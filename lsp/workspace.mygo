package lsp

import filepath "go:path/filepath"
import json "go:encoding/json"

struct WorkspaceFolder
  URI: String `json:"uri"`
end

struct WorkspaceInitialization
  RootURI: String `json:"rootUri"`
  Folders: Slice[WorkspaceFolder] `json:"workspaceFolders"`
end

func configureWorkspace(store: Ref[DocumentStore], params: Option[Map[String, Any]]) -> ()
  switch params
    case None => ()
    case Some(fields) then
      switch json.Marshal(fields)
        case Err(_) => ()
        case Ok(data) then
          var settings = WorkspaceInitialization{RootURI: "", Folders: []}
          switch json.Unmarshal(data, Ref.new(settings))
            case Err(_) => ()
            case Ok(_) then
              var roots: Slice[String] = []
              var index = 0
              while index < settings.Folders.Len()
                switch settings.Folders.Get(index)
                  case None => ()
                  case Some(folder) then
                    let path = parseDocumentURI(folder.URI)
                    if path != "" then
                      roots = roots.Append(path)
                    else
                      ()
                    end
                  end
                end
                index = index + 1
              end
              if roots.Len() == 0 && settings.RootURI != "" then
                let path = parseDocumentURI(settings.RootURI)
                if path != "" then
                  roots = roots.Append(path)
                else
                  ()
                end
              else
                ()
              end
              store.Roots = roots
            end
          end
        end
      end
    end
  end
end

func workspacePaths(store: Ref[DocumentStore]) -> Slice[String]
  let overlays = store.docs.ToPairs()
  let roots = store.Roots
  if overlays.Len() == 0 && roots.Len() == 1 then
    switch roots.Get(0)
      case Some(root) => cachedWorkspaceSources(store, root)
      case None => []
    end
  else
    collectWorkspacePaths(store, roots)
  end
end

func collectWorkspacePaths(store: Ref[DocumentStore], roots: Slice[String]) -> Slice[String]
  var paths: Slice[String] = []
  var seen: Set[String] = Set.New[String]()
  var mutableRoots = roots
  let overlays = store.docs.ToPairs()
  var index = 0
  while index < overlays.Len()
    switch overlays.Get(index)
      case None => ()
      case Some(pair) then
        let (_, document) = pair
        let path = parseDocumentURI(document.URI)
        if path != "" then
          if store.Roots.Len() == 0 && !mutableRoots.Contains(filepath.Dir(path)) then
            mutableRoots = mutableRoots.Append(filepath.Dir(path))
          else
            ()
          end
          if !seen.Contains(path) then
            seen = seen.Add(path)
            paths = paths.Append(path)
          else
            ()
          end
        else
          ()
        end
      end
    end
    index = index + 1
  end
  index = 0
  while index < mutableRoots.Len()
    switch mutableRoots.Get(index)
      case None => ()
      case Some(root) then
        let found = cachedWorkspaceSources(store, root)
        var fileIndex = 0
        while fileIndex < found.Len()
          switch found.Get(fileIndex)
            case None => ()
            case Some(path) then
              if !seen.Contains(path) then
                seen = seen.Add(path)
                paths = paths.Append(path)
              else
                ()
              end
            end
          end
          fileIndex = fileIndex + 1
        end
      end
    end
    index = index + 1
  end
  paths
end

func documentOverlays(store: Ref[DocumentStore]) -> Map[String, String]
  var overlays: Map[String, String] = {}
  let pairs = store.docs.ToPairs()
  var index = 0
  while index < pairs.Len()
    switch pairs.Get(index)
      case None => ()
      case Some(pair) then
        let (_, document) = pair
        let path = parseDocumentURI(document.URI)
        if path != "" then
          overlays.Set(path, document.Content)
        else
          ()
        end
      end
    end
    index = index + 1
  end
  overlays
end

# documentOverlayStamps gives the parse cache one identity per open document
# version.  Disk files have no entry and fall back to size and modification
# time in the compiler loader.
func documentOverlayStamps(store: Ref[DocumentStore]) -> Map[String, String]
  var stamps: Map[String, String] = {}
  let pairs = store.docs.ToPairs()
  var index = 0
  while index < pairs.Len()
    switch pairs.Get(index)
      case None => ()
      case Some(pair) then
        let (_, document) = pair
        let path = parseDocumentURI(document.URI)
        if path != "" then
          stamps.Set(path, overlayStampText(document))
        else
          ()
        end
      end
    end
    index = index + 1
  end
  stamps
end

# overlayStampText is the shared parse-cache identity for an open document.
func overlayStampText(document: Ref[Document]) -> String
  "overlay|" + document.Version.ToString() + "|" + document.Content.Len().ToString()
end
