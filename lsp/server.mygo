package lsp

import os "go:os"
import bufio "go:bufio"

# ===== Main Entry Point =====

struct ServerState
  Initialized: Bool
  Shutdown: Bool
end

func routeMessage(state: Ref[ServerState], store: Ref[DocumentStore], msg: LSPMessage) -> Option[LSPMessage]
  switch msg.Error
    case Some(err) => Some(responseError(msg.Id, err.Code, err.Message))
    case None then
      if msg.Method == "exit" then
        if state.Shutdown then
          os.Exit(0)
        else
          os.Exit(1)
        end
        None
      elsif msg.Method == "initialize" then
        if state.Initialized then
          Some(responseError(msg.Id, -32600, "already initialized"))
        elsif msg.Id.IsNone() then
          None
        else
          state.Initialized = true
          configureWorkspace(store, msg.Params)
          Some(responseResult(msg.Id, buildInitializeResponse()))
        end
      elsif !state.Initialized then
        if msg.Id.IsSome() then
          Some(responseError(msg.Id, -32002, "server not initialized"))
        else
          None
        end
      elsif state.Shutdown then
        if msg.Id.IsSome() then
          Some(responseError(msg.Id, -32600, "server has shut down"))
        else
          None
        end
      elsif msg.Method == "shutdown" && msg.Id.IsSome() then
        state.Shutdown = true
        Some(responseEmpty(msg.Id))
      elsif !validMessageParams(msg) then
        if msg.Id.IsSome() then
          Some(responseError(msg.Id, -32602, "invalid params"))
        else
          None
        end
      elsif msg.Id.IsNone() then
        if msg.Method == "textDocument/didOpen" || msg.Method == "textDocument/didChange" || msg.Method == "textDocument/didClose" then
          let _ = handleMessage(store, msg)
          switch msg.Params
            case None => ()
            case Some(params) then
              let uri = requestURI(params)
              publishOpenDiagnostics(store, uri)
            end
          end
          None
        elsif msg.Method == "workspace/didChangeWatchedFiles" then
          handleWatchedFiles(store, msg.Params)
          publishOpenDiagnostics(store, "")
          None
        else
          None
        end
      else
        Some(handleMessage(store, msg))
      end
    end
  end
end

func Main() -> ()
  let store = Ref.new(newDocumentStore())
  let state = Ref.new(ServerState{Initialized: false, Shutdown: false})
  let reader = bufio.NewReader(os.Stdin)

  while true
    switch readFrame(reader)
      case Err(_) then
        break
      end
      case Ok(raw) then
        let msg = decodeMessage(raw)
        switch routeMessage(state, store, msg)
          case Some(response) then
            let _ = writeOneMessage(response)
          end
          case None => ()
        end
      end
    end
  end
end
