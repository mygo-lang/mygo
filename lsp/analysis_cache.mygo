package lsp

import compiler "github.com/mygo-lang/mygo/internal/mygo/compiler"
import codegen2 "github.com/mygo-lang/mygo/internal/mygo/codegen2"
import filepath "go:path/filepath"

struct PackageSnapshot
  Fingerprint: String
  WatchedPaths: Slice[String]
  Package: Option[compiler.EditorPackage]
  Error: String
  Index: Option[SourceIndex]
end

func analysisFingerprint(store: Ref[DocumentStore], paths: Slice[String]) -> String
  var stamps: Slice[FileStamp] = []
  var index = 0
  while index < paths.Len()
    switch paths.Get(index)
      case None => ()
      case Some(path) => stamps = stamps.Append(sourceStamp(store, path))
    end
    index = index + 1
  end
  fingerprintOf(stamps)
end

func analyzePackage(store: Ref[DocumentStore], uri: String) -> Ref[PackageSnapshot]
  let path = parseDocumentURI(uri)
  if path == "" then
    Ref.new(PackageSnapshot{
      Fingerprint: "",
      WatchedPaths: [],
      Package: None,
      Error: "semantic analysis requires a file URI",
      Index: None,
    })
  else
    analyzeFilePackage(store, path)
  end
end

func analyzeFilePackage(store: Ref[DocumentStore], path: String) -> Ref[PackageSnapshot]
  let dir = filepath.Dir(path)
  var paths = packageSourcePaths(store, dir)
  var pathSet: Set[String] = Set.New[String]()
  var seedIndex = 0
  while seedIndex < paths.Len()
    switch paths.Get(seedIndex)
      case None => ()
      case Some(source) => pathSet = pathSet.Add(source)
    end
    seedIndex = seedIndex + 1
  end
  switch store.Analyses.Get(dir)
    case None => ()
    case Some(previous) then
      var index = 0
      var directories: Set[String] = Set.New[String]()
      directories = directories.Add(dir)
      while index < previous.WatchedPaths.Len()
        switch previous.WatchedPaths.Get(index)
          case None => ()
          case Some(watched) then
            let dependencyDir = filepath.Dir(watched)
            let dependencyPaths = if directories.Contains(dependencyDir) then
              [] as Slice[String]
            else
              directories = directories.Add(dependencyDir)
              packageSourcePaths(store, dependencyDir)
            end
            var dependencyPosition = 0
            while dependencyPosition < dependencyPaths.Len()
              switch dependencyPaths.Get(dependencyPosition)
                case None => ()
                case Some(dependencyPath) then
                  if !pathSet.Contains(dependencyPath) then
                    pathSet = pathSet.Add(dependencyPath)
                    paths = paths.Append(dependencyPath)
                  else
                    ()
                  end
                end
              end
              dependencyPosition = dependencyPosition + 1
            end
            if !pathSet.Contains(watched) then
              pathSet = pathSet.Add(watched)
              paths = paths.Append(watched)
            else
              ()
            end
          end
        end
        index = index + 1
      end
    end
  end
  let fingerprint = analysisFingerprint(store, canonicalPaths(paths))
  switch store.Analyses.Get(dir)
    case Some(previous) then
      # Reuse failed snapshots too: while typing, an error state is common and
      # re-running the full analysis per open document is the behavior this
      # change removes.  Directory listings and watched paths still invalidate
      # the identity when a file appears or disappears.
      if previous.Fingerprint == fingerprint then
        previous
      else
        refreshPackage(store, dir, paths)
      end
    end
    case None => refreshPackage(store, dir, paths)
  end
end

func refreshPackage(
  store: Ref[DocumentStore],
  dir: String,
  paths: Slice[String]
) -> Ref[PackageSnapshot]
  store.PackageAnalyses = store.PackageAnalyses + 1
  let analyzed = compiler.AnalyzeEditorPackageCached(
    dir,
    documentOverlays(store),
    documentOverlayStamps(store),
    store.ParseCache
  )
  var watched = paths
  let snapshot = switch analyzed
    case Err(message) then
      let ordered = canonicalPaths(watched)
      PackageSnapshot{
        Fingerprint: analysisFingerprint(store, ordered),
        WatchedPaths: ordered,
        Package: None,
        Error: message,
        Index: None,
      }
    end
    case Ok(analyzedPackage) then
      let sources = analyzedPackage.Sources.ToPairs()
      var index = 0
      while index < sources.Len()
        switch sources.Get(index)
          case None => ()
          case Some(pair) then
            let (_, inputs) = pair
            var fileIndex = 0
            while fileIndex < inputs.Inputs.Len()
              switch inputs.Inputs.Get(fileIndex)
                case None => ()
                case Some(input) then
                  let sourceInput: codegen2.SourceFileInput = input
                  if !watched.Contains(sourceInput.Path) then
                    watched = watched.Append(sourceInput.Path)
                  else
                    ()
                  end
                end
              end
              fileIndex = fileIndex + 1
            end
          end
        end
        index = index + 1
      end
      let ordered = canonicalPaths(watched)
      PackageSnapshot{
        Fingerprint: analysisFingerprint(store, ordered),
        WatchedPaths: ordered,
        Package: Some(analyzedPackage),
        Error: "",
        Index: None,
      }
    end
  end
  let reference = Ref.new(snapshot)
  store.Analyses.Set(dir, reference)
  recordPackageDependencies(store, dir, reference.value().WatchedPaths)
  reference
end
