package parser2

import ps "github.com/mygo-lang/mygo/lib/text/parsec"

enum CstTokenKind
  Identifier
  Keyword
  Number
  StringLiteral
  RawStringLiteral
  TripleStringLiteral
  RuneLiteral
  Symbol
end

enum CstTriviaKind
  Whitespace
  Comment
end

func cstTriviaKindText(kind: CstTriviaKind) -> String
  switch kind
    case Whitespace => "whitespace"
    case Comment => "comment"
  end
end

func cstTokenKindText(kind: CstTokenKind) -> String
  switch kind
    case Identifier => "identifier"
    case Keyword => "keyword"
    case Number => "number"
    case StringLiteral => "string"
    case RawStringLiteral => "raw-string"
    case TripleStringLiteral => "triple-string"
    case RuneLiteral => "rune"
    case Symbol => "symbol"
  end
end

enum CstNodeKind
  File
  Declaration
  PackageDeclaration
  ImportDeclaration
  LetDeclaration
  VarDeclaration
  FuncDeclaration
  TypeDeclaration
  StructDeclaration
  EnumDeclaration
  InterfaceDeclaration
  ImplDeclaration
  TypeParameters
  StructField
  EnumVariant
  FuncSignature
  ImplMethod
  FunctionParameters
  FunctionReturnType
  TypeAnnotation
  ValueInitializer
  Expression
  IdentifierExpr
  NumberExpr
  BoolExpr
  StringExpr
  RuneExpr
  ParenExpr
  TupleExpr
  UnitExpr
  InlineGoExpr
  InlineGoBody
  InlineGoCode
  InlineGoValueBinding
  InlineGoTypeBinding
  Type
  NamedType
  TupleType
  GenericType
  TypeArguments
  UnitType
  FuncType
  FunctionTypeParameters
  Pattern
  BindPattern
  TuplePattern
  WildcardPattern
  LiteralPattern
  VariantPattern
  StructVariantPattern
  StructPatternField
  Constraint
  Constraints
  ParenGroup
  BracketGroup
  BraceGroup
  IfBlock
  SwitchBlock
  WhileBlock
  Call
  UnaryExpr
  BinaryExpr
  FieldExpr
  TypeAsExpr
  FuncLitExpr
  SliceLiteral
  MapLiteral
  SetLiteral
  StructLiteral
  MapEntry
  StructLitField
  ElsifBranch
  ElseBranch
  CaseBranch
  Block
  ExprStatement
  LetStatement
  VarStatement
  TupleLetStatement
  AssignStatement
  ReturnStatement
  BreakStatement
  ContinueStatement
  LetRecStatement
  LetRecBinding
  Error
end

# The lossless parser owns these leaves.  Raw is always a source slice; decoded
# literal values and semantic meaning belong to CST-to-ast2 lowering instead.
struct CstToken
  Kind: CstTokenKind
  Raw: String
  Span: ps.SourceSpan
end

struct CstTrivia
  Kind: CstTriviaKind
  Raw: String
  Span: ps.SourceSpan
end

# A diagnostic is attached to the recovered syntax tree, never to ast2.  The
# recovery field names the grammar boundary at which parsing resumed.
struct SyntaxDiagnostic
  Message: String
  Span: ps.SourceSpan
  Expected: Slice[String]
  Recovery: String
end

# CstElement keeps ordered source children.  A node is referenced so CST
# nodes form an immutable recursive tree without copying subtrees.
enum CstElement
  TokenElement(CstToken)
  TriviaElement(CstTrivia)
  NodeElement(Ref[CstNode])
end

struct CstNode
  Kind: CstNodeKind
  Span: ps.SourceSpan
  Children: Slice[CstElement]
  HasError: Bool
end

# SyntaxTree is the result of syntax parsing, including recoverable failures.
# Its source is retained so future formatter and editor consumers can slice any
# token range without reconstructing text from AST values.
struct SyntaxTree
  SourceName: String
  Source: String
  Root: Ref[CstNode]
  Diagnostics: Slice[SyntaxDiagnostic]
end

# Red views add a stable tree root and a child-index path to CST storage.
# Navigation is deliberately layered on these values in task 1.4.
struct SyntaxNodeView
  Root: Ref[CstNode]
  Node: Ref[CstNode]
  Path: Slice[Int]
end

struct SyntaxToken
  Root: Ref[CstNode]
  ParentPath: Slice[Int]
  ChildIndex: Int
  Token: CstToken
end

# SyntaxElement preserves child order while exposing node and token views.
# Trivia is kept as its CST value because it has no independent tree identity.
enum SyntaxElement
  SyntaxNodeElement(SyntaxNodeView)
  SyntaxTokenElement(SyntaxToken)
  SyntaxTriviaElement(CstTrivia)
end

func syntaxTreeRoot(tree: SyntaxTree) -> SyntaxNodeView
  SyntaxNodeView { Root: tree.Root, Node: tree.Root, Path: [] }
end

func syntaxElementView(parent: SyntaxNodeView, index: Int, item: CstElement) -> Option[SyntaxElement]
  switch item
    case NodeElement(child) => Some(SyntaxElement.SyntaxNodeElement(SyntaxNodeView { Root: parent.Root, Node: child, Path: parent.Path.Append(index) }))
    case TokenElement(token) => Some(SyntaxElement.SyntaxTokenElement(SyntaxToken { Root: parent.Root, ParentPath: parent.Path, ChildIndex: index, Token: token }))
    case TriviaElement(trivia) => Some(SyntaxElement.SyntaxTriviaElement(trivia))
  end
end

func syntaxElementToken(item: SyntaxElement) -> Option[SyntaxToken]
  switch item
    case SyntaxTokenElement(token) => Some(token)
    case _ => None
  end
end

func syntaxNodeAtPath(root: Ref[CstNode], path: Slice[Int], index: Int) -> Option[SyntaxNodeView]
  syntaxNodeAtPathFrom(root, root, path, index, [])
end

func syntaxNodeAtPathFrom(root: Ref[CstNode], current: Ref[CstNode], path: Slice[Int], index: Int, walked: Slice[Int]) -> Option[SyntaxNodeView]
  if index >= path.Len() then
    Some(SyntaxNodeView { Root: root, Node: current, Path: walked })
  else
    switch path.Get(index)
      case Some(childIndex) then
        switch current.value().Children.Get(childIndex)
          case Some(item) then
            switch cstElementNode(item)
              case Some(child) => syntaxNodeAtPathFrom(root, child, path, index + 1, walked.Append(childIndex))
              case None => None
            end
          end
          case _ => None
        end
      end
      case None => None
    end
  end
end

impl SyntaxNodeView
  func Kind(node: SyntaxNodeView) -> CstNodeKind
    node.Node.value().Kind
  end

  func Span(node: SyntaxNodeView) -> ps.SourceSpan
    node.Node.value().Span
  end

  func ChildCount(node: SyntaxNodeView) -> Int
    node.Node.value().Children.Len()
  end

  func Child(node: SyntaxNodeView, index: Int) -> Option[SyntaxNodeView]
    switch node.Node.value().Children.Get(index)
      case Some(item) then
        switch cstElementNode(item)
          case Some(child) => Some(SyntaxNodeView { Root: node.Root, Node: child, Path: node.Path.Append(index) })
          case None => None
        end
      end
      case _ => None
    end
  end

  func Element(node: SyntaxNodeView, index: Int) -> Option[SyntaxElement]
    switch node.Node.value().Children.Get(index)
      case Some(item) => syntaxElementView(node, index, item)
      case None => None
    end
  end

  func Token(node: SyntaxNodeView, index: Int) -> Option[SyntaxToken]
    switch node.Element(index)
      case Some(item) => syntaxElementToken(item)
      case None => None
    end
  end

  func Parent(node: SyntaxNodeView) -> Option[SyntaxNodeView]
    if node.Path.Len() == 0 then
      None
    else
      switch node.Path.Slice(0, node.Path.Len() - 1)
        case Some(path) => syntaxNodeAtPath(node.Root, path, 0)
        case None => None
      end
    end
  end

  func PreviousSibling(node: SyntaxNodeView) -> Option[SyntaxNodeView]
    node.Sibling(-1)
  end

  func NextSibling(node: SyntaxNodeView) -> Option[SyntaxNodeView]
    node.Sibling(1)
  end

  func Sibling(node: SyntaxNodeView, step: Int) -> Option[SyntaxNodeView]
    if node.Path.Len() == 0 then
      None
    else
      switch (node.Parent(), node.Path.Get(node.Path.Len() - 1))
        case (Some(parent), Some(index)) => syntaxNodeSiblingFrom(parent, index + step, step)
        case _ => None
      end
    end
  end

  func FirstChildOfKind(node: SyntaxNodeView, kind: CstNodeKind) -> Option[SyntaxNodeView]
    node.FirstChildOfKindFrom(kind, 0)
  end

  func FirstChildOfKindFrom(node: SyntaxNodeView, kind: CstNodeKind, index: Int) -> Option[SyntaxNodeView]
    if index >= node.ChildCount() then
      None
    else
      switch node.Child(index)
        case Some(child) then
          if child.Kind() == kind then
            Some(child)
          else
            node.FirstChildOfKindFrom(kind, index + 1)
          end
        end
        case None => node.FirstChildOfKindFrom(kind, index + 1)
      end
    end
  end

  func FirstPatternChildOfKind(node: SyntaxNodeView, index: Int) -> Option[SyntaxNodeView]
    if index >= node.ChildCount() then
      None
    else
      switch node.Child(index)
        case Some(child) then
          if cstNodeIsPatternKind(child.Kind()) then
            Some(child)
          else
            node.FirstPatternChildOfKind(index + 1)
          end
        end
        case None => node.FirstPatternChildOfKind(index + 1)
      end
    end
  end

  func FirstTypedChild(node: SyntaxNodeView) -> Option[SyntaxNodeView]
    node.FirstTypedChildFrom(0)
  end

  func FirstTypedChildFrom(node: SyntaxNodeView, index: Int) -> Option[SyntaxNodeView]
    if index >= node.ChildCount() then
      None
    else
      switch node.Child(index)
        case Some(child) then
          if syntaxNodeIsSemanticKind(child.Kind()) then
            Some(child)
          else
            node.FirstTypedChildFrom(index + 1)
          end
        end
        case None => node.FirstTypedChildFrom(index + 1)
      end
    end
  end
end

impl SyntaxToken
  func Kind(token: SyntaxToken) -> CstTokenKind
    token.Token.Kind
  end

  func Raw(token: SyntaxToken) -> String
    token.Token.Raw
  end

  func Span(token: SyntaxToken) -> ps.SourceSpan
    token.Token.Span
  end
end

func syntaxNodeSiblingFrom(parent: SyntaxNodeView, index: Int, step: Int) -> Option[SyntaxNodeView]
  if index < 0 || index >= parent.ChildCount() then
    None
  else
    switch parent.Child(index)
      case Some(sibling) => Some(sibling)
      case None => syntaxNodeSiblingFrom(parent, index + step, step)
    end
  end
end

# These accessors expose the semantic CST contract consumed by lowering.
func syntaxDeclarationName(node: SyntaxNodeView) -> Option[SyntaxNodeView]
  node.FirstChildOfKind(CstNodeKind.IdentifierExpr)
end

func syntaxDeclarationPattern(node: SyntaxNodeView) -> Option[SyntaxNodeView]
  node.FirstPatternChildOfKind(0)
end

func syntaxDeclarationTypeAnnotation(node: SyntaxNodeView) -> Option[SyntaxNodeView]
  node.FirstChildOfKind(CstNodeKind.TypeAnnotation)
end

func syntaxDeclarationInitializer(node: SyntaxNodeView) -> Option[SyntaxNodeView]
  node.FirstChildOfKind(CstNodeKind.ValueInitializer)
end

func syntaxFunctionParameters(node: SyntaxNodeView) -> Option[SyntaxNodeView]
  node.FirstChildOfKind(CstNodeKind.FunctionParameters)
end

func syntaxFunctionReturnType(node: SyntaxNodeView) -> Option[SyntaxNodeView]
  node.FirstChildOfKind(CstNodeKind.FunctionReturnType)
end

func syntaxTypeAnnotationValue(node: SyntaxNodeView) -> Option[SyntaxNodeView]
  node.FirstTypedChild()
end

func syntaxInitializerExpression(node: SyntaxNodeView) -> Option[SyntaxNodeView]
  node.FirstTypedChild()
end

func syntaxNodeIsSemanticKind(kind: CstNodeKind) -> Bool
  kind == CstNodeKind.IdentifierExpr || kind == CstNodeKind.NumberExpr || kind == CstNodeKind.BoolExpr || kind == CstNodeKind.StringExpr || kind == CstNodeKind.RuneExpr || kind == CstNodeKind.ParenExpr || kind == CstNodeKind.TupleExpr || kind == CstNodeKind.UnitExpr || kind == CstNodeKind.InlineGoExpr || kind == CstNodeKind.Call || kind == CstNodeKind.UnaryExpr || kind == CstNodeKind.BinaryExpr || kind == CstNodeKind.FieldExpr || kind == CstNodeKind.TypeAsExpr || kind == CstNodeKind.Type || kind == CstNodeKind.NamedType || kind == CstNodeKind.TupleType || kind == CstNodeKind.GenericType || kind == CstNodeKind.Pattern || kind == CstNodeKind.BindPattern || kind == CstNodeKind.WildcardPattern || kind == CstNodeKind.LiteralPattern || kind == CstNodeKind.TuplePattern || kind == CstNodeKind.VariantPattern || kind == CstNodeKind.StructVariantPattern || kind == CstNodeKind.Expression || kind == CstNodeKind.SliceLiteral || kind == CstNodeKind.MapLiteral || kind == CstNodeKind.SetLiteral || kind == CstNodeKind.StructLiteral || kind == CstNodeKind.StructLitField || kind == CstNodeKind.IfBlock || kind == CstNodeKind.SwitchBlock || kind == CstNodeKind.WhileBlock
end

# This closed predicate is the lowering frontier for task 3.1.  It is kept
# separate from syntaxNodeIsSemanticKind: the latter describes CST structure,
# while this one describes only node kinds that LowerSyntax can currently turn
# into ast2 without using the legacy parser.
func syntaxLoweringSupportsNodeKind(kind: CstNodeKind) -> Bool
  kind == CstNodeKind.File || kind == CstNodeKind.PackageDeclaration || kind == CstNodeKind.ImportDeclaration || kind == CstNodeKind.LetDeclaration || kind == CstNodeKind.VarDeclaration || kind == CstNodeKind.FuncDeclaration || kind == CstNodeKind.TypeDeclaration || kind == CstNodeKind.StructDeclaration || kind == CstNodeKind.EnumDeclaration || kind == CstNodeKind.InterfaceDeclaration || kind == CstNodeKind.ImplDeclaration || kind == CstNodeKind.TypeParameters || kind == CstNodeKind.StructField || kind == CstNodeKind.EnumVariant || kind == CstNodeKind.FuncSignature || kind == CstNodeKind.ImplMethod || kind == CstNodeKind.FunctionParameters || kind == CstNodeKind.FunctionReturnType || kind == CstNodeKind.TypeAnnotation || kind == CstNodeKind.ValueInitializer || kind == CstNodeKind.IdentifierExpr || kind == CstNodeKind.NumberExpr || kind == CstNodeKind.BoolExpr || kind == CstNodeKind.StringExpr || kind == CstNodeKind.RuneExpr || kind == CstNodeKind.ParenExpr || kind == CstNodeKind.TupleExpr || kind == CstNodeKind.UnitExpr || kind == CstNodeKind.InlineGoExpr || kind == CstNodeKind.FuncLitExpr || kind == CstNodeKind.Call || kind == CstNodeKind.UnaryExpr || kind == CstNodeKind.BinaryExpr || kind == CstNodeKind.FieldExpr || kind == CstNodeKind.TypeAsExpr || kind == CstNodeKind.NamedType || kind == CstNodeKind.GenericType || kind == CstNodeKind.TupleType || kind == CstNodeKind.UnitType || kind == CstNodeKind.FuncType || kind == CstNodeKind.Constraint || kind == CstNodeKind.Constraints || kind == CstNodeKind.SliceLiteral || kind == CstNodeKind.MapLiteral || kind == CstNodeKind.SetLiteral || kind == CstNodeKind.StructLiteral || kind == CstNodeKind.StructLitField || kind == CstNodeKind.BindPattern || kind == CstNodeKind.WildcardPattern || kind == CstNodeKind.LiteralPattern || kind == CstNodeKind.TuplePattern || kind == CstNodeKind.VariantPattern || kind == CstNodeKind.StructVariantPattern || kind == CstNodeKind.StructPatternField || kind == CstNodeKind.IfBlock || kind == CstNodeKind.SwitchBlock || kind == CstNodeKind.WhileBlock || kind == CstNodeKind.Block || kind == CstNodeKind.ExprStatement || kind == CstNodeKind.LetStatement || kind == CstNodeKind.VarStatement || kind == CstNodeKind.TupleLetStatement || kind == CstNodeKind.AssignStatement || kind == CstNodeKind.ReturnStatement || kind == CstNodeKind.BreakStatement || kind == CstNodeKind.ContinueStatement || kind == CstNodeKind.LetRecStatement || kind == CstNodeKind.LetRecBinding
end

# LexedSource is the lexer boundary used by both CST construction and the
# temporary LosslessFile compatibility adapter. Elements retain source order;
# the categorized slices are indexes, not a second source representation.
struct LexedSource
  Elements: Slice[CstElement]
  Tokens: Slice[CstToken]
  Trivia: Slice[CstTrivia]
end

struct LexerState
  Input: String
  Index: Int
  Offset: Int
  Line: Int
  Column: Int
  Elements: Slice[CstElement]
  Tokens: Slice[CstToken]
  Trivia: Slice[CstTrivia]
end

# DelimitedBuildResult makes the lossless structural pass total: an unmatched
# opener remains a leaf and therefore never causes source text to disappear.
struct DelimitedBuildResult
  Children: Option[List[CstElement]]
  Next: Int
  Close: Option[CstElement]
end

struct DeclarationPatternResult
  Element: Option[CstElement]
  Next: Int
end

# FuncLitSignature carries the classified signature of a `func` literal between
# its parameter group and its body: where the body begins, the trivia gap that
# follows the parameter group, and the optional return-type node.
struct FuncLitSignature
  BodyStart: Int
  Return: Option[CstElement]
  Gap: Slice[CstElement]
end

# SyntaxCursor is the CST parser input.  It walks the lexer-owned ordered
# leaves; trivia is skipped only for grammar decisions and remains in every
# source-range slice used to freeze a CST node.
struct SyntaxCursor
  Elements: Slice[CstElement]
  Index: Int
end

struct SyntaxParseResult
  Node: Option[Ref[CstNode]]
  Cursor: SyntaxCursor
end

# Recovery tracks only grammar synchronization state. It never drops source
# leaves: diagnostics later turn the responsible leaves into Error nodes.
struct SyntaxBlock
  Keyword: String
  Close: String
  Span: ps.SourceSpan
end

struct SyntaxRecoveryState
  Delimiters: Slice[CstElement]
  Blocks: Slice[SyntaxBlock]
  Diagnostics: Slice[SyntaxDiagnostic]
end

func sourceSpanContains(outer: ps.SourceSpan, inner: ps.SourceSpan) -> Bool
  outer.Start.Offset <= inner.Start.Offset && inner.End.Offset <= outer.End.Offset
end

func sourceSpanIsOrdered(span: ps.SourceSpan) -> Bool
  span.Start.Offset <= span.End.Offset &&
    (span.Start.Line < span.End.Line ||
      (span.Start.Line == span.End.Line && span.Start.Column <= span.End.Column))
end

func cstElementSpan(item: CstElement) -> ps.SourceSpan
  switch item
    case TokenElement(token) => token.Span
    case TriviaElement(trivia) => trivia.Span
    case NodeElement(node) => node.value().Span
  end
end

func cstElementIsOrdered(item: CstElement) -> Bool
  sourceSpanIsOrdered(cstElementSpan(item))
end

func cstNodeChildrenFit(node: CstNode) -> Bool
  node.Children.Fold(true, func(valid: Bool, item: CstElement) -> Bool
    valid && cstElementIsOrdered(item) && sourceSpanContains(node.Span, cstElementSpan(item))
  end)
end

func LexSource(input: String) -> LexedSource
  lexStep(LexerState {
    Input: input,
    Index: 0,
    Offset: 0,
    Line: 1,
    Column: 1,
    Elements: [],
    Tokens: [],
    Trivia: [],
  })
end

# ParseSyntax is the recovery-capable entry point. It always returns the
# lossless tree; callers inspect Diagnostics before semantic lowering.
func ParseSyntax(input: String) -> SyntaxTree
  ParseSyntaxAt("<input>", input)
end

func ParseSyntaxAt(sourceName: String, input: String) -> SyntaxTree
  buildDelimitedSyntax(sourceName, input)
end
