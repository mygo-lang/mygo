package parser2

import ps "github.com/mygo-lang/mygo/lib/text/parsec"
import strings "go:strings"
import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"

enum GreenTokenKind
  Identifier
  Keyword
  Number
  StringLiteral
  RawStringLiteral
  TripleStringLiteral
  RuneLiteral
  Symbol
end

enum GreenTriviaKind
  Whitespace
  Comment
end

func greenTriviaKindText(kind: GreenTriviaKind) -> String
  switch kind
    case Whitespace => "whitespace"
    case Comment => "comment"
  end
end

func greenTokenKindText(kind: GreenTokenKind) -> String
  switch kind
    case Identifier => "identifier"
    case Keyword => "keyword"
    case Number => "number"
    case StringLiteral => "string"
    case RawStringLiteral => "raw-string"
    case TripleStringLiteral => "triple-string"
    case RuneLiteral => "rune"
    case Symbol => "symbol"
  end
end

enum GreenNodeKind
  File
  Declaration
  PackageDeclaration
  ImportDeclaration
  LetDeclaration
  VarDeclaration
  FuncDeclaration
  TypeDeclaration
  StructDeclaration
  EnumDeclaration
  InterfaceDeclaration
  ImplDeclaration
  TypeParameters
  StructField
  EnumVariant
  FuncSignature
  ImplMethod
  FunctionParameters
  FunctionReturnType
  TypeAnnotation
  ValueInitializer
  Expression
  IdentifierExpr
  NumberExpr
  BoolExpr
  StringExpr
  RuneExpr
  ParenExpr
  TupleExpr
  UnitExpr
  InlineGoExpr
  InlineGoBody
  InlineGoCode
  InlineGoValueBinding
  InlineGoTypeBinding
  Type
  NamedType
  TupleType
  GenericType
  TypeArguments
  UnitType
  FuncType
  FunctionTypeParameters
  Pattern
  BindPattern
  TuplePattern
  WildcardPattern
  LiteralPattern
  VariantPattern
  StructVariantPattern
  StructPatternField
  Constraint
  Constraints
  ParenGroup
  BracketGroup
  BraceGroup
  IfBlock
  SwitchBlock
  WhileBlock
  Call
  UnaryExpr
  BinaryExpr
  FieldExpr
  TypeAsExpr
  FuncLitExpr
  SliceLiteral
  MapLiteral
  SetLiteral
  StructLiteral
  MapEntry
  StructLitField
  ElsifBranch
  ElseBranch
  CaseBranch
  Block
  ExprStatement
  LetStatement
  VarStatement
  TupleLetStatement
  AssignStatement
  ReturnStatement
  BreakStatement
  ContinueStatement
  LetRecStatement
  LetRecBinding
  Error
end

# The lossless parser owns these leaves.  Raw is always a source slice; decoded
# literal values and semantic meaning belong to CST-to-ast2 lowering instead.
struct GreenToken
  Kind: GreenTokenKind
  Raw: String
  Span: ps.SourceSpan
end

struct GreenTrivia
  Kind: GreenTriviaKind
  Raw: String
  Span: ps.SourceSpan
end

# A diagnostic is attached to the recovered syntax tree, never to ast2.  The
# recovery field names the grammar boundary at which parsing resumed.
struct SyntaxDiagnostic
  Message: String
  Span: ps.SourceSpan
  Expected: Slice[String]
  Recovery: String
end

# GreenElement keeps ordered source children.  A node is referenced so green
# nodes form an immutable recursive tree without copying subtrees.
enum GreenElement
  TokenElement(GreenToken)
  TriviaElement(GreenTrivia)
  NodeElement(Ref[GreenNode])
end

struct GreenNode
  Kind: GreenNodeKind
  Span: ps.SourceSpan
  Children: Slice[GreenElement]
  HasError: Bool
end

# SyntaxTree is the result of syntax parsing, including recoverable failures.
# Its source is retained so future formatter and editor consumers can slice any
# token range without reconstructing text from AST values.
struct SyntaxTree
  SourceName: String
  Source: String
  Root: Ref[GreenNode]
  Diagnostics: Slice[SyntaxDiagnostic]
end

# Red views add a stable tree root and a child-index path to green storage.
# Navigation is deliberately layered on these values in task 1.4.
struct SyntaxNode
  Root: Ref[GreenNode]
  Node: Ref[GreenNode]
  Path: Slice[Int]
end

struct SyntaxToken
  Root: Ref[GreenNode]
  ParentPath: Slice[Int]
  ChildIndex: Int
  Token: GreenToken
end

# SyntaxElement preserves child order while exposing node and token views.
# Trivia is kept as its green value because it has no independent tree identity.
enum SyntaxElement
  SyntaxNodeElement(SyntaxNode)
  SyntaxTokenElement(SyntaxToken)
  SyntaxTriviaElement(GreenTrivia)
end

func syntaxNodeKind(node: SyntaxNode) -> GreenNodeKind
  node.Node.value().Kind
end

func syntaxNodeSpan(node: SyntaxNode) -> ps.SourceSpan
  node.Node.value().Span
end

func syntaxTreeRoot(tree: SyntaxTree) -> SyntaxNode
  SyntaxNode { Root: tree.Root, Node: tree.Root, Path: [] }
end

func syntaxNodeChildCount(node: SyntaxNode) -> Int
  node.Node.value().Children.Len()
end

func syntaxNodeChild(node: SyntaxNode, index: Int) -> Option[SyntaxNode]
  switch node.Node.value().Children.Get(index)
    case Some(item) then
      switch greenElementNode(item)
        case Some(child) => Some(SyntaxNode { Root: node.Root, Node: child, Path: node.Path.Append(index) })
        case None => None
      end
    end
    case _ => None
  end
end

func syntaxNodeElement(node: SyntaxNode, index: Int) -> Option[SyntaxElement]
  switch node.Node.value().Children.Get(index)
    case Some(item) => syntaxElementView(node, index, item)
    case None => None
  end
end

func syntaxElementView(parent: SyntaxNode, index: Int, item: GreenElement) -> Option[SyntaxElement]
  switch item
    case NodeElement(child) => Some(SyntaxElement.SyntaxNodeElement(SyntaxNode { Root: parent.Root, Node: child, Path: parent.Path.Append(index) }))
    case TokenElement(token) => Some(SyntaxElement.SyntaxTokenElement(SyntaxToken { Root: parent.Root, ParentPath: parent.Path, ChildIndex: index, Token: token }))
    case TriviaElement(trivia) => Some(SyntaxElement.SyntaxTriviaElement(trivia))
  end
end

func syntaxNodeToken(node: SyntaxNode, index: Int) -> Option[SyntaxToken]
  switch syntaxNodeElement(node, index)
    case Some(item) => syntaxElementToken(item)
    case None => None
  end
end

func syntaxElementToken(item: SyntaxElement) -> Option[SyntaxToken]
  switch item
    case SyntaxTokenElement(token) => Some(token)
    case _ => None
  end
end

func syntaxTokenKind(token: SyntaxToken) -> GreenTokenKind
  token.Token.Kind
end

func syntaxTokenRaw(token: SyntaxToken) -> String
  token.Token.Raw
end

func syntaxTokenSpan(token: SyntaxToken) -> ps.SourceSpan
  token.Token.Span
end

func syntaxNodeParent(node: SyntaxNode) -> Option[SyntaxNode]
  if node.Path.Len() == 0 then
    None
  else
    switch node.Path.Slice(0, node.Path.Len() - 1)
      case Some(path) => syntaxNodeAtPath(node.Root, path, 0)
      case None => None
    end
  end
end

func syntaxNodePreviousSibling(node: SyntaxNode) -> Option[SyntaxNode]
  syntaxNodeSibling(node, -1)
end

func syntaxNodeNextSibling(node: SyntaxNode) -> Option[SyntaxNode]
  syntaxNodeSibling(node, 1)
end

func syntaxNodeSibling(node: SyntaxNode, step: Int) -> Option[SyntaxNode]
  if node.Path.Len() == 0 then
    None
  else
    switch (syntaxNodeParent(node), node.Path.Get(node.Path.Len() - 1))
      case (Some(parent), Some(index)) => syntaxNodeSiblingFrom(parent, index + step, step)
      case _ => None
    end
  end
end

func syntaxNodeSiblingFrom(parent: SyntaxNode, index: Int, step: Int) -> Option[SyntaxNode]
  if index < 0 || index >= syntaxNodeChildCount(parent) then
    None
  else
    switch syntaxNodeChild(parent, index)
      case Some(sibling) => Some(sibling)
      case None => syntaxNodeSiblingFrom(parent, index + step, step)
    end
  end
end

func syntaxNodeAtPath(root: Ref[GreenNode], path: Slice[Int], index: Int) -> Option[SyntaxNode]
  syntaxNodeAtPathFrom(root, root, path, index, [])
end

func syntaxNodeAtPathFrom(root: Ref[GreenNode], current: Ref[GreenNode], path: Slice[Int], index: Int, walked: Slice[Int]) -> Option[SyntaxNode]
  if index >= path.Len() then
    Some(SyntaxNode { Root: root, Node: current, Path: walked })
  else
    switch path.Get(index)
      case Some(childIndex) then
        switch current.value().Children.Get(childIndex)
          case Some(item) then
            switch greenElementNode(item)
              case Some(child) => syntaxNodeAtPathFrom(root, child, path, index + 1, walked.Append(childIndex))
              case None => None
            end
          end
          case _ => None
        end
      end
      case None => None
    end
  end
end

# These accessors are the semantic CST contract consumed by lowering.  They
# only inspect direct, typed CST children; lowering must not rediscover
# semantic ownership by scanning source text or arbitrary descendants.
func syntaxNodeFirstChildOfKind(node: SyntaxNode, kind: GreenNodeKind) -> Option[SyntaxNode]
  syntaxNodeFirstChildOfKindFrom(node, kind, 0)
end

func syntaxNodeFirstChildOfKindFrom(node: SyntaxNode, kind: GreenNodeKind, index: Int) -> Option[SyntaxNode]
  if index >= syntaxNodeChildCount(node) then
    None
  else
    switch syntaxNodeChild(node, index)
      case Some(child) then
        if syntaxNodeKind(child) == kind then
          Some(child)
        else
          syntaxNodeFirstChildOfKindFrom(node, kind, index + 1)
        end
      end
      case None => syntaxNodeFirstChildOfKindFrom(node, kind, index + 1)
    end
  end
end

func syntaxDeclarationName(node: SyntaxNode) -> Option[SyntaxNode]
  syntaxNodeFirstChildOfKind(node, GreenNodeKind.IdentifierExpr)
end

func syntaxDeclarationPattern(node: SyntaxNode) -> Option[SyntaxNode]
  syntaxNodeFirstPatternChildOfKind(node, 0)
end

func syntaxNodeFirstPatternChildOfKind(node: SyntaxNode, index: Int) -> Option[SyntaxNode]
  if index >= syntaxNodeChildCount(node) then
    None
  else
    switch syntaxNodeChild(node, index)
      case Some(child) then
        if greenNodeIsPatternKind(syntaxNodeKind(child)) then
          Some(child)
        else
          syntaxNodeFirstPatternChildOfKind(node, index + 1)
        end
      end
      case None => syntaxNodeFirstPatternChildOfKind(node, index + 1)
    end
  end
end

func syntaxDeclarationTypeAnnotation(node: SyntaxNode) -> Option[SyntaxNode]
  syntaxNodeFirstChildOfKind(node, GreenNodeKind.TypeAnnotation)
end

func syntaxDeclarationInitializer(node: SyntaxNode) -> Option[SyntaxNode]
  syntaxNodeFirstChildOfKind(node, GreenNodeKind.ValueInitializer)
end

func syntaxFunctionParameters(node: SyntaxNode) -> Option[SyntaxNode]
  syntaxNodeFirstChildOfKind(node, GreenNodeKind.FunctionParameters)
end

func syntaxFunctionReturnType(node: SyntaxNode) -> Option[SyntaxNode]
  syntaxNodeFirstChildOfKind(node, GreenNodeKind.FunctionReturnType)
end

func syntaxTypeAnnotationValue(node: SyntaxNode) -> Option[SyntaxNode]
  syntaxNodeFirstTypedChild(node)
end

func syntaxInitializerExpression(node: SyntaxNode) -> Option[SyntaxNode]
  syntaxNodeFirstTypedChild(node)
end

func syntaxNodeFirstTypedChild(node: SyntaxNode) -> Option[SyntaxNode]
  syntaxNodeFirstTypedChildFrom(node, 0)
end

func syntaxNodeFirstTypedChildFrom(node: SyntaxNode, index: Int) -> Option[SyntaxNode]
  if index >= syntaxNodeChildCount(node) then
    None
  else
    switch syntaxNodeChild(node, index)
      case Some(child) then
        if syntaxNodeIsSemanticKind(syntaxNodeKind(child)) then
          Some(child)
        else
          syntaxNodeFirstTypedChildFrom(node, index + 1)
        end
      end
      case None => syntaxNodeFirstTypedChildFrom(node, index + 1)
    end
  end
end

func syntaxNodeIsSemanticKind(kind: GreenNodeKind) -> Bool
  kind == GreenNodeKind.IdentifierExpr || kind == GreenNodeKind.NumberExpr || kind == GreenNodeKind.BoolExpr || kind == GreenNodeKind.StringExpr || kind == GreenNodeKind.RuneExpr || kind == GreenNodeKind.ParenExpr || kind == GreenNodeKind.TupleExpr || kind == GreenNodeKind.UnitExpr || kind == GreenNodeKind.InlineGoExpr || kind == GreenNodeKind.Call || kind == GreenNodeKind.UnaryExpr || kind == GreenNodeKind.BinaryExpr || kind == GreenNodeKind.FieldExpr || kind == GreenNodeKind.TypeAsExpr || kind == GreenNodeKind.Type || kind == GreenNodeKind.NamedType || kind == GreenNodeKind.TupleType || kind == GreenNodeKind.GenericType || kind == GreenNodeKind.Pattern || kind == GreenNodeKind.BindPattern || kind == GreenNodeKind.WildcardPattern || kind == GreenNodeKind.LiteralPattern || kind == GreenNodeKind.TuplePattern || kind == GreenNodeKind.VariantPattern || kind == GreenNodeKind.StructVariantPattern || kind == GreenNodeKind.Expression || kind == GreenNodeKind.SliceLiteral || kind == GreenNodeKind.MapLiteral || kind == GreenNodeKind.SetLiteral || kind == GreenNodeKind.StructLiteral || kind == GreenNodeKind.StructLitField || kind == GreenNodeKind.IfBlock || kind == GreenNodeKind.SwitchBlock || kind == GreenNodeKind.WhileBlock
end

# This closed predicate is the lowering frontier for task 3.1.  It is kept
# separate from syntaxNodeIsSemanticKind: the latter describes CST structure,
# while this one describes only node kinds that LowerSyntax can currently turn
# into ast2 without using the legacy parser.
func syntaxLoweringSupportsNodeKind(kind: GreenNodeKind) -> Bool
  kind == GreenNodeKind.File || kind == GreenNodeKind.PackageDeclaration || kind == GreenNodeKind.ImportDeclaration || kind == GreenNodeKind.LetDeclaration || kind == GreenNodeKind.VarDeclaration || kind == GreenNodeKind.FuncDeclaration || kind == GreenNodeKind.TypeDeclaration || kind == GreenNodeKind.StructDeclaration || kind == GreenNodeKind.EnumDeclaration || kind == GreenNodeKind.InterfaceDeclaration || kind == GreenNodeKind.ImplDeclaration || kind == GreenNodeKind.TypeParameters || kind == GreenNodeKind.StructField || kind == GreenNodeKind.EnumVariant || kind == GreenNodeKind.FuncSignature || kind == GreenNodeKind.ImplMethod || kind == GreenNodeKind.FunctionParameters || kind == GreenNodeKind.FunctionReturnType || kind == GreenNodeKind.TypeAnnotation || kind == GreenNodeKind.ValueInitializer || kind == GreenNodeKind.IdentifierExpr || kind == GreenNodeKind.NumberExpr || kind == GreenNodeKind.BoolExpr || kind == GreenNodeKind.StringExpr || kind == GreenNodeKind.RuneExpr || kind == GreenNodeKind.ParenExpr || kind == GreenNodeKind.TupleExpr || kind == GreenNodeKind.UnitExpr || kind == GreenNodeKind.InlineGoExpr || kind == GreenNodeKind.FuncLitExpr || kind == GreenNodeKind.Call || kind == GreenNodeKind.UnaryExpr || kind == GreenNodeKind.BinaryExpr || kind == GreenNodeKind.FieldExpr || kind == GreenNodeKind.TypeAsExpr || kind == GreenNodeKind.NamedType || kind == GreenNodeKind.GenericType || kind == GreenNodeKind.TupleType || kind == GreenNodeKind.UnitType || kind == GreenNodeKind.FuncType || kind == GreenNodeKind.Constraint || kind == GreenNodeKind.Constraints || kind == GreenNodeKind.SliceLiteral || kind == GreenNodeKind.MapLiteral || kind == GreenNodeKind.SetLiteral || kind == GreenNodeKind.StructLiteral || kind == GreenNodeKind.StructLitField || kind == GreenNodeKind.BindPattern || kind == GreenNodeKind.WildcardPattern || kind == GreenNodeKind.LiteralPattern || kind == GreenNodeKind.TuplePattern || kind == GreenNodeKind.VariantPattern || kind == GreenNodeKind.StructVariantPattern || kind == GreenNodeKind.StructPatternField || kind == GreenNodeKind.IfBlock || kind == GreenNodeKind.SwitchBlock || kind == GreenNodeKind.WhileBlock || kind == GreenNodeKind.Block || kind == GreenNodeKind.ExprStatement || kind == GreenNodeKind.LetStatement || kind == GreenNodeKind.VarStatement || kind == GreenNodeKind.TupleLetStatement || kind == GreenNodeKind.AssignStatement || kind == GreenNodeKind.ReturnStatement || kind == GreenNodeKind.BreakStatement || kind == GreenNodeKind.ContinueStatement || kind == GreenNodeKind.LetRecStatement || kind == GreenNodeKind.LetRecBinding
end

# LexedSource is the lexer boundary used by both CST construction and the
# temporary LosslessFile compatibility adapter. Elements retain source order;
# the categorized slices are indexes, not a second source representation.
struct LexedSource
  Elements: Slice[GreenElement]
  Tokens: Slice[GreenToken]
  Trivia: Slice[GreenTrivia]
end

struct LexerState
  Input: String
  Index: Int
  Offset: Int
  Line: Int
  Column: Int
  Elements: Slice[GreenElement]
  Tokens: Slice[GreenToken]
  Trivia: Slice[GreenTrivia]
end

# DelimitedBuildResult makes the lossless structural pass total: an unmatched
# opener remains a leaf and therefore never causes source text to disappear.
struct DelimitedBuildResult
  Children: Option[List[GreenElement]]
  Next: Int
  Close: Option[GreenElement]
end

struct DeclarationPatternResult
  Element: GreenElement
  Next: Int
end

# FuncLitSignature carries the classified signature of a `func` literal between
# its parameter group and its body: where the body begins, the trivia gap that
# follows the parameter group, and the optional return-type node.
struct FuncLitSignature
  BodyStart: Int
  Return: Option[GreenElement]
  Gap: Slice[GreenElement]
end

# SyntaxCursor is the CST parser input.  It walks the lexer-owned ordered
# leaves; trivia is skipped only for grammar decisions and remains in every
# source-range slice used to freeze a green node.
struct SyntaxCursor
  Elements: Slice[GreenElement]
  Index: Int
end

struct SyntaxParseResult
  Node: Option[Ref[GreenNode]]
  Cursor: SyntaxCursor
end

# Recovery tracks only grammar synchronization state. It never drops source
# leaves: diagnostics later turn the responsible leaves into Error nodes.
struct SyntaxBlock
  Keyword: String
  Close: String
  Span: ps.SourceSpan
end

struct SyntaxRecoveryState
  Delimiters: Slice[GreenElement]
  Blocks: Slice[SyntaxBlock]
  Diagnostics: Slice[SyntaxDiagnostic]
end

func sourceSpanContains(outer: ps.SourceSpan, inner: ps.SourceSpan) -> Bool
  outer.Start.Offset <= inner.Start.Offset && inner.End.Offset <= outer.End.Offset
end

func sourceSpanIsOrdered(span: ps.SourceSpan) -> Bool
  span.Start.Offset <= span.End.Offset &&
    (span.Start.Line < span.End.Line ||
      (span.Start.Line == span.End.Line && span.Start.Column <= span.End.Column))
end

func greenElementSpan(item: GreenElement) -> ps.SourceSpan
  switch item
    case TokenElement(token) => token.Span
    case TriviaElement(trivia) => trivia.Span
    case NodeElement(node) => node.value().Span
  end
end

func greenElementIsOrdered(item: GreenElement) -> Bool
  sourceSpanIsOrdered(greenElementSpan(item))
end

func greenNodeChildrenFit(node: GreenNode) -> Bool
  node.Children.Fold(true, func(valid: Bool, item: GreenElement) -> Bool
    valid && greenElementIsOrdered(item) && sourceSpanContains(node.Span, greenElementSpan(item))
  end)
end

func LexSource(input: String) -> LexedSource
  lexStep(LexerState {
    Input: input,
    Index: 0,
    Offset: 0,
    Line: 1,
    Column: 1,
    Elements: [],
    Tokens: [],
    Trivia: [],
  })
end

# ParseSyntax is the recovery-capable entry point. It always returns the
# lossless tree; callers inspect Diagnostics before semantic lowering.
func ParseSyntax(input: String) -> SyntaxTree
  ParseSyntaxAt("<input>", input)
end

func ParseSyntaxAt(sourceName: String, input: String) -> SyntaxTree
  buildDelimitedSyntax(sourceName, input)
end

struct SyntaxLowerState
  PackageName: String
  Decls: Slice[ast2.Decl]
  Positions: Slice[ast2.SourcePos]
end

func LowerSyntax(tree: SyntaxTree) -> Result[ast2.File, String]
  if tree.Diagnostics.Len() != 0 || greenNodeHasError(tree.Root.value()) then
    Err("syntax diagnostics prevent AST lowering")
  else
    switch lowerSyntaxDeclarations(tree, tree.Root.value().Children, 0, SyntaxLowerState { PackageName: "", Decls: [], Positions: [] })
      case Err(message) => Err(message)
      case Ok(state) => Ok(ast2.File {
        PackageName: state.PackageName,
        Decls: state.Decls,
        SourceName: tree.SourceName,
        Line: 1,
        Column: 1,
        DeclPositions: state.Positions,
        Span: syntaxAstSpan(tree.SourceName, tree.Root.value().Span),
      })
    end
  end
end

func greenNodeHasError(node: GreenNode) -> Bool
  node.HasError || node.Children.Find(func(item: GreenElement) -> Bool
    switch item
      case NodeElement(child) => greenNodeHasError(child.value())
      case _ => false
    end
  end).IsSome()
end

func lowerSyntaxDeclarations(tree: SyntaxTree, items: Slice[GreenElement], index: Int, state: SyntaxLowerState) -> Result[SyntaxLowerState, String]
  if index >= items.Len() then
    Ok(state)
  else
    switch items.Get(index)
      case Some(item) then
        switch greenElementNode(item)
          case Some(node) then
            if node.value().Kind == GreenNodeKind.PackageDeclaration then
              lowerSyntaxDeclarations(tree, items, index + 1, SyntaxLowerState { PackageName: greenNodeFirstIdentifier(node.value()), Decls: state.Decls, Positions: state.Positions })
            elsif node.value().Kind == GreenNodeKind.LetDeclaration || node.value().Kind == GreenNodeKind.VarDeclaration then
              switch lowerSyntaxBinding(tree, node)
                case Ok(decl) => lowerSyntaxDeclarations(tree, items, index + 1, SyntaxLowerState { PackageName: state.PackageName, Decls: state.Decls.Append(decl), Positions: state.Positions.Append(syntaxAstPos(tree.SourceName, node.value().Span.Start)) })
                case Err(message) => Err(message)
              end
            elsif node.value().Kind == GreenNodeKind.FuncDeclaration then
              switch lowerSyntaxFunction(tree, node)
                case Ok(decl) => lowerSyntaxDeclarations(tree, items, index + 1, SyntaxLowerState { PackageName: state.PackageName, Decls: state.Decls.Append(decl), Positions: state.Positions.Append(syntaxAstPos(tree.SourceName, node.value().Span.Start)) })
                case Err(message) => Err(message)
              end
            elsif node.value().Kind == GreenNodeKind.TypeDeclaration then
              switch lowerSyntaxTypeDeclaration(node)
                case Ok(decl) => lowerSyntaxDeclarations(tree, items, index + 1, SyntaxLowerState { PackageName: state.PackageName, Decls: state.Decls.Append(decl), Positions: state.Positions.Append(syntaxAstPos(tree.SourceName, node.value().Span.Start)) })
                case Err(message) => Err(message)
              end
            elsif node.value().Kind == GreenNodeKind.ImportDeclaration then
              switch lowerSyntaxImportDeclaration(node)
                case Ok(decl) => lowerSyntaxDeclarations(tree, items, index + 1, SyntaxLowerState { PackageName: state.PackageName, Decls: state.Decls.Append(decl), Positions: state.Positions.Append(syntaxAstPos(tree.SourceName, node.value().Span.Start)) })
                case Err(message) => Err(message)
              end
            elsif node.value().Kind == GreenNodeKind.StructDeclaration then
              switch lowerSyntaxStructDeclaration(tree, node)
                case Ok(decl) => lowerSyntaxDeclarations(tree, items, index + 1, SyntaxLowerState { PackageName: state.PackageName, Decls: state.Decls.Append(decl), Positions: state.Positions.Append(syntaxAstPos(tree.SourceName, node.value().Span.Start)) })
                case Err(message) => Err(message)
              end
            elsif node.value().Kind == GreenNodeKind.EnumDeclaration then
              switch lowerSyntaxEnumDeclaration(tree, node)
                case Ok(decl) => lowerSyntaxDeclarations(tree, items, index + 1, SyntaxLowerState { PackageName: state.PackageName, Decls: state.Decls.Append(decl), Positions: state.Positions.Append(syntaxAstPos(tree.SourceName, node.value().Span.Start)) })
                case Err(message) => Err(message)
              end
            elsif node.value().Kind == GreenNodeKind.InterfaceDeclaration then
              switch lowerSyntaxInterfaceDeclaration(tree, node)
                case Ok(decl) => lowerSyntaxDeclarations(tree, items, index + 1, SyntaxLowerState { PackageName: state.PackageName, Decls: state.Decls.Append(decl), Positions: state.Positions.Append(syntaxAstPos(tree.SourceName, node.value().Span.Start)) })
                case Err(message) => Err(message)
              end
            elsif node.value().Kind == GreenNodeKind.ImplDeclaration then
              switch lowerSyntaxImplDeclaration(tree, node)
                case Ok(decl) => lowerSyntaxDeclarations(tree, items, index + 1, SyntaxLowerState { PackageName: state.PackageName, Decls: state.Decls.Append(decl), Positions: state.Positions.Append(syntaxAstPos(tree.SourceName, node.value().Span.Start)) })
                case Err(message) => Err(message)
              end
            elsif greenNodeIsDeclarationKind(node.value().Kind) then
              Err("CST declaration kind is not lowered yet")
            else
              Err("CST top-level node kind is not lowered yet")
            end
          end
          case None => lowerSyntaxDeclarations(tree, items, index + 1, state)
        end
      end
      case None => Ok(state)
    end
  end
end

func lowerSyntaxTypeDeclaration(node: Ref[GreenNode]) -> Result[ast2.Decl, String]
  switch greenNodeFindChild(node.value(), GreenNodeKind.TypeAnnotation, 0)
    case Some(annotation) then
      switch lowerSyntaxTypeOption(annotation.value())
        case Some(typ) then
          let name = greenNodeFirstIdentifier(node.value())
          let params = lowerSyntaxTypeParams(node.value())
          if strings.HasPrefix(greenNodeText(annotation.value()), "=") then
            Ok(ast2.Decl.TypeAliasDecl(name, params, typ))
          else
            Ok(ast2.Decl.TypeDecl(name, params, typ))
          end
        end
        case None => Err("type declaration CST type is not lowered yet")
      end
    end
    case None => Err("type declaration CST lacks right hand side")
  end
end

# lowerSyntaxTypeParams reads the declaration's optional TypeParameters node
# into the legacy string shape, including HKT arguments (`C[A]`).
func lowerSyntaxTypeParams(node: GreenNode) -> Slice[String]
  switch greenNodeFindChild(node, GreenNodeKind.TypeParameters, 0)
    case Some(group) => lowerSyntaxTypeParamChildren(group.value(), 0, [])
    case None => []
  end
end

func lowerSyntaxTypeParamChildren(node: GreenNode, index: Int, output: Slice[String]) -> Slice[String]
  if index >= node.Children.Len() then
    output
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if greenNodeIsTypeKind(child.value().Kind) then
          lowerSyntaxTypeParamChildren(node, index + 1, output.Append(lowerSyntaxTypeParamText(child.value())))
        else
          lowerSyntaxTypeParamChildren(node, index + 1, output)
        end
      end
      case None => lowerSyntaxTypeParamChildren(node, index + 1, output)
    end
  end
end

# A type parameter is a bare name or an HKT application `C[A, B]`.  The nested
# generic arguments are rendered in the established source shape so inference
# keeps its kind information.
func lowerSyntaxTypeParamText(node: GreenNode) -> String
  switch (greenNodeFindChild(node, GreenNodeKind.NamedType, 0), greenNodeFindChild(node, GreenNodeKind.TypeArguments, 0))
    case (Some(base), Some(arguments)) => greenNodeText(base.value()) + "[" + strings.Join(lowerSyntaxTypeParamChildren(arguments.value(), 0, []), ", ") + "]"
    case _ => greenNodeText(node)
  end
end

func lowerSyntaxImportDeclaration(node: Ref[GreenNode]) -> Result[ast2.Decl, String]
  let path = syntaxStringLeafText(node.value())
  if path == "" then
    Err("import declaration CST lacks a path literal")
  else
    let alias = greenNodeFirstIdentifier(node.value())
    if alias == "" then
      Ok(ast2.Decl.ImportDecl(defaultImportAlias(path), path))
    else
      Ok(ast2.Decl.ImportDecl(alias, path))
    end
  end
end

# syntaxStringLeafText returns the decoded content of the first string literal
# leaf inside a node, or "" when the node owns no literal.
func syntaxStringLeafText(node: GreenNode) -> String
  switch syntaxStringLeafRaw(node, 0)
    case Some(raw) => syntaxStringContent(raw).UnwrapOr("")
    case None => ""
  end
end

func syntaxStringLeafRaw(node: GreenNode, index: Int) -> Option[String]
  if index >= node.Children.Len() then
    None
  else
    let item = greenElementAt(node.Children, index)
    if greenElementIsStringLiteral(item) then
      Some(greenElementRaw(item))
    else
      syntaxStringLeafRaw(node, index + 1)
    end
  end
end

func lowerSyntaxStructDeclaration(tree: SyntaxTree, node: Ref[GreenNode]) -> Result[ast2.Decl, String]
  switch lowerSyntaxFields(tree, node.value(), GreenNodeKind.StructField, 0, [])
    case Ok(fields) => Ok(ast2.Decl.StructDecl(greenNodeFirstIdentifier(node.value()), lowerSyntaxTypeParams(node.value()), fields))
    case Err(message) => Err(message)
  end
end

func lowerSyntaxEnumDeclaration(tree: SyntaxTree, node: Ref[GreenNode]) -> Result[ast2.Decl, String]
  switch lowerSyntaxVariants(tree, node.value(), 0, [])
    case Ok(variants) => Ok(ast2.Decl.EnumDecl(greenNodeFirstIdentifier(node.value()), lowerSyntaxTypeParams(node.value()), variants))
    case Err(message) => Err(message)
  end
end

func lowerSyntaxInterfaceDeclaration(tree: SyntaxTree, node: Ref[GreenNode]) -> Result[ast2.Decl, String]
  switch lowerSyntaxSignatures(tree, node.value(), GreenNodeKind.FuncSignature, 0, [])
    case Ok(methods) => Ok(ast2.Decl.InterfaceDecl(greenNodeFirstIdentifier(node.value()), lowerSyntaxTypeParams(node.value()), methods))
    case Err(message) => Err(message)
  end
end

func lowerSyntaxImplDeclaration(tree: SyntaxTree, node: Ref[GreenNode]) -> Result[ast2.Decl, String]
  switch lowerSyntaxImplTarget(node.value()) 
    case Some(target) then
      switch lowerSyntaxImplMethods(tree, node.value(), 0, [])
        case Ok(methods) => Ok(ast2.Decl.ImplDecl(lowerSyntaxTypeParams(node.value()), target, lowerSyntaxImplInterface(node.value()), methods))
        case Err(message) => Err(message)
      end
    end
    case None => Err("impl declaration CST lacks a target type")
  end
end

# The impl target is the first concrete type node in the header; the optional
# `: Interface` clause is the TypeAnnotation child, whose type node is the
# interface name.
func lowerSyntaxImplTarget(node: GreenNode) -> Option[ast2.TypeExpr]
  switch greenNodeFindTypeChild(node, 0)
    case Some(typ) => lowerSyntaxTypeNode(typ.value())
    case None => None
  end
end

func lowerSyntaxImplInterface(node: GreenNode) -> Option[ast2.TypeExpr]
  switch greenNodeFindChild(node, GreenNodeKind.TypeAnnotation, 0)
    case Some(annotation) => lowerSyntaxTypeOption(annotation.value())
    case None => None
  end
end

func lowerSyntaxFunction(tree: SyntaxTree, node: Ref[GreenNode]) -> Result[ast2.Decl, String]
  switch greenNodeFindChild(node.value(), GreenNodeKind.FunctionParameters, 0)
    case Some(parameters) then
      let paramsResult = lowerSyntaxParameters(tree, parameters.value().Children, 0, None, [])
      let bodyResult = lowerSyntaxFunctionBody(tree, node.value())
      switch (paramsResult, bodyResult)
        case (Ok(params), Ok(body)) => Ok(ast2.Decl.FuncDecl(greenNodeFirstIdentifier(node.value()), lowerSyntaxTypeParams(node.value()), params, lowerSyntaxFunctionReturn(tree, node.value()), body, lowerSyntaxConstraints(node.value())))
        case (Err(message), _) => Err(message)
        case (_, Err(message)) => Err(message)
      end
    end
    case None => Err("function CST lacks parameter or body boundary")
  end
end

# lowerSyntaxFunctionBody lowers either an arrow body (a ValueInitializer) or a
# block body (a Block node of statements).  The block keeps its own span so the
# function body range matches the source between the signature and the closing
# end, mirroring the legacy blockUntil result.
func lowerSyntaxFunctionBody(tree: SyntaxTree, node: GreenNode) -> Result[ast2.Expr, String]
  switch greenNodeFindChild(node, GreenNodeKind.ValueInitializer, 0)
    case Some(initializer) => lowerSyntaxExpr(tree, initializer)
    case None then
      switch greenNodeFindChild(node, GreenNodeKind.Block, 0)
        case Some(block) => lowerSyntaxExpressionNode(tree, block.value())
        case None => Err("function CST lacks a body boundary")
      end
    end
  end
end

# lowerSyntaxFields reads struct members in source order.  Each StructField owns
# its name (or the literal `embed` marker), its annotated type, and an optional
# tag literal, so every ast2.Field span derives from green ranges.
func lowerSyntaxFields(tree: SyntaxTree, node: GreenNode, kind: GreenNodeKind, index: Int, output: Slice[ast2.Field]) -> Result[Slice[ast2.Field], String]
  if index >= node.Children.Len() then
    Ok(output)
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if child.value().Kind == kind then
          switch lowerSyntaxField(tree, child.value())
            case Ok(field) => lowerSyntaxFields(tree, node, kind, index + 1, output.Append(field))
            case Err(message) => Err(message)
          end
        else
          lowerSyntaxFields(tree, node, kind, index + 1, output)
        end
      end
      case None => lowerSyntaxFields(tree, node, kind, index + 1, output)
    end
  end
end

func lowerSyntaxField(tree: SyntaxTree, node: GreenNode) -> Result[ast2.Field, String]
  switch greenNodeFindChild(node, GreenNodeKind.TypeAnnotation, 0)
    case Some(annotation) then
      switch lowerSyntaxTypeOption(annotation.value())
        case Some(typ) => Ok(ast2.Field {
          Name: lowerSyntaxFieldName(node),
          Type: typ,
          TypeSpan: syntaxAstSpan(tree.SourceName, annotation.value().Span),
          Tag: syntaxStringLeafTextOption(node),
          Span: syntaxAstSpan(tree.SourceName, node.Span),
        })
        case None => Err("struct field CST type is not lowered yet")
      end
    end
    case None then
      # An embedded field (`embed T`) has no `name: type` annotation; its type
      # is the bare type node that follows the `embed` marker.
      switch greenNodeFindTypeChild(node, 0)
        case Some(typ) then
          switch lowerSyntaxTypeNode(typ.value())
            case Some(lowered) => Ok(ast2.Field {
              Name: lowerSyntaxFieldName(node),
              Type: lowered,
              TypeSpan: syntaxAstSpan(tree.SourceName, typ.value().Span),
              Tag: syntaxStringLeafTextOption(node),
              Span: syntaxAstSpan(tree.SourceName, node.Span),
            })
            case None => Err("embedded struct field CST type is not lowered yet")
          end
        end
        case None => Err("struct field CST lacks a type annotation")
      end
    end
  end
end

# An embedded field has no name identifier; the legacy AST records the literal
# `embed` marker in that slot.
func lowerSyntaxFieldName(node: GreenNode) -> String
  let name = greenNodeFirstIdentifier(node)
  if name == "" => "embed" else name
end

func syntaxStringLeafTextOption(node: GreenNode) -> Option[String]
  switch syntaxStringLeafRaw(node, 0)
    case Some(raw) => syntaxStringContent(raw)
    case None => None
  end
end

func lowerSyntaxVariants(tree: SyntaxTree, node: GreenNode, index: Int, output: Slice[ast2.Variant]) -> Result[Slice[ast2.Variant], String]
  if index >= node.Children.Len() then
    Ok(output)
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if child.value().Kind == GreenNodeKind.EnumVariant then
          switch lowerSyntaxVariant(tree, child.value())
            case Ok(variant) => lowerSyntaxVariants(tree, node, index + 1, output.Append(variant))
            case Err(message) => Err(message)
          end
        else
          lowerSyntaxVariants(tree, node, index + 1, output)
        end
      end
      case None => lowerSyntaxVariants(tree, node, index + 1, output)
    end
  end
end

# lowerSyntaxVariant distinguishes tuple variants (`Name(A, B)`) from named
# variants (`Name { a: A, b: B }`).  Tuple fields come from the ParenGroup's
# typed items; named fields pair each IdentifierExpr with its TypeAnnotation.
func lowerSyntaxVariant(tree: SyntaxTree, node: GreenNode) -> Result[ast2.Variant, String]
  switch greenNodeFindChild(node, GreenNodeKind.BraceGroup, 0)
    case Some(group) then
      switch lowerSyntaxNamedVariantFields(tree, group.value(), 0, [], []) 
        case Ok(pair) => Ok(ast2.Variant {
          Name: greenNodeFirstIdentifier(node),
          Fields: pair.F0,
          FieldSpans: pair.F1,
          Named: true,
          Names: lowerSyntaxNamedVariantNames(group.value(), 0, []),
          Span: syntaxAstSpan(tree.SourceName, node.Span),
        })
        case Err(message) => Err(message)
      end
    end
    case None then
      switch greenNodeFindChild(node, GreenNodeKind.ParenGroup, 0)
        case Some(group) => Ok(ast2.Variant {
          Name: greenNodeFirstIdentifier(node),
          Fields: lowerSyntaxTypeChildren(group.value(), 0, []),
          FieldSpans: lowerSyntaxTypeChildSpans(tree, group.value(), 0, []),
          Named: false,
          Names: [],
          Span: syntaxAstSpan(tree.SourceName, node.Span),
        })
        case None => Ok(ast2.Variant {
          Name: greenNodeFirstIdentifier(node),
          Fields: [],
          FieldSpans: [],
          Named: false,
          Names: [],
          Span: syntaxAstSpan(tree.SourceName, node.Span),
        })
      end
    end
  end
end

func lowerSyntaxTypeChildSpans(tree: SyntaxTree, node: GreenNode, index: Int, output: Slice[ast2.SourceSpan]) -> Slice[ast2.SourceSpan]
  if index >= node.Children.Len() then
    output
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if greenNodeIsTypeKind(child.value().Kind) then
          lowerSyntaxTypeChildSpans(tree, node, index + 1, output.Append(syntaxAstSpan(tree.SourceName, child.value().Span)))
        else
          lowerSyntaxTypeChildSpans(tree, node, index + 1, output)
        end
      end
      case None => lowerSyntaxTypeChildSpans(tree, node, index + 1, output)
    end
  end
end

func lowerSyntaxNamedVariantFields(tree: SyntaxTree, group: GreenNode, index: Int, fields: Slice[ast2.TypeExpr], spans: Slice[ast2.SourceSpan]) -> Result[(Slice[ast2.TypeExpr], Slice[ast2.SourceSpan]), String]
  if index >= group.Children.Len() then
    Ok((fields, spans))
  else
    switch greenElementNode(greenElementAt(group.Children, index))
      case Some(child) then
        if child.value().Kind == GreenNodeKind.TypeAnnotation then
          switch lowerSyntaxTypeOption(child.value())
            case Some(typ) => lowerSyntaxNamedVariantFields(tree, group, index + 1, fields.Append(typ), spans.Append(syntaxAstSpan(tree.SourceName, child.value().Span)))
            case None => Err("named variant field CST type is not lowered yet")
          end
        else
          lowerSyntaxNamedVariantFields(tree, group, index + 1, fields, spans)
        end
      end
      case None => lowerSyntaxNamedVariantFields(tree, group, index + 1, fields, spans)
    end
  end
end

func lowerSyntaxNamedVariantNames(group: GreenNode, index: Int, output: Slice[String]) -> Slice[String]
  if index >= group.Children.Len() then
    output
  else
    switch greenElementNode(greenElementAt(group.Children, index))
      case Some(child) then
        if child.value().Kind == GreenNodeKind.IdentifierExpr then
          lowerSyntaxNamedVariantNames(group, index + 1, output.Append(greenNodeText(child.value())))
        else
          lowerSyntaxNamedVariantNames(group, index + 1, output)
        end
      end
      case None => lowerSyntaxNamedVariantNames(group, index + 1, output)
    end
  end
end

func lowerSyntaxSignatures(tree: SyntaxTree, node: GreenNode, kind: GreenNodeKind, index: Int, output: Slice[ast2.FuncSig]) -> Result[Slice[ast2.FuncSig], String]
  if index >= node.Children.Len() then
    Ok(output)
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if child.value().Kind == kind then
          switch lowerSyntaxSignature(tree, child.value())
            case Ok(sig) => lowerSyntaxSignatures(tree, node, kind, index + 1, output.Append(sig))
            case Err(message) => Err(message)
          end
        else
          lowerSyntaxSignatures(tree, node, kind, index + 1, output)
        end
      end
      case None => lowerSyntaxSignatures(tree, node, kind, index + 1, output)
    end
  end
end

# lowerSyntaxSignature lowers a bare `func` signature (interface member or impl
# method).  The signature has no body of its own here; an impl method's body is
# owned by the enclosing ImplMethod node and is lowered separately.
func lowerSyntaxSignature(tree: SyntaxTree, node: GreenNode) -> Result[ast2.FuncSig, String]
  switch (greenNodeFindChild(node, GreenNodeKind.FunctionParameters, 0), greenNodeFindChild(node, GreenNodeKind.FunctionReturnType, 0))
    case (Some(parameters), returned) then
      switch lowerSyntaxParameters(tree, parameters.value().Children, 0, None, [])
        case Ok(params) => Ok(ast2.FuncSig {
          Pos: syntaxAstPos(tree.SourceName, node.Span.Start),
          Name: greenNodeFirstIdentifier(node),
          TypeParams: lowerSyntaxTypeParams(node),
          Params: params,
          Ret: lowerSyntaxReturnOption(tree, returned),
          RetSpan: lowerSyntaxReturnSpan(tree, node, returned),
          Using: lowerSyntaxConstraints(node),
        })
        case Err(message) => Err(message)
      end
    end
    case (None, _) => Err("function signature CST lacks parameters")
  end
end

func lowerSyntaxReturnOption(tree: SyntaxTree, returned: Option[Ref[GreenNode]]) -> Option[ast2.TypeExpr]
  switch returned
    case Some(node) => lowerSyntaxTypeOption(node.value())
    case None => None
  end
end

func lowerSyntaxReturnSpan(tree: SyntaxTree, node: GreenNode, returned: Option[Ref[GreenNode]]) -> ast2.SourceSpan
  switch returned
    case Some(annotation) => syntaxAstSpan(tree.SourceName, annotation.value().Span)
    case None => syntaxAstSpan(tree.SourceName, node.Span)
  end
end

func lowerSyntaxImplMethods(tree: SyntaxTree, node: GreenNode, index: Int, output: Slice[ast2.ImplMethod]) -> Result[Slice[ast2.ImplMethod], String]
  if index >= node.Children.Len() then
    Ok(output)
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if child.value().Kind == GreenNodeKind.ImplMethod then
          switch lowerSyntaxImplMethod(tree, child.value())
            case Ok(method) => lowerSyntaxImplMethods(tree, node, index + 1, output.Append(method))
            case Err(message) => Err(message)
          end
        else
          lowerSyntaxImplMethods(tree, node, index + 1, output)
        end
      end
      case None => lowerSyntaxImplMethods(tree, node, index + 1, output)
    end
  end
end

# lowerSyntaxImplMethod lowers the method signature and its block body through
# the same function-body path a top-level func uses.  A signature-only method
# (an interface-style member with no body) lowers to an empty body.
func lowerSyntaxImplMethod(tree: SyntaxTree, node: GreenNode) -> Result[ast2.ImplMethod, String]
  switch lowerSyntaxSignature(tree, node)
    case Ok(sig) then
      switch (greenNodeFindChild(node, GreenNodeKind.ValueInitializer, 0), greenNodeFindChild(node, GreenNodeKind.Block, 0))
        case (Some(initializer), _) then
          switch lowerSyntaxExpr(tree, initializer)
            case Ok(body) => Ok(ast2.ImplMethod { Pos: sig.Pos, Sig: sig, Body: body })
            case Err(message) => Err(message)
          end
        end
        case (None, Some(block)) then
          switch lowerSyntaxExpressionNode(tree, block.value())
            case Ok(body) => Ok(ast2.ImplMethod { Pos: sig.Pos, Sig: sig, Body: body })
            case Err(message) => Err(message)
          end
        end
        case _ => Ok(ast2.ImplMethod { Pos: sig.Pos, Sig: sig, Body: ast2.EmptyExpr() })
      end
    end
    case Err(message) => Err(message)
  end
end

# implMethodHasBody reports whether the method owns a block body after its
# signature.  The signature ends at its last typed slot node (parameters,
# result, or using clause); the method's own closing `end` leaf is the block
# terminator rather than body content, so it does not count.
func implMethodHasBody(node: GreenNode) -> Bool
  let boundary = implMethodSignatureEnd(node, 0, 0)
  implMethodBodyTokensAfter(node, boundary + 1)
end

func implMethodSignatureEnd(node: GreenNode, index: Int, last: Int) -> Int
  if index >= node.Children.Len() then
    last
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if greenNodeIsSignatureSlotKind(child.value().Kind) then
          implMethodSignatureEnd(node, index + 1, index)
        else
          implMethodSignatureEnd(node, index + 1, last)
        end
      end
      case None => implMethodSignatureEnd(node, index + 1, last)
    end
  end
end

func greenNodeIsSignatureSlotKind(kind: GreenNodeKind) -> Bool
  kind == GreenNodeKind.FunctionParameters || kind == GreenNodeKind.FunctionReturnType || kind == GreenNodeKind.Constraints
end

func implMethodBodyTokensAfter(node: GreenNode, index: Int) -> Bool
  if index >= node.Children.Len() then
    false
  elsif greenElementIsTrivia(greenElementAt(node.Children, index)) then
    implMethodBodyTokensAfter(node, index + 1)
  else
    greenElementRaw(greenElementAt(node.Children, index)) != "end"
  end
end

func lowerSyntaxParameters(tree: SyntaxTree, items: Slice[GreenElement], index: Int, pending: Option[Ref[GreenNode]], output: Slice[ast2.Param]) -> Result[Slice[ast2.Param], String]
  if index >= items.Len() then
    if pending.IsSome() then
      Err("parameter CST lacks type annotation")
    else
      Ok(output)
    end
  else
    switch items.Get(index)
      case Some(item) then
        switch greenElementNode(item)
          case Some(child) then
            if child.value().Kind == GreenNodeKind.BindPattern then
              lowerSyntaxParameters(tree, items, index + 1, Some(child), output)
            elsif child.value().Kind == GreenNodeKind.TypeAnnotation then
              switch pending
                case Some(name) then
                  switch lowerSyntaxTypeOption(child.value())
                    case Some(typ) then
                      lowerSyntaxParameters(
                        tree,
                        items,
                        index + 1,
                        None,
                        output.Append(ast2.Param {
                          Name: greenNodeText(name.value()),
                          Type: typ,
                          TypeSpan: syntaxAstSpan(tree.SourceName, child.value().Span),
                          Span: ast2.SourceSpan {
                            Start: syntaxAstPos(tree.SourceName, name.value().Span.Start),
                            End: syntaxAstPos(tree.SourceName, child.value().Span.End),
                          },
                        }),
                      )
                    end
                    case None => Err("parameter CST type is not lowered yet")
                  end
                end
                case None => Err("parameter CST has type without name")
              end
            else
              lowerSyntaxParameters(tree, items, index + 1, pending, output)
            end
          end
          case None => lowerSyntaxParameters(tree, items, index + 1, pending, output)
        end
      end
      case None => Ok(output)
    end
  end
end

func functionParametersHaveBinding(node: GreenNode, index: Int) -> Bool
  if index >= node.Children.Len() then
    false
  else
    switch node.Children.Get(index)
      case Some(item) then
        switch greenElementNode(item)
          case Some(child) then
            if child.value().Kind == GreenNodeKind.BindPattern && greenNodeText(child.value()) != "(" && greenNodeText(child.value()) != ")" && greenNodeText(child.value()) != "," then
              true
            elsif functionParametersHaveBinding(child.value(), 0) then
              true
            else
              functionParametersHaveBinding(node, index + 1)
            end
          end
          case None => functionParametersHaveBinding(node, index + 1)
        end
      end
      case None => false
    end
  end
end

func lowerSyntaxFunctionReturn(tree: SyntaxTree, node: GreenNode) -> Option[ast2.TypeExpr]
  switch greenNodeFindChild(node, GreenNodeKind.FunctionReturnType, 0)
    case Some(returned) => lowerSyntaxTypeOption(returned.value())
    case None => None
  end
end

# lowerSyntaxConstraints reads a function's `using` clause from its Constraints
# CST node.  Every constraint and argument comes from a nested CST node; the
# clause text is never re-parsed.
func lowerSyntaxConstraints(node: GreenNode) -> Slice[ast2.Constraint]
  switch greenNodeFindChild(node, GreenNodeKind.Constraints, 0)
    case Some(clause) => lowerSyntaxConstraintChildren(clause.value(), 0, [])
    case None => []
  end
end

func lowerSyntaxConstraintChildren(node: GreenNode, index: Int, output: Slice[ast2.Constraint]) -> Slice[ast2.Constraint]
  if index >= node.Children.Len() then
    output
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if child.value().Kind == GreenNodeKind.Constraint then
          switch lowerSyntaxConstraint(child.value())
            case Some(constraint) => lowerSyntaxConstraintChildren(node, index + 1, output.Append(constraint))
            case None => lowerSyntaxConstraintChildren(node, index + 1, output)
          end
        else
          lowerSyntaxConstraintChildren(node, index + 1, output)
        end
      end
      case None => lowerSyntaxConstraintChildren(node, index + 1, output)
    end
  end
end

func lowerSyntaxConstraint(node: GreenNode) -> Option[ast2.Constraint]
  switch greenNodeFindChild(node, GreenNodeKind.IdentifierExpr, 0)
    case Some(name) => Some(ast2.Constraint { Name: greenNodeText(name.value()), BindName: lowerSyntaxConstraintBind(node), Args: lowerSyntaxConstraintArgs(node) })
    case None => None
  end
end

func lowerSyntaxConstraintBind(node: GreenNode) -> Option[String]
  switch greenNodeFindChild(node, GreenNodeKind.BindPattern, 0)
    case Some(pattern) => Some(greenNodeText(pattern.value()))
    case None => None
  end
end

func lowerSyntaxConstraintArgs(node: GreenNode) -> Slice[ast2.TypeExpr]
  switch greenNodeFindChild(node, GreenNodeKind.TypeArguments, 0)
    case Some(group) => lowerSyntaxTypeChildren(group.value(), 0, [])
    case None => []
  end
end

func lowerSyntaxBinding(tree: SyntaxTree, node: Ref[GreenNode]) -> Result[ast2.Decl, String]
  switch (greenNodeFindPatternChild(node.value(), 0), greenNodeFindChild(node.value(), GreenNodeKind.ValueInitializer, 0))
    case (Some(pattern), Some(initializer)) then
      switch lowerSyntaxExpr(tree, initializer) 
        case Ok(value) then
          if pattern.value().Kind != GreenNodeKind.BindPattern then
            Err("tuple binding CST is not lowered to a declaration yet")
          else
            let typ = lowerSyntaxOptionalType(tree, node.value())
            let bind = ast2.Bind { Name: greenNodeText(pattern.value()), Type: typ, TypeSpan: syntaxOptionalTypeSpan(tree, node.value()), Value: value, Span: syntaxAstSpan(tree.SourceName, node.value().Span) }
            if node.value().Kind == GreenNodeKind.LetDeclaration then
              Ok(ast2.Decl.LetDecl(bind))
            else
              Ok(ast2.Decl.VarDecl(bind))
            end
          end
        end
        case Err(message) => Err(message)
      end
    end
    case _ => Err("binding CST lacks name or initializer")
  end
end

func greenNodeFindPatternChild(node: GreenNode, index: Int) -> Option[Ref[GreenNode]]
  if index >= node.Children.Len() then
    None
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if greenNodeIsPatternKind(child.value().Kind) then
          Some(child)
        else
          greenNodeFindPatternChild(node, index + 1)
        end
      end
      case None => greenNodeFindPatternChild(node, index + 1)
    end
  end
end

func lowerSyntaxExpr(tree: SyntaxTree, wrapper: Ref[GreenNode]) -> Result[ast2.Expr, String]
  switch greenNodeFindExpression(wrapper.value(), 0)
    case Some(node) then
      lowerSyntaxExpressionNode(tree, node.value())
    end
    case None => Err("initializer CST lacks expression")
  end
end

# lowerSyntaxExpressionNode maps one concrete CST expression node onto ast2.
# Ranges come from the green node span; values are decoded from the CST leaves.
func lowerSyntaxExpressionNode(tree: SyntaxTree, node: GreenNode) -> Result[ast2.Expr, String]
  let span = syntaxAstSpan(tree.SourceName, node.Span)
  if !syntaxLoweringSupportsNodeKind(node.Kind) then
    Err("CST expression kind is not lowered yet")
  elsif node.Kind == GreenNodeKind.IdentifierExpr then
    Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.IdentExpr(greenNodeText(node)), Type: None })
  elsif node.Kind == GreenNodeKind.NumberExpr then
    Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.NumberExpr(strings.ReplaceAll(greenNodeText(node), "_", "")), Type: None })
  elsif node.Kind == GreenNodeKind.BoolExpr then
    Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.BoolExpr(greenNodeText(node) == "true"), Type: None })
  elsif node.Kind == GreenNodeKind.StringExpr then
    lowerSyntaxStringExpr(span, greenNodeText(node))
  elsif node.Kind == GreenNodeKind.RuneExpr then
    lowerSyntaxRuneExpr(span, greenNodeText(node))
  elsif node.Kind == GreenNodeKind.UnitExpr then
    Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.UnitExpr, Type: None })
  elsif node.Kind == GreenNodeKind.ParenExpr then
    lowerSyntaxParenExpr(tree, node, span)
  elsif node.Kind == GreenNodeKind.TupleExpr then
    switch lowerSyntaxTupleExpr(tree, node)
      case Ok(items) => Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.TupleExpr(items), Type: None })
      case Err(message) => Err(message)
    end
  elsif node.Kind == GreenNodeKind.InlineGoExpr then
    lowerSyntaxInlineGoExpr(tree, node, span)
  elsif node.Kind == GreenNodeKind.FuncLitExpr then
    lowerSyntaxFuncLitExpr(tree, node, span)
  elsif node.Kind == GreenNodeKind.Call then
    lowerSyntaxCallExpr(tree, node, span)
  elsif node.Kind == GreenNodeKind.UnaryExpr then
    lowerSyntaxUnaryExpr(tree, node, span)
  elsif node.Kind == GreenNodeKind.BinaryExpr then
    lowerSyntaxBinaryExpr(tree, node, span)
  elsif node.Kind == GreenNodeKind.FieldExpr then
    lowerSyntaxFieldExpr(tree, node, span)
  elsif node.Kind == GreenNodeKind.TypeAsExpr then
    lowerSyntaxTypeAsExpr(tree, node, span)
  elsif node.Kind == GreenNodeKind.SliceLiteral then
    lowerSyntaxCollectionLiteral(tree, node, span, GreenNodeKind.BracketGroup)
  elsif node.Kind == GreenNodeKind.SetLiteral then
    lowerSyntaxCollectionLiteral(tree, node, span, GreenNodeKind.BraceGroup)
  elsif node.Kind == GreenNodeKind.MapLiteral then
    lowerSyntaxMapLiteral(tree, node, span)
  elsif node.Kind == GreenNodeKind.StructLiteral then
    lowerSyntaxStructLiteral(tree, node, span)
  elsif node.Kind == GreenNodeKind.IfBlock then
    lowerSyntaxIfBlock(tree, node, span)
  elsif node.Kind == GreenNodeKind.SwitchBlock then
    lowerSyntaxSwitchBlock(tree, node, span)
  elsif node.Kind == GreenNodeKind.WhileBlock then
    Err("while CST is a statement, not a lowerable expression")
  elsif node.Kind == GreenNodeKind.Block then
    lowerSyntaxBlockExpr(tree, node, span)
  else
    Err("CST expression kind is not lowered yet")
  end
end

# lowerSyntaxIfBlock lowers the then form and the arrow form of an if
# expression.  The condition is the first expression child; the then body is
# the first expression after the header keyword, and the else body comes from
# the ElseBranch child.  A missing else lowers to the unit value, matching the
# legacy parser's empty else slot.
func lowerSyntaxIfBlock(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  switch lowerSyntaxIfCond(tree, node)
    case Ok(cond) then
      switch lowerSyntaxIfThenBody(tree, node)
        case Ok(thenBody) then
          switch lowerSyntaxIfElseBody(tree, node, span)
            case Ok(elseBody) => Ok(ast2.Expr { ID: 0, Pos: cond.Pos, Span: span, Kind: ast2.ExprKind.IfExpr(cond, thenBody, elseBody), Type: None })
            case Err(message) => Err(message)
          end
        end
        case Err(message) => Err(message)
      end
    end
    case Err(message) => Err(message)
  end
end

func lowerSyntaxIfCond(tree: SyntaxTree, node: GreenNode) -> Result[ast2.Expr, String]
  switch greenNodeFindExpression(node, 0)
    case Some(child) => lowerSyntaxExpressionNode(tree, child.value())
    case None => Err("if CST lacks its condition expression")
  end
end

# lowerSyntaxIfThenBody picks the then body: the expression after the header
# keyword, stopping before the first ElsifBranch/ElseBranch child.  Arrow and
# then forms both place their body there, so the same rule covers both.
func lowerSyntaxIfThenBody(tree: SyntaxTree, node: GreenNode) -> Result[ast2.Expr, String]
  let headerEnd = lowerSyntaxIfHeaderEnd(node, 0)
  switch lowerSyntaxFirstExpression(tree, node, headerEnd)
    case Ok(body) => Ok(lowerSyntaxBlockBody(body))
    case Err(message) => Err(message)
  end
end

# lowerSyntaxIfHeaderEnd finds the token index just after the then or arrow
# leaf so the then body search starts inside the header's body region.
func lowerSyntaxIfHeaderEnd(node: GreenNode, index: Int) -> Int
  if index >= node.Children.Len() then
    index
  elsif lowerSyntaxIsHeaderKeyword(greenElementRaw(greenElementAt(node.Children, index))) then
    index + 1
  else
    lowerSyntaxIfHeaderEnd(node, index + 1)
  end
end

func lowerSyntaxIsHeaderKeyword(raw: String) -> Bool
  raw == "then" || raw == "=>"
end

# lowerSyntaxFirstExpression returns the first expression child at or after
# index, so a nested ElsifBranch/ElseBranch child never shadows the then body.
# Branch nodes are not expression children, so the scan is safe.
func lowerSyntaxFirstExpression(tree: SyntaxTree, node: GreenNode, index: Int) -> Result[ast2.Expr, String]
  if index >= node.Children.Len() then
    Err("if CST lacks a then body expression")
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if greenNodeIsExpressionKind(child.value().Kind) then
          lowerSyntaxExpressionNode(tree, child.value())
        else
          lowerSyntaxFirstExpression(tree, node, index + 1)
        end
      end
      case None => lowerSyntaxFirstExpression(tree, node, index + 1)
    end
  end
end

func lowerSyntaxIfElseBody(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  if syntaxHeaderKeyword(node.Children, 0, "=>") then
    # An arrow-form if keeps its `else` inside the expression stream instead of
    # building an ElseBranch child, so the else body is the first expression
    # after the `else` keyword.
    lowerSyntaxArrowIfElseBody(tree, node, 0, span)
  else
    lowerSyntaxIfElseBodyFrom(tree, node, 0, span)
  end
end

func lowerSyntaxArrowIfElseBody(tree: SyntaxTree, node: GreenNode, index: Int, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  if index >= node.Children.Len() then
    Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.UnitExpr, Type: None })
  elsif greenElementRaw(greenElementAt(node.Children, index)) == "else" then
    lowerSyntaxFirstExpression(tree, node, index + 1)
  else
    lowerSyntaxArrowIfElseBody(tree, node, index + 1, span)
  end
end

# lowerSyntaxIfElseBodyFrom walks the branch children after an if/elsif header in
# source order.  The first ElsifBranch becomes a nested IfExpr whose else slot is
# the remaining branches, and an ElseBranch contributes its own body.  When no
# branch follows, the else slot is the unit value, matching the legacy parser's
# empty-else slot.
func lowerSyntaxIfElseBodyFrom(tree: SyntaxTree, node: GreenNode, index: Int, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  if index >= node.Children.Len() then
    Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.UnitExpr, Type: None })
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if child.value().Kind == GreenNodeKind.ElsifBranch then
          lowerSyntaxElsifBranch(tree, node, index, child.value(), span)
        elsif child.value().Kind == GreenNodeKind.ElseBranch then
          lowerSyntaxElseBranchBody(tree, child.value())
        else
          lowerSyntaxIfElseBodyFrom(tree, node, index + 1, span)
        end
      end
      case None => lowerSyntaxIfElseBodyFrom(tree, node, index + 1, span)
    end
  end
end

# lowerSyntaxElsifBranch turns one `elsif cond then body` branch into a nested
# IfExpr.  Its condition and then body come from the branch children; its else
# slot continues with the following branches in the enclosing if block.  The
# nested span runs from the `elsif` keyword to the end of the enclosing block so
# every ast2 range still derives from a green range.
func lowerSyntaxElsifBranch(tree: SyntaxTree, node: GreenNode, index: Int, branch: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  switch lowerSyntaxIfCond(tree, branch)
    case Ok(cond) then
      switch lowerSyntaxIfThenBody(tree, branch)
        case Ok(thenBody) then
          let elsifSpan = ast2.SourceSpan { Start: lowerSyntaxIfHeaderStart(cond, syntaxAstPos(tree.SourceName, branch.Span.Start)), End: syntaxAstPos(tree.SourceName, node.Span.End) }
          switch lowerSyntaxIfElseBodyFrom(tree, node, index + 1, elsifSpan)
            case Ok(elseBody) => Ok(ast2.Expr { ID: 0, Pos: cond.Pos, Span: elsifSpan, Kind: ast2.ExprKind.IfExpr(cond, thenBody, elseBody), Type: None })
            case Err(message) => Err(message)
          end
        end
        case Err(message) => Err(message)
      end
    end
    case Err(message) => Err(message)
  end
end

# lowerSyntaxIfHeaderStart picks the source position an if expression starts at.
# A then-form if starts at its `if` keyword (the CST node start); an elsif
# branch is an IfExpr in the else slot and starts at its lowered condition,
# matching the legacy parser's exprWithPos(cond.Pos, ...).  The condition's own
# span is preferred so the start stays a real source range; the branch node start
# is the fallback when the condition carries no position.
func lowerSyntaxIfHeaderStart(cond: ast2.Expr, fallback: ast2.SourcePos) -> ast2.SourcePos
  if cond.Span.Start.Line > 0 then
    cond.Span.Start
  elsif cond.Pos.Line > 0 then
    cond.Pos
  else
    fallback
  end
end

func lowerSyntaxElseBranchBody(tree: SyntaxTree, branch: GreenNode) -> Result[ast2.Expr, String]
  switch greenNodeFindExpression(branch, 0)
    case Some(child) then
      switch lowerSyntaxExpressionNode(tree, child.value())
        case Ok(value) => Ok(lowerSyntaxBlockBody(value))
        case Err(message) => Err(message)
      end
    end
    case None => Err("else branch CST lacks its body expression")
  end
end

# lowerSyntaxBlockBody unwraps a single-expression block to the expression
# itself, mirroring the legacy bodyExprWithBlockSpan helper.  The block's
# start offset sits immediately after the header keyword, while the legacy
# grammar starts the block at the first non-trivia token; adopting the inner
# expression's start keeps the unwrapped span aligned with the legacy parser.
# A bare expression is returned unchanged.
func lowerSyntaxBlockBody(value: ast2.Expr) -> ast2.Expr
  switch value.Kind
    case BlockExpr(items) then
      if items.Len() == 1 then
        let first = items.Get(0).UnwrapOr(ast2.Stmt.ExprStmt(ast2.EmptyExpr()))
        switch first
          case ExprStmt(inner) => ast2.Expr { ID: inner.ID, Pos: inner.Pos, Span: ast2.SourceSpan { Start: lowerSyntaxBlockInnerStart(inner, value.Span.Start), End: value.Span.End }, Kind: inner.Kind, Type: inner.Type }
          case _ => value
        end
      else
        value
      end
    end
    case _ => value
  end
end

# lowerSyntaxBlockInnerStart prefers the inner expression's own start, falling
# back to the block start when the inner node carries no source position.
func lowerSyntaxBlockInnerStart(inner: ast2.Expr, fallback: ast2.SourcePos) -> ast2.SourcePos
  if inner.Span.Start.Line > 0 then
    inner.Span.Start
  elsif inner.Pos.Line > 0 then
    inner.Pos
  else
    fallback
  end
end

# lowerSyntaxBlockInner unwraps a single-expression block to the inner
# expression unchanged, keeping the inner node's own span.  This mirrors the
# legacy bodyExprFromBlock helper used for case arms, whose body span is the
# expression itself rather than the enclosing block.
func lowerSyntaxBlockInner(value: ast2.Expr) -> ast2.Expr
  switch value.Kind
    case BlockExpr(items) then
      if items.Len() == 1 then
        let first = items.Get(0).UnwrapOr(ast2.Stmt.ExprStmt(ast2.EmptyExpr()))
        switch first
          case ExprStmt(inner) => inner
          case _ => value
        end
      else
        value
      end
    end
    case _ => value
  end
end

# lowerSyntaxSwitchBlock lowers a switch expression.  The target is the first
# expression child; every CaseBranch child contributes one ast2 switch case
# with its own pattern, body, and span.
func lowerSyntaxSwitchBlock(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  switch greenNodeFindExpression(node, 0)
    case Some(target) then
      switch lowerSyntaxExpressionNode(tree, target.value())
        case Ok(value) then
          switch lowerSyntaxSwitchCases(tree, node, 0, [])
            case Ok(cases) then
              Ok(ast2.Expr {
                ID: 0,
                Pos: value.Pos,
                Span: span,
                Kind: ast2.ExprKind.SwitchExpr(value, cases, None),
                Type: None,
              })
            end
            case Err(message) => Err(message)
          end
        end
        case Err(message) => Err(message)
      end
    end
    case None => Err("switch CST lacks its target expression")
  end
end

func lowerSyntaxSwitchCases(tree: SyntaxTree, node: GreenNode, index: Int, output: Slice[ast2.SwitchCase]) -> Result[Slice[ast2.SwitchCase], String]
  if index >= node.Children.Len() then
    Ok(output)
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if child.value().Kind == GreenNodeKind.CaseBranch then
          switch lowerSyntaxSwitchCase(tree, child.value())
            case Ok(value) => lowerSyntaxSwitchCases(tree, node, index + 1, output.Append(value))
            case Err(message) => Err(message)
          end
        else
          lowerSyntaxSwitchCases(tree, node, index + 1, output)
        end
      end
      case None => lowerSyntaxSwitchCases(tree, node, index + 1, output)
    end
  end
end

func lowerSyntaxSwitchCase(tree: SyntaxTree, node: GreenNode) -> Result[ast2.SwitchCase, String]
  switch greenNodeFindPatternChild(node, 0)
    case Some(pattern) then
      switch lowerSyntaxPatternNode(pattern.value())
        case Ok(lowered) then
          switch lowerSyntaxCaseBody(tree, node)
            case Ok(body) then
              Ok(ast2.SwitchCase {
                Pattern: lowered,
                PatternSpan: syntaxAstSpan(tree.SourceName, pattern.value().Span),
                Body: body,
                BodySpan: body.Span,
                Span: syntaxAstSpan(tree.SourceName, node.Span),
              })
            end
            case Err(message) => Err(message)
          end
        end
        case Err(message) => Err(message)
      end
    end
    case None => Err("case branch CST lacks its pattern")
  end
end

# lowerSyntaxCaseBody returns the case's body expression: the first expression
# child after the pattern, unwrapped from a single-statement block.
func lowerSyntaxCaseBody(tree: SyntaxTree, node: GreenNode) -> Result[ast2.Expr, String]
  switch lowerSyntaxCaseBodyFrom(tree, node, 0, false)
    case Ok(body) => Ok(lowerSyntaxBlockInner(body))
    case Err(message) => Err(message)
  end
end

func lowerSyntaxCaseBodyFrom(tree: SyntaxTree, node: GreenNode, index: Int, seenPattern: Bool) -> Result[ast2.Expr, String]
  if index >= node.Children.Len() then
    Err("case branch CST lacks its body expression")
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if greenNodeIsPatternKind(child.value().Kind) then
          lowerSyntaxCaseBodyFrom(tree, node, index + 1, true)
        elsif seenPattern && greenNodeIsExpressionKind(child.value().Kind) then
          lowerSyntaxExpressionNode(tree, child.value())
        else
          lowerSyntaxCaseBodyFrom(tree, node, index + 1, seenPattern)
        end
      end
      case None => lowerSyntaxCaseBodyFrom(tree, node, index + 1, seenPattern)
    end
  end
end

# lowerSyntaxBlockExpr lowers a statement block into an ast2 BlockExpr.  Each
# ExprStatement child becomes one ExprStmt so the block keeps statement
# semantics; a block that owns no statement children is the unit value.
func lowerSyntaxBlockExpr(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  switch lowerSyntaxBlockStatements(tree, node, 0, [])
    case Ok(statements) => Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.BlockExpr(statements), Type: None })
    case Err(message) => Err(message)
  end
end

func lowerSyntaxBlockStatements(tree: SyntaxTree, node: GreenNode, index: Int, output: Slice[ast2.Stmt]) -> Result[Slice[ast2.Stmt], String]
  if index >= node.Children.Len() then
    Ok(output)
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if greenNodeIsStatementKind(child.value().Kind) then
          switch lowerSyntaxStatementNode(tree, child.value())
            case Ok(statement) => lowerSyntaxBlockStatements(tree, node, index + 1, output.Append(statement))
            case Err(message) => Err(message)
          end
        else
          lowerSyntaxBlockStatements(tree, node, index + 1, output)
        end
      end
      case None => lowerSyntaxBlockStatements(tree, node, index + 1, output)
    end
  end
end

# greenNodeIsStatementKind lists the CST statement nodes a block can own.
func greenNodeIsStatementKind(kind: GreenNodeKind) -> Bool
  kind == GreenNodeKind.ExprStatement || kind == GreenNodeKind.LetStatement || kind == GreenNodeKind.VarStatement || kind == GreenNodeKind.TupleLetStatement || kind == GreenNodeKind.AssignStatement || kind == GreenNodeKind.ReturnStatement || kind == GreenNodeKind.BreakStatement || kind == GreenNodeKind.ContinueStatement || kind == GreenNodeKind.LetRecStatement
end

# lowerSyntaxStatementNode dispatches one CST statement node onto its ast2.Stmt
# alternative.  Every range comes from the frozen green node span.
func lowerSyntaxStatementNode(tree: SyntaxTree, node: GreenNode) -> Result[ast2.Stmt, String]
  if node.Kind == GreenNodeKind.ExprStatement then
    lowerSyntaxExprStatement(tree, node, syntaxAstSpan(tree.SourceName, node.Span))
  elsif node.Kind == GreenNodeKind.LetStatement then
    lowerSyntaxBindingStatement(tree, node, true)
  elsif node.Kind == GreenNodeKind.VarStatement then
    lowerSyntaxBindingStatement(tree, node, false)
  elsif node.Kind == GreenNodeKind.TupleLetStatement then
    lowerSyntaxTupleLetStatement(tree, node)
  elsif node.Kind == GreenNodeKind.AssignStatement then
    lowerSyntaxAssignStatement(tree, node)
  elsif node.Kind == GreenNodeKind.ReturnStatement then
    lowerSyntaxReturnStatement(tree, node)
  elsif node.Kind == GreenNodeKind.BreakStatement then
    Ok(ast2.Stmt.BreakStmt(syntaxAstPos(tree.SourceName, node.Span.Start)))
  elsif node.Kind == GreenNodeKind.ContinueStatement then
    Ok(ast2.Stmt.ContinueStmt(syntaxAstPos(tree.SourceName, node.Span.Start)))
  elsif node.Kind == GreenNodeKind.LetRecStatement then
    lowerSyntaxLetRecStatement(tree, node)
  else
    Err("CST statement kind is not lowered yet")
  end
end

# lowerSyntaxBindingStatement lowers a let/var statement.  The value and span
# follow the legacy Bind shape: the value expression carries its own span and
# the binding span covers the whole statement.
func lowerSyntaxBindingStatement(tree: SyntaxTree, node: GreenNode, immutable: Bool) -> Result[ast2.Stmt, String]
  switch (greenNodeFindPatternChild(node, 0), greenNodeFindChild(node, GreenNodeKind.ValueInitializer, 0))
    case (Some(pattern), Some(initializer)) then
      switch lowerSyntaxExpr(tree, initializer)
        case Ok(value) then
          let bind = ast2.Bind { Name: greenNodeText(pattern.value()), Type: lowerSyntaxOptionalType(tree, node), TypeSpan: syntaxOptionalTypeSpan(tree, node), Value: value, Span: syntaxAstSpan(tree.SourceName, node.Span) }
          if immutable then
            Ok(ast2.Stmt.LetStmt(bind))
          else
            Ok(ast2.Stmt.VarStmt(bind))
          end
        end
        case Err(message) => Err(message)
      end
    end
    case _ => Err("binding statement CST lacks name or initializer")
  end
end

# lowerSyntaxTupleLetStatement lowers a destructuring binding.  The pattern is
# the typed TuplePattern child and the value is the initializer expression.
func lowerSyntaxTupleLetStatement(tree: SyntaxTree, node: GreenNode) -> Result[ast2.Stmt, String]
  switch (greenNodeFindPatternChild(node, 0), greenNodeFindChild(node, GreenNodeKind.ValueInitializer, 0))
    case (Some(pattern), Some(initializer)) then
      let patternResult = lowerSyntaxPatternNode(pattern.value())
      let valueResult = lowerSyntaxExpr(tree, initializer)
      switch (patternResult, valueResult)
        case (Ok(pat), Ok(value)) => Ok(ast2.Stmt.TupleLetStmt(pat, value))
        case (Err(message), _) => Err(message)
        case (_, Err(message)) => Err(message)
      end
    end
    case _ => Err("tuple binding statement CST lacks pattern or initializer")
  end
end

# lowerSyntaxAssignStatement lowers an assignment.  Both operands are typed
# expression children in source order; the left one is the assignment target.
func lowerSyntaxAssignStatement(tree: SyntaxTree, node: GreenNode) -> Result[ast2.Stmt, String]
  switch greenNodeFindExpression(node, 0)
    case Some(target) then
      switch lowerSyntaxExpressionNode(tree, target.value())
        case Ok(left) then
          switch greenNodeFindChild(node, GreenNodeKind.ValueInitializer, 0)
            case Some(initializer) then
              switch lowerSyntaxExpr(tree, initializer)
                case Ok(right) => Ok(ast2.Stmt.AssignStmt(left, right))
                case Err(message) => Err(message)
              end
            end
            case None => Err("assignment CST lacks its value initializer")
          end
        end
        case Err(message) => Err(message)
      end
    end
    case None => Err("assignment CST lacks its target expression")
  end
end

# lowerSyntaxReturnStatement lowers a bare or valued return.  A bare return owns
# no expression child, so it becomes ReturnStmt; otherwise ReturnWithStmt.
func lowerSyntaxReturnStatement(tree: SyntaxTree, node: GreenNode) -> Result[ast2.Stmt, String]
  switch greenNodeFindExpression(node, 0)
    case Some(child) then
      switch lowerSyntaxExpressionNode(tree, child.value())
        case Ok(value) => Ok(ast2.Stmt.ReturnWithStmt(value))
        case Err(message) => Err(message)
      end
    end
    case None => Ok(ast2.Stmt.ReturnStmt)
  end
end

func lowerSyntaxLetRecStatement(tree: SyntaxTree, node: GreenNode) -> Result[ast2.Stmt, String]
  switch lowerSyntaxLetRecBindings(tree, node, 0, [])
    case Ok(bindings) => Ok(ast2.Stmt.LetRecStmt(bindings))
    case Err(message) => Err(message)
  end
end

func lowerSyntaxLetRecBindings(tree: SyntaxTree, node: GreenNode, index: Int, output: Slice[ast2.LetRecBind]) -> Result[Slice[ast2.LetRecBind], String]
  if index >= node.Children.Len() then
    Ok(output)
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if child.value().Kind == GreenNodeKind.LetRecBinding then
          switch lowerSyntaxLetRecBinding(tree, child.value())
            case Ok(binding) => lowerSyntaxLetRecBindings(tree, node, index + 1, output.Append(binding))
            case Err(message) => Err(message)
          end
        else
          lowerSyntaxLetRecBindings(tree, node, index + 1, output)
        end
      end
      case None => lowerSyntaxLetRecBindings(tree, node, index + 1, output)
    end
  end
end

func lowerSyntaxLetRecBinding(tree: SyntaxTree, node: GreenNode) -> Result[ast2.LetRecBind, String]
  switch (greenNodeFindPatternChild(node, 0), greenNodeFindChild(node, GreenNodeKind.TypeAnnotation, 0), greenNodeFindChild(node, GreenNodeKind.ValueInitializer, 0))
    case (Some(pattern), Some(annotation), Some(initializer)) => lowerSyntaxLetRecBindingParts(tree, pattern.value(), annotation.value(), initializer)
    case _ => Err("letrec binding CST lacks name, annotation, or initializer")
  end
end

func lowerSyntaxLetRecBindingParts(tree: SyntaxTree, pattern: GreenNode, annotation: GreenNode, initializer: Ref[GreenNode]) -> Result[ast2.LetRecBind, String]
  switch lowerSyntaxTypeOption(annotation)
    case Some(typ) then
      switch lowerSyntaxExpr(tree, initializer)
        case Ok(value) => Ok(ast2.LetRecBind { Name: greenNodeText(pattern), Type: typ, TypeSpan: syntaxAstSpan(tree.SourceName, annotation.Span), Value: value })
        case Err(message) => Err(message)
      end
    end
    case None => Err("letrec binding annotation is not lowered yet")
  end
end
func lowerSyntaxExprStatement(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Stmt, String]
  switch greenNodeFindChild(node, GreenNodeKind.WhileBlock, 0)
    case Some(loop) => lowerSyntaxWhileStatement(tree, loop.value())
    case None then
      switch greenNodeFindExpression(node, 0)
        case Some(child) then
          switch lowerSyntaxExpressionNode(tree, child.value())
            case Ok(value) => Ok(ast2.Stmt.ExprStmt(value))
            case Err(message) => Err(message)
          end
        end
        case None => Err("expression statement CST lacks its expression")
      end
    end
  end
end

# lowerSyntaxWhileStatement lowers a while loop.  The condition is the first
# expression child after the while keyword; the body is the remaining region up
# to the closing end, wrapped into a Block so its statements keep statement
# semantics, matching the legacy blockUntilAndConsumeEnd body shape.
func lowerSyntaxWhileStatement(tree: SyntaxTree, node: GreenNode) -> Result[ast2.Stmt, String]
  switch lowerSyntaxWhileCondIndex(node, 0)
    case Some(condIndex) then
      switch lowerSyntaxChildExpression(tree, node, condIndex)
        case Ok(cond) then
          let endIndex = syntaxLastTokenIndex(node.Children, node.Children.Len() - 1)
          let bodyStart = condIndex + 1
          let bodyFinish = if endIndex < 0 => node.Children.Len() else endIndex
          let block = syntaxBlockNode(greenElementSliceOrEmpty(node.Children, bodyStart, bodyFinish))
          switch lowerSyntaxBlockExpr(tree, block, syntaxAstSpan(tree.SourceName, block.Span))
            case Ok(body) => Ok(ast2.Stmt.WhileStmt(cond, body))
            case Err(message) => Err(message)
          end
        end
        case Err(message) => Err(message)
      end
    end
    case None => Err("while CST lacks its condition expression")
  end
end

# lowerSyntaxWhileCondIndex returns the index of the first expression child,
# which is the loop condition; the body expressions that follow stay separate.
func lowerSyntaxWhileCondIndex(node: GreenNode, index: Int) -> Option[Int]
  if index >= node.Children.Len() then
    None
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if greenNodeIsExpressionKind(child.value().Kind) then
          Some(index)
        else
          lowerSyntaxWhileCondIndex(node, index + 1)
        end
      end
      case None => lowerSyntaxWhileCondIndex(node, index + 1)
    end
  end
end

func lowerSyntaxChildExpression(tree: SyntaxTree, node: GreenNode, index: Int) -> Result[ast2.Expr, String]
  switch greenElementNode(greenElementAt(node.Children, index))
    case Some(child) => lowerSyntaxExpressionNode(tree, child.value())
    case None => Err("CST child is not an expression node")
  end
end

# syntaxBlockNode freezes a region of leaves into one Block node whose children
# are ExprStatement nodes.  Both a function body and a while body use it, so the
# block's span and statement ownership stay identical in both lowerings.
func syntaxBlockNode(items: Slice[GreenElement]) -> GreenNode
  GreenNode {
    Kind: GreenNodeKind.Block,
    Span: greenElementSliceSpan(items, 0, items.Len()),
    Children: functionBodyStatements(items),
    HasError: false,
  }
end

# lowerSyntaxCollectionLiteral lowers a slice or set literal.  The items are the
# expression children of the single delimiter group, in source order; the
# delimiters and separators stay owned by the group but carry no ast2 node.
func lowerSyntaxCollectionLiteral(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan, groupKind: GreenNodeKind) -> Result[ast2.Expr, String]
  switch greenNodeFindChild(node, groupKind, 0)
    case Some(group) then
      switch lowerSyntaxExpressionChildren(tree, group.value(), 0, [])
        case Ok(items) then
          if node.Kind == GreenNodeKind.SliceLiteral then
            Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.SliceLitExpr(items), Type: None })
          else
            Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.SetLitExpr(items), Type: None })
          end
        end
        case Err(message) => Err(message)
      end
    end
    case None => Err("collection literal CST lacks its delimiter group")
  end
end

# lowerSyntaxMapLiteral lowers a map literal.  Each MapEntry child owns a key
# and a value expression child that combine into one ast2 pair.
func lowerSyntaxMapLiteral(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  switch greenNodeFindChild(node, GreenNodeKind.BraceGroup, 0)
    case Some(group) then
      switch lowerSyntaxMapEntries(tree, group.value(), 0, [])
        case Ok(pairs) => Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.MapLitExpr(pairs), Type: None })
        case Err(message) => Err(message)
      end
    end
    case None => Err("map literal CST lacks its brace group")
  end
end

func lowerSyntaxMapEntries(tree: SyntaxTree, node: GreenNode, index: Int, output: Slice[(ast2.Expr, ast2.Expr)]) -> Result[Slice[(ast2.Expr, ast2.Expr)], String]
  if index >= node.Children.Len() then
    Ok(output)
  else
    let item = greenElementAt(node.Children, index)
    switch greenElementNode(item)
      case Some(child) then
        if child.value().Kind == GreenNodeKind.MapEntry then
          switch lowerSyntaxMapEntry(tree, child.value())
            case Ok(pair) => lowerSyntaxMapEntries(tree, node, index + 1, output.Append(pair))
            case Err(message) => Err(message)
          end
        else
          lowerSyntaxMapEntries(tree, node, index + 1, output)
        end
      end
      case None => lowerSyntaxMapEntries(tree, node, index + 1, output)
    end
  end
end

func lowerSyntaxMapEntry(tree: SyntaxTree, node: GreenNode) -> Result[(ast2.Expr, ast2.Expr), String]
  let expressions = greenNodeDirectExpressionChildren(node, 0, [])
  if expressions.Len() != 2 then
    Err("map entry CST must own exactly a key and a value expression")
  else
    switch (expressions.Get(0), expressions.Get(1))
      case (Some(keyRef), Some(valueRef)) then
        let keyResult = lowerSyntaxExpressionNode(tree, keyRef.value())
        let valueResult = lowerSyntaxExpressionNode(tree, valueRef.value())
        switch (keyResult, valueResult)
          case (Ok(key), Ok(value)) => Ok((key, value))
          case (Err(message), _) => Err(message)
          case (_, Err(message)) => Err(message)
        end
      end
      case _ => Err("map entry CST lacks its key or value")
    end
  end
end

# lowerSyntaxStructLiteral lowers `TypeName { field: value }` and its generic
# form.  The head expression supplies the qualified name; the TypeArguments
# child supplies explicit type arguments; each StructLitField child owns the
# field name token and its value expression.
func lowerSyntaxStructLiteral(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  switch greenNodeFindExpression(node, 0)
    case Some(head) then
      let name = syntaxStructLitHeadName(head.value())
      if name == "" then
        Err("struct literal CST lacks a type name head")
      else
        switch greenNodeFindChild(node, GreenNodeKind.BraceGroup, 0)
          case Some(group) then
            switch lowerSyntaxStructLitFields(tree, group.value(), 0, [])
              case Ok(fields) then
                let typeArgs = syntaxCallTypeArgs(node)
                if typeArgs.Len() == 0 then
                  Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.StructLitExpr(name, fields), Type: None })
                else
                  Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.GenericStructLitExpr(name, typeArgs, fields), Type: None })
                end
              end
              case Err(message) => Err(message)
            end
          end
          case None => Err("struct literal CST lacks its field group")
        end
      end
    end
    case None => Err("struct literal CST lacks its type name head")
  end
end

func lowerSyntaxStructLitFields(tree: SyntaxTree, node: GreenNode, index: Int, output: Slice[ast2.StructLitField]) -> Result[Slice[ast2.StructLitField], String]
  if index >= node.Children.Len() then
    Ok(output)
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if child.value().Kind == GreenNodeKind.StructLitField then
          switch lowerSyntaxStructLitField(tree, child.value())
            case Ok(field) => lowerSyntaxStructLitFields(tree, node, index + 1, output.Append(field))
            case Err(message) => Err(message)
          end
        else
          lowerSyntaxStructLitFields(tree, node, index + 1, output)
        end
      end
      case None => lowerSyntaxStructLitFields(tree, node, index + 1, output)
    end
  end
end

func lowerSyntaxStructLitField(tree: SyntaxTree, node: GreenNode) -> Result[ast2.StructLitField, String]
  switch greenNodeFindExpression(node, 0)
    case Some(value) then
      switch lowerSyntaxExpressionNode(tree, value.value())
        case Ok(expr) => Ok(ast2.StructLitField { Name: syntaxStructLitFieldName(node), Value: expr })
        case Err(message) => Err(message)
      end
    end
    case None => Err("struct literal field CST lacks its value expression")
  end
end

# syntaxStructLitFieldName returns the field name token preceding a struct
# literal field's value expression.
func syntaxStructLitFieldName(node: GreenNode) -> String
  syntaxStructLitFieldNameScan(node, 0, "")
end

func syntaxStructLitFieldNameScan(node: GreenNode, index: Int, found: String) -> String
  if index >= node.Children.Len() || found != "" then
    found
  else
    switch greenElementAt(node.Children, index)
      case TokenElement(token) then
        if token.Kind == GreenTokenKind.Identifier then
          token.Raw
        else
          syntaxStructLitFieldNameScan(node, index + 1, found)
        end
      end
      case _ => syntaxStructLitFieldNameScan(node, index + 1, found)
    end
  end
end

# lowerSyntaxUnaryExpr lowers a prefix operator.  The operator is the leading
# non-trivia token and the operand is the recursive expression child; both live
# inside the same green range, so no source text is re-read.
func lowerSyntaxUnaryExpr(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  let op = syntaxLeadingTokenRaw(node, 0, "")
  switch greenNodeFindExpression(node, 0)
    case Some(operand) then
      switch lowerSyntaxExpressionNode(tree, operand.value())
        case Ok(value) => Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.UnaryExpr(op, value), Type: None })
        case Err(message) => Err(message)
      end
    end
    case None => Err("unary expression CST lacks an operand")
  end
end

# lowerSyntaxBinaryExpr lowers a left-associative operator chain.  Its direct
# expression children are the left and right operands in source order; the
# operator is the token between them.
func lowerSyntaxBinaryExpr(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  let operands = greenNodeDirectExpressionChildren(node, 0, [])
  if operands.Len() != 2 then
    Err("binary expression CST must own exactly two operands")
  else
    let op = syntaxTokenBetweenExpressions(node)
    # Bind each operand lowering to a local before matching.  A tuple switch
    # lowers to a scrutinee struct that the compiler re-evaluates once per case
    # arm, so an inline recursive call here would blow up exponentially down a
    # chain of binary operators.
    switch operands.Get(0)
      case Some(leftRef) then
        switch operands.Get(1)
          case Some(rightRef) then
            let left = lowerSyntaxExpressionNode(tree, leftRef.value())
            let right = lowerSyntaxExpressionNode(tree, rightRef.value())
            switch (left, right)
              case (Ok(leftExpr), Ok(rightExpr)) then
                Ok(ast2.Expr {
                  ID: 0,
                  Pos: span.Start,
                  Span: span,
                  Kind: ast2.ExprKind.BinaryExpr(op, leftExpr, rightExpr),
                  Type: None,
                })
              end
              case (Err(message), _) => Err(message)
              case (_, Err(message)) => Err(message)
            end
          end
          case None => Err("binary expression CST lacks its operands")
        end
      end
      case None => Err("binary expression CST lacks its operands")
    end
  end
end

# lowerSyntaxFieldExpr lowers a member-access expression.  The base is the
# expression child and the field name is the identifier token that follows it.
func lowerSyntaxFieldExpr(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  switch greenNodeFindExpression(node, 0)
    case Some(receiver) then
      switch lowerSyntaxExpressionNode(tree, receiver.value())
        case Ok(value) => Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.FieldExpr(value, syntaxFieldName(node)), Type: None })
        case Err(message) => Err(message)
      end
    end
    case None => Err("field expression CST lacks its receiver")
  end
end

# lowerSyntaxTypeAsExpr lowers an as-cast expression.  The base is the
# expression child and the target is the nested type node.
func lowerSyntaxTypeAsExpr(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  switch (greenNodeFindExpression(node, 0), greenNodeFindTypeChild(node, 0))
    case (Some(baseExpr), Some(target)) then
      switch (lowerSyntaxExpressionNode(tree, baseExpr.value()), lowerSyntaxTypeNode(target.value()))
        case (Ok(value), Some(targetType)) => Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.TypeAsExpr(value, targetType), Type: None })
        case (Err(message), _) => Err(message)
        case (_, None) => Err("as-expression CST target type is not lowered yet")
      end
    end
    case _ => Err("as-expression CST lacks its operand or target type")
  end
end

# lowerSyntaxCallExpr lowers a call with optional explicit type arguments.  The
# callee is the expression child, the arguments are the expression children of
# the argument group, and type arguments come from the TypeArguments child.
func lowerSyntaxCallExpr(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  switch greenNodeFindExpression(node, 0)
    case Some(callee) then
      switch lowerSyntaxExpressionNode(tree, callee.value())
        case Ok(value) => lowerSyntaxCallWithCallee(tree, node, span, value)
        case Err(message) => Err(message)
      end
    end
    case None => Err("call expression CST lacks its callee")
  end
end

func lowerSyntaxCallWithCallee(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan, callee: ast2.Expr) -> Result[ast2.Expr, String]
  switch greenNodeFindChild(node, GreenNodeKind.ParenGroup, 0)
    case Some(arguments) then
      switch lowerSyntaxExpressionChildren(tree, arguments.value(), 0, [])
        case Ok(args) => Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.CallExpr(callee, syntaxCallTypeArgs(node), args), Type: None })
        case Err(message) => Err(message)
      end
    end
    case None => Err("call expression CST lacks its argument group")
  end
end

func syntaxCallTypeArgs(node: GreenNode) -> Slice[ast2.TypeExpr]
  switch greenNodeFindChild(node, GreenNodeKind.TypeArguments, 0)
    case Some(group) => lowerSyntaxTypeChildren(group.value(), 0, [])
    case None => []
  end
end

# greenNodeDirectExpressionChildren collects the direct expression children in
# source order.  It does not recurse, so a call's argument group is never
# mistaken for the callee.
func greenNodeDirectExpressionChildren(node: GreenNode, index: Int, output: Slice[Ref[GreenNode]]) -> Slice[Ref[GreenNode]]
  if index >= node.Children.Len() then
    output
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if greenNodeIsExpressionKind(child.value().Kind) then
          greenNodeDirectExpressionChildren(node, index + 1, output.Append(child))
        else
          greenNodeDirectExpressionChildren(node, index + 1, output)
        end
      end
      case None => greenNodeDirectExpressionChildren(node, index + 1, output)
    end
  end
end

# syntaxLeadingTokenRaw returns the first non-trivia token raw in the node, or
# the fallback when the node owns no token.
func syntaxLeadingTokenRaw(node: GreenNode, index: Int, fallback: String) -> String
  if index >= node.Children.Len() then
    fallback
  else
    let item = greenElementAt(node.Children, index)
    if greenElementIsTrivia(item) then
      syntaxLeadingTokenRaw(node, index + 1, fallback)
    else
      switch item
        case TokenElement(token) => token.Raw
        case _ => syntaxLeadingTokenRaw(node, index + 1, fallback)
      end
    end
  end
end

# syntaxTokenBetweenExpressions returns the first token raw that appears after
# the first expression child and before the second, which is the binary
# operator for a left-associative chain.
func syntaxTokenBetweenExpressions(node: GreenNode) -> String
  syntaxOperatorToken(node, 0, 0, "")
end

func syntaxOperatorToken(node: GreenNode, index: Int, expressionsSeen: Int, found: String) -> String
  if index >= node.Children.Len() || found != "" then
    found
  else
    let item = greenElementAt(node.Children, index)
    switch item
      case NodeElement(child) then
        if greenNodeIsExpressionKind(child.value().Kind) then
          syntaxOperatorToken(node, index + 1, expressionsSeen + 1, found)
        else
          syntaxOperatorToken(node, index + 1, expressionsSeen, found)
        end
      end
      case TokenElement(token) then
        if expressionsSeen == 1 then
          token.Raw
        else
          syntaxOperatorToken(node, index + 1, expressionsSeen, found)
        end
      end
      case _ => syntaxOperatorToken(node, index + 1, expressionsSeen, found)
    end
  end
end

# syntaxFieldName returns the identifier that follows the receiver in a field
# expression.  The receiver is the first expression child; the name is the first
# identifier token after it.
func syntaxFieldName(node: GreenNode) -> String
  syntaxFieldNameScan(node, 0, false, "")
end

func syntaxFieldNameScan(node: GreenNode, index: Int, seenReceiver: Bool, found: String) -> String
  if index >= node.Children.Len() || found != "" then
    found
  else
    let item = greenElementAt(node.Children, index)
    switch item
      case NodeElement(child) then
        if !seenReceiver && greenNodeIsExpressionKind(child.value().Kind) then
          syntaxFieldNameScan(node, index + 1, true, found)
        else
          syntaxFieldNameScan(node, index + 1, seenReceiver, found)
        end
      end
      case TokenElement(token) then
        if seenReceiver && token.Kind == GreenTokenKind.Identifier then
          token.Raw
        else
          syntaxFieldNameScan(node, index + 1, seenReceiver, found)
        end
      end
      case _ => syntaxFieldNameScan(node, index + 1, seenReceiver, found)
    end
  end
end

# lowerSyntaxParenExpr unwraps a single parenthesized expression.  The inner
# group owns the expression child; the parens themselves carry no ast2 node.
func lowerSyntaxParenExpr(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  switch greenNodeFindExpression(node, 0)
    case Some(inner) then
      switch lowerSyntaxExpressionNode(tree, inner.value())
        case Ok(value) => Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: value.Kind, Type: None })
        case Err(message) => Err(message)
      end
    end
    case None => Err("parenthesized expression CST lacks an inner expression")
  end
end

func lowerSyntaxTupleExpr(tree: SyntaxTree, node: GreenNode) -> Result[Slice[ast2.Expr], String]
  switch greenNodeFindChild(node, GreenNodeKind.ParenGroup, 0)
    case Some(group) => lowerSyntaxExpressionChildren(tree, group.value(), 0, [])
    case None => Err("tuple expression CST lacks its parenthesized group")
  end
end

func lowerSyntaxExpressionChildren(tree: SyntaxTree, node: GreenNode, index: Int, output: Slice[ast2.Expr]) -> Result[Slice[ast2.Expr], String]
  if index >= node.Children.Len() then
    Ok(output)
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if greenNodeIsExpressionKind(child.value().Kind) then
          switch lowerSyntaxExpressionNode(tree, child.value())
            case Ok(value) => lowerSyntaxExpressionChildren(tree, node, index + 1, output.Append(value))
            case Err(message) => Err(message)
          end
        else
          lowerSyntaxExpressionChildren(tree, node, index + 1, output)
        end
      end
      case None => lowerSyntaxExpressionChildren(tree, node, index + 1, output)
    end
  end
end

# lowerSyntaxInlineGoExpr lowers `go[Type] { code: ...; in x = e; type T = T }`.
# The bracket group holds the result type; the body holds the decoded code
# string plus typed value and type bindings, each read from its own CST child.
func lowerSyntaxInlineGoExpr(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  switch greenNodeFindChild(node, GreenNodeKind.BracketGroup, 0)
    case Some(brackets) => lowerSyntaxInlineGoWithType(tree, node, span, brackets.value())
    case None => Err("inline-Go CST lacks its type argument group")
  end
end

# lowerSyntaxFuncLitExpr lowers a `func` literal.  The parameters come from the
# FunctionParameters child, the optional result type from the FunctionReturnType
# child, and the body from the Block child, so every field derives from a frozen
# green range rather than re-reading source text.
func lowerSyntaxFuncLitExpr(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan) -> Result[ast2.Expr, String]
  switch greenNodeFindChild(node, GreenNodeKind.FunctionParameters, 0)
    case Some(parameters) then
      switch (lowerSyntaxParameters(tree, parameters.value().Children, 0, None, []), lowerSyntaxFuncLitBody(tree, node))
        case (Ok(params), Ok(body)) => Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.FuncLitExpr(params, lowerSyntaxFunctionReturn(tree, node), body), Type: None })
        case (Err(message), _) => Err(message)
        case (_, Err(message)) => Err(message)
      end
    end
    case None => Err("func literal CST lacks its parameter group")
  end
end

func lowerSyntaxFuncLitBody(tree: SyntaxTree, node: GreenNode) -> Result[ast2.Expr, String]
  switch greenNodeFindChild(node, GreenNodeKind.Block, 0)
    case Some(block) => lowerSyntaxExpressionNode(tree, block.value())
    case None => Err("func literal CST lacks its body block")
  end
end

func lowerSyntaxInlineGoWithType(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan, brackets: GreenNode) -> Result[ast2.Expr, String]
  switch lowerSyntaxInlineGoType(brackets)
    case Some(typ) => lowerSyntaxInlineGoWithCode(tree, node, span, typ)
    case None => Err("inline-Go CST result type is not lowered yet")
  end
end

func lowerSyntaxInlineGoWithCode(tree: SyntaxTree, node: GreenNode, span: ast2.SourceSpan, typ: ast2.TypeExpr) -> Result[ast2.Expr, String]
  switch greenNodeFindChild(node, GreenNodeKind.BraceGroup, 0)
    case Some(body) then
      switch greenNodeFindChild(body.value(), GreenNodeKind.InlineGoCode, 0)
        case Some(codeNode) => lowerSyntaxInlineGoCode(tree, span, typ, codeNode.value(), body.value())
        case None => Err("inline-Go CST lacks its code or body")
      end
    end
    case None => Err("inline-Go CST lacks its code or body")
  end
end

func lowerSyntaxInlineGoCode(tree: SyntaxTree, span: ast2.SourceSpan, typ: ast2.TypeExpr, codeNode: GreenNode, body: GreenNode) -> Result[ast2.Expr, String]
  switch syntaxStringLeafRaw(codeNode, 0)
    case Some(codeRaw) then
      switch syntaxDecodeStringRaw(codeRaw)
        case Ok(code) then
          switch lowerSyntaxInlineGoBindings(tree, body)
            case Ok(bindings) => Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.InlineGoExpr(Ref.new(typ), code, bindings.Values, bindings.Types), Type: None })
            case Err(message) => Err(message)
          end
        end
        case Err(message) => Err(message)
      end
    end
    case None => Err("inline-Go code CST lacks a string literal")
  end
end

func lowerSyntaxInlineGoType(brackets: GreenNode) -> Option[ast2.TypeExpr]
  switch greenNodeFindTypeChild(brackets, 0)
    case Some(typ) => lowerSyntaxTypeNode(typ.value())
    case None => None
  end
end

struct InlineGoBindings
  Values: Slice[ast2.GoOperand]
  Types: Slice[ast2.GoTypeOperand]
end

func lowerSyntaxInlineGoBindings(tree: SyntaxTree, body: GreenNode) -> Result[InlineGoBindings, String]
  lowerSyntaxInlineGoBindingsFrom(tree, body, 0, InlineGoBindings { Values: [], Types: [] })
end

func lowerSyntaxInlineGoBindingsFrom(tree: SyntaxTree, body: GreenNode, index: Int, output: InlineGoBindings) -> Result[InlineGoBindings, String]
  if index >= body.Children.Len() then
    Ok(output)
  else
    switch greenElementNode(greenElementAt(body.Children, index))
      case Some(child) then
        if child.value().Kind == GreenNodeKind.InlineGoValueBinding then
          switch lowerSyntaxInlineGoValueBinding(tree, child.value())
            case Ok(operand) => lowerSyntaxInlineGoBindingsFrom(tree, body, index + 1, InlineGoBindings { Values: output.Values.Append(operand), Types: output.Types })
            case Err(message) => Err(message)
          end
        elsif child.value().Kind == GreenNodeKind.InlineGoTypeBinding then
          switch lowerSyntaxInlineGoTypeBinding(child.value())
            case Ok(operand) => lowerSyntaxInlineGoBindingsFrom(tree, body, index + 1, InlineGoBindings { Values: output.Values, Types: output.Types.Append(operand) })
            case Err(message) => Err(message)
          end
        else
          lowerSyntaxInlineGoBindingsFrom(tree, body, index + 1, output)
        end
      end
      case None => lowerSyntaxInlineGoBindingsFrom(tree, body, index + 1, output)
    end
  end
end

func lowerSyntaxInlineGoValueBinding(tree: SyntaxTree, node: GreenNode) -> Result[ast2.GoOperand, String]
  switch greenNodeFindExpression(node, 0)
    case Some(value) then
      switch lowerSyntaxExpressionNode(tree, value.value())
        case Ok(expr) => Ok(ast2.GoOperand { Name: syntaxInlineGoBindingName(node), Value: expr })
        case Err(message) => Err(message)
      end
    end
    case None => Err("inline-Go value binding lacks its expression")
  end
end

func lowerSyntaxInlineGoTypeBinding(node: GreenNode) -> Result[ast2.GoTypeOperand, String]
  switch greenNodeFindTypeChild(node, 0)
    case Some(typ) then
      switch lowerSyntaxTypeNode(typ.value())
        case Some(lowered) => Ok(ast2.GoTypeOperand { Name: syntaxInlineGoBindingName(node), Type: lowered })
        case None => Err("inline-Go type binding is not lowered yet")
      end
    end
    case None => Err("inline-Go type binding lacks its type")
  end
end

func lowerSyntaxRuneExpr(span: ast2.SourceSpan, raw: String) -> Result[ast2.Expr, String]
  switch syntaxDecodeRuneRaw(raw)
    case Ok(value) => Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.RuneExpr(value), Type: None })
    case Err(message) => Err(message)
  end
end

func lowerSyntaxStringExpr(span: ast2.SourceSpan, raw: String) -> Result[ast2.Expr, String]
  switch syntaxDecodeStringRaw(raw)
    case Ok(value) => Ok(ast2.Expr { ID: 0, Pos: span.Start, Span: span, Kind: ast2.ExprKind.StringExpr(value), Type: None })
    case Err(message) => Err(message)
  end
end

# syntaxDecodeStringRaw decodes a string literal's semantic value from its raw
# source slice.  Raw and triple-quoted literals keep their bytes verbatim;
# ordinary literals decode backslash escapes so the ast2 value matches the
# legacy parser's literal value.
func syntaxDecodeStringRaw(raw: String) -> Result[String, String]
  switch syntaxStringContent(raw)
    case Some(content) then
      if strings.HasPrefix(raw, "\"") && !strings.HasPrefix(raw, "\"\"\"") then
        syntaxDecodeEscapes(content, 0, "")
      else
        Ok(content)
      end
    end
    case None => Err("malformed string CST cannot lower")
  end
end

# syntaxDecodeRuneRaw decodes a rune literal's single character, applying the
# same escape set as the legacy parser.
func syntaxDecodeRuneRaw(raw: String) -> Result[String, String]
  switch raw.Slice(1, raw.Len() - 1)
    case Some(content) then
      if strings.Contains(content, "\\") then
        syntaxDecodeEscapes(content, 0, "")
      else
        Ok(content)
      end
    end
    case None => Err("malformed rune CST cannot lower")
  end
end

struct SyntaxDecodeResult
  Text: String
  Next: Int
end

func syntaxDecodeEscapes(text: String, index: Int, output: String) -> Result[String, String]
  syntaxDecodeEscapesAt(text as Slice[Rune], index, output)
end

func syntaxDecodeEscapesAt(runes: Slice[Rune], index: Int, output: String) -> Result[String, String]
  if index >= runes.Len() then
    Ok(output)
  else
    switch runes.Get(index)
      case Some(r) then
        if r == '\\' then
          switch syntaxDecodeEscapeAt(runes, index + 1)
            case Ok(decoded) => syntaxDecodeEscapesAt(runes, decoded.Next, output + decoded.Text)
            case Err(message) => Err(message)
          end
        else
          syntaxDecodeEscapesAt(runes, index + 1, output + String.FromRunes([r]))
        end
      end
      case None => Ok(output)
    end
  end
end

func syntaxDecodeEscapeAt(runes: Slice[Rune], index: Int) -> Result[SyntaxDecodeResult, String]
  switch runes.Get(index)
    case Some(r) then
      if r == 'u' then
        syntaxDecodeUnicodeEscape(runes, index + 1)
      elsif r == 'n' then
        Ok(SyntaxDecodeResult { Text: "\n", Next: index + 1 })
      elsif r == 't' then
        Ok(SyntaxDecodeResult { Text: "\t", Next: index + 1 })
      elsif r == 'b' then
        Ok(SyntaxDecodeResult { Text: "\b", Next: index + 1 })
      elsif r == 'f' then
        Ok(SyntaxDecodeResult { Text: "\f", Next: index + 1 })
      elsif r == 'r' then
        Ok(SyntaxDecodeResult { Text: "\r", Next: index + 1 })
      elsif r == '0' then
        Ok(SyntaxDecodeResult { Text: "\0", Next: index + 1 })
      elsif r == '"' then
        Ok(SyntaxDecodeResult { Text: "\"", Next: index + 1 })
      elsif r == '\'' then
        Ok(SyntaxDecodeResult { Text: "'", Next: index + 1 })
      elsif r == '\\' then
        Ok(SyntaxDecodeResult { Text: "\\", Next: index + 1 })
      else
        Err("unsupported escape in string CST")
      end
    end
    case None => Err("trailing escape in string CST")
  end
end

func syntaxDecodeUnicodeEscape(runes: Slice[Rune], index: Int) -> Result[SyntaxDecodeResult, String]
  switch (syntaxHexRune(runes, index), syntaxHexRune(runes, index + 1), syntaxHexRune(runes, index + 2), syntaxHexRune(runes, index + 3))
    case (Some(d0), Some(d1), Some(d2), Some(d3)) then
      let value = d0 * 4096 + d1 * 256 + d2 * 16 + d3
      if value >= 55296 && value <= 57343 then
        Err("Unicode escape must not be a surrogate")
      else
        Ok(SyntaxDecodeResult { Text: String.FromRunes([value as Rune]), Next: index + 4 })
      end
    end
    case _ => Err("malformed Unicode escape in string CST")
  end
end

func syntaxHexRune(runes: Slice[Rune], index: Int) -> Option[Int]
  switch runes.Get(index)
    case Some(r) then
      if r >= '0' && r <= '9' then
        Some((r as Int) - ('0' as Int))
      elsif r >= 'a' && r <= 'f' then
        Some((r as Int) - ('a' as Int) + 10)
      elsif r >= 'A' && r <= 'F' then
        Some((r as Int) - ('A' as Int) + 10)
      else
        None
      end
    end
    case None => None
  end
end

# syntaxInlineGoBindingName reads the identifier leaf of an `in x = ...` or
# `type T = ...` binding; the name is a raw token, not a nested expression.
func syntaxInlineGoBindingName(node: GreenNode) -> String
  syntaxFirstIdentifierRaw(node.Children, 0)
end

func syntaxFirstIdentifierRaw(items: Slice[GreenElement], index: Int) -> String
  if index >= items.Len() then
    ""
  else
    switch items.Get(index)
      case Some(item) then
        switch item
          case TokenElement(token) then
            if token.Kind == GreenTokenKind.Identifier then
              token.Raw
            else
              syntaxFirstIdentifierRaw(items, index + 1)
            end
          end
          case _ => syntaxFirstIdentifierRaw(items, index + 1)
        end
      end
      case None => ""
    end
  end
end

func syntaxStringContent(raw: String) -> Option[String]
  if strings.HasPrefix(raw, "\"\"\"") && strings.HasSuffix(raw, "\"\"\"") then
    raw.Slice(3, raw.Len() - 3)
  elsif (strings.HasPrefix(raw, "\"") && strings.HasSuffix(raw, "\"")) || (strings.HasPrefix(raw, "`") && strings.HasSuffix(raw, "`")) then
    raw.Slice(1, raw.Len() - 1)
  else
    None
  end
end

func lowerSyntaxOptionalType(tree: SyntaxTree, node: GreenNode) -> Option[ast2.TypeExpr]
  switch greenNodeFindChild(node, GreenNodeKind.TypeAnnotation, 0)
    case Some(annotation) => lowerSyntaxTypeOption(annotation.value())
    case None => None
  end
end

func lowerSyntaxTypeOption(node: GreenNode) -> Option[ast2.TypeExpr]
  switch greenNodeFindTypeChild(node, 0)
    case Some(typ) => lowerSyntaxTypeNode(typ.value())
    case None => None
  end
end

func greenNodeFindTypeChild(node: GreenNode, index: Int) -> Option[Ref[GreenNode]]
  if index >= node.Children.Len() then
    None
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if greenNodeIsTypeKind(child.value().Kind) then
          Some(child)
        else
          greenNodeFindTypeChild(node, index + 1)
        end
      end
      case None => greenNodeFindTypeChild(node, index + 1)
    end
  end
end

# lowerSyntaxTypeNode maps one typed Syntax type node onto ast2.TypeExpr.  Every
# ast2 child comes from a nested CST type node; the source text is never
# re-parsed, so ranges and structure stay owned by the Syntax Tree.
func lowerSyntaxTypeNode(node: GreenNode) -> Option[ast2.TypeExpr]
  if node.Kind == GreenNodeKind.NamedType then
    Some(ast2.TypeExpr.NamedType(greenNodeText(node), []))
  elsif node.Kind == GreenNodeKind.GenericType then
    lowerSyntaxGenericType(node)
  elsif node.Kind == GreenNodeKind.TupleType then
    Some(ast2.TypeExpr.TupleType(lowerSyntaxTypeChildren(node, 0, [])))
  elsif node.Kind == GreenNodeKind.UnitType then
    Some(ast2.TypeExpr.UnitType)
  elsif node.Kind == GreenNodeKind.FuncType then
    lowerSyntaxFuncType(node)
  else
    None
  end
end

func lowerSyntaxGenericType(node: GreenNode) -> Option[ast2.TypeExpr]
  switch (greenNodeFindChild(node, GreenNodeKind.NamedType, 0), greenNodeFindChild(node, GreenNodeKind.TypeArguments, 0))
    case (Some(base), Some(arguments)) => Some(ast2.TypeExpr.NamedType(greenNodeText(base.value()), lowerSyntaxTypeChildren(arguments.value(), 0, [])))
    case (Some(base), None) => Some(ast2.TypeExpr.NamedType(greenNodeText(base.value()), []))
    case _ => None
  end
end

func lowerSyntaxTypeChildren(node: GreenNode, index: Int, output: Slice[ast2.TypeExpr]) -> Slice[ast2.TypeExpr]
  if index >= node.Children.Len() then
    output
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if greenNodeIsTypeKind(child.value().Kind) then
          switch lowerSyntaxTypeNode(child.value())
            case Some(typ) => lowerSyntaxTypeChildren(node, index + 1, output.Append(typ))
            case None => lowerSyntaxTypeChildren(node, index + 1, output)
          end
        else
          lowerSyntaxTypeChildren(node, index + 1, output)
        end
      end
      case None => lowerSyntaxTypeChildren(node, index + 1, output)
    end
  end
end

func lowerSyntaxFuncType(node: GreenNode) -> Option[ast2.TypeExpr]
  switch greenNodeFindChild(node, GreenNodeKind.FunctionTypeParameters, 0)
    case Some(parameters) then
      switch greenNodeFindTypeChild(node, 0)
        case Some(ret) then
          switch lowerSyntaxTypeNode(ret.value())
            case Some(returns) => Some(ast2.TypeExpr.FuncType(lowerSyntaxTypeChildren(parameters.value(), 0, []), Ref.new(returns)))
            case None => None
          end
        end
        case None => None
      end
    end
    case None => None
  end
end

# lowerSyntaxPatternNode maps one pattern CST node onto ast2.Pattern.  Every
# alternative is read from its typed green children; literal values are decoded
# from the retained raw token, so no source text is re-parsed during lowering.
func lowerSyntaxPatternNode(node: GreenNode) -> Result[ast2.Pattern, String]
  if node.Kind == GreenNodeKind.BindPattern then
    Ok(ast2.Pattern.BindPattern(greenNodeText(node)))
  elsif node.Kind == GreenNodeKind.WildcardPattern then
    Ok(ast2.Pattern.WildcardPattern)
  elsif node.Kind == GreenNodeKind.LiteralPattern then
    lowerSyntaxLiteralPattern(node)
  elsif node.Kind == GreenNodeKind.TuplePattern then
    switch greenNodeFindChild(node, GreenNodeKind.ParenGroup, 0)
      case Some(group) then
        switch lowerSyntaxPatternChildren(group.value(), 0, [])
          case Ok(items) => Ok(ast2.Pattern.TuplePattern(items))
          case Err(message) => Err(message)
        end
      end
      case None => Err("tuple pattern CST lacks a delimiter group")
    end
  elsif node.Kind == GreenNodeKind.VariantPattern then
    switch greenNodeFindChild(node, GreenNodeKind.ParenGroup, 0)
      case Some(group) then
        switch lowerSyntaxPatternChildren(group.value(), 0, [])
          case Ok(items) => Ok(ast2.Pattern.VariantPattern(greenNodeFirstIdentifier(node), items))
          case Err(message) => Err(message)
        end
      end
      case None => Ok(ast2.Pattern.VariantPattern(greenNodeFirstIdentifier(node), []))
    end
  elsif node.Kind == GreenNodeKind.StructVariantPattern then
    switch greenNodeFindChild(node, GreenNodeKind.BraceGroup, 0)
      case Some(group) then
        switch lowerSyntaxStructPatternFields(group.value(), 0, [])
          case Ok(fields) => Ok(ast2.Pattern.StructVariantPattern(greenNodeFirstIdentifier(node), fields))
          case Err(message) => Err(message)
        end
      end
      case None => Err("struct variant pattern CST lacks a field group")
    end
  else
    Err("CST pattern kind is not lowered yet")
  end
end

func lowerSyntaxLiteralPattern(node: GreenNode) -> Result[ast2.Pattern, String]
  switch syntaxLiteralPatternToken(node, 0)
    case Some(token) => lowerSyntaxLiteralPatternToken(token)
    case None => Err("literal pattern CST lacks a literal token")
  end
end

func lowerSyntaxLiteralPatternToken(token: GreenToken) -> Result[ast2.Pattern, String]
  let kind = greenTokenPatternLiteralKind(token)
  if kind == "number" then
    Ok(ast2.Pattern.LiteralPattern("number", token.Raw))
  elsif kind == "rune" then
    lowerSyntaxLiteralRunePattern(token.Raw)
  elsif kind == "string" then
    switch syntaxDecodeStringRaw(token.Raw)
      case Ok(value) => Ok(ast2.Pattern.LiteralPattern("string", value))
      case Err(message) => Err(message)
    end
  else
    Err("literal pattern token is not a literal")
  end
end

func lowerSyntaxLiteralRunePattern(raw: String) -> Result[ast2.Pattern, String]
  # A rune pattern decodes backslash escapes to the same character value the
  # legacy parser stores in `LiteralPattern.Value`, so `'\n'` and `'\\'` lower
  # to the control/rune they denote rather than their raw source bytes.
  switch syntaxDecodeRuneRaw(raw)
    case Ok(value) => Ok(ast2.Pattern.LiteralPattern("rune", value))
    case Err(message) => Err(message)
  end
end

func greenTokenPatternLiteralKind(token: GreenToken) -> String
  if token.Kind == GreenTokenKind.Number then
    "number"
  elsif token.Kind == GreenTokenKind.RuneLiteral then
    "rune"
  elsif token.Kind == GreenTokenKind.StringLiteral || token.Kind == GreenTokenKind.RawStringLiteral || token.Kind == GreenTokenKind.TripleStringLiteral then
    "string"
  else
    ""
  end
end

func syntaxLiteralPatternToken(node: GreenNode, index: Int) -> Option[GreenToken]
  if index >= node.Children.Len() then
    None
  else
    switch greenElementAt(node.Children, index)
      case TokenElement(token) => Some(token)
      case _ => syntaxLiteralPatternToken(node, index + 1)
    end
  end
end

func lowerSyntaxPatternChildren(node: GreenNode, index: Int, output: Slice[ast2.Pattern]) -> Result[Slice[ast2.Pattern], String]
  if index >= node.Children.Len() then
    Ok(output)
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if greenNodeIsPatternKind(child.value().Kind) then
          switch lowerSyntaxPatternNode(child.value())
            case Ok(pattern) => lowerSyntaxPatternChildren(node, index + 1, output.Append(pattern))
            case Err(message) => Err(message)
          end
        else
          lowerSyntaxPatternChildren(node, index + 1, output)
        end
      end
      case None => lowerSyntaxPatternChildren(node, index + 1, output)
    end
  end
end

func lowerSyntaxStructPatternFields(node: GreenNode, index: Int, output: Slice[ast2.StructPatternField]) -> Result[Slice[ast2.StructPatternField], String]
  if index >= node.Children.Len() then
    Ok(output)
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) then
        if child.value().Kind == GreenNodeKind.StructPatternField then
          lowerSyntaxStructPatternFields(node, index + 1, output.Append(lowerSyntaxStructPatternField(child.value())))
        else
          lowerSyntaxStructPatternFields(node, index + 1, output)
        end
      end
      case None => lowerSyntaxStructPatternFields(node, index + 1, output)
    end
  end
end

func lowerSyntaxStructPatternField(node: GreenNode) -> ast2.StructPatternField
  let names = greenNodeIdentifierTexts(node, 0, [])
  if names.Len() == 0 then
    ast2.StructPatternField { Field: "_", Bind: "_" }
  else
    switch (names.Get(0), names.Get(1))
      case (Some(field), Some(bind)) => ast2.StructPatternField { Field: field, Bind: bind }
      case (Some(field), None) => ast2.StructPatternField { Field: field, Bind: field }
      case _ => ast2.StructPatternField { Field: "_", Bind: "_" }
    end
  end
end

func greenNodeIdentifierTexts(node: GreenNode, index: Int, output: Slice[String]) -> Slice[String]
  if index >= node.Children.Len() then
    output
  else
    switch greenElementAt(node.Children, index)
      case TokenElement(token) then
        if token.Kind == GreenTokenKind.Identifier then
          greenNodeIdentifierTexts(node, index + 1, output.Append(token.Raw))
        else
          greenNodeIdentifierTexts(node, index + 1, output)
        end
      end
      case _ => greenNodeIdentifierTexts(node, index + 1, output)
    end
  end
end

func greenNodeChildAt(node: GreenNode, index: Int) -> Option[Ref[GreenNode]]
  switch node.Children.Get(index)
    case Some(item) => greenElementNode(item)
    case None => None
  end
end

func syntaxOptionalTypeSpan(tree: SyntaxTree, node: GreenNode) -> ast2.SourceSpan
  switch greenNodeFindChild(node, GreenNodeKind.TypeAnnotation, 0)
    case Some(annotation) => syntaxAstSpan(tree.SourceName, annotation.value().Span)
    case None => syntaxAstSpan(tree.SourceName, node.Span)
  end
end

func greenNodeFindChild(node: GreenNode, kind: GreenNodeKind, index: Int) -> Option[Ref[GreenNode]]
  if index >= node.Children.Len() then
    None
  else
    switch node.Children.Get(index)
      case Some(item) then
        switch greenElementNode(item)
          case Some(child) then
            if child.value().Kind == kind then
              Some(child)
            else
              greenNodeFindChild(node, kind, index + 1)
            end
          end
          case None => greenNodeFindChild(node, kind, index + 1)
        end
      end
      case _ => greenNodeFindChild(node, kind, index + 1)
    end
  end
end

func greenNodeFindExpression(node: GreenNode, index: Int) -> Option[Ref[GreenNode]]
  if index >= node.Children.Len() then None else
    switch node.Children.Get(index)
      case Some(item) then
        switch greenElementNode(item)
          case Some(child) then
            if greenNodeIsExpressionKind(child.value().Kind) then
              Some(child)
            else
              greenNodeFindExpression(child.value(), 0)
            end
          end
          case None => greenNodeFindExpression(node, index + 1)
        end
      end
      case _ => greenNodeFindExpression(node, index + 1)
    end
  end
end

# greenNodeIsExpressionKind is the CST-side expression frontier.  It lists the
# concrete expression alternatives that lowering understands, including the
# atom kinds added for task 3.5.
func greenNodeIsExpressionKind(kind: GreenNodeKind) -> Bool
  kind == GreenNodeKind.IdentifierExpr || kind == GreenNodeKind.NumberExpr || kind == GreenNodeKind.BoolExpr || kind == GreenNodeKind.StringExpr || kind == GreenNodeKind.RuneExpr || kind == GreenNodeKind.ParenExpr || kind == GreenNodeKind.TupleExpr || kind == GreenNodeKind.UnitExpr || kind == GreenNodeKind.InlineGoExpr || kind == GreenNodeKind.FuncLitExpr || kind == GreenNodeKind.Call || kind == GreenNodeKind.UnaryExpr || kind == GreenNodeKind.BinaryExpr || kind == GreenNodeKind.FieldExpr || kind == GreenNodeKind.TypeAsExpr || kind == GreenNodeKind.SliceLiteral || kind == GreenNodeKind.MapLiteral || kind == GreenNodeKind.SetLiteral || kind == GreenNodeKind.StructLiteral || kind == GreenNodeKind.IfBlock || kind == GreenNodeKind.SwitchBlock || kind == GreenNodeKind.WhileBlock || kind == GreenNodeKind.Block || kind == GreenNodeKind.ExprStatement
end

func greenNodeFirstIdentifier(node: GreenNode) -> String
  switch greenNodeFindChild(node, GreenNodeKind.IdentifierExpr, 0)
    case Some(name) => greenNodeText(name.value())
    case None => ""
  end
end

func greenNodeIsDeclarationKind(kind: GreenNodeKind) -> Bool
  kind == GreenNodeKind.Declaration || kind == GreenNodeKind.ImportDeclaration || kind == GreenNodeKind.FuncDeclaration || kind == GreenNodeKind.TypeDeclaration || kind == GreenNodeKind.StructDeclaration || kind == GreenNodeKind.EnumDeclaration || kind == GreenNodeKind.InterfaceDeclaration || kind == GreenNodeKind.ImplDeclaration
end

func syntaxAstPos(sourceName: String, position: ps.Position) -> ast2.SourcePos
  ast2.SourcePos { SourceName: sourceName, Line: position.Line, Column: position.Column }
end

func syntaxAstSpan(sourceName: String, span: ps.SourceSpan) -> ast2.SourceSpan
  ast2.SourceSpan { Start: syntaxAstPos(sourceName, span.Start), End: syntaxAstPos(sourceName, span.End) }
end

func syntaxAstParseIsErr(result: Result[ast2.File, String]) -> Bool
  result.IsErr()
end

func syntaxLowerIsOk(result: Result[ast2.File, String]) -> Bool
  result.IsOk()
end

func syntaxLowerDeclCount(result: Result[ast2.File, String]) -> Int
  switch result
    case Ok(file) => file.Decls.Len()
    case Err(_) => 0
  end
end

# buildDelimitedSyntax is the first CST construction pass.  It consumes the
# lexer leaves exactly once, nesting only delimiters that are actually paired.
# Grammar-specific nodes are added on top of this invariant rather than by
# duplicating leaves in a semantic side table.
func buildDelimitedSyntax(sourceName: String, input: String) -> SyntaxTree
  let lexed = LexSource(input)
  let built = buildDelimitedChildren(lexed.Elements, 0, "")
  let declarations = parseFileDeclarations(SyntaxCursor { Elements: greenListToSlice(built.Children), Index: 0 }, [])
  let recovery = finishSyntaxRecovery(recoverSyntaxItems(lexed.Elements, 0, SyntaxRecoveryState {
    Delimiters: [],
    Blocks: [],
    Diagnostics: [],
  }))
  let topLevelDiagnostics = recoverTopLevelPrefix(lexed.Elements, 0, recovery.Diagnostics)
  let literalDiagnostics = recoverLiteralDiagnostics(lexed.Elements, 0, topLevelDiagnostics)
  let numericDiagnostics = recoverNumericLiteralDiagnostics(lexed.Elements, 0, literalDiagnostics)
  let diagnostics = recoverDeclarationHeaderDiagnostics(declarations, 0, numericDiagnostics)
  let recoveredDeclarations = recoverGreenElements(declarations, diagnostics)
  SyntaxTree {
    SourceName: sourceName,
    Source: input,
    Root: Ref.new(GreenNode {
      Kind: GreenNodeKind.File,
      Span: syntaxRootSpan(lexed.Elements),
      Children: recoveredDeclarations,
      HasError: diagnostics.Len() != 0,
    }),
    Diagnostics: diagnostics,
  }
end

func recoverLiteralDiagnostics(items: Slice[GreenElement], index: Int, diagnostics: Slice[SyntaxDiagnostic]) -> Slice[SyntaxDiagnostic]
  if index >= items.Len() then
    diagnostics
  else
    switch items.Get(index)
      case Some(item) then
        let next = if greenElementHasMalformedLiteral(item) then
          diagnostics.Append(SyntaxDiagnostic {
            Message: "unterminated literal",
            Span: greenElementSpan(item),
            Expected: [literalClosingDelimiter(item)],
            Recovery: "literal",
          })
        else
          diagnostics
        end
        recoverLiteralDiagnostics(items, index + 1, next)
      end
      case None => diagnostics
    end
  end
end

func greenElementHasMalformedLiteral(item: GreenElement) -> Bool
  switch item
    case TokenElement(token) => !greenLiteralIsClosed(token)
    case _ => false
  end
end

func greenLiteralIsClosed(token: GreenToken) -> Bool
  if token.Kind == GreenTokenKind.StringLiteral then
    token.Raw.Len() >= 2 && strings.HasSuffix(token.Raw, "\"")
  elsif token.Kind == GreenTokenKind.RawStringLiteral then
    token.Raw.Len() >= 2 && strings.HasSuffix(token.Raw, "`")
  elsif token.Kind == GreenTokenKind.TripleStringLiteral then
    token.Raw.Len() >= 6 && strings.HasSuffix(token.Raw, "\"\"\"")
  elsif token.Kind == GreenTokenKind.RuneLiteral then
    token.Raw.Len() >= 2 && strings.HasSuffix(token.Raw, "'")
  else
    true
  end
end

func literalClosingDelimiter(item: GreenElement) -> String
  switch item
    case TokenElement(token) then
      if token.Kind == GreenTokenKind.TripleStringLiteral then
        "\"\"\""
      elsif token.Kind == GreenTokenKind.RawStringLiteral then
        "`"
      elsif token.Kind == GreenTokenKind.RuneLiteral then
        "'"
      else
        "\""
      end
    end
    case _ => ""
  end
end

# Number tokens are lexed greedily so that `1.2` and `3.14f32` stay one leaf,
# but that also lets malformed text such as `1.2.3`, `1oops`, `0x`, `0b102`,
# `1_`, and `0x_1` reach the tree.  The lexer has no way to reject them without
# a second pass, so the recovery scan validates each number leaf against the
# legacy grammar (`digits(.digits)?suffix`, or a prefixed digit run with an
# integer suffix) and records a location-bearing diagnostic for the failures.
func recoverNumericLiteralDiagnostics(items: Slice[GreenElement], index: Int, diagnostics: Slice[SyntaxDiagnostic]) -> Slice[SyntaxDiagnostic]
  if index >= items.Len() then
    diagnostics
  else
    switch items.Get(index)
      case Some(item) then
        let next = if greenElementHasInvalidNumber(item) then
          diagnostics.Append(SyntaxDiagnostic {
            Message: "invalid numeric literal",
            Span: greenElementSpan(item),
            Expected: ["number literal"],
            Recovery: "number literal",
          })
        else
          diagnostics
        end
        recoverNumericLiteralDiagnostics(items, index + 1, next)
      end
      case None => diagnostics
    end
  end
end

func greenElementHasInvalidNumber(item: GreenElement) -> Bool
  switch item
    case TokenElement(token) => token.Kind == GreenTokenKind.Number && !greenNumberIsValid(token.Raw)
    case _ => false
  end
end

func greenNumberIsValid(raw: String) -> Bool
  let runes = raw as Slice[Rune]
  switch (runes.Get(0), runes.Get(1))
    case (Some(first), Some(second)) then
      if first == '0' && (second == 'x' || second == 'X') then
        numberPrefixedIsValid(runes, 2, numberIsHexDigit)
      elsif first == '0' && (second == 'o' || second == 'O') then
        numberPrefixedIsValid(runes, 2, numberIsOctalDigit)
      elsif first == '0' && (second == 'b' || second == 'B') then
        numberPrefixedIsValid(runes, 2, numberIsBinaryDigit)
      else
        numberDecimalIsValid(runes)
      end
    end
    case _ => numberDecimalIsValid(runes)
  end
end

func numberDecimalIsValid(runes: Slice[Rune]) -> Bool
  let afterWhole = numberDigitRunEnd(runes, 0, numberIsDecimalDigit)
  if afterWhole == 0 then
    false
  else
    switch runes.Get(afterWhole)
      case Some(raw) then
        if raw == '.' then
          let afterFraction = numberDigitRunEnd(runes, afterWhole + 1, numberIsDecimalDigit)
          if afterFraction == afterWhole + 1 then
            false
          else
            numberSuffixText(runes, afterFraction, true)
          end
        else
          numberSuffixText(runes, afterWhole, true)
        end
      end
      case None => true
    end
  end
end

func numberPrefixedIsValid(runes: Slice[Rune], start: Int, valid: func(Rune) -> Bool) -> Bool
  let afterDigits = numberDigitRunEnd(runes, start, valid)
  if afterDigits == start then
    false
  else
    numberSuffixText(runes, afterDigits, false)
  end
end

# numberDigitRunEnd consumes `digit (_? digit)*` starting at index.  A run that
# ends on a bare underscore (`1_`) stops before it so the caller sees the
# trailing underscore and rejects the leaf.
func numberDigitRunEnd(runes: Slice[Rune], index: Int, valid: func(Rune) -> Bool) -> Int
  switch runes.Get(index)
    case Some(raw) => if valid(raw) => numberDigitRunTail(runes, index + 1, valid) else index
    case None => index
  end
end

func numberDigitRunTail(runes: Slice[Rune], index: Int, valid: func(Rune) -> Bool) -> Int
  switch runes.Get(index)
    case Some(raw) then
      if valid(raw) then
        numberDigitRunTail(runes, index + 1, valid)
      elsif raw == '_' then
        switch runes.Get(index + 1)
          case Some(next) => if valid(next) => numberDigitRunTail(runes, index + 2, valid) else index
          case None => index
        end
      else
        index
      end
    end
    case None => index
  end
end

# numberSuffixText accepts an empty tail (no suffix), an integer suffix, or a
# float suffix when the literal already carried a fraction.  Prefixed literals
# pass allowFloat=false because the legacy grammar only suffixes them with an
# integer type.
func numberSuffixText(runes: Slice[Rune], index: Int, allowFloat: Bool) -> Bool
  switch runes.Slice(index, runes.Len())
    case Some(tail) then
      let text = String.FromRunes(tail)
      if text == "" then
        true
      elsif numberIntegerSuffix(text) then
        true
      elsif allowFloat && numberFloatSuffix(text) then
        true
      else
        false
      end
    end
    case None => index >= runes.Len()
  end
end

func numberIntegerSuffix(raw: String) -> Bool
  raw == "i8" || raw == "i16" || raw == "i32" || raw == "i64" || raw == "u8" || raw == "u16" || raw == "u32" || raw == "u64" || raw == "u"
end

func numberFloatSuffix(raw: String) -> Bool
  raw == "f32" || raw == "f64"
end

func numberIsDecimalDigit(raw: Rune) -> Bool
  raw >= '0' && raw <= '9'
end

func numberIsHexDigit(raw: Rune) -> Bool
  numberIsDecimalDigit(raw) || (raw >= 'a' && raw <= 'f') || (raw >= 'A' && raw <= 'F')
end

func numberIsOctalDigit(raw: Rune) -> Bool
  raw >= '0' && raw <= '7'
end

func numberIsBinaryDigit(raw: Rune) -> Bool
  raw == '0' || raw == '1'
end

# A truncated declaration header leaves the semantic children without the name
# or parameter group the lowering step needs, so it would only fail later with
# an unlocated message.  This pass records the missing header boundary as a
# location-bearing diagnostic instead, matching the legacy parser's
# `expected identifier` / `expected (` errors at the first missing token.
func recoverDeclarationHeaderDiagnostics(items: Slice[GreenElement], index: Int, diagnostics: Slice[SyntaxDiagnostic]) -> Slice[SyntaxDiagnostic]
  if index >= items.Len() then
    diagnostics
  else
    switch items.Get(index)
      case Some(item) then
        recoverDeclarationHeaderDiagnostics(items, index + 1, recoverDeclarationHeaderDiagnostic(item, diagnostics))
      end
      case None => diagnostics
    end
  end
end

func recoverDeclarationHeaderDiagnostic(item: GreenElement, diagnostics: Slice[SyntaxDiagnostic]) -> Slice[SyntaxDiagnostic]
  switch greenElementNode(item)
    case Some(node) then
      if node.value().Kind == GreenNodeKind.FuncDeclaration then
        recoverFunctionHeaderDiagnostic(node.value(), diagnostics)
      else
        diagnostics
      end
    end
    case None => diagnostics
  end
end

func recoverFunctionHeaderDiagnostic(node: GreenNode, diagnostics: Slice[SyntaxDiagnostic]) -> Slice[SyntaxDiagnostic]
  if greenNodeHasError(node) then
    diagnostics
  else
    recoverFunctionHeaderBoundary(node, diagnostics)
  end
end

func recoverFunctionHeaderBoundary(node: GreenNode, diagnostics: Slice[SyntaxDiagnostic]) -> Slice[SyntaxDiagnostic]
  let keywordIndex = syntaxNextTokenIndex(node.Children, 0)
  if keywordIndex < 0 then
    diagnostics
  else
    let nameIndex = syntaxNextTokenIndex(node.Children, keywordIndex + 1)
    if nameIndex < 0 then
      diagnostics.Append(
        declarationHeaderDiagnostic(
          "expected identifier",
          ["identifier"],
          greenElementSpan(greenElementAt(node.Children, keywordIndex)).End,
        ),
      )
    elsif !greenElementIsPlainIdentifier(greenElementAt(node.Children, nameIndex)) then
      diagnostics.Append(
        declarationHeaderDiagnostic(
          "expected identifier",
          ["identifier"],
          greenElementSpan(greenElementAt(node.Children, nameIndex)).Start,
        ),
      )
    elsif greenNodeFindChild(node, GreenNodeKind.FunctionParameters, 0).IsNone() then
      diagnostics.Append(
        declarationHeaderDiagnostic(
          "expected (",
          ["("],
          greenElementSpan(greenElementAt(node.Children, nameIndex)).End,
        ),
      )
    else
      diagnostics
    end
  end
end

func declarationHeaderDiagnostic(message: String, expected: Slice[String], position: ps.Position) -> SyntaxDiagnostic
  SyntaxDiagnostic {
    Message: message,
    Span: ps.SourceSpan { Start: position, End: position },
    Expected: expected,
    Recovery: "declaration header",
  }
end

# greenElementIsPlainIdentifier accepts a bare identifier token or a name node
# that textually spells an identifier.  A parenthesized group such as `()` is
# wrapped as a name node by declarationChildrenWithName but is not a name.
func greenElementIsPlainIdentifier(item: GreenElement) -> Bool
  switch item
    case TokenElement(token) => token.Kind == GreenTokenKind.Identifier
    case NodeElement(node) then
      node.value().Kind == GreenNodeKind.IdentifierExpr && syntaxTextIsIdentifier(greenNodeText(node.value()))
    end
    case _ => false
  end
end

func syntaxTextIsIdentifier(text: String) -> Bool
  if text == "" then
    false
  else
    syntaxIdentifierRunes(text as Slice[Rune], 0)
  end
end

func syntaxIdentifierRunes(runes: Slice[Rune], index: Int) -> Bool
  if index >= runes.Len() then
    true
  else
    switch runes.Get(index)
      case Some(raw) => isWordChar(String.FromRunes([raw])) && syntaxIdentifierRunes(runes, index + 1)
      case None => true
    end
  end
end

# A declaration start is the top-level synchronization boundary. Only the
# prefix before the first declaration is considered here; declaration bodies
# are intentionally left to their own grammar contexts.
func recoverTopLevelPrefix(items: Slice[GreenElement], index: Int, diagnostics: Slice[SyntaxDiagnostic]) -> Slice[SyntaxDiagnostic]
  if index >= items.Len() then
    diagnostics
  else
    switch items.Get(index)
      case Some(item) then
        if greenElementIsTrivia(item) || greenElementStartsDeclaration(item) || isRecoveryStructuralToken(greenElementRaw(item)) then
          if greenElementStartsDeclaration(item) then
            diagnostics
          else
            recoverTopLevelPrefix(items, index + 1, diagnostics)
          end
        elsif topLevelDeclarationAfterLine(items, index + 1, false) then
          recoverTopLevelPrefix(items, index + 1, diagnostics.Append(SyntaxDiagnostic {
            Message: "expected top-level declaration",
            Span: greenElementSpan(item),
            Expected: ["declaration"],
            Recovery: "top-level declaration",
          }))
        else
          recoverTopLevelPrefix(items, index + 1, diagnostics)
        end
      end
      case None => diagnostics
    end
  end
end

func topLevelDeclarationAfterLine(items: Slice[GreenElement], index: Int, sawLine: Bool) -> Bool
  if index >= items.Len() then
    false
  else
    switch items.Get(index)
      case Some(item) then
        if greenElementStartsDeclaration(item) then
          sawLine
        else
          topLevelDeclarationAfterLine(items, index + 1, sawLine || (greenElementIsTrivia(item) && strings.Contains(greenElementRaw(item), "\n")))
        end
      end
      case None => false
    end
  end
end

func isRecoveryStructuralToken(raw: String) -> Bool
  structuralClose(raw) != "" || isDelimiterClose(raw) || raw == "end" || raw == "elsif" || raw == "else" || raw == "case"
end

func recoverSyntaxItems(items: Slice[GreenElement], index: Int, state: SyntaxRecoveryState) -> SyntaxRecoveryState
  if index >= items.Len() then
    state
  else
    switch items.Get(index)
      case Some(item) => recoverSyntaxItems(items, index + 1, recoverSyntaxItem(items, index, state))
      case None => state
    end
  end
end

func recoverSyntaxItem(items: Slice[GreenElement], index: Int, state: SyntaxRecoveryState) -> SyntaxRecoveryState
  let item = greenElementAt(items, index)
  if greenElementIsTrivia(item) then
    state
  else
    let raw = greenElementRaw(item)
    let close = delimiterClose(raw)
    if close != "" then
      SyntaxRecoveryState {
        Delimiters: state.Delimiters.Append(item),
        Blocks: state.Blocks,
        Diagnostics: state.Diagnostics,
      }
    elsif isDelimiterClose(raw) then
      recoverDelimiterClose(item, state)
    elsif syntaxBlockCloseAt(items, index, state.Blocks) != "" then
      SyntaxRecoveryState {
        Delimiters: state.Delimiters,
        Blocks: state.Blocks.Append(SyntaxBlock { Keyword: raw, Close: syntaxBlockCloseAt(items, index, state.Blocks), Span: greenElementSpan(item) }),
        Diagnostics: state.Diagnostics,
      }
    elsif raw == "end" then
      recoverBlockEnd(item, state)
    elsif raw == "elsif" || raw == "else" then
      recoverIfBranch(item, raw, state)
    elsif raw == "case" then
      recoverCaseBranch(item, state)
    else
      state
    end
  end
end

func recoverDelimiterClose(item: GreenElement, state: SyntaxRecoveryState) -> SyntaxRecoveryState
  switch syntaxRecoveryLast(state.Delimiters)
    case Some(open) then
      if delimiterClose(greenElementRaw(open)) == greenElementRaw(item) then
        SyntaxRecoveryState {
          Delimiters: syntaxRecoveryDropLast(state.Delimiters),
          Blocks: state.Blocks,
          Diagnostics: state.Diagnostics,
        }
      else
        syntaxRecoveryError(state, item, "unexpected closing delimiter", [delimiterClose(greenElementRaw(open))], "delimiter")
      end
    end
    case None => syntaxRecoveryError(state, item, "unexpected closing delimiter", [], "delimiter")
  end
end

func recoverBlockEnd(item: GreenElement, state: SyntaxRecoveryState) -> SyntaxRecoveryState
  switch syntaxRecoveryLastBlock(state.Blocks)
    case Some(open) then
      if open.Close == "end" then
        SyntaxRecoveryState {
          Delimiters: state.Delimiters,
          Blocks: syntaxRecoveryDropLastBlock(state.Blocks),
          Diagnostics: state.Diagnostics,
        }
      else
        syntaxRecoveryError(state, item, "unexpected end", [open.Close], "branch/end")
      end
    end
    case None then
      syntaxRecoveryError(state, item, "unexpected end", ["if", "switch", "while"], "branch/end")
    end
  end
end

func recoverIfBranch(item: GreenElement, raw: String, state: SyntaxRecoveryState) -> SyntaxRecoveryState
  switch syntaxRecoveryLastBlock(state.Blocks)
    case Some(block) then
      if block.Keyword != "if" then
        syntaxRecoveryError(state, item, "branch outside if block", ["end"], "branch/end")
      elsif block.Close == "else" then
        # A single-line arrow-if is closed by its `else`; the branch keyword
        # itself terminates the block.
        SyntaxRecoveryState {
          Delimiters: state.Delimiters,
          Blocks: syntaxRecoveryDropLastBlock(state.Blocks),
          Diagnostics: state.Diagnostics,
        }
      else
        state
      end
    end
    case None => syntaxRecoveryError(state, item, "branch outside if block", ["if"], "branch/end")
  end
end

func recoverCaseBranch(item: GreenElement, state: SyntaxRecoveryState) -> SyntaxRecoveryState
  switch syntaxRecoveryLastBlock(state.Blocks)
    case Some(block) then
      if block.Keyword == "switch" then
        state
      elsif block.Keyword == "case" && block.Close == "else" then
        SyntaxRecoveryState {
          Delimiters: state.Delimiters,
          Blocks: syntaxRecoveryDropLastBlock(state.Blocks),
          Diagnostics: state.Diagnostics,
        }
      else
        syntaxRecoveryError(state, item, "case outside switch block", ["end"], "branch/end")
      end
    end
    case None then
      syntaxRecoveryError(state, item, "case outside switch block", ["switch"], "branch/end")
    end
  end
end

func finishSyntaxRecovery(state: SyntaxRecoveryState) -> SyntaxRecoveryState
  let delimiters = finishUnclosedDelimiters(state.Delimiters, state)
  finishUnclosedBlocks(state.Blocks, delimiters)
end

func finishUnclosedDelimiters(items: Slice[GreenElement], state: SyntaxRecoveryState) -> SyntaxRecoveryState
  switch syntaxRecoveryLast(items)
    case Some(open) => finishUnclosedDelimiters(syntaxRecoveryDropLast(items), syntaxRecoveryError(state, open, "unclosed delimiter", [delimiterClose(greenElementRaw(open))], "delimiter"))
    case None => state
  end
end

func finishUnclosedBlocks(items: Slice[SyntaxBlock], state: SyntaxRecoveryState) -> SyntaxRecoveryState
  switch syntaxRecoveryLastBlock(items)
    case Some(open) => finishUnclosedBlocks(syntaxRecoveryDropLastBlock(items), syntaxRecoveryStateAddBlock(state, open))
    case None => state
  end
end

func syntaxRecoveryStateAddBlock(state: SyntaxRecoveryState, open: SyntaxBlock) -> SyntaxRecoveryState
  SyntaxRecoveryState {
    Delimiters: state.Delimiters,
    Blocks: state.Blocks,
    Diagnostics: state.Diagnostics.Append(SyntaxDiagnostic {
      Message: "unclosed keyword block",
      Span: open.Span,
      Expected: [open.Close],
      Recovery: "branch/end",
    }),
  }
end

func syntaxRecoveryError(state: SyntaxRecoveryState, item: GreenElement, message: String, expected: Slice[String], recovery: String) -> SyntaxRecoveryState
  SyntaxRecoveryState {
    Delimiters: state.Delimiters,
    Blocks: state.Blocks,
    Diagnostics: state.Diagnostics.Append(SyntaxDiagnostic {
      Message: message,
      Span: greenElementSpan(item),
      Expected: expected,
      Recovery: recovery,
    }),
  }
end

func syntaxRecoveryLast(items: Slice[GreenElement]) -> Option[GreenElement]
  if items.Len() == 0 => None else items.Get(items.Len() - 1)
end

func syntaxRecoveryDropLast(items: Slice[GreenElement]) -> Slice[GreenElement]
  if items.Len() == 0 => [] else greenElementSliceOrEmpty(items, 0, items.Len() - 1)
end

func syntaxRecoveryLastBlock(items: Slice[SyntaxBlock]) -> Option[SyntaxBlock]
  if items.Len() == 0 => None else items.Get(items.Len() - 1)
end

func syntaxRecoveryDropLastBlock(items: Slice[SyntaxBlock]) -> Slice[SyntaxBlock]
  if items.Len() == 0 => [] else syntaxBlockSliceOrEmpty(items, 0, items.Len() - 1)
end

func syntaxBlockSliceOrEmpty(items: Slice[SyntaxBlock], start: Int, finish: Int) -> Slice[SyntaxBlock]
  switch items.Slice(start, finish)
    case Some(slice) => slice
    case None => []
  end
end

func isDelimiterClose(raw: String) -> Bool
  raw == ")" || raw == "]" || raw == "}"
end

func recoverGreenElements(items: Slice[GreenElement], diagnostics: Slice[SyntaxDiagnostic]) -> Slice[GreenElement]
  recoverGreenElementsFrom(items, diagnostics, 0, [])
end

func recoverGreenElementsFrom(items: Slice[GreenElement], diagnostics: Slice[SyntaxDiagnostic], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    switch items.Get(index)
      case Some(item) then
        recoverGreenElementsFrom(
          items,
          diagnostics,
          index + 1,
          output.Append(recoverGreenElement(item, diagnostics)),
        )
      end
      case None => output
    end
  end
end

func recoverGreenElement(item: GreenElement, diagnostics: Slice[SyntaxDiagnostic]) -> GreenElement
  switch item
    case NodeElement(node) then
      let value = node.value()
      GreenElement.NodeElement(Ref.new(GreenNode {
        Kind: value.Kind,
        Span: value.Span,
        Children: recoverGreenElements(value.Children, diagnostics),
        HasError: value.HasError || greenElementHasDiagnostic(item, diagnostics),
      }))
    end
    case _ => if greenElementHasDiagnostic(item, diagnostics) then
      GreenElement.NodeElement(Ref.new(GreenNode {
        Kind: GreenNodeKind.Error,
        Span: greenElementSpan(item),
        Children: [item],
        HasError: true,
      }))
    else
      item
    end
  end
end

func greenElementHasDiagnostic(item: GreenElement, diagnostics: Slice[SyntaxDiagnostic]) -> Bool
  diagnostics.Find(func(diagnostic: SyntaxDiagnostic) -> Bool
    diagnostic.Span.Start.Offset == greenElementSpan(item).Start.Offset
  end).IsSome()
end

func parseFileDeclarations(cursor: SyntaxCursor, items: Slice[GreenElement]) -> Slice[GreenElement]
  let current = syntaxCursorSkipTrivia(cursor)
  if current.Index > cursor.Index then
    switch syntaxCursorPeek(cursor)
      case Some(item) => parseFileDeclarations(syntaxCursorAdvance(cursor), items.Append(item))
      case None => items
    end
  elsif current.Index >= current.Elements.Len() then
    items
  else
    let parsed = parseDeclaration(current)
    if parsed.Cursor.Index > current.Index then
      switch parsed.Node
        case Some(node) => parseFileDeclarations(parsed.Cursor, items.Append(GreenElement.NodeElement(node)))
        case None => parseFileDeclarations(parsed.Cursor, items)
      end
    else
      switch syntaxCursorPeek(cursor)
        case Some(item) => parseFileDeclarations(syntaxCursorAdvance(cursor), items.Append(item))
        case None => items
      end
    end
  end
end

func syntaxCursorPeek(cursor: SyntaxCursor) -> Option[GreenElement]
  cursor.Elements.Get(cursor.Index)
end

func syntaxCursorAdvance(cursor: SyntaxCursor) -> SyntaxCursor
  SyntaxCursor { Elements: cursor.Elements, Index: cursor.Index + 1 }
end

func syntaxCursorSkipTrivia(cursor: SyntaxCursor) -> SyntaxCursor
  switch syntaxCursorPeek(cursor)
    case Some(item) then
      if greenElementIsTrivia(item) then
        syntaxCursorSkipTrivia(syntaxCursorAdvance(cursor))
      else
        cursor
      end
    end
    case None => cursor
  end
end

# Like syntaxCursorSkipTrivia, but stops at a newline-bearing trivia so that a
# construct cannot silently continue onto the following source line.  MyGO
# treats newlines as statement/declaration boundaries, so suffix parsing such as
# generic type arguments must not cross them.
func syntaxCursorSkipTriviaSameLine(cursor: SyntaxCursor) -> SyntaxCursor
  switch syntaxCursorPeek(cursor)
    case Some(item) then
      if greenElementIsTrivia(item) && !strings.Contains(greenElementRaw(item), "\n") then
        syntaxCursorSkipTriviaSameLine(syntaxCursorAdvance(cursor))
      else
        cursor
      end
    end
    case None => cursor
  end
end

func greenElementsContainNewline(items: Slice[GreenElement], start: Int, finish: Int) -> Bool
  if start >= finish then
    false
  else
    switch items.Get(start)
      case Some(item) then
        if strings.Contains(greenElementRaw(item), "\n") then
          true
        else
          greenElementsContainNewline(items, start + 1, finish)
        end
      end
      case None => false
    end
  end
end

func greenElementIsTrivia(item: GreenElement) -> Bool
  switch item
    case TriviaElement(_) => true
    case _ => false
  end
end

func syntaxCursorRaw(cursor: SyntaxCursor) -> String
  switch syntaxCursorPeek(syntaxCursorSkipTrivia(cursor))
    case Some(item) => greenElementRaw(item)
    case None => ""
  end
end

func syntaxCursorPreviousRaw(cursor: SyntaxCursor, index: Int) -> String
  if index < 0 then
    ""
  else
    switch cursor.Elements.Get(index)
      case Some(item) then
        if greenElementIsTrivia(item) then
          syntaxCursorPreviousRaw(cursor, index - 1)
        else
          greenElementRaw(item)
        end
      end
      case None => ""
    end
  end
end

# These entry points deliberately form the CST grammar call chain.  Their
# detailed alternatives are introduced incrementally; no ast2 node or legacy
# span metadata participates in this syntax phase.
func parseDeclaration(cursor: SyntaxCursor) -> SyntaxParseResult
  let current = syntaxCursorSkipTrivia(cursor)
  let raw = syntaxCursorRaw(current)
  let parsed = if greenElementStartsDeclarationRaw(raw) then
    SyntaxParseResult { Node: None, Cursor: syntaxCursorAtNextDeclaration(current) }
  else
    SyntaxParseResult { Node: None, Cursor: cursor }
  end
  freezeDeclaration(cursor, parsed)
end

func syntaxCursorAtNextDeclaration(cursor: SyntaxCursor) -> SyntaxCursor
  let next = nextTopLevelDeclaration(cursor.Elements, cursor.Index)
  SyntaxCursor {
    Elements: cursor.Elements,
    Index: if next < 0 => cursor.Elements.Len() else next,
  }
end

# nextTopLevelDeclaration returns the start of the next top-level declaration
# after the one beginning at start, or -1 at end of input.  A declaration that
# opens a keyword block owns every nested block up to its matching `end`, so
# interface/impl methods and struct/enum members stay inside their enclosing
# declaration instead of being exported as separate top-level declarations.
func nextTopLevelDeclaration(items: Slice[GreenElement], start: Int) -> Int
  if start >= items.Len() then
    -1
  elsif syntaxBlockCloseAt(items, start, []) == "" then
    nextLineLeadingDeclaration(items, start + 1)
  else
    nextDeclarationAfterBlock(items, start + 1, [SyntaxBlock { Keyword: greenElementRaw(greenElementAt(items, start)), Close: "", Span: syntaxRootSpan([]) }], 1)
  end
end

# nextDeclarationAfterBlock skips a declaration's nested keyword blocks.  The
# scan starts inside the declaration's own block (depth 1); the `end` that
# closes it hands the search to the next line-leading declaration keyword.
func nextDeclarationAfterBlock(items: Slice[GreenElement], index: Int, blocks: Slice[SyntaxBlock], depth: Int) -> Int
  if index >= items.Len() then
    -1
  else
    let item = greenElementAt(items, index)
    if greenElementIsTrivia(item) then
      nextDeclarationAfterBlock(items, index + 1, blocks, depth)
    elsif greenElementRaw(item) == "end" then
      if depth <= 1 then
        nextLineLeadingDeclaration(items, index + 1)
      else
        nextDeclarationAfterBlock(items, index + 1, syntaxRecoveryDropLastBlock(blocks), depth - 1)
      end
    else
      let open = syntaxBlockCloseAt(items, index, blocks)
      if open == "" then
        nextDeclarationAfterBlock(items, index + 1, blocks, depth)
      else
        nextDeclarationAfterBlock(items, index + 1, blocks.Append(SyntaxBlock { Keyword: greenElementRaw(item), Close: open, Span: greenElementSpan(item) }), depth + 1)
      end
    end
  end
end

func nextLineLeadingDeclaration(items: Slice[GreenElement], index: Int) -> Int
  if index >= items.Len() then
    -1
  elsif greenElementIsLineLeading(items, index) && greenElementStartsDeclaration(greenElementAt(items, index)) then
    index
  else
    nextLineLeadingDeclaration(items, index + 1)
  end
end

# A declaration keyword only opens a new declaration when it begins a line.
# This keeps `func` inside a type position such as `let g: func(Int) -> Bool`
# from being mistaken for the start of the next top-level declaration.
func greenElementIsLineLeading(items: Slice[GreenElement], index: Int) -> Bool
  if index <= 0 then
    true
  else
    switch items.Get(index - 1)
      case Some(previous) => greenElementIsTrivia(previous) && strings.Contains(greenElementRaw(previous), "\n")
      case None => true
    end
  end
end

func freezeDeclaration(start: SyntaxCursor, parsed: SyntaxParseResult) -> SyntaxParseResult
  if parsed.Cursor.Index <= start.Index then
    parsed
  else
    switch start.Elements.Slice(start.Index, parsed.Cursor.Index)
      case Some(children) then
        switch (children.Get(0), children.Get(children.Len() - 1))
          case (Some(first), Some(last)) then
            SyntaxParseResult {
              Node: Some(Ref.new(GreenNode {
                Kind: declarationKind(syntaxCursorRaw(start)),
                Span: ps.SourceSpan {
                  Start: greenElementSpan(first).Start,
                  End: greenElementSpan(last).End
                },
                Children: declarationSemanticChildren(declarationKind(syntaxCursorRaw(start)), children),
                HasError: false,
              })),
              Cursor: parsed.Cursor,
            }
          end
          case _ => parsed
        end
      end
      case None => parsed
    end
  end
end

func declarationSemanticChildren(kind: GreenNodeKind, items: Slice[GreenElement]) -> Slice[GreenElement]
  let named = declarationChildrenWithName(items, 0, "", [])
  if kind == GreenNodeKind.FuncDeclaration then
    functionBodyChildren(functionParameterChildren(declarationChildrenWithExpr(functionReturnChildren(functionUsingChildren(typeParameterChildren(named, 1, 0, greenElementSliceOrEmpty(named, 0, 1)), 0, []), 0, []), 0, []), 0, false, []))
  elsif kind == GreenNodeKind.TypeDeclaration then
    typeDeclarationChildren(typeParameterChildren(named, 1, 0, greenElementSliceOrEmpty(named, 0, 1)), 0, [])
  elsif kind == GreenNodeKind.ImportDeclaration then
    importDeclarationChildren(items, 0, [])
  elsif kind == GreenNodeKind.StructDeclaration then
    structDeclarationChildren(items)
  elsif kind == GreenNodeKind.EnumDeclaration then
    enumDeclarationChildren(items)
  elsif kind == GreenNodeKind.InterfaceDeclaration then
    interfaceDeclarationChildren(items)
  elsif kind == GreenNodeKind.ImplDeclaration then
    implDeclarationChildren(items)
  else
    declarationChildrenWithExpr(named, 0, [])
  end
end

# typeParameterChildren wraps the declaration's `[T, C[A]]` parameter list into
# one TypeParameters node.  Only the bracket group that immediately follows the
# declared name (with only trivia in between) is the parameter list; a bracket
# that belongs to a later type argument stays owned by that type.  Phase 0 seeks
# the name (or the bracket itself for `impl[T]`), phase 1 accepts the optional
# bracket, and phase 2 copies the remaining header unchanged.
func typeParameterChildren(items: Slice[GreenElement], index: Int, phase: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  elsif phase == 2 then
    joinGreenElements(output, greenElementSliceOrEmpty(items, index, items.Len()))
  else
    let item = greenElementAt(items, index)
    if greenElementIsTrivia(item) then
      typeParameterChildren(items, index + 1, phase, output.Append(item))
    elsif syntaxElementIsNodeKind(item, GreenNodeKind.BracketGroup) then
      switch greenElementNode(item)
        case Some(group) then
          joinGreenElements(output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
            Kind: GreenNodeKind.TypeParameters,
            Span: group.value().Span,
            Children: parseTypeItems(group.value().Children, 0, []),
            HasError: group.value().HasError,
          }))), greenElementSliceOrEmpty(items, index + 1, items.Len()))
        end
        case None => typeParameterChildren(items, index + 1, 2, output.Append(item))
      end
    elsif phase == 0 && syntaxElementIsNodeKind(item, GreenNodeKind.IdentifierExpr) then
      typeParameterChildren(items, index + 1, 1, output.Append(item))
    else
      joinGreenElements(output, greenElementSliceOrEmpty(items, index, items.Len()))
    end
  end
end

func syntaxElementIsNodeKind(item: GreenElement, kind: GreenNodeKind) -> Bool
  switch greenElementNode(item)
    case Some(node) => node.value().Kind == kind
    case None => false
  end
end

func greenElementIsStringLiteral(item: GreenElement) -> Bool
  switch item
    case TokenElement(token) then
      token.Kind == GreenTokenKind.StringLiteral || token.Kind == GreenTokenKind.RawStringLiteral || token.Kind == GreenTokenKind.TripleStringLiteral
    end
    case _ => false
  end
end

func greenElementSliceSpan(items: Slice[GreenElement], start: Int, finish: Int) -> ps.SourceSpan
  switch (items.Get(start), items.Get(finish - 1))
    case (Some(first), Some(last)) then
      ps.SourceSpan { Start: greenElementSpan(first).Start, End: greenElementSpan(last).End }
    end
    case _ => syntaxRootSpan([])
  end
end

func syntaxLastTokenIndex(items: Slice[GreenElement], index: Int) -> Int
  if index < 0 then
    -1
  elsif greenElementIsTrivia(greenElementAt(items, index)) then
    syntaxLastTokenIndex(items, index - 1)
  else
    index
  end
end

# syntaxNextLineLeading finds the first non-trivia element at or after index that
# begins a new logical line.  MyGO declarations separate members by newlines, so
# a line-leading token is the member boundary.
func syntaxNextLineLeading(items: Slice[GreenElement], index: Int, finish: Int) -> Int
  if index >= finish then
    -1
  elsif greenElementIsLineLeading(items, index) && !greenElementIsTrivia(greenElementAt(items, index)) then
    index
  else
    syntaxNextLineLeading(items, index + 1, finish)
  end
end

func syntaxNextFuncLine(items: Slice[GreenElement], index: Int, finish: Int) -> Int
  if index >= finish then
    -1
  elsif greenElementIsLineLeading(items, index) && !greenElementIsTrivia(greenElementAt(items, index)) && greenElementRaw(greenElementAt(items, index)) == "func" then
    index
  else
    syntaxNextFuncLine(items, index + 1, finish)
  end
end

func importDeclarationChildren(items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    let item = greenElementAt(items, index)
    if greenElementIsTrivia(item) then
      importDeclarationChildren(items, index + 1, output.Append(item))
    elsif greenElementIsStringLiteral(item) then
      joinGreenElements(output.Append(item), greenElementSliceOrEmpty(items, index + 1, items.Len()))
    elsif greenElementRaw(item) == "." || syntaxElementNameToken(item) then
      joinGreenElements(output.Append(GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.IdentifierExpr, Span: greenElementSpan(item), Children: [item], HasError: false }))), greenElementSliceOrEmpty(items, index + 1, items.Len()))
    else
      importDeclarationChildren(items, index + 1, output.Append(item))
    end
  end
end

func structDeclarationChildren(items: Slice[GreenElement]) -> Slice[GreenElement]
  let named = declarationChildrenWithName(items, 0, "", [])
  let header = typeParameterChildren(named, 1, 0, greenElementSliceOrEmpty(named, 0, 1))
  let bodyStart = syntaxNextLineLeading(header, 1, header.Len())
  let endIndex = syntaxLastTokenIndex(header, header.Len() - 1)
  if bodyStart < 0 || endIndex < 0 then
    header
  else
    joinGreenElements(joinGreenElements(greenElementSliceOrEmpty(header, 0, bodyStart), syntaxFieldMembers(GreenNodeKind.StructField, header, bodyStart, endIndex, [])), greenElementSliceOrEmpty(header, endIndex, header.Len()))
  end
end

func enumDeclarationChildren(items: Slice[GreenElement]) -> Slice[GreenElement]
  let named = declarationChildrenWithName(items, 0, "", [])
  let header = typeParameterChildren(named, 1, 0, greenElementSliceOrEmpty(named, 0, 1))
  let bodyStart = syntaxNextLineLeading(header, 1, header.Len())
  let endIndex = syntaxLastTokenIndex(header, header.Len() - 1)
  if bodyStart < 0 || endIndex < 0 then
    header
  else
    joinGreenElements(joinGreenElements(greenElementSliceOrEmpty(header, 0, bodyStart), syntaxFieldMembers(GreenNodeKind.EnumVariant, header, bodyStart, endIndex, [])), greenElementSliceOrEmpty(header, endIndex, header.Len()))
  end
end

func interfaceDeclarationChildren(items: Slice[GreenElement]) -> Slice[GreenElement]
  let named = declarationChildrenWithName(items, 0, "", [])
  let header = typeParameterChildren(named, 1, 0, greenElementSliceOrEmpty(named, 0, 1))
  let bodyStart = syntaxNextLineLeading(header, 1, header.Len())
  let endIndex = syntaxLastTokenIndex(header, header.Len() - 1)
  if bodyStart < 0 || endIndex < 0 then
    header
  else
    joinGreenElements(joinGreenElements(greenElementSliceOrEmpty(header, 0, bodyStart), syntaxFuncMembers(GreenNodeKind.FuncSignature, header, bodyStart, endIndex, [])), greenElementSliceOrEmpty(header, endIndex, header.Len()))
  end
end

func implDeclarationChildren(items: Slice[GreenElement]) -> Slice[GreenElement]
  let withParams = typeParameterChildren(items, 1, 0, greenElementSliceOrEmpty(items, 0, 1))
  let bodyStart = syntaxNextLineLeading(withParams, 1, withParams.Len())
  let endIndex = syntaxLastTokenIndex(withParams, withParams.Len() - 1)
  let headerEnd = if bodyStart < 0 then withParams.Len() else bodyStart end
  let header = implHeaderChildren(withParams, 2, headerEnd, false, greenElementSliceOrEmpty(withParams, 0, 2))
  if bodyStart < 0 || endIndex < 0 then
    header
  else
    joinGreenElements(joinGreenElements(header, syntaxFuncMembers(GreenNodeKind.ImplMethod, withParams, bodyStart, endIndex, [])), greenElementSliceOrEmpty(withParams, endIndex, withParams.Len()))
  end
end

# implHeaderChildren types the impl header: the target type and the optional
# `: Interface` clause.  Type parameters were already wrapped by the caller.
func implHeaderChildren(items: Slice[GreenElement], index: Int, finish: Int, target: Bool, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= finish then
    output
  else
    let item = greenElementAt(items, index)
    if greenElementIsTrivia(item) then
      implHeaderChildren(items, index + 1, finish, target, output.Append(item))
    elsif greenElementRaw(item) == ":" then
      let next = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: index + 1 })
      let parsed = parseType(next)
      switch parsed.Node
        case Some(node) => joinGreenElements(output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
          Kind: GreenNodeKind.TypeAnnotation,
          Span: ps.SourceSpan { Start: greenElementSpan(item).Start, End: node.value().Span.End },
          Children: joinGreenElements(greenElementSliceOrEmpty(items, index, next.Index), [GreenElement.NodeElement(node)]),
          HasError: node.value().HasError,
        }))), greenElementSliceOrEmpty(items, parsed.Cursor.Index, finish))
        case None => implHeaderChildren(items, index + 1, finish, target, output.Append(item))
      end
    elsif !target then
      let next = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: index })
      let parsed = parseType(next)
      switch parsed.Node
        case Some(node) => implHeaderChildren(items, parsed.Cursor.Index, finish, true, output.Append(GreenElement.NodeElement(node)))
        case None => implHeaderChildren(items, index + 1, finish, true, output.Append(item))
      end
    else
      implHeaderChildren(items, index + 1, finish, target, output.Append(item))
    end
  end
end

# syntaxFieldMembers splits a struct/enum body into one node per line-leading
# member, so each member owns its name, type, tag, and separators.
func syntaxFieldMembers(kind: GreenNodeKind, items: Slice[GreenElement], index: Int, finish: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= finish then
    output
  else
    let next = syntaxNextLineLeading(items, index + 1, finish)
    let endPos = if next < 0 then finish else next end
    syntaxFieldMembers(kind, items, endPos, finish, output.Append(syntaxMemberNode(kind, items, index, endPos)))
  end
end

func syntaxFuncMembers(kind: GreenNodeKind, items: Slice[GreenElement], index: Int, finish: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= finish then
    output
  else
    let next = syntaxNextFuncLine(items, index + 1, finish)
    let endPos = if next < 0 then finish else next end
    syntaxFuncMembers(kind, items, endPos, finish, output.Append(syntaxMemberNode(kind, items, index, endPos)))
  end
end

func syntaxMemberNode(kind: GreenNodeKind, items: Slice[GreenElement], start: Int, finish: Int) -> GreenElement
  switch items.Slice(start, finish)
    case Some(children) => GreenElement.NodeElement(Ref.new(GreenNode {
      Kind: kind,
      Span: greenElementSliceSpan(items, start, finish),
      Children: syntaxMemberChildren(kind, children),
      HasError: false,
    }))
    case None => greenElementAt(items, start)
  end
end

func syntaxMemberChildren(kind: GreenNodeKind, items: Slice[GreenElement]) -> Slice[GreenElement]
  if kind == GreenNodeKind.StructField then
    structFieldSemanticChildren(items, 0, false, [])
  elsif kind == GreenNodeKind.EnumVariant then
    enumVariantSemanticChildren(items, 0, false, [])
  elsif kind == GreenNodeKind.FuncSignature || kind == GreenNodeKind.ImplMethod then
    signatureSemanticChildren(items)
  else
    items
  end
end

# signatureSemanticChildren types a bare `func` signature (name, type
# parameters, using clause, result, parameters) without a body.  It is shared by
# interface members and impl members; any impl method body stays as raw leaves.
func signatureSemanticChildren(items: Slice[GreenElement]) -> Slice[GreenElement]
  let named = declarationChildrenWithName(items, 0, "", [])
  functionBodyChildren(functionParameterChildren(functionReturnChildren(functionUsingChildren(typeParameterChildren(named, 1, 0, greenElementSliceOrEmpty(named, 0, 1)), 0, []), 0, []), 0, false, []))
end

func structFieldSemanticChildren(items: Slice[GreenElement], index: Int, named: Bool, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    let item = greenElementAt(items, index)
    let raw = greenElementRaw(item)
    if greenElementIsTrivia(item) then
      structFieldSemanticChildren(items, index + 1, named, output.Append(item))
    elsif !named && raw == "embed" then
      let next = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: index + 1 })
      let parsed = parseType(next)
      switch parsed.Node
        case Some(node) => structFieldSemanticChildren(items, parsed.Cursor.Index, true, joinGreenElements(output.Append(item), joinGreenElements(greenElementSliceOrEmpty(items, index + 1, next.Index), [GreenElement.NodeElement(node)])))
        case None => structFieldSemanticChildren(items, index + 1, true, output.Append(item))
      end
    elsif !named && syntaxElementNameToken(item) then
      structFieldSemanticChildren(items, index + 1, true, output.Append(GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.IdentifierExpr, Span: greenElementSpan(item), Children: [item], HasError: false }))))
    elsif raw == ":" then
      let next = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: index + 1 })
      let parsed = parseType(next)
      switch parsed.Node
        case Some(node) => structFieldSemanticChildren(items, parsed.Cursor.Index, true, output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
          Kind: GreenNodeKind.TypeAnnotation,
          Span: ps.SourceSpan { Start: greenElementSpan(item).Start, End: node.value().Span.End },
          Children: joinGreenElements(greenElementSliceOrEmpty(items, index, next.Index), [GreenElement.NodeElement(node)]),
          HasError: node.value().HasError,
        }))))
        case None => structFieldSemanticChildren(items, index + 1, true, output.Append(item))
      end
    else
      structFieldSemanticChildren(items, index + 1, named, output.Append(item))
    end
  end
end

func enumVariantSemanticChildren(items: Slice[GreenElement], index: Int, named: Bool, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    let item = greenElementAt(items, index)
    if greenElementIsTrivia(item) then
      enumVariantSemanticChildren(items, index + 1, named, output.Append(item))
    elsif !named && syntaxElementNameToken(item) then
      enumVariantSemanticChildren(items, index + 1, true, output.Append(GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.IdentifierExpr, Span: greenElementSpan(item), Children: [item], HasError: false }))))
    elsif syntaxElementIsNodeKind(item, GreenNodeKind.ParenGroup) then
      enumVariantSemanticChildren(items, index + 1, true, output.Append(wrapGroupWithTypeItems(item, GreenNodeKind.ParenGroup, [])))
    elsif syntaxElementIsNodeKind(item, GreenNodeKind.BraceGroup) then
      switch greenElementNode(item)
        case Some(group) => enumVariantSemanticChildren(items, index + 1, true, output.Append(GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.BraceGroup, Span: group.value().Span, Children: namedVariantFieldChildren(group.value().Children, 0, false, []), HasError: group.value().HasError }))))
        case None => enumVariantSemanticChildren(items, index + 1, named, output.Append(item))
      end
    else
      enumVariantSemanticChildren(items, index + 1, named, output.Append(item))
    end
  end
end

func wrapGroupWithTypeItems(item: GreenElement, kind: GreenNodeKind, extra: Slice[GreenElement]) -> GreenElement
  switch greenElementNode(item)
    case Some(group) => GreenElement.NodeElement(Ref.new(GreenNode { Kind: kind, Span: group.value().Span, Children: parseTypeItems(group.value().Children, 0, []), HasError: group.value().HasError }))
    case None => item
  end
end

func namedVariantFieldChildren(items: Slice[GreenElement], index: Int, named: Bool, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    let item = greenElementAt(items, index)
    let raw = greenElementRaw(item)
    if greenElementIsTrivia(item) then
      namedVariantFieldChildren(items, index + 1, named, output.Append(item))
    elsif raw == "{" || raw == "}" || raw == "," then
      namedVariantFieldChildren(items, index + 1, false, output.Append(item))
    elsif !named && syntaxElementNameToken(item) then
      namedVariantFieldChildren(items, index + 1, true, output.Append(GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.IdentifierExpr, Span: greenElementSpan(item), Children: [item], HasError: false }))))
    elsif raw == ":" then
      let next = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: index + 1 })
      let parsed = parseType(next)
      switch parsed.Node
        case Some(node) => namedVariantFieldChildren(items, parsed.Cursor.Index, false, output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
          Kind: GreenNodeKind.TypeAnnotation,
          Span: ps.SourceSpan { Start: greenElementSpan(item).Start, End: node.value().Span.End },
          Children: joinGreenElements(greenElementSliceOrEmpty(items, index, next.Index), [GreenElement.NodeElement(node)]),
          HasError: node.value().HasError,
        }))))
        case None => namedVariantFieldChildren(items, index + 1, false, output.Append(item))
      end
    else
      namedVariantFieldChildren(items, index + 1, named, output.Append(item))
    end
  end
end

# functionUsingChildren groups a function's `using` clause into one Constraints
# node.  The clause runs from the `using` keyword up to the body boundary, so
# the pass stops at the first `=>`/`=` or an already-frozen ValueInitializer.
func functionUsingChildren(items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    switch items.Get(index)
      case Some(item) then
        if greenElementRaw(item) == "using" then
          let finish = functionUsingBoundary(items, index + 1)
          let constraints = constraintChildren(items, finish, index + 1, [], [])
          functionUsingChildren(items, finish, output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
            Kind: GreenNodeKind.Constraints,
            Span: ps.SourceSpan { Start: greenElementSpan(item).Start, End: constraintRangeEnd(items, index + 1, finish) },
            Children: joinGreenElements([item], constraints),
            HasError: false,
          }))))
        else
          functionUsingChildren(items, index + 1, output.Append(item))
        end
      end
      case None => output
    end
  end
end

func functionUsingBoundary(items: Slice[GreenElement], index: Int) -> Int
  if index >= items.Len() then
    items.Len()
  else
    switch items.Get(index)
      case Some(item) then
        # A `using` clause is a single comma-separated constraint list on one
        # logical line.  Stop at the body boundary markers and at the first
        # newline so the following block body is not swallowed as constraints.
        if greenElementRaw(item) == "=>" || greenElementRaw(item) == "=" || strings.Contains(greenElementRaw(item), "\n") then
          index
        else
          switch greenElementNode(item)
            case Some(node) => if node.value().Kind == GreenNodeKind.ValueInitializer then index else functionUsingBoundary(items, index + 1) end
            case None => functionUsingBoundary(items, index + 1)
          end
        end
      end
      case None => items.Len()
    end
  end
end

# constraintChildren splits the clause on top-level commas.  Commas inside a
# bracket group stay owned by that group, so only real separators split here.
func constraintChildren(items: Slice[GreenElement], finish: Int, index: Int, current: Slice[GreenElement], output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= finish then
    appendConstraintNode(current, output)
  else
    switch items.Get(index)
      case Some(item) then
        if greenElementRaw(item) == "," then
          constraintChildren(items, finish, index + 1, [], appendConstraintNode(current, output).Append(item))
        else
          constraintChildren(items, finish, index + 1, current.Append(item), output)
        end
      end
      case None => appendConstraintNode(current, output)
    end
  end
end

func appendConstraintNode(items: Slice[GreenElement], output: Slice[GreenElement]) -> Slice[GreenElement]
  if greenElementsHaveContent(items, 0) then
    output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
      Kind: GreenNodeKind.Constraint,
      Span: ps.SourceSpan { Start: constraintRangeStart(items, 0, items.Len()), End: constraintRangeEnd(items, 0, items.Len()) },
      Children: constraintSemanticChildren(items, 0, false, false, []),
      HasError: false,
    })))
  else
    output
  end
end

# A constraint is `Bind: Name` or `Name`, optionally followed by `[Args]`.  The
# bind name is frozen as a BindPattern so lowering reads it like a let binding.
func constraintSemanticChildren(items: Slice[GreenElement], index: Int, boundName: Bool, emittedName: Bool, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    switch items.Get(index)
      case Some(item) then
        switch greenElementNode(item)
          case Some(group) then
            if group.value().Kind == GreenNodeKind.BracketGroup then
              constraintSemanticChildren(items, index + 1, boundName, emittedName, output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
                Kind: GreenNodeKind.TypeArguments,
                Span: group.value().Span,
                Children: parseTypeItems(group.value().Children, 0, []),
                HasError: group.value().HasError,
              }))))
            else
              constraintSemanticChildren(items, index + 1, boundName, emittedName, output.Append(item))
            end
          end
          case None then
            if syntaxElementNameToken(item) && !emittedName && !boundName && greenElementsContainRaw(items, ":", 0) then
              constraintSemanticChildren(items, index + 1, true, false, output.Append(GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.BindPattern, Span: greenElementSpan(item), Children: [item], HasError: false }))))
            elsif syntaxElementNameToken(item) && !emittedName then
              constraintSemanticChildren(items, index + 1, boundName, true, output.Append(GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.IdentifierExpr, Span: greenElementSpan(item), Children: [item], HasError: false }))))
            else
              constraintSemanticChildren(items, index + 1, boundName, emittedName, output.Append(item))
            end
          end
        end
      end
      case None => output
    end
  end
end

func constraintRangeStart(items: Slice[GreenElement], start: Int, finish: Int) -> ps.Position
  if start >= finish then
    syntaxRootSpan([]).Start
  elsif greenElementIsTrivia(greenElementAt(items, start)) then
    constraintRangeStart(items, start + 1, finish)
  else
    greenElementSpan(greenElementAt(items, start)).Start
  end
end

func constraintRangeEnd(items: Slice[GreenElement], start: Int, finish: Int) -> ps.Position
  if finish <= start then
    syntaxRootSpan([]).End
  elsif greenElementIsTrivia(greenElementAt(items, finish - 1)) then
    constraintRangeEnd(items, start, finish - 1)
  else
    greenElementSpan(greenElementAt(items, finish - 1)).End
  end
end

func greenElementsHaveContent(items: Slice[GreenElement], index: Int) -> Bool
  if index >= items.Len() then
    false
  elsif greenElementIsTrivia(greenElementAt(items, index)) then
    greenElementsHaveContent(items, index + 1)
  else
    true
  end
end

func typeDeclarationChildren(items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then output else
    switch items.Get(index)
      case Some(item) then
        if greenElementRaw(item) == "=" then
          let next = SyntaxCursor { Elements: items, Index: index + 1 }
          let start = syntaxCursorSkipTrivia(next)
          let parsed = parseType(start)
          switch parsed.Node
            case Some(node) => typeDeclarationChildren(items, parsed.Cursor.Index, output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
              Kind: GreenNodeKind.TypeAnnotation,
              Span: ps.SourceSpan { Start: greenElementSpan(item).Start, End: node.value().Span.End },
              Children: joinGreenElements(greenElementSliceOrEmpty(items, index, start.Index), [GreenElement.NodeElement(node)]),
              HasError: node.value().HasError,
            }))))
            case None => typeDeclarationChildren(items, index + 1, output.Append(item))
          end
        elsif !greenElementIsTrivia(item) && greenElementRaw(item) != "type" && !syntaxElementIsNodeKind(item, GreenNodeKind.IdentifierExpr) then
          # Nominal form `type A B`: the right-hand side is a bare type with no
          # `=` marker, so wrap it in TypeAnnotation to keep one lowering shape.
          let start = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: index })
          let parsed = parseType(start)
          switch parsed.Node
            case Some(node) => joinGreenElements(output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
              Kind: GreenNodeKind.TypeAnnotation,
              Span: node.value().Span,
              Children: joinGreenElements(greenElementSliceOrEmpty(items, index, start.Index), [GreenElement.NodeElement(node)]),
              HasError: node.value().HasError,
            }))), greenElementSliceOrEmpty(items, parsed.Cursor.Index, items.Len()))
            case None => typeDeclarationChildren(items, index + 1, output.Append(item))
          end
        else
          typeDeclarationChildren(items, index + 1, output.Append(item))
        end
      end
      case None => output
    end
  end
end

# functionReturnChildren freezes the single `-> Ret` that belongs to a
# function signature.  The arrow must sit after the parameter group and before
# the body, so the scan starts wrapping only once the parameter ParenGroup has
# been passed: any other token after the parameters ends the signature and the
# remaining leaves are copied through unchanged.  Without that anchor a nested
# function literal's `->` further down the body would be wrapped instead, which
# then hides it from the func-literal signature pass.
func functionReturnChildren(items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  functionReturnChildrenAfter(items, index, output, false)
end

func functionReturnChildrenAfter(items: Slice[GreenElement], index: Int, output: Slice[GreenElement], seenParameters: Bool) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    let item = greenElementAt(items, index)
    if greenElementIsTrivia(item) then
      functionReturnChildrenAfter(items, index + 1, output.Append(item), seenParameters)
    else
      switch greenElementNode(item)
        case Some(node) then
          if node.value().Kind == GreenNodeKind.ParenGroup then
            functionReturnChildrenAfter(items, index + 1, output.Append(item), true)
          else
            functionReturnChildrenAfter(items, index + 1, output.Append(item), seenParameters)
          end
        end
        case None then
          let raw = greenElementRaw(item)
          if seenParameters && raw == "->" then
            let next = SyntaxCursor { Elements: items, Index: index + 1 }
            let start = syntaxCursorSkipTrivia(next)
            let parsed = parseType(start)
            switch parsed.Node
              case Some(node) => joinGreenElements(output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
                  Kind: GreenNodeKind.FunctionReturnType,
                  Span: ps.SourceSpan { Start: greenElementSpan(item).Start, End: node.value().Span.End },
                  Children: joinGreenElements(greenElementSliceOrEmpty(items, index, start.Index), [GreenElement.NodeElement(node)]),
                  HasError: node.value().HasError,
                }))), greenElementSliceOrEmpty(items, parsed.Cursor.Index, items.Len()))
              case None => functionReturnChildrenAfter(items, index + 1, output.Append(item), seenParameters)
            end
          elsif seenParameters then
            joinGreenElements(output, greenElementSliceOrEmpty(items, index, items.Len()))
          else
            functionReturnChildrenAfter(items, index + 1, output.Append(item), seenParameters)
          end
        end
      end
    end
  end
end

func functionParameterChildren(items: Slice[GreenElement], index: Int, wrapped: Bool, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    switch items.Get(index)
      case Some(item) then
        switch greenElementNode(item)
          case Some(group) then
            if !wrapped && group.value().Kind == GreenNodeKind.ParenGroup then
              let value = group.value()
              functionParameterChildren(items, index + 1, true, output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
                Kind: GreenNodeKind.FunctionParameters,
                Span: value.Span,
                Children: functionParameterItems(value.Children, 0, true, []),
                HasError: value.HasError,
              }))))
            else
              functionParameterChildren(items, index + 1, wrapped, output.Append(item))
            end
          end
          case None => functionParameterChildren(items, index + 1, wrapped, output.Append(item))
        end
      end
      case None => output
    end
  end
end

func functionParameterItems(items: Slice[GreenElement], index: Int, expectName: Bool, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    switch items.Get(index)
      case Some(item) then
        let raw = greenElementRaw(item)
        if greenElementIsTrivia(item) || raw == "(" || raw == ")" then
          functionParameterItems(items, index + 1, expectName, output.Append(item))
        elsif raw == "," then
          functionParameterItems(items, index + 1, true, output.Append(item))
        elsif expectName then
          let pattern = GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.BindPattern, Span: greenElementSpan(item), Children: [item], HasError: false }))
          functionParameterItems(items, index + 1, false, output.Append(pattern))
        elsif raw == ":" then
          let next = SyntaxCursor { Elements: items, Index: index + 1 }
          let start = syntaxCursorSkipTrivia(next)
          let parsed = parseType(start)
          switch parsed.Node
            case Some(node) => functionParameterItems(items, parsed.Cursor.Index, false, output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
              Kind: GreenNodeKind.TypeAnnotation,
              Span: ps.SourceSpan { Start: greenElementSpan(item).Start, End: node.value().Span.End },
              Children: joinGreenElements(greenElementSliceOrEmpty(items, index, start.Index), [GreenElement.NodeElement(node)]),
              HasError: node.value().HasError,
            }))))
            case None => functionParameterItems(items, index + 1, false, output.Append(item))
          end
        else
          functionParameterItems(items, index + 1, false, output.Append(item))
        end
      end
      case None => output
    end
  end
end

func declarationChildrenWithName(items: Slice[GreenElement], index: Int, keyword: String, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    switch items.Get(index)
      case Some(item) then
        let raw = greenElementRaw(item)
        if keyword == "" && greenElementStartsDeclarationRaw(raw) then
          declarationChildrenWithName(items, index + 1, raw, output.Append(item))
        elsif keyword != "" && !greenElementIsTrivia(item) then
          if keyword == "let" || keyword == "var" then
            let bound = declarationPatternItems(items, index)
            joinGreenElements(output.Append(bound.Element), greenElementSliceOrEmpty(items, bound.Next, items.Len()))
          else
            let named = GreenElement.NodeElement(Ref.new(GreenNode {
              Kind: GreenNodeKind.IdentifierExpr,
              Span: greenElementSpan(item),
              Children: [item],
              HasError: false,
            }))
            joinGreenElements(output.Append(named), greenElementSliceOrEmpty(items, index + 1, items.Len()))
          end
        else
          declarationChildrenWithName(items, index + 1, keyword, output.Append(item))
        end
      end
      case None => output
    end
  end
end

func declarationKind(raw: String) -> GreenNodeKind
  if raw == "package" then
    GreenNodeKind.PackageDeclaration
  elsif raw == "import" then
    GreenNodeKind.ImportDeclaration
  elsif raw == "let" then
    GreenNodeKind.LetDeclaration
  elsif raw == "var" then
    GreenNodeKind.VarDeclaration
  elsif raw == "func" then
    GreenNodeKind.FuncDeclaration
  elsif raw == "type" then
    GreenNodeKind.TypeDeclaration
  elsif raw == "struct" then
    GreenNodeKind.StructDeclaration
  elsif raw == "enum" then
    GreenNodeKind.EnumDeclaration
  elsif raw == "interface" then
    GreenNodeKind.InterfaceDeclaration
  elsif raw == "impl" then
    GreenNodeKind.ImplDeclaration
  else
    GreenNodeKind.Declaration
  end
end

func declarationChildrenWithExpr(items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    switch items.Get(index)
      case Some(item) then
        if greenElementRaw(item) == ":" then
          let next = SyntaxCursor { Elements: items, Index: index + 1 }
          let start = syntaxCursorSkipTrivia(next)
          let parsed = parseType(start)
          switch parsed.Node
            case Some(node) => declarationChildrenWithExpr(items, parsed.Cursor.Index, output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
              Kind: GreenNodeKind.TypeAnnotation,
              Span: ps.SourceSpan { Start: greenElementSpan(item).Start, End: node.value().Span.End },
              Children: joinGreenElements(greenElementSliceOrEmpty(items, index, start.Index), [GreenElement.NodeElement(node)]),
              HasError: node.value().HasError,
            }))))
            case None => declarationChildrenWithExpr(items, index + 1, output.Append(item))
          end
        elsif greenElementRaw(item) == "=" || greenElementRaw(item) == "=>" then
          let next = SyntaxCursor { Elements: items, Index: index + 1 }
          let start = syntaxCursorSkipTrivia(next)
          let parsed = parseExpr(start)
          switch parsed.Node
            case Some(node) => declarationChildrenWithExpr(items, parsed.Cursor.Index, output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
              Kind: GreenNodeKind.ValueInitializer,
              Span: ps.SourceSpan { Start: greenElementSpan(item).Start, End: node.value().Span.End },
              Children: joinGreenElements(greenElementSliceOrEmpty(items, index, start.Index), [GreenElement.NodeElement(node)]),
              HasError: node.value().HasError,
            }))))
            case None => declarationChildrenWithExpr(items, index + 1, output.Append(item))
          end
        else
          declarationChildrenWithExpr(items, index + 1, output.Append(item))
        end
      end
      case None => output
    end
  end
end

func parseBindingDeclaration(cursor: SyntaxCursor) -> SyntaxParseResult
  let afterKeyword = syntaxCursorAdvance(cursor)
  let afterPattern = parsePattern(afterKeyword)
  let afterType = if syntaxCursorRaw(afterPattern.Cursor) == ":" then
    parseType(syntaxCursorAdvance(afterPattern.Cursor))
  else
    afterPattern
  end

  if syntaxCursorRaw(afterType.Cursor) == "=" then
    parseExpr(syntaxCursorAdvance(afterType.Cursor))
  else
    afterType
  end
end

func parseFunctionDeclaration(cursor: SyntaxCursor) -> SyntaxParseResult
  let afterKeyword = syntaxCursorAdvance(cursor)
  let afterName = syntaxCursorAdvance(syntaxCursorSkipTrivia(afterKeyword))
  let afterParams = parsePattern(afterName)
  let afterReturn = if syntaxCursorRaw(afterParams.Cursor) == "->" then
    parseType(syntaxCursorAdvance(afterParams.Cursor))
  else
    afterParams
  end

  if syntaxCursorRaw(afterReturn.Cursor) == "=>" then
    parseExpr(syntaxCursorAdvance(afterReturn.Cursor))
  else
    afterReturn
  end
end

func parseExpr(cursor: SyntaxCursor) -> SyntaxParseResult
  parsePipeExpr(cursor)
end

# The expression grammar is a precedence-climbing layer above the atom parser.
# Every level is a left-associative chain whose right operand is the next
# tighter level, mirroring the legacy precedence:
#   pipe -> or -> and -> compare -> add -> mul -> unary -> postfix -> atomic.
# Operator nodes own the intervening trivia and the operator token so each
# source byte is still claimed exactly once inside a frozen green range.
func parsePipeExpr(cursor: SyntaxCursor) -> SyntaxParseResult
  parseBinaryLevel(cursor, func(inner: SyntaxCursor) -> SyntaxParseResult parseOrExpr(inner) end, ["|>", "<|"])
end

func parseOrExpr(cursor: SyntaxCursor) -> SyntaxParseResult
  parseBinaryLevel(cursor, func(inner: SyntaxCursor) -> SyntaxParseResult parseAndExpr(inner) end, ["||"])
end

func parseAndExpr(cursor: SyntaxCursor) -> SyntaxParseResult
  parseBinaryLevel(cursor, func(inner: SyntaxCursor) -> SyntaxParseResult parseCompareExpr(inner) end, ["&&"])
end

func parseCompareExpr(cursor: SyntaxCursor) -> SyntaxParseResult
  parseBinaryLevel(cursor, func(inner: SyntaxCursor) -> SyntaxParseResult parseAddExpr(inner) end, ["==", "!=", "<=", ">=", "<", ">"])
end

func parseAddExpr(cursor: SyntaxCursor) -> SyntaxParseResult
  parseBinaryLevel(cursor, func(inner: SyntaxCursor) -> SyntaxParseResult parseMulExpr(inner) end, ["+", "-"])
end

func parseMulExpr(cursor: SyntaxCursor) -> SyntaxParseResult
  parseBinaryLevel(cursor, func(inner: SyntaxCursor) -> SyntaxParseResult parseUnaryExpr(inner) end, ["*", "/"])
end

# parseBinaryLevel parses one left-associative precedence level.  The operand
# parser is the next tighter level, so the first node it returns starts at a
# non-trivia element; the index of that element anchors the combined range.
func parseBinaryLevel(cursor: SyntaxCursor, operand: func(SyntaxCursor) -> SyntaxParseResult, ops: Slice[String]) -> SyntaxParseResult
  let lead = syntaxCursorSkipTrivia(cursor)
  let left = operand(lead)
  switch left.Node
    case None => left
    case Some(_) => parseBinaryTail(lead.Index, left, operand, ops)
  end
end

func parseBinaryTail(startIndex: Int, left: SyntaxParseResult, operand: func(SyntaxCursor) -> SyntaxParseResult, ops: Slice[String]) -> SyntaxParseResult
  let opCursor = syntaxCursorSkipTrivia(left.Cursor)
  let raw = syntaxCursorRaw(opCursor)
  if !syntaxRawInSlice(ops, raw) then
    left
  else
    let rightStart = syntaxCursorSkipTrivia(syntaxCursorAdvance(opCursor))
    let right = operand(rightStart)
    switch (left.Node, right.Node)
      case (Some(leftNode), Some(rightNode)) then
        parseBinaryTail(
          startIndex,
          syntaxBinaryResult(
            startIndex,
            left,
            leftNode,
            opCursor,
            rightStart,
            rightNode,
            right.Cursor
          ),
          operand,
          ops,
        )
      end
      case _ => left
    end
  end
end

func syntaxBinaryResult(startIndex: Int, left: SyntaxParseResult, leftNode: Ref[GreenNode], opCursor: SyntaxCursor, rightStart: SyntaxCursor, rightNode: Ref[GreenNode], rightEnd: SyntaxCursor) -> SyntaxParseResult
  SyntaxParseResult {
    Node: Some(Ref.new(GreenNode {
      Kind: GreenNodeKind.BinaryExpr,
      Span: ps.SourceSpan { Start: leftNode.value().Span.Start, End: rightNode.value().Span.End },
      Children: joinGreenElements(
        joinGreenElements(
          [GreenElement.NodeElement(leftNode)],
          greenElementSliceOrEmpty(opCursor.Elements, left.Cursor.Index, opCursor.Index)
        ),
        joinGreenElements(
          [greenElementAt(opCursor.Elements, opCursor.Index)],
          joinGreenElements(
            greenElementSliceOrEmpty(opCursor.Elements, opCursor.Index + 1, rightStart.Index),
            [GreenElement.NodeElement(rightNode)]
          )
        )
      ),
      HasError: leftNode.value().HasError || rightNode.value().HasError,
    })),
    Cursor: rightEnd,
  }
end

func syntaxRawInSlice(items: Slice[String], raw: String) -> Bool
  if items.Len() == 0 then
    false
  else
    switch items.Get(0)
      case Some(candidate) => if candidate == raw then true else syntaxRawInSlice(syntaxRawTail(items), raw) end
      case None => false
    end
  end
end

func syntaxRawTail(items: Slice[String]) -> Slice[String]
  switch items.Slice(1, items.Len())
    case Some(tail) => tail
    case None => []
  end
end

# parseUnaryExpr owns a leading not/negate operator.  The operator token, its
# trailing trivia, and the recursive operand are one green range so lowering
# reads the operand and the operator text without touching the source string.
func parseUnaryExpr(cursor: SyntaxCursor) -> SyntaxParseResult
  let start = syntaxCursorSkipTrivia(cursor)
  let raw = syntaxCursorRaw(start)
  if raw != "!" && raw != "-" then
    parsePostfixExpr(start)
  else
    let operandStart = syntaxCursorSkipTrivia(syntaxCursorAdvance(start))
    let operand = parseUnaryExpr(operandStart)
    switch operand.Node
      case Some(operandNode) => SyntaxParseResult {
        Node: Some(Ref.new(GreenNode {
          Kind: GreenNodeKind.UnaryExpr,
          Span: ps.SourceSpan { Start: greenElementSpan(greenElementAt(start.Elements, start.Index)).Start, End: operandNode.value().Span.End },
          Children: joinGreenElements(
            greenElementSliceOrEmpty(start.Elements, start.Index, operandStart.Index),
            [GreenElement.NodeElement(operandNode)]
          ),
          HasError: operandNode.value().HasError,
        })),
        Cursor: operand.Cursor,
      }
      case None => SyntaxParseResult { Node: None, Cursor: cursor }
    end
  end
end

# parsePostfixExpr parses one atomic expression followed by a chain of casts,
# calls (with optional type-argument brackets), and field selections.
func parsePostfixExpr(cursor: SyntaxCursor) -> SyntaxParseResult
  let start = syntaxCursorSkipTrivia(cursor)
  let base = parsePrimarySyntax(start)
  switch base.Node
    case None => base
    case Some(_) => parsePostfixTail(start.Index, base)
  end
end

func parsePrimarySyntax(cursor: SyntaxCursor) -> SyntaxParseResult
  if syntaxCursorRaw(cursor) == "go" then
    parseInlineGoExpr(cursor)
  elsif syntaxCursorRaw(cursor) == "func" then
    parseFuncLitExpr(cursor)
  else
    parseGroupedSyntax(GreenNodeKind.Expression, cursor)
  end
end

func parsePostfixTail(startIndex: Int, acc: SyntaxParseResult) -> SyntaxParseResult
  let cur = syntaxCursorSkipTrivia(acc.Cursor)
  if syntaxCursorNodeKind(cur, GreenNodeKind.BraceGroup) then
    parsePostfixStructLiteral(startIndex, acc, cur, None, cur.Index)
  elsif syntaxCursorNodeKind(cur, GreenNodeKind.BracketGroup) then
    parsePostfixBracketSuffix(startIndex, acc, cur)
  else
    let raw = syntaxCursorRaw(cur)
    if raw == "as" then
      parsePostfixCast(startIndex, acc, cur)
    elsif raw == "." then
      parsePostfixField(startIndex, acc, cur)
    else
      parsePostfixCall(startIndex, acc, cur)
    end
  end
end

# syntaxCursorNodeKind reports whether the cursor's next non-trivia element is a
# nested green node of the given kind.
func syntaxCursorNodeKind(cursor: SyntaxCursor, kind: GreenNodeKind) -> Bool
  switch syntaxNodeElementAt(cursor, kind)
    case Some(_) => true
    case None => false
  end
end

func parsePostfixCast(startIndex: Int, acc: SyntaxParseResult, castCursor: SyntaxCursor) -> SyntaxParseResult
  let typeStart = syntaxCursorSkipTrivia(syntaxCursorAdvance(castCursor))
  let parsedType = parseType(typeStart)
  switch (acc.Node, parsedType.Node)
    case (Some(accNode), Some(typeNode)) then
      parsePostfixTail(startIndex, SyntaxParseResult {
        Node: Some(Ref.new(GreenNode {
          Kind: GreenNodeKind.TypeAsExpr,
          Span: ps.SourceSpan { Start: accNode.value().Span.Start, End: typeNode.value().Span.End },
          Children: joinGreenElements(
            joinGreenElements(
              [GreenElement.NodeElement(accNode)],
              greenElementSliceOrEmpty(castCursor.Elements, acc.Cursor.Index, castCursor.Index + 1)
            ),
            joinGreenElements(
              greenElementSliceOrEmpty(castCursor.Elements, castCursor.Index + 1, typeStart.Index),
              [GreenElement.NodeElement(typeNode)]
            )
          ),
          HasError: accNode.value().HasError || typeNode.value().HasError,
        })),
        Cursor: parsedType.Cursor,
      })
    end
    case _ => acc
  end
end

func parsePostfixField(startIndex: Int, acc: SyntaxParseResult, dotCursor: SyntaxCursor) -> SyntaxParseResult
  let nameStart = syntaxCursorSkipTrivia(syntaxCursorAdvance(dotCursor))
  let nameItem = greenElementAt(nameStart.Elements, nameStart.Index)
  switch acc.Node
    case Some(accNode) then
      if !syntaxElementNameToken(nameItem) then
        acc
      else
        parsePostfixTail(startIndex, SyntaxParseResult {
          Node: Some(Ref.new(GreenNode {
            Kind: GreenNodeKind.FieldExpr,
            Span: ps.SourceSpan { Start: accNode.value().Span.Start, End: greenElementSpan(nameItem).End },
            Children: joinGreenElements(
              [GreenElement.NodeElement(accNode)],
              greenElementSliceOrEmpty(dotCursor.Elements, acc.Cursor.Index, nameStart.Index + 1)
            ),
            HasError: accNode.value().HasError,
          })),
          Cursor: syntaxCursorAdvance(nameStart),
        })
      end
    end
    case None => acc
  end
end

func parsePostfixCall(startIndex: Int, acc: SyntaxParseResult, cur: SyntaxCursor) -> SyntaxParseResult
  switch syntaxNodeElementAt(cur, GreenNodeKind.BracketGroup)
    case Some(bracketEl) => parsePostfixGenericCall(startIndex, acc, cur, bracketEl)
    case None => parsePostfixPlainCall(startIndex, acc, cur)
  end
end

func parsePostfixPlainCall(startIndex: Int, acc: SyntaxParseResult, cur: SyntaxCursor) -> SyntaxParseResult
  switch syntaxNodeElementAt(cur, GreenNodeKind.ParenGroup)
    case Some(parenEl) then
      if !syntaxSameLineSuffix(cur) then
        acc
      else
        parsePostfixTail(startIndex, syntaxCallResult(acc, cur, parenEl, None, cur.Index))
      end
    end
    case None => acc
  end
end

# parsePostfixBracketSuffix owns a `[...]` after an expression.  It becomes the
# type-argument slot of a generic call when a paren group follows, or the type
# arguments of a struct literal when a brace group follows.
func parsePostfixBracketSuffix(startIndex: Int, acc: SyntaxParseResult, cur: SyntaxCursor) -> SyntaxParseResult
  switch syntaxNodeElementAt(cur, GreenNodeKind.BracketGroup)
    case Some(bracketEl) then
      let afterBracket = syntaxCursorSkipTrivia(syntaxCursorAdvance(cur))
      switch syntaxNodeElementAt(afterBracket, GreenNodeKind.ParenGroup)
        case Some(parenEl) then
          if !syntaxSameLineSuffix(cur) then
            acc
          else
            parsePostfixTail(startIndex, syntaxCallResult(acc, afterBracket, parenEl, Some(bracketEl), cur.Index))
          end
        end
        case None then
          if syntaxCursorNodeKind(afterBracket, GreenNodeKind.BraceGroup) then
            parsePostfixStructLiteral(startIndex, acc, afterBracket, Some(bracketEl), cur.Index)
          else
            acc
          end
        end
      end
    end
    case None => acc
  end
end

# parsePostfixStructLiteral freezes `TypeName { field: value, ... }` (optionally
# with `[TypeArgs]`) into a StructLiteral whose brace group owns one
# StructLitField per `field: expr` pair.  The type name is the accumulated
# leading expression; its raw text is read from the retained tokens, not the
# source string.
func parsePostfixStructLiteral(startIndex: Int, acc: SyntaxParseResult, braceCursor: SyntaxCursor, typeArgs: Option[GreenElement], typeArgIndex: Int) -> SyntaxParseResult
  switch (acc.Node, syntaxNodeElementAt(braceCursor, GreenNodeKind.BraceGroup))
    case (Some(accNode), Some(braceEl)) then
      parsePostfixStructLiteralBody(acc, accNode, braceCursor, braceEl, typeArgs, typeArgIndex)
    end
    case _ => acc
  end
end

func parsePostfixStructLiteralBody(acc: SyntaxParseResult, accNode: Ref[GreenNode], braceCursor: SyntaxCursor, braceEl: GreenElement, typeArgs: Option[GreenElement], typeArgIndex: Int) -> SyntaxParseResult
  if syntaxStructLitHeadName(accNode.value()) == "" then
    acc
  else
    parsePostfixStructLiteralFreeze(acc, accNode, braceCursor, braceEl, typeArgs, typeArgIndex)
  end
end

func parsePostfixStructLiteralFreeze(acc: SyntaxParseResult, accNode: Ref[GreenNode], braceCursor: SyntaxCursor, braceEl: GreenElement, typeArgs: Option[GreenElement], typeArgIndex: Int) -> SyntaxParseResult
  switch greenElementNode(braceEl)
    case Some(braceRef) => parsePostfixStructLiteralNode(acc, accNode, braceCursor, braceRef.value(), typeArgs, typeArgIndex)
    case None => acc
  end
end

func parsePostfixStructLiteralNode(acc: SyntaxParseResult, accNode: Ref[GreenNode], braceCursor: SyntaxCursor, brace: GreenNode, typeArgs: Option[GreenElement], typeArgIndex: Int) -> SyntaxParseResult
  SyntaxParseResult {
    Node: Some(Ref.new(GreenNode {
      Kind: GreenNodeKind.StructLiteral,
      Span: ps.SourceSpan { Start: accNode.value().Span.Start, End: brace.Span.End },
      Children: syntaxStructLiteralChildren(acc, accNode, braceCursor, structLitBodyElement(brace), typeArgs, typeArgIndex),
      HasError: accNode.value().HasError || brace.HasError,
    })),
    Cursor: syntaxCursorAdvance(braceCursor),
  }
end

func structLitBodyElement(brace: GreenNode) -> GreenElement
  GreenElement.NodeElement(Ref.new(GreenNode {
    Kind: GreenNodeKind.BraceGroup,
    Span: brace.Span,
    Children: parseStructLitFieldItems(brace.Children, 0, []),
    HasError: brace.HasError,
  }))
end

# syntaxStructLitHeadName reconstructs the qualified type name of a struct
# literal head.  A plain identifier or a dotted identifier chain yields its
# source text; any other expression shape yields "" so the brace group is not
# mistaken for a struct literal.
func syntaxStructLitHeadName(node: GreenNode) -> String
  if node.Kind == GreenNodeKind.IdentifierExpr then
    greenNodeText(node)
  elsif node.Kind == GreenNodeKind.FieldExpr then
    switch greenNodeFindExpression(node, 0)
      case Some(receiver) then
        let base = syntaxStructLitHeadName(receiver.value())
        if base == "" => "" else base + "." + syntaxFieldName(node)
      end
      case None => ""
    end
  else
    ""
  end
end

func syntaxStructLiteralChildren(acc: SyntaxParseResult, accNode: Ref[GreenNode], braceCursor: SyntaxCursor, body: GreenElement, typeArgs: Option[GreenElement], typeArgIndex: Int) -> Slice[GreenElement]
  switch typeArgs
    case Some(bracketEl) then
      joinGreenElements(
        joinGreenElements(
          [GreenElement.NodeElement(accNode)],
          greenElementSliceOrEmpty(braceCursor.Elements, acc.Cursor.Index, typeArgIndex)
        ),
        joinGreenElements(
          [syntaxTypeArgumentsElement(bracketEl)],
          joinGreenElements(
            greenElementSliceOrEmpty(braceCursor.Elements, typeArgIndex + 1, braceCursor.Index),
            [body]
          )
        )
      )
    end
    case None then
      joinGreenElements(
        [GreenElement.NodeElement(accNode)],
        joinGreenElements(greenElementSliceOrEmpty(braceCursor.Elements, acc.Cursor.Index, braceCursor.Index), [body])
      )
    end
  end
end

# parseStructLitFieldItems groups the flat leaves of a struct-literal body into
# StructLitField nodes: `field: expr`.  Every `{`, `}`, `,`, and trivia leaf
# stays owned between the field nodes so no source byte is dropped.
func parseStructLitFieldItems(items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    let item = greenElementAt(items, index)
    let raw = greenElementRaw(item)
    if greenElementIsTrivia(item) || raw == "{" || raw == "}" || raw == "," then
      parseStructLitFieldItems(items, index + 1, output.Append(item))
    elsif syntaxElementNameToken(item) then
      let colon = syntaxNextTokenIndex(items, index + 1)
      if colon >= 0 && greenElementRaw(greenElementAt(items, colon)) == ":" then
        let valueStart = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: colon + 1 })
        let parsed = parseExpr(valueStart)
        switch parsed.Node
          case Some(valueNode) => parseStructLitFieldItems(items, parsed.Cursor.Index, output.Append(syntaxStructLitFieldElement(greenElementSliceOrEmpty(items, index, valueStart.Index), valueNode)))
          case None => parseStructLitFieldItems(items, index + 1, output.Append(item))
        end
      else
        parseStructLitFieldItems(items, index + 1, output.Append(item))
      end
    else
      parseStructLitFieldItems(items, index + 1, output.Append(item))
    end
  end
end

func syntaxStructLitFieldElement(prefix: Slice[GreenElement], value: Ref[GreenNode]) -> GreenElement
  GreenElement.NodeElement(Ref.new(GreenNode {
    Kind: GreenNodeKind.StructLitField,
    Span: ps.SourceSpan { Start: greenElementSliceSpan(prefix, 0, prefix.Len()).Start, End: value.value().Span.End },
    Children: joinGreenElements(prefix, [GreenElement.NodeElement(value)]),
    HasError: value.value().HasError,
  }))
end

func parsePostfixGenericCall(startIndex: Int, acc: SyntaxParseResult, cur: SyntaxCursor, bracketEl: GreenElement) -> SyntaxParseResult
  let afterBracket = syntaxCursorSkipTrivia(syntaxCursorAdvance(cur))
  switch syntaxNodeElementAt(afterBracket, GreenNodeKind.ParenGroup)
    case Some(parenEl) then
      if !syntaxSameLineSuffix(cur) then
        acc
      else
        parsePostfixTail(startIndex, syntaxCallResult(acc, afterBracket, parenEl, Some(bracketEl), cur.Index))
      end
    end
    case None => acc
  end
end

# syntaxCallResult freezes a call node.  The callee is the accumulated
# expression; the argument group is re-parsed so its items are typed children
# rather than raw leaves.  Optional type arguments come from the bracket group.
func syntaxCallResult(acc: SyntaxParseResult, parenCursor: SyntaxCursor, parenEl: GreenElement, typeArgs: Option[GreenElement], typeArgIndex: Int) -> SyntaxParseResult
  switch (acc.Node, greenElementNode(parenEl))
    case (Some(accNode), Some(parenRef)) then
      let paren = parenRef.value()
      let argsNode = GreenElement.NodeElement(Ref.new(GreenNode {
        Kind: GreenNodeKind.ParenGroup,
        Span: paren.Span,
        Children: parseGroupItems(GreenNodeKind.Expression, paren.Children, 0, []),
        HasError: paren.HasError,
      }))
      SyntaxParseResult {
        Node: Some(Ref.new(GreenNode {
          Kind: GreenNodeKind.Call,
          Span: ps.SourceSpan { Start: accNode.value().Span.Start, End: paren.Span.End },
          Children: syntaxCallChildren(acc, accNode, parenCursor, argsNode, typeArgs, typeArgIndex),
          HasError: accNode.value().HasError || paren.HasError,
        })),
        Cursor: syntaxCursorAdvance(parenCursor),
      }
    end
    case _ => acc
  end
end

func syntaxCallChildren(acc: SyntaxParseResult, accNode: Ref[GreenNode], parenCursor: SyntaxCursor, argsNode: GreenElement, typeArgs: Option[GreenElement], typeArgIndex: Int) -> Slice[GreenElement]
  switch typeArgs
    case Some(bracketEl) then
      joinGreenElements(
        joinGreenElements(
          [GreenElement.NodeElement(accNode)],
          greenElementSliceOrEmpty(parenCursor.Elements, acc.Cursor.Index, typeArgIndex)
        ),
        joinGreenElements(
          [syntaxTypeArgumentsElement(bracketEl)],
          joinGreenElements(
            greenElementSliceOrEmpty(parenCursor.Elements, typeArgIndex + 1, parenCursor.Index),
            [argsNode]
          )
        )
      )
    end
    case None then
      joinGreenElements(
        [GreenElement.NodeElement(accNode)],
        joinGreenElements(greenElementSliceOrEmpty(parenCursor.Elements, acc.Cursor.Index, parenCursor.Index), [argsNode])
      )
    end
  end
end

func syntaxTypeArgumentsElement(bracketEl: GreenElement) -> GreenElement
  switch greenElementNode(bracketEl)
    case Some(bracket) then
      GreenElement.NodeElement(Ref.new(GreenNode {
        Kind: GreenNodeKind.TypeArguments,
        Span: bracket.value().Span,
        Children: parseTypeItems(bracket.value().Children, 0, []),
        HasError: bracket.value().HasError,
      }))
    end
    case None => bracketEl
  end
end

func syntaxNodeElementAt(cursor: SyntaxCursor, kind: GreenNodeKind) -> Option[GreenElement]
  switch cursor.Elements.Get(cursor.Index)
    case Some(item) then
      switch greenElementNode(item)
        case Some(node) => if node.value().Kind == kind => Some(item) else None
        case None => None
      end
    end
    case None => None
  end
end

# syntaxSameLineSuffix mirrors the legacy rule that a call suffix must begin on
# the same source line as the expression it applies to.  Scanning backward from
# the suffix over trivia finds a newline exactly when the previous element ended
# on an earlier line.
func syntaxSameLineSuffix(cursor: SyntaxCursor) -> Bool
  syntaxSameLineScan(cursor.Elements, cursor.Index - 1)
end

func syntaxSameLineScan(items: Slice[GreenElement], index: Int) -> Bool
  if index < 0 then
    true
  else
    let item = greenElementAt(items, index)
    if greenElementIsTrivia(item) then
      if strings.Contains(greenElementRaw(item), "\n") then
        false
      else
        syntaxSameLineScan(items, index - 1)
      end
    else
      true
    end
  end
end


# parseFuncLitExpr builds the CST for `func (params) (-> ret)? body end`.  The
# leading `func` token is the keyword parsePrimarySyntax saw, so this entry
# point owns the parameter group, the optional return type, the body region,
# and the closing `end`.  The body is wrapped in a Block node so it lowers
# through the same statement path as a function body.
func parseFuncLitExpr(start: SyntaxCursor) -> SyntaxParseResult
  let keyword = greenElementAt(start.Elements, start.Index)
  let afterKeyword = syntaxCursorSkipTrivia(syntaxCursorAdvance(start))
  switch syntaxCursorPeek(afterKeyword)
    case Some(item) then
      switch greenElementNode(item)
        case Some(group) then
          if group.value().Kind == GreenNodeKind.ParenGroup then
            parseFuncLitBody(start, keyword, afterKeyword, group.value())
          else
            SyntaxParseResult { Node: None, Cursor: start }
          end
        end
        case None => SyntaxParseResult { Node: None, Cursor: start }
      end
    end
    case None => SyntaxParseResult { Node: None, Cursor: start }
  end
end

func parseFuncLitBody(start: SyntaxCursor, keyword: GreenElement, paramsCursor: SyntaxCursor, params: GreenNode) -> SyntaxParseResult
  let afterParams = syntaxCursorSkipTrivia(syntaxCursorAdvance(paramsCursor))
  let paramsNode = GreenElement.NodeElement(Ref.new(GreenNode {
    Kind: GreenNodeKind.FunctionParameters,
    Span: params.Span,
    Children: functionParameterItems(params.Children, 0, true, []),
    HasError: params.HasError,
  }))
  let items = start.Elements
  let signature = funcLitSignature(items, paramsCursor, afterParams)
  let bodyStart = signature.BodyStart
  let endIndex = funcLitBodyEnd(items, bodyStart, 0)
  if endIndex < 0 then
    SyntaxParseResult { Node: None, Cursor: start }
  else
    SyntaxParseResult {
      Node: Some(Ref.new(GreenNode {
        Kind: GreenNodeKind.FuncLitExpr,
        Span: ps.SourceSpan { Start: greenElementSpan(keyword).Start, End: greenElementSpan(greenElementAt(items, endIndex)).End },
        Children: funcLitChildren(items, start.Index, paramsCursor.Index, paramsNode, signature, endIndex),
        HasError: false,
      })),
      Cursor: syntaxCursorAdvance(SyntaxCursor { Elements: items, Index: endIndex }),
    }
  end
end

# funcLitSignature classifies the optional `-> ret` between the parameter group
# and the body.  It returns the body-start index, the gap slice that follows the
# parameter group, and the return-type node when an arrow form is present.
func funcLitSignature(items: Slice[GreenElement], paramsCursor: SyntaxCursor, afterParams: SyntaxCursor) -> FuncLitSignature
  let gap = greenElementSliceOrEmpty(items, paramsCursor.Index + 1, afterParams.Index)
  if syntaxCursorRaw(afterParams) != "->" then
    FuncLitSignature { BodyStart: afterParams.Index, Return: None, Gap: gap }
  else
    let typeStart = syntaxCursorSkipTrivia(syntaxCursorAdvance(afterParams))
    let parsed = parseType(typeStart)
    switch parsed.Node
      case Some(node) then
        FuncLitSignature {
          BodyStart: parsed.Cursor.Index,
          Gap: gap,
          Return: Some(GreenElement.NodeElement(Ref.new(GreenNode {
            Kind: GreenNodeKind.FunctionReturnType,
            Span: ps.SourceSpan { Start: greenElementSpan(greenElementAt(items, afterParams.Index)).Start, End: node.value().Span.End },
            Children: joinGreenElements(greenElementSliceOrEmpty(items, afterParams.Index, typeStart.Index), [GreenElement.NodeElement(node)]),
            HasError: node.value().HasError,
          }))),
        }
      end
      case None => FuncLitSignature { BodyStart: afterParams.Index, Return: None, Gap: gap }
    end
  end
end

func funcLitChildren(items: Slice[GreenElement], keywordIndex: Int, paramsIndex: Int, paramsNode: GreenElement, signature: FuncLitSignature, endIndex: Int) -> Slice[GreenElement]
  let lead = joinGreenElements(
    [GreenElement.TokenElement(greenTokenOf(greenElementAt(items, keywordIndex)))],
    greenElementSliceOrEmpty(items, keywordIndex + 1, paramsIndex)
  )
  switch signature.Return
    case Some(returnNode) then
      joinGreenElements(
        joinGreenElements(
          joinGreenElements(lead, [paramsNode]),
          joinGreenElements(signature.Gap, [returnNode])
        ),
        joinGreenElements(
          [funcLitBodyElement(items, signature.BodyStart, endIndex)],
          greenElementSliceOrEmpty(items, endIndex, endIndex + 1)
        )
      )
    end
    case None then
      joinGreenElements(
        joinGreenElements(
          joinGreenElements(lead, [paramsNode]),
          signature.Gap
        ),
        joinGreenElements(
          [funcLitBodyElement(items, signature.BodyStart, endIndex)],
          greenElementSliceOrEmpty(items, endIndex, endIndex + 1)
        )
      )
    end
  end
end

# funcLitBodyElement wraps the body region in one Block node so it lowers as a
# statement block, matching the legacy `blockUntil end` result.
func funcLitBodyElement(items: Slice[GreenElement], start: Int, finish: Int) -> GreenElement
  GreenElement.NodeElement(Ref.new(GreenNode {
    Kind: GreenNodeKind.Block,
    Span: greenElementSliceSpan(items, start, finish),
    Children: functionBodyStatements(greenElementSliceOrEmpty(items, start, finish)),
    HasError: false,
  }))
end

# funcLitBodyEnd finds the `end` that closes the func literal whose body starts
# at index.  A nested `func` literal or `letrec` opens a further block; every
# other keyword block (`if`/`switch`/`while`/`case`) is already a nested node in
# the delimited build, so its `end` is owned by that node and never seen here.
func funcLitBodyEnd(items: Slice[GreenElement], index: Int, depth: Int) -> Int
  if index >= items.Len() then
    -1
  else
    let raw = greenElementRaw(greenElementAt(items, index))
    if raw == "end" then
      if depth == 0 then index else funcLitBodyEnd(items, index + 1, depth - 1) end
    elsif raw == "func" && !syntaxFuncIsType(items, index) && syntaxFuncOpensBlock(items, index) then
      funcLitBodyEnd(items, index + 1, depth + 1)
    elsif raw == "letrec" then
      funcLitBodyEnd(items, index + 1, depth + 1)
    else
      funcLitBodyEnd(items, index + 1, depth)
    end
  end
end

# parseInlineGoExpr builds the CST for `go[Type] { code: ... }`.  The leading
# `go` token is the identifier that parseExpr saw, so this entry point only
# owns the bracket group, brace body, and their trivia.  The bracket group keeps
# the type argument as a nested type node; the brace body groups `code:` and the
# `in`/`type` bindings into typed children so lowering never re-parses source.
func parseInlineGoExpr(start: SyntaxCursor) -> SyntaxParseResult
  let keyword = greenElementAt(start.Elements, start.Index)
  let afterKeyword = syntaxCursorSkipTrivia(syntaxCursorAdvance(start))
  switch syntaxCursorPeek(afterKeyword)
    case Some(item) then
      switch greenElementNode(item)
        case Some(brackets) then
          if brackets.value().Kind == GreenNodeKind.BracketGroup then
            let afterBrackets = syntaxCursorSkipTrivia(syntaxCursorAdvance(afterKeyword))
            switch syntaxCursorPeek(afterBrackets)
              case Some(bodyItem) then
                switch greenElementNode(bodyItem)
                  case Some(body) then
                    if body.value().Kind == GreenNodeKind.BraceGroup then
                      parseInlineGoBodyNode(start, keyword, afterKeyword, brackets.value(), afterBrackets, body.value())
                    else
                      SyntaxParseResult { Node: None, Cursor: start }
                    end
                  end
                  case None => SyntaxParseResult { Node: None, Cursor: start }
                end
              end
              case None => SyntaxParseResult { Node: None, Cursor: start }
            end
          else
            SyntaxParseResult { Node: None, Cursor: start }
          end
        end
        case None => SyntaxParseResult { Node: None, Cursor: start }
      end
    end
    case None => SyntaxParseResult { Node: None, Cursor: start }
  end
end

func parseInlineGoBodyNode(start: SyntaxCursor, keyword: GreenElement, afterKeyword: SyntaxCursor, brackets: GreenNode, afterBrackets: SyntaxCursor, body: GreenNode) -> SyntaxParseResult
  let bodyChildren = parseInlineGoBodyItems(body.Children, 0, [])
  SyntaxParseResult {
    Node: Some(Ref.new(GreenNode {
      Kind: GreenNodeKind.InlineGoExpr,
      Span: ps.SourceSpan { Start: greenElementSpan(keyword).Start, End: body.Span.End },
      Children: joinGreenElements(
        joinGreenElements(
          [GreenElement.TokenElement(greenTokenOf(keyword))],
          greenElementSliceOrEmpty(start.Elements, start.Index + 1, afterKeyword.Index)
        ),
        joinGreenElements(
          joinGreenElements(
            [GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.BracketGroup, Span: brackets.Span, Children: parseTypeItems(brackets.Children, 0, []), HasError: brackets.HasError }))],
            greenElementSliceOrEmpty(start.Elements, afterKeyword.Index + 1, afterBrackets.Index)
          ),
          [GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.BraceGroup, Span: body.Span, Children: bodyChildren, HasError: body.HasError }))]
        )
      ),
      HasError: false,
    })),
    Cursor: syntaxCursorAdvance(afterBrackets),
  }
end

# parseInlineGoBodyItems groups the flat leaves of a `{ code: ... in x = e ... }`
# body.  `code:` becomes an InlineGoCode node holding the literal; each `in` or
# `type` binding becomes a typed binding node whose value/type children are
# parsed from the same leaf range.
func parseInlineGoBodyItems(items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    let item = greenElementAt(items, index)
    let raw = greenElementRaw(item)
    if raw == "code" then
      parseInlineGoCodeItem(items, index, output)
    elsif raw == "in" || raw == "type" then
      parseInlineGoBindingItem(items, index, output)
    else
      parseInlineGoBodyItems(items, index + 1, output.Append(item))
    end
  end
end

func parseInlineGoCodeItem(items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  let colon = syntaxNextTokenIndex(items, index + 1)
  if colon < 0 || greenElementRaw(greenElementAt(items, colon)) != ":" then
    parseInlineGoBodyItems(items, index + 1, output.Append(greenElementAt(items, index)))
  else
    let literal = syntaxNextTokenIndex(items, colon + 1)
    if literal < 0 || !greenElementIsStringLiteral(greenElementAt(items, literal)) then
      parseInlineGoBodyItems(items, index + 1, output.Append(greenElementAt(items, index)))
    else
      let children = greenElementSliceOrEmpty(items, index, literal + 1)
      parseInlineGoBodyItems(items, literal + 1, output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
        Kind: GreenNodeKind.InlineGoCode,
        Span: greenElementSliceSpan(children, 0, children.Len()),
        Children: children,
        HasError: false,
      }))))
    end
  end
end

func parseInlineGoBindingItem(items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  let name = syntaxNextTokenIndex(items, index + 1)
  if name < 0 || !syntaxElementNameToken(greenElementAt(items, name)) then
    parseInlineGoBodyItems(items, index + 1, output.Append(greenElementAt(items, index)))
  else
    let equals = syntaxNextTokenIndex(items, name + 1)
    if equals < 0 || greenElementRaw(greenElementAt(items, equals)) != "=" then
      parseInlineGoBodyItems(items, index + 1, output.Append(greenElementAt(items, index)))
    else
      let valueStart = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: equals + 1 })
      let parsed = if greenElementRaw(greenElementAt(items, index)) == "type" then
        parseType(valueStart)
      else
        parseExpr(valueStart)
      end
      if parsed.Cursor.Index > valueStart.Index then
        switch parsed.Node
          case Some(node) then
            let kind = if greenElementRaw(greenElementAt(items, index)) == "type" then
              GreenNodeKind.InlineGoTypeBinding
            else
              GreenNodeKind.InlineGoValueBinding
            end
            let children = joinGreenElements(
              greenElementSliceOrEmpty(items, index, valueStart.Index),
              [GreenElement.NodeElement(node)]
            )
            parseInlineGoBodyItems(items, parsed.Cursor.Index, output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
              Kind: kind,
              Span: greenElementSliceSpan(children, 0, children.Len()),
              Children: children,
              HasError: node.value().HasError,
            }))))
          end
          case None => parseInlineGoBodyItems(items, index + 1, output.Append(greenElementAt(items, index)))
        end
      else
        parseInlineGoBodyItems(items, index + 1, output.Append(greenElementAt(items, index)))
      end
    end
  end
end

func greenTokenOf(item: GreenElement) -> GreenToken
  switch item
    case TokenElement(token) => token
    case TriviaElement(trivia) => GreenToken { Kind: GreenTokenKind.Symbol, Raw: trivia.Raw, Span: trivia.Span }
    case NodeElement(_) => GreenToken { Kind: GreenTokenKind.Symbol, Raw: "", Span: syntaxRootSpan([]) }
  end
end

func parseType(cursor: SyntaxCursor) -> SyntaxParseResult
  parseTypeApplication(parseTypeAtom(syntaxCursorSkipTrivia(cursor)))
end

# A type atom is a function type, a parenthesized tuple/unit type, or a named
# (possibly qualified) type.  Bracketed suffixes are applied afterwards so that
# nested generic applications stay right-recursive without re-parsing source.
func parseTypeAtom(cursor: SyntaxCursor) -> SyntaxParseResult
  switch syntaxCursorPeek(cursor)
    case None => SyntaxParseResult { Node: None, Cursor: cursor }
    case Some(item) then
      switch greenElementNode(item)
        case Some(node) then
          if node.value().Kind == GreenNodeKind.ParenGroup then
            parseTupleType(cursor, node.value())
          else
            SyntaxParseResult { Node: None, Cursor: cursor }
          end
        end
        case None then
          if greenElementRaw(item) == "func" then
            parseFuncType(cursor)
          else
            parseNamedType(cursor)
          end
        end
      end
    end
  end
end

func parseNamedType(cursor: SyntaxCursor) -> SyntaxParseResult
  switch syntaxCursorPeek(cursor)
    case Some(item) then
      if syntaxElementNameToken(item) then
        let finish = collectQualifiedTypeName(cursor.Elements, cursor.Index)
        switch cursor.Elements.Slice(cursor.Index, finish)
          case Some(children) then
            switch (children.Get(0), children.Get(children.Len() - 1))
              case (Some(first), Some(last)) => SyntaxParseResult {
                Node: Some(Ref.new(GreenNode {
                  Kind: GreenNodeKind.NamedType,
                  Span: ps.SourceSpan { Start: greenElementSpan(first).Start, End: greenElementSpan(last).End },
                  Children: children,
                  HasError: false,
                })),
                Cursor: SyntaxCursor { Elements: cursor.Elements, Index: finish },
              }
              case _ => SyntaxParseResult { Node: None, Cursor: cursor }
            end
          end
          case None => SyntaxParseResult { Node: None, Cursor: cursor }
        end
      else
        SyntaxParseResult { Node: None, Cursor: cursor }
      end
    end
    case None => SyntaxParseResult { Node: None, Cursor: cursor }
  end
end

# Qualified names keep their '.' tokens so the CST still replays the source.
# Only an identifier on both sides of the dot is consumed.
func collectQualifiedTypeName(items: Slice[GreenElement], index: Int) -> Int
  let afterName = index + 1
  let dot = syntaxNextTokenIndex(items, afterName)
  if dot < 0 then
    afterName
  else
    switch items.Get(dot)
      case Some(item) then
        if greenElementRaw(item) == "." then
          let tail = syntaxNextTokenIndex(items, dot + 1)
          if tail >= 0 then
            switch items.Get(tail)
              case Some(next) then
                if syntaxElementNameToken(next) then
                  collectQualifiedTypeName(items, tail)
                else
                  afterName
                end
              end
              case None => afterName
            end
          else
            afterName
          end
        else
          afterName
        end
      end
      case None => afterName
    end
  end
end

func parseTupleType(cursor: SyntaxCursor, group: GreenNode) -> SyntaxParseResult
  let children = parseTypeItems(group.Children, 0, [])
  let kind = if greenElementsHaveTypeNode(children, 0) => GreenNodeKind.TupleType else GreenNodeKind.UnitType
  SyntaxParseResult {
    Node: Some(Ref.new(GreenNode {
      Kind: kind,
      Span: group.Span,
      Children: children,
      HasError: group.HasError,
    })),
    Cursor: syntaxCursorAdvance(cursor),
  }
end

func parseFuncType(cursor: SyntaxCursor) -> SyntaxParseResult
  let afterFunc = syntaxCursorSkipTrivia(syntaxCursorAdvance(cursor))
  switch syntaxCursorPeek(afterFunc)
    case Some(item) then
      switch greenElementNode(item)
        case Some(group) then
          if group.value().Kind == GreenNodeKind.ParenGroup then
            let parameters = GreenElement.NodeElement(Ref.new(GreenNode {
              Kind: GreenNodeKind.FunctionTypeParameters,
              Span: group.value().Span,
              Children: parseTypeItems(group.value().Children, 0, []),
              HasError: group.value().HasError,
            }))
            parseFuncTypeReturn(cursor, afterFunc, parameters)
          else
            SyntaxParseResult { Node: None, Cursor: cursor }
          end
        end
        case None => SyntaxParseResult { Node: None, Cursor: cursor }
      end
    end
    case None => SyntaxParseResult { Node: None, Cursor: cursor }
  end
end

func parseFuncTypeReturn(start: SyntaxCursor, afterFunc: SyntaxCursor, parameters: GreenElement) -> SyntaxParseResult
  let arrow = syntaxCursorSkipTrivia(syntaxCursorAdvance(afterFunc))
  if greenElementRaw(greenElementAt(arrow.Elements, arrow.Index)) != "->" then
    SyntaxParseResult { Node: None, Cursor: start }
  else
    let returnStart = syntaxCursorSkipTrivia(syntaxCursorAdvance(arrow))
    let parsed = parseType(returnStart)
    switch parsed.Node
      case Some(returned) => SyntaxParseResult {
        Node: Some(Ref.new(GreenNode {
          Kind: GreenNodeKind.FuncType,
          Span: ps.SourceSpan {
            Start: greenElementSpan(greenElementAt(start.Elements, start.Index)).Start,
            End: returned.value().Span.End,
          },
          Children: joinGreenElements(
            joinGreenElements(
              greenElementSliceOrEmpty(start.Elements, start.Index, afterFunc.Index),
              [parameters]
            ),
            joinGreenElements(
              joinGreenElements(
                greenElementSliceOrEmpty(start.Elements, afterFunc.Index + 1, arrow.Index),
                [greenElementAt(arrow.Elements, arrow.Index)]
              ),
              joinGreenElements(
                greenElementSliceOrEmpty(start.Elements, arrow.Index + 1, returnStart.Index),
                [GreenElement.NodeElement(returned)]
              )
            )
          ),
          HasError: returned.value().HasError,
        })),
        Cursor: parsed.Cursor,
      }
      case None => SyntaxParseResult { Node: None, Cursor: start }
    end
  end
end

func parseTypeApplication(base: SyntaxParseResult) -> SyntaxParseResult
  switch base.Node
    case Some(node) then
      # A generic argument list must sit on the same line as the base type.  A
      # bracket group after a newline starts a new construct (for example a
      # function body list literal), never a type argument suffix.
      let next = syntaxCursorSkipTriviaSameLine(base.Cursor)
      switch syntaxCursorPeek(next)
        case Some(item) then
          switch greenElementNode(item)
            case Some(group) then
              if (node.value().Kind == GreenNodeKind.NamedType || node.value().Kind == GreenNodeKind.GenericType) && group.value().Kind == GreenNodeKind.BracketGroup && !greenElementsContainNewline(base.Cursor.Elements, base.Cursor.Index, next.Index) then
                let arguments = GreenElement.NodeElement(Ref.new(GreenNode {
                  Kind: GreenNodeKind.TypeArguments,
                  Span: group.value().Span,
                  Children: parseTypeItems(group.value().Children, 0, []),
                  HasError: group.value().HasError,
                }))
                parseTypeApplication(SyntaxParseResult {
                  Node: Some(Ref.new(GreenNode {
                    Kind: GreenNodeKind.GenericType,
                    Span: ps.SourceSpan { Start: node.value().Span.Start, End: group.value().Span.End },
                    Children: [GreenElement.NodeElement(node), arguments],
                    HasError: node.value().HasError || group.value().HasError,
                  })),
                  Cursor: syntaxCursorAdvance(next),
                })
              else
                base
              end
            end
            case None => base
          end
        end
        case None => base
      end
    end
    case None => base
  end
end

# parseTypeItems re-parses the direct children of a delimiter or type-argument
# range.  Tokens and trivia pass through unchanged so every source byte is still
# owned exactly once; only actual type atoms become nested type nodes.
func parseTypeItems(items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    let cursor = SyntaxCursor { Elements: items, Index: index }
    let start = syntaxCursorSkipTrivia(cursor)
    let prefix = joinGreenElements(output, greenElementSliceOrEmpty(items, index, start.Index))
    if start.Index >= items.Len() then
      prefix
    else
      let parsed = parseType(start)
      if parsed.Cursor.Index > start.Index then
        switch parsed.Node
          case Some(node) => parseTypeItems(items, parsed.Cursor.Index, prefix.Append(GreenElement.NodeElement(node)))
          case None => parseTypeItems(items, start.Index + 1, prefix.Append(greenElementAt(items, start.Index)))
        end
      else
        parseTypeItems(items, start.Index + 1, prefix.Append(greenElementAt(items, start.Index)))
      end
    end
  end
end

func greenElementAt(items: Slice[GreenElement], index: Int) -> GreenElement
  items.Get(index).UnwrapOr(GreenElement.TokenElement(GreenToken { Kind: GreenTokenKind.Symbol, Raw: "", Span: syntaxRootSpan([]) }))
end

func greenElementsHaveTypeNode(items: Slice[GreenElement], index: Int) -> Bool
  if index >= items.Len() then
    false
  else
    switch greenElementNode(greenElementAt(items, index))
      case Some(node) => if greenNodeIsTypeKind(node.value().Kind) then true else greenElementsHaveTypeNode(items, index + 1) end
      case None => greenElementsHaveTypeNode(items, index + 1)
    end
  end
end

func syntaxElementNameToken(item: GreenElement) -> Bool
  switch item
    case TokenElement(token) => token.Kind == GreenTokenKind.Identifier
    case _ => false
  end
end

func syntaxNextTokenIndex(items: Slice[GreenElement], index: Int) -> Int
  if index >= items.Len() then
    -1
  else
    if greenElementIsTrivia(greenElementAt(items, index)) then syntaxNextTokenIndex(items, index + 1) else index end
  end
end

func syntaxNextTokenRaw(items: Slice[GreenElement], index: Int) -> String
  let next = syntaxNextTokenIndex(items, index + 1)
  if next < 0 then "" else greenElementRaw(greenElementAt(items, next)) end
end

# syntaxBlockCloseAt reports the keyword that ends a block opened by the token
# at index, or "" when the token does not open one.  MyGO closes func, struct,
# enum, interface, impl, while, letrec, if-then and case-then bodies with
# `end`; `if`/`case` only open a block in their `then` form, and a `func` inside
# an interface is a bare signature rather than a body.
# syntaxBlockCloseAt reports the keyword that ends a block opened by the token
# at index, or "" when the token does not open one.  MyGO closes func, struct,
# enum, interface, impl, while, letrec and `switch` bodies with `end`; `if`
# opens either a `then` block closed by `end` or a single-line `=>` form closed
# by `else`; a `case` header closes its body with `end`; and a `func` inside an
# interface, or in a type position, is a bare signature rather than a body.
func syntaxBlockCloseAt(items: Slice[GreenElement], index: Int, blocks: Slice[SyntaxBlock]) -> String
  let raw = greenElementRaw(greenElementAt(items, index))
  if raw == "func" then
    if syntaxInInterfaceBlock(blocks) || syntaxFuncIsType(items, index) || !syntaxFuncOpensBlock(items, index) then
      ""
    else
      "end"
    end
  elsif raw == "struct" || raw == "enum" || raw == "interface" || raw == "impl" || raw == "while" || raw == "letrec" || raw == "switch" then
    "end"
  elsif raw == "if" then
    if syntaxHeaderKeyword(items, index, "=>") then "else" else "end" end
  elsif raw == "case" then
    # A `case pat then` arm owns an `end`; a `case pat =>` arm has no
    # terminator of its own -- its body runs until the next `case` or the
    # enclosing `switch`'s `end` -- so it opens no block.
    if syntaxHeaderKeyword(items, index, "=>") then "" else "end" end
  else
    ""
  end
end

# syntaxInInterfaceBlock reports whether the innermost open block is an
# interface.  Interface members are bare signatures with no body, so a `func`
# there never opens a block.
func syntaxInInterfaceBlock(blocks: Slice[SyntaxBlock]) -> Bool
  switch syntaxRecoveryLastBlock(blocks)
    case Some(open) => open.Keyword == "interface"
    case None => false
  end
end

# syntaxFuncIsType reports whether the `func` at index is a func type used in a
# type position.  A func type follows `:`, `->`, `as`, or `[` (parameter, field,
# result, cast, or type-argument position).  A func declaration or literal
# instead starts a line, follows `=`, or appears after `(`/`,` as an argument;
# those own an `end` body and are left to `syntaxFuncOpensBlock`.
func syntaxFuncIsType(items: Slice[GreenElement], index: Int) -> Bool
  let previous = syntaxPreviousTokenRaw(items, index - 1)
  if previous == ":" || previous == "->" || previous == "[" || previous == "as" then
    true
  elsif previous == "=" then
    # `type T = func(...) -> R` is a func type; `let f = func(...) ... end`
    # is a func literal.  Only the `type` declaration opens a type position.
    syntaxLineStartsWith(items, index, "type")
  else
    false
  end
end

# syntaxLineStartsWith reports whether the first non-trivia token on the logical
# line containing index is the requested keyword.
func syntaxLineStartsWith(items: Slice[GreenElement], index: Int, keyword: String) -> Bool
  let lineStart = syntaxLineStartIndex(items, index)
  let first = syntaxNextTokenIndex(items, lineStart)
  if first < 0 then false else greenElementRaw(greenElementAt(items, first)) == keyword end
end

# syntaxLineStartIndex returns the index of the first element on the logical
# line containing index: the element right after the preceding newline trivia.
func syntaxLineStartIndex(items: Slice[GreenElement], index: Int) -> Int
  if index <= 0 then
    0
  else
    if greenElementIsTrivia(greenElementAt(items, index - 1)) && strings.Contains(greenElementRaw(greenElementAt(items, index - 1)), "\n") then
      index
    else
      syntaxLineStartIndex(items, index - 1)
    end
  end
end

func syntaxPreviousTokenRaw(items: Slice[GreenElement], index: Int) -> String
  if index < 0 then
    ""
  else
    if greenElementIsTrivia(greenElementAt(items, index)) then syntaxPreviousTokenRaw(items, index - 1) else greenElementRaw(greenElementAt(items, index)) end
  end
end

# syntaxHeaderKeyword scans the header of an `if`/`case` at index for the first
# depth-zero keyword among `then` and `=>`.  It reports whether that keyword is
# the requested one; a header terminated by a newline reports neither.
func syntaxHeaderKeyword(items: Slice[GreenElement], index: Int, want: String) -> Bool
  syntaxHeaderScan(items, index + 1, 0, want)
end

func syntaxHeaderScan(items: Slice[GreenElement], index: Int, depth: Int, want: String) -> Bool
  if index >= items.Len() then
    false
  else
    let item = greenElementAt(items, index)
    if greenElementIsTrivia(item) then
      if depth == 0 && strings.Contains(greenElementRaw(item), "\n") then false else syntaxHeaderScan(items, index + 1, depth, want) end
    else
      let raw = greenElementRaw(item)
      if raw == "(" || raw == "[" || raw == "{" then
        syntaxHeaderScan(items, index + 1, depth + 1, want)
      elsif raw == ")" || raw == "]" || raw == "}" then
        if depth == 0 then false else syntaxHeaderScan(items, index + 1, depth - 1, want) end
      elsif depth == 0 && raw == "then" then
        want == "then"
      elsif depth == 0 && raw == "=>" then
        want == "=>"
      else
        syntaxHeaderScan(items, index + 1, depth, want)
      end
    end
  end
end

# syntaxFuncOpensBlock distinguishes a func declaration/literal that owns an
# `end` from a func type used in a type position.  Scanning the signature at
# depth zero: an arrow body (`=>`) or a closing delimiter that ends the
# enclosing construct means no block; an `end`, or a header terminated by a
# newline, means the func owns a block.  Interface signatures are excluded by
# the caller because they have no body.
func syntaxFuncOpensBlock(items: Slice[GreenElement], index: Int) -> Bool
  syntaxFuncBodyScan(items, index + 1, 0)
end

func syntaxFuncBodyScan(items: Slice[GreenElement], index: Int, depth: Int) -> Bool
  if index >= items.Len() then
    false
  else
    let item = greenElementAt(items, index)
    if greenElementIsTrivia(item) then
      if depth == 0 && strings.Contains(greenElementRaw(item), "\n") then true else syntaxFuncBodyScan(items, index + 1, depth) end
    else
      let raw = greenElementRaw(item)
      if raw == "(" || raw == "[" || raw == "{" then
        syntaxFuncBodyScan(items, index + 1, depth + 1)
      elsif raw == ")" || raw == "]" || raw == "}" then
        if depth == 0 then false else syntaxFuncBodyScan(items, index + 1, depth - 1) end
      elsif depth == 0 && raw == "=>" then
        false
      elsif depth == 0 && raw == "end" then
        true
      else
        syntaxFuncBodyScan(items, index + 1, depth)
      end
    end
  end
end

func greenNodeIsTypeKind(kind: GreenNodeKind) -> Bool
  kind == GreenNodeKind.NamedType || kind == GreenNodeKind.GenericType || kind == GreenNodeKind.TupleType || kind == GreenNodeKind.UnitType || kind == GreenNodeKind.FuncType
end

func greenNodeIsPatternKind(kind: GreenNodeKind) -> Bool
  kind == GreenNodeKind.Pattern || kind == GreenNodeKind.BindPattern || kind == GreenNodeKind.WildcardPattern || kind == GreenNodeKind.LiteralPattern || kind == GreenNodeKind.TuplePattern || kind == GreenNodeKind.VariantPattern || kind == GreenNodeKind.StructVariantPattern
end

func greenNodeTypeChildren(node: GreenNode, index: Int, output: Slice[Ref[GreenNode]]) -> Slice[Ref[GreenNode]]
  if index >= node.Children.Len() then
    output
  else
    switch greenElementNode(greenElementAt(node.Children, index))
      case Some(child) => if greenNodeIsTypeKind(child.value().Kind) then greenNodeTypeChildren(node, index + 1, output.Append(child)) else greenNodeTypeChildren(node, index + 1, output) end
      case None => greenNodeTypeChildren(node, index + 1, output)
    end
  end
end

# parsePattern implements the recursive pattern grammar of frontier 2.  The
# delimiter pass has already grouped `( ... )` into a ParenGroup, so a tuple
# pattern is that group and a variant payload is the ParenGroup that follows a
# variant name.  Literal patterns keep their raw token so lowering can decode
# the value from the green range without re-reading the source text.
func parsePattern(cursor: SyntaxCursor) -> SyntaxParseResult
  let start = syntaxCursorSkipTrivia(cursor)
  switch syntaxCursorPeek(start)
    case Some(item) then
      switch greenElementNode(item)
        case Some(group) then
          if group.value().Kind == GreenNodeKind.ParenGroup then
            parseTuplePatternNode(start, group.value())
          else
            SyntaxParseResult { Node: None, Cursor: cursor }
          end
        end
        case None => parsePatternLeaf(start, item)
      end
    end
    case _ => SyntaxParseResult { Node: None, Cursor: cursor }
  end
end

func parsePatternLeaf(cursor: SyntaxCursor, item: GreenElement) -> SyntaxParseResult
  if greenElementRaw(item) == "_" then
    syntaxLeafNodeResult(GreenNodeKind.WildcardPattern, item, syntaxCursorAdvance(cursor))
  elsif greenElementPatternLiteralKind(item) != "" then
    syntaxLeafNodeResult(GreenNodeKind.LiteralPattern, item, syntaxCursorAdvance(cursor))
  elsif syntaxElementNameToken(item) then
    parsePatternIdentifier(cursor, item)
  else
    SyntaxParseResult { Node: None, Cursor: cursor }
  end
end

func syntaxLeafNodeResult(kind: GreenNodeKind, item: GreenElement, next: SyntaxCursor) -> SyntaxParseResult
  SyntaxParseResult {
    Node: Some(Ref.new(GreenNode { Kind: kind, Span: greenElementSpan(item), Children: [item], HasError: false })),
    Cursor: next,
  }
end

# greenElementPatternLiteralKind classifies a literal token for the pattern
# grammar.  The kind name matches ast2.Pattern.LiteralPattern's first field.
func greenElementPatternLiteralKind(item: GreenElement) -> String
  switch item
    case TokenElement(token) then
      if token.Kind == GreenTokenKind.Number then
        "number"
      elsif token.Kind == GreenTokenKind.StringLiteral || token.Kind == GreenTokenKind.RawStringLiteral || token.Kind == GreenTokenKind.TripleStringLiteral then
        "string"
      elsif token.Kind == GreenTokenKind.RuneLiteral then
        "rune"
      else
        ""
      end
    end
    case _ => ""
  end
end

# A bare identifier is a bind pattern unless a payload group follows it, in
# which case it is a variant (`Some(x)`) or struct-variant (`Point { x }`)
# pattern.  The payload group stays a sibling of the name so every source byte
# is owned exactly once.
func parsePatternIdentifier(cursor: SyntaxCursor, item: GreenElement) -> SyntaxParseResult
  let afterName = syntaxCursorSkipTrivia(syntaxCursorAdvance(cursor))
  switch syntaxCursorPeek(afterName)
    case Some(peek) then
      switch greenElementNode(peek)
        case Some(group) then
          if group.value().Kind == GreenNodeKind.ParenGroup then
            parseVariantPatternNode(cursor, item, afterName, group.value())
          elsif group.value().Kind == GreenNodeKind.BraceGroup then
            parseStructVariantPatternNode(cursor, item, afterName, group.value())
          else
            syntaxLeafNodeResult(GreenNodeKind.BindPattern, item, syntaxCursorAdvance(cursor))
          end
        end
        case None => syntaxLeafNodeResult(GreenNodeKind.BindPattern, item, syntaxCursorAdvance(cursor))
      end
    end
    case _ => syntaxLeafNodeResult(GreenNodeKind.BindPattern, item, syntaxCursorAdvance(cursor))
  end
end

func parseTuplePatternNode(start: SyntaxCursor, group: GreenNode) -> SyntaxParseResult
  let items = parseGroupItems(GreenNodeKind.Pattern, group.Children, 0, [])
  SyntaxParseResult {
    Node: Some(Ref.new(GreenNode {
      Kind: GreenNodeKind.TuplePattern,
      Span: group.Span,
      Children: [GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.ParenGroup, Span: group.Span, Children: items, HasError: group.HasError }))],
      HasError: group.HasError,
    })),
    Cursor: syntaxCursorAdvance(start),
  }
end

func parseVariantPatternNode(cursor: SyntaxCursor, name: GreenElement, afterName: SyntaxCursor, group: GreenNode) -> SyntaxParseResult
  let items = parseGroupItems(GreenNodeKind.Pattern, group.Children, 0, [])
  let gap = greenElementSliceOrEmpty(cursor.Elements, cursor.Index + 1, afterName.Index)
  SyntaxParseResult {
    Node: Some(Ref.new(GreenNode {
      Kind: GreenNodeKind.VariantPattern,
      Span: ps.SourceSpan { Start: greenElementSpan(name).Start, End: group.Span.End },
      Children: joinGreenElements(
        joinGreenElements(
          [GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.IdentifierExpr, Span: greenElementSpan(name), Children: [name], HasError: false }))],
          gap
        ),
        [GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.ParenGroup, Span: group.Span, Children: items, HasError: group.HasError }))]
      ),
      HasError: group.HasError,
    })),
    Cursor: syntaxCursorAdvance(afterName),
  }
end

func parseStructVariantPatternNode(cursor: SyntaxCursor, name: GreenElement, afterName: SyntaxCursor, group: GreenNode) -> SyntaxParseResult
  let fields = parseStructPatternFieldItems(group.Children, 0, [])
  let gap = greenElementSliceOrEmpty(cursor.Elements, cursor.Index + 1, afterName.Index)
  SyntaxParseResult {
    Node: Some(Ref.new(GreenNode {
      Kind: GreenNodeKind.StructVariantPattern,
      Span: ps.SourceSpan { Start: greenElementSpan(name).Start, End: group.Span.End },
      Children: joinGreenElements(
        joinGreenElements(
          [GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.IdentifierExpr, Span: greenElementSpan(name), Children: [name], HasError: false }))],
          gap
        ),
        [GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.BraceGroup, Span: group.Span, Children: fields, HasError: group.HasError }))]
      ),
      HasError: group.HasError,
    })),
    Cursor: syntaxCursorAdvance(afterName),
  }
end

# parseStructPatternFieldItems groups the flat leaves of a `{ ... }` pattern
# payload into StructPatternField nodes: `field: bind`, `_`, or `field`.
func parseStructPatternFieldItems(items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    let item = greenElementAt(items, index)
    let raw = greenElementRaw(item)
    if greenElementIsTrivia(item) || raw == "{" || raw == "}" || raw == "," then
      parseStructPatternFieldItems(items, index + 1, output.Append(item))
    elsif raw == "_" then
      parseStructPatternFieldItems(items, index + 1, output.Append(syntaxStructPatternField([item])))
    elsif syntaxElementNameToken(item) then
      let colon = syntaxNextTokenIndex(items, index + 1)
      if colon >= 0 && greenElementRaw(greenElementAt(items, colon)) == ":" then
        let bind = syntaxNextTokenIndex(items, colon + 1)
        if bind >= 0 && syntaxElementNameToken(greenElementAt(items, bind)) then
          parseStructPatternFieldItems(items, bind + 1, output.Append(syntaxStructPatternField(greenElementSliceOrEmpty(items, index, bind + 1))))
        else
          parseStructPatternFieldItems(items, index + 1, output.Append(syntaxStructPatternField([item])))
        end
      else
        parseStructPatternFieldItems(items, index + 1, output.Append(syntaxStructPatternField([item])))
      end
    else
      parseStructPatternFieldItems(items, index + 1, output.Append(item))
    end
  end
end

func syntaxStructPatternField(children: Slice[GreenElement]) -> GreenElement
  GreenElement.NodeElement(Ref.new(GreenNode {
    Kind: GreenNodeKind.StructPatternField,
    Span: greenElementSliceSpan(children, 0, children.Len()),
    Children: children,
    HasError: false,
  }))
end

func parseGroupedSyntax(kind: GreenNodeKind, cursor: SyntaxCursor) -> SyntaxParseResult
  switch syntaxCursorPeek(cursor)
    case Some(item) then
      switch greenElementNode(item)
        case Some(node) then
          let value = node.value()
          if value.Kind == GreenNodeKind.ParenGroup || value.Kind == GreenNodeKind.BracketGroup || value.Kind == GreenNodeKind.BraceGroup then
            let nodeKind = expressionGroupKind(kind, value, syntaxCursorPreviousRaw(cursor, cursor.Index - 1), syntaxSameLineSuffix(cursor))
            let children = syntaxGroupChildren(nodeKind, kind, value.Children)
            SyntaxParseResult {
              Node: Some(Ref.new(GreenNode {
                Kind: nodeKind,
                Span: value.Span,
                Children: [GreenElement.NodeElement(Ref.new(GreenNode {
                  Kind: value.Kind,
                  Span: value.Span,
                  Children: children,
                  HasError: value.HasError,
                }))],
                HasError: false
              })),
              Cursor: syntaxCursorAdvance(cursor),
            }
          else
            parseAtomicSyntax(kind, cursor)
          end
        end
        case None => parseAtomicSyntax(kind, cursor)
      end
    end
    case _ => parseAtomicSyntax(kind, cursor)
  end
end

func expressionGroupKind(fallback: GreenNodeKind, group: GreenNode, previous: String, sameLine: Bool) -> GreenNodeKind
  if fallback == GreenNodeKind.Type && group.Kind == GreenNodeKind.ParenGroup then
    GreenNodeKind.TupleType
  elsif fallback == GreenNodeKind.Pattern && group.Kind == GreenNodeKind.ParenGroup then
    GreenNodeKind.TuplePattern
  elsif fallback != GreenNodeKind.Expression then
    fallback
  elsif group.Kind == GreenNodeKind.ParenGroup && syntaxPreviousStartsCall(previous) && sameLine then
    GreenNodeKind.Call
  elsif group.Kind == GreenNodeKind.ParenGroup then
    parenExpressionKind(group)
  elsif group.Kind == GreenNodeKind.BracketGroup then
    GreenNodeKind.SliceLiteral
  elsif group.Kind == GreenNodeKind.BraceGroup && syntaxPreviousStartsCall(previous) && sameLine then
    GreenNodeKind.StructLiteral
  elsif group.Kind == GreenNodeKind.BraceGroup && greenElementsContainRaw(group.Children, ":", 0) then
    GreenNodeKind.MapLiteral
  elsif group.Kind == GreenNodeKind.BraceGroup && !greenElementsHaveInnerContent(group.Children, 0) then
    # An empty `{}` is the empty map literal, matching the legacy parser.
    GreenNodeKind.MapLiteral
  elsif group.Kind == GreenNodeKind.BraceGroup then
    GreenNodeKind.SetLiteral
  else
    fallback
  end
end

# greenElementsHaveInnerContent reports whether a delimiter group owns any
# element besides its own `{`/`}` (or `(`/`)`, `[`/`]`) tokens and trivia.  An
# empty brace group is the empty map literal, matching the legacy parser.
func greenElementsHaveInnerContent(items: Slice[GreenElement], index: Int) -> Bool
  if index >= items.Len() then
    false
  else
    let item = greenElementAt(items, index)
    let raw = greenElementRaw(item)
    if greenElementIsTrivia(item) || raw == "{" || raw == "}" || raw == "(" || raw == ")" || raw == "[" || raw == "]" then
      greenElementsHaveInnerContent(items, index + 1)
    else
      true
    end
  end
end

# parenExpressionKind distinguishes `()`, `(x)`, and `(x, y)`.  A group with no
# tokens is the unit value; a top-level comma makes it a tuple; otherwise the
# parentheses only group a single expression.
func parenExpressionKind(group: GreenNode) -> GreenNodeKind
  if !greenElementsHaveInnerToken(group.Children, 0) then
    GreenNodeKind.UnitExpr
  elsif greenElementsContainRaw(group.Children, ",", 0) then
    GreenNodeKind.TupleExpr
  else
    GreenNodeKind.ParenExpr
  end
end

# greenElementsHaveInnerToken reports whether a delimiter group holds any token
# besides its own opening and closing delimiters.  `()` has none, while `(x)`
# and `((x))` both do; the nested group is a node element and counts as content.
func greenElementsHaveInnerToken(items: Slice[GreenElement], index: Int) -> Bool
  if index >= items.Len() then
    false
  else
    let item = greenElementAt(items, index)
    if greenElementIsTrivia(item) then
      greenElementsHaveInnerToken(items, index + 1)
    else
      switch item
        case TokenElement(token) => if token.Raw == "(" || token.Raw == ")" then greenElementsHaveInnerToken(items, index + 1) else true end
        case _ => true
      end
    end
  end
end

# syntaxPreviousStartsCall reports whether the token before a delimiter group can
# be the callee of a call or the type name of a struct literal.  Operators such
# as `=`, `=>`, `,`, and `(` leave the group as a parenthesized/tuple value.
func syntaxPreviousStartsCall(previous: String) -> Bool
  if previous == "" then
    false
  elsif previous == ")" || previous == "]" || previous == "}" then
    true
  else
    isWordChar(sourceSliceOrEOF(previous, 0, 1)) && !isKeyword(previous)
  end
end

func greenElementsContainRaw(items: Slice[GreenElement], raw: String, index: Int) -> Bool
  if index >= items.Len() then
    false
  else
    switch items.Get(index)
      case Some(item) => if greenElementRaw(item) == raw => true else greenElementsContainRaw(items, raw, index + 1)
      case None => false
    end
  end
end

# syntaxGroupChildren chooses how to fill a delimiter group's typed children.
# Slice and set literals own expression items; map literals own MapEntry nodes;
# struct literals own StructLitField nodes; every other group re-parses its
# items with the context kind.
func syntaxGroupChildren(nodeKind: GreenNodeKind, fallback: GreenNodeKind, items: Slice[GreenElement]) -> Slice[GreenElement]
  if nodeKind == GreenNodeKind.MapLiteral then
    parseMapEntryItems(items, 0, [], 0)
  elsif nodeKind == GreenNodeKind.StructLiteral then
    parseStructLitFieldItems(items, 0, [])
  elsif nodeKind == GreenNodeKind.SliceLiteral || nodeKind == GreenNodeKind.SetLiteral then
    parseGroupItems(GreenNodeKind.Expression, items, 0, [])
  else
    parseGroupItems(fallback, items, 0, [])
  end
end

# parseMapEntryItems groups a map body into MapEntry nodes.  A MapEntry owns the
# trivia before its key, the key expression, the `:`, its value expression, and
# the trivia between them; the braces and comma separators stay owned between
# entries.  `pending` is the start of the current entry region, i.e. the element
# right after the last `{` or `,`.
func parseMapEntryItems(items: Slice[GreenElement], index: Int, output: Slice[GreenElement], pending: Int) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    let item = greenElementAt(items, index)
    let raw = greenElementRaw(item)
    if greenElementIsTrivia(item) then
      parseMapEntryItems(items, index + 1, output, pending)
    elsif raw == "{" || raw == "," then
      parseMapEntryItems(items, index + 1, output.Append(item), index + 1)
    elsif raw == "}" then
      parseMapEntryItems(items, index + 1, output.Append(item), pending)
    else
      let start = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: index })
      let parsedKey = parseExpr(start)
      switch parsedKey.Node
        case Some(keyNode) => parseMapEntryValue(items, parsedKey.Cursor, output, pending, keyNode, index)
        case None => parseMapEntryItems(items, index + 1, output.Append(item), pending)
      end
    end
  end
end

func parseMapEntryValue(items: Slice[GreenElement], afterKey: SyntaxCursor, output: Slice[GreenElement], pending: Int, keyNode: Ref[GreenNode], keyStart: Int) -> Slice[GreenElement]
  let colonIndex = syntaxNextTokenIndex(items, afterKey.Index)
  if colonIndex < 0 || greenElementRaw(greenElementAt(items, colonIndex)) != ":" then
    parseMapEntryItems(items, afterKey.Index, output.Append(GreenElement.NodeElement(keyNode)), pending)
  else
    let valueStart = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: colonIndex + 1 })
    let parsedValue = parseExpr(valueStart)
    switch parsedValue.Node
      case Some(valueNode) then
        let entry = syntaxMapEntryElement(
          greenElementSliceOrEmpty(items, pending, keyStart),
          greenElementSliceOrEmpty(items, afterKey.Index, valueStart.Index),
          keyNode,
          valueNode,
        )
        parseMapEntryItems(items, parsedValue.Cursor.Index, output.Append(entry), parsedValue.Cursor.Index)
      end
      case None then
        parseMapEntryItems(items, colonIndex + 1, output.Append(GreenElement.NodeElement(keyNode)), pending)
      end
    end
  end
end

func syntaxMapEntryElement(lead: Slice[GreenElement], middle: Slice[GreenElement], keyNode: Ref[GreenNode], valueNode: Ref[GreenNode]) -> GreenElement
  GreenElement.NodeElement(Ref.new(GreenNode {
    Kind: GreenNodeKind.MapEntry,
    Span: ps.SourceSpan { Start: keyNode.value().Span.Start, End: valueNode.value().Span.End },
    Children: joinGreenElements(
      joinGreenElements(joinGreenElements(lead, [GreenElement.NodeElement(keyNode)]), middle),
      [GreenElement.NodeElement(valueNode)]
    ),
    HasError: keyNode.value().HasError || valueNode.value().HasError,
  }))
end

func parseGroupItems(kind: GreenNodeKind, items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    let cursor = SyntaxCursor { Elements: items, Index: index }
    let start = syntaxCursorSkipTrivia(cursor)
    let parsed = if kind == GreenNodeKind.Type then
      parseType(start)
    elsif kind == GreenNodeKind.Expression then
      parseExpr(start)
    else
      parsePattern(start)
    end
    let prefix = joinGreenElements(output, greenElementSliceOrEmpty(items, index, start.Index))
    if parsed.Cursor.Index > index then
      switch parsed.Node
        case Some(node) then
          parseGroupItems(kind, items, parsed.Cursor.Index, prefix.Append(GreenElement.NodeElement(node)))
        end
        case None => parseGroupItems(kind, items, parsed.Cursor.Index, prefix)
      end
    else
      switch items.Get(index)
        case Some(item) => parseGroupItems(kind, items, index + 1, output.Append(item))
        case None => output
      end
    end
  end
end

func greenElementNode(item: GreenElement) -> Option[Ref[GreenNode]]
  switch item
    case NodeElement(node) => Some(node)
    case _ => None
  end
end

func parseAtomicSyntax(kind: GreenNodeKind, cursor: SyntaxCursor) -> SyntaxParseResult
  switch syntaxCursorPeek(cursor)
    case None => SyntaxParseResult { Node: None, Cursor: cursor }
    case Some(item) then
      if syntaxElementStartsAtom(item) then
        parseAtomicElement(kind, cursor, item)
      else
        SyntaxParseResult { Node: None, Cursor: cursor }
      end
    end
  end
end

# parseAtomicElement freezes one atom.  An element that is already a frozen
# node (a nested keyword block or a typed group) is returned directly so its
# concrete kind survives, letting lowering see a SwitchBlock/IfBlock rather
# than a generic expression wrapper; a raw token becomes its atom node.
func parseAtomicElement(kind: GreenNodeKind, cursor: SyntaxCursor, item: GreenElement) -> SyntaxParseResult
  switch greenElementNode(item)
    case Some(node) => SyntaxParseResult { Node: Some(node), Cursor: syntaxCursorAdvance(cursor) }
    case None => SyntaxParseResult {
      Node: Some(Ref.new(GreenNode { Kind: atomicSyntaxKind(kind, item), Span: greenElementSpan(item), Children: [item], HasError: false })),
      Cursor: syntaxCursorAdvance(cursor),
    }
  end
end

func atomicSyntaxKind(context: GreenNodeKind, item: GreenElement) -> GreenNodeKind
  if context == GreenNodeKind.Type then
    GreenNodeKind.NamedType
  elsif context == GreenNodeKind.Pattern then
    GreenNodeKind.BindPattern
  else
    switch item
      case TokenElement(token) then
        if token.Raw == "true" || token.Raw == "false" then GreenNodeKind.BoolExpr
        elsif token.Kind == GreenTokenKind.Number then GreenNodeKind.NumberExpr
        elsif token.Kind == GreenTokenKind.StringLiteral || token.Kind == GreenTokenKind.RawStringLiteral || token.Kind == GreenTokenKind.TripleStringLiteral then GreenNodeKind.StringExpr
        elsif token.Kind == GreenTokenKind.RuneLiteral then GreenNodeKind.RuneExpr
        else GreenNodeKind.IdentifierExpr
        end
      end
      case _ => context
    end
  end
end

func syntaxElementStartsAtom(item: GreenElement) -> Bool
  switch item
    case TokenElement(token) => token.Raw != "" && !syntaxTokenIsStructuralSeparator(token.Raw)
    case NodeElement(_) => true
    case TriviaElement(_) => false
  end
end

# syntaxTokenIsStructuralSeparator reports whether a raw token only separates or
# delimits other syntax.  These leaves stay unwrapped inside a group so a
# parenthesized expression keeps its commas and parens as trivia-like tokens
# rather than becoming spurious identifier atoms.
func syntaxTokenIsStructuralSeparator(raw: String) -> Bool
  raw == "(" || raw == ")" || raw == "[" || raw == "]" || raw == "{" || raw == "}" || raw == "," || raw == ":" || raw == ";"
end

func groupTopLevelDeclarations(items: Slice[GreenElement]) -> Slice[GreenElement]
  let startPos = nextDeclarationStart(items, 0)
  if startPos < 0 then
    items
  else
    let finish = nextDeclarationStart(items, startPos + 1)
    let endPos = if finish < 0 => items.Len() else finish
    switch greenElementSlice(items, startPos, endPos)
      case None => items
      case Some(body) then
        switch (body.Get(0), body.Get(body.Len() - 1))
          case (Some(first), Some(last)) then
            let declaration = GreenElement.NodeElement(Ref.new(GreenNode {
              Kind: GreenNodeKind.Declaration,
              Span: ps.SourceSpan { Start: greenElementSpan(first).Start, End: greenElementSpan(last).End },
              Children: body,
              HasError: false,
            }))
            joinGreenElements(
              joinGreenElements(greenElementSliceOrEmpty(items, 0, startPos), [declaration]),
              groupTopLevelDeclarations(greenElementSliceOrEmpty(items, endPos, items.Len()))
            )
          end
          case _ => items
        end
      end
    end
  end
end

func nextDeclarationStart(items: Slice[GreenElement], index: Int) -> Int
  if index >= items.Len() then
    -1
  else
    switch items.Get(index)
      case Some(item) => if greenElementStartsDeclaration(item) => index else nextDeclarationStart(items, index + 1)
      case None => -1
    end
  end
end

func greenElementStartsDeclaration(item: GreenElement) -> Bool
  greenElementStartsDeclarationRaw(greenElementRaw(item))
end

func greenElementStartsDeclarationRaw(raw: String) -> Bool
  raw == "func" || raw == "type" || raw == "struct" || raw == "enum" || raw == "interface" || raw == "impl" || raw == "let" || raw == "var" || raw == "import" || raw == "package"
end

func greenElementSlice(items: Slice[GreenElement], start: Int, finish: Int) -> Option[Slice[GreenElement]]
  # Slice returns a Go sub-slice that aliases the same backing array, so a
  # caller that later Appends into this view would overwrite live source
  # elements.  Copy it so every returned range owns its own storage.
  switch items.Slice(start, finish)
    case Some(slice) => Some(greenListToSlice(greenSliceToList(slice, None)))
    case None => None
  end
end

func greenElementSliceOrEmpty(items: Slice[GreenElement], start: Int, finish: Int) -> Slice[GreenElement]
  switch greenElementSlice(items, start, finish)
    case Some(slice) => slice
    case None => []
  end
end

func syntaxRootSpan(items: Slice[GreenElement]) -> ps.SourceSpan
  let start = ps.Position { Offset: 0, Line: 1, Column: 1 }
  if items.Len() == 0 then
    ps.SourceSpan { Start: start, End: start }
  else
    switch items.Get(items.Len() - 1)
      case Some(last) => ps.SourceSpan { Start: start, End: greenElementSpan(last).End }
      case None => ps.SourceSpan { Start: start, End: start }
    end
  end
end

func buildDelimitedChildren(items: Slice[GreenElement], index: Int, close: String) -> DelimitedBuildResult
  if index >= items.Len() then
    DelimitedBuildResult { Children: None, Next: index, Close: None }
  else
    switch items.Get(index)
      case None => DelimitedBuildResult { Children: None, Next: index, Close: None }
      case Some(item) then
        if structuralIsStatementClose(close) && structuralTerminatesStatement(item) then
          # End the arrow-form if block just before its statement boundary.  A
          # zero-width synthetic closer records the end range while leaving the
          # boundary element itself for the enclosing context to own.
          let anchor = greenElementSpan(item).Start
          let closer = GreenElement.TokenElement(GreenToken { Kind: GreenTokenKind.Symbol, Raw: "", Span: ps.SourceSpan { Start: anchor, End: anchor } })
          DelimitedBuildResult { Children: None, Next: index, Close: Some(closer) }
        elsif greenElementRaw(item) == close && close != "" then
          DelimitedBuildResult { Children: Some(List.Cons(item, None)), Next: index + 1, Close: Some(item) }
        elsif close != "" && structuralOpaqueBlockOpen(items, index) then
          # A func literal or letrec owns its own `end`, which must not be
          # mistaken for the terminator of the enclosing keyword block.  Build
          # the inner region against its own `end` (so nested keyword blocks
          # are still structured) and splice it back flat, keeping the opener
          # and closer as raw leaves for the later statement/expression passes.
          let nested = buildDelimitedChildren(items, index + 1, "end")
          if nested.Close.IsNone() then
            let tail = buildDelimitedChildren(items, index + 1, close)
            DelimitedBuildResult { Children: Some(List.Cons(item, tail.Children)), Next: tail.Next, Close: tail.Close }
          else
            let tail = buildDelimitedChildren(items, nested.Next, close)
            DelimitedBuildResult {
              Children: Some(List.Cons(item, greenSliceToList(greenListToSlice(nested.Children), tail.Children))),
              Next: tail.Next,
              Close: tail.Close,
            }
          end
        else
          let terminator = structuralCloseAt(items, index)
          if terminator == "" then
            let tail = buildDelimitedChildren(items, index + 1, close)
            DelimitedBuildResult { Children: Some(List.Cons(item, tail.Children)), Next: tail.Next, Close: tail.Close }
          else
            let nested = buildDelimitedChildren(items, index + 1, terminator)
            if nested.Close.IsNone() then
              let tail = buildDelimitedChildren(items, index + 1, close)
              DelimitedBuildResult { Children: Some(List.Cons(item, tail.Children)), Next: tail.Next, Close: tail.Close }
            else
              switch nested.Close
                case Some(closer) then
                  let group = GreenNode {
                    Kind: structuralKind(greenElementRaw(item)),
                    Span: ps.SourceSpan { Start: greenElementSpan(item).Start, End: greenElementSpan(closer).End },
                    Children: structuralBlockChildren(structuralKind(greenElementRaw(item)), structuralIsKeywordBlock(greenElementRaw(item)), greenListToSlice(Some(List.Cons(item, nested.Children))), closer),
                    HasError: false,
                  }
                  let tail = buildDelimitedChildren(items, nested.Next, close)
                  DelimitedBuildResult {
                    Children: Some(List.Cons(GreenElement.NodeElement(Ref.new(group)), tail.Children)),
                    Next: tail.Next,
                    Close: tail.Close,
                  }
                end
                case None => DelimitedBuildResult { Children: Some(List.Cons(item, nested.Children)), Next: nested.Next, Close: None }
              end
            end
          end
        end
      end
    end
  end
end

func branchChildren(blockKind: GreenNodeKind, items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    switch items.Get(index)
      case Some(item) then
        if greenElementBranchKind(blockKind, item) != GreenNodeKind.Error then
          # An already-built branch node owns its own region (a then-form case
          # nested inside an arrow-form case body); keep it whole as a sibling.
          branchChildren(blockKind, items, index + 1, output.Append(item))
        else
          let kind = branchKind(blockKind, greenElementRaw(item))
          if kind == GreenNodeKind.Error then
            branchChildren(blockKind, items, index + 1, output.Append(item))
          else
          let finish = nextBranchStart(blockKind, items, index + 1)
          let endPos = if finish < 0 => items.Len() else finish
          switch items.Slice(index, endPos)
            case Some(children) then
              switch children.Get(children.Len() - 1)
                case Some(last) => branchChildren(blockKind, items, endPos, output.Append(GreenElement.NodeElement(Ref.new(GreenNode { Kind: kind, Span: ps.SourceSpan { Start: greenElementSpan(item).Start, End: greenElementSpan(last).End }, Children: syntaxBranchBodyChildren(kind, if kind == GreenNodeKind.CaseBranch then caseBranchChildren(children) else children end), HasError: false }))))
                case None => branchChildren(blockKind, items, endPos, output)
              end
            end
            case None => branchChildren(blockKind, items, index + 1, output.Append(item))
          end
          end
        end
      end
      case None => output
    end
  end
end

# greenElementBranchKind reports whether an element is already a branch node
# for this block: a then-form case built as its own CaseBranch, or an elsif/else
# branch.  Such a node owns its whole region, so the branch splitter must treat
# it as a boundary rather than folding it into the previous branch's body.
func greenElementBranchKind(blockKind: GreenNodeKind, item: GreenElement) -> GreenNodeKind
  switch greenElementNode(item)
    case Some(node) then
      let kind = node.value().Kind
      if blockKind == GreenNodeKind.SwitchBlock && kind == GreenNodeKind.CaseBranch then
        GreenNodeKind.CaseBranch
      elsif blockKind == GreenNodeKind.IfBlock && (kind == GreenNodeKind.ElsifBranch || kind == GreenNodeKind.ElseBranch) then
        kind
      else
        GreenNodeKind.Error
      end
    end
    case None => GreenNodeKind.Error
  end
end

# syntaxBranchBodyChildren rewrites the body region that follows a branch
# header keyword into statement nodes wrapped in one Block node, so a
# multi-statement then/else/case body lowers through the same path as a
# function body.  The header keeps its typed expression runs and a branch's own
# `end` closer stays a sibling of the body Block.
func syntaxBranchBodyChildren(kind: GreenNodeKind, items: Slice[GreenElement]) -> Slice[GreenElement]
  if kind == GreenNodeKind.ElseBranch then
    syntaxBranchBodyAfter(items, syntaxTopLevelKeywordIndex(items, 0, "else"))
  elsif kind == GreenNodeKind.ElsifBranch then
    syntaxBranchBodyAfter(items, syntaxTopLevelKeywordIndex(items, 0, "then"))
  else
    syntaxBranchBodyAfter(items, syntaxCaseHeaderIndex(items))
  end
end

# syntaxCaseHeaderIndex returns the index of the first depth-zero `then` or `=>`
# in a case branch header, or -1 when neither appears.  A then-form case closes
# its body with its own `end`; an arrow-form case has no closer.
func syntaxCaseHeaderIndex(items: Slice[GreenElement]) -> Int
  let thenIndex = syntaxTopLevelKeywordIndex(items, 0, "then")
  let arrowIndex = syntaxTopLevelKeywordIndex(items, 0, "=>")
  if thenIndex < 0 then
    arrowIndex
  elsif arrowIndex < 0 then
    thenIndex
  elsif thenIndex < arrowIndex then
    thenIndex
  else
    arrowIndex
  end
end

# syntaxBranchBodyAfter splits a branch region at its header keyword.  Elements
# up to and including the keyword are typed as expression runs; the body region
# becomes one Block node; a trailing `end` closer stays outside the Block.
func syntaxBranchBodyAfter(items: Slice[GreenElement], keywordIndex: Int) -> Slice[GreenElement]
  if keywordIndex < 0 then
    syntaxTypeExpressionRuns(items)
  else
    let bodyStart = keywordIndex + 1
    let bodyEnd = syntaxTrailingEndIndex(items, bodyStart)
    joinGreenElements(
      joinGreenElements(
        syntaxTypeExpressionRuns(greenElementSliceOrEmpty(items, 0, bodyStart)),
        syntaxBranchBodyBlock(greenElementSliceOrEmpty(items, bodyStart, bodyEnd))
      ),
      greenElementSliceOrEmpty(items, bodyEnd, items.Len())
    )
  end
end

# syntaxTopLevelKeywordIndex returns the index of the first token at the top
# level of the region whose raw text equals keyword, or -1.  Nodes never match,
# so a nested block's keyword is never mistaken for the branch header.
func syntaxTopLevelKeywordIndex(items: Slice[GreenElement], index: Int, keyword: String) -> Int
  if index >= items.Len() then
    -1
  elsif greenElementRaw(greenElementAt(items, index)) == keyword then
    index
  else
    syntaxTopLevelKeywordIndex(items, index + 1, keyword)
  end
end

# syntaxTrailingEndIndex returns the index of a trailing `end` closer in the
# region from `from` to the end, skipping trivia.  A then-form case keeps its
# own `end` as a sibling of the body Block; every other branch reports the
# region end.
func syntaxTrailingEndIndex(items: Slice[GreenElement], from: Int) -> Int
  let last = syntaxLastTokenIndex(items, items.Len() - 1)
  if last >= from && greenElementRaw(greenElementAt(items, last)) == "end" then last else items.Len() end
end

# syntaxBranchBodyBlock wraps a statement region into one Block node.  The block
# owns every byte of the region, including the trivia between statements, so no
# source byte is dropped and replay stays byte-exact.  The leading trivia before
# the first statement stays a sibling of the Block so the Block's own range
# starts at the first statement token, matching the legacy parser whose body
# block begins after the header keyword's trailing trivia.
func syntaxBranchBodyBlock(items: Slice[GreenElement]) -> Slice[GreenElement]
  if items.Len() == 0 then
    []
  else
    let bodyStart = syntaxNextTokenIndex(items, 0)
    if bodyStart <= 0 then
      [GreenElement.NodeElement(Ref.new(GreenNode {
        Kind: GreenNodeKind.Block,
        Span: greenElementSliceSpan(items, 0, items.Len()),
        Children: functionBodyStatements(items),
        HasError: false,
      }))]
    else
      joinGreenElements(greenElementSliceOrEmpty(items, 0, bodyStart), [GreenElement.NodeElement(Ref.new(GreenNode {
        Kind: GreenNodeKind.Block,
        Span: greenElementSliceSpan(items, bodyStart, items.Len()),
        Children: functionBodyStatements(greenElementSliceOrEmpty(items, bodyStart, items.Len())),
        HasError: false,
      }))])
    end
  end
end

func nextBranchStart(blockKind: GreenNodeKind, items: Slice[GreenElement], index: Int) -> Int
  if index >= items.Len() then
    -1
  else
    switch items.Get(index)
      case Some(item) then
        if branchKind(blockKind, greenElementRaw(item)) != GreenNodeKind.Error || greenElementBranchKind(blockKind, item) != GreenNodeKind.Error then
          index
        else
          nextBranchStart(blockKind, items, index + 1)
        end
      end
      case None => -1
    end
  end
end

func branchKind(blockKind: GreenNodeKind, raw: String) -> GreenNodeKind
  if blockKind == GreenNodeKind.IfBlock && raw == "elsif" then
    GreenNodeKind.ElsifBranch
  elsif blockKind == GreenNodeKind.IfBlock && raw == "else" then
    GreenNodeKind.ElseBranch
  elsif blockKind == GreenNodeKind.SwitchBlock && raw == "case" then
    GreenNodeKind.CaseBranch
  else
    GreenNodeKind.Error
  end
end

func greenListToSlice(items: Option[List[GreenElement]]) -> Slice[GreenElement]
  greenListToSliceInto(items, [])
end

# caseBranchChildren turns the header region of one `case` branch into a
# concrete pattern node.  The branch's own children begin with the `case`
# keyword; the pattern runs from the token after it up to the header terminator
# (`then` or `=>`).  A non-pattern branch (recovery text) keeps its raw leaves.
func caseBranchChildren(items: Slice[GreenElement]) -> Slice[GreenElement]
  let keyword = syntaxNextTokenIndex(items, 0)
  if keyword < 0 then
    items
  else
    let headerStart = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: keyword + 1 })
    let parsed = parsePattern(headerStart)
    switch parsed.Node
      case Some(node) then
        joinGreenElements(
          greenElementSliceOrEmpty(items, 0, headerStart.Index),
          joinGreenElements(
            [GreenElement.NodeElement(node)],
            greenElementSliceOrEmpty(items, parsed.Cursor.Index, items.Len())
          )
        )
      end
      case None => items
    end
  end
end

# declarationPatternItems parses one `let`/`var` binding pattern starting at
# index.  A tuple pattern owns its parenthesized group, so the returned Next is
# the first element after the pattern range.
func declarationPatternItems(items: Slice[GreenElement], index: Int) -> DeclarationPatternResult
  let parsed = parsePattern(SyntaxCursor { Elements: items, Index: index })
  switch parsed.Node
    case Some(node) => DeclarationPatternResult { Element: GreenElement.NodeElement(node), Next: parsed.Cursor.Index }
    case None => DeclarationPatternResult {
      Element: GreenElement.NodeElement(Ref.new(GreenNode { Kind: GreenNodeKind.BindPattern, Span: greenElementSpan(greenElementAt(items, index)), Children: [greenElementAt(items, index)], HasError: false })),
      Next: index + 1,
    }
  end
end

func greenListToSliceInto(items: Option[List[GreenElement]], output: Slice[GreenElement]) -> Slice[GreenElement]
  switch items
    case None => output
    case Some(list) => greenListToSliceInto(list.Tail(), output.Append(list.Head()))
  end
end

func joinGreenElements(left: Slice[GreenElement], right: Slice[GreenElement]) -> Slice[GreenElement]
  greenListToSlice(greenSliceToList(left, greenSliceToList(right, None)))
end

func greenSliceToList(items: Slice[GreenElement], tail: Option[List[GreenElement]]) -> Option[List[GreenElement]]
  if items.Len() == 0 then
    tail
  else
    switch items.Get(0)
      case Some(head) => Some(List.Cons(head, greenSliceToList(greenElementTail(items), tail)))
      case None => tail
    end
  end
end

func greenElementTail(items: Slice[GreenElement]) -> Slice[GreenElement]
  switch items.Slice(1, items.Len())
    case Some(tail) => tail
    case None => []
  end
end

func sourceSliceOrEOF(input: String, start: Int, finish: Int) -> String
  switch input.Slice(start, finish)
    case Some(value) => value
    case None => ""
  end
end

func greenElementRaw(item: GreenElement) -> String
  switch item
    case TokenElement(token) => token.Raw
    case TriviaElement(trivia) => trivia.Raw
    case NodeElement(_) => ""
  end
end

func delimiterClose(raw: String) -> String
  if raw == "(" then
    ")"
  elsif raw == "[" then
    "]"
  elsif raw == "{" then
    "}"
  else
    ""
  end
end

func delimiterKind(raw: String) -> String
  if raw == "(" then
    "paren-group"
  elsif raw == "[" then
    "bracket-group"
  elsif raw == "{" then
    "brace-group"
  else
    ""
  end
end

func keywordBlockClose(raw: String) -> String
  if raw == "if" || raw == "switch" || raw == "while" then
    "end"
  else
    ""
  end
end

func structuralClose(raw: String) -> String
  let delimiter = delimiterClose(raw)
  if delimiter != "" => delimiter else keywordBlockClose(raw)
end

func structuralIsKeywordBlock(raw: String) -> Bool
  raw == "if" || raw == "switch" || raw == "while"
end

# structuralOpaqueBlockOpen reports a `func` literal or `letrec` whose body is
# closed by its own `end`.  These blocks are not built as keyword-block nodes in
# the delimiter pass, so the enclosing keyword block must skip over them rather
# than adopt their `end` as its own terminator.  A `func` in a type position
# (`func(Int) -> Bool`) opens no block and is excluded.
func structuralOpaqueBlockOpen(items: Slice[GreenElement], index: Int) -> Bool
  let raw = greenElementRaw(greenElementAt(items, index))
  if raw == "letrec" then
    true
  elsif raw == "func" then
    !syntaxFuncIsType(items, index) && syntaxFuncOpensBlock(items, index)
  else
    false
  end
end

# structuralCloseAt reports the terminator that the structural-group builder
# should pair with the token at index.  It mirrors syntaxBlockCloseAt for the
# keyword blocks that can appear while building delimited children: an `if`
# closed by `end` (or by `else` in the single-line `=>` form), and `switch`/
# `while` closed by `end`.  Delimiter groups close on their matching bracket.
func structuralCloseAt(items: Slice[GreenElement], index: Int) -> String
  let raw = greenElementRaw(greenElementAt(items, index))
  if raw == "if" then
    # A `then`-form if is closed by `end`; an arrow-form if has no `end`, so it
    # is bounded by the surrounding statement boundary instead.
    if syntaxHeaderKeyword(items, index, "=>") then structuralStatementClose() else "end" end
  elsif raw == "switch" || raw == "while" then
    "end"
  elsif raw == "case" then
    # A `case pat then` arm owns its own `end`, so it opens a nested
    # structural block; a `case pat =>` arm has no terminator of its own and is
    # split from its siblings by branch boundaries instead.
    if syntaxHeaderKeyword(items, index, "=>") then "" else "end" end
  else
    delimiterClose(raw)
  end
end

# structuralStatementClose is the synthetic terminator for an arrow-form
# `if cond => then else elseBody`.  It is never a real token, so it only
# matches the statement-boundary rule below rather than a closer leaf.
func structuralStatementClose() -> String
  "@stmt@"
end

func structuralIsStatementClose(raw: String) -> Bool
  raw == structuralStatementClose()
end

# structuralTerminatesStatement reports whether the element ends an arrow-form
# if body: the first newline trivia, a top-level separator, or the enclosing
# delimiter.  Nested delimiter groups and keyword blocks are already owned by
# their own recursion and are therefore not seen at this level.
func structuralTerminatesStatement(item: GreenElement) -> Bool
  if greenElementIsTrivia(item) then
    strings.Contains(greenElementRaw(item), "\n")
  else
    let raw = greenElementRaw(item)
    raw == "," || raw == ")" || raw == "]" || raw == "}"
  end
end

func structuralKind(raw: String) -> GreenNodeKind
  if raw == "(" then
    GreenNodeKind.ParenGroup
  elsif raw == "[" then
    GreenNodeKind.BracketGroup
  elsif raw == "{" then
    GreenNodeKind.BraceGroup
  elsif raw == "if" then
    GreenNodeKind.IfBlock
  elsif raw == "switch" then
    GreenNodeKind.SwitchBlock
  elsif raw == "case" then
    GreenNodeKind.CaseBranch
  else
    GreenNodeKind.WhileBlock
  end
end

# syntaxTypeExpressionRuns is the task-3.8 post-recovery typing pass.  Keyword
# block regions arrive as raw leaves because recovery keeps bytes rather than
# structure.  This pass replaces each maximal run of non-boundary elements with
# the expression node that parseExpr builds, but only when that parse consumes
# the whole run; a run that does not parse stays as raw leaves so no source byte
# is dropped and diagnostics remain intact.
func syntaxTypeExpressionRuns(items: Slice[GreenElement]) -> Slice[GreenElement]
  syntaxTypeRunsFrom(items, 0, [])
end

func syntaxTypeRunsFrom(items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  elsif syntaxElementIsRunBoundary(greenElementAt(items, index)) then
    syntaxTypeRunsFrom(items, index + 1, output.Append(greenElementAt(items, index)))
  else
    let finish = syntaxRunEnd(items, index)
    syntaxTypeRunsFrom(items, finish, joinGreenElements(output, syntaxTypeOneRun(items, index, finish)))
  end
end

func syntaxRunEnd(items: Slice[GreenElement], index: Int) -> Int
  if index >= items.Len() then
    index
  elsif syntaxElementIsRunBoundary(greenElementAt(items, index)) then
    index
  else
    syntaxRunEnd(items, index + 1)
  end
end

# syntaxElementIsRunBoundary decides where an expression run stops.  A newline
# trivia separates statements; a block keyword separates header/body/branch
# slots; a branch or nested-block node owns its own range.  A typed pattern or
# type node is already a semantic child, so it also ends a run rather than being
# re-wrapped as an expression atom.
func syntaxElementIsRunBoundary(item: GreenElement) -> Bool
  if greenElementIsTrivia(item) then
    strings.Contains(greenElementRaw(item), "\n")
  else
    switch greenElementNode(item)
      case Some(node) => syntaxNodeIsRunBoundary(node.value().Kind)
      case None => syntaxRawIsBlockKeyword(greenElementRaw(item))
    end
  end
end

func syntaxNodeIsRunBoundary(kind: GreenNodeKind) -> Bool
  greenNodeIsPatternKind(kind) || greenNodeIsTypeKind(kind) || kind == GreenNodeKind.ElsifBranch || kind == GreenNodeKind.ElseBranch || kind == GreenNodeKind.CaseBranch || kind == GreenNodeKind.IfBlock || kind == GreenNodeKind.SwitchBlock || kind == GreenNodeKind.WhileBlock || kind == GreenNodeKind.Block || kind == GreenNodeKind.ExprStatement || kind == GreenNodeKind.LetStatement || kind == GreenNodeKind.VarStatement || kind == GreenNodeKind.TupleLetStatement || kind == GreenNodeKind.AssignStatement || kind == GreenNodeKind.ReturnStatement || kind == GreenNodeKind.BreakStatement || kind == GreenNodeKind.ContinueStatement || kind == GreenNodeKind.LetRecStatement || kind == GreenNodeKind.Error || kind == GreenNodeKind.Declaration
end

func syntaxRawIsBlockKeyword(raw: String) -> Bool
  raw == "if" || raw == "elsif" || raw == "else" || raw == "then" || raw == "=>" || raw == "case" || raw == "switch" || raw == "while" || raw == "end"
end

# syntaxRawIsStatementKeyword reports the leading keywords that introduce a
# non-expression statement.  The block splitter selects the statement form from
# the run's first token, so these must stay raw until that pass runs.
func syntaxRawIsStatementKeyword(raw: String) -> Bool
  raw == "let" || raw == "var" || raw == "return" || raw == "break" || raw == "continue" || raw == "letrec"
end

func syntaxTypeOneRun(items: Slice[GreenElement], start: Int, finish: Int) -> Slice[GreenElement]
  let lead = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: start })
  if lead.Index >= finish then
    greenElementSliceOrEmpty(items, start, finish)
  elsif syntaxRawIsStatementKeyword(greenElementRaw(greenElementAt(items, lead.Index))) then
    # A run that starts with a statement keyword (`let`/`var`/`return`/
    # `break`/`continue`/`letrec`) belongs to the statement pass, not the
    # expression pass.  Typing it here would freeze the leading keyword as an
    # identifier atom and hide the statement form from the block splitter.
    greenElementSliceOrEmpty(items, start, finish)
  else
    let parsed = parseExpr(lead)
    switch parsed.Node
      case Some(node) then
        if parsed.Cursor.Index <= finish && syntaxElementsAllTrivia(items, parsed.Cursor.Index, finish) then
          joinGreenElements(
            joinGreenElements(greenElementSliceOrEmpty(items, start, lead.Index), [GreenElement.NodeElement(node)]),
            greenElementSliceOrEmpty(items, parsed.Cursor.Index, finish)
          )
        else
          greenElementSliceOrEmpty(items, start, finish)
        end
      end
      case None => greenElementSliceOrEmpty(items, start, finish)
    end
  end
end

func syntaxElementsAllTrivia(items: Slice[GreenElement], index: Int, finish: Int) -> Bool
  if index >= finish then
    true
  elsif greenElementIsTrivia(greenElementAt(items, index)) then
    syntaxElementsAllTrivia(items, index + 1, finish)
  else
    false
  end
end

# functionBodyChildren wraps a block-body function's statements into one Block
# node so lowering can consume them.  The func's own closer is the last token;
# an arrow-form function has no closer and keeps its initializer child, so it is
# returned unchanged.  Every body byte stays owned by the Block, which is why
# the region excludes only the signature nodes and the final end.
func functionBodyChildren(items: Slice[GreenElement]) -> Slice[GreenElement]
  let endIndex = syntaxLastTokenIndex(items, items.Len() - 1)
  if endIndex < 0 || greenElementRaw(greenElementAt(items, endIndex)) != "end" then
    items
  else
    let signatureEnd = functionSignatureEnd(items, 0, 0)
    let start = if signatureEnd >= endIndex then endIndex else syntaxNextTokenIndex(items, signatureEnd) end
    if start < 0 || start >= endIndex then
      items
    else
      let block = GreenElement.NodeElement(Ref.new(GreenNode {
        Kind: GreenNodeKind.Block,
        Span: greenElementSliceSpan(items, start, endIndex),
        Children: functionBodyStatements(greenElementSliceOrEmpty(items, start, endIndex)),
        HasError: false,
      }))
      joinGreenElements(
        joinGreenElements(greenElementSliceOrEmpty(items, 0, start), [block]),
        greenElementSliceOrEmpty(items, endIndex, items.Len())
      )
    end
  end
end

# functionSignatureEnd returns the index just after the leading signature child
# (parameters, return type, constraints, or type parameters), so the body
# region begins after the whole signature.  It stops at the first token that is
# not part of the signature: a nested function literal's return type appears
# later in the same leaf run, and scanning it would push the body start past the
# nested literal's opening, stranding its `end` outside the body block.
func functionSignatureEnd(items: Slice[GreenElement], index: Int, seen: Int) -> Int
  if index >= items.Len() then
    seen
  elsif functionElementIsSignature(greenElementAt(items, index)) then
    functionSignatureEnd(items, index + 1, index + 1)
  elsif seen == 0 || greenElementIsTrivia(greenElementAt(items, index)) then
    functionSignatureEnd(items, index + 1, seen)
  else
    seen
  end
end

func functionElementIsSignature(item: GreenElement) -> Bool
  switch greenElementNode(item)
    case Some(node) => functionKindIsSignature(node.value().Kind)
    case None => false
  end
end

func functionKindIsSignature(kind: GreenNodeKind) -> Bool
  kind == GreenNodeKind.FunctionParameters || kind == GreenNodeKind.FunctionReturnType || kind == GreenNodeKind.Constraints || kind == GreenNodeKind.TypeParameters
end

# functionBodyStatements splits a body region on newline trivia and turns each
# statement run into an ExprStatement node.  A run that is not a single
# expression and does not parse as one stays as raw leaves, so multi-statement
# lowering can extend this in the next task without losing any byte.
func functionBodyStatements(items: Slice[GreenElement]) -> Slice[GreenElement]
  functionBodyStatementsFrom(items, 0, [])
end

func functionBodyStatementsFrom(items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  elsif greenElementIsTrivia(greenElementAt(items, index)) then
    functionBodyStatementsFrom(items, index + 1, output.Append(greenElementAt(items, index)))
  else
    let finish = syntaxStatementFinish(items, index)
    functionBodyStatementsFrom(items, finish, joinGreenElements(output, syntaxStatementNode(items, index, finish)))
  end
end

# syntaxStatementFinish extends the newline-based statement boundary for a
# letrec statement, whose body spans several lines up to its matching end.  The
# inner binding lines are grouped by syntaxLetRecChildren, so the whole region
# must be claimed as one statement before the newline splitter sees it.
func syntaxStatementFinish(items: Slice[GreenElement], index: Int) -> Int
  if greenElementRaw(greenElementAt(items, index)) == "letrec" then
    syntaxLetRecStatementEnd(items, index + 1, 1)
  else
    syntaxStatementEndBlockAware(items, index)
  end
end

# syntaxStatementEndBlockAware extends the newline statement boundary over any
# function literal that opens a block.  A `func` literal body spans lines and is
# not yet a nested node at the block level, so its interior newlines must not
# finish the statement early; the scan jumps past the literal's matching `end`.
# Keyword blocks (`if`/`switch`/`while`) are already nested nodes here, so their
# newlines are never seen.
func syntaxStatementEndBlockAware(items: Slice[GreenElement], index: Int) -> Int
  if index >= items.Len() then
    index
  elsif greenElementIsTrivia(greenElementAt(items, index)) && strings.Contains(greenElementRaw(greenElementAt(items, index)), "\n") then
    if syntaxLineEndsWithContinuation(items, index) then syntaxStatementEndBlockAware(items, index + 1) else index end
  elsif greenElementRaw(greenElementAt(items, index)) == "func" && syntaxFuncOpensBlock(items, index) then
    let close = funcLitBodyEnd(items, index + 1, 0)
    if close < 0 then items.Len() else syntaxStatementEndBlockAware(items, close + 1) end
  else
    syntaxStatementEndBlockAware(items, index + 1)
  end
end

func syntaxLetRecStatementEnd(items: Slice[GreenElement], index: Int, depth: Int) -> Int
  if index >= items.Len() then
    index
  else
    let raw = greenElementRaw(greenElementAt(items, index))
    if raw == "letrec" then
      syntaxLetRecStatementEnd(items, index + 1, depth + 1)
    elsif raw == "end" then
      if depth <= 1 then index + 1 else syntaxLetRecStatementEnd(items, index + 1, depth - 1) end
    else
      syntaxLetRecStatementEnd(items, index + 1, depth)
    end
  end
end

# syntaxStatementEnd returns the index of the newline trivia that ends the
# statement beginning at index, or the region end when none follows.
func syntaxStatementEnd(items: Slice[GreenElement], index: Int) -> Int
  if index >= items.Len() then
    index
  elsif greenElementIsTrivia(greenElementAt(items, index)) && strings.Contains(greenElementRaw(greenElementAt(items, index)), "\n") then
    if syntaxLineEndsWithContinuation(items, index) then syntaxStatementEnd(items, index + 1) else index end
  else
    syntaxStatementEnd(items, index + 1)
  end
end

# syntaxLineEndsWithContinuation reports whether the line that ends at the
# newline trivia `index` finishes with a binary operator, so the statement
# continues onto the following line.  A single-expression body such as
# `a &&\n  b` has no enclosing delimiter to own the break, so the trailing
# operator is what keeps the two lines in one statement run.
func syntaxLineEndsWithContinuation(items: Slice[GreenElement], index: Int) -> Bool
  let prev = syntaxPrevTokenIndex(items, index - 1)
  if prev < 0 then false else syntaxRawContinuesExpression(greenElementRaw(greenElementAt(items, prev))) end
end

# syntaxPrevTokenIndex returns the nearest non-trivia index at or before
# `index`, or -1 when only trivia precedes it.
func syntaxPrevTokenIndex(items: Slice[GreenElement], index: Int) -> Int
  if index < 0 then
    -1
  elsif greenElementIsTrivia(greenElementAt(items, index)) then
    syntaxPrevTokenIndex(items, index - 1)
  else
    index
  end
end

# syntaxRawContinuesExpression lists the binary and pipe operators whose
# presence at end of line means the right operand is on the next line.
func syntaxRawContinuesExpression(raw: String) -> Bool
  raw == "&&" || raw == "||" || raw == "|>" || raw == "<|" || raw == "+" || raw == "-" || raw == "*" || raw == "/" || raw == "==" || raw == "!=" || raw == "<=" || raw == ">=" || raw == "<" || raw == ">"
end

func syntaxStatementNode(items: Slice[GreenElement], start: Int, finish: Int) -> Slice[GreenElement]
  switch syntaxStatementKeyword(items, start, finish)
    case Some(keyword) => switch keyword
      case "let" => syntaxLetStatementNode(items, start, finish)
      case "var" => syntaxVarStatementNode(items, start, finish)
      case "return" => syntaxReturnStatementNode(items, start, finish)
      case "break" => syntaxLeafStatementNode(items, start, finish, GreenNodeKind.BreakStatement)
      case "continue" => syntaxLeafStatementNode(items, start, finish, GreenNodeKind.ContinueStatement)
      case "letrec" => syntaxLetRecStatementNode(items, start, finish)
      case _ => syntaxExprStatementNode(items, start, finish)
    end
    case None => syntaxExprStatementNode(items, start, finish)
  end
end

# syntaxStatementKeyword reports the leading keyword of a statement run when
# that keyword introduces a non-expression statement.  The run's first token is
# the only token that can select the statement form, so trivia is skipped once
# and a leading identifier is never confused with a nested expression.
func syntaxStatementKeyword(items: Slice[GreenElement], start: Int, finish: Int) -> Option[String]
  let lead = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: start })
  if lead.Index >= finish then
    None
  else
    switch greenElementNode(greenElementAt(items, lead.Index))
      case Some(_) => None
      case None then
        let raw = greenElementRaw(greenElementAt(items, lead.Index))
        if raw == "let" || raw == "var" || raw == "return" || raw == "break" || raw == "continue" || raw == "letrec" then Some(raw) else None end
      end
    end
  end
end

func syntaxExprStatementNode(items: Slice[GreenElement], start: Int, finish: Int) -> Slice[GreenElement]
  let lead = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: start })
  if lead.Index >= finish then
    greenElementSliceOrEmpty(items, start, finish)
  elsif syntaxRunHasValueInitializer(items, lead.Index, finish) then
    syntaxAssignStatementNode(items, start, finish)
  elsif syntaxRunAssignmentIndex(items, lead.Index, finish, 0) >= 0 then
    # A statement run nested in a branch/loop body is still raw leaves, so no
    # ValueInitializer was frozen by a declaration pass.  The top-level `=` is
    # synthesized into one here instead of being left as raw tokens.
    syntaxAssignStatementNodeRaw(items, start, finish)
  else
    switch syntaxStatementSingleExpression(items, lead.Index, finish)
      case Some(node) => syntaxExprStatementElement(items, start, finish, lead.Index, node, lead.Index + 1)
      case None then
        let parsed = parseExpr(lead)
        switch parsed.Node
          case Some(node) then
            if parsed.Cursor.Index <= finish && syntaxElementsAllTrivia(items, parsed.Cursor.Index, finish) then
              syntaxExprStatementElement(items, start, finish, lead.Index, node, parsed.Cursor.Index)
            else
              greenElementSliceOrEmpty(items, start, finish)
            end
          end
          case None => greenElementSliceOrEmpty(items, start, finish)
        end
      end
    end
  end
end

func syntaxRunHasValueInitializer(items: Slice[GreenElement], index: Int, finish: Int) -> Bool
  if index >= finish then
    false
  elsif syntaxElementOpensFuncBlock(items, index) then
    # A func literal still contributes raw leaves here, so its own body
    # initializers must not count as this run's assignment initializer.
    let close = funcLitBodyEnd(items, index + 1, 0)
    if close < 0 then false else syntaxRunHasValueInitializer(items, close + 1, finish) end
  else
    switch greenElementNode(greenElementAt(items, index))
      case Some(child) => if child.value().Kind == GreenNodeKind.ValueInitializer then true else syntaxRunHasValueInitializer(items, index + 1, finish) end
      case None => syntaxRunHasValueInitializer(items, index + 1, finish)
    end
  end
end

# syntaxElementOpensFuncBlock reports a func leaf that owns an end block,
# distinguishing a func literal from a func type in a type position.
func syntaxElementOpensFuncBlock(items: Slice[GreenElement], index: Int) -> Bool
  greenElementRaw(greenElementAt(items, index)) == "func" && !syntaxFuncIsType(items, index) && syntaxFuncOpensBlock(items, index)
end

# syntaxAssignStatementNode freezes an assignment run as an AssignStatement.
# The declaration pass already froze the right-hand initializer, so the target
# is the expression parsed from the run's leading token; the gap and the
# initializer keep their bytes so lowering reads two typed operands in order.
func syntaxAssignStatementNode(items: Slice[GreenElement], start: Int, finish: Int) -> Slice[GreenElement]
  let lead = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: start })
  let initializer = syntaxValueInitializerIndex(items, lead.Index, finish)
  if initializer < 0 then
    greenElementSliceOrEmpty(items, start, finish)
  else
    let parsed = parseExpr(lead)
    switch parsed.Node
      case Some(node) then
        if parsed.Cursor.Index <= initializer && syntaxElementsAllTrivia(items, parsed.Cursor.Index, initializer) then
          syntaxStatementElement(items, start, finish, GreenNodeKind.AssignStatement, joinGreenElements(
            joinGreenElements(greenElementSliceOrEmpty(items, start, lead.Index), [GreenElement.NodeElement(node)]),
            greenElementSliceOrEmpty(items, parsed.Cursor.Index, finish)
          ))
        else
          greenElementSliceOrEmpty(items, start, finish)
        end
      end
      case None => greenElementSliceOrEmpty(items, start, finish)
    end
  end
end

func syntaxValueInitializerIndex(items: Slice[GreenElement], index: Int, finish: Int) -> Int
  if index >= finish then
    -1
  else
    switch greenElementNode(greenElementAt(items, index))
      case Some(child) => if child.value().Kind == GreenNodeKind.ValueInitializer then index else syntaxValueInitializerIndex(items, index + 1, finish) end
      case None => syntaxValueInitializerIndex(items, index + 1, finish)
    end
  end
end

# syntaxRunAssignmentIndex returns the index of the top-level `=` token that
# makes a raw statement run an assignment, or -1 when the run has none.  The
# scan tracks delimiter depth so an `=` inside a call or collection literal is
# never mistaken for the assignment operator, and it jumps over function
# literal bodies the same way syntaxRunHasValueInitializer does.
func syntaxRunAssignmentIndex(items: Slice[GreenElement], index: Int, finish: Int, depth: Int) -> Int
  if index >= finish then
    -1
  elsif syntaxElementOpensFuncBlock(items, index) then
    let close = funcLitBodyEnd(items, index + 1, 0)
    if close < 0 then -1 else syntaxRunAssignmentIndex(items, close + 1, finish, depth) end
  else
    switch greenElementNode(greenElementAt(items, index))
      case Some(_) => syntaxRunAssignmentIndex(items, index + 1, finish, depth)
      case None then
        let raw = greenElementRaw(greenElementAt(items, index))
        if raw == "(" || raw == "[" || raw == "{" then
          syntaxRunAssignmentIndex(items, index + 1, finish, depth + 1)
        elsif raw == ")" || raw == "]" || raw == "}" then
          if depth <= 0 then syntaxRunAssignmentIndex(items, index + 1, finish, 0) else syntaxRunAssignmentIndex(items, index + 1, finish, depth - 1) end
        elsif depth == 0 && raw == "=" then
          index
        else
          syntaxRunAssignmentIndex(items, index + 1, finish, depth)
        end
      end
    end
  end
end

# syntaxAssignStatementNodeRaw freezes a raw assignment run as an
# AssignStatement.  The target is the expression parsed from the run's leading
# token and the value initializer is synthesized from the `=` token and the
# expression that follows it, so lowering reads the same two typed operands it
# reads for an assignment whose initializer a declaration pass already froze.
# A run whose target or value does not consume exactly up to the `=`/region end
# stays as raw leaves so no byte is dropped.
func syntaxAssignStatementNodeRaw(items: Slice[GreenElement], start: Int, finish: Int) -> Slice[GreenElement]
  let lead = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: start })
  let eq = syntaxRunAssignmentIndex(items, lead.Index, finish, 0)
  if eq < 0 then
    greenElementSliceOrEmpty(items, start, finish)
  else
    let parsedLhs = parseExpr(lead)
    switch parsedLhs.Node
      case Some(lhsNode) then
        if parsedLhs.Cursor.Index > eq || !syntaxElementsAllTrivia(items, parsedLhs.Cursor.Index, eq) then
          greenElementSliceOrEmpty(items, start, finish)
        else
          let rhsStart = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: eq + 1 })
          let parsedRhs = parseExpr(rhsStart)
          switch parsedRhs.Node
            case Some(rhsNode) then
              if parsedRhs.Cursor.Index > finish || !syntaxElementsAllTrivia(items, parsedRhs.Cursor.Index, finish) then
                greenElementSliceOrEmpty(items, start, finish)
              else
                let initializer = GreenElement.NodeElement(Ref.new(GreenNode {
                  Kind: GreenNodeKind.ValueInitializer,
                  Span: ps.SourceSpan { Start: greenElementSpan(greenElementAt(items, eq)).Start, End: rhsNode.value().Span.End },
                  Children: joinGreenElements(
                    greenElementSliceOrEmpty(items, eq, rhsStart.Index),
                    [GreenElement.NodeElement(rhsNode)]
                  ),
                  HasError: rhsNode.value().HasError,
                }))
                syntaxStatementElement(items, start, finish, GreenNodeKind.AssignStatement, joinGreenElements(
                  joinGreenElements(
                    greenElementSliceOrEmpty(items, start, lead.Index),
                    [GreenElement.NodeElement(lhsNode)]
                  ),
                  joinGreenElements(
                    greenElementSliceOrEmpty(items, parsedLhs.Cursor.Index, eq),
                    joinGreenElements(
                      [initializer],
                      greenElementSliceOrEmpty(items, parsedRhs.Cursor.Index, finish)
                    )
                  )
                ))
              end
            end
            case None => greenElementSliceOrEmpty(items, start, finish)
          end
        end
      end
      case None => greenElementSliceOrEmpty(items, start, finish)
    end
  end
end

# syntaxStatementElement freezes a statement run as one statement node whose
# span covers the whole run, so the block keeps byte ownership while lowering
# reads the typed children.
func syntaxStatementElement(items: Slice[GreenElement], start: Int, finish: Int, kind: GreenNodeKind, children: Slice[GreenElement]) -> Slice[GreenElement]
  [GreenElement.NodeElement(Ref.new(GreenNode {
    Kind: kind,
    Span: greenElementSliceSpan(items, start, finish),
    Children: children,
    HasError: false,
  }))]
end

# syntaxLetStatementNode / syntaxVarStatementNode freeze a binding statement.
# The name (or tuple pattern) and optional annotation are already typed by the
# declaration passes; this pass reuses the same helpers so a local binding and a
# top-level binding share one CST shape.
func syntaxLetStatementNode(items: Slice[GreenElement], start: Int, finish: Int) -> Slice[GreenElement]
  let body = greenElementSliceOrEmpty(items, start, finish)
  let typed = declarationChildrenWithExpr(declarationChildrenWithName(body, 0, "", []), 0, [])
  let kind = if syntaxLetIsTuplePattern(typed) then GreenNodeKind.TupleLetStatement else GreenNodeKind.LetStatement end
  syntaxStatementElement(items, start, finish, kind, typed)
end

func syntaxVarStatementNode(items: Slice[GreenElement], start: Int, finish: Int) -> Slice[GreenElement]
  let body = greenElementSliceOrEmpty(items, start, finish)
  let typed = declarationChildrenWithExpr(declarationChildrenWithName(body, 0, "", []), 0, [])
  syntaxStatementElement(items, start, finish, GreenNodeKind.VarStatement, typed)
end

# syntaxLetIsTuplePattern reports a destructuring binding whose left-hand side
# is a parenthesized tuple.  The declaration pass types the group as a
# TuplePattern, so the statement kind is chosen from frozen children rather than
# raw text.
func syntaxLetIsTuplePattern(items: Slice[GreenElement]) -> Bool
  syntaxLetIsTuplePatternFrom(items, 0)
end

func syntaxLetIsTuplePatternFrom(items: Slice[GreenElement], index: Int) -> Bool
  if index >= items.Len() then
    false
  else
    switch greenElementNode(greenElementAt(items, index))
      case Some(child) => child.value().Kind == GreenNodeKind.TuplePattern
      case None => syntaxLetIsTuplePatternFrom(items, index + 1)
    end
  end
end

func syntaxReturnStatementNode(items: Slice[GreenElement], start: Int, finish: Int) -> Slice[GreenElement]
  let lead = syntaxCursorSkipTrivia(SyntaxCursor { Elements: items, Index: start })
  let valueStart = syntaxNextTokenIndex(items, lead.Index + 1)
  if valueStart < 0 || valueStart >= finish then
    syntaxStatementElement(items, start, finish, GreenNodeKind.ReturnStatement, greenElementSliceOrEmpty(items, start, finish))
  else
    let parsed = parseExpr(SyntaxCursor { Elements: items, Index: valueStart })
    switch parsed.Node
      case Some(node) then
        if parsed.Cursor.Index <= finish && syntaxElementsAllTrivia(items, parsed.Cursor.Index, finish) then
          syntaxStatementElement(items, start, finish, GreenNodeKind.ReturnStatement, joinGreenElements(
            greenElementSliceOrEmpty(items, start, valueStart),
            joinGreenElements([GreenElement.NodeElement(node)], greenElementSliceOrEmpty(items, parsed.Cursor.Index, finish))
          ))
        else
          syntaxStatementElement(items, start, finish, GreenNodeKind.ReturnStatement, greenElementSliceOrEmpty(items, start, finish))
        end
      end
      case None => syntaxStatementElement(items, start, finish, GreenNodeKind.ReturnStatement, greenElementSliceOrEmpty(items, start, finish))
    end
  end
end

func syntaxLeafStatementNode(items: Slice[GreenElement], start: Int, finish: Int, kind: GreenNodeKind) -> Slice[GreenElement]
  syntaxStatementElement(items, start, finish, kind, greenElementSliceOrEmpty(items, start, finish))
end

# syntaxLetRecStatementNode freezes a letrec statement.  Each binding line is
# grouped into a LetRecBinding node (name, annotation, initializer) and the
# closing end stays a child so the statement owns its whole range.
func syntaxLetRecStatementNode(items: Slice[GreenElement], start: Int, finish: Int) -> Slice[GreenElement]
  let body = greenElementSliceOrEmpty(items, start, finish)
  syntaxStatementElement(items, start, finish, GreenNodeKind.LetRecStatement, syntaxLetRecChildren(body, 0, []))
end

func syntaxLetRecChildren(items: Slice[GreenElement], index: Int, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    let item = greenElementAt(items, index)
    let raw = greenElementRaw(item)
    if greenElementIsTrivia(item) || raw == "letrec" || raw == "end" then
      syntaxLetRecChildren(items, index + 1, output.Append(item))
    else
      let finish = syntaxStatementEnd(items, index)
      syntaxLetRecChildren(items, finish, output.Append(syntaxLetRecBindingNode(items, index, finish)))
    end
  end
end

func syntaxLetRecBindingNode(items: Slice[GreenElement], start: Int, finish: Int) -> GreenElement
  let body = greenElementSliceOrEmpty(items, start, finish)
  GreenElement.NodeElement(Ref.new(GreenNode {
    Kind: GreenNodeKind.LetRecBinding,
    Span: greenElementSliceSpan(items, start, finish),
    Children: declarationChildrenWithExpr(syntaxLetRecBindingHeader(body, 0, false, []), 0, []),
    HasError: false,
  }))
end

# syntaxLetRecBindingHeader wraps the binding name as a BindPattern and leaves
# the annotation and initializer for declarationChildrenWithExpr.  A letrec
# binding has no binding keyword, so the name is the first non-trivia token.
func syntaxLetRecBindingHeader(items: Slice[GreenElement], index: Int, named: Bool, output: Slice[GreenElement]) -> Slice[GreenElement]
  if index >= items.Len() then
    output
  else
    let item = greenElementAt(items, index)
    if !named && !greenElementIsTrivia(item) then
      syntaxLetRecBindingHeader(items, index + 1, true, output.Append(GreenElement.NodeElement(Ref.new(GreenNode {
        Kind: GreenNodeKind.BindPattern,
        Span: greenElementSpan(item),
        Children: [item],
        HasError: false,
      }))))
    else
      syntaxLetRecBindingHeader(items, index + 1, named, output.Append(item))
    end
  end
end

# syntaxStatementSingleExpression reports a run that is one already-typed
# expression node surrounded only by trivia.  Re-parsing such a node would wrap
# it in a spurious Expression node, so it is used directly instead.
func syntaxStatementSingleExpression(items: Slice[GreenElement], index: Int, finish: Int) -> Option[Ref[GreenNode]]
  switch greenElementNode(greenElementAt(items, index))
    case Some(node) then
      if greenNodeIsExpressionKind(node.value().Kind) && syntaxElementsAllTrivia(items, index + 1, finish) then
        Some(node)
      else
        None
      end
    end
    case None => None
  end
end

# syntaxExprStatementElement freezes one statement run as an ExprStatement.  The
# run's leading and trailing trivia stay as its own children, and the parsed
# expression replaces exactly the elements it consumed, so no byte is lost.
func syntaxExprStatementElement(items: Slice[GreenElement], start: Int, finish: Int, leadIndex: Int, node: Ref[GreenNode], parsedEnd: Int) -> Slice[GreenElement]
  [GreenElement.NodeElement(Ref.new(GreenNode {
    Kind: GreenNodeKind.ExprStatement,
    Span: greenElementSliceSpan(items, start, finish),
    Children: joinGreenElements(
      joinGreenElements(greenElementSliceOrEmpty(items, start, leadIndex), [GreenElement.NodeElement(node)]),
      greenElementSliceOrEmpty(items, parsedEnd, finish)
    ),
    HasError: node.value().HasError,
  }))]
end

# structuralBlockChildren builds the child list of a structural group.  A
# delimiter group keeps every inner element, including its own closer.  A
# keyword block instead excludes the closing `end`/`else` leaf from the branch
# ranges so that `elsif`/`else`/`case` branches do not absorb it, then appends
# the terminator as the block's own final child.
func structuralBlockChildren(blockKind: GreenNodeKind, isKeyword: Bool, inner: Slice[GreenElement], closer: GreenElement) -> Slice[GreenElement]
  if blockKind == GreenNodeKind.CaseBranch then
    # A then-form case built its own `end`; parse its pattern header while
    # keeping the closer inside the branch range.
    syntaxBranchBodyChildren(GreenNodeKind.CaseBranch, caseBranchChildren(inner))
  elsif blockKind == GreenNodeKind.IfBlock && syntaxHeaderKeyword(inner, 0, "=>") then
    # An arrow-form if has no branch keywords to split on: `else` is part of
    # its expression, so its leaves stay in source order.  The synthetic
    # statement-boundary closer only fixes the block's end range and is not a
    # real leaf, so it is not appended to the children.
    syntaxTypeExpressionRuns(inner)
  elsif blockKind == GreenNodeKind.IfBlock then
    # A then-form if owns a body region between its header keyword and its
    # first elsif/else branch; wrap it as one Block so multi-statement bodies
    # lower through the statement path, then split the remaining branches.
    joinGreenElements(syntaxIfThenBodyChildren(blockKind, greenElementSliceOrEmpty(inner, 0, inner.Len() - 1)), [closer])
  elsif isKeyword then
    syntaxTypeExpressionRuns(branchChildren(blockKind, greenElementSliceOrEmpty(inner, 0, inner.Len() - 1), 0, [])).Append(closer)
  else
    branchChildren(blockKind, inner, 0, [])
  end
end

# syntaxIfThenBodyChildren types the header of a then-form if and wraps the then
# body region as one Block.  The body runs from just after the header keyword to
# the first elsif/else branch; the branches themselves are split by
# branchChildren so each keeps its own keyword, header, body, and closer.
func syntaxIfThenBodyChildren(blockKind: GreenNodeKind, items: Slice[GreenElement]) -> Slice[GreenElement]
  let thenIndex = syntaxTopLevelKeywordIndex(items, 0, "then")
  if thenIndex < 0 then
    syntaxTypeExpressionRuns(branchChildren(blockKind, items, 0, []))
  else
    let bodyStart = thenIndex + 1
    let bodyEnd = syntaxNextBranchKeywordIndex(blockKind, items, bodyStart)
    joinGreenElements(
      joinGreenElements(
        syntaxTypeExpressionRuns(greenElementSliceOrEmpty(items, 0, bodyStart)),
        syntaxBranchBodyBlock(greenElementSliceOrEmpty(items, bodyStart, bodyEnd))
      ),
      branchChildren(blockKind, greenElementSliceOrEmpty(items, bodyEnd, items.Len()), 0, [])
    )
  end
end

# syntaxNextBranchKeywordIndex returns the index of the next elsif/else/case
# keyword at or after `from`, or the region end when none follows.
func syntaxNextBranchKeywordIndex(blockKind: GreenNodeKind, items: Slice[GreenElement], from: Int) -> Int
  if from >= items.Len() then
    items.Len()
  elsif branchKind(blockKind, greenElementRaw(greenElementAt(items, from))) != GreenNodeKind.Error then
    from
  else
    syntaxNextBranchKeywordIndex(blockKind, items, from + 1)
  end
end

func lexedSourceText(items: Slice[GreenElement]) -> String
  items.Fold("", func(text: String, item: GreenElement) -> String
    switch item
      case TokenElement(token) => text + token.Raw
      case TriviaElement(trivia) => text + trivia.Raw
      case NodeElement(_) => text
    end
  end)
end

func greenNodeText(node: GreenNode) -> String
  node.Children.Fold("", func(text: String, item: GreenElement) -> String
    text + greenElementText(item)
  end)
end

func greenElementText(item: GreenElement) -> String
  switch item
    case TokenElement(token) => token.Raw
    case TriviaElement(trivia) => trivia.Raw
    case NodeElement(node) => greenNodeText(node.value())
  end
end

func lexStep(state: LexerState) -> LexedSource using StringRuneIndex
  let raw = sourceSliceOrEOF(state.Input, state.Index, state.Index + 1)
  if raw == "" then
    LexedSource { Elements: state.Elements, Tokens: state.Tokens, Trivia: state.Trivia }
  else
    let start = lexPosition(state)
    if isSpace(raw) then
      lexWhitespace(lexAdvance(state, raw), start, raw)
    elsif raw == "#" then
      lexComment(lexAdvance(state, raw), start, raw)
    elsif raw == "\"" && tripleQuoteAt(state) then
      lexTripleQuoted(lexAdvance(lexAdvance(lexAdvance(state, raw), raw), raw), start, "\"\"\"")
    elsif raw == "\"" then
      lexQuoted(lexAdvance(state, raw), start, raw, "\"", false)
    elsif raw == "`" then
      lexQuoted(lexAdvance(state, raw), start, raw, "`", false)
    elsif raw == "'" then
      lexQuoted(lexAdvance(state, raw), start, raw, "'", false)
    elsif raw >= "0" && raw <= "9" then
      lexNumber(lexAdvance(state, raw), start, raw)
    elsif isWordChar(raw) then
      lexWord(lexAdvance(state, raw), start, raw)
    else
      lexSymbol(state, start)
    end
  end
end

func lexPosition(state: LexerState) -> ps.Position
  ps.Position { Offset: state.Offset, Line: state.Line, Column: state.Column }
end

func lexAdvance(state: LexerState, raw: String) -> LexerState
  LexerState {
    Input: state.Input,
    Index: state.Index + 1,
    Offset: state.Offset + (raw as Slice[Byte]).Len(),
    Line: if raw == "\n" then state.Line + 1 else state.Line end,
    Column: if raw == "\n" then 1 else state.Column + 1 end,
    Elements: state.Elements,
    Tokens: state.Tokens,
    Trivia: state.Trivia,
  }
end

func lexWhitespace(state: LexerState, start: ps.Position, raw: String) -> LexedSource using StringRuneIndex
  let next = sourceSliceOrEOF(state.Input, state.Index, state.Index + 1)
  if next == "" || !isSpace(next) then
    lexEmitTrivia(state, start, GreenTriviaKind.Whitespace, raw)
  else
    lexWhitespace(lexAdvance(state, next), start, raw + next)
  end
end

func lexComment(state: LexerState, start: ps.Position, raw: String) -> LexedSource using StringRuneIndex
  let next = sourceSliceOrEOF(state.Input, state.Index, state.Index + 1)
  if next == "" || next == "\n" then
    lexEmitTrivia(state, start, GreenTriviaKind.Comment, raw)
  else
    lexComment(lexAdvance(state, next), start, raw + next)
  end
end

func lexWord(state: LexerState, start: ps.Position, raw: String) -> LexedSource using StringRuneIndex
  let next = sourceSliceOrEOF(state.Input, state.Index, state.Index + 1)
  if next == "" || !isWordChar(next) then
    let kind = if isKeyword(raw) then
      GreenTokenKind.Keyword
    elsif raw >= "0" && raw <= "9" then
      GreenTokenKind.Number
    else
      GreenTokenKind.Identifier
    end
    lexEmitToken(state, start, kind, raw)
  else
    lexWord(lexAdvance(state, next), start, raw + next)
  end
end

func lexNumber(state: LexerState, start: ps.Position, raw: String) -> LexedSource using StringRuneIndex
  let next = sourceSliceOrEOF(state.Input, state.Index, state.Index + 1)
  if next == "" || !isNumberChar(next) then
    lexEmitToken(state, start, GreenTokenKind.Number, raw)
  else
    lexNumber(lexAdvance(state, next), start, raw + next)
  end
end

func isNumberChar(raw: String) -> Bool
  isWordChar(raw) || raw == "."
end

func tripleQuoteAt(state: LexerState) -> Bool
  sourceSliceOrEOF(state.Input, state.Index, state.Index + 3) == "\"\"\""
end

func lexTripleQuoted(state: LexerState, start: ps.Position, raw: String) -> LexedSource using StringRuneIndex
  if tripleQuoteAt(state) then
    let quote = "\""
    lexEmitToken(lexAdvance(lexAdvance(lexAdvance(state, quote), quote), quote), start, GreenTokenKind.TripleStringLiteral, raw + "\"\"\"")
  else
    let next = sourceSliceOrEOF(state.Input, state.Index, state.Index + 1)
    if next == "" then
      lexEmitToken(state, start, GreenTokenKind.TripleStringLiteral, raw)
    else
      lexTripleQuoted(lexAdvance(state, next), start, raw + next)
    end
  end
end

func lexQuoted(state: LexerState, start: ps.Position, raw: String, quote: String, escaped: Bool) -> LexedSource using StringRuneIndex
  let next = sourceSliceOrEOF(state.Input, state.Index, state.Index + 1)
  if next == "" then
    lexEmitToken(
      state,
      start,
      if quote == "`" then
        GreenTokenKind.RawStringLiteral
      elsif quote == "'" then
        GreenTokenKind.RuneLiteral
      else
        GreenTokenKind.StringLiteral
      end,
      raw
    )
  elsif next == quote && !escaped then
    let kind = if quote == "`" then
      GreenTokenKind.RawStringLiteral
    elsif quote == "'" then
      GreenTokenKind.RuneLiteral
    else
      GreenTokenKind.StringLiteral
    end
    lexEmitToken(lexAdvance(state, next), start, kind, raw + next)
  else
    let nextEscaped = if quote == "`" then
      false
    elsif escaped then
      false
    else
      next == "\\"
    end
    lexQuoted(lexAdvance(state, next), start, raw + next, quote, nextEscaped)
  end
end

func lexSymbol(state: LexerState, start: ps.Position) -> LexedSource using StringRuneIndex
  let two = sourceSliceOrEOF(state.Input, state.Index, state.Index + 2)
  let multi = if isMultiSymbol(two) => two else ""
  if multi == "" then
    let raw = sourceSliceOrEOF(state.Input, state.Index, state.Index + 1)
    lexEmitToken(lexAdvance(state, raw), start, GreenTokenKind.Symbol, raw)
  else
    let first = sourceSliceOrEOF(multi, 0, 1)
    let second = sourceSliceOrEOF(multi, 1, 2)
    lexEmitToken(lexAdvance(lexAdvance(state, first), second), start, GreenTokenKind.Symbol, multi)
  end
end

func isMultiSymbol(raw: String) -> Bool
  raw == "=>" || raw == "->" || raw == "==" || raw == "!=" || raw == ">=" || raw == "<=" ||
    raw == "&&" || raw == "||" || raw == "|>" || raw == "<|" || raw == "::" || raw == ".."
end

func lexEmitToken(state: LexerState, start: ps.Position, kind: GreenTokenKind, raw: String) -> LexedSource
  let item = GreenToken { Kind: kind, Raw: raw, Span: ps.SourceSpan { Start: start, End: lexPosition(state) } }
  lexStep(LexerState {
    Input: state.Input, Index: state.Index, Offset: state.Offset, Line: state.Line, Column: state.Column,
    Elements: state.Elements.Append(GreenElement.TokenElement(item)), Tokens: state.Tokens.Append(item), Trivia: state.Trivia,
  })
end

func lexEmitTrivia(state: LexerState, start: ps.Position, kind: GreenTriviaKind, raw: String) -> LexedSource
  let item = GreenTrivia { Kind: kind, Raw: raw, Span: ps.SourceSpan { Start: start, End: lexPosition(state) } }
  lexStep(LexerState {
    Input: state.Input, Index: state.Index, Offset: state.Offset, Line: state.Line, Column: state.Column,
    Elements: state.Elements.Append(GreenElement.TriviaElement(item)), Tokens: state.Tokens, Trivia: state.Trivia.Append(item),
  })
end
