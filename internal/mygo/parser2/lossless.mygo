package parser2

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import ps "github.com/mygo-lang/mygo/lib/text/parsec"

struct LosslessFile
  AST: ast2.File
  Tokens: Slice[ps.PositionedToken]
  Trivia: Slice[ps.PositionedTrivia]
  NodeSpans: Slice[NodeSpan]
  Delimited: Slice[DelimitedSpan]
  LayoutEvents: Slice[LayoutEvent]
end

struct DelimitedSpan
  Kind: String
  Span: ast2.SourceSpan
  Items: Slice[ast2.SourceSpan]
  Separators: Slice[ast2.SourceSpan]
end

struct Spanned[A]
  Value: A
  Span: ast2.SourceSpan
end

struct NodeSpan
  Path: Slice[Int]
  Kind: String
  Span: ast2.SourceSpan
end

struct LayoutEvent
  Kind: String
  Path: Slice[Int]
  Depth: Int
  Span: ast2.SourceSpan
  Anchor: ast2.SourceSpan
  BodyAnchor: ast2.SourceSpan
  BlockBodyAnchor: ast2.SourceSpan
  BodyLayout: String
  AffectsIndent: Bool
  ExpandsAfter: Bool
  HeaderForm: String
  SeparatorAnchor: ast2.SourceSpan
  ExitAnchor: ast2.SourceSpan
  HeaderLine: Int
  BodyLine: Int
  ExitLine: Int
end

func LosslessDeclarationCount(file: LosslessFile) -> Int
  file.AST.Decls.Len()
end

func LosslessProtectedLines(file: LosslessFile) -> Slice[Int]
  # Only whole constructs that must stay byte-verbatim are protected by line:
  # comments, triple-quoted strings, and backtick raw strings.  An ordinary
  # single-line `"…"`/`'…'` literal is NOT protected here - protecting its whole
  # line would freeze a row the formatter is free to reflow (for example a long
  # struct literal that wraps), and it is unnecessary: the renderer protects the
  # literal's interior while normalizing the surrounding code.
  joinProtectedLines(joinProtectedLines(protectedTriviaLines(file.Trivia, 0), tripleQuotedLines(file.Tokens, 0)), pairedQuotedLines(file.Tokens, "`", 0))
end

func tripleQuotedLines(tokens: Slice[ps.PositionedToken], index: Int) -> Slice[Int]
  if index + 2 >= tokens.Len() then []
  elsif quoteTripleAt(tokens, index) then
    let finish = nextQuoteTriple(tokens, index + 3)
    if finish < 0 then []
    else
    let start = tokens.Get(index).UnwrapOr(emptyPositionedToken())
    let finishToken = tokens.Get(finish + 2).UnwrapOr(start)
    # A triple-quoted literal that stays on one line is preserved verbatim by
    # the renderer's literal-aware line normalizer, so it needs no line lock;
    # only the interior rows of a multi-line literal must be reproduced raw.
    let protected = if start.Span.Start.Line == finishToken.Span.End.Line then [] else spanLines(start.Span.Start.Line, finishToken.Span.End.Line) end
    joinProtectedLines(protected, tripleQuotedLines(tokens, finish + 3))
    end
  else tripleQuotedLines(tokens, index + 1) end
end

func quoteTripleAt(tokens: Slice[ps.PositionedToken], index: Int) -> Bool
  tokens.Get(index).Map(func(first: ps.PositionedToken) -> Bool
    tokens.Get(index + 1).Map(func(second: ps.PositionedToken) -> Bool
      tokens.Get(index + 2).Map(func(third: ps.PositionedToken) -> Bool first.Raw == "\"" && second.Raw == "\"" && third.Raw == "\"" end).UnwrapOr(false)
    end).UnwrapOr(false)
  end).UnwrapOr(false)
end

func nextQuoteTriple(tokens: Slice[ps.PositionedToken], index: Int) -> Int
  if index + 2 >= tokens.Len() then -1 elsif quoteTripleAt(tokens, index) then index else nextQuoteTriple(tokens, index + 1) end
end

# Raw literals have one-token delimiters.  Pair them in the positioned-token
# stream so every intervening source line is preserved without renderer state.
func pairedQuotedLines(tokens: Slice[ps.PositionedToken], quote: String, index: Int) -> Slice[Int]
  let start = nextRawToken(tokens, quote, index)
  if start < 0 then []
  else
    let finish = nextRawToken(tokens, quote, start + 1)
    if finish < 0 then []
    else
    let startToken = tokens.Get(start).UnwrapOr(emptyPositionedToken())
    let finishToken = tokens.Get(finish).UnwrapOr(startToken)
    # Only a raw literal that spans multiple lines needs a line lock; a
    # single-line raw literal is preserved by the literal-aware normalizer.
    let protected = if startToken.Span.Start.Line == finishToken.Span.End.Line then [] else spanLines(startToken.Span.Start.Line, finishToken.Span.End.Line) end
    joinProtectedLines(protected, pairedQuotedLines(tokens, quote, finish + 1))
    end
  end
end

func nextRawToken(tokens: Slice[ps.PositionedToken], raw: String, index: Int) -> Int
  if index >= tokens.Len() then -1
  else if tokens.Get(index).Map(func(token: ps.PositionedToken) -> Bool token.Raw == raw end).UnwrapOr(false) then index
  else nextRawToken(tokens, raw, index + 1) end end
end

func emptyPositionedToken() -> ps.PositionedToken
  ps.PositionedToken { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } }
end


func protectedTriviaLines(items: Slice[ps.PositionedTrivia], index: Int) -> Slice[Int]
  if index >= items.Len() then []
  else
    let item = items.Get(index).UnwrapOr(ps.PositionedTrivia { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } })
    let current = if item.Kind == "comment" then spanLines(item.Span.Start.Line, item.Span.End.Line) else [] end
    joinProtectedLines(current, protectedTriviaLines(items, index + 1))
  end
end

func spanLines(start: Int, finish: Int) -> Slice[Int]
  if start <= 0 || finish < start then [] elsif start == finish then [start] else joinProtectedLines([start], spanLines(start + 1, finish)) end
end

func joinProtectedLines(left: Slice[Int], right: Slice[Int]) -> Slice[Int]
  if right.Len() == 0 then left else joinProtectedLines(left.Append(right.Get(0).UnwrapOr(0)), right.Slice(1, right.Len()).UnwrapOr([])) end
end

struct LosslessScan
  Tokens: Slice[ps.PositionedToken]
  Trivia: Slice[ps.PositionedTrivia]
end

struct ScanState
  Input: String
  Index: Int
  Offset: Int
  Line: Int
  Column: Int
  Tokens: Slice[ps.PositionedToken]
  Trivia: Slice[ps.PositionedTrivia]
  Literal: LiteralScan
end

func spannedTypeExpr() -> ps.Parser[Spanned[ast2.TypeExpr]]
  func(state: ps.State) -> ps.Reply[Spanned[ast2.TypeExpr]]
    let reply = typeExpr()(state)
    if reply.Ok then
      ps.Reply[Spanned[ast2.TypeExpr]] { Ok: true, Consumed: reply.Consumed, Value: Spanned[ast2.TypeExpr] { Value: reply.Value, Span: stateSpan(state, reply.State) }, State: reply.State, Error: reply.Error }
    else
      ps.Reply[Spanned[ast2.TypeExpr]] { Ok: false, Consumed: reply.Consumed, Value: Spanned[ast2.TypeExpr] { Value: ast2.TypeExpr.UnitType, Span: stateSpan(state, reply.State) }, State: reply.State, Error: reply.Error }
    end
  end
end

func spannedExpr() -> ps.Parser[Spanned[ast2.Expr]]
  func(state: ps.State) -> ps.Reply[Spanned[ast2.Expr]]
    let reply = expr()(state)
    if reply.Ok then
      ps.Reply[Spanned[ast2.Expr]] { Ok: true, Consumed: reply.Consumed, Value: Spanned[ast2.Expr] { Value: reply.Value, Span: stateSpan(state, reply.State) }, State: reply.State, Error: reply.Error }
    else
      ps.Reply[Spanned[ast2.Expr]] { Ok: false, Consumed: reply.Consumed, Value: Spanned[ast2.Expr] { Value: ast2.EmptyExpr(), Span: stateSpan(state, reply.State) }, State: reply.State, Error: reply.Error }
    end
  end
end

func spannedLiteral() -> ps.Parser[Spanned[String]]
  func(state: ps.State) -> ps.Reply[Spanned[String]]
    let reply = ps.PChoice([number(), stringLiteral(), runeLiteral()])(state)
    if reply.Ok then
      ps.Reply[Spanned[String]] { Ok: true, Consumed: reply.Consumed, Value: Spanned[String] { Value: reply.Value, Span: stateSpan(state, reply.State) }, State: reply.State, Error: reply.Error }
    else
      ps.Reply[Spanned[String]] { Ok: false, Consumed: reply.Consumed, Value: Spanned[String] { Value: "", Span: stateSpan(state, reply.State) }, State: reply.State, Error: reply.Error }
    end
  end
end

func spannedPattern() -> ps.Parser[Spanned[ast2.Pattern]]
  func(state: ps.State) -> ps.Reply[Spanned[ast2.Pattern]]
    let reply = pattern()(state)
    if reply.Ok then
      ps.Reply[Spanned[ast2.Pattern]] { Ok: true, Consumed: reply.Consumed, Value: Spanned[ast2.Pattern] { Value: reply.Value, Span: stateSpan(state, reply.State) }, State: reply.State, Error: reply.Error }
    else
      ps.Reply[Spanned[ast2.Pattern]] { Ok: false, Consumed: reply.Consumed, Value: Spanned[ast2.Pattern] { Value: ast2.Pattern.WildcardPattern, Span: stateSpan(state, reply.State) }, State: reply.State, Error: reply.Error }
    end
  end
end

func spannedFuncSig() -> ps.Parser[Spanned[ast2.FuncSig]]
  func(state: ps.State) -> ps.Reply[Spanned[ast2.FuncSig]]
    let reply = funcSig()(state)
    if reply.Ok then
      ps.Reply[Spanned[ast2.FuncSig]] { Ok: true, Consumed: reply.Consumed, Value: Spanned[ast2.FuncSig] { Value: reply.Value, Span: stateSpan(state, reply.State) }, State: reply.State, Error: reply.Error }
    else
      ps.Reply[Spanned[ast2.FuncSig]] { Ok: false, Consumed: reply.Consumed, Value: Spanned[ast2.FuncSig] { Value: ast2.FuncSig { Pos: ast2.SourcePos { SourceName: "", Line: state.Position.Line, Column: state.Position.Column }, Name: "", TypeParams: [], Params: [], Ret: None, RetSpan: stateSpan(state, reply.State), Using: [] }, Span: stateSpan(state, reply.State) }, State: reply.State, Error: reply.Error }
    end
  end
end

func spannedSwitchCase() -> ps.Parser[Spanned[ast2.SwitchCase]]
  func(state: ps.State) -> ps.Reply[Spanned[ast2.SwitchCase]]
    let reply = switchCase()(state)
    if reply.Ok then
      ps.Reply[Spanned[ast2.SwitchCase]] { Ok: true, Consumed: reply.Consumed, Value: Spanned[ast2.SwitchCase] { Value: reply.Value, Span: stateSpan(state, reply.State) }, State: reply.State, Error: reply.Error }
    else
      ps.Reply[Spanned[ast2.SwitchCase]] { Ok: false, Consumed: reply.Consumed, Value: Spanned[ast2.SwitchCase] { Value: ast2.SwitchCase { Pattern: ast2.Pattern.WildcardPattern, PatternSpan: stateSpan(state, reply.State), Body: ast2.EmptyExpr(), BodySpan: stateSpan(state, reply.State), Span: stateSpan(state, reply.State) }, Span: stateSpan(state, reply.State) }, State: reply.State, Error: reply.Error }
    end
  end
end

func stateSpan(start: ps.State, finish: ps.State) -> ast2.SourceSpan
  ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: start.Position.Line, Column: start.Position.Column }, End: ast2.SourcePos { SourceName: "", Line: finish.Position.Line, Column: finish.Position.Column } }
end

func ParseFileLossless(sourceName: String, input: String) -> Result[LosslessFile, String]
  switch ParseFileAt(sourceName, input)
    case Err(message) => Err(message)
    case Ok(file) then
      let scanned = scanLossless(input)
      let finished = finishFile(file, scanned.Tokens)
      let tokenSpans = collectNodeSpans(scanned.Tokens)
      let declarationSpans = collectDeclSpans(finished.Decls, finished.DeclPositions, scanned.Tokens, 0)
      let metadataSpans = collectDeclMetadataSpans(finished.Decls, declarationSpans, scanned.Tokens, 0)
      let baseSpans = joinSpans(joinSpans(joinSpans(tokenSpans, declarationSpans), collectFileExprSpans(finished)), metadataSpans)
      let nodeSpans = joinSpans(baseSpans, collectNestedPatternSpans(baseSpans, scanned.Tokens, 0))
      let blockIfs = blockIfStarts(nodeSpans, scanned.Tokens, 0, None, [])
      Ok(LosslessFile { AST: finished, Tokens: scanned.Tokens, Trivia: scanned.Trivia, NodeSpans: nodeSpans, Delimited: collectDelimitedSpans(nodeSpans, scanned.Tokens, 0), LayoutEvents: collectLayoutEvents(nodeSpans, scanned.Tokens, blockIfs, 0, []) })
    end
  end
end

func collectDeclMetadataSpans(decls: Slice[ast2.Decl], declarationSpans: Slice[NodeSpan], tokens: Slice[ps.PositionedToken], index: Int) -> Slice[NodeSpan]
  if index >= decls.Len() then []
  else
    let decl = decls.Get(index).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    let current = withPath(collectDeclMetadata(decl, declarationSpanAt(declarationSpans, index, 0), tokens), [index])
    joinSpans(current, collectDeclMetadataSpans(decls, declarationSpans, tokens, index + 1))
  end
end

func collectDeclMetadata(decl: ast2.Decl, declSpan: ast2.SourceSpan, tokens: Slice[ps.PositionedToken]) -> Slice[NodeSpan]
  switch decl
    case TypeAliasDecl(_, _, target) => withPath(collectTypeSpans(target, typeDeclarationTargetSpan(tokens, declSpan, true), tokens), [0])
    case TypeDecl(_, _, target) => withPath(collectTypeSpans(target, typeDeclarationTargetSpan(tokens, declSpan, false), tokens), [0])
    case FuncDecl(_, _, params, ret, _, _) => joinSpans(collectParamSpans(params, tokens, 0), switch ret case Some(target) => withPath(collectTypeSpans(target, functionReturnSpan(tokens, declSpan), tokens), [-1]) case None => [] end)
    case StructDecl(_, _, fields) => collectFieldSpans(fields, tokens, 0)
    case EnumDecl(_, _, variants) => collectVariantSpans(variants, tokens, 0)
    case LetDecl(bind) => joinSpans([NodeSpan { Path: [], Kind: "bind", Span: bind.Span }], if bind.TypeSpan.Start.Line > 0 then collectTypeSpans(bind.Type.UnwrapOr(ast2.TypeExpr.UnitType), bind.TypeSpan, tokens) else [] end)
    case VarDecl(bind) => joinSpans([NodeSpan { Path: [], Kind: "bind", Span: bind.Span }], if bind.TypeSpan.Start.Line > 0 then collectTypeSpans(bind.Type.UnwrapOr(ast2.TypeExpr.UnitType), bind.TypeSpan, tokens) else [] end)
    case _ => []
  end
end

func declarationSpanAt(items: Slice[NodeSpan], declaration: Int, index: Int) -> ast2.SourceSpan
  if index >= items.Len() then emptySpan()
  else
    let item = items.Get(index).UnwrapOr(NodeSpan { Path: [], Kind: "", Span: emptySpan() })
    if item.Path.Len() == 1 && item.Path.Get(0).UnwrapOr(-1) == declaration && item.Kind.Slice(0, 5).UnwrapOr("") == "decl:" then item.Span
    else declarationSpanAt(items, declaration, index + 1) end
  end
end

func functionReturnSpan(tokens: Slice[ps.PositionedToken], declSpan: ast2.SourceSpan) -> ast2.SourceSpan
  let arrow = firstArrowInSpan(tokens, declSpan, 0)
  if arrow < 0 then emptySpan() else typeSpanAtToken(tokens, arrow + 2) end
end

func typeDeclarationTargetSpan(tokens: Slice[ps.PositionedToken], declSpan: ast2.SourceSpan, alias: Bool) -> ast2.SourceSpan
  let start = if alias then firstTokenInSpan(tokens, declSpan, "=") + 1 else typeDeclarationTargetStart(tokens, declSpan, 0, 0) end
  if start <= 0 then emptySpan() else typeSpanAtToken(tokens, start) end
end

func typeDeclarationTargetStart(tokens: Slice[ps.PositionedToken], declSpan: ast2.SourceSpan, index: Int, words: Int) -> Int
  if index >= tokens.Len() then -1
  else
    let token = tokens.Get(index).UnwrapOr(ps.PositionedToken { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } })
    if !tokenStartsInSpan(token, declSpan) then typeDeclarationTargetStart(tokens, declSpan, index + 1, words)
    elsif words < 2 then typeDeclarationTargetStart(tokens, declSpan, index + 1, words + 1)
    elsif token.Raw == "[" then
      let close = matchingDelimiter(tokens, index, "[", "]", 0)
      if close < 0 then -1 else typeDeclarationTargetStart(tokens, declSpan, close + 1, words) end
    else index end
  end
end

func typeSpanAtToken(tokens: Slice[ps.PositionedToken], index: Int) -> ast2.SourceSpan
  if index < 0 || index >= tokens.Len() then emptySpan()
  else
    let token = tokens.Get(index).UnwrapOr(ps.PositionedToken { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } })
    let finish = if token.Raw == "(" then matchingDelimiter(tokens, index, "(", ")", 0)
      elsif token.Raw == "func" then functionTypeEnd(tokens, index + 1)
      else namedTypeEnd(tokens, index) end
    if finish < index then emptySpan() else tokenRangeSpan(tokens, index, finish) end
  end
end

func namedTypeEnd(tokens: Slice[ps.PositionedToken], index: Int) -> Int
  let next = tokens.Get(index + 1).UnwrapOr(ps.PositionedToken { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } })
  if next.Raw == "[" then
    let close = matchingDelimiter(tokens, index + 1, "[", "]", 0)
    if close < 0 then index else close end
  else index end
end

func functionTypeEnd(tokens: Slice[ps.PositionedToken], index: Int) -> Int
  let paramsOpen = firstRawToken(tokens, "(", index)
  if paramsOpen < 0 then
    index - 1
  else
    let paramsClose = matchingDelimiter(tokens, paramsOpen, "(", ")", 0)
    let arrow = if paramsClose < 0 then
      -1
    else
      firstArrowToken(tokens, paramsClose + 1)
    end
    if arrow < 0 then
      paramsClose
    else
      namedTypeEnd(tokens, arrow + 2) 
    end
  end
end

# Source tokens are emitted strictly left-to-right, so (Line, Column) is
# monotonically increasing across `tokens`.  These lower-bound binary searches
# let span scans start at the token nearest a position/line instead of walking
# the whole token list from index 0, turning the per-span scans from O(N) into
# O(log N + local region).
func positionBefore(left: ast2.SourcePos, right: ast2.SourcePos) -> Bool
  left.Line < right.Line || (left.Line == right.Line && left.Column < right.Column)
end

func lowerBoundStart(tokens: Slice[ps.PositionedToken], pos: ast2.SourcePos, low: Int, high: Int) -> Int
  if low >= high then low
  else
    let mid = low + (high - low) / 2
    switch tokens.Get(mid)
      case Some(token) =>
        let start = ast2.SourcePos { SourceName: "", Line: token.Span.Start.Line, Column: token.Span.Start.Column }
        if positionBefore(start, pos) then lowerBoundStart(tokens, pos, mid + 1, high) else lowerBoundStart(tokens, pos, low, mid) end
      case None => low
    end
  end
end

func lowerBoundLine(tokens: Slice[ps.PositionedToken], line: Int, low: Int, high: Int) -> Int
  if low >= high then low
  else
    let mid = low + (high - low) / 2
    switch tokens.Get(mid)
      case Some(token) =>
        if token.Span.Start.Line < line then lowerBoundLine(tokens, line, mid + 1, high) else lowerBoundLine(tokens, line, low, mid) end
      case None => low
    end
  end
end

func tokenBeforeSpanStart(token: ps.PositionedToken, span: ast2.SourceSpan) -> Bool
  token.Span.Start.Line < span.Start.Line || (token.Span.Start.Line == span.Start.Line && token.Span.Start.Column <= span.Start.Column)
end

func firstRawToken(tokens: Slice[ps.PositionedToken], raw: String, index: Int) -> Int
  if index >= tokens.Len() then
    -1
  elsif tokens.Get(index).Map(func(token: ps.PositionedToken) -> Bool
    token.Raw == raw
  end).UnwrapOr(false) then
    index
  else
    firstRawToken(tokens, raw, index + 1)
  end
end

func firstArrowInSpan(tokens: Slice[ps.PositionedToken], span: ast2.SourceSpan, index: Int) -> Int
  if index + 1 >= tokens.Len() then
    -1
  else
    let token = tokens.Get(index).UnwrapOr(ps.PositionedToken { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } })
    let next = tokens.Get(index + 1).UnwrapOr(token)
    if tokenStartsInSpan(token, span) && token.Raw == "-" && next.Raw == ">" then
      index
    else
      firstArrowInSpan(tokens, span, index + 1) 
    end
  end
end

func firstArrowToken(tokens: Slice[ps.PositionedToken], index: Int) -> Int
  if index + 1 >= tokens.Len() then
    -1
  else
    let token = tokens.Get(index).UnwrapOr(ps.PositionedToken { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } })
    let next = tokens.Get(index + 1).UnwrapOr(token)
    if token.Raw == "-" && next.Raw == ">" then
      index
    else
      firstArrowToken(tokens, index + 1)
    end
  end
end

func collectParamSpans(items: Slice[ast2.Param], tokens: Slice[ps.PositionedToken], index: Int) -> Slice[NodeSpan]
  if index >= items.Len() then []
  else
    switch items.Get(index)
      case Some(item) then
        let typeNodes = withPath(collectTypeSpans(item.Type, item.TypeSpan, tokens), [index, 0])
        joinSpans(
          joinSpans([NodeSpan { Path: [index], Kind: "param", Span: item.Span }], typeNodes),
          collectParamSpans(items, tokens, index + 1)
        )
      end
      case None => collectParamSpans(items, tokens, index + 1)
    end
  end
end

func collectFieldSpans(items: Slice[ast2.Field], tokens: Slice[ps.PositionedToken], index: Int) -> Slice[NodeSpan]
  if index >= items.Len() then []
  else
    switch items.Get(index)
      case Some(item) =>
        joinSpans(joinSpans([NodeSpan { Path: [index], Kind: "field", Span: item.Span }], withPath(collectTypeSpans(item.Type, item.TypeSpan, tokens), [index, 0])), collectFieldSpans(items, tokens, index + 1))
      case None => collectFieldSpans(items, tokens, index + 1)
    end
  end
end

func collectVariantSpans(items: Slice[ast2.Variant], tokens: Slice[ps.PositionedToken], index: Int) -> Slice[NodeSpan]
  if index >= items.Len() then
    []
  else
    switch items.Get(index)
      case Some(item) =>
        let fields = collectVariantTypeSpans(item.Fields, item.FieldSpans, tokens, 0)
        joinSpans(joinSpans([NodeSpan { Path: [index], Kind: "variant", Span: item.Span }], withPath(fields, [index])), collectVariantSpans(items, tokens, index + 1))
      case None => collectVariantSpans(items, tokens, index + 1)
    end
  end
end

func collectVariantTypeSpans(types: Slice[ast2.TypeExpr], spans: Slice[ast2.SourceSpan], tokens: Slice[ps.PositionedToken], index: Int) -> Slice[NodeSpan]
  if index >= types.Len() then
    []
  else
    switch (types.Get(index), spans.Get(index))
      case (Some(typ), Some(span)) => joinSpans(withPath(collectTypeSpans(typ, span, tokens), [index]), collectVariantTypeSpans(types, spans, tokens, index + 1))
      case _ => collectVariantTypeSpans(types, spans, tokens, index + 1)
    end
  end
end

# TypeExpr and Pattern deliberately remain compact AST enums.  The lossless
# result carries their recursive source identity separately: each child path is
# derived from the parser-owned root span and the positioned delimiter stream.
func collectTypeSpans(typ: ast2.TypeExpr, span: ast2.SourceSpan, tokens: Slice[ps.PositionedToken]) -> Slice[NodeSpan]
  if span.Start.Line <= 0 then
    []
  else
    let current = [NodeSpan { Path: [], Kind: "type", Span: span }]
    joinSpans(current, collectTypeChildren(typ, span, tokens))
  end
end

func collectTypeChildren(typ: ast2.TypeExpr, span: ast2.SourceSpan, tokens: Slice[ps.PositionedToken]) -> Slice[NodeSpan]
  switch typ
    case NamedType(_, args) => collectTypeListSpans(args, delimitedChildSpans(tokens, span, "[", "]"), tokens, 0)
    case TupleType(items) => collectTypeListSpans(items, delimitedChildSpans(tokens, span, "(", ")"), tokens, 0)
    case FuncType(params, ret) => joinSpans(collectTypeListSpans(params, delimitedChildSpans(tokens, span, "(", ")"), tokens, 0), withPath(collectTypeSpans(ret.value(), trailingSpan(tokens, span, "->"), tokens), [-1]))
    case InlineGo(inner, _) => withPath(collectTypeSpans(inner.value(), delimitedChildSpan(tokens, span, "[", "]"), tokens), [0])
    case _ => []
  end
end

func collectTypeListSpans(types: Slice[ast2.TypeExpr], spans: Slice[ast2.SourceSpan], tokens: Slice[ps.PositionedToken], index: Int) -> Slice[NodeSpan]
  if index >= types.Len() then
    []
  else
    let typ = types.Get(index).UnwrapOr(ast2.TypeExpr.UnitType)
    let span = spans.Get(index).UnwrapOr(emptySpan())
    joinSpans(withPath(collectTypeSpans(typ, span, tokens), [index]), collectTypeListSpans(types, spans, tokens, index + 1))
  end
end

func collectPatternSpans(pattern: ast2.Pattern, span: ast2.SourceSpan, tokens: Slice[ps.PositionedToken]) -> Slice[NodeSpan]
  if span.Start.Line <= 0 then
    []
  else
    let kind = switch pattern case LiteralPattern(_, _) => "pattern-literal" case _ => "pattern" end
    let current = [NodeSpan { Path: [], Kind: kind, Span: span }]
    joinSpans(current, collectPatternChildren(pattern, span, tokens))
  end
end

func collectPatternChildren(pattern: ast2.Pattern, span: ast2.SourceSpan, tokens: Slice[ps.PositionedToken]) -> Slice[NodeSpan]
  switch pattern
    case TuplePattern(items) => collectPatternListSpans(items, delimitedChildSpans(tokens, span, "(", ")"), tokens, 0)
    case VariantPattern(_, items) => collectPatternListSpans(items, delimitedChildSpans(tokens, span, "(", ")"), tokens, 0)
    case StructVariantPattern(_, fields) => collectStructPatternFieldSpans(fields, delimitedChildSpans(tokens, span, "{", "}"), 0)
    case _ => []
  end
end

# Pattern fields do not carry individual AST span fields.  Their enclosing
# PatternSpan is exact, so derive their nested paths solely from the token
# delimiters within that parser-owned range.
func collectNestedPatternSpans(items: Slice[NodeSpan], tokens: Slice[ps.PositionedToken], index: Int) -> Slice[NodeSpan]
  if index >= items.Len() then
    []
  else
    let item = items.Get(index).UnwrapOr(NodeSpan { Path: [], Kind: "", Span: emptySpan() })
    let nested = if item.Kind == "pattern" then collectPatternTokenChildren(item.Span, item.Path, tokens) else [] end
    joinSpans(nested, collectNestedPatternSpans(items, tokens, index + 1))
  end
end

func collectPatternTokenChildren(span: ast2.SourceSpan, path: Slice[Int], tokens: Slice[ps.PositionedToken]) -> Slice[NodeSpan]
  let parenChildren = delimitedChildSpans(tokens, span, "(", ")")
  let children = if parenChildren.Len() > 0 then
    parenChildren
  else
    delimitedChildSpans(tokens, span, "{", "}") 
  end
  collectPatternTokenChildList(children, path, tokens, 0)
end

func collectPatternTokenChildList(spans: Slice[ast2.SourceSpan], path: Slice[Int], tokens: Slice[ps.PositionedToken], index: Int) -> Slice[NodeSpan]
  if index >= spans.Len() then
    []
  else
    let span = spans.Get(index).UnwrapOr(emptySpan())
    let childPath = path.Append(index)
    let kind = if spanStartsLiteral(tokens, span, 0) then "pattern-literal" else "pattern" end
    let current = NodeSpan { Path: childPath, Kind: kind, Span: span }
    joinSpans(
      joinSpans([current], if kind == "pattern" => collectPatternTokenChildren(span, childPath, tokens) else []),
      collectPatternTokenChildList(spans, path, tokens, index + 1)
    )
  end
end

func spanStartsLiteral(tokens: Slice[ps.PositionedToken], span: ast2.SourceSpan, index: Int) -> Bool
  if index >= tokens.Len() then false
  else
    let token = tokens.Get(index).UnwrapOr(ps.PositionedToken { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } })
    if tokenStartsInSpan(token, span) then
      token.Raw == "\"" || token.Raw == "'" || (token.Raw >= "0" && token.Raw <= "9")
    else
      spanStartsLiteral(tokens, span, index + 1)
    end
  end
end

func collectPatternListSpans(patterns: Slice[ast2.Pattern], spans: Slice[ast2.SourceSpan], tokens: Slice[ps.PositionedToken], index: Int) -> Slice[NodeSpan]
  if index >= patterns.Len() then []
  else
    let pattern = patterns.Get(index).UnwrapOr(ast2.Pattern.WildcardPattern)
    let span = spans.Get(index).UnwrapOr(emptySpan())
    joinSpans(withPath(collectPatternSpans(pattern, span, tokens), [index]), collectPatternListSpans(patterns, spans, tokens, index + 1))
  end
end

func collectStructPatternFieldSpans(fields: Slice[ast2.StructPatternField], spans: Slice[ast2.SourceSpan], index: Int) -> Slice[NodeSpan]
  if index >= fields.Len() then []
  else
    let span = spans.Get(index).UnwrapOr(emptySpan())
    joinSpans([NodeSpan { Path: [index], Kind: "pattern-field", Span: span }], collectStructPatternFieldSpans(fields, spans, index + 1))
  end
end

func delimitedChildSpan(tokens: Slice[ps.PositionedToken], span: ast2.SourceSpan, open: String, close: String) -> ast2.SourceSpan
  delimitedChildSpans(tokens, span, open, close).Get(0).UnwrapOr(emptySpan())
end

func delimitedChildSpans(tokens: Slice[ps.PositionedToken], span: ast2.SourceSpan, open: String, close: String) -> Slice[ast2.SourceSpan]
  let start = firstTokenInSpan(tokens, span, open)
  if start < 0 then
    []
  else
    let finish = matchingDelimiter(tokens, start, open, close, 0)
    if finish < 0 then [] else splitDelimitedTokens(tokens, start + 1, finish, 0, start + 1, startLiteralScan(), []) end
  end
end

func trailingSpan(tokens: Slice[ps.PositionedToken], span: ast2.SourceSpan, marker: String) -> ast2.SourceSpan
  let markerIndex = firstTokenInSpan(tokens, span, marker)
  if markerIndex < 0 then
    emptySpan()
  else
    tokenRangeSpan(tokens, markerIndex + 1, lastTokenInSpan(tokens, span))
  end
end

func firstTokenInSpan(tokens: Slice[ps.PositionedToken], span: ast2.SourceSpan, raw: String) -> Int
  firstTokenInSpanFrom(tokens, span, raw, lowerBoundStart(tokens, span.Start, 0, tokens.Len()))
end

func firstTokenInSpanFrom(tokens: Slice[ps.PositionedToken], span: ast2.SourceSpan, raw: String, index: Int) -> Int
  if index >= tokens.Len() then
    -1
  else
    switch tokens.Get(index)
      case Some(token) =>
        if !tokenBeforeSpanStart(token, span) && (token.Span.Start.Line > span.End.Line || (token.Span.Start.Line == span.End.Line && token.Span.Start.Column >= span.End.Column)) then
          -1
        elsif tokenStartsInSpan(token, span) && token.Raw == raw then
          index
        else
          firstTokenInSpanFrom(tokens, span, raw, index + 1)
        end
      case None => -1
    end
  end
end

func lastTokenInSpan(tokens: Slice[ps.PositionedToken], span: ast2.SourceSpan) -> Int
  lastTokenInSpanFrom(tokens, span, lowerBoundStart(tokens, span.Start, 0, tokens.Len()), -1)
end

func lastTokenInSpanFrom(tokens: Slice[ps.PositionedToken], span: ast2.SourceSpan, index: Int, best: Int) -> Int
  if index >= tokens.Len() then best
  else
    switch tokens.Get(index)
      case Some(token) =>
        if !tokenBeforeSpanStart(token, span) && (token.Span.Start.Line > span.End.Line || (token.Span.Start.Line == span.End.Line && token.Span.Start.Column >= span.End.Column)) then
          best
        else
          lastTokenInSpanFrom(tokens, span, index + 1, if tokenStartsInSpan(token, span) then index else best end)
        end
      case None => best
    end
  end
end

# The lossless scanner emits each quote as its own one-character token, so the
# interior of a rune, string, or backtick literal reaches the token stream as
# ordinary tokens: the `[` of a `"map["` literal arrives as a symbol token, and a
# `#` inside a literal would otherwise open a line comment that swallows the
# literal's closing quote.  Both the scanner and the delimiter scans therefore
# carry the open literal plus its escape state so literal interiors stay opaque -
# the scanner to decide whether `#` starts a comment, the delimiter scans to skip
# brackets that would unbalance their depth count, such as a rune `'('` or a
# string `"("` that would otherwise swallow the rest of the enclosing construct.
struct LiteralScan
  Quote: String
  Escaped: Bool
end

func startLiteralScan() -> LiteralScan
  LiteralScan { Quote: "", Escaped: false }
end

func advanceLiteralScan(scan: LiteralScan, token: ps.PositionedToken) -> LiteralScan
  advanceLiteralState(scan, token.Kind, token.Raw)
end

# advanceLiteralState folds one token into the literal state: a quote opens a
# literal, an unescaped matching quote closes it, `\` escapes the following
# token, and any other token leaves the state alone.  Backtick literals are raw,
# so a backslash inside one stays ordinary and never escapes its closing quote.
func advanceLiteralState(scan: LiteralScan, kind: String, raw: String) -> LiteralScan
  if scan.Quote != "" then
    if scan.Escaped then
      LiteralScan { Quote: scan.Quote, Escaped: false }
    elsif raw == "\\" && scan.Quote != "`" then
      LiteralScan { Quote: scan.Quote, Escaped: true }
    elsif raw == scan.Quote then
      LiteralScan { Quote: "", Escaped: false }
    else
      LiteralScan { Quote: scan.Quote, Escaped: false }
    end
  elsif kind == "literal" then
    LiteralScan { Quote: raw, Escaped: false }
  else
    LiteralScan { Quote: "", Escaped: false }
  end
end

# True when the token folded between the two states is a bare symbol: a token
# outside any literal whose bracket or comma meaning the caller may use.
func literalTokenIsBare(before: LiteralScan, after: LiteralScan) -> Bool
  before.Quote == "" && after.Quote == ""
end

func matchingDelimiter(tokens: Slice[ps.PositionedToken], index: Int, open: String, close: String, depth: Int) -> Int
  matchingDelimiterFrom(tokens, index, open, close, depth, startLiteralScan())
end

func matchingDelimiterFrom(tokens: Slice[ps.PositionedToken], index: Int, open: String, close: String, depth: Int, scan: LiteralScan) -> Int
  if index >= tokens.Len() then
    -1
  else
    switch tokens.Get(index)
      case Some(token) =>
        let nextScan = advanceLiteralScan(scan, token)
        let bare = literalTokenIsBare(scan, nextScan)
        let nextDepth = if bare && token.Raw == open then depth + 1 elsif bare && token.Raw == close then depth - 1 else depth end
        if bare && token.Raw == close && nextDepth == 0 then
          index
        else
          matchingDelimiterFrom(tokens, index + 1, open, close, nextDepth, nextScan)
        end
      case None => -1
    end
  end
end

func splitDelimitedTokens(tokens: Slice[ps.PositionedToken], index: Int, finish: Int, depth: Int, start: Int, scan: LiteralScan, out: Slice[ast2.SourceSpan]) -> Slice[ast2.SourceSpan]
  if index >= finish then
    if start >= finish then
      out
    else
      out.Append(tokenRangeSpan(tokens, start, finish - 1))
    end
  else
    let token = tokens.Get(index).UnwrapOr(ps.PositionedToken { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } })
    let nextScan = advanceLiteralScan(scan, token)
    let bare = literalTokenIsBare(scan, nextScan)
    let nextDepth = if bare && (token.Raw == "[" || token.Raw == "(" || token.Raw == "{") then depth + 1 elsif bare && (token.Raw == "]" || token.Raw == ")" || token.Raw == "}") then depth - 1 else depth end
    if bare && token.Raw == "," && depth == 0 then
      splitDelimitedTokens(
        tokens,
        index + 1,
        finish,
        nextDepth,
        index + 1,
        nextScan,
        if start >= index => out else out.Append(tokenRangeSpan(tokens, start, index - 1)),
      )
    else
      splitDelimitedTokens(tokens, index + 1, finish, nextDepth, start, nextScan, out)
    end
  end
end

func tokenRangeSpan(tokens: Slice[ps.PositionedToken], start: Int, finish: Int) -> ast2.SourceSpan
  if start < 0 || finish < start then
    emptySpan()
  else
    let first = tokens.Get(start).UnwrapOr(ps.PositionedToken { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } })
    let last = tokens.Get(finish).UnwrapOr(first)
    ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: first.Span.Start.Line, Column: first.Span.Start.Column }, End: ast2.SourcePos { SourceName: "", Line: last.Span.End.Line, Column: last.Span.End.Column } }
  end
end

func tokenStartsInSpan(token: ps.PositionedToken, span: ast2.SourceSpan) -> Bool
  (token.Span.Start.Line > span.Start.Line || (token.Span.Start.Line == span.Start.Line && token.Span.Start.Column >= span.Start.Column)) && (token.Span.Start.Line < span.End.Line || (token.Span.Start.Line == span.End.Line && token.Span.Start.Column < span.End.Column))
end

func collectLayoutEvents(items: Slice[NodeSpan], tokens: Slice[ps.PositionedToken], blockIfs: Slice[ast2.SourcePos], index: Int, acc: Slice[LayoutEvent]) -> Slice[LayoutEvent]
  if index >= items.Len() then
    acc
  else
    let item = items.Get(index).UnwrapOr(NodeSpan { Path: [], Kind: "", Span: ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, End: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 } } })
    if item.Kind == "" || item.Kind == "symbol" || item.Kind == "literal" || item.Kind == "block-body" then
      collectLayoutEvents(items, tokens, blockIfs, index + 1, acc)
    else
      let anchor = if item.Kind == "case-body" then
        items.Get(index - 1).Map(func(header: NodeSpan) -> ast2.SourceSpan header.Span end).UnwrapOr(item.Span)
      else layoutEventAnchor(items, item, tokens) end
      # An `elsif` link is an IfExpr in the else slot with no `else` keyword, so its
      # `if-else` node cannot be anchored on a real `else` token. Drop that event pair so
      # the chain keeps being driven solely by the `transition:if-elsif` events; a
      # genuine `else`-block branch verifies and is kept (see `suppressedElsif` below).
      # Verification must also place an `if-else` anchor INSIDE the parent `if` span:
      # a backward keyword scan can otherwise borrow an `else` from an unrelated earlier
      # construct (a cross-function phantom `enter:if-else`), which the formatter's
      # depth projection then counts as a real branch and mis-indents the donor span.
      let anchorTokenVerified = anchorIsVerified(item.Kind, anchor, tokens)
      let anchorVerified = anchorTokenVerified && elseAnchorInsideParent(items, item, anchor)
      # Event existence is the parser contract: a failed token verification only
      # falls back to the parser-owned span anchor, it never drops the event pair.
      let anchor = if anchorVerified then anchor
        elsif hasUsableSpan(item.Span) then item.Span
        else anchor end
        let bodyAnchor = if item.Kind == "case" then caseBodyAnchor(items, item, 0) else item.Span end
        let blockBodyAnchor = if canOwnBlockBody(item.Kind) then nestedBodyAnchor(items, item, 0) else item.Span end
        let bodyLayout = if bodyAnchor.Start.Line > anchor.Start.Line || item.Span.End.Line > anchor.Start.Line then "block" else "inline" end
        let headerForm = layoutHeaderForm(item.Kind, anchor)
        let branchForm = if item.Kind == "if-else" then siblingThenForm(items, item, tokens, "") else headerForm end
        let separatorAnchor = layoutSeparatorAnchor(item.Kind, bodyAnchor, tokens, 0)
        let blockCase = item.Kind == "case" && bodyLayout == "block"
        let exitAnchor = if item.Kind.HasPrefix("decl:") || item.Kind == "impl-method" then declarationEndAnchor(tokens, item.Span)
          elsif item.Kind == "inline-go" then inlineGoExitAnchor(tokens, item.Span)
          elsif item.Kind == "if-then" || item.Kind == "if-else" then branchEndAnchor(items, item, tokens, blockIfs, item.Span)
          elsif item.Kind == "if" then ifExitAnchor(items, item, tokens, blockIfs, item.Span)
          elsif item.Kind == "func-lit" then funcLitEndAnchor(tokens, item.Span, blockIfs, item.Span)
          elsif blockCase then caseBlockExitAnchor(tokens, bodyAnchor, item.Span)
          elsif bodyLayout == "block" then matchingEndAnchor(tokens, anchor, 0, 0, false, item.Span)
          else item.Span end
        let sameLineEnd = item.Span.Start.Line == item.Span.End.Line && hasEndTokenOnLine(tokens, item.Span.Start.Line) && item.Kind != "case"
        let blockLike = bodyLayout == "block" || (sameLineEnd && hasUsableSpan(blockBodyAnchor)) || (item.Kind == "if-else" && sameLineEnd) || (item.Kind == "if-then" && sameLineEnd && layoutHeaderForm(item.Kind, anchor) == "then")
        # A func literal bumps depth only for a multi-row body (see `funcLitBumpsIndent`);
        # every other kind keeps the structural-block rule.
        let funcLitIndent = funcLitBumpsIndent(exitAnchor, anchor)
        let structuralIndent = structuralBlockKind(item.Kind) && blockLike
        let affectsIndent = if item.Kind == "func-lit" then funcLitIndent else structuralIndent end
        let wideLine = item.Span.Start.Line == item.Span.End.Line && lineIsWide(tokens, item.Span.End.Line)
        let expandsAfter = if bodyAnchor.Start.Line <= 0 then false
          elsif item.Kind == "case" then bodyLayout == "inline" && wideLine
          elsif item.Kind == "if-then" || item.Kind == "if-else" then bodyLayout == "inline" && (wideLine || branchForm == "then")
          elsif item.Kind == "func-lit" then false
          else affectsIndent && bodyLayout == "inline" end
        let headerLine = if item.Kind == "if-then" && item.Span.Start.Line > 1 then item.Span.Start.Line - 1 elsif anchor.Start.Line > 0 then anchor.Start.Line else item.Span.Start.Line end
        let bodyLine = if item.Kind == "case" then items.Get(index + 1).Map(func(body: NodeSpan) -> Int body.Span.Start.Line end).UnwrapOr(item.Span.Start.Line) else item.Span.Start.Line end
        let normal = [LayoutEvent { Kind: "enter:" + item.Kind, Path: item.Path, Depth: item.Path.Len(), Span: item.Span, Anchor: anchor, BodyAnchor: bodyAnchor, BlockBodyAnchor: blockBodyAnchor, BodyLayout: bodyLayout, AffectsIndent: affectsIndent, ExpandsAfter: expandsAfter, HeaderForm: headerForm, SeparatorAnchor: separatorAnchor, ExitAnchor: exitAnchor, HeaderLine: headerLine, BodyLine: bodyLine, ExitLine: exitAnchor.Start.Line }, LayoutEvent { Kind: "exit:" + item.Kind, Path: item.Path, Depth: item.Path.Len(), Span: item.Span, Anchor: anchor, BodyAnchor: bodyAnchor, BlockBodyAnchor: blockBodyAnchor, BodyLayout: bodyLayout, AffectsIndent: affectsIndent, ExpandsAfter: expandsAfter, HeaderForm: headerForm, SeparatorAnchor: separatorAnchor, ExitAnchor: exitAnchor, HeaderLine: headerLine, BodyLine: bodyLine, ExitLine: exitAnchor.Start.Line }]
        let suppressed = item.Kind == "if-else" && !anchorVerified
        collectLayoutEvents(items, tokens, blockIfs, index + 1,
          if suppressed then acc
          else elsifTransitions(items, item, tokens, 0).Fold(
            normal.Fold(acc, func(a: Slice[LayoutEvent], e: LayoutEvent) -> Slice[LayoutEvent] a.Append(e) end),
            func(a: Slice[LayoutEvent], e: LayoutEvent) -> Slice[LayoutEvent] a.Append(e) end) end)
    end
  end
end

func verifiedLayoutAnchor(kind: String, anchor: ast2.SourceSpan, tokens: Slice[ps.PositionedToken]) -> Bool
  verifiedLayoutAnchorFrom(kind, anchor, tokens, lowerBoundStart(tokens, ast2.SourcePos { SourceName: "", Line: anchor.Start.Line, Column: anchor.Start.Column }, 0, tokens.Len()))
end

func verifiedLayoutAnchorFrom(kind: String, anchor: ast2.SourceSpan, tokens: Slice[ps.PositionedToken], index: Int) -> Bool
  if kind != "if-then" && kind != "if-else" then
    true
  elsif index >= tokens.Len() then
    false
  else
    switch tokens.Get(index)
      case Some(token) =>
        # The lexer splits `=>` into `=` and `>` tokens, so an arrow branch header
        # verifies through the pair rather than a single `=>` token.
        let onAnchor = token.Span.Start.Line == anchor.Start.Line && token.Span.Start.Column == anchor.Start.Column
        let matches = onAnchor && (isAnchorToken(kind, token.Raw) || (kind == "if-then" && token.Raw == "=" && arrowTail(tokens, index + 1)))
        if matches then
          true
        else
          verifiedLayoutAnchorFrom(kind, anchor, tokens, index + 1)
        end
      case None => false
    end
  end
end

func elsifTransitions(items: Slice[NodeSpan], branch: NodeSpan, tokens: Slice[ps.PositionedToken], index: Int) -> Slice[LayoutEvent]
  if branch.Kind != "if-then" || index >= items.Len() then []
  else
    let candidate = items.Get(index).UnwrapOr(NodeSpan { Path: [], Kind: "", Span: emptySpan() })
    if candidate.Kind == "if" && isSiblingBranchPath(candidate.Path, branch.Path, 0) then
      switch elsifHeaderAnchor(tokens, candidate.Span.Start.Line)
        case Some(anchor) => [LayoutEvent { Kind: "transition:if-elsif", Path: branch.Path, Depth: branch.Path.Len(), Span: candidate.Span, Anchor: anchor, BodyAnchor: anchor, BlockBodyAnchor: anchor, BodyLayout: "block", AffectsIndent: false, ExpandsAfter: false, HeaderForm: "", SeparatorAnchor: emptySpan(), ExitAnchor: anchor, HeaderLine: anchor.Start.Line, BodyLine: anchor.Start.Line, ExitLine: anchor.Start.Line }]
        case None => []
      end
    else elsifTransitions(items, branch, tokens, index + 1) end
  end
end

func elsifHeaderAnchor(tokens: Slice[ps.PositionedToken], line: Int) -> Option[ast2.SourceSpan]
  elsifHeaderAnchorFrom(tokens, line, lowerBoundLine(tokens, line, 0, tokens.Len()))
end

func elsifHeaderAnchorFrom(tokens: Slice[ps.PositionedToken], line: Int, index: Int) -> Option[ast2.SourceSpan]
  if index >= tokens.Len() then
    None
  else
    switch tokens.Get(index)
      case Some(token) =>
        if token.Raw == "elsif" && token.Span.Start.Line == line then Some(tokenRangeSpan(tokens, index, index))
        else elsifHeaderAnchorFrom(tokens, line, index + 1) end
      case None => None
    end
  end
end

# A branch (then/else) closes at the enclosing if's `end`.  Scanning from the
# branch header alone cannot find it because `else` is not a block-opening
# token, so matchingEndAnchor would fall back to the branch span.  The parent
# if's header anchor is structural: the parser owns the boundary.  An `elsif
# ... then` branch continues its enclosing if and is tracked separately by the
# transition event, so it keeps the innermost parent lookup above.
func branchEndAnchor(items: Slice[NodeSpan], branch: NodeSpan, tokens: Slice[ps.PositionedToken], blockIfs: Slice[ast2.SourcePos], fallback: ast2.SourceSpan) -> ast2.SourceSpan
  switch parentIfNode(items, branch, 0)
    case Some(ifItem) => ifExitAnchor(items, ifItem, tokens, blockIfs, fallback)
    case None => fallback
  end
end

func parentIfNode(items: Slice[NodeSpan], branch: NodeSpan, index: Int) -> Option[NodeSpan]
  if index >= items.Len() then
    None
  else
    switch items.Get(index)
      case Some(candidate) =>
        if candidate.Kind == "if" && isDirectChildPath(branch.Path, candidate.Path, 0) then
          Some(candidate)
        else
          parentIfNode(items, branch, index + 1)
        end
      case None => None
    end
  end
end

func structuralBlockKind(kind: String) -> Bool
  kind.HasPrefix("decl:") || kind == "impl-method" || kind == "inline-go" || kind == "if-then" || kind == "if-else" || kind == "switch" || kind == "case" || kind == "while" || kind == "for"
end

# Anchor keywords are a fixed, small set; only these node kinds carry a
# backward keyword scan.  Leaf node spans (expr/type/param/delimited/stmt)
# have no keyword to locate and skip the token scan entirely.
func isAnchorKind(kind: String) -> Bool
  kind == "case" || kind == "if" || kind == "if-else" || kind == "if-then" || kind == "switch" || kind == "while"
end

# A `block-body` child only exists for block-introducing kinds; the remaining
# (leaf) kinds keep the parser-owned span fallback without scanning the node
# list for a body child that can never be present.
func canOwnBlockBody(kind: String) -> Bool
  structuralBlockKind(kind) || kind == "if" || kind == "func-body" || kind == "block"
end

# Top-level declaration spans are bounded by parser-recorded declaration
# positions, so their final token is the declaration's own `end`.  Re-scanning
# from the header is wrong for interfaces: method signatures begin with `func`
# but do not introduce a matching `end` block.
func declarationEndAnchor(tokens: Slice[ps.PositionedToken], span: ast2.SourceSpan) -> ast2.SourceSpan
  let index = lastTokenInSpan(tokens, span)
  switch tokens.Get(index)
    case Some(token) => if token.Raw == "end" then tokenRangeSpan(tokens, index, index) else span end
    case None => span
  end
end

# Inline Go is delimited by braces, not `end`; its parser-owned expression
# span already contains the matching closing brace.
func inlineGoExitAnchor(tokens: Slice[ps.PositionedToken], span: ast2.SourceSpan) -> ast2.SourceSpan
  let index = lastTokenInSpan(tokens, span)
  switch tokens.Get(index)
    case Some(token) => if token.Raw == "}" then tokenRangeSpan(tokens, index, index) else span end
    case None => span
  end
end

# Some AST constructors predate source spans and therefore retain a zero span
# on a composite parent.  Event anchors may still be recovered from the first
# direct child: syntax tokens immediately before that child belong to the
# parent header.  This keeps event construction structural rather than asking
# the formatter to rediscover syntax from source lines.
func layoutEventAnchor(items: Slice[NodeSpan], item: NodeSpan, tokens: Slice[ps.PositionedToken]) -> ast2.SourceSpan
  let bound = if hasUsableSpan(item.Span) then item.Span else firstDirectChildSpan(items, item.Path, 0) end
  if item.Kind == "if-then" then
    branchHeaderAnchor(bound, tokens)
  else
    layoutAnchorForSpan(item.Kind, bound, tokens)
  end
end

func layoutHeaderForm(kind: String, anchor: ast2.SourceSpan) -> String
  if kind == "case" then "pattern"
  elsif kind != "if-then" then ""
  elsif anchor.End.Column - anchor.Start.Column == 2 then "arrow"
  else "then" end
end

func siblingThenForm(items: Slice[NodeSpan], branch: NodeSpan, tokens: Slice[ps.PositionedToken], fallback: String) -> String
  switch siblingThenNode(items, branch, 0)
    case Some(thenNode) => layoutHeaderForm("if-then", layoutEventAnchor(items, thenNode, tokens))
    case None => fallback
  end
end

func siblingThenNode(items: Slice[NodeSpan], branch: NodeSpan, index: Int) -> Option[NodeSpan]
  if index >= items.Len() then None
  else
    switch items.Get(index)
      case Some(candidate) =>
        if candidate.Kind == "if-then" && isSiblingBranchPath(candidate.Path, branch.Path, 0) then
          Some(candidate)
        else
          siblingThenNode(items, branch, index + 1)
        end
      case None => None
    end
  end
end

func isSiblingBranchPath(left: Slice[Int], right: Slice[Int], index: Int) -> Bool
  if left.Len() != right.Len() || left.Len() == 0 then
    false
  elsif index + 1 >= left.Len() then
    (left.Get(index).UnwrapOr(0) == 1 && right.Get(index).UnwrapOr(0) == 2) || (left.Get(index).UnwrapOr(0) == 2 && right.Get(index).UnwrapOr(0) == 1)
  elsif left.Get(index).UnwrapOr(-1) != right.Get(index).UnwrapOr(-2) then
    false
  else
    isSiblingBranchPath(left, right, index + 1)
  end
end

func layoutSeparatorAnchor(kind: String, body: ast2.SourceSpan, tokens: Slice[ps.PositionedToken], index: Int) -> ast2.SourceSpan
  if kind != "case" then
    ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, End: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 } }
  else
    separatorAnchorAt(body, tokens)
  end
end

func separatorAnchorAt(body: ast2.SourceSpan, tokens: Slice[ps.PositionedToken]) -> ast2.SourceSpan
  # Backward scan: the case-body `=>` separator sits at or before the body start,
  # so it cannot be localized to lowerBoundStart(body.Start).
  separatorAnchorAtFrom(body, tokens, 0)
end

func separatorAnchorAtFrom(body: ast2.SourceSpan, tokens: Slice[ps.PositionedToken], index: Int) -> ast2.SourceSpan
  if index + 1 >= tokens.Len() then
    ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, End: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 } }
  else
    switch tokens.Get(index)
      case Some(head) =>
        let tail = tokens.Get(index + 1).UnwrapOr(head)
        if head.Raw == "=" && tail.Raw == ">" && tail.Span.End.Line == body.Start.Line && tail.Span.End.Column <= body.Start.Column then arrowAnchor(head, tail)
        else separatorAnchorAtFrom(body, tokens, index + 1) end
      case None => ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, End: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 } }
    end
  end
end

func branchHeaderAnchor(span: ast2.SourceSpan, tokens: Slice[ps.PositionedToken]) -> ast2.SourceSpan
  # Backward scan: the nearest `then`/`=>` at or before the span start cannot be
  # localized to lowerBoundStart(span.Start) - that would skip the token sought.
  branchHeaderAnchorFrom(span, tokens, 0, span)
end

func branchHeaderAnchorFrom(span: ast2.SourceSpan, tokens: Slice[ps.PositionedToken], index: Int, nearest: ast2.SourceSpan) -> ast2.SourceSpan
  if index >= tokens.Len() then
    nearest
  else
    switch tokens.Get(index)
      case Some(token) =>
        let beforeSpan = token.Span.Start.Line < span.Start.Line || (token.Span.Start.Line == span.Start.Line && token.Span.Start.Column <= span.Start.Column)
        let arrow = token.Raw == "=" && arrowTail(tokens, index + 1)
        let next = if beforeSpan && token.Raw == "then" then
          ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: token.Span.Start.Line, Column: token.Span.Start.Column }, End: ast2.SourcePos { SourceName: "", Line: token.Span.End.Line, Column: token.Span.End.Column } }
        elsif beforeSpan && arrow then
          arrowAnchor(token, tokens.Get(index + 1).UnwrapOr(token))
        else
          nearest
        end
        branchHeaderAnchorFrom(span, tokens, index + 1, next)
      case None => nearest
    end
  end
end

func arrowTail(tokens: Slice[ps.PositionedToken], index: Int) -> Bool
  tokens.Get(index).Map(func(token: ps.PositionedToken) -> Bool token.Raw == ">" end).UnwrapOr(false)
end

func arrowAnchor(head: ps.PositionedToken, tail: ps.PositionedToken) -> ast2.SourceSpan
  ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: head.Span.Start.Line, Column: head.Span.Start.Column }, End: ast2.SourcePos { SourceName: "", Line: tail.Span.End.Line, Column: tail.Span.End.Column } }
end

func hasUsableSpan(span: ast2.SourceSpan) -> Bool
  span.Start.Line > 0 && span.Start.Column > 0
end

func firstDirectChildSpan(items: Slice[NodeSpan], parentPath: Slice[Int], index: Int) -> ast2.SourceSpan
  if index >= items.Len() then
    ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, End: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 } }
  else
    switch items.Get(index)
      case Some(candidate) =>
        if isDirectChildPath(candidate.Path, parentPath, 0) && hasUsableSpan(candidate.Span) then
          candidate.Span
        else
          firstDirectChildSpan(items, parentPath, index + 1)
        end
      case None => ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, End: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 } }
    end
  end
end

func layoutExitAnchor(item: NodeSpan, tokens: Slice[ps.PositionedToken], index: Int) -> ast2.SourceSpan
  matchingEndAnchor(tokens, layoutAnchor(item, tokens), 0, 0, false, item.Span)
end

# The `end` that terminates an `if`.  A plain `if` scans forward from its own
# keyword (see `ifEndAnchor`).  An `elsif` link is not a fresh block, though: the
# parser lowers `if ... elsif ... else ... end` to a nested `IfExpr` tree whose
# every link is the ELSE slot of the previous one, so all links share the ONE
# `end` owned by the outermost `if`.  A forward scan from the `elsif` keyword
# cannot find that terminator - the link's own branch body may hold balanced
# `if ... end` constructs (a nested value `if`, for instance) whose closes net the
# shared depth back to zero first.  Delegate to the enclosing `if`'s exit instead.
func ifExitAnchor(
  items: Slice[NodeSpan],
  item: NodeSpan,
  tokens: Slice[ps.PositionedToken],
  blockIfs: Slice[ast2.SourcePos],
  fallback: ast2.SourceSpan
) -> ast2.SourceSpan
  let anchor = layoutEventAnchor(items, item, tokens)
  if anchorIsElsif(anchor, tokens) then
    switch parentIfNode(items, item, 0)
      case Some(parent) => ifExitAnchor(items, parent, tokens, blockIfs, fallback)
      case None => ifEndAnchor(tokens, anchor, blockIfs, fallback)
    end
  else
    ifEndAnchor(tokens, anchor, blockIfs, fallback)
  end
end

# True when `anchor` points at an `elsif` keyword - the node is an `elsif` link
# rather than a block-opening `if`.
func anchorIsElsif(anchor: ast2.SourceSpan, tokens: Slice[ps.PositionedToken]) -> Bool
  anchorRawAt(tokens, anchor.Start, 0) == "elsif"
end

func anchorRawAt(tokens: Slice[ps.PositionedToken], pos: ast2.SourcePos, index: Int) -> String
  if index >= tokens.Len() then
    ""
  else
    switch tokens.Get(index)
      case Some(token) =>
        if token.Span.Start.Line == pos.Line && token.Span.Start.Column == pos.Column then
          token.Raw
        else
          anchorRawAt(tokens, pos, index + 1)
        end
      case None => ""
    end
  end
end

# Locate the `end` that terminates a keyword `if` block.  The generic
# `matchingEndAnchor` treats `func`/`switch`/... as block openers but NOT the `if`
# keyword, so when an `if`'s condition contains a self-contained `end`-terminated
# construct that opens and closes BEFORE the `if`'s own `then` - a function
# literal (`func ... end`), a nested value `switch`/`if`/`while` ... - the scan
# binds that inner construct's `end` as the `if`'s exit anchor: its transient open
# nets the shared depth back to zero and satisfies the terminator predicate.
# This matcher seeds the enclosing `if` itself so nested openers each net against
# their own `end`, and the `if`'s single shared `end` is the one returning depth to
# zero.  Only BLOCK ifs count as openers: an arrow `if c => a else b` carries no
# `end`, so `blockIfs` (the keyword-start positions of every block-form `if`, i.e.
# one whose then-branch header is `then` rather than `=>`) gates the `if` opener
# and also gates the anchor itself.  `then`/`else`/`elsif` are net-neutral for an
# `if` (its branches share one terminator); a `then` that belongs to a `case`
# (block case form) opens a block closed by its own `end`, so it is counted only
# while the nearest preceding branch keyword is `case`.
func ifEndAnchor(tokens: Slice[ps.PositionedToken], start: ast2.SourceSpan, blockIfs: Slice[ast2.SourcePos], fallback: ast2.SourceSpan) -> ast2.SourceSpan
  if !containsSourcePos(blockIfs, start.Start) then
    fallback
  else
    ifEndAnchorFrom(
      tokens,
      lowerBoundStart(tokens, start.Start, 0, tokens.Len()),
      0,
      false,
      blockIfs,
      fallback
    )
  end
end

# A func literal is `func ... end`-delimited like a block `if`, so its terminator is
# the `end` that nets the shared depth back to zero. Reuse the group-10 net scan
# (`ifEndAnchorFrom`, which counts `func`/nested block-`if`/block-`case` openers against
# their own `end`) seeded at the func-literal's own span start. Inline func literals get
# the same net result but only bump depth when the body is a block (see `affectsIndent`).
func anchorIsVerified(kind: String, anchor: ast2.SourceSpan, tokens: Slice[ps.PositionedToken]) -> Bool
  hasUsableSpan(anchor) && verifiedLayoutAnchor(kind, anchor, tokens)
end

# True when an `if-else` branch anchor falls within its parent `if` span.  A genuine
# `else` keyword always does.  For an `elsif` link (which has no `else` keyword of its
# own) the backward keyword scan may land on an unrelated earlier `else` - possibly in
# a different function entirely - and this containment check rejects that phantom so
# the event pair is suppressed and the chain stays driven by `transition:if-elsif`.
# Any kind other than `if-else`, or a branch without a resolvable parent `if`, is
# accepted unchanged.
func elseAnchorInsideParent(items: Slice[NodeSpan], item: NodeSpan, anchor: ast2.SourceSpan) -> Bool
  if item.Kind != "if-else" then true
  else
    switch parentIfNode(items, item, 0)
      case Some(ifItem) =>
        let afterOpen = anchor.Start.Line > ifItem.Span.Start.Line || (anchor.Start.Line == ifItem.Span.Start.Line && anchor.Start.Column >= ifItem.Span.Start.Column)
        let beforeClose = anchor.End.Line < ifItem.Span.End.Line || (anchor.End.Line == ifItem.Span.End.Line && anchor.End.Column <= ifItem.Span.End.Column)
        afterOpen && beforeClose && elseAfterThenBranch(items, item, anchor)
      case None => true
    end
  end
end

# A genuine `else` keyword sits AFTER its then-branch body.  An `elsif` link has no
# `else` keyword of its own (its ELSE slot is the NEXT `elsif`), so its phantom
# `if-else` node can still borrow an `else` that passes the span containment test
# above - an `else` belonging to a nested construct in the PRECEDING branch and so
# still inside the parent `if` span.  Requiring the anchor to start at or after the
# sibling then-branch's end rejects that borrow while accepting every genuine
# `else`.
func elseAfterThenBranch(items: Slice[NodeSpan], branch: NodeSpan, anchor: ast2.SourceSpan) -> Bool
  switch siblingThenNode(items, branch, 0)
    case None => true
    case Some(thenNode) =>
      let finish = thenNode.Span.End
      anchor.Start.Line > finish.Line || (anchor.Start.Line == finish.Line && anchor.Start.Column >= finish.Column)
  end
end

# A func literal bumps depth only when its body spans multiple rows. The AST func-literal
# span is unreliable (it may cover only the return type), so the multi-line test uses the
# token-scanned `end` exit anchor. An inline func literal stays depth-transparent so
# existing inline call chains (`.Map(func(x: X) -> Bool y end).U(false)`) are byte-identical.
func funcLitBumpsIndent(exitAnchor: ast2.SourceSpan, anchor: ast2.SourceSpan) -> Bool
  exitAnchor.Start.Line > anchor.Start.Line
end

func funcLitEndAnchor(
  tokens: Slice[ps.PositionedToken],
  start: ast2.SourceSpan,
  blockIfs: Slice[ast2.SourcePos],
  fallback: ast2.SourceSpan
) -> ast2.SourceSpan
  let index = lowerBoundStart(tokens, start.Start, 0, tokens.Len())
  ifEndAnchorFrom(tokens, index, 0, false, blockIfs, fallback)
end

# The lossless lexer splits a double-quoted string into `"` / content / `"` tokens with
# no string context, so a block keyword word that merely appears inside a string (e.g.
# the `func` in a "func(" literal) is a standalone symbol token and must NOT count as a
# depth opener -- same precedent as the backward `nearestBranchIsCaseFrom`. The scan
# tracks double-quote parity: a `"` flips the state and stays depth-neutral, a backslash
# inside a quoted region skips the escaped token (so `\"` does not flip parity), and
# every other in-string token is depth-neutral.
func ifEndAnchorFrom(
  tokens: Slice[ps.PositionedToken],
  index: Int,
  depth: Int,
  inString: Bool,
  blockIfs: Slice[ast2.SourcePos],
  fallback: ast2.SourceSpan
) -> ast2.SourceSpan
  if index >= tokens.Len() then
    fallback
  else
    switch tokens.Get(index)
      case Some(token) then
        if token.Raw == "\"" then
          ifEndAnchorFrom(tokens, index + 1, depth, !inString, blockIfs, fallback)
        elsif inString && token.Raw == "\\" then
          ifEndAnchorFrom(tokens, index + 2, depth, inString, blockIfs, fallback)
        elsif inString then
          ifEndAnchorFrom(tokens, index + 1, depth, inString, blockIfs, fallback)
        else
          let nextDepth = depth + ifTokenDelta(tokens, index, blockIfs)
          if depth > 0 && token.Raw == "end" && nextDepth == 0 then
            tokenRangeSpan(tokens, index, index)
          else
            ifEndAnchorFrom(tokens, index + 1, nextDepth, false, blockIfs, fallback)
          end
        end
      end
      case None => fallback
    end
  end
end

func ifTokenDelta(tokens: Slice[ps.PositionedToken], index: Int, blockIfs: Slice[ast2.SourcePos]) -> Int
  switch tokens.Get(index)
    case Some(token) then
      let raw = token.Raw
      if raw == "end" then
        -1
      elsif raw == "if" && containsSourcePos(blockIfs, ast2.SourcePos { SourceName: "", Line: token.Span.Start.Line, Column: token.Span.Start.Column }) then
        1
      elsif raw == "func" || raw == "struct" || raw == "enum" || raw == "interface" || raw == "impl" || raw == "switch" || raw == "while" then
        1
      elsif raw == "then" && nearestBranchIsCase(tokens, index - 1) then
        1
      else
        0
      end
    end
    case None => 0
  end
end

# Scan backward from `index` for the nearest branch-introducing keyword.  A `then`
# opened by a `case` (block case form) carries its own `end`; a `then` opened by an
# `if`/`elsif` shares the `if`'s single terminator and must not add depth.  String
# literals are lexed into `"` / content / `"` tokens, so a keyword word that merely
# appears inside a string (e.g. the `case` in `== "case"`) must NOT be mistaken for a
# block-case opener — the backward scan tracks double-quote parity and ignores every
# token inside a quoted region.
func nearestBranchIsCase(tokens: Slice[ps.PositionedToken], index: Int) -> Bool
  nearestBranchIsCaseFrom(tokens, index, false)
end

func nearestBranchIsCaseFrom(tokens: Slice[ps.PositionedToken], index: Int, inString: Bool) -> Bool
  if index < 0 then false
  else
    switch tokens.Get(index)
      case Some(token) =>
        let raw = token.Raw
        if raw == "\"" then nearestBranchIsCaseFrom(tokens, index - 1, !inString)
        elsif inString then nearestBranchIsCaseFrom(tokens, index - 1, inString)
        elsif raw == "case" then true
        elsif raw == "if" || raw == "elsif" || raw == "else" || raw == "switch" then false
        else nearestBranchIsCaseFrom(tokens, index - 1, inString) end
      case None => false
    end
  end
end

# Collect the keyword-start positions of every BLOCK-form `if`.  In DFS node order
# a block/arrow `if` is immediately followed by its `if-then` child, whose header
# anchor is `then` (block) or `=>` (arrow); the `if` keyword start equals the `if`
# node's span start, so no token scan is needed for the position.  Arrow ifs are
# excluded because they carry no `end`.
func blockIfStarts(items: Slice[NodeSpan], tokens: Slice[ps.PositionedToken], index: Int, pending: Option[NodeSpan], acc: Slice[ast2.SourcePos]) -> Slice[ast2.SourcePos]
  if index >= items.Len() then acc
  else
    switch items.Get(index)
      case Some(item) =>
        let nextPending = if item.Kind == "if" then Some(item) else pending end
        let nextAcc = if item.Kind == "if-then" then
          switch pending
            case Some(parent) =>
              if isDirectChildPath(item.Path, parent.Path, 0) then
                let header = layoutEventAnchor(items, item, tokens)
                if header.End.Column - header.Start.Column != 2 then acc.Append(ast2.SourcePos { SourceName: "", Line: parent.Span.Start.Line, Column: parent.Span.Start.Column }) else acc end
              else acc end
            case None => acc
          end
        else acc end
        blockIfStarts(items, tokens, index + 1, nextPending, nextAcc)
      case None => acc
    end
  end
end

func containsSourcePos(positions: Slice[ast2.SourcePos], pos: ast2.SourcePos) -> Bool
  positions.Fold(false, func(found: Bool, p: ast2.SourcePos) -> Bool
    if found then true else p.Line == pos.Line && p.Column == pos.Column end
  end)
end

func matchingEndAnchor(tokens: Slice[ps.PositionedToken], start: ast2.SourceSpan, index: Int, depth: Int, started: Bool, fallback: ast2.SourceSpan) -> ast2.SourceSpan
  if index >= tokens.Len() then
    fallback
  else
    switch tokens.Get(index)
      case Some(token) =>
        let afterStart = token.Span.Start.Line > start.Start.Line || (token.Span.Start.Line == start.Start.Line && token.Span.Start.Column >= start.Start.Column)
        # An elsif continues the enclosing if and shares its single terminator.
        # The keyword nets one pending branch opener exactly like the end that
        # closes a branch; the then after it re-opens the next branch.
        let opens = isBlockOpenToken(token.Raw)
        let nets = token.Raw == "elsif" || token.Raw == "end"
        let nextDepth = if afterStart && opens then depth + 1 elsif afterStart && nets && depth > 0 then depth - 1 else depth end
        let nextStarted = started || (afterStart && opens)
        if afterStart && token.Raw == "end" && nextStarted && nextDepth == 0 then
          ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: token.Span.Start.Line, Column: token.Span.Start.Column }, End: ast2.SourcePos { SourceName: "", Line: token.Span.End.Line, Column: token.Span.End.Column } }
        else
          matchingEndAnchor(tokens, start, index + 1, nextDepth, nextStarted, fallback)
        end
      case None => fallback
    end
  end
end

# `elsif` closes the pending branch header and `then` opens the next one, so
# an if/elsif/else chain keeps exactly one terminator and matchingEndAnchor
# never consumes the enclosing function or impl `end`.
func isBlockOpenToken(raw: String) -> Bool
  raw == "func" || raw == "struct" || raw == "enum" || raw == "interface" || raw == "impl" || raw == "switch" || raw == "then" || raw == "while"
end

func isEndTokenAnchor(tokens: Slice[ps.PositionedToken], anchor: ast2.SourceSpan, index: Int) -> Bool
  if index >= tokens.Len() then false
  else
    switch tokens.Get(index)
      case Some(token) =>
        if token.Raw == "end" && token.Span.Start.Line == anchor.Start.Line && token.Span.Start.Column == anchor.Start.Column then
          true
        else
          isEndTokenAnchor(tokens, anchor, index + 1)
        end
      case None => false
    end
  end
end

# The exit of a block-bodied case is the token terminating its arm: the end of a
# then block, or - for an arrow arm (case pat => body), which has no keyword -
# the next case arm or the enclosing switch end.  Anchoring the exit on the case
# header instead (matchingEndAnchor's fallback when the body holds no opener)
# would cancel the indent bump the case contributes to its block body.
func caseBlockExitAnchor(tokens: Slice[ps.PositionedToken], body: ast2.SourceSpan, fallback: ast2.SourceSpan) -> ast2.SourceSpan
  caseBlockExitAnchorFrom(tokens, body, 0, fallback)
end

func caseBlockExitAnchorFrom(tokens: Slice[ps.PositionedToken], body: ast2.SourceSpan, index: Int, fallback: ast2.SourceSpan) -> ast2.SourceSpan
  if index >= tokens.Len() then
    fallback
  else
    switch tokens.Get(index)
      case Some(token) =>
        if tokenStartsAtOrAfterPos(token, body.End) && (token.Raw == "case" || token.Raw == "end") then
          ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: token.Span.Start.Line, Column: token.Span.Start.Column }, End: ast2.SourcePos { SourceName: "", Line: token.Span.End.Line, Column: token.Span.End.Column } }
        else
          caseBlockExitAnchorFrom(tokens, body, index + 1, fallback)
        end
      case None => fallback
    end
  end
end

func tokenStartsAtOrAfterPos(token: ps.PositionedToken, pos: ast2.SourcePos) -> Bool
  token.Span.Start.Line > pos.Line || (token.Span.Start.Line == pos.Line && token.Span.Start.Column >= pos.Column)
end

func hasEndTokenOnLine(tokens: Slice[ps.PositionedToken], line: Int) -> Bool
  hasEndTokenOnLineFrom(tokens, line, lowerBoundLine(tokens, line, 0, tokens.Len()))
end

func hasEndTokenOnLineFrom(tokens: Slice[ps.PositionedToken], line: Int, index: Int) -> Bool
  if index >= tokens.Len() then
    false
  else
    switch tokens.Get(index)
      case Some(token) =>
        if token.Raw == "end" && token.Span.Start.Line == line then
          true
        else
          hasEndTokenOnLineFrom(tokens, line, index + 1)
        end
      case None => false
    end
  end
end

func lineIsWide(tokens: Slice[ps.PositionedToken], line: Int) -> Bool
  lineEndColumn(tokens, line) > 101
end

func lineEndColumn(tokens: Slice[ps.PositionedToken], line: Int) -> Int
  lineEndColumnFrom(tokens, line, lowerBoundLine(tokens, line, 0, tokens.Len()), 0)
end

func lineEndColumnFrom(tokens: Slice[ps.PositionedToken], line: Int, index: Int, farthest: Int) -> Int
  if index >= tokens.Len() then
    farthest
  else
    switch tokens.Get(index)
      case Some(token) =>
        let endColumn = if token.Span.End.Line == line && token.Span.End.Column > farthest then
          token.Span.End.Column
        else
          farthest
        end
        lineEndColumnFrom(tokens, line, index + 1, endColumn)
      case None => farthest
    end
  end
end

func caseBodyAnchor(items: Slice[NodeSpan], caseItem: NodeSpan, index: Int) -> ast2.SourceSpan
  if index >= items.Len() then
    caseItem.Span
  else
    switch items.Get(index)
      case Some(candidate) =>
        if candidate.Kind == "case-body" && matchesCaseBodyPath(candidate.Path, caseItem.Path, 0) then candidate.Span
        else caseBodyAnchor(items, caseItem, index + 1) end
      case None => caseItem.Span
    end
  end
end

# Block bodies are parser structure, not declaration-specific formatter input.
# A direct `block-body` child provides the exact body range for its parent.
func nestedBodyAnchor(items: Slice[NodeSpan], item: NodeSpan, index: Int) -> ast2.SourceSpan
  if index >= items.Len() then
    item.Span
  else
    switch items.Get(index)
      case Some(candidate) =>
        if candidate.Kind == "block-body" && isDirectChildPath(candidate.Path, item.Path, 0) then
          candidate.Span
        else
          nestedBodyAnchor(items, item, index + 1)
        end
      case None => item.Span
    end
  end
end

func isDirectChildPath(child: Slice[Int], parent: Slice[Int], index: Int) -> Bool
  if child.Len() != parent.Len() + 1 then
    false
  elsif index >= parent.Len() then
    true
  elsif child.Get(index).UnwrapOr(-1) != parent.Get(index).UnwrapOr(-2) then
    false
  else
    isDirectChildPath(child, parent, index + 1)
  end
end

func matchesCaseBodyPath(bodyPath: Slice[Int], casePath: Slice[Int], index: Int) -> Bool
  if bodyPath.Len() != casePath.Len() + 1 then false
  elsif index >= casePath.Len() then bodyPath.Get(index).UnwrapOr(0) == -1
  elsif bodyPath.Get(index).UnwrapOr(-1) != casePath.Get(index).UnwrapOr(-2) then false
  else matchesCaseBodyPath(bodyPath, casePath, index + 1) end
end

func layoutAnchor(item: NodeSpan, tokens: Slice[ps.PositionedToken]) -> ast2.SourceSpan
  layoutAnchorForSpan(item.Kind, item.Span, tokens)
end

func layoutAnchorForSpan(kind: String, span: ast2.SourceSpan, tokens: Slice[ps.PositionedToken]) -> ast2.SourceSpan
  # Backward scan: the keyword sits at or before the span start, so it cannot be
  # localized to lowerBoundStart(span.Start).  Only anchor kinds carry a keyword;
  # other kinds return their parser-owned span unchanged.
  if isAnchorKind(kind) then layoutAnchorForSpanFrom(kind, span, tokens, 0, span) else span end
end

func layoutAnchorForSpanFrom(kind: String, span: ast2.SourceSpan, tokens: Slice[ps.PositionedToken], index: Int, nearest: ast2.SourceSpan) -> ast2.SourceSpan
  if index >= tokens.Len() then nearest
  else
    switch tokens.Get(index)
      case Some(token) =>
        let beforeItem = token.Span.Start.Line < span.Start.Line || (token.Span.Start.Line == span.Start.Line && token.Span.Start.Column <= span.Start.Column)
        let next = if isAnchorToken(kind, token.Raw) && beforeItem then ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: token.Span.Start.Line, Column: token.Span.Start.Column }, End: ast2.SourcePos { SourceName: "", Line: token.Span.End.Line, Column: token.Span.End.Column } } else nearest end
        layoutAnchorForSpanFrom(kind, span, tokens, index + 1, next)
      case None => nearest
    end
  end
end

func isAnchorToken(kind: String, raw: String) -> Bool
  (kind == "case" && raw == "case") || (kind == "if" && raw == "if") || (kind == "if-else" && raw == "else") || (kind == "if-then" && (raw == "then" || raw == "=>")) || (kind == "switch" && raw == "switch") || (kind == "while" && raw == "while")
end

func collectNodeSpans(tokens: Slice[ps.PositionedToken]) -> Slice[NodeSpan]
  tokens.Map(func(token: ps.PositionedToken) -> NodeSpan
    NodeSpan { Path: [], Kind: token.Kind, Span: ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: token.Span.Start.Line, Column: token.Span.Start.Column }, End: ast2.SourcePos { SourceName: "", Line: token.Span.End.Line, Column: token.Span.End.Column } } }
  end)
end

func collectDeclSpans(decls: Slice[ast2.Decl], positions: Slice[ast2.SourcePos], tokens: Slice[ps.PositionedToken], index: Int) -> Slice[NodeSpan]
  if index >= positions.Len() then []
  else
    let pos = positions.Get(index).UnwrapOr(ast2.SourcePos { SourceName: "", Line: 0, Column: 0 })
    let endPos = if index + 1 < positions.Len() then
      let nextPos = positions.Get(index + 1).UnwrapOr(pos)
      tokenEndBefore(nextPos, tokens, 0, pos)
    else
      tokenLastEnd(tokens, 0, pos)
    end
    let decl = decls.Get(index).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    let item = NodeSpan { Path: [index], Kind: "decl:" + declKind(decl), Span: ast2.SourceSpan { Start: pos, End: endPos } }
    itemList(item, joinSpans(matchDeclBodySpan(decl, index, item.Span, tokens), collectDeclSpans(decls, positions, tokens, index + 1)))
  end
end

func tokenEndBefore(limit: ast2.SourcePos, tokens: Slice[ps.PositionedToken], index: Int, fallback: ast2.SourcePos) -> ast2.SourcePos
  if index >= tokens.Len() then
    fallback
  else
    let token = tokens.Get(index).UnwrapOr(ps.PositionedToken { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } })
    if token.Span.Start.Line > limit.Line || (token.Span.Start.Line == limit.Line && token.Span.Start.Column >= limit.Column) then
      fallback
    else
      tokenEndBefore(limit, tokens, index + 1, ast2.SourcePos { SourceName: fallback.SourceName, Line: token.Span.End.Line, Column: token.Span.End.Column })
    end
  end
end

func matchDeclBodySpan(decl: ast2.Decl, index: Int, declSpan: ast2.SourceSpan, tokens: Slice[ps.PositionedToken]) -> Slice[NodeSpan]
  switch decl
    case FuncDecl(_, _, _, _, body, _) =>
      let span = functionBodySpan(body)
      [NodeSpan { Path: [index, 0], Kind: "func-body", Span: span }, NodeSpan { Path: [index, 0], Kind: "block-body", Span: span }]
    case ImplDecl(_, _, _, methods) => collectImplMethodSpans(methods, index, declarationEndAnchor(tokens, declSpan).Start, tokens, 0)
    case _ => []
  end
end

func collectImplMethodSpans(methods: Slice[ast2.ImplMethod], declaration: Int, implEnd: ast2.SourcePos, tokens: Slice[ps.PositionedToken], index: Int) -> Slice[NodeSpan]
  if index >= methods.Len() then []
  else
    let method = methods.Get(index).UnwrapOr(ast2.ImplMethod { Pos: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, Sig: ast2.FuncSig { Pos: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, Name: "", TypeParams: [], Params: [], Ret: None, RetSpan: emptySpan(), Using: [] }, Body: ast2.EmptyExpr() })
    let next = methods.Get(index + 1).Map(func(item: ast2.ImplMethod) -> ast2.SourcePos item.Pos end).UnwrapOr(implEnd)
    let endPos = tokenEndBefore(next, tokens, 0, method.Pos)
    let span = ast2.SourceSpan { Start: method.Pos, End: endPos }
    let path = [declaration, -2, index]
    joinSpans([NodeSpan { Path: path, Kind: "impl-method", Span: span }, NodeSpan { Path: path.Append(0), Kind: "block-body", Span: functionBodySpan(method.Body) }], collectImplMethodSpans(methods, declaration, implEnd, tokens, index + 1))
  end
end

func functionBodySpan(body: ast2.Expr) -> ast2.SourceSpan
  if body.Span.Start.Line > 0 then body.Span
  else firstLiteralSpan(collectExprSpans(body)) end
end

func firstLiteralSpan(items: Slice[NodeSpan]) -> ast2.SourceSpan
  if items.Len() == 0 then ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, End: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 } }
  else
    let item = items.Get(0).UnwrapOr(NodeSpan { Path: [], Kind: "", Span: ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, End: ast2.SourcePos { Line: 0, Column: 0, SourceName: "" } } })
    if item.Kind == "literal" then item.Span else firstLiteralSpan(items.Slice(1, items.Len()).UnwrapOr([])) end
  end
end

func tokenLastEnd(tokens: Slice[ps.PositionedToken], index: Int, fallback: ast2.SourcePos) -> ast2.SourcePos
  if index >= tokens.Len() then fallback
  else
    let token = tokens.Get(index).UnwrapOr(ps.PositionedToken { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } })
    tokenLastEnd(tokens, index + 1, ast2.SourcePos { SourceName: fallback.SourceName, Line: token.Span.End.Line, Column: token.Span.End.Column })
  end
end

func declKind(decl: ast2.Decl) -> String
  switch decl
    case ImportDecl(_, _) => "import"
    case LetDecl(_) => "let"
    case VarDecl(_) => "var"
    case TypeAliasDecl(_, _, _) => "type"
    case TypeDecl(_, _, _) => "type"
    case FuncDecl(_, _, _, _, _, _) => "func"
    case StructDecl(_, _, _) => "struct"
    case EnumDecl(_, _, _) => "enum"
    case InterfaceDecl(_, _, _) => "interface"
    case ImplDecl(_, _, _, _) => "impl"
  end
end

func itemList(item: NodeSpan, rest: Slice[NodeSpan]) -> Slice[NodeSpan]
  if rest.Len() == 0 then [item]
  else joinSpans([item], rest) end
end

func collectFileExprSpans(file: ast2.File) -> Slice[NodeSpan]
  collectDeclExprSpans(file.Decls, 0)
end

func collectDeclExprSpans(decls: Slice[ast2.Decl], index: Int) -> Slice[NodeSpan]
  if index >= decls.Len() then []
  else
    let current = decls.Get(index).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    joinSpans(withPath(collectDeclExpr(current), [index]), collectDeclExprSpans(decls, index + 1))
  end
end

func collectDeclExpr(decl: ast2.Decl) -> Slice[NodeSpan]
  switch decl
    case FuncDecl(_, _, _, _, body, _) => collectExprSpans(body)
    case ImplDecl(_, _, _, methods) => collectImplMethodExprSpans(methods, 0)
    case LetDecl(bind) => collectExprSpans(bind.Value)
    case VarDecl(bind) => collectExprSpans(bind.Value)
    case _ => []
  end
end

func collectImplMethodExprSpans(methods: Slice[ast2.ImplMethod], index: Int) -> Slice[NodeSpan]
  if index >= methods.Len() then []
  else
    let method = methods.Get(index).UnwrapOr(ast2.ImplMethod { Pos: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, Sig: ast2.FuncSig { Pos: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, Name: "", TypeParams: [], Params: [], Ret: None, RetSpan: emptySpan(), Using: [] }, Body: ast2.EmptyExpr() })
    joinSpans(withPath(collectExprSpans(method.Body), [-2, index]), collectImplMethodExprSpans(methods, index + 1))
  end
end

func withPath(items: Slice[NodeSpan], path: Slice[Int]) -> Slice[NodeSpan]
  items.Map(func(item: NodeSpan) -> NodeSpan NodeSpan { Path: joinPath(path, item.Path), Kind: item.Kind, Span: item.Span } end)
end

func joinPath(left: Slice[Int], right: Slice[Int]) -> Slice[Int]
  if right.Len() == 0 then
    left
  else
    joinPath(left.Append(right.Get(0).UnwrapOr(0)), right.Slice(1, right.Len()).UnwrapOr([]))
  end
end

func collectExprSpans(expr: ast2.Expr) -> Slice[NodeSpan]
  let current = [NodeSpan { Path: [], Kind: exprSpanKind(expr.Kind), Span: effectiveExprSpan(expr) }]
  joinSpans(current, collectKindSpans(expr.Kind))
end

func effectiveExprSpan(expr: ast2.Expr) -> ast2.SourceSpan
  if expr.Span.Start.Line > 0 then expr.Span
  else
    switch expr.Kind
      case BlockExpr(stmts) => statementListSpan(stmts)
      case SwitchExpr(target, cases, _) => switchExprSpan(target, cases)
      case _ => expr.Span
    end
  end
end

func switchExprSpan(target: ast2.Expr, cases: Slice[ast2.SwitchCase]) -> ast2.SourceSpan
  let caseSpan = caseListSpan(cases)
  ast2.SourceSpan { Start: if target.Span.Start.Line > 0 then target.Span.Start else caseSpan.Start end, End: caseSpan.End }
end

func statementListSpan(stmts: Slice[ast2.Stmt]) -> ast2.SourceSpan
  let spans = collectStmtSpans(stmts, 0)
  spanListBounds(spans)
end

func caseListSpan(cases: Slice[ast2.SwitchCase]) -> ast2.SourceSpan
  let spans = collectCaseSpans(cases, 0)
  spanListBounds(spans)
end

func spanListBounds(items: Slice[NodeSpan]) -> ast2.SourceSpan
  if items.Len() == 0 then ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, End: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 } }
  else
    let first = items.Get(0).UnwrapOr(NodeSpan { Path: [], Kind: "", Span: ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, End: ast2.SourcePos { Line: 0, Column: 0, SourceName: "" } } })
    let last = items.Get(items.Len() - 1).UnwrapOr(first)
    ast2.SourceSpan { Start: first.Span.Start, End: last.Span.End }
  end
end

func exprSpanKind(kind: ast2.ExprKind) -> String
  switch kind
    case NumberExpr(_) => "literal"
    case StringExpr(_) => "literal"
    case RuneExpr(_) => "literal"
    case SwitchExpr(_, _, _) => "switch"
    case IfExpr(_, _, _) => "if"
    case FuncLitExpr(_, _, _) => "func-lit"
    case BlockExpr(_) => "block"
    case SliceLitExpr(_) => "delimited:slice"
    case SetLitExpr(_) => "delimited:set"
    case TupleExpr(_) => "delimited:tuple"
    case CallExpr(_, _, _) => "delimited:call"
    case StructLitExpr(_, _) => "delimited:struct"
    case GenericStructLitExpr(_, _, _) => "delimited:struct"
    case InlineGoExpr(_, _, _, _) => "inline-go"
    case _ => "expr"
  end
end

func collectDelimitedSpans(items: Slice[NodeSpan], tokens: Slice[ps.PositionedToken], index: Int) -> Slice[DelimitedSpan]
  if index >= items.Len() then []
  else
    let item = items.Get(index).UnwrapOr(NodeSpan { Path: [], Kind: "", Span: emptySpan() })
    let current = delimitedSpanForNode(item, tokens)
    let rest = collectDelimitedSpans(items, tokens, index + 1)
    switch current
      case Some(value) => joinDelimited([value], rest)
      case None => rest
    end
  end
end

func delimitedSpanForNode(item: NodeSpan, tokens: Slice[ps.PositionedToken]) -> Option[DelimitedSpan]
  let pair = delimiterPair(item.Kind)
  switch pair
    case Some(delimiters) =>
      let children = delimitedChildSpans(tokens, item.Span, delimiters.F0, delimiters.F1)
      if !delimitedSpanWorthReporting(item.Span, children) then None
      else Some(DelimitedSpan { Kind: item.Kind, Span: item.Span, Items: children, Separators: topLevelSeparators(tokens, item.Span, delimiters.F0, delimiters.F1, 0) }) end
    case None => None
  end
end

# A delimited span is reported when it has something the formatter can act on:
# either several top-level items (the wrap pass splits those) or a line break
# between its delimiters.  The interior rows of a hand-written multiline literal
# are lifted one level by the formatter's item indent, and that projection only
# sees spans the parser reports, so a multiline literal holding a single item (a
# one-argument call such as `ps.PChoice([` ... `])`, a one-element list) must be
# reported too - otherwise its anchor row stays at the enclosing indent and the
# whole literal reads one level shallow.  A same-line span with a single item has
# no interior rows to lift and is dropped, keeping the wrap pass scans small.
func delimitedSpanWorthReporting(span: ast2.SourceSpan, children: Slice[ast2.SourceSpan]) -> Bool
  children.Len() >= 1 && (children.Len() >= 2 || span.Start.Line < span.End.Line)
end

func delimiterPair(kind: String) -> Option[(String, String)]
  if kind == "delimited:slice" || kind == "delimited:set" then Some(("[", "]"))
  elsif kind == "delimited:tuple" || kind == "delimited:call" then Some(("(", ")"))
  elsif kind == "delimited:struct" then Some(("{", "}"))
  else None end
end

func topLevelSeparators(tokens: Slice[ps.PositionedToken], span: ast2.SourceSpan, open: String, close: String, index: Int) -> Slice[ast2.SourceSpan]
  let start = firstTokenInSpan(tokens, span, open)
  if start < 0 then []
  else
    let finish = matchingDelimiter(tokens, start, open, close, 0)
    if finish < 0 then [] else separatorTokens(tokens, start + 1, finish, 0, index, startLiteralScan()) end
  end
end

func separatorTokens(tokens: Slice[ps.PositionedToken], index: Int, finish: Int, depth: Int, origin: Int, scan: LiteralScan) -> Slice[ast2.SourceSpan]
  if index >= finish then []
  else
    let token = tokens.Get(index).UnwrapOr(ps.PositionedToken { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } })
    let nextScan = advanceLiteralScan(scan, token)
    let bare = literalTokenIsBare(scan, nextScan)
    let nextDepth = if bare && (token.Raw == "[" || token.Raw == "(" || token.Raw == "{") then depth + 1 elsif bare && (token.Raw == "]" || token.Raw == ")" || token.Raw == "}") then depth - 1 else depth end
    let current = if bare && token.Raw == "," && depth == 0 then [tokenRangeSpan(tokens, index, index)] else [] end
    joinSpanList(current, separatorTokens(tokens, index + 1, finish, nextDepth, origin, nextScan))
  end
end

func joinSpanList(left: Slice[ast2.SourceSpan], right: Slice[ast2.SourceSpan]) -> Slice[ast2.SourceSpan]
  if right.Len() == 0 then left else joinSpanList(left.Append(right.Get(0).UnwrapOr(emptySpan())), right.Slice(1, right.Len()).UnwrapOr([])) end
end

func joinDelimited(left: Slice[DelimitedSpan], right: Slice[DelimitedSpan]) -> Slice[DelimitedSpan]
  if right.Len() == 0 then left else joinDelimited(left.Append(right.Get(0).UnwrapOr(DelimitedSpan { Kind: "", Span: emptySpan(), Items: [], Separators: [] })), right.Slice(1, right.Len()).UnwrapOr([])) end
end

func collectKindSpans(kind: ast2.ExprKind) -> Slice[NodeSpan]
  switch kind
    case CallExpr(callee, _, args) => joinSpans(withPath(collectExprSpans(callee), [0]), collectExprListSpans(args, 0))
    case DictionaryCallExpr(_, callee, args) => joinSpans(withPath(collectExprSpans(callee), [0]), collectExprListSpans(args, 1))
    case FieldExpr(base, _) => withPath(collectExprSpans(base), [0])
    case UnaryExpr(_, inner) => withPath(collectExprSpans(inner), [0])
    case BinaryExpr(_, left, right) => joinSpans(withPath(collectExprSpans(left), [0]), withPath(collectExprSpans(right), [1]))
    case IfExpr(cond, yes, no) =>
      switch optionalElseExpr(no)
        case Some(elseExpr) =>
          # Always emit the `if-else` node span (path `[2]`) so the formatter can close
          # the then-branch at the `else` row (via `siblingElseLine`), even when the
          # else-branch is itself a block `if`. An `elsif` link shares this AST shape but
          # has no `else` keyword; `collectLayoutEvents` drops its `if-else` event pair so
          # the `transition:if-elsif` machinery keeps driving the chain unchanged.
          joinSpans(joinSpans(withPath(collectExprSpans(cond), [0]), collectBranchSpans(yes, Some(elseExpr))), withPath(collectExprSpans(elseExpr), [2]))
        case None => joinSpans(withPath(collectExprSpans(cond), [0]), collectBranchSpans(yes, None))
      end
    case BlockExpr(stmts) => collectStmtSpans(stmts, 0)
    case SwitchExpr(target, cases, _) => joinSpans(withPath(collectExprSpans(target), [0]), collectCaseSpans(cases, 0))
    case FuncLitExpr(_, _, body) => withPath(collectExprSpans(body), [0])
    case SliceLitExpr(items) => collectExprListSpans(items, 0)
    case TypeAsExpr(value, _) => withPath(collectExprSpans(value), [0])
    case StructLitExpr(_, fields) => collectFieldExprSpans(fields, 0)
    case GenericStructLitExpr(_, _, fields) => collectFieldExprSpans(fields, 0)
    case MapLitExpr(pairs) => collectPairExprSpans(pairs, 0)
    case SetLitExpr(items) => collectExprListSpans(items, 0)
    case TupleExpr(items) => collectExprListSpans(items, 0)
    case InlineGoExpr(_, _, operands, _) => collectOperandExprSpans(operands, 0)
    case _ => []
  end
end

func collectOperandExprSpans(items: Slice[ast2.GoOperand], index: Int) -> Slice[NodeSpan]
  if index >= items.Len() then []
  else
    let item = items.Get(index).UnwrapOr(ast2.GoOperand { Name: "", Value: ast2.EmptyExpr() })
    joinSpans(withPath(collectExprSpans(item.Value), [index]), collectOperandExprSpans(items, index + 1))
  end
end

func optionalElseExpr(expr: ast2.Expr) -> Option[ast2.Expr]
  switch expr.Kind
    case UnitExpr => if expr.Pos.Line <= 0 then None else Some(expr) end
    case _ => Some(expr)
  end
end

func collectBranchSpans(yes: ast2.Expr, no: Option[ast2.Expr]) -> Slice[NodeSpan]
  let thenSpan = NodeSpan { Path: [1], Kind: "if-then", Span: effectiveExprSpan(yes) }
  let thenItems = joinSpans([thenSpan], withPath(collectExprSpans(yes), [1]))
  switch no
    case Some(elseExpr) => joinSpans(thenItems, [NodeSpan { Path: [2], Kind: "if-else", Span: effectiveExprSpan(elseExpr) }])
    case None => thenItems
  end
end

func collectCaseSpans(items: Slice[ast2.SwitchCase], index: Int) -> Slice[NodeSpan]
  if index >= items.Len() then []
  else
    switch items.Get(index)
      case None => collectCaseSpans(items, index + 1)
      case Some(item) =>
        let bodySpans = withPath(collectExprSpans(item.Body), [index])
        let bodySpan = NodeSpan { Path: [index, -1], Kind: "case-body", Span: effectiveExprSpan(item.Body) }
        let patternSpans = withPath(collectPatternSpans(item.Pattern, item.PatternSpan, []), [index, 0])
        let caseStart = if item.PatternSpan.Start.Line > 0 then item.PatternSpan.Start else item.Span.Start end
        let caseSpan = NodeSpan { Path: [index], Kind: "case", Span: ast2.SourceSpan { Start: caseStart, End: effectiveExprSpan(item.Body).End } }
        joinSpans(joinSpans(joinSpans([caseSpan], [bodySpan]), patternSpans), joinSpans(bodySpans, collectCaseSpans(items, index + 1)))
    end
  end
end

func collectFieldExprSpans(items: Slice[ast2.StructLitField], index: Int) -> Slice[NodeSpan]
  if index >= items.Len() then []
  else
    let item = items.Get(index).UnwrapOr(ast2.StructLitField { Name: "", Value: ast2.EmptyExpr() })
    joinSpans(withPath(collectExprSpans(item.Value), [index]), collectFieldExprSpans(items, index + 1))
  end
end

func collectPairExprSpans(items: Slice[(ast2.Expr, ast2.Expr)], index: Int) -> Slice[NodeSpan]
  if index >= items.Len() then []
  else
    let item = items.Get(index).UnwrapOr((ast2.EmptyExpr(), ast2.EmptyExpr()))
    joinSpans(joinSpans(withPath(collectExprSpans(item.F0), [index, 0]), withPath(collectExprSpans(item.F1), [index, 1])), collectPairExprSpans(items, index + 1))
  end
end

func collectExprListSpans(items: Slice[ast2.Expr], index: Int) -> Slice[NodeSpan]
  if index >= items.Len() then
    []
  else
    joinSpans(withPath(collectExprSpans(items.Get(index).UnwrapOr(ast2.EmptyExpr())), [index]), collectExprListSpans(items, index + 1))
  end
end

func joinSpans(left: Slice[NodeSpan], right: Slice[NodeSpan]) -> Slice[NodeSpan]
  if right.Len() == 0 then
    left
  else
    joinSpans(left.Append(right.Get(0).UnwrapOr(NodeSpan { Path: [], Kind: "", Span: ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, End: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 } } })), right.Slice(1, right.Len()).UnwrapOr([]))
  end
end

func collectStmtSpans(items: Slice[ast2.Stmt], index: Int) -> Slice[NodeSpan]
  if index >= items.Len() then []
  else
    let stmt = items.Get(index).UnwrapOr(ast2.Stmt.ReturnStmt)
    let current = switch stmt
      case ExprStmt(expr) => joinSpans([stmtSpan("expr", expr)], collectExprSpans(expr))
      case LetStmt(bind) => joinSpans([stmtSpan("let", bind.Value)], collectExprSpans(bind.Value))
      case VarStmt(bind) => joinSpans([stmtSpan("var", bind.Value)], collectExprSpans(bind.Value))
      case WhileStmt(cond, body) =>
        let span = ast2.SourceSpan { Start: effectiveExprSpan(cond).Start, End: effectiveExprSpan(body).End }
        joinSpans(joinSpans([NodeSpan { Path: [], Kind: "while", Span: span }], withPath(collectExprSpans(cond), [0])), withPath(collectExprSpans(body), [1]))
      case AssignStmt(left, right) => joinSpans(joinSpans([stmtSpan("assign", left)], collectExprSpans(left)), collectExprSpans(right))
      case ReturnWithStmt(expr) => joinSpans([stmtSpan("return", expr)], collectExprSpans(expr))
      case LetRecStmt(bindings) => collectLetRecSpans(bindings, 0)
      case TupleLetStmt(_, expr) => joinSpans([stmtSpan("tuple-let", expr)], collectExprSpans(expr))
      case _ => []
    end
    joinSpans(withPath(current, [index]), collectStmtSpans(items, index + 1))
  end
end

func stmtSpan(kind: String, expr: ast2.Expr) -> NodeSpan
  NodeSpan { Path: [], Kind: "stmt:" + kind, Span: effectiveExprSpan(expr) }
end

func collectLetRecSpans(items: Slice[ast2.LetRecBind], index: Int) -> Slice[NodeSpan]
  if index >= items.Len() then []
  else
    switch items.Get(index)
      case Some(item) =>
        let typeNode = NodeSpan { Path: [index, 0], Kind: "type", Span: item.TypeSpan }
        joinSpans(joinSpans([typeNode], withPath(collectExprSpans(item.Value), [index])), collectLetRecSpans(items, index + 1))
      case None => collectLetRecSpans(items, index + 1)
    end
  end
end

func finishFile(file: ast2.File, tokens: Slice[ps.PositionedToken]) -> ast2.File
  ast2.File {
    PackageName: file.PackageName,
    Decls: file.Decls.Map(func(decl: ast2.Decl) -> ast2.Decl
      finishDecl(decl, tokens)
    end),
    SourceName: file.SourceName,
    Line: file.Line,
    Column: file.Column,
    DeclPositions: file.DeclPositions,
    Span: file.Span
  }
end

func finishDecl(decl: ast2.Decl, tokens: Slice[ps.PositionedToken]) -> ast2.Decl
  switch decl
    case FuncDecl(name, tps, params, ret, body, constraints) => ast2.Decl.FuncDecl(name, tps, params, ret, finishExpr(body, tokens), constraints)
    case ImplDecl(tps, target, iface, methods) => ast2.Decl.ImplDecl(tps, target, iface, methods.Map(func(method: ast2.ImplMethod) -> ast2.ImplMethod ast2.ImplMethod { Pos: method.Pos, Sig: method.Sig, Body: finishExpr(method.Body, tokens) } end))
    case LetDecl(bind) => ast2.Decl.LetDecl(finishBind(bind, tokens))
    case VarDecl(bind) => ast2.Decl.VarDecl(finishBind(bind, tokens))
    case _ => decl
  end
end

func finishBind(bind: ast2.Bind, tokens: Slice[ps.PositionedToken]) -> ast2.Bind
  let value = finishExpr(bind.Value, tokens)
  ast2.Bind { Name: bind.Name, Type: bind.Type, TypeSpan: bind.TypeSpan, Value: value, Span: value.Span }
end

func finishExpr(expr: ast2.Expr, tokens: Slice[ps.PositionedToken]) -> ast2.Expr
  let kind = finishKind(expr.Kind, tokens)
  let startPos = finishExprStart(expr, tokens)
  let endPos = finishExprEnd(ast2.Expr { ID: expr.ID, Pos: expr.Pos, Span: ast2.SourceSpan { Start: startPos, End: expr.Span.End }, Kind: kind, Type: expr.Type }, tokens)
  ast2.Expr { ID: expr.ID, Pos: expr.Pos, Span: ast2.SourceSpan { Start: startPos, End: endPos }, Kind: kind, Type: expr.Type }
end

func finishExprStart(expr: ast2.Expr, tokens: Slice[ps.PositionedToken]) -> ast2.SourcePos
  switch expr.Kind
    case SliceLitExpr(_) => delimiterStart(expr.Span.Start, tokens, "[", 0)
    case SetLitExpr(_) => delimiterStart(expr.Span.Start, tokens, "{", 0)
    case TupleExpr(_) => delimiterStart(expr.Span.Start, tokens, "(", 0)
    case CallExpr(_, _, _) => delimiterStart(expr.Span.Start, tokens, "(", 0)
    case StructLitExpr(_, _) => delimiterStart(expr.Span.Start, tokens, "{", 0)
    case GenericStructLitExpr(_, _, _) => delimiterStart(expr.Span.Start, tokens, "{", 0)
    case InlineGoExpr(_, _, _, _) => expr.Pos
    case _ => expr.Span.Start
  end
end

func delimiterStart(start: ast2.SourcePos, tokens: Slice[ps.PositionedToken], raw: String, index: Int) -> ast2.SourcePos
  let found = delimiterTokenAt(start, tokens, raw, index)
  if found < 0 then start else tokens.Get(found).Map(func(token: ps.PositionedToken) -> ast2.SourcePos ast2.SourcePos { SourceName: "", Line: token.Span.Start.Line, Column: token.Span.Start.Column } end).UnwrapOr(start) end
end

func finishExprEnd(expr: ast2.Expr, tokens: Slice[ps.PositionedToken]) -> ast2.SourcePos
  switch expr.Kind
    case BlockExpr(stmts) => blockExprEnd(stmts, expr.Span.End, 0)
    case SliceLitExpr(_) => closingDelimiterEnd(expr.Span.Start, tokens, "[", "]", 0)
    case SetLitExpr(_) => closingDelimiterEnd(expr.Span.Start, tokens, "{", "}", 0)
    case TupleExpr(_) => closingDelimiterEnd(expr.Span.Start, tokens, "(", ")", 0)
    case CallExpr(_, _, _) => closingDelimiterEnd(expr.Span.Start, tokens, "(", ")", 0)
    case StructLitExpr(_, _) => closingDelimiterEnd(expr.Span.Start, tokens, "{", "}", 0)
    case GenericStructLitExpr(_, _, _) => closingDelimiterEnd(expr.Span.Start, tokens, "{", "}", 0)
    case InlineGoExpr(_, _, _, _) => closingDelimiterEnd(expr.Span.Start, tokens, "{", "}", 0)
    case SwitchExpr(target, cases, _) => switchExprSpan(target, cases).End
    case IfExpr(_, yes, no) => branchExprEnd(yes, no, expr.Span.End, tokens)
    case _ => tokenEnd(expr.Span.Start, tokens)
  end
end

# Composite conditionals own their branches: the expression ends where its
# last branch ends, never at the header keyword token.
func branchExprEnd(yes: ast2.Expr, no: ast2.Expr, fallback: ast2.SourcePos, tokens: Slice[ps.PositionedToken]) -> ast2.SourcePos
  let yesEnd = effectiveExprSpan(yes).End
  let noEnd = effectiveExprSpan(no).End
  if noEnd.Line > 0 && (noEnd.Line > yesEnd.Line || (noEnd.Line == yesEnd.Line && noEnd.Column > yesEnd.Column)) then noEnd
  elsif yesEnd.Line > 0 then yesEnd
  elsif fallback.Line > 0 then fallback
  else tokenEnd(exprStartForEnd(yes, tokens), tokens) end
end

func exprStartForEnd(expr: ast2.Expr, tokens: Slice[ps.PositionedToken]) -> ast2.SourcePos
  if expr.Span.Start.Line > 0 then expr.Span.Start else expr.Pos end
end

func blockExprEnd(stmts: Slice[ast2.Stmt], fallback: ast2.SourcePos, index: Int) -> ast2.SourcePos
  if index >= stmts.Len() then fallback
  else
    let item = stmts.Get(index).UnwrapOr(ast2.Stmt.ReturnStmt)
    let next = blockExprEnd(stmts, fallback, index + 1)
    let span = stmtFinishedSpan(item)
    if next.Line > 0 then next else span.End end
  end
end

func stmtFinishedSpan(stmt: ast2.Stmt) -> ast2.SourceSpan
  switch stmt
    case ExprStmt(expr) => expr.Span
    case LetStmt(bind) => bind.Span
    case VarStmt(bind) => bind.Span
    case WhileStmt(cond, body) => ast2.SourceSpan { Start: effectiveExprSpan(cond).Start, End: effectiveExprSpan(body).End }
    case AssignStmt(_, right) => right.Span
    case ReturnWithStmt(expr) => expr.Span
    case TupleLetStmt(_, expr) => expr.Span
    case _ => emptySpan()
  end
end

func closingDelimiterEnd(start: ast2.SourcePos, tokens: Slice[ps.PositionedToken], open: String, close: String, index: Int) -> ast2.SourcePos
  let opener = delimiterTokenAt(start, tokens, open, index)
  if opener < 0 then tokenEnd(start, tokens)
  else
    let closing = matchingDelimiter(tokens, opener, open, close, 0)
    if closing < 0 then tokenEnd(start, tokens)
    else closingTokenEnd(tokens.Get(closing).UnwrapOr(ps.PositionedToken { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } })) end
  end
end

func delimiterTokenAt(start: ast2.SourcePos, tokens: Slice[ps.PositionedToken], raw: String, index: Int) -> Int
  if index >= tokens.Len() then -1
  else
    let token = tokens.Get(index).UnwrapOr(ps.PositionedToken { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } })
    let afterStart = token.Span.Start.Line > start.Line || (token.Span.Start.Line == start.Line && token.Span.Start.Column >= start.Column)
    if token.Raw == raw && afterStart then index
    else delimiterTokenAt(start, tokens, raw, index + 1) end
  end
end

func closingTokenEnd(token: ps.PositionedToken) -> ast2.SourcePos
  ast2.SourcePos { SourceName: "", Line: token.Span.End.Line, Column: token.Span.End.Column }
end

func finishKind(kind: ast2.ExprKind, tokens: Slice[ps.PositionedToken]) -> ast2.ExprKind
  switch kind
    case CallExpr(callee, typeArgs, args) => ast2.ExprKind.CallExpr(finishExpr(callee, tokens), typeArgs, args.Map(func(item: ast2.Expr) -> ast2.Expr finishExpr(item, tokens) end))
    case FieldExpr(base, field) => ast2.ExprKind.FieldExpr(finishExpr(base, tokens), field)
    case UnaryExpr(op, inner) => ast2.ExprKind.UnaryExpr(op, finishExpr(inner, tokens))
    case BinaryExpr(op, left, right) => ast2.ExprKind.BinaryExpr(op, finishExpr(left, tokens), finishExpr(right, tokens))
    case IfExpr(cond, yes, no) => ast2.ExprKind.IfExpr(finishExpr(cond, tokens), finishExpr(yes, tokens), finishExpr(no, tokens))
    case BlockExpr(stmts) => ast2.ExprKind.BlockExpr(stmts.Map(func(item: ast2.Stmt) -> ast2.Stmt finishStmt(item, tokens) end))
    case FuncLitExpr(params, ret, body) => ast2.ExprKind.FuncLitExpr(params, ret, finishExpr(body, tokens))
    case SliceLitExpr(items) => ast2.ExprKind.SliceLitExpr(items.Map(func(item: ast2.Expr) -> ast2.Expr finishExpr(item, tokens) end))
    case TypeAsExpr(value, typ) => ast2.ExprKind.TypeAsExpr(finishExpr(value, tokens), typ)
    case SwitchExpr(target, cases, targetType) => ast2.ExprKind.SwitchExpr(finishExpr(target, tokens), cases.Map(func(item: ast2.SwitchCase) -> ast2.SwitchCase finishSwitchCase(item, tokens) end), targetType)
    case StructLitExpr(name, fields) => ast2.ExprKind.StructLitExpr(name, fields.Map(func(item: ast2.StructLitField) -> ast2.StructLitField ast2.StructLitField { Name: item.Name, Value: finishExpr(item.Value, tokens) } end))
    case GenericStructLitExpr(name, typeArgs, fields) => ast2.ExprKind.GenericStructLitExpr(name, typeArgs, fields.Map(func(item: ast2.StructLitField) -> ast2.StructLitField ast2.StructLitField { Name: item.Name, Value: finishExpr(item.Value, tokens) } end))
    case InlineGoExpr(typ, code, operands, typeOperands) => ast2.ExprKind.InlineGoExpr(typ, code, operands.Map(func(item: ast2.GoOperand) -> ast2.GoOperand ast2.GoOperand { Name: item.Name, Value: finishExpr(item.Value, tokens) } end), typeOperands)
    case MapLitExpr(pairs) => ast2.ExprKind.MapLitExpr(pairs.Map(func(item: (ast2.Expr, ast2.Expr)) -> (ast2.Expr, ast2.Expr) (finishExpr(item.F0, tokens), finishExpr(item.F1, tokens)) end))
    case SetLitExpr(items) => ast2.ExprKind.SetLitExpr(items.Map(func(item: ast2.Expr) -> ast2.Expr finishExpr(item, tokens) end))
    case _ => kind
  end
end

# Case body spans must follow the completed body expression, rather than the
# combinator state after trailing whitespace.  Otherwise an inline case can
# absorb the following `case` line and incorrectly open a layout level.
func finishSwitchCase(item: ast2.SwitchCase, tokens: Slice[ps.PositionedToken]) -> ast2.SwitchCase
  let body = finishExpr(item.Body, tokens)
  let start = if item.PatternSpan.Start.Line > 0 then item.PatternSpan.Start else item.Span.Start end
  let span = ast2.SourceSpan { Start: start, End: body.Span.End }
  ast2.SwitchCase { Pattern: item.Pattern, PatternSpan: item.PatternSpan, Body: body, BodySpan: body.Span, Span: span }
end

func finishStmt(stmt: ast2.Stmt, tokens: Slice[ps.PositionedToken]) -> ast2.Stmt
  switch stmt
    case ExprStmt(expr) => ast2.Stmt.ExprStmt(finishExpr(expr, tokens))
    case LetStmt(bind) => ast2.Stmt.LetStmt(finishBind(bind, tokens))
    case VarStmt(bind) => ast2.Stmt.VarStmt(finishBind(bind, tokens))
    case WhileStmt(cond, body) => ast2.Stmt.WhileStmt(finishExpr(cond, tokens), finishExpr(body, tokens))
    case AssignStmt(left, right) => ast2.Stmt.AssignStmt(finishExpr(left, tokens), finishExpr(right, tokens))
    case ReturnWithStmt(expr) => ast2.Stmt.ReturnWithStmt(finishExpr(expr, tokens))
    case _ => stmt
  end
end

func tokenEnd(pos: ast2.SourcePos, tokens: Slice[ps.PositionedToken]) -> ast2.SourcePos
  tokenEndAt(pos, tokens, 0)
end

func tokenEndAt(pos: ast2.SourcePos, tokens: Slice[ps.PositionedToken], index: Int) -> ast2.SourcePos
  if index >= tokens.Len() then
    pos
  else
    let token = tokens.Get(index).UnwrapOr(ps.PositionedToken { Kind: "", Raw: "", Span: ps.SourceSpan { Start: ps.Position { Offset: 0, Line: 0, Column: 0 }, End: ps.Position { Offset: 0, Line: 0, Column: 0 } } })
    if token.Span.Start.Line == pos.Line && token.Span.Start.Column == pos.Column then
      ast2.SourcePos { SourceName: pos.SourceName, Line: token.Span.End.Line, Column: token.Span.End.Column }
    else
      tokenEndAt(pos, tokens, index + 1)
    end
  end
end

func scanLossless(input: String) -> LosslessScan
  scanStep(ScanState { Input: input, Index: 0, Offset: 0, Line: 1, Column: 1, Tokens: [], Trivia: [], Literal: startLiteralScan() })
end

func scanStep(state: ScanState) -> LosslessScan using StringRuneIndex
  let raw = state.Input.Slice(state.Index, state.Index + 1).UnwrapOr("")
  if raw == "" then
    LosslessScan { Tokens: state.Tokens, Trivia: state.Trivia }
  else
    let width = (raw as Slice[Byte]).Len()
    let start = ps.Position { Offset: state.Offset, Line: state.Line, Column: state.Column }
    let next = advanceScan(state, raw, width)
    if raw == "#" && state.Literal.Quote == "" then
      scanComment(next, start, "#")
    elsif isSpace(raw) then
      emitTrivia(next, start, "whitespace", raw)
    elsif isWordChar(raw) then
      scanWord(next, start, raw)
    else
      emitToken(next, start, raw)
    end
  end
end

func isSpace(raw: String) -> Bool
  raw == " " || raw == "\t" || raw == "\r" || raw == "\n"
end

func isWordChar(raw: String) -> Bool
  (raw >= "a" && raw <= "z") || (raw >= "A" && raw <= "Z") || (raw >= "0" && raw <= "9") || raw == "_"
end

func advanceScan(state: ScanState, raw: String, width: Int) -> ScanState
  ScanState { Input: state.Input, Index: state.Index + 1, Offset: state.Offset + width, Line: if raw == "\n" then state.Line + 1 else state.Line end, Column: if raw == "\n" then 1 else state.Column + 1 end, Tokens: state.Tokens, Trivia: state.Trivia, Literal: state.Literal }
end

func emitTrivia(state: ScanState, start: ps.Position, kind: String, raw: String) -> LosslessScan
  let item = ps.PositionedTrivia { Kind: kind, Raw: raw, Span: ps.SourceSpan { Start: start, End: ps.Position { Offset: state.Offset, Line: state.Line, Column: state.Column } } }
  scanStep(ScanState { Input: state.Input, Index: state.Index, Offset: state.Offset, Line: state.Line, Column: state.Column, Tokens: state.Tokens, Trivia: state.Trivia.Append(item), Literal: state.Literal })
end

func scanComment(state: ScanState, start: ps.Position, raw: String) -> LosslessScan using StringRuneIndex
  let next = state.Input.Slice(state.Index, state.Index + 1).UnwrapOr("")
  if next == "" || next == "\n" then
    emitTrivia(state, start, "comment", raw)
  else
    scanComment(advanceScan(state, next, (next as Slice[Byte]).Len()), start, raw + next)
  end
end

func scanWord(state: ScanState, start: ps.Position, raw: String) -> LosslessScan using StringRuneIndex
  let next = state.Input.Slice(state.Index, state.Index + 1).UnwrapOr("")
  if next == "" || !isWordChar(next) then
    emitToken(state, start, raw)
  else
    scanWord(advanceScan(state, next, (next as Slice[Byte]).Len()), start, raw + next)
  end
end

func emitToken(state: ScanState, start: ps.Position, raw: String) -> LosslessScan
  let kind = if raw == "\"" || raw == "`" || raw == "'" => "literal" else "symbol"
  let item = ps.PositionedToken {
    Kind: kind,
    Raw: raw,
    Span: ps.SourceSpan {
      Start: start,
      End: ps.Position {
        Offset: state.Offset,
        Line: state.Line,
        Column: state.Column
      }
    }
  }
  scanStep(ScanState {
    Input: state.Input,
    Index: state.Index,
    Offset: state.Offset,
    Line: state.Line,
    Column: state.Column,
    Tokens: state.Tokens.Append(item),
    Trivia: state.Trivia,
    Literal: advanceLiteralScan(state.Literal, item)
  })
end
