package parser2

import os "go:os"
import strings "go:strings"
import testing "go:testing"
# Benchmarks pin the parse-stage cost so every optimization in
# openspec/changes/optimize-parser2-performance has a before/after number.
# Two shapes are measured at three sizes each: a pinned real source repeated
# 1x/4x/16x, and generated declaration-heavy input with 500/2000/8000
# declarations.  Run them with:
#
#   go test -run '^$' -bench 'Benchmark' -benchmem ./internal/mygo/parser2

func benchRealSource(b: Ref[testing.B], multiplier: Int) -> String
  switch os.ReadFile("testdata/bench_real.mygo.txt")
    case Err(err) then
      b.Fatalf("read benchmark fixture: %v", err)
      ""
    end
    case Ok(content) then
      "package bench\n\n" + strings.Repeat(content as String, multiplier)
    end
  end
end

func benchDeclarationSource(declarations: Int) -> String
  var parts: Slice[String] = ["package bench\n\n"]
  var index = 1
  while index <= declarations
    let suffix = index.ToString()
    parts = parts.Append("func fn" + suffix + "(a: Int, b: Int) -> Int => a + b * " + suffix + "\n\n")
    index = index + 1
  end
  strings.Join(parts, "")
end

# --- lexing ---

func BenchmarkLexSourceReal1x(b: Ref[testing.B]) -> ()
  benchLex(b, benchRealSource(b, 1))
end

func BenchmarkLexSourceReal4x(b: Ref[testing.B]) -> ()
  benchLex(b, benchRealSource(b, 4))
end

func BenchmarkLexSourceReal16x(b: Ref[testing.B]) -> ()
  benchLex(b, benchRealSource(b, 16))
end

func BenchmarkLexSourceDecls500(b: Ref[testing.B]) -> ()
  benchLex(b, benchDeclarationSource(500))
end

func BenchmarkLexSourceDecls2000(b: Ref[testing.B]) -> ()
  benchLex(b, benchDeclarationSource(2000))
end

func BenchmarkLexSourceDecls8000(b: Ref[testing.B]) -> ()
  benchLex(b, benchDeclarationSource(8000))
end

func benchLex(b: Ref[testing.B], source: String) -> ()
  var index = 0
  while index < b.N
    let _ = LexSource(source)
    index = index + 1
  end
end

# --- syntax parsing ---

func BenchmarkParseSyntaxReal1x(b: Ref[testing.B]) -> ()
  benchParseSyntax(b, benchRealSource(b, 1))
end

func BenchmarkParseSyntaxReal4x(b: Ref[testing.B]) -> ()
  benchParseSyntax(b, benchRealSource(b, 4))
end

func BenchmarkParseSyntaxReal16x(b: Ref[testing.B]) -> ()
  benchParseSyntax(b, benchRealSource(b, 16))
end

func BenchmarkParseSyntaxDecls500(b: Ref[testing.B]) -> ()
  benchParseSyntax(b, benchDeclarationSource(500))
end

func BenchmarkParseSyntaxDecls2000(b: Ref[testing.B]) -> ()
  benchParseSyntax(b, benchDeclarationSource(2000))
end

func BenchmarkParseSyntaxDecls8000(b: Ref[testing.B]) -> ()
  benchParseSyntax(b, benchDeclarationSource(8000))
end

func benchParseSyntax(b: Ref[testing.B], source: String) -> ()
  var index = 0
  while index < b.N
    let _ = ParseSyntaxAt("bench.mygo", source)
    index = index + 1
  end
end

# --- lowering ---

func BenchmarkLowerSyntaxReal1x(b: Ref[testing.B]) -> ()
  benchLowerSyntax(b, benchRealSource(b, 1))
end

func BenchmarkLowerSyntaxReal4x(b: Ref[testing.B]) -> ()
  benchLowerSyntax(b, benchRealSource(b, 4))
