func benchLowerSyntax(b: Ref[testing.B], source: String) -> ()
  let tree = ParseSyntaxAt("bench.mygo", source)
  var index = 0
  while index < b.N
    let _ = LowerSyntaxDiagnostic(tree)
    index = index + 1
  end
end

# --- whole parse stage, including ast2 identifier assignment ---

func BenchmarkParseFileReal1x(b: Ref[testing.B]) -> ()
  benchParseFile(b, benchRealSource(b, 1))
end

func BenchmarkParseFileReal4x(b: Ref[testing.B]) -> ()
  benchParseFile(b, benchRealSource(b, 4))
end

func BenchmarkParseFileReal16x(b: Ref[testing.B]) -> ()
