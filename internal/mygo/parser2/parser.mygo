package parser2

import strings "go:strings"
import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"

# A MyGO parser written in MyGO.
#
# The production parse path is the lossless CST: ParseSyntaxAt lexes and parses
# every input into a CST tree with recovery diagnostics, and LowerSyntax turns
# a diagnostic-free tree into ast2.  This file owns only that cutover surface
# plus the handful of small helpers the production CST/lowering and lossless
# metadata paths share.  The pre-cutover parsec combinators live in
# legacy_parser_test.mygo, which is excluded from the production build.

func emptySpan() -> ast2.SourceSpan
  ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, End: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 } }
end

func isSpace(raw: String) -> Bool
  raw == " " || raw == "\t" || raw == "\r" || raw == "\n"
end

func isWordChar(raw: String) -> Bool
  (raw >= "a" && raw <= "z") || (raw >= "A" && raw <= "Z") || (raw >= "0" && raw <= "9") || raw == "_"
end

func ParseFile(input: String) -> Result[ast2.File, String]
  ParseFileAt("<input>", input)
end

# ParseFileAt retains the source name in diagnostics.  Callers that compile a
# file should use this entry point so an editor or command-line user can jump
# directly to the malformed source.
#
# It lowers the lossless CST.  A source with any syntax diagnostic is rejected
# before lowering so the AST-producing API never returns a recovered tree; the
# legacy grammar in legacy_parser_test.mygo stays reachable as
# `parseFileLegacyAt` for the differential oracle only.
func ParseFileAt(sourceName: String, input: String) -> Result[ast2.File, String]
  let tree = ParseSyntaxAt(sourceName, input)
  if tree.Diagnostics.Len() != 0 then
    switch tree.Diagnostics.Get(0)
      case Some(diagnostic) => Err(syntaxDiagnosticError(sourceName, diagnostic))
      case None => Err(sourceName + ":1:1: parse error")
    end
  else
    LowerSyntax(tree)
  end
end

func isKeyword(value: String) -> Bool
  switch value
    case "package" => true
    case "import" => true
    case "enum" => true
    case "struct" => true
    case "interface" => true
    case "impl" => true
    case "func" => true
    case "if" => true
    case "then" => true
    case "elsif" => true
    case "else" => true
    case "switch" => true
    case "case" => true
    case "end" => true
    case "using" => true
    case "not" => true
    case "let" => true
    case "letrec" => true
    case "var" => true
    case "embed" => true
    case "while" => true
    case "break" => true
    case "continue" => true
    case "return" => true
    case "go" => true
    case "in" => true
    case "type" => true
    case "as" => true
    case "true" => true
    case "false" => true
    case _ => false
  end
end

func defaultImportAlias(path: String) -> String
  let parts = strings.Split(path, "/")
  if parts.Len() == 0 then
    path
  else
    switch parts.Get(parts.Len() - 1)
      case Some(part) => part
      case None => path
    end
  end
end

# syntaxDiagnosticError renders a CST recovery diagnostic in the same
# `source:line:column: parse error: expected ...` shape the compiler and CLI
# already surface, so the production CST route does not change how a caller
# reads a malformed input.
func syntaxDiagnosticError(sourceName: String, diagnostic: SyntaxDiagnostic) -> String
  let detail = if diagnostic.Expected.Len() == 0 then
    if diagnostic.Message == "" then "parse error" else "parse error: " + diagnostic.Message end
  else
    "parse error: expected " + strings.Join(diagnostic.Expected, " / ")
  end
  sourceName + ":" + diagnostic.Span.Start.Line.ToString() + ":" + diagnostic.Span.Start.Column.ToString() + ": " + detail
end
