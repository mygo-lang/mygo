func TestOptimizer3O0AndDeterminism(t: Ref[testing.T]) -> ()
  t.Helper()
  let pkg = optimizerPackage()
  let o0 = Run(pkg, 0)
  if ir3.DumpPackage(o0) != ir3.DumpPackage(pkg) then
    t.Fatal("O0 changed the IR")
  end
  let first = Run(pkg, 2)
  let second = Run(pkg, 2)
  if ir3.DumpPackage(first) != ir3.DumpPackage(second) then
    t.Fatal("optimizer pass order is not deterministic")
  end
  let (fixed, iterations) = RunToFixpoint(pkg, 2, 8)
  if iterations != 1 then
    t.Fatalf("identity passes should converge in one iteration, got %d", iterations)
  end
  if ir3.DumpPackage(fixed) != ir3.DumpPackage(pkg) then
    t.Fatal("identity fixpoint changed the IR")
  end
end

func optRefNew(value: ir3.Expr) -> ir3.Expr
  optExpr(ir3.ExprKind.ApplyExpr(
    Ref.new(optExpr(ir3.ExprKind.FieldNamedExpr(
      Ref.new(optExpr(ir3.ExprKind.VarExpr("Ref"))),
      "new"
    ))),
    [value],
    ir3.CallKind.Method,
    false,
    ir3.Effect.Foreign
  ))
end

func optRefCall(name: String) -> ir3.Expr
  optExpr(ir3.ExprKind.ApplyExpr(
    Ref.new(optExpr(ir3.ExprKind.FieldNamedExpr(
      Ref.new(optExpr(ir3.ExprKind.VarExpr(name))),
      "value"
    ))),
    [],
    ir3.CallKind.Method,
    false,
    ir3.Effect.Foreign
  ))
end

func optRefField(name: String) -> ir3.Expr
  optExpr(ir3.ExprKind.FieldNamedExpr(
    Ref.new(optExpr(ir3.ExprKind.VarExpr(name))),
    "value"
  ))
end

func TestUnbox3EliminatesNonEscapingRef(t: Ref[testing.T]) -> ()
  t.Helper()
  let body = optExpr(ir3.ExprKind.PrimExpr(
    "+",
    [optRefCall("r"), optRefField("r")],
    ir3.Effect.Pure
  ))
  let local = optExpr(ir3.ExprKind.LetExpr(
    "r",
    Ref.new(optRefNew(optExpr(ir3.ExprKind.VarExpr("n")))),
    Ref.new(body)
  ))
  let text = ir3.DumpPackage(Unbox3(optimizerPackageWithBody(local)))
  if strings.Contains(text, "Ref") || strings.Contains(text, "value") then
    t.Fatal("Unbox3 left the reference allocation in place:\n" + text)
  end
  if strings.Count(text, "var n") != 2 then
    t.Fatal("Unbox3 did not substitute every read:\n" + text)
  end
  if strings.Contains(ir3.DumpPackage(Unbox3(Unbox3(optimizerPackageWithBody(local)))), "Ref") then
    t.Fatal("Unbox3 reintroduced a reference on a second run")
  end
  if strings.Contains(ir3.DumpPackage(Run(optimizerPackageWithBody(local), 2)), "Ref") then
    t.Fatal("Unbox3 is not wired into the O2 pipeline")
  end
end

func TestUnbox3KeepsEscapingRef(t: Ref[testing.T]) -> ()
  t.Helper()
  let escaped = optExpr(ir3.ExprKind.LetExpr(
    "r",
    Ref.new(optRefNew(optExpr(ir3.ExprKind.VarExpr("n")))),
    Ref.new(optExpr(ir3.ExprKind.ApplyExpr(
      Ref.new(optExpr(ir3.ExprKind.VarExpr("consume"))),
      [optExpr(ir3.ExprKind.VarExpr("r"))],
      ir3.CallKind.Direct,
      false,
      ir3.Effect.Foreign
    )))
  ))
  let escapedText = ir3.DumpPackage(Unbox3(optimizerPackageWithBody(escaped)))
  if !strings.Contains(escapedText, "Ref") then
    t.Fatal("Unbox3 removed a reference that escapes into a call:\n" + escapedText)
  end
  let mutated = optExpr(ir3.ExprKind.LetExpr(
    "r",
    Ref.new(optRefNew(optExpr(ir3.ExprKind.VarExpr("n")))),
    Ref.new(optExpr(ir3.ExprKind.SetFieldNamedExpr(
      Ref.new(optExpr(ir3.ExprKind.VarExpr("r"))),
      "value",
      Ref.new(optExpr(ir3.ExprKind.ConstExpr("2")))
    )))
  ))
  let mutatedText = ir3.DumpPackage(Unbox3(optimizerPackageWithBody(mutated)))
  if !strings.Contains(mutatedText, "Ref") then
    t.Fatal("Unbox3 removed a mutated reference:\n" + mutatedText)
  end
  let shadowed = optExpr(ir3.ExprKind.LetExpr(
    "r",
    Ref.new(optRefNew(optExpr(ir3.ExprKind.VarExpr("n")))),
    Ref.new(optExpr(ir3.ExprKind.LetExpr(
      "n",
      Ref.new(optExpr(ir3.ExprKind.ConstExpr("9"))),
      Ref.new(optRefCall("r"))
    )))
  ))
  let shadowedText = ir3.DumpPackage(Unbox3(optimizerPackageWithBody(shadowed)))
  if !strings.Contains(shadowedText, "Ref") then
    t.Fatal("Unbox3 substituted under a rebinding of the allocated variable:\n" + shadowedText)
  end
end

func TestUnbox3PreservesEffectOfUnusedAllocation(t: Ref[testing.T]) -> ()
  t.Helper()
  let effectful = optExpr(ir3.ExprKind.LetExpr(
    "r",
    Ref.new(optRefNew(optExpr(ir3.ExprKind.ForeignExpr("sideEffect()", [], [], ir3.Effect.Foreign)))),
    Ref.new(optExpr(ir3.ExprKind.ConstExpr("1")))
  ))
  let text = ir3.DumpPackage(Unbox3(optimizerPackageWithBody(effectful)))
  if strings.Contains(text, "Ref") then
    t.Fatal("Unbox3 kept the unused reference cell:\n" + text)
  end
  if !strings.Contains(text, "sideEffect()") then
    t.Fatal("Unbox3 dropped the effectful allocated value:\n" + text)
  end
end
