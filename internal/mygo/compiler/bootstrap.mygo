package compiler
# Self-hosted bootstrap implementation.
#
# This source owns the bootstrap orchestration.  Go standard-library access is
# kept behind small FFI helpers; parsing, dependency traversal, external-decl
# aggregation, inference and code generation remain MyGO-level operations.

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import codegen2 "github.com/mygo-lang/mygo/internal/mygo/codegen2"
import parser2 "github.com/mygo-lang/mygo/internal/mygo/parser2"
import typeinference2 "github.com/mygo-lang/mygo/internal/mygo/typeinference2"

import fmt "go:fmt"
import os "go:os"
import filepath "go:path/filepath"
import sort "go:sort"
import strings "go:strings"
import time "go:time"

struct BootstrapState
  Compiling: Map[String, Bool]
  Compiled: Map[String, Slice[String]]
  SourcesCache: Map[String, BootstrapInputs]
  GenerateImportFiles: Bool
  Timing: Bool
  NoPrelude: Bool
  # Editor analyses may reuse parsed files across requests.  Compiler and CLI
  # callers leave both empty, so their behavior is unchanged.
  ParseCache: Option[Ref[EditorParseCache]]
  OverlayStamps: Map[String, String]
  # codegen3 rollout. When Codegen3 is set, generated Go is written below
  # OutputRoot/build/mygo3 instead of beside the .mygo sources, and the IR
  # optimizer runs at OptimizationLevel.
  Codegen3: Bool
  OptimizationLevel: Int
  OutputRoot: String
  # Content-addressed codegen3 cache. BuildRoot is a per-build staging area
  # inside the cache's temporary directory; ModuleRoot anchors relative paths;
  # ManifestPath records package -> generated-file mappings for the overlay.
  BuildRoot: String
  ModuleRoot: String
  ManifestPath: String
  EmitRoot: String
  CacheEnabled: Bool
  CacheRoot: String
  CompilerID: String
  GoInputsDigest: String
  PackageKeys: Map[String, String]
end

# BootstrapInputs pairs the per-file codegen inputs with the decl sources that
# feed the type-inference pass.  Mirrors bootstrap.go.bak's parallel slices.
struct BootstrapInputs
  Inputs: Slice[codegen2.SourceFileInput]
  Sources: Slice[typeinference2.PkgDeclSource]
end

# A directory can contain an ordinary package plus an external Go test
# package.  They must be inferred independently even though they produce Go
# files in the same directory.
struct BootstrapInputGroups
  Main: BootstrapInputs
  ExternalTest: BootstrapInputs
end

struct BootstrapGoPackageCollection
  Packages: Slice[typeinference2.GoPackageEntry]
  Seen: Map[String, Bool]
end

struct BootstrapImport
  Alias: String
  Path: String
  Origin: ast2.SourceSpan
end

func newBootstrapState(generateImportFiles: Bool, timing: Bool, noPrelude: Bool) -> BootstrapState
  BootstrapState {
    Compiling: {},
    Compiled: {},
    SourcesCache: {},
    GenerateImportFiles: generateImportFiles,
    Timing: timing,
    NoPrelude: noPrelude,
    ParseCache: None,
    OverlayStamps: {},
    Codegen3: false,
    OptimizationLevel: 0,
    OutputRoot: "",
    BuildRoot: "",
    ModuleRoot: "",
    ManifestPath: "",
    EmitRoot: "",
    CacheEnabled: false,
    CacheRoot: "",
    CompilerID: "",
    GoInputsDigest: "",
    PackageKeys: {},
  }
end

func emptyBootstrapInputs() -> BootstrapInputs
  BootstrapInputs { Inputs: [], Sources: [] }
end

func emptyBootstrapInputGroups() -> BootstrapInputGroups
  BootstrapInputGroups { Main: emptyBootstrapInputs(), ExternalTest: emptyBootstrapInputs() }
end

func emptyBootstrapGoPackageCollection() -> BootstrapGoPackageCollection
  BootstrapGoPackageCollection { Packages: [], Seen: {} }
end

func bootstrapTimingStart() -> Int64
  time.Now().UnixNano()
end

func bootstrapTimingLog(state: BootstrapState, stage: String, dir: String, started: Int64) -> ()
  if state.Timing then
    let _ = fmt.Fprintf(
      os.Stderr,
      "[bootstrap] %s %s: %s\n",
      stage,
      dir,
      (time.Now().UnixNano()-started) as time.Duration
    )
  else
    ()
  end
end

# Public bootstrap entry points.  The implementation below is intentionally
# state-threaded so imported packages can contribute typed external decls to
# their importers without falling back to the legacy compiler pipeline.
func compileDirBootstrapEntry(dir: String) -> Result[Slice[String], Error]
  compileDirBootstrapEntryWithTiming(dir, false)
end

func compileDirBootstrapEntryWithTiming(dir: String, timing: Bool) -> Result[Slice[String], Error]
  # The single-package API must return a usable transitive build, including
  # generated files for imported MyGO packages.
  compileDirBootstrapWithCodegen(dir, newBootstrapState(true, timing, false), true)
end

# Sharing one BootstrapState across the whole sync run lets prelude (and every
# other transitive dependency) be compiled exactly once.  In addition, the
# per-package import walk and the prelude handler only request *inference* of
# dependencies (no codegen and no write) because every package is a top-level
# sync target on its own; its .gen.go files are produced when the package
# itself is later processed by syncBootstrapDirs.
func syncBootstrapMyGO(root: String) -> Result[Slice[String], Error]
  syncBootstrapMyGOWithTiming(root, false)
end

func syncBootstrapMyGOWithTiming(root: String, timing: Bool) -> Result[Slice[String], Error]
  let dirs = bootstrapMygoDirs(root)
  switch dirs
    case Ok(items) => syncBootstrapDirs(items, 0, newBootstrapState(false, timing, false), [])
    case Err(err) => Err(err)
  end
end

func syncBootstrapMyGONoPrelude(root: String) -> Result[Slice[String], Error]
  let dirs = bootstrapMygoDirs(root)
  switch dirs
    case Ok(items) => syncBootstrapDirs(items, 0, newBootstrapState(false, false, true), [])
    case Err(err) => Err(err)
  end
end

# GenerateSourceAt convenience: parse one source file, then run the same
# prelude/Go-FFI external-context path used by package compilation.  The
# prelude is treated as an ordinary auto-imported package; no files are
# written.
func bootstrapGenerateSourceAt(sourceName: String, input: String) -> Result[String, Error]
  let cwd = bootstrapWorkingDir()
  switch cwd
    case Err(err) => Err(err)
    case Ok(dir) then
      let root = bootstrapWorkspaceRoot(dir)
      let workspaceRoot = if root == "" then
        dir
      else
        root
      end
      let parsed = bootstrapParseSourceDiagnostic("", sourceName, input)
      switch parsed
        case Err(msg) => bootstrapStringFailure(msg, "parse " + sourceName)
        case Ok(parsedInputs) then
          let groups = bootstrapSplitTestInputs(parsedInputs)
          let mainInputs = groups.Main
          switch mainInputs.Inputs.Get(0)
            case None then
              bootstrapStringFailure(
                ast2.NewDiagnostic("parse", "source-package", "source", "no non-test package"),
                sourceName
              )
            end
            case Some(input) then
              let isPrelude = input.File.PackageName == "prelude"
              let preludeResolved = bootstrapResolveImport(workspaceRoot, dir, "github.com/mygo-lang/mygo/prelude")
              switch preludeResolved
                case Err(err) => Err(bootstrapContext("resolve prelude", dir, err))
                case Ok(preludeDir) then
                  let state = newBootstrapState(true, false, false)
                  let preludeLoaded = bootstrapLoadCachedSourcesDiagnostic(preludeDir, state)
                  switch preludeLoaded
                    case Err(msg) => bootstrapStringFailure(msg, "prelude " + sourceName)
                    case Ok(prelude) then
                      let externalSources = if isPrelude then
                        [] as Slice[typeinference2.PkgDeclSource]
                      else
                        prelude.Sources
                      end
                      let sourceSets = appendBootstrapSources(mainInputs.Sources, externalSources)
                      let packagesRef = Ref.new(bootstrapCollectGoPackages(sourceSets))
                      let populated = bootstrapPopulateGoSignatures(workspaceRoot, packagesRef)
                      switch populated
                        case Err(err) => Err(bootstrapContext("Go FFI", sourceName, err))
                        case Ok(_) then
                          let inferred = typeinference2.InferPackageWithExternalDiagnostic(
                            mainInputs.Sources,
                            externalSources,
                            packagesRef.value(),
                            [] as Slice[typeinference2.MyGoPackageInfo]
                          )
                          switch inferred
                            case Err(msg) => bootstrapStringFailure(msg, "infer " + sourceName)
                            case Ok(info) then
                              let infoWithPackages = typeinference2.PackageInfo {
                                Env: info.Env,
                                Fields: info.Fields,
                                GoPackages: packagesRef.value(),
                                MyGoPackages: info.MyGoPackages,
                                Instances: info.Instances,
                                Solver: info.Solver,
                                TypedDecls: info.TypedDecls,
                                ExternalTypedDecls: info.ExternalTypedDecls,
                                TypedDeclSources: info.TypedDeclSources,
                                ExternalTypedDeclSources: info.ExternalTypedDeclSources,
                                ResolvedConstraintArgs: info.ResolvedConstraintArgs,
                              }
                              let generated = codegen2.GenerateDiagnostic(input.File, infoWithPackages)
                              switch generated
                                case Err(msg) then
                                  bootstrapStringFailure(msg, "generate " + sourceName)
                                end
                                case Ok(code) => Ok(code)
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

func bootstrapMygoDirs(root: String) -> Result[Slice[String], Error]
  go[Result[Slice[String], Error]] {
    code: "bootstrapOutcome(mygoDirs(root))"
    in root = root
  }
end

func syncBootstrapDirs(
  dirs: Slice[String],
  index: Int,
  state: BootstrapState,
  written: Slice[String]
) -> Result[Slice[String], Error]
  if index >= dirs.Len() then
    sort.Strings(written)
    Ok(written)
  else
    switch dirs.Get(index)
      case Some(dir) then
        switch compileDirBootstrapWithCodegen(dir, state, true)
          case Err(err) => Err(err)
          case Ok(files) then
            syncBootstrapDirs(dirs, index + 1, state, appendBootstrapStrings(written, files))
          end
        end
      end
      case None then
        bootstrapFilesFailure(
          ast2.NewDiagnostic(
            "load",
            "directory-index",
            "internal",
            "missing directory at index " + index.ToString()
          ),
          ""
        )
      end
    end
  end
end

# compileDirBootstrapMyGO is the inference-only entry point used while walking
# a package's imports.  The same package may be reached again as a top-level
# sync target, in which case the codegen path is taken from the start.
func compileDirBootstrapMyGO(dir: String, state: BootstrapState) -> Result[Slice[String], Error]
  compileDirBootstrapWithCodegen(dir, state, false)
end

func compileDirBootstrapWithCodegen(
  dir: String,
  state: BootstrapState,
  codegen: Bool
) -> Result[Slice[String], Error]
  let absolute = bootstrapAbsolutePath(dir)
  switch absolute
    case Err(err) => Err(err)
    case Ok(absDir) => compileAbsoluteBootstrapDir(absDir, state, codegen)
  end
end

func bootstrapAbsolutePath(path: String) -> Result[String, Error]
  filepath.Abs(path)
end

# compileAbsoluteBootstrapDir routes through the cache when the package has
# already been fully processed (codegen path).  When called as an inference
# dependency, only the parse + signature-collection side runs; the result is
# stored in SourcesCache but not in Compiled, so the sync loop still drives a
# full codegen pass for the same dir.
func compileAbsoluteBootstrapDir(
  dir: String,
  state: BootstrapState,
  codegen: Bool
) -> Result[Slice[String], Error]
  if codegen then
    switch state.Compiled.Get(dir)
      case Some(files) => Ok(files)
      case None then
        switch state.Compiling.Get(dir)
          case Some(v) then
            if v then
              bootstrapFilesFailure(
                ast2.NewDiagnostic("import", "import-cycle", "source", "import cycle at " + dir),
                ""
              )
            else
              compileUncachedBootstrapDir(dir, state, true)
            end
          end
          case _ => compileUncachedBootstrapDir(dir, state, true)
        end
      end
    end
  else
    switch state.SourcesCache.Get(dir)
      case Some(_) => Ok([])
      case None then
        switch state.Compiling.Get(dir)
          case Some(v) then
            if v then
              bootstrapFilesFailure(
                ast2.NewDiagnostic("import", "import-cycle", "source", "import cycle at " + dir),
                ""
              )
            else
              compileUncachedBootstrapDir(dir, state, false)
            end
          end
          case _ => compileUncachedBootstrapDir(dir, state, false)
        end
      end
    end
  end
end

# Parse the package, then expose the canonical prelude as an external MyGO
# package.  Its declarations take part in inference but are never merged into
# this package's sources or emitted declarations.
#
# When `codegen` is false the package is only being inspected because it is a
# dependency of another package being built.  In that case we run the same
# parse + inference + Go-FFI collection pipeline (so the dependency's
# declarations are visible to its importer) but we skip code generation and
# file emission.  The sync loop will eventually run the codegen path for
# every package on its own.
func compileUncachedBootstrapDir(
  dir: String,
  state: BootstrapState,
  codegen: Bool
) -> Result[Slice[String], Error]
  state.Compiling.Set(dir, true)
  let totalStarted = bootstrapTimingStart()
  let parserStarted = bootstrapTimingStart()
  let loaded = bootstrapLoadPackageSourcesDiagnostic(dir)
  switch loaded
    case Err(msg) then
      state.Compiling.Delete(dir)
      bootstrapFilesFailure(msg, "parse " + dir)
    end
    case Ok(inputs) then
      bootstrapTimingLog(state, "parser2", dir, parserStarted)
      let groups = bootstrapSplitTestInputs(inputs)
      let mainInputs = groups.Main
      if mainInputs.Inputs.Len() == 0 then
        state.Compiling.Delete(dir)
        bootstrapTimingLog(state, "total", dir, totalStarted)
        Ok([])
      else
        let root = bootstrapWorkspaceRoot(dir)
        let workspaceRoot = if root == "" => dir else root
        let preludeResolved = if state.NoPrelude then
          Ok(dir)
        else
          bootstrapResolveImport(workspaceRoot, dir, "github.com/mygo-lang/mygo/prelude")
        end
        switch preludeResolved
          case Err(err) then
            state.Compiling.Delete(dir)
            Err(bootstrapContext("resolve prelude", dir, err))
          end
          case Ok(preludeDir) then
            let preludeFiles = if dir == preludeDir then
              Ok([] as Slice[String])
            else
              compileDirBootstrapMyGO(preludeDir, state)
            end
            switch preludeFiles
              case Err(err) then
                state.Compiling.Delete(dir)
                Err(err)
              end
              case Ok(preludeWritten) then
                let preludeLoaded = bootstrapLoadCachedSourcesDiagnostic(preludeDir, state)
                switch preludeLoaded
                  case Err(msg) then
                    state.Compiling.Delete(dir)
                    bootstrapFilesFailure(msg, "prelude " + dir)
                  end
                  case Ok(prelude) then
                    # The prelude itself has no external prelude dependency.
                    # For every other package, its declarations stay external
                    # to inputs.Sources while their go: imports participate in
                    # FFI signature collection.
                    let externalSources = if dir == preludeDir then
                      [] as Slice[typeinference2.PkgDeclSource]
                    else
                      prelude.Sources
                    end
                    # Include the external test imports in FFI discovery, but
                    # infer its declarations only after the main unit below.
                    let packageSources = appendBootstrapSources(mainInputs.Sources, groups.ExternalTest.Sources)
                    let sourceSets = appendBootstrapSources(packageSources, externalSources)
                    let packagesRef = Ref.new(bootstrapCollectGoPackages(sourceSets))
                    let ffiStarted = bootstrapTimingStart()
                    let initialPopulated = bootstrapPopulateGoSignatures(workspaceRoot, packagesRef)
                    switch initialPopulated
                      case Err(err) then
                        state.Compiling.Delete(dir)
                        Err(bootstrapContext("Go FFI", dir, err))
                      end
                      case Ok(_) then
                        let walked = bootstrapWalkImports(
                          workspaceRoot,
                          dir,
                          bootstrapImportsFromSources(packageSources),
                          0,
                          state,
                          []
                        )
                        switch walked
                          case Err(err) then
                            state.Compiling.Delete(dir)
                            Err(err)
                          end
                          case Ok(dependencyFiles) then
                            let myGoPkgInfos = bootstrapCollectMyGoPkgInfos(
                              workspaceRoot,
                              dir,
                              bootstrapImportsFromSources(packageSources),
                              0,
                              state,
                              [] as Slice[typeinference2.MyGoPackageInfo]
                            )
                            # The importing package can use FFI types mentioned
                            # only by a dependency's public signatures (for
                            # example utils returning Result[io.ReadCloser, E]).
                            # Include those Go imports before inference so type
                            # annotations in imported package signatures keep
                            # their canonical go: paths.
                            let inferenceSources = bootstrapAppendMyGoPackageSources(sourceSets, myGoPkgInfos, 0)
                            let completePackagesRef = Ref.new(bootstrapCollectGoPackages(inferenceSources))
                            let finalPopulated = bootstrapPopulateGoSignatures(workspaceRoot, completePackagesRef)
                            switch finalPopulated
                              case Err(err) then
                                state.Compiling.Delete(dir)
                                Err(bootstrapContext("Go FFI", dir, err))
                              end
                              case Ok(_) then
                                bootstrapTimingLog(state, "imports+ffi", dir, ffiStarted)
                                let inferenceStarted = bootstrapTimingStart()
                                let inferred = bootstrapInferPackageWithDynamicAPIsDiagnostic(
                                  mainInputs,
                                  externalSources,
                                  completePackagesRef.value(),
                                  myGoPkgInfos
                                )
                                switch inferred
                                  case Err(msg) then
                                    state.Compiling.Delete(dir)
                                    bootstrapFilesFailure(msg, "infer " + dir)
                                  end
                                  case Ok(info) then
                                    bootstrapTimingLog(state, "typeinference2", dir, inferenceStarted)
                                    bootstrapFinishPackage(
                                      dir,
                                      state,
                                      codegen,
                                      mainInputs,
                                      groups.ExternalTest,
                                      info,
                                      completePackagesRef,
                                      preludeWritten,
                                      dependencyFiles,
                                      totalStarted
                                    )
                                  end
                                end
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

func bootstrapInferPackageWithDynamicAPIsDiagnostic(
  inputs: BootstrapInputs,
  externalSources: Slice[typeinference2.PkgDeclSource],
  goPackages: Slice[typeinference2.GoPackageEntry],
  myGoPackages: Slice[typeinference2.MyGoPackageInfo]
) -> Result[typeinference2.PackageInfo, ast2.Diagnostic]
  switch codegen2.DynamicDispatchDeclsDiagnostic(inputs.Inputs, myGoPackages)
    case Err(msg) => Err(msg)
    case Ok(dynamicDecls) then
      let visibleExternal = if dynamicDecls.Len() == 0 then
        externalSources
      else
        externalSources.Append(typeinference2.PkgDeclSource {
          Path: "<mygo-dynamic-api>",
          PackageImportPath: "",
          Decls: dynamicDecls,
        })
      end
      typeinference2.InferPackageWithExternalDiagnostic(
        inputs.Sources,
        visibleExternal,
        goPackages,
        myGoPackages
      )
    end
  end
end

# bootstrapFinishPackage drives the post-inference half of the bootstrap
# pipeline.  When the caller asked for inference only (codegen == false) we
# release the Compiling flag, leave the parsed sources cached for future
# re-use, and return an empty file list.  The sync loop will eventually
# revisit the same dir with codegen == true.
func bootstrapFinishPackage(
  dir: String,
  state: BootstrapState,
  codegen: Bool,
  inputs: BootstrapInputs,
  externalTest: BootstrapInputs,
  info: typeinference2.PackageInfo,
  packagesRef: Ref[Slice[typeinference2.GoPackageEntry]],
  preludeWritten: Slice[String],
  dependencyFiles: Slice[String],
  totalStarted: Int64
) -> Result[Slice[String], Error]
  if state.Codegen3 then
    bootstrapAssignPackageKey(dir, state, inputs)
  end
  if !codegen then
    state.Compiling.Delete(dir)
    bootstrapTimingLog(state, "total", dir, totalStarted)
    Ok([])
  elsif state.Codegen3 then
    bootstrapFinishCodegen3Package(
      dir,
      state,
      inputs,
      externalTest,
      info,
      packagesRef,
      preludeWritten,
      dependencyFiles,
      totalStarted
    )
  else
    let infoWithPackages = typeinference2.PackageInfo {
      Env: info.Env,
      Fields: info.Fields,
      GoPackages: packagesRef.value(),
      MyGoPackages: info.MyGoPackages,
      Instances: info.Instances,
      Solver: info.Solver,
      TypedDecls: info.TypedDecls,
      ExternalTypedDecls: info.ExternalTypedDecls,
      TypedDeclSources: info.TypedDeclSources,
      ExternalTypedDeclSources: info.ExternalTypedDeclSources,
      ResolvedConstraintArgs: info.ResolvedConstraintArgs,
    }
    let codegenStarted = bootstrapTimingStart()
    let generated = codegen2.GenerateFilesDiagnostic(inputs.Inputs, infoWithPackages)
    switch generated
      case Err(msg) then
        state.Compiling.Delete(dir)
        bootstrapFilesFailure(msg, "generate " + dir)
      end
      case Ok(files) then
        bootstrapTimingLog(state, "codegen2", dir, codegenStarted)
        let writeStarted = bootstrapTimingStart()
        let written = bootstrapWriteGenerated(dir, files)
        switch written
          case Err(err) then
            state.Compiling.Delete(dir)
            Err(bootstrapContext("write", dir, err))
          end
          case Ok(paths) then
            bootstrapFinishExternalTestPackage(
              dir,
              state,
              externalTest,
              info,
              packagesRef,
              preludeWritten,
              dependencyFiles,
              paths,
              writeStarted,
              totalStarted
            )
          end
        end
      end
    end
  end
end

# An external `name_test` package gets the already-typed main declarations as
# external context.  The generated dot import is metadata on its inputs, not
# a MyGO import, so dependency traversal never treats the package as importing
# itself.
func bootstrapFinishExternalTestPackage(
  dir: String,
  state: BootstrapState,
  externalTest: BootstrapInputs,
  mainInfo: typeinference2.PackageInfo,
  packagesRef: Ref[Slice[typeinference2.GoPackageEntry]],
  preludeWritten: Slice[String],
  dependencyFiles: Slice[String],
  mainPaths: Slice[String],
  writeStarted: Int64,
  totalStarted: Int64
) -> Result[Slice[String], Error]
  if externalTest.Inputs.Len() == 0 then
    bootstrapCompletePackage(
      dir,
      state,
      preludeWritten,
      dependencyFiles,
      mainPaths,
      writeStarted,
      totalStarted
    )
  else
    let inferred = typeinference2.InferPackageWithExternalInfoDiagnostic(
      externalTest.Sources,
      mainInfo,
      packagesRef.value(),
      [] as Slice[typeinference2.MyGoPackageInfo]
    )
    switch inferred
      case Err(msg) then
        state.Compiling.Delete(dir)
        bootstrapFilesFailure(msg, "infer external tests " + dir)
      end
      case Ok(info) then
        let generated = codegen2.GenerateFilesDiagnostic(externalTest.Inputs, info)
        switch generated
          case Err(msg) then
            state.Compiling.Delete(dir)
            bootstrapFilesFailure(msg, "generate external tests " + dir)
          end
          case Ok(files) then
            let written = bootstrapWriteGenerated(dir, files)
            switch written
              case Err(err) then
                state.Compiling.Delete(dir)
                Err(bootstrapContext("write external tests", dir, err))
              end
              case Ok(paths) then
                bootstrapCompletePackage(
                  dir,
                  state,
                  preludeWritten,
                  dependencyFiles,
                  appendBootstrapStrings(mainPaths, paths),
                  writeStarted,
                  totalStarted
                )
              end
            end
          end
        end
      end
    end
  end
end

func bootstrapCompletePackage(
  dir: String,
  state: BootstrapState,
  preludeWritten: Slice[String],
  dependencyFiles: Slice[String],
  paths: Slice[String],
  writeStarted: Int64,
  totalStarted: Int64
) -> Result[Slice[String], Error]
  switch bootstrapCleanupOutputs(dir, paths)
    case Err(err) then
      state.Compiling.Delete(dir)
      Err(err)
    end
    case Ok(_) then
      bootstrapRecordCompletePackage(
        dir,
        state,
        preludeWritten,
        dependencyFiles,
        paths,
        writeStarted,
        totalStarted
      )
    end
  end
end

func bootstrapRecordCompletePackage(
  dir: String,
  state: BootstrapState,
  preludeWritten: Slice[String],
  dependencyFiles: Slice[String],
  paths: Slice[String],
  writeStarted: Int64,
  totalStarted: Int64
) -> Result[Slice[String], Error]
  bootstrapTimingLog(state, "write", dir, writeStarted)
  let allFiles = appendBootstrapStrings(
    preludeWritten,
    appendBootstrapStrings(dependencyFiles, paths)
  )
  state.Compiled.Set(dir, allFiles)
  state.Compiling.Delete(dir)
  bootstrapTimingLog(state, "total", dir, totalStarted)
  Ok(allFiles)
end

func appendBootstrapStrings(left: Slice[String], right: Slice[String]) -> Slice[String]
  appendBootstrapStringsAt(left, right, 0)
end

func appendBootstrapStringsAt(
  left: Slice[String],
  right: Slice[String],
  index: Int
) -> Slice[String]
  if index >= right.Len() then
    left
  else
    switch right.Get(index)
      case Some(value) => appendBootstrapStringsAt(left.Append(value), right, index + 1)
      case None => left
    end
  end
end

# Walk the package's non-Go imports in declaration order.  For each one we
# (1) recursively compile the dependency, (2) read its MyGo package signatures
# from the already-parsed sources, and (3) append the entry to the running
# goPackages slice.  This mirrors bootstrap.go.bak's per-input import loop.
func bootstrapWalkImports(
  workspaceRoot: String,
  fromDir: String,
  imports: Slice[BootstrapImport],
  index: Int,
  state: BootstrapState,
  written: Slice[String]
) -> Result[Slice[String], Error]
  if index >= imports.Len() then
    Ok(written)
  else
    switch imports.Get(index)
      case None then
        bootstrapFilesFailure(
          ast2.NewDiagnostic(
            "import",
            "import-index",
            "internal",
            "missing import at index " + index.ToString()
          ),
          fromDir
        )
      end
      case Some(imp) then
        let resolved = bootstrapResolveImport(workspaceRoot, fromDir, imp.Path)
        switch resolved
          case Err(err) => Err(bootstrapImportContext(imp, err, true))
          case Ok(dependencyDir) then
            let dependencyBuild = if state.GenerateImportFiles then
              compileDirBootstrapWithCodegen(dependencyDir, state, true)
            else
              compileDirBootstrapMyGO(dependencyDir, state)
            end
            switch dependencyBuild
              case Err(err) => Err(bootstrapImportContext(imp, err, false))
              case Ok(files) then
                let loaded = bootstrapLoadCachedSourcesDiagnostic(dependencyDir, state)
                switch loaded
                  case Err(err) => Err(bootstrapImportContext(imp, bootstrapAsError(err), false))
                  case Ok(_) then
                    bootstrapWalkImports(
                      workspaceRoot,
                      fromDir,
                      imports,
                      index + 1,
                      state,
                      appendBootstrapStrings(written, files)
                    )
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

# Bootstrap source discovery: only the package's own files feed codegen2.
func bootstrapParseSourceDiagnostic(
  path: String,
  sourcePath: String,
  source: String
) -> Result[BootstrapInputs, ast2.Diagnostic]
  let parsed = parser2.ParseFileAtDiagnostic(sourcePath, source)
  switch parsed
    case Ok(file) then
      switch ast2.ValidateLoopControlDiagnostic(file)
        case Err(msg) => Err(msg)
        case Ok(_) then
          switch ast2.AssignFileExprIDs(file)
            case Some(typed) then
              let input = codegen2.NewSourceFileInput(sourcePath, typed)
              let packageImportPath = if strings.HasPrefix(sourcePath, "<") then
                ""
              else
                bootstrapCurrentPackageImport(sourcePath)
              end
              let withImportPath = if packageImportPath == "" then
                input
              else
                codegen2.SourceFileInputWithPackageImportPath(input, packageImportPath)
              end
              let pkg = typeinference2.PkgDeclSource {
                Path: sourcePath,
                PackageImportPath: packageImportPath,
                Decls: typed.Decls,
                DeclPositions: typed.DeclPositions,
              }
              Ok(BootstrapInputs { Inputs: [withImportPath], Sources: [pkg] })
            end
            case None then
              Err(ast2.NewDiagnostic(
                "parse",
                "ast-invariant",
                "internal",
                "malformed AST: missing indexed value while assigning expression IDs"
              ))
            end
          end
        end
      end
    end
    case Err(msg) => Err(msg)
  end
end

# The declared package name, not the filename, selects the Go package unit.
# Only `mainName_test` is external; an internal `*_test.mygo` file declaring
# `mainName` remains part of the main inference unit.
func bootstrapSplitTestInputs(inputs: BootstrapInputs) -> BootstrapInputGroups
  let mainName = bootstrapMainPackageName(inputs.Inputs, 0)
  bootstrapSplitTestInputsAt(inputs, mainName, 0, emptyBootstrapInputGroups())
end

func bootstrapMainPackageName(inputs: Slice[codegen2.SourceFileInput], index: Int) -> String
  if index >= inputs.Len() then
    ""
  else
    switch inputs.Get(index)
      case Some(input) then
        if input.File.PackageName.HasSuffix("_test") then
          bootstrapMainPackageName(inputs, index + 1)
        else
          input.File.PackageName
        end
      end
      case None => bootstrapMainPackageName(inputs, index + 1)
    end
  end
end

func bootstrapSplitTestInputsAt(
  inputs: BootstrapInputs,
  mainName: String,
  index: Int,
  groups: BootstrapInputGroups
) -> BootstrapInputGroups
  if index >= inputs.Inputs.Len() then
    groups
  else
    switch inputs.Inputs.Get(index)
      case Some(input) then
        switch inputs.Sources.Get(index)
          case Some(source) then
            if input.File.PackageName == mainName + "_test" then
              let externalInput = codegen2.SourceFileInputWithAutomaticImport(input, ".", bootstrapCurrentPackageImport(input.Path))
              let next = BootstrapInputGroups {
                Main: groups.Main,
                ExternalTest: BootstrapInputs {
                  Inputs: groups.ExternalTest.Inputs.Append(externalInput),
                  Sources: groups.ExternalTest.Sources.Append(source),
                },
              }
              bootstrapSplitTestInputsAt(inputs, mainName, index + 1, next)
            else
              let next = BootstrapInputGroups {
                Main: BootstrapInputs {
                  Inputs: groups.Main.Inputs.Append(input),
                  Sources: groups.Main.Sources.Append(source),
                },
                ExternalTest: groups.ExternalTest,
              }
              bootstrapSplitTestInputsAt(inputs, mainName, index + 1, next)
            end
          end
          case None => bootstrapSplitTestInputsAt(inputs, mainName, index + 1, groups)
        end
      end
      case None => bootstrapSplitTestInputsAt(inputs, mainName, index + 1, groups)
    end
  end
end

func bootstrapCurrentPackageImport(sourcePath: String) -> String
  let dir = filepath.Dir(sourcePath)
  switch bootstrapAbsolutePath(dir)
    case Err(_) => ""
    case Ok(absDir) then
      let root = bootstrapWorkspaceRoot(absDir)
      if root == "" then
        ""
      else
        switch bootstrapReadFileString(filepath.Join(root, "go.mod"))
          case Some(content) then
            let module = bootstrapGoModModulePath(content)
            switch bootstrapRelativePath(root, absDir)
              case Ok(rel) then
                let relSlash = filepath.ToSlash(rel)
                if relSlash == "." then
                  module
                else
                  module + "/" + relSlash
                end
              end
              case Err(_) => module
            end
          end
          case None => ""
        end
      end
    end
  end
end

func bootstrapReadDir(dir: String) -> Result[Slice[String], Error]
  switch os.ReadDir(dir)
    case Err(err) => Err(err)
    case Ok(entries) then
      var names = entries.Filter(func(entry: os.DirEntry) -> Bool
        !entry.IsDir() && strings.HasSuffix(entry.Name(), ".mygo")
      end).Map(func(entry: os.DirEntry) -> String
        entry.Name()
      end)
      sort.Strings(names)
      Ok(names)
    end
  end
end

func bootstrapReadFile(path: String) -> Result[String, Error]
  switch os.ReadFile(path)
    case Err(err) => Err(err)
    case Ok(raw) => Ok(raw as String)
  end
end

func bootstrapJoin(dir: String, name: String) -> String
  filepath.Join(dir, name)
end

func appendBootstrapSources(
  left: Slice[typeinference2.PkgDeclSource],
  right: Slice[typeinference2.PkgDeclSource]
) -> Slice[typeinference2.PkgDeclSource]
  appendBootstrapSourcesAt(left, right, 0)
end

func appendBootstrapSourcesAt(
  left: Slice[typeinference2.PkgDeclSource],
  right: Slice[typeinference2.PkgDeclSource],
  index: Int
) -> Slice[typeinference2.PkgDeclSource]
  if index >= right.Len() then
    left
  else
    switch right.Get(index)
      case Some(value) => appendBootstrapSourcesAt(left.Append(value), right, index + 1)
      case None => appendBootstrapSourcesAt(left, right, index + 1)
    end
  end
end

func bootstrapWorkingDir() -> Result[String, Error]
  os.Getwd()
end

func bootstrapRelativePath(cwd: String, path: String) -> Result[String, Error]
  filepath.Rel(cwd, path)
end

func bootstrapLoadInputsDiagnostic(
  dir: String,
  cwd: String,
  names: Slice[String],
  index: Int,
  out: BootstrapInputs
) -> Result[BootstrapInputs, ast2.Diagnostic]
  if index >= names.Len() then
    Ok(out)
  else
    switch names.Get(index)
      case None then
        Err(ast2.NewDiagnostic(
          "load",
          "source-index",
          "internal",
          "missing source name at index " + index.ToString()
        ))
      end
      case Some(name) then
        let path = bootstrapJoin(dir, name)
        let relative = bootstrapRelativePath(cwd, path)
        switch relative
          case Err(err) => Err(bootstrapOperation("read-source", path, err))
          case Ok(sourcePath) then
            let raw = bootstrapReadFile(path)
            switch raw
              case Err(err) => Err(bootstrapOperation("read-source", path, err))
              case Ok(source) then
                let parsed = bootstrapParseSourceDiagnostic(name, sourcePath, source)
                switch parsed
                  case Err(msg) => Err(msg)
                  case Ok(one) then
                    switch one.Inputs.Get(0)
                      case Some(input) then
                        let next = BootstrapInputs {
                          Inputs: out.Inputs.Append(input),
                          Sources: appendBootstrapSources(out.Sources, one.Sources),
                        }
                        bootstrapLoadInputsDiagnostic(dir, cwd, names, index + 1, next)
                      end
                      case None then
                        Err(ast2.NewDiagnostic("parse", "ast-invariant", "internal", "parsed source has no input"))
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

func bootstrapImportsFromSources(
  sources: Slice[typeinference2.PkgDeclSource]
) -> Slice[BootstrapImport]
  bootstrapImportsFromSourcesAt(sources, 0, [])
end

func bootstrapImportsFromSourcesAt(
  sources: Slice[typeinference2.PkgDeclSource],
  index: Int,
  out: Slice[BootstrapImport]
) -> Slice[BootstrapImport]
  if index >= sources.Len() then
    out
  else
    switch sources.Get(index)
      case Some(source) then
        bootstrapImportsFromSourcesAt(
          sources,
          index + 1,
          bootstrapImportsFromDecls(source.Decls, source.DeclPositions, 0, out)
        )
      end
      case None => out
    end
  end
end

func bootstrapImportsFromDecls(
  decls: Slice[ast2.Decl],
  positions: Slice[ast2.SourcePos],
  index: Int,
  out: Slice[BootstrapImport]
) -> Slice[BootstrapImport]
  if index >= decls.Len() then
    out
  else
    switch decls.Get(index)
      case Some(decl) then
        let next = switch decl
          case ImportDecl(alias, path) then
            if strings.HasPrefix(path, "go:") || alias == "." then
              out
            else
              out.Append(BootstrapImport {
                Alias: alias,
                Path: path,
                Origin: ast2.PointSpan(positions.Get(index).UnwrapOr(ast2.SourcePos {
                  SourceName: "",
                  Line: 0,
                  Column: 0,
                })),
              })
            end
          end
          case _ => out
        end
        bootstrapImportsFromDecls(decls, positions, index + 1, next)
      end
      case None => out
    end
  end
end

func bootstrapResolveImport(
  workspaceRoot: String,
  fromDir: String,
  importPath: String
) -> Result[String, Error]
  go[Result[String, Error]] {
    code: "bootstrapOutcome(resolveMyGoImport({workspaceRoot}, {fromDir}, {importPath}))"
    in workspaceRoot = workspaceRoot
    in fromDir = fromDir
    in importPath = importPath
  }
end

func bootstrapWorkspaceRoot(dir: String) -> String
  go[String] { code: "findGoModuleRoot(dir)" in dir = dir }
end

func bootstrapLoadPackageSourcesDiagnostic(dir: String) -> Result[BootstrapInputs, ast2.Diagnostic]
  let cwd = bootstrapWorkingDir()
  switch cwd
    case Err(err) => Err(bootstrapOperation("load", dir, err))
    case Ok(cwdPath) then
      let names = bootstrapReadDir(dir)
      switch names
        case Err(err) => Err(bootstrapOperation("load", dir, err))
        case Ok(items) then
          if items.Len() == 0 then
            go[Result[BootstrapInputs, Error]] {
              code: """bootstrapOutcome(bootstrapReadMetadataInputs({dir}))"""
              in dir = dir
            }.MapErr(func(err: Error) -> ast2.Diagnostic
              bootstrapOperation("read-metadata", dir, err)
            end)
          else
            bootstrapLoadInputsDiagnostic(dir, cwdPath, items, 0, emptyBootstrapInputs())
          end
        end
      end
    end
  end
end

func bootstrapLoadCachedSourcesDiagnostic(
  dir: String,
  state: BootstrapState
) -> Result[BootstrapInputs, ast2.Diagnostic]
  switch state.SourcesCache.Get(dir)
    case Some(inputs) => Ok(inputs)
    case None then
      switch bootstrapLoadPackageSourcesDiagnostic(dir)
        case Ok(inputs) =>
          state.SourcesCache.Set(dir, inputs)
          Ok(inputs)
        case Err(msg) => Err(msg)
      end
    end
  end
end

# Populate go: FFI entries with the exported functions and types of their Go
# packages.  The heavy lifting lives in bootstrapLoadGoPackage
# (go_ffi_import.mygo), which falls back to module-aware source loading for
# packages inside the current module or the module cache.
func bootstrapPopulateGoSignatures(
  workspaceRoot: String,
  packages: Ref[Slice[typeinference2.GoPackageEntry]]
) -> Result[(), Error]
  let paths = bootstrapGoImportPaths(packages.value(), 0, [])
  switch bootstrapLoadGoPackages(workspaceRoot, paths)
    case Err(err) => Err(bootstrapFFIContext(packages.value(), err))
    case Ok(loaded) => bootstrapPopulateGoSignaturesAt(packages, loaded, 0)
  end
end

func bootstrapGoImportPaths(
  packages: Slice[typeinference2.GoPackageEntry],
  index: Int,
  out: Slice[String]
) -> Slice[String]
  if index >= packages.Len() then
    out
  else
    switch packages.Get(index)
      case Some(entry) then
        if entry.Path.HasPrefix("go:") then
          bootstrapGoImportPaths(packages, index + 1, out.Append(entry.Path.TrimPrefix("go:")))
        else
          bootstrapGoImportPaths(packages, index + 1, out)
        end
      end
      case None => bootstrapGoImportPaths(packages, index + 1, out)
    end
  end
end

func bootstrapPopulateGoSignaturesAt(
  packages: Ref[Slice[typeinference2.GoPackageEntry]],
  loaded: Map[String, BootstrapGoPackageInfo],
  index: Int
) -> Result[(), Error]
  if index >= packages.value().Len() then
    Ok(())
  else
    switch packages.value().Get(index)
      case Some(entry) then
        if entry.Path.HasPrefix("go:") then
          let trimmed = entry.Path.TrimPrefix("go:")
          switch loaded.Get(trimmed)
            case Some(info) then
              packages.value().Set(
                index,
                typeinference2.GoPackageEntry {
                  Alias: entry.Alias,
                  Path: entry.Path,
                  Origin: entry.Origin,
                  GoName: info.GoName,
                  Funcs: info.Funcs,
                  Types: info.Types,
                  Constants: info.Constants,
                }
              )
              bootstrapPopulateGoSignaturesAt(packages, loaded, index + 1)
            end
            case None then
              Err(bootstrapAsError(ast2.NewDiagnostic(
                "ffi",
                "ffi-invariant",
                "internal",
                "can't find import in loaded Go packages: " + trimmed
              )))
            end
          end
        else
          bootstrapPopulateGoSignaturesAt(packages, loaded, index + 1)
        end
      end
      case None => bootstrapPopulateGoSignaturesAt(packages, loaded, index + 1)
    end
  end
end

func bootstrapCollectGoPackages(
  sources: Slice[typeinference2.PkgDeclSource]
) -> Slice[typeinference2.GoPackageEntry]
  bootstrapCollectGoPackagesAt(sources, 0, emptyBootstrapGoPackageCollection()).Packages
end

func bootstrapAppendMyGoPackageSources(
  sources: Slice[typeinference2.PkgDeclSource],
  packages: Slice[typeinference2.MyGoPackageInfo],
  index: Int
) -> Slice[typeinference2.PkgDeclSource]
  if index >= packages.Len() then
    sources
  else
    switch packages.Get(index)
      case Some(pkg) then
        bootstrapAppendMyGoPackageSources(
          sources.Append(typeinference2.PkgDeclSource {
            Path: pkg.Path,
            PackageImportPath: pkg.Path,
            Decls: pkg.Decls,
          }),
          packages,
          index + 1
        )
      end
      case None => bootstrapAppendMyGoPackageSources(sources, packages, index + 1)
    end
  end
end

func bootstrapCollectGoPackagesAt(
  sources: Slice[typeinference2.PkgDeclSource],
  index: Int,
  state: BootstrapGoPackageCollection
) -> BootstrapGoPackageCollection
  if index >= sources.Len() then
    state
  else
    switch sources.Get(index)
      case Some(source) then
        bootstrapCollectGoPackagesAt(
          sources,
          index + 1,
          bootstrapCollectGoPackagesFromDecls(source.Decls, source.DeclPositions, 0, state)
        )
      end
      case None => bootstrapCollectGoPackagesAt(sources, index + 1, state)
    end
  end
end

func bootstrapCollectGoPackagesFromDecls(
  decls: Slice[ast2.Decl],
  positions: Slice[ast2.SourcePos],
  index: Int,
  state: BootstrapGoPackageCollection
) -> BootstrapGoPackageCollection
  if index >= decls.Len() then
    state
  else
    switch decls.Get(index)
      case Some(decl) then
        switch decl
          case ImportDecl(alias, path) then
            let importKey = alias + "|" + path
            let aliasSeen = switch state.Seen.Get(importKey)
              case Some(seen) => seen
              case None => false
            end
            if strings.HasPrefix(path, "go:") && aliasSeen == false then
              state.Seen.Set(importKey, true)
              bootstrapCollectGoPackagesFromDecls(
                decls,
                positions,
                index + 1,
                BootstrapGoPackageCollection {
                  Packages: state.Packages.Append(typeinference2.GoPackageEntry {
                    Alias: alias,
                    Path: path,
                    Origin: positions.Get(index).Map(func(pos: ast2.SourcePos) -> ast2.SourceSpan ast2.PointSpan(pos) end),
                    GoName: "",
                    Funcs: [] as Slice[typeinference2.GoFuncSignature],
                    Types: [] as Slice[typeinference2.GoTypeSignature],
                    Constants: [] as Slice[typeinference2.GoConstSignature],
                  }),
                  Seen: state.Seen,
                }
              )
            else
              bootstrapCollectGoPackagesFromDecls(decls, positions, index + 1, state)
            end
          end
          case _ => bootstrapCollectGoPackagesFromDecls(decls, positions, index + 1, state)
        end
      end
      case None => bootstrapCollectGoPackagesFromDecls(decls, positions, index + 1, state)
    end
  end
end

# bootstrapCollectMyGoPkgInfos collects MyGO package info (alias + decls) from the
# bootstrap sources cache so they can be passed to InferPackageWithExternal.
func bootstrapCollectMyGoPkgInfos(
  workspaceRoot: String,
  fromDir: String,
  imports: Slice[BootstrapImport],
  index: Int,
  state: BootstrapState,
  out: Slice[typeinference2.MyGoPackageInfo]
) -> Slice[typeinference2.MyGoPackageInfo]
  if index >= imports.Len() then
    out
  else
    switch imports.Get(index)
      case Some(imp) then
        let resolved = bootstrapResolveImport(workspaceRoot, fromDir, imp.Path)
        switch resolved
          case Err(_) then
            bootstrapCollectMyGoPkgInfos(workspaceRoot, fromDir, imports, index + 1, state, out)
          end
          case Ok(depDir) then
            if bootstrapHasMyGoPackagePath(out, imp.Path, 0) then
              bootstrapCollectMyGoPkgInfos(workspaceRoot, fromDir, imports, index + 1, state, out)
            else
              switch bootstrapLoadCachedSourcesDiagnostic(depDir, state)
                case Ok(inputs) then
                  let info = typeinference2.MyGoPackageInfo {
                    Alias: imp.Alias,
                    Path: imp.Path,
                    Decls: bootstrapFlattenSources(inputs.Sources, 0, [] as Slice[ast2.Decl]),
                    DynamicMetadataJSON: bootstrapMetadataJSON(depDir),
                  }
                  let withDependencies = bootstrapCollectMyGoPkgInfos(
                    workspaceRoot,
                    depDir,
                    bootstrapImportsFromSources(inputs.Sources),
                    0,
                    state,
                    out.Append(info)
                  )
                  bootstrapCollectMyGoPkgInfos(workspaceRoot, fromDir, imports, index + 1, state, withDependencies)
                end
                case Err(_) then
                  bootstrapCollectMyGoPkgInfos(workspaceRoot, fromDir, imports, index + 1, state, out)
                end
              end
            end
          end
        end
      end
      case None => out
    end
  end
end

func bootstrapMetadataJSON(dir: String) -> String
  go[String] { code: "bootstrapReadMetadataJSON(dir)" in dir = dir }
end

func bootstrapHasMyGoPackagePath(
  packages: Slice[typeinference2.MyGoPackageInfo],
  path: String,
  index: Int
) -> Bool
  if index >= packages.Len() then
    false
  else
    switch packages.Get(index)
      case Some(pkg) => pkg.Path == path || bootstrapHasMyGoPackagePath(packages, path, index + 1)
      case None => false
    end
  end
end

func bootstrapFlattenSources(
  sources: Slice[typeinference2.PkgDeclSource],
  index: Int,
  out: Slice[ast2.Decl]
) -> Slice[ast2.Decl]
  if index >= sources.Len() then
    out
  else
    switch sources.Get(index)
      case Some(source) then
        let next = source.Decls.Fold(
          out,
          func(acc: Slice[ast2.Decl], d: ast2.Decl) -> Slice[ast2.Decl] acc.Append(d) end
        )
        bootstrapFlattenSources(sources, index + 1, next)
      end
      case None => out
    end
  end
end

func bootstrapWriteGenerated(
  dir: String,
  generated: Map[String, String]
) -> Result[Slice[String], Error]
  bootstrapWriteOutputs(dir, generated)
end
