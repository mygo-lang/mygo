package compiler

import filepath "go:path/filepath"
import strings "go:strings"
import os "go:os"
import strconv "go:strconv"
# Editor analysis loads source snapshots without entering code generation.
func editorLoadInputs(
  dir: String,
  overlays: Map[String, String],
  state: BootstrapState
) -> Result[BootstrapInputs, String]
  switch bootstrapReadDir(dir)
    case Err(err) => Err(err.Error())
    case Ok(diskNames) then
      var names = diskNames
      let pairs = overlays.ToPairs()
      var index = 0
      while index < pairs.Len()
        switch pairs.Get(index)
          case None => ()
          case Some(pair) then
            let (path, _) = pair
            if filepath.Dir(path) == dir &&
              strings.HasSuffix(path, ".mygo") &&
              !names.Contains(filepath.Base(path)) then
              names = names.Append(filepath.Base(path))
            else
              ()
            end
          end
        end
        index = index + 1
      end
      editorLoadNamedInputs(dir, names, 0, overlays, emptyBootstrapInputs(), state)
    end
  end
end

func editorReadSource(path: String, overlays: Map[String, String]) -> Result[String, String]
  switch overlays.Get(path)
    case Some(source) => Ok(source)
    case None then
      switch os.ReadFile(path)
        case Err(err) => Err(path + ": " + err.Error())
        case Ok(raw) then
          let source = raw as String
          overlays.Set(path, source)
          Ok(source)
        end
      end
    end
  end
end

func editorSnapshotOverlays(overlays: Map[String, String]) -> Map[String, String]
  var texts: Map[String, String] = {}
  let pairs = overlays.ToPairs()
  var position = 0
  while position < pairs.Len()
    switch pairs.Get(position)
      case None => ()
      case Some(pair) then
        let (path, text) = pair
        texts.Set(path, text)
      end
    end
    position = position + 1
  end
  texts
end

func editorLoadNamedInputs(
  dir: String,
  names: Slice[String],
  index: Int,
  overlays: Map[String, String],
  out: BootstrapInputs,
  state: BootstrapState
) -> Result[BootstrapInputs, String]
  if index >= names.Len() then
    Ok(bootstrapSplitTestInputs(out).Main)
  else
    switch names.Get(index)
      case None => Err("missing editor source file")
      case Some(name) then
        let path = filepath.Join(dir, name)
        let stamp = editorSourceStamp(path, state)
        switch editorCachedEntry(path, stamp, state)
          case Some(entry) then
            overlays.Set(path, entry.Content)
            editorAppendEntry(path, entry, dir, names, index, overlays, out, state)
          end
          case None then
            switch editorReadSource(path, overlays)
              case Err(msg) => Err(msg)
              case Ok(source) then
                let outcome = EditorParseSource(path, source, state.OverlayStamps.Get(path).IsSome())
                switch state.ParseCache
                  case Some(cache) then
                    EditorParseCacheStore(cache, path, EditorParseEntryFromOutcome(stamp, source, outcome))
                  end
                  case None => ()
                end
                editorAppendOutcome(path, outcome, dir, names, index, overlays, out, state)
              end
            end
          end
        end
      end
    end
  end
end

# editorCachedEntry reports a parse cache hit without changing loader control
# flow.  Without a cache (CLI/bootstrap), every file is parsed as before.
func editorCachedEntry(
  path: String,
  stamp: String,
  state: BootstrapState
) -> Option[EditorParseEntry]
  switch state.ParseCache
    case Some(cache) => EditorParseCacheLookup(cache, path, stamp)
    case None => None
  end
end

func editorAppendEntry(
  path: String,
  entry: EditorParseEntry,
  dir: String,
  names: Slice[String],
  index: Int,
  overlays: Map[String, String],
  out: BootstrapInputs,
  state: BootstrapState
) -> Result[BootstrapInputs, String]
  if entry.AnalysisError != "" then
    Err(entry.AnalysisError)
  else
    switch entry.Input
      case None => Err("missing parsed editor input")
      case Some(input) then
        let next = BootstrapInputs{
          Inputs: out.Inputs.Append(input),
          Sources: appendBootstrapSources(out.Sources, entry.Sources),
        }
        editorLoadNamedInputs(dir, names, index + 1, overlays, next, state)
      end
    end
  end
end

func editorAppendOutcome(
  path: String,
  outcome: EditorParseOutcome,
  dir: String,
  names: Slice[String],
  index: Int,
  overlays: Map[String, String],
  out: BootstrapInputs,
  state: BootstrapState
) -> Result[BootstrapInputs, String]
  if outcome.AnalysisError != "" then
    Err(outcome.AnalysisError)
  else
    switch outcome.Input
      case None => Err("missing parsed editor input")
      case Some(input) then
        let next = BootstrapInputs{
          Inputs: out.Inputs.Append(input),
          Sources: appendBootstrapSources(out.Sources, outcome.Sources),
        }
        editorLoadNamedInputs(dir, names, index + 1, overlays, next, state)
      end
    end
  end
end

# editorSourceStamp derives the cache identity for one source.  Overlay stamps
# come from the editor's document version; disk files use size and modification
# time so an unseen save still invalidates the entry.
func editorSourceStamp(path: String, state: BootstrapState) -> String
  switch state.OverlayStamps.Get(path)
    case Some(stamp) => stamp
    case None => editorDiskStamp(path)
  end
end

func editorDiskStamp(path: String) -> String
  switch os.Stat(path)
    case Err(_) => "disk|missing"
    case Ok(info) then
      "disk|" +
        strconv.FormatInt(info.Size(), 10) +
        "|" +
        strconv.FormatInt(info.ModTime().UnixNano(), 10)
    end
  end
end

func editorLoadDependency(
  dir: String,
  root: String,
  overlays: Map[String, String],
  state: BootstrapState
) -> Result[(), String]
  if state.Compiling.Get(dir).UnwrapOr(false) then
    Err("cyclic MyGO import: " + dir)
  else
    editorLoadDependencyUnchecked(dir, root, overlays, state)
  end
end

func editorLoadDependencyUnchecked(
  dir: String,
  root: String,
  overlays: Map[String, String],
  state: BootstrapState
) -> Result[(), String]
  switch state.SourcesCache.Get(dir)
    case Some(_) => Ok(())
    case None then
      switch editorLoadInputs(dir, overlays, state)
        case Err(msg) => Err(msg)
        case Ok(inputs) then
          state.SourcesCache.Set(dir, inputs)
          state.Compiling.Set(dir, true)
          let result = editorLoadImports(root, dir, bootstrapImportsFromSources(inputs.Sources), 0, overlays, state)
          state.Compiling.Delete(dir)
          result
        end
      end
    end
  end
end

func editorLoadImports(
  root: String,
  fromDir: String,
  imports: Slice[BootstrapImport],
  index: Int,
  overlays: Map[String, String],
  state: BootstrapState
) -> Result[(), String]
  if index >= imports.Len() then
    Ok(())
  else
    switch imports.Get(index)
      case None => Err("missing editor import")
      case Some(imp) then
        switch bootstrapResolveImport(root, fromDir, imp.Path)
          case Err(err) => Err("import " + imp.Path + " from " + fromDir + ": " + err.Error())
          case Ok(dir) then
            switch editorLoadDependency(dir, root, overlays, state)
              case Err(msg) => Err("import " + imp.Path + " from " + fromDir + ": " + msg)
              case Ok(_) => editorLoadImports(root, fromDir, imports, index + 1, overlays, state)
            end
          end
        end
      end
    end
  end
end
