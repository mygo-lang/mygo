  writeFixture(t, moduleRoot, "value.mygo", "package fixture\n\nfunc Value() -> Int\n  1\nend\n")
  let cold = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, cold)
    case Err(err) => t.Fatalf("cold build: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, moduleRoot, "value.mygo", "package fixture\n\nfunc Value() -> Int\n  2\nend\n")
  let warm = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, warm)
    case Err(err) => t.Fatalf("changed-source build: %v", err)
    case Ok(_) => ()
