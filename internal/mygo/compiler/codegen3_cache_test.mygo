package compiler

import os "go:os"
import filepath "go:path/filepath"
import testing "go:testing"

func codegen3CacheTestSources(t: Ref[testing.T], dir: String) -> ()
  writeFixture(t, dir, "go.mod", "module example.invalid/cache-fixture\n\ngo 1.24\n")
  writeFixture(
    t,
    dir,
    "add.mygo",
    "package fixture\n\nfunc Add(a: Int, b: Int) -> Int\n  a + b\nend\n"
  )
end

func codegen3CacheTestOptions() -> PipelineOptions
  PipelineOptions {
    Codegen3: true,
    OptimizationLevel: 2,
    IR3Dump: "",
    EmitDir: "",
    NoPrelude: true,
  }
end

func codegen3CacheEntryDirs(cacheRoot: String) -> Slice[String]
  switch filepath.Glob(filepath.Join(cacheRoot, "build", "*", "*-d"))
    case Err(_) => []
    case Ok(matches) => matches
  end
end

func TestCodegen3SourceDigestTracksInputsButIgnoresGeneratedFiles(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  switch os.WriteFile(
    filepath.Join(dir, "source.mygo"),
    "package fixture\n" as Slice[Byte],
    0o644 as os.FileMode
  )
    case Err(err) => t.Fatalf("write source: %v", err)
    case Ok(_) => ()
  end
  switch os.WriteFile(
    filepath.Join(dir, "zz_handwritten.go"),
    "package fixture\n" as Slice[Byte],
    0o644 as os.FileMode
  )
    case Err(err) => t.Fatalf("write hand-written Go file: %v", err)
    case Ok(_) => ()
  end
  let original = codegen3SourceDigest(dir)
  switch os.WriteFile(
    filepath.Join(dir, "zz_source.gen.go"),
    "generated v1" as Slice[Byte],
    0o644 as os.FileMode
  )
    case Err(err) => t.Fatalf("write generated file: %v", err)
    case Ok(_) => ()
  end
  if codegen3SourceDigest(dir) != original then
    t.Fatalf("generated Go changed source digest")
  end
  switch os.WriteFile(
    filepath.Join(dir, "source.mygo"),
    "package fixture\nfunc Changed() -> Int 1 end\n" as Slice[Byte],
    0o644 as os.FileMode
  )
    case Err(err) => t.Fatalf("change source: %v", err)
    case Ok(_) => ()
  end
  let sourceChanged = codegen3SourceDigest(dir)
  if sourceChanged == original then
    t.Fatalf("source change did not change source digest")
  end
  switch os.WriteFile(
    filepath.Join(dir, "zz_handwritten.go"),
    "package fixture\nvar changed = true\n" as Slice[Byte],
    0o644 as os.FileMode
  )
    case Err(err) => t.Fatalf("change hand-written Go file: %v", err)
    case Ok(_) => ()
  end
  if codegen3SourceDigest(dir) == sourceChanged then
    t.Fatalf("hand-written Go change did not change source digest")
  end
end

func TestCodegen3GoInputsDigestTracksBuildEnvironment(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  writeFixture(t, dir, "go.mod", "module example.invalid/cache-inputs\n\ngo 1.24\n")
  t.Setenv("GOFLAGS", "")
  let defaultDigest = codegen3GoInputsDigest(dir)
  t.Setenv("GOFLAGS", "-tags=mygo_cache_test")
  if codegen3GoInputsDigest(dir) == defaultDigest then
    t.Fatalf("GOFLAGS change did not invalidate Go inputs digest")
  end
end

func TestCodegen3GoInputsDigestTracksLocalGoSources(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  writeFixture(t, dir, "go.mod", "module example.invalid/go-inputs\n\ngo 1.24\n")
  writeFixture(t, dir, "helper.go", "package fixture\n\nconst Value = 1\n")
  let first = codegen3GoInputsDigest(dir)
  writeFixture(t, dir, "helper.go", "package fixture\n\nconst Value = 2\n")
  if codegen3GoInputsDigest(dir) == first then
    t.Fatal("hand-written Go change did not invalidate Go inputs")
  end
end

func TestCodegen3GoInputsDigestTracksLocalReplacement(t: Ref[testing.T]) -> ()
  let root = t.TempDir()
  let replacement = filepath.Join(root, "replacement")
  switch os.MkdirAll(replacement, 0o755 as os.FileMode)
    case Err(err) => t.Fatalf("replacement directory: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, root, "go.mod", "module example.invalid/main\n\ngo 1.24\n\nreplace example.invalid/dep => ./replacement\n")
  writeFixture(t, replacement, "go.mod", "module example.invalid/dep\n\ngo 1.24\n")
  writeFixture(t, replacement, "dep.go", "package dep\n\nconst Value = 1\n")
  let first = codegen3GoInputsDigest(root)
  writeFixture(t, replacement, "dep.go", "package dep\n\nconst Value = 2\n")
  if codegen3GoInputsDigest(root) == first then
    t.Fatal("local replacement change did not invalidate Go inputs")
  end
end

func codegen3ExpectedFailure(t: Ref[testing.T], dir: String) -> String
  switch buildCodegen3(dir, codegen3CacheTestOptions(), false, [])
    case Err(err) => err.Error()
    case Ok(_) then
      t.Fatal("expected the invalid package to fail inference")
      ""
    end
  end
end

func TestCodegen3CacheHitPathPreservesFailureDiagnostics(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let dir = t.TempDir()
  codegen3CacheTestSources(t, dir)
  writeFixture(t, dir, "add.mygo", "package fixture\n\nfunc Add() -> Int\n  \"wrong type\"\nend\n")
  let first = codegen3ExpectedFailure(t, dir)
  let second = codegen3ExpectedFailure(t, dir)
  if first != second then
    t.Fatalf("diagnostic changed on repeated failure:\nfirst: %s\nsecond: %s", first, second)
  end
  if codegen3CacheEntryDirs(cache).Len() != 0 then
    t.Fatal("failed inference published a cache entry")
  end
end

func TestCodegen3CacheSharedAcrossModules(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let first = t.TempDir()
  let second = t.TempDir()
  codegen3CacheTestSources(t, first)
  codegen3CacheTestSources(t, second)
  # Different module paths; identical sources must still share an entry.
  writeFixture(t, second, "go.mod", "module example.invalid/other-module\n\ngo 1.24\n")
  switch buildCodegen3(first, codegen3CacheTestOptions(), false, [])
    case Err(err) => t.Fatalf("first build: %v", err)
    case Ok(_) => ()
  end
  switch buildCodegen3(second, codegen3CacheTestOptions(), false, [])
    case Err(err) => t.Fatalf("second build: %v", err)
    case Ok(_) => ()
  end
  let entries = codegen3CacheEntryDirs(cache)
  if entries.Len() != 1 then
    t.Fatalf("cache entries = %d, want 1 shared entry", entries.Len())
  end
end

func codegen3EarlyHitState(t: Ref[testing.T], moduleRoot: String) -> BootstrapState
  let buildRoot = t.TempDir()
  newBootstrapCodegen3State(
    2,
    moduleRoot,
    buildRoot,
    true,
    filepath.Join(buildRoot, "manifest.jsonl"),
    ""
  )
end

func codegen3StageCount(state: BootstrapState, stage: String) -> Int
  state.StageCounters.Get(stage).UnwrapOr(0)
end

func TestCodegen3SummaryEarlyHitSkipsParseAndFFI(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", t.TempDir())
  let moduleRoot = t.TempDir()
  writeFixture(t, moduleRoot, "go.mod", "module example.invalid/early-hit\n\ngo 1.24\n")
  writeFixture(
    t,
    moduleRoot,
    "add.mygo",
    "package fixture\n\nfunc Add(a: Int, b: Int) -> Int\n  a + b\nend\n"
  )
  let cold = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, cold)
    case Err(err) => t.Fatalf("cold build: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(cold, "parse") == 0 || codegen3StageCount(cold, "ffi") == 0 then
    t.Fatalf("cold build did not record front-end work: parse=%d ffi=%d",
      codegen3StageCount(cold, "parse"),
      codegen3StageCount(cold, "ffi")
    )
  end
  let probe = codegen3EarlyHitState(t, moduleRoot)
  let fingerprint = codegen3SourceFingerprint(moduleRoot, probe)
  switch codegen3ReadPackageSummary(fingerprint)
    case None => t.Fatal("summary record was not readable: " + fingerprint)
    case Some(summary) then
      if !codegen3ValidatePackageSummary(moduleRoot, probe, summary, {}) then
        t.Fatal("summary record did not validate: " + fingerprint)
      end
      let entry = codegen3CacheLookup(summary.PackageKey)
      if entry == "" then
        t.Fatal("summary output entry is missing: " + summary.PackageKey)
      end
      switch codegen3MetadataInputs(probe, entry, summary.PackagePath)
        case Err(err) => t.Fatalf("summary metadata could not be loaded: %v", err)
        case Ok(_) => ()
      end
    end
  end
  let warm = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, warm)
    case Err(err) => t.Fatalf("warm build: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(warm, "cache-early-hit") != 1 then
    t.Fatalf("warm build early hits = %d, want 1", codegen3StageCount(warm, "cache-early-hit"))
  end
  if codegen3StageCount(warm, "parse") != 0 || codegen3StageCount(warm, "ffi") != 0 then
    t.Fatalf("warm build repeated front-end work: parse=%d ffi=%d",
      codegen3StageCount(warm, "parse"),
      codegen3StageCount(warm, "ffi")
    )
  end
end

func TestCodegen3SummaryInvalidFallsBackToParsing(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let moduleRoot = t.TempDir()
  writeFixture(t, moduleRoot, "go.mod", "module example.invalid/bad-summary\n\ngo 1.24\n")
  writeFixture(
    t,
    moduleRoot,
    "value.mygo",
    "package fixture\n\nfunc Value() -> Int\n  1\nend\n"
  )
  let cold = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, cold)
    case Err(err) => t.Fatalf("cold build: %v", err)
    case Ok(_) => ()
  end
  let fingerprint = codegen3SourceFingerprint(moduleRoot, cold)
  let summaryPath = codegen3SummaryPath(fingerprint)
  switch os.WriteFile(
    summaryPath,
    "truncated" as Slice[Byte],
    0o644 as os.FileMode
  )
    case Err(err) => t.Fatalf("corrupt summary: %v", err)
    case Ok(_) => ()
  end
  let warm = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, warm)
    case Err(err) => t.Fatalf("fallback build: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(warm, "cache-early-hit") != 0 then
    t.Fatalf("corrupt summary produced an early hit")
  end
  if codegen3StageCount(warm, "parse") == 0 then
    t.Fatalf("corrupt summary skipped parsing instead of falling back")
  end
  let repaired = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, repaired)
    case Err(err) => t.Fatalf("repaired-summary build: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(repaired, "cache-early-hit") != 1 then
    t.Fatalf("fallback did not repair the summary")
  end
end

func TestCodegen3SummaryTracksCheckoutIndependentSource(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let first = t.TempDir()
  let second = t.TempDir()
  let source = "package fixture\n\nfunc Value() -> Int\n  1\nend\n"
  writeFixture(t, first, "go.mod", "module example.invalid/summary-checkout\n\ngo 1.24\n")
  writeFixture(t, second, "go.mod", "module example.invalid/summary-checkout\n\ngo 1.24\n")
  writeFixture(t, first, "value.mygo", source)
  writeFixture(t, second, "value.mygo", source)
  let firstState = codegen3EarlyHitState(t, first)
  switch syncBootstrapMyGO3WithState(first, firstState)
    case Err(err) => t.Fatalf("first checkout: %v", err)
    case Ok(_) => ()
  end
  let secondState = codegen3EarlyHitState(t, second)
  switch syncBootstrapMyGO3WithState(second, secondState)
    case Err(err) => t.Fatalf("second checkout: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(secondState, "cache-early-hit") != 1 then
    t.Fatalf("second checkout did not reuse the summary")
  end
  let summaryRoot = filepath.Join(cache, "summaries")
  switch filepath.Glob(filepath.Join(summaryRoot, "*", "*.json"))
    case Err(err) => t.Fatalf("list summaries: %v", err)
    case Ok(paths) then
      if paths.Len() != 1 then
        t.Fatalf("summary files = %d, want one path-independent summary", paths.Len())
      end
    end
  end
end

func TestCodegen3SummaryInvalidatesChangedSource(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", t.TempDir())
  let moduleRoot = t.TempDir()
  writeFixture(t, moduleRoot, "go.mod", "module example.invalid/changed-summary\n\ngo 1.24\n")
  writeFixture(t, moduleRoot, "value.mygo", "package fixture\n\nfunc Value() -> Int\n  1\nend\n")
  let cold = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, cold)
    case Err(err) => t.Fatalf("cold build: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, moduleRoot, "value.mygo", "package fixture\n\nfunc Value() -> Int\n  2\nend\n")
  let warm = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, warm)
    case Err(err) => t.Fatalf("changed-source build: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(warm, "cache-early-hit") != 0 then
    t.Fatalf("changed source reused a stale summary")
  end
  if codegen3StageCount(warm, "parse") == 0 || codegen3StageCount(warm, "ffi") == 0 then
    t.Fatalf("changed source did not re-enter the front end")
  end
end

func TestCodegen3SummaryInvalidatesChangedDependency(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", t.TempDir())
  let moduleRoot = t.TempDir()
  writeFixture(t, moduleRoot, "go.mod", "module example.invalid/summary-deps\n\ngo 1.24\n")
  let lib = filepath.Join(moduleRoot, "lib")
  let app = filepath.Join(moduleRoot, "app")
  switch os.MkdirAll(lib, 0o755 as os.FileMode)
    case Err(err) => t.Fatalf("lib directory: %v", err)
    case Ok(_) => ()
  end
  switch os.MkdirAll(app, 0o755 as os.FileMode)
    case Err(err) => t.Fatalf("app directory: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, lib, "lib.mygo", "package lib\n\nfunc Add(a: Int, b: Int) -> Int\n  a + b\nend\n")
  writeFixture(
    t,
    app,
    "main.mygo",
    "package app\n\nimport lib \"example.invalid/summary-deps/lib\"\n\nfunc Value() -> Int\n  lib.Add(1, 2)\nend\n"
  )
  let cold = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, cold)
    case Err(err) => t.Fatalf("cold build: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, lib, "lib.mygo", "package lib\n\nfunc Add(a: Int, b: Int) -> Int\n  a + b + 1\nend\n")
  let warm = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, warm)
    case Err(err) => t.Fatalf("changed-dependency build: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(warm, "cache-early-hit") != 0 then
    t.Fatalf("changed dependency reused a stale summary")
  end
  if codegen3StageCount(warm, "parse") < 2 then
    t.Fatalf("changed dependency did not invalidate its importer: parse=%d", codegen3StageCount(warm, "parse"))
  end
end

func TestCodegen3CacheRecoversFromCorruptEntry(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let dir = t.TempDir()
  codegen3CacheTestSources(t, dir)
  switch buildCodegen3(dir, codegen3CacheTestOptions(), false, [])
    case Err(err) => t.Fatalf("first build: %v", err)
    case Ok(_) => ()
  end
  switch filepath.Glob(filepath.Join(cache, "build", "*", "*-d", "zz_add.gen.go"))
    case Err(err) => t.Fatalf("locate entry: %v", err)
    case Ok(matches) then
      if matches.Len() == 0 then
        t.Fatalf("%s", "entry file missing")
      end
      switch os.WriteFile(matches.Get(0).UnwrapOr(""), "corrupt" as Slice[Byte], 0o644 as os.FileMode)
        case Err(err) => t.Fatalf("corrupt entry: %v", err)
        case Ok(_) => ()
      end
    end
  end
  switch buildCodegen3(dir, codegen3CacheTestOptions(), false, [])
    case Err(err) => t.Fatalf("rebuild after corruption: %v", err)
    case Ok(_) => ()
  end
  let entries = codegen3CacheEntryDirs(cache)
  if entries.Len() == 0 then
    t.Fatalf("%s", "cache entry missing after recovery")
  end
  switch codegen3ReadEntry(entries.Get(0).UnwrapOr(""), "")
    case None => t.Fatalf("%s", "corrupt entry was not repaired")
    case Some(_) => ()
  end
end

func TestCodegen3EmitCopiesGeneratedFiles(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", t.TempDir())
  let dir = t.TempDir()
  codegen3CacheTestSources(t, dir)
  let emit = t.TempDir()
  let options = PipelineOptions {
    Codegen3: true,
    OptimizationLevel: 2,
    IR3Dump: "",
    EmitDir: emit,
    NoPrelude: true,
  }
  switch buildCodegen3(dir, options, false, [])
    case Err(err) => t.Fatalf("build with emit: %v", err)
    case Ok(_) => ()
  end
  if !codegen3FileExists(filepath.Join(emit, "zz_add.gen.go")) then
    t.Fatalf("%s", "emitted file missing")
  end
  if codegen3FileExists(filepath.Join(dir, "build")) then
    t.Fatalf("%s", "emit must not create a project-local build directory")
  end
end

func TestCodegen3CacheCleanRemovesEntries(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let dir = t.TempDir()
  codegen3CacheTestSources(t, dir)
  switch buildCodegen3(dir, codegen3CacheTestOptions(), false, [])
    case Err(err) => t.Fatalf("build: %v", err)
    case Ok(_) => ()
  end
  if codegen3CacheEntryDirs(cache).Len() == 0 then
    t.Fatalf("%s", "expected a cache entry before cleaning")
  end
  switch codegen3LockCache(true, 5000)
    case Err(err) => t.Fatalf("exclusive lock: %v", err)
    case Ok(_) then
      switch codegen3CacheClean()
        case Err(err) => t.Fatalf("clean: %v", err)
        case Ok(_) => ()
      end
      codegen3UnlockCache()
      ()
    end
  end
  if codegen3CacheEntryDirs(cache).Len() != 0 then
    t.Fatalf("%s", "clean left cache entries behind")
  end
end

func TestCodegen3CacheDisabled(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", "off")
  if codegen3CacheRootPath() != "" then
    t.Fatalf("%s", "MYGO_CACHE=off must disable the cache")
  end
  switch codegen3CacheClean()
    case Err(err) => t.Fatalf("clean with cache disabled: %v", err)
    case Ok(removed) then
      if removed != 0i64 then
        t.Fatalf("removed = %d, want 0", removed)
      end
    end
  end
end

func TestCodegen3CacheExclusiveLockWait(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", t.TempDir())
  switch codegen3LockCache(false, 5000)
    case Err(err) => t.Fatalf("shared lock: %v", err)
    case Ok(_) then
      switch codegen3LockCache(true, 50)
        case Ok(_) then
          codegen3UnlockCache()
          t.Fatalf("%s", "exclusive lock succeeded while a shared lock was held")
        end
        case Err(_) => ()
      end
      codegen3UnlockCache()
      ()
    end
  end
  switch codegen3LockCache(true, 5000)
    case Err(err) => t.Fatalf("exclusive lock after release: %v", err)
    case Ok(_) then
      codegen3UnlockCache()
      ()
    end
  end
end

func codegen3TestModule(t: Ref[testing.T], dir: String, modulePath: String) -> ()
  writeFixture(t, dir, "go.mod", "module " + modulePath + "\n\ngo 1.24\n")
  writeFixture(t, dir, "add.mygo", "package fixture\n\nfunc Add(a: Int, b: Int) -> Int\n  a + b\nend\n")
  writeFixture(t, dir, "add_test.mygo", "package fixture\n\nimport testing \"go:testing\"\n\nfunc TestAdd(t: Ref[testing.T]) -> ()\n  if Add(1, 2) != 3 then\n    t.Fatal(\"bad sum\")\n  end\nend\n")
end

func TestCodegen3TestSharedCacheAcrossModules(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let first = t.TempDir()
  let second = t.TempDir()
  codegen3TestModule(t, first, "example.invalid/mod-one")
  codegen3TestModule(t, second, "example.invalid/mod-two")
  switch buildCodegen3(first, codegen3CacheTestOptions(), true, [])
    case Err(err) => t.Fatalf("first module test: %v", err)
    case Ok(_) => ()
  end
  switch buildCodegen3(second, codegen3CacheTestOptions(), true, [])
    case Err(err) => t.Fatalf("second module test: %v", err)
    case Ok(_) => ()
  end
  if codegen3CacheEntryDirs(cache).Len() != 1 then
    t.Fatalf("cache entries = %d, want one shared entry", codegen3CacheEntryDirs(cache).Len())
  end
  [first, second].Each(func(dir: String) -> ()
    if codegen3FileExists(filepath.Join(dir, "build")) then
      t.Fatalf("project-local build directory in %s", dir)
    end
  end)
end
