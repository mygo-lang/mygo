  switch os.MkdirAll(lib, 0o755 as os.FileMode)
    case Err(err) => t.Fatalf("lib directory: %v", err)
    case Ok(_) => ()
  end
  switch os.MkdirAll(app, 0o755 as os.FileMode)
    case Err(err) => t.Fatalf("app directory: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, lib, "lib.mygo", "package lib\n\nfunc Add(a: Int, b: Int) -> Int\n  a + b\nend\n")
  writeFixture(
    t,
    app,
    "main.mygo",
    "package app\n\nimport lib \"example.invalid/summary-deps/lib\"\n\nfunc Value() -> Int\n  lib.Add(1, 2)\nend\n"
  )
  let cold = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, cold)
    case Err(err) => t.Fatalf("cold build: %v", err)
