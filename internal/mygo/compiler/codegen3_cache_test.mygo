package compiler

import os "go:os"
import bytes "go:bytes"
import filepath "go:path/filepath"
import strings "go:strings"
import testing "go:testing"

func codegen3CacheTestSources(t: Ref[testing.T], dir: String) -> ()
  writeFixture(t, dir, "go.mod", "module example.invalid/cache-fixture\n\ngo 1.24\n")
  writeFixture(
    t,
    dir,
    "add.mygo",
    "package fixture\n\nfunc Add(a: Int, b: Int) -> Int\n  a + b\nend\n"
  )
end

func codegen3CacheTestOptions() -> PipelineOptions
  PipelineOptions {
    Codegen3: true,
    OptimizationLevel: 2,
    IR3Dump: "",
    EmitDir: "",
    NoPrelude: true,
  }
end

func codegen3CacheEntryDirs(cacheRoot: String) -> Slice[String]
  switch filepath.Glob(filepath.Join(cacheRoot, "build", "*", "*-d"))
    case Err(_) => []
    case Ok(matches) => matches
  end
end

func TestCodegen3SourceDigestTracksInputsButIgnoresGeneratedFiles(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  switch os.WriteFile(
    filepath.Join(dir, "source.mygo"),
    "package fixture\n" as Slice[Byte],
    0o644 as os.FileMode
  )
    case Err(err) => t.Fatalf("write source: %v", err)
    case Ok(_) => ()
  end
  switch os.WriteFile(
    filepath.Join(dir, "zz_handwritten.go"),
    "package fixture\n" as Slice[Byte],
    0o644 as os.FileMode
  )
    case Err(err) => t.Fatalf("write hand-written Go file: %v", err)
    case Ok(_) => ()
  end
  let original = codegen3SourceDigest(dir)
  switch os.WriteFile(
    filepath.Join(dir, "zz_source.gen.go"),
    "generated v1" as Slice[Byte],
    0o644 as os.FileMode
  )
    case Err(err) => t.Fatalf("write generated file: %v", err)
    case Ok(_) => ()
  end
  if codegen3SourceDigest(dir) != original then
    t.Fatalf("generated Go changed source digest")
  end
  switch os.WriteFile(
    filepath.Join(dir, "source.mygo"),
    "package fixture\nfunc Changed() -> Int 1 end\n" as Slice[Byte],
    0o644 as os.FileMode
  )
    case Err(err) => t.Fatalf("change source: %v", err)
    case Ok(_) => ()
  end
  let sourceChanged = codegen3SourceDigest(dir)
  if sourceChanged == original then
    t.Fatalf("source change did not change source digest")
  end
  switch os.WriteFile(
    filepath.Join(dir, "zz_handwritten.go"),
    "package fixture\nvar changed = true\n" as Slice[Byte],
    0o644 as os.FileMode
  )
    case Err(err) => t.Fatalf("change hand-written Go file: %v", err)
    case Ok(_) => ()
  end
  if codegen3SourceDigest(dir) == sourceChanged then
    t.Fatalf("hand-written Go change did not change source digest")
  end
end

func TestCodegen3GoInputsDigestTracksBuildEnvironment(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  writeFixture(t, dir, "go.mod", "module example.invalid/cache-inputs\n\ngo 1.24\n")
  t.Setenv("GOFLAGS", "")
  let defaultDigest = codegen3GoInputsDigest(dir)
  t.Setenv("GOFLAGS", "-tags=mygo_cache_test")
  if codegen3GoInputsDigest(dir) == defaultDigest then
    t.Fatalf("GOFLAGS change did not invalidate Go inputs digest")
  end
end

func TestCodegen3GoInputsDigestTracksLocalGoSources(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  writeFixture(t, dir, "go.mod", "module example.invalid/go-inputs\n\ngo 1.24\n")
  writeFixture(t, dir, "helper.go", "package fixture\n\nconst Value = 1\n")
  let first = codegen3GoInputsDigest(dir)
  writeFixture(t, dir, "helper.go", "package fixture\n\nconst Value = 2\n")
  if codegen3GoInputsDigest(dir) == first then
    t.Fatal("hand-written Go change did not invalidate Go inputs")
  end
end

func TestCodegen3GoInputsDigestTracksLocalReplacement(t: Ref[testing.T]) -> ()
  let root = t.TempDir()
  let replacement = filepath.Join(root, "replacement")
  switch os.MkdirAll(replacement, 0o755 as os.FileMode)
    case Err(err) => t.Fatalf("replacement directory: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, root, "go.mod", "module example.invalid/main\n\ngo 1.24\n\nreplace example.invalid/dep => ./replacement\n")
  writeFixture(t, replacement, "go.mod", "module example.invalid/dep\n\ngo 1.24\n")
  writeFixture(t, replacement, "dep.go", "package dep\n\nconst Value = 1\n")
  let first = codegen3GoInputsDigest(root)
  writeFixture(t, replacement, "dep.go", "package dep\n\nconst Value = 2\n")
  if codegen3GoInputsDigest(root) == first then
    t.Fatal("local replacement change did not invalidate Go inputs")
  end
end

func TestCodegen3DisabledCacheSkipsGoInputsDigest(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", "off")
  let root = t.TempDir()
  writeFixture(t, root, "go.mod", "module example.invalid/cache-off\n\ngo 1.24\n")
  writeFixture(t, root, "input.go", "package fixture\n\nconst Value = 1\n")
  let state = codegen3EarlyHitState(t, root)
  if state.CacheEnabled || state.GoInputsDigest != "" || state.CompilerID != "" then
    t.Fatalf("disabled cache computed cache identity: %s %s", state.GoInputsDigest, state.CompilerID)
  end
end

func TestCodegen3TypedSummaryInvalidatesBuildOptions(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", t.TempDir())
  let root = t.TempDir()
  codegen3CacheTestSources(t, root)
  let cold = codegen3EarlyHitState(t, root)
  switch compileAbsoluteBootstrapDir(root, cold, true)
    case Err(err) => t.Fatalf("cold build: %v", err)
    case Ok(_) => ()
  end
  if codegen3ReadVerifiedTypedSummary(root, codegen3EarlyHitState(t, root), "main").IsNone() then
    t.Fatal("baseline summary missing")
  end
  var otherLevel = codegen3EarlyHitState(t, root)
  otherLevel.OptimizationLevel = 1
  if codegen3ReadVerifiedTypedSummary(root, otherLevel, "main").IsSome() then
    t.Fatal("summary was reused across optimization levels")
  end
  var otherCompiler = codegen3EarlyHitState(t, root)
  otherCompiler.CompilerID = "other-compiler"
  if codegen3ReadVerifiedTypedSummary(root, otherCompiler, "main").IsSome() then
    t.Fatal("summary was reused across compiler identities")
  end
  var otherGoInputs = codegen3EarlyHitState(t, root)
  otherGoInputs.GoInputsDigest = "other-go-inputs"
  if codegen3ReadVerifiedTypedSummary(root, otherGoInputs, "main").IsSome() then
    t.Fatal("summary was reused across Go toolchain inputs")
  end
end

func codegen3ExpectedFailure(t: Ref[testing.T], dir: String) -> String
  switch buildCodegen3(dir, codegen3CacheTestOptions(), false, [])
    case Err(err) => err.Error()
    case Ok(_) then
      t.Fatal("expected the invalid package to fail inference")
      ""
    end
  end
end

func TestCodegen3CacheHitPathPreservesFailureDiagnostics(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let dir = t.TempDir()
  codegen3CacheTestSources(t, dir)
  writeFixture(t, dir, "add.mygo", "package fixture\n\nfunc Add() -> Int\n  \"wrong type\"\nend\n")
  let first = codegen3ExpectedFailure(t, dir)
  let second = codegen3ExpectedFailure(t, dir)
  if first != second then
    t.Fatalf("diagnostic changed on repeated failure:\nfirst: %s\nsecond: %s", first, second)
  end
  if codegen3CacheEntryDirs(cache).Len() != 0 then
    t.Fatal("failed inference published a cache entry")
  end
end

func TestCodegen3CacheSharedAcrossModules(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let first = t.TempDir()
  let second = t.TempDir()
  codegen3CacheTestSources(t, first)
  codegen3CacheTestSources(t, second)
  # Different module paths; identical sources must still share an entry.
  writeFixture(t, second, "go.mod", "module example.invalid/other-module\n\ngo 1.24\n")
  switch buildCodegen3(first, codegen3CacheTestOptions(), false, [])
    case Err(err) => t.Fatalf("first build: %v", err)
    case Ok(_) => ()
  end
  switch buildCodegen3(second, codegen3CacheTestOptions(), false, [])
    case Err(err) => t.Fatalf("second build: %v", err)
    case Ok(_) => ()
  end
  let entries = codegen3CacheEntryDirs(cache)
  if entries.Len() != 1 then
    t.Fatalf("cache entries = %d, want 1 shared entry", entries.Len())
  end
end

func codegen3EarlyHitState(t: Ref[testing.T], moduleRoot: String) -> BootstrapState
  let buildRoot = t.TempDir()
  newBootstrapCodegen3State(
    2,
    moduleRoot,
    buildRoot,
    true,
    filepath.Join(buildRoot, "manifest.jsonl"),
    ""
  )
end

func codegen3StageCount(state: BootstrapState, stage: String) -> Int
  state.StageCounters.Get(stage).UnwrapOr(0)
end

func TestCodegen3PretypedPreludeRuntimeHit(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let root = t.TempDir()
  writeFixture(t, root, "go.mod", "module github.com/mygo-lang/mygo\n\ngo 1.24\n")
  let prelude = filepath.Join(root, "prelude")
  switch os.MkdirAll(prelude, 0o755 as os.FileMode)
    case Err(err) => t.Fatalf("create prelude: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, prelude, "prelude.mygo", """package prelude
enum Choice[A]
  Some(A)
  None
end
impl[A] Choice[A]
  func Echo(value: Choice[A]) -> Choice[A]
    value
  end
end
func Value() -> Int
  7
end
""")
  writeFixture(t, root, "main.mygo", "package main\nfunc Use() -> Int\n  Value()\nend\n")
  var cold = codegen3EarlyHitState(t, root)
  cold.NoPrelude = false
  switch compileAbsoluteBootstrapDir(prelude, cold, true)
    case Err(err) => t.Fatalf("cold prelude: %v", err)
    case Ok(_) => ()
  end
  switch compileAbsoluteBootstrapDir(root, cold, true)
    case Err(err) => t.Fatalf("cold compilation: %v", err)
    case Ok(_) => ()
  end
  var probe = codegen3EarlyHitState(t, root)
  probe.NoPrelude = false
  if codegen3ReadVerifiedTypedSummary(prelude, probe, "main").IsNone() then
    t.Fatalf("prelude typed summary unavailable: key=%s cold=%s probe=%s package=%+v path=%s", cold.PackageKeys.Get(prelude).UnwrapOr(""), codegen3SourceFingerprint(prelude, cold), codegen3SourceFingerprint(prelude, probe), codegen3ReadPackageSummary(codegen3SourceFingerprint(prelude, probe)), codegen3SummaryPath(codegen3SourceFingerprint(prelude, probe)))
  end
  writeFixture(t, root, "main.mygo", "package main\nfunc Use(value: Choice[Int]) -> Choice[Int]\n  value.Echo()\nend\n")
  var warm = codegen3EarlyHitState(t, root)
  warm.NoPrelude = false
  switch compileAbsoluteBootstrapDir(root, warm, true)
    case Err(err) => t.Fatalf("warm compilation: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(warm, "typed-prelude-hit") != 1 then
    t.Fatalf("pretyped prelude was not used: hits=%d", codegen3StageCount(warm, "typed-prelude-hit"))
  end
  if warm.SourcesCache.Get(prelude).IsSome() || codegen3StageCount(warm, "prelude-source-load") != 0 || codegen3StageCount(warm, "parse") != 1 then
    t.Fatalf("warm prelude was parsed: loads=%d parse=%d", codegen3StageCount(warm, "prelude-source-load"), codegen3StageCount(warm, "parse"))
  end
  let warmDir = bootstrapCodegen3OutputDir(warm, root).Unwrap()
  let warmOutput = os.ReadFile(filepath.Join(warmDir, "zz_main.gen.go")).Unwrap()
  t.Setenv("MYGO_CACHE", "off")
  var uncached = codegen3EarlyHitState(t, root)
  uncached.NoPrelude = false
  switch compileAbsoluteBootstrapDir(prelude, uncached, true)
    case Err(err) => t.Fatalf("cache-off prelude: %v", err)
    case Ok(_) => ()
  end
  switch compileAbsoluteBootstrapDir(root, uncached, true)
    case Err(err) => t.Fatalf("cache-off compilation: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(uncached, "typed-prelude-hit") != 0 then t.Fatal("cache-off compilation used a typed summary") end
  let uncachedDir = bootstrapCodegen3OutputDir(uncached, root).Unwrap()
  let uncachedOutput = os.ReadFile(filepath.Join(uncachedDir, "zz_main.gen.go")).Unwrap()
  if !bytes.Equal(warmOutput, uncachedOutput) then t.Fatal("cached and uncached output differ") end
  t.Setenv("MYGO_CACHE", cache)
  let key = cold.PackageKeys.Get(prelude).UnwrapOr("")
  let path = codegen3TypedSummaryPath(key, "main")
  switch os.WriteFile(path, "corrupt" as Slice[Byte], 0o644 as os.FileMode)
    case Err(err) => t.Fatalf("corrupt summary: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, root, "main.mygo", "package main\nfunc Use(value: Choice[Int]) -> Choice[Int]\n  value.Echo()\nend\n\n")
  var corrupt = codegen3EarlyHitState(t, root)
  corrupt.NoPrelude = false
  switch compileAbsoluteBootstrapDir(root, corrupt, true)
    case Err(err) => t.Fatalf("corrupt-summary fallback: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(corrupt, "typed-prelude-hit") != 0 then t.Fatal("corrupt summary was used") end
end

func TestCodegen3PretypedPreludeListRuntimeHit(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", t.TempDir())
  let root = t.TempDir()
  writeFixture(t, root, "go.mod", "module github.com/mygo-lang/mygo\n\ngo 1.24\n")
  let prelude = filepath.Join(root, "prelude")
  switch os.MkdirAll(prelude, 0o755 as os.FileMode)
    case Err(err) => t.Fatalf("create prelude: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, prelude, "prelude.mygo", """package prelude
enum List[A]
  Nil
  Node(A, Option[List[A]])
end
impl[T] List[T]
  func Cons(head: T) -> List[T]
    List.Node(head, None)
  end
end
func ListToSlice[T](c: List[T]) -> Slice[T]
  [] as Slice[T]
end
""")
  writeFixture(t, root, "main.mygo", "package main\nfunc Use() -> Slice[Int]\n  let item = List.Node(1, None)\n  let items = item.Cons(2)\n  ListToSlice(items)\nend\n")
  var cold = codegen3EarlyHitState(t, root)
  cold.NoPrelude = false
  switch compileAbsoluteBootstrapDir(prelude, cold, true)
    case Err(err) => t.Fatalf("cold prelude: %v", err)
    case Ok(_) => ()
  end
  switch compileAbsoluteBootstrapDir(root, cold, true)
    case Err(err) => t.Fatalf("cold compilation: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, root, "main.mygo", "package main\nfunc Use() -> Slice[Int]\n  let item = List.Node(3, None)\n  let items = item.Cons(4)\n  ListToSlice(items)\nend\n")
  var warm = codegen3EarlyHitState(t, root)
  warm.NoPrelude = false
  switch compileAbsoluteBootstrapDir(root, warm, true)
    case Err(err) => t.Fatalf("warm compilation: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(warm, "typed-prelude-hit") != 1 || warm.SourcesCache.Get(prelude).IsSome() || codegen3StageCount(warm, "parse") != 1 then
    t.Fatalf("prelude List summary was not reused: hits=%d parse=%d", codegen3StageCount(warm, "typed-prelude-hit"), codegen3StageCount(warm, "parse"))
  end
  let warmOutput = os.ReadFile(filepath.Join(bootstrapCodegen3OutputDir(warm, root).Unwrap(), "zz_main.gen.go")).Unwrap()
  t.Setenv("MYGO_CACHE", "off")
  var uncached = codegen3EarlyHitState(t, root)
  uncached.NoPrelude = false
  switch compileAbsoluteBootstrapDir(prelude, uncached, true)
    case Err(err) => t.Fatalf("cache-off prelude: %v", err)
    case Ok(_) => ()
  end
  switch compileAbsoluteBootstrapDir(root, uncached, true)
    case Err(err) => t.Fatalf("cache-off compilation: %v", err)
    case Ok(_) => ()
  end
  let sourceOutput = os.ReadFile(filepath.Join(bootstrapCodegen3OutputDir(uncached, root).Unwrap(), "zz_main.gen.go")).Unwrap()
  if !bytes.Equal(warmOutput, sourceOutput) then
    t.Fatal("List output differs with caching disabled")
  end
end

func TestCodegen3SummaryEarlyHitSkipsParseAndFFI(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", t.TempDir())
  let moduleRoot = t.TempDir()
  writeFixture(t, moduleRoot, "go.mod", "module example.invalid/early-hit\n\ngo 1.24\n")
  writeFixture(
    t,
    moduleRoot,
    "add.mygo",
    "package fixture\n\nfunc Add(a: Int, b: Int) -> Int\n  a + b\nend\n"
  )
  let cold = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, cold)
    case Err(err) => t.Fatalf("cold build: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(cold, "parse") == 0 || codegen3StageCount(cold, "ffi") == 0 then
    t.Fatalf("cold build did not record front-end work: parse=%d ffi=%d",
      codegen3StageCount(cold, "parse"),
      codegen3StageCount(cold, "ffi")
    )
  end
  let probe = codegen3EarlyHitState(t, moduleRoot)
  let fingerprint = codegen3SourceFingerprint(moduleRoot, probe)
  switch codegen3ReadPackageSummary(fingerprint)
    case None => t.Fatal("summary record was not readable: " + fingerprint)
    case Some(summary) then
      if !codegen3ValidatePackageSummary(moduleRoot, probe, summary, {}) then
        t.Fatal("summary record did not validate: " + fingerprint)
      end
      let entry = codegen3CacheLookup(summary.PackageKey)
      if entry == "" then
        t.Fatal("summary output entry is missing: " + summary.PackageKey)
      end
      switch codegen3MetadataInputs(probe, entry, summary.PackagePath)
        case Err(err) => t.Fatalf("summary metadata could not be loaded: %v", err)
        case Ok(_) => ()
      end
    end
  end
  let warm = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, warm)
    case Err(err) => t.Fatalf("warm build: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(warm, "cache-early-hit") != 1 then
    t.Fatalf("warm build early hits = %d, want 1", codegen3StageCount(warm, "cache-early-hit"))
  end
  if warm.SourcesCache.Get(moduleRoot).IsSome() || warm.TypedSourcesCache.Get(moduleRoot).IsSome() then
    t.Fatal("output-only hit populated declaration caches")
  end
  if codegen3StageCount(warm, "parse") != 0 || codegen3StageCount(warm, "ffi") != 0 then
    t.Fatalf("warm build repeated front-end work: parse=%d ffi=%d",
      codegen3StageCount(warm, "parse"),
      codegen3StageCount(warm, "ffi")
    )
  end
end

func TestCodegen3SummaryInvalidFallsBackToParsing(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let moduleRoot = t.TempDir()
  writeFixture(t, moduleRoot, "go.mod", "module example.invalid/bad-summary\n\ngo 1.24\n")
  writeFixture(
    t,
    moduleRoot,
    "value.mygo",
    "package fixture\n\nfunc Value() -> Int\n  1\nend\n"
  )
  let cold = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, cold)
    case Err(err) => t.Fatalf("cold build: %v", err)
    case Ok(_) => ()
  end
  let fingerprint = codegen3SourceFingerprint(moduleRoot, cold)
  let summaryPath = codegen3SummaryPath(fingerprint)
  switch os.WriteFile(
    summaryPath,
    "truncated" as Slice[Byte],
    0o644 as os.FileMode
  )
    case Err(err) => t.Fatalf("corrupt summary: %v", err)
    case Ok(_) => ()
  end
  let warm = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, warm)
    case Err(err) => t.Fatalf("fallback build: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(warm, "cache-early-hit") != 0 then
    t.Fatalf("corrupt summary produced an early hit")
  end
  if codegen3StageCount(warm, "parse") == 0 then
    t.Fatalf("corrupt summary skipped parsing instead of falling back")
  end
  let repaired = codegen3EarlyHitState(t, moduleRoot)
  switch syncBootstrapMyGO3WithState(moduleRoot, repaired)
    case Err(err) => t.Fatalf("repaired-summary build: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(repaired, "cache-early-hit") != 1 then
    t.Fatalf("fallback did not repair the summary")
  end
end

func TestCodegen3SummaryTracksCheckoutIndependentSource(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let first = t.TempDir()
  let second = t.TempDir()
  let source = "package fixture\n\nfunc Value() -> Int\n  1\nend\n"
  writeFixture(t, first, "go.mod", "module example.invalid/summary-checkout\n\ngo 1.24\n")
  writeFixture(t, second, "go.mod", "module example.invalid/summary-checkout\n\ngo 1.24\n")
  writeFixture(t, first, "value.mygo", source)
  writeFixture(t, second, "value.mygo", source)
  let firstState = codegen3EarlyHitState(t, first)
  switch syncBootstrapMyGO3WithState(first, firstState)
    case Err(err) => t.Fatalf("first checkout: %v", err)
    case Ok(_) => ()
  end
  let secondState = codegen3EarlyHitState(t, second)
  switch syncBootstrapMyGO3WithState(second, secondState)
    case Err(err) => t.Fatalf("second checkout: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(secondState, "cache-early-hit") != 1 then
    t.Fatalf("second checkout did not reuse the summary")
  end
  let summaryRoot = filepath.Join(cache, "summaries")
  switch filepath.Glob(filepath.Join(summaryRoot, "*", "*.json"))
    case Err(err) => t.Fatalf("list summaries: %v", err)
    case Ok(paths) then
      if paths.Len() != 1 then
        t.Fatalf("summary files = %d, want one path-independent summary", paths.Len())
      end
    end
  end
end

func TestCodegen3TypedSummaryAcrossCheckouts(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", t.TempDir())
  let first = t.TempDir()
  let second = t.TempDir()
  let module = "module example.invalid/typed-checkout\n\ngo 1.24\n"
  let dependency = "package lib\n\nfunc Add(value: Int) -> Int\n  value + 1\nend\n"
  let importer = "package main\nimport lib \"example.invalid/typed-checkout/lib\"\nfunc Use() -> Int\n  lib.Add(\"wrong\")\nend\n"
  [first, second].Each(func(root: String) -> ()
    writeFixture(t, root, "go.mod", module)
    let dir = filepath.Join(root, "lib")
    switch os.MkdirAll(dir, 0o755 as os.FileMode)
      case Err(err) => t.Fatalf("create dependency: %v", err)
      case Ok(_) => ()
    end
    writeFixture(t, dir, "lib.mygo", dependency)
    writeFixture(t, root, "main.mygo", importer)
  end)
  let firstLib = filepath.Join(first, "lib")
  let cold = codegen3EarlyHitState(t, first)
  switch compileAbsoluteBootstrapDir(firstLib, cold, true)
    case Err(err) => t.Fatalf("compile first checkout: %v", err)
    case Ok(_) => ()
  end
  let secondLib = filepath.Join(second, "lib")
  let warm = codegen3EarlyHitState(t, second)
  switch codegen3ReadVerifiedTypedSummary(secondLib, warm, "main")
    case None => t.Fatal("second checkout did not reuse the typed summary")
    case Some(summary) then
      let source = summary.Sources.Get(0).Unwrap()
      let pos = source.Positions.Get(0).Unwrap()
      if source.Path != filepath.Join(secondLib, "lib.mygo") || pos.SourceName != source.Path || pos.Line != 3 || pos.Column != 1 then
        t.Fatalf("source location was not rebased: %+v", pos)
      end
    end
  end
  let overlay = codegen3EarlyHitState(t, second)
  overlay.OverlayStamps.Set(secondLib, "unsaved")
  if codegen3ReadVerifiedTypedSummary(secondLib, overlay, "main").IsSome() then t.Fatal("overlay accepted a disk-derived summary") end
  let warmError = switch compileAbsoluteBootstrapDir(second, warm, true)
    case Ok(_) then
      t.Fatal("invalid importer was accepted")
      ""
    end
    case Err(err) => err.Error()
  end
  if codegen3StageCount(warm, "typed-dependency-hit") == 0 then t.Fatal("diagnostic did not use the cached dependency") end
  t.Setenv("MYGO_CACHE", "off")
  let uncached = codegen3EarlyHitState(t, second)
  let coldError = switch compileAbsoluteBootstrapDir(second, uncached, true)
    case Ok(_) then
      t.Fatal("uncached invalid importer was accepted")
      ""
    end
    case Err(err) => err.Error()
  end
  if warmError != coldError || strings.Contains(warmError, first) || !strings.Contains(warmError, "main.mygo:4:11") then
    t.Fatalf("cached diagnostic differs from source: cached=%s source=%s", warmError, coldError)
  end
end

func TestCodegen3TypedSummaryTestInputIdentity(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", t.TempDir())
  let root = t.TempDir()
  writeFixture(t, root, "go.mod", "module example.invalid/test-summary\n\ngo 1.24\n")
  writeFixture(t, root, "main.mygo", "package fixture\nfunc Value() -> Int\n  1\nend\n")
  writeFixture(t, root, "main_test.mygo", "package fixture\nfunc InternalHelper() -> Int\n  Value()\nend\n")
  writeFixture(t, root, "external_test.mygo", "package fixture_test\nfunc ExternalHelper() -> Int\n  2\nend\n")
  let cold = codegen3EarlyHitState(t, root)
  switch compileAbsoluteBootstrapDir(root, cold, true)
    case Err(err) => t.Fatalf("compile test inputs: %v", err)
    case Ok(_) => ()
  end
  let warm = codegen3EarlyHitState(t, root)
  if codegen3ReadVerifiedTypedSummary(root, warm, "internal-test").IsNone() then t.Fatal("internal-test summary missing") end
  if codegen3ReadVerifiedTypedSummary(root, warm, "main").IsSome() || codegen3ReadVerifiedTypedSummary(root, warm, "external-test").IsSome() then
    t.Fatal("test summary was accepted for another input kind")
  end
  writeFixture(t, root, "main_test.mygo", "package fixture\nfunc InternalHelper() -> Int\n  Value() + 1\nend\n")
  let changed = codegen3EarlyHitState(t, root)
  if codegen3ReadVerifiedTypedSummary(root, changed, "internal-test").IsSome() then t.Fatal("changed test input reused a stale summary") end
end

