func TestCodegen3OnDemandTypedDependencyHit(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let root = t.TempDir()
  writeFixture(t, root, "go.mod", "module example.invalid/typed-dep\n\ngo 1.24\n")
  let lib = filepath.Join(root, "lib")
  switch os.MkdirAll(lib, 0o755 as os.FileMode)
    case Err(err) => t.Fatalf("create dependency: %v", err)
    case Ok(_) => ()
  end
  let util = filepath.Join(root, "util")
  switch os.MkdirAll(util, 0o755 as os.FileMode)
    case Err(err) => t.Fatalf("create transitive dependency: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, util, "util.mygo", "package util\nfunc Identity(value: Int) -> Int\n  value\nend\n")
  writeFixture(t, lib, "lib.mygo", "package lib\nimport util \"example.invalid/typed-dep/util\"\nlet Value = 7\nfunc Add(a: Int, b: Int)\n  util.Identity(a + b)\nend\n")
  writeFixture(t, root, "main.mygo", "package main\nimport lib \"example.invalid/typed-dep/lib\"\nfunc Use() -> Int\n  lib.Add(lib.Value, 1)\nend\n")
  let cold = codegen3EarlyHitState(t, root)
  switch compileAbsoluteBootstrapDir(root, cold, true)
    case Err(err) => t.Fatalf("cold build: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, root, "main.mygo", "package main\nimport lib \"example.invalid/typed-dep/lib\"\nfunc Use() -> Int\n  lib.Add(lib.Value, 2)\nend\n")
  let warm = codegen3EarlyHitState(t, root)
  switch compileAbsoluteBootstrapDir(root, warm, true)
    case Err(err) => t.Fatalf("warm build: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(warm, "typed-dependency-hit") == 0 || warm.SourcesCache.Get(lib).IsSome() || codegen3StageCount(warm, "parse") != 1 || codegen3StageCount(warm, "ffi") != 1 || codegen3StageCount(warm, "inference") != 1 then
    t.Fatalf("dependency was not reused: hits=%d parse=%d ffi=%d inference=%d", codegen3StageCount(warm, "typed-dependency-hit"), codegen3StageCount(warm, "parse"), codegen3StageCount(warm, "ffi"), codegen3StageCount(warm, "inference"))
  end
  if warm.SourcesCache.Get(util).IsSome() || warm.Compiled.Get(util).IsNone() then t.Fatal("transitive dependency was parsed or not staged") end
  let warmOutput = os.ReadFile(filepath.Join(bootstrapCodegen3OutputDir(warm, root).Unwrap(), "zz_main.gen.go")).Unwrap()
  t.Setenv("MYGO_CACHE", "off")
  let uncached = codegen3EarlyHitState(t, root)
  switch compileAbsoluteBootstrapDir(root, uncached, true)
    case Err(err) => t.Fatalf("cache-off build: %v", err)
    case Ok(_) => ()
  end
  let uncachedOutput = os.ReadFile(filepath.Join(bootstrapCodegen3OutputDir(uncached, root).Unwrap(), "zz_main.gen.go")).Unwrap()
  if !bytes.Equal(warmOutput, uncachedOutput) then t.Fatal("cached and cache-off output differ") end
  t.Setenv("MYGO_CACHE", cache)
  let key = cold.PackageKeys.Get(lib).UnwrapOr("")
  switch os.WriteFile(codegen3TypedSummaryPath(key, "main"), "corrupt" as Slice[Byte], 0o644 as os.FileMode)
    case Err(err) => t.Fatalf("corrupt dependency summary: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, root, "main.mygo", "package main\nimport lib \"example.invalid/typed-dep/lib\"\nfunc Use() -> Int\n  lib.Add(lib.Value, 3)\nend\n")
  let fallback = codegen3EarlyHitState(t, root)
  switch compileAbsoluteBootstrapDir(root, fallback, true)
    case Err(err) => t.Fatalf("corrupt-summary fallback: %v", err)
    case Ok(_) => ()
  end
  if fallback.SourcesCache.Get(lib).IsNone() then t.Fatal("corrupt dependency summary did not fall back to source") end
end

func TestCodegen3TypedDependencyInstanceParity(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", t.TempDir())
  let root = t.TempDir()
  writeFixture(t, root, "go.mod", "module example.invalid/typed-instance\n\ngo 1.24\n")
  let lib = filepath.Join(root, "lib")
  switch os.MkdirAll(lib, 0o755 as os.FileMode)
    case Err(err) => t.Fatalf("create dependency: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, lib, "lib.mygo", """package lib
interface Render[A]
  func Render(value: A) -> String
end
impl Int: Render[Int]
  func Render(value: Int) -> String
    "int"
  end
end
func RenderInt(value: Int) -> String
  value.Render()
end
""")
  writeFixture(t, root, "main.mygo", "package main\nimport lib \"example.invalid/typed-instance/lib\"\nfunc Use() -> String\n  lib.RenderInt(1)\nend\n")
  let cold = codegen3EarlyHitState(t, root)
  switch compileAbsoluteBootstrapDir(root, cold, true)
    case Err(err) => t.Fatalf("cold build: %v", err)
    case Ok(_) => ()
  end
  switch codegen3ReadVerifiedTypedSummary(lib, codegen3EarlyHitState(t, root), "main")
    case None => t.Fatal("instance dependency summary missing")
    case Some(summary) then
      if summary.Instances.Len() == 0 || summary.DynamicMetadata == "" then t.Fatal("instance or dynamic metadata was lost") end
    end
  end
  writeFixture(t, root, "main.mygo", "package main\nimport lib \"example.invalid/typed-instance/lib\"\nfunc Use() -> String\n  lib.RenderInt(2)\nend\n")
  let warm = codegen3EarlyHitState(t, root)
  switch compileAbsoluteBootstrapDir(root, warm, true)
    case Err(err) => t.Fatalf("warm build: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(warm, "typed-dependency-hit") == 0 then t.Fatal("instance dependency was not reused") end
  let warmOutput = os.ReadFile(filepath.Join(bootstrapCodegen3OutputDir(warm, root).Unwrap(), "zz_main.gen.go")).Unwrap()
  t.Setenv("MYGO_CACHE", "off")
  let uncached = codegen3EarlyHitState(t, root)
  switch compileAbsoluteBootstrapDir(root, uncached, true)
    case Err(err) => t.Fatalf("cache-off build: %v", err)
    case Ok(_) => ()
  end
  let uncachedOutput = os.ReadFile(filepath.Join(bootstrapCodegen3OutputDir(uncached, root).Unwrap(), "zz_main.gen.go")).Unwrap()
  if !bytes.Equal(warmOutput, uncachedOutput) then t.Fatal("instance dependency changed generated output") end
end

