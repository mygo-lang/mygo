func TestCodegen3TypedDependencyDynamicBoxingParity(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", t.TempDir())
  let root = t.TempDir()
  writeFixture(t, root, "go.mod", "module example.invalid/dynamic-cache\n\ngo 1.24\n")
  let contracts = filepath.Join(root, "contracts")
  let backend = filepath.Join(root, "backend")
  [contracts, backend].Each(func(dir: String) -> ()
    switch os.MkdirAll(dir, 0o755 as os.FileMode)
      case Err(err) => t.Fatalf("create package: %v", err)
      case Ok(_) => ()
    end
  end)
  writeFixture(t, contracts, "anchor.go", "package contracts\n")
  writeFixture(t, backend, "anchor.go", "package backend\n")
  writeFixture(t, contracts, "contracts.mygo", "package contracts\ninterface Show[A]\n  func Show(value: A) -> String\nend\n")
  writeFixture(t, backend, "backend.mygo", """package backend
import contracts "example.invalid/dynamic-cache/contracts"
struct Widget
  Name: String
end
impl WidgetShow: contracts.Show[Widget]
  func Show(value: Widget) -> String
    value.Name
  end
end
""")
  let dynamicCall = "MygoDynamic" + "ShowCallShow"
  let app = "package main\nimport backend \"example.invalid/dynamic-cache/backend\"\nimport contracts \"example.invalid/dynamic-cache/contracts\"\nfunc Use() -> String\n  let widget = backend.Widget { Name: \"hello\" }\n  let boxed = widget as contracts.Show\n  " + dynamicCall + "(boxed)\nend\nfunc main() -> ()\n  let _ = Use()\n  ()\nend\n"
  writeFixture(t, root, "main.mygo", app)
  let cold = codegen3EarlyHitState(t, root)
  switch compileAbsoluteBootstrapDir(root, cold, true)
    case Err(err) => t.Fatalf("cold dynamic build: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, root, "main.mygo", app + "\n")
  let warm = codegen3EarlyHitState(t, root)
  switch compileAbsoluteBootstrapDir(root, warm, true)
    case Err(err) => t.Fatalf("warm dynamic build: %v", err)
    case Ok(_) => ()
  end
  if codegen3StageCount(warm, "typed-dependency-hit") == 0 then t.Fatal("dynamic dependencies were not reused") end
  let warmOutput = os.ReadFile(filepath.Join(bootstrapCodegen3OutputDir(warm, root).Unwrap(), "zz_main.gen.go")).Unwrap()
  let options = PipelineOptions { Codegen3: true, OptimizationLevel: 2, IR3Dump: "", EmitDir: "", NoPrelude: true }
  switch buildCodegen3(root, options, false, ["-buildvcs=false", "-o", filepath.Join(root, "warm-app")])
    case Err(err) then
      let backendDir = bootstrapCodegen3OutputDir(cold, backend).Unwrap()
      let generated = os.ReadFile(filepath.Join(backendDir, "zz_backend.gen.go")).UnwrapOr([] as Slice[Byte])
      t.Fatalf("warm dynamic Go build: %v\nbackend:\n%s", err, generated)
    end
    case Ok(_) => ()
  end
  t.Setenv("MYGO_CACHE", "off")
  let uncached = codegen3EarlyHitState(t, root)
  switch compileAbsoluteBootstrapDir(root, uncached, true)
    case Err(err) => t.Fatalf("cache-off dynamic build: %v", err)
    case Ok(_) => ()
  end
  let sourceOutput = os.ReadFile(filepath.Join(bootstrapCodegen3OutputDir(uncached, root).Unwrap(), "zz_main.gen.go")).Unwrap()
  if !bytes.Equal(warmOutput, sourceOutput) then t.Fatal("dynamic boxing differs with caching disabled") end
end

