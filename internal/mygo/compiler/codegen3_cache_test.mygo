  switch os.MkdirAll(lib, 0o755 as os.FileMode)
    case Err(err) => t.Fatalf("lib directory: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, lib, "lib.mygo", "package lib\nfunc Value() -> Int\n  1\nend\n")
  writeFixture(t, root, "main.mygo", "package main\nimport lib \"example.invalid/signature-change/lib\"\nfunc Use() -> Int\n  lib.Value()\nend\n")
  let cold = codegen3EarlyHitState(t, root)
  switch compileAbsoluteBootstrapDir(root, cold, true)
    case Err(err) => t.Fatalf("cold build: %v", err)
    case Ok(_) => ()
  end
  writeFixture(t, lib, "lib.mygo", "package lib\nfunc Value() -> String\n  \"changed\"\nend\n")
  let warm = codegen3EarlyHitState(t, root)
  switch compileAbsoluteBootstrapDir(root, warm, true)
    case Ok(_) => t.Fatal("changed dependency signature was accepted")
