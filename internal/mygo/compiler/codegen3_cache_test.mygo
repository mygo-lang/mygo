func TestCodegen3SummaryValidationReusesSharedDependencies(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", t.TempDir())
  let root = t.TempDir()
  writeFixture(t, root, "go.mod", "module example.invalid/diamond\n\ngo 1.24\n")
  let _ = ["base", "left", "right", "top"].Fold(0, func(count: Int, name: String) -> Int
    switch os.MkdirAll(filepath.Join(root, name), 0o755 as os.FileMode)
      case Err(err) => t.Fatalf("fixture directory: %v", err)
      case Ok(_) => ()
    end
    count + 1
  end)
  writeFixture(t, filepath.Join(root, "base"), "base.mygo", "package base\n\nfunc Value() -> Int\n  1\nend\n")
  writeFixture(t, filepath.Join(root, "left"), "left.mygo", "package left\n\nimport base \"example.invalid/diamond/base\"\n\nfunc Value() -> Int\n  base.Value()\nend\n")
  writeFixture(t, filepath.Join(root, "right"), "right.mygo", "package right\n\nimport base \"example.invalid/diamond/base\"\n\nfunc Value() -> Int\n  base.Value()\nend\n")
  writeFixture(t, filepath.Join(root, "top"), "top.mygo", "package top\n\nimport left \"example.invalid/diamond/left\"\nimport right \"example.invalid/diamond/right\"\n\nfunc Value() -> Int\n  left.Value() + right.Value()\nend\n")
  let cold = codegen3EarlyHitState(t, root)
  switch syncBootstrapMyGO3WithState(root, cold)
    case Err(err) => t.Fatalf("cold graph: %v", err)
    case Ok(_) => ()
  end
  let warm = codegen3EarlyHitState(t, root)
  let top = filepath.Join(root, "top")
  let fingerprint = codegen3SourceFingerprint(top, warm)
  switch codegen3ReadPackageSummary(fingerprint)
    case None => t.Fatal("top summary missing")
    case Some(summary) then
      if !codegen3ValidatePackageSummary(top, warm, summary, {}) then
        t.Fatal("top summary did not validate")
      end
      var visiting: Map[String, Bool] = {}
      visiting.Set(top, true)
      if codegen3ValidatePackageSummary(top, warm, summary, visiting) then
        t.Fatal("active dependency cycle was accepted from the validation memo")
      end
    end
  end
  if codegen3StageCount(warm, "summary-validation") != 4 ||
    codegen3StageCount(warm, "source-digest") != 4 then
    t.Fatalf("validations=%d digests=%d, want 4 each",
      codegen3StageCount(warm, "summary-validation"), codegen3StageCount(warm, "source-digest"))
  end
end

func TestCodegen3CacheRecoversFromCorruptEntry(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let dir = t.TempDir()
  codegen3CacheTestSources(t, dir)
  switch buildCodegen3(dir, codegen3CacheTestOptions(), false, [])
    case Err(err) => t.Fatalf("first build: %v", err)
    case Ok(_) => ()
  end
  switch filepath.Glob(filepath.Join(cache, "build", "*", "*-d", "zz_add.gen.go"))
    case Err(err) => t.Fatalf("locate entry: %v", err)
    case Ok(matches) then
      if matches.Len() == 0 then
        t.Fatalf("%s", "entry file missing")
      end
      switch os.WriteFile(matches.Get(0).UnwrapOr(""), "corrupt" as Slice[Byte], 0o644 as os.FileMode)
        case Err(err) => t.Fatalf("corrupt entry: %v", err)
        case Ok(_) => ()
      end
    end
  end
  switch buildCodegen3(dir, codegen3CacheTestOptions(), false, [])
    case Err(err) => t.Fatalf("rebuild after corruption: %v", err)
    case Ok(_) => ()
  end
  let entries = codegen3CacheEntryDirs(cache)
  if entries.Len() == 0 then
    t.Fatalf("%s", "cache entry missing after recovery")
  end
  switch codegen3ReadEntry(entries.Get(0).UnwrapOr(""), "")
    case None => t.Fatalf("%s", "corrupt entry was not repaired")
    case Some(_) => ()
  end
end

func TestCodegen3EmitCopiesGeneratedFiles(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", t.TempDir())
  let dir = t.TempDir()
  codegen3CacheTestSources(t, dir)
  let emit = t.TempDir()
  let options = PipelineOptions {
    Codegen3: true,
    OptimizationLevel: 2,
    IR3Dump: "",
    EmitDir: emit,
    NoPrelude: true,
  }
  switch buildCodegen3(dir, options, false, [])
    case Err(err) => t.Fatalf("build with emit: %v", err)
    case Ok(_) => ()
  end
  if !codegen3FileExists(filepath.Join(emit, "zz_add.gen.go")) then
    t.Fatalf("%s", "emitted file missing")
  end
  if codegen3FileExists(filepath.Join(dir, "build")) then
    t.Fatalf("%s", "emit must not create a project-local build directory")
  end
end

func TestCodegen3CacheCleanRemovesEntries(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let dir = t.TempDir()
  codegen3CacheTestSources(t, dir)
  switch buildCodegen3(dir, codegen3CacheTestOptions(), false, [])
    case Err(err) => t.Fatalf("build: %v", err)
    case Ok(_) => ()
  end
  if codegen3CacheEntryDirs(cache).Len() == 0 then
    t.Fatalf("%s", "expected a cache entry before cleaning")
  end
  switch codegen3LockCache(true, 5000)
    case Err(err) => t.Fatalf("exclusive lock: %v", err)
    case Ok(_) then
      switch codegen3CacheClean()
        case Err(err) => t.Fatalf("clean: %v", err)
        case Ok(_) => ()
      end
      codegen3UnlockCache()
      ()
    end
  end
  if codegen3CacheEntryDirs(cache).Len() != 0 then
    t.Fatalf("%s", "clean left cache entries behind")
  end
end

func TestCodegen3CacheDisabled(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", "off")
  if codegen3CacheRootPath() != "" then
    t.Fatalf("%s", "MYGO_CACHE=off must disable the cache")
  end
  switch codegen3CacheClean()
    case Err(err) => t.Fatalf("clean with cache disabled: %v", err)
    case Ok(removed) then
      if removed != 0i64 then
        t.Fatalf("removed = %d, want 0", removed)
      end
    end
  end
end

func TestCodegen3CacheOffKeepsOutputDirectoriesDistinct(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", "off")
  let root = t.TempDir()
  writeFixture(t, root, "go.mod", "module example.invalid/cache-off-dirs\n\ngo 1.24\n")
  let first = filepath.Join(root, "first")
  let second = filepath.Join(root, "second")
  let app = filepath.Join(root, "app")
  [first, second, app].Each(func(dir: String) -> ()
    switch os.MkdirAll(dir, 0o755 as os.FileMode)
      case Err(err) => t.Fatalf("create package: %v", err)
      case Ok(_) => ()
    end
  end)
  writeFixture(t, first, "anchor.go", "package first\n")
  writeFixture(t, second, "anchor.go", "package second\n")
  writeFixture(t, first, "first.mygo", "package first\nfunc Value() -> Int\n  1\nend\n")
  writeFixture(t, second, "second.mygo", "package second\nfunc Value() -> Int\n  2\nend\n")
  writeFixture(t, app, "main.mygo", "package main\nimport first \"example.invalid/cache-off-dirs/first\"\nimport second \"example.invalid/cache-off-dirs/second\"\nfunc main() -> ()\n  let _ = first.Value() + second.Value()\n  ()\nend\n")
  let state = codegen3EarlyHitState(t, root)
  state.CacheEnabled = false
  state.CacheRoot = ""
  switch compileAbsoluteBootstrapDir(app, state, true)
    case Err(err) => t.Fatalf("cache-off build: %v", err)
    case Ok(_) => ()
  end
  let appDir = bootstrapCodegen3OutputDir(state, app).Unwrap()
  let firstDir = bootstrapCodegen3OutputDir(state, first).Unwrap()
  let secondDir = bootstrapCodegen3OutputDir(state, second).Unwrap()
  if appDir == firstDir || appDir == secondDir || firstDir == secondDir then
    t.Fatalf("cache-off output directories collide: app=%s first=%s second=%s", appDir, firstDir, secondDir)
  end
  switch codegen3ManifestRecords(state.ManifestPath)
    case Err(err) => t.Fatalf("read manifest: %v", err)
    case Ok(records) then
      let mismatches = records.Fold("", func(acc: String, record: codegen3ManifestRecord) -> String
        let relative = filepath.Rel(root, record.Dir).UnwrapOr("")
        let expected = filepath.Join(state.BuildRoot, relative) + "/"
        record.Files.Fold(acc, func(text: String, file: String) -> String
          if file.HasPrefix(expected) then text else text + "\n" + record.Dir + " -> " + file end
        end)
      end)
      if mismatches != "" then t.Fatalf("cache-off manifest contains foreign files:%s", mismatches) end
    end
  end
end

func TestCodegen3CacheExclusiveLockWait(t: Ref[testing.T]) -> ()
  t.Setenv("MYGO_CACHE", t.TempDir())
  switch codegen3LockCache(false, 5000)
    case Err(err) => t.Fatalf("shared lock: %v", err)
    case Ok(_) then
      switch codegen3LockCache(true, 50)
        case Ok(_) then
          codegen3UnlockCache()
          t.Fatalf("%s", "exclusive lock succeeded while a shared lock was held")
        end
        case Err(_) => ()
      end
      codegen3UnlockCache()
      ()
    end
  end
  switch codegen3LockCache(true, 5000)
    case Err(err) => t.Fatalf("exclusive lock after release: %v", err)
    case Ok(_) then
      codegen3UnlockCache()
      ()
    end
  end
end

func codegen3TestModule(t: Ref[testing.T], dir: String, modulePath: String) -> ()
  writeFixture(t, dir, "go.mod", "module " + modulePath + "\n\ngo 1.24\n")
  writeFixture(t, dir, "add.mygo", "package fixture\n\nfunc Add(a: Int, b: Int) -> Int\n  a + b\nend\n")
  writeFixture(t, dir, "add_test.mygo", "package fixture\n\nimport testing \"go:testing\"\n\nfunc TestAdd(t: Ref[testing.T]) -> ()\n  if Add(1, 2) != 3 then\n    t.Fatal(\"bad sum\")\n  end\nend\n")
end

func TestCodegen3TestSharedCacheAcrossModules(t: Ref[testing.T]) -> ()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  let first = t.TempDir()
  let second = t.TempDir()
  codegen3TestModule(t, first, "example.invalid/mod-one")
  codegen3TestModule(t, second, "example.invalid/mod-two")
  switch buildCodegen3(first, codegen3CacheTestOptions(), true, [])
    case Err(err) => t.Fatalf("first module test: %v", err)
    case Ok(_) => ()
  end
  switch buildCodegen3(second, codegen3CacheTestOptions(), true, [])
    case Err(err) => t.Fatalf("second module test: %v", err)
    case Ok(_) => ()
  end
  if codegen3CacheEntryDirs(cache).Len() != 1 then
    t.Fatalf("cache entries = %d, want one shared entry", codegen3CacheEntryDirs(cache).Len())
  end
  [first, second].Each(func(dir: String) -> ()
    if codegen3FileExists(filepath.Join(dir, "build")) then
      t.Fatalf("project-local build directory in %s", dir)
    end
  end)
end
