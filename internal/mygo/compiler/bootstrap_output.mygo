package compiler

import os "go:os"
import filepath "go:path/filepath"
import sort "go:sort"
import strings "go:strings"
import fmt "go:fmt"

func bootstrapCleanupOutputs(dir: String, written: Slice[String]) -> Result[(), Error]
  let known = written.Fold(
    {} as Map[String, Bool],
    func(paths: Map[String, Bool], path: String) -> Map[String, Bool]
      let name = filepath.Base(path)
      paths.Set(name, true)
      paths
    end
  )
  switch os.ReadDir(dir)
    case Err(err) => Err(bootstrapContext("cleanup-output", dir, err))
    case Ok(entries) then
      entries.Fold(
        Ok(()) as Result[(), Error],
        func(result: Result[(), Error], entry: os.DirEntry) -> Result[(), Error]
          result.AndThen(func(ignored: ()) -> Result[(), Error]
            let name = entry.Name()
            let metadata = "zz_mygo_metadata.gen.go"
            let eligible = strings.HasPrefix(name, "zz_") &&
              (strings.HasSuffix(name, ".gen.go") ||
                strings.HasSuffix(name, ".gen_test.go"))
            if entry.IsDir() ||
              !eligible ||
              known.Get(name).UnwrapOr(false) ||
              name == metadata then
              Ok(())
            else
              let path = filepath.Join(dir, name)
              switch os.ReadFile(path)
                case Err(err) => Err(bootstrapContext("cleanup-output", path, err))
                case Ok(raw) then
                  if bootstrapGeneratedSource(raw as String) then
                    os.Remove(path)
                  else
                    Ok(())
                  end
                end
              end
            end
          end)
        end
      )
    end
  end
end

# The generated banner is not always the first bytes: codegen3 output starts
# with a line directive that points back at the .mygo source.
func bootstrapGeneratedSource(text: String) -> Bool
  strings.Contains(text, "// Code generated by mygo;")
end

func bootstrapWriteOutputs(
  dir: String,
  generated: Map[String, String]
) -> Result[Slice[String], Error]
  let names = go[Slice[String]] {
    code: """func() []string {
      names := make([]string,0,len({generated}));
      for name := range {generated} {
        names = append(names,name)
      };
      return names
    }()"""
    in generated = generated
  }
  sort.Strings(names)
  let ordered = names.Filter(func(name: String) -> Bool
    name != "zz_mygo_metadata.gen.go"
  end).Concat(names.Filter(func(name: String) -> Bool
    name == "zz_mygo_metadata.gen.go"
  end))
  ordered.Fold(
    Ok([] as Slice[String]) as Result[Slice[String], Error],
    func(result: Result[Slice[String], Error], name: String) -> Result[Slice[String], Error]
      result.AndThen(func(written: Slice[String]) -> Result[Slice[String], Error]
        let path = filepath.Join(dir, name)
        switch bootstrapAtomicWrite(path, generated.Get(name).UnwrapOr(""))
          case Err(err) => Err(bootstrapContext("write-output", path, err))
          case Ok(_) then
            if strings.HasSuffix(name, ".go") then
              let displayed = go[String] {
                code: "displayPath({path})"
                in path = path
              }
              let _ = fmt.Println(displayed)
            end
            if strings.HasSuffix(name, ".go") && name != "zz_mygo_metadata.gen.go" then
              Ok(written.Append(path))
            else
              Ok(written)
            end
          end
        end
      end)
    end
  )
end

func bootstrapAtomicWrite(path: String, source: String) -> Result[(), Error]
  switch os.CreateTemp(filepath.Dir(path), ".mygo-output-*.tmp")
    case Err(err) => Err(err)
    case Ok(file) then
      let temporary = file.Name()
      let written = file.WriteString(source).AndThen(func(count: Int) -> Result[(), Error]
        file.Sync().AndThen(func(synced: ()) -> Result[(), Error]
          file.Chmod(0o644 as os.FileMode).AndThen(func(changed: ()) -> Result[(), Error]
            file.Close().AndThen(func(closed: ()) -> Result[(), Error]
              os.Rename(temporary, path)
            end)
          end)
        end)
      end)
      let _ = file.Close()
      let _ = os.Remove(temporary)
      written
    end
  end
end
