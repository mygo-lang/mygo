package compiler

import os "go:os"
import filepath "go:path/filepath"
import strings "go:strings"
import testing "go:testing"

func TestGeneratedOutputLifecycle(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  let obsolete = filepath.Join(dir, "zz_old.gen.go")
  let manual = filepath.Join(dir, "manual.txt")
  if os.WriteFile(obsolete, "// Code generated by mygo; DO NOT EDIT.\n" as Slice[Byte], 0o600 as os.FileMode).IsErr() || os.WriteFile(manual, "keep" as Slice[Byte], 0o600 as os.FileMode).IsErr() then
    t.Fatal("cannot create lifecycle fixtures")
  end
  let generated: Map[String, String] = {
    "zz_current.gen.go": "// Code generated by mygo; DO NOT EDIT.\n",
    "zz_mygo_metadata.gen.go": "// Code generated by mygo; DO NOT EDIT.\n",
  }
  switch bootstrapWriteOutputs(dir, generated)
    case Err(err) => t.Fatal(err)
    case Ok(written) then
      if written.Len() != 1 || !strings.HasSuffix(written.Get(0).UnwrapOr(""), "zz_current.gen.go") then t.Fatal("written path list is incorrect") end
    end
  end
  switch bootstrapCleanupOutputs(dir, [filepath.Join(dir, "zz_current.gen.go")])
    case Err(err) => t.Fatal(err)
    case Ok(_) then
      if os.ReadFile(obsolete).IsOk() then t.Fatal("obsolete generated outputs were retained") end
      if os.ReadFile(manual).IsErr() || os.ReadFile(filepath.Join(dir, "zz_current.gen.go")).IsErr() then
        t.Fatal("current output or unrelated file was removed")
      end
    end
  end
end
