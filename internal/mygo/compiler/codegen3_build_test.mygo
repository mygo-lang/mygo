package compiler

import json "go:encoding/json"
import os "go:os"
import exec "go:os/exec"
import filepath "go:path/filepath"
import strings "go:strings"
import testing "go:testing"

struct codegen3OverlayDecoded
  Replace: Map[String, String] `json:"Replace"`
end

struct codegen3PatternCase
  Name: String
  Args: Slice[String]
  Want: Slice[String]
end

func TestCodegen3OverlayIncludesPrelude(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  writeFixture(t, dir, "go.mod", "module github.com/mygo-lang/mygo\n\ngo 1.24\n")
  let generated = filepath.Join(dir, "entry", "zz_option.gen.go")
  switch os.MkdirAll(filepath.Dir(generated), 0o755 as os.FileMode)
    case Err(err) => t.Fatal(err)
    case Ok(_) then
      switch os.WriteFile(generated, "package prelude\n" as Slice[Byte], 0o600 as os.FileMode)
        case Err(err) => t.Fatal(err)
        case Ok(_) => ()
      end
    end
  end
  let manifest = filepath.Join(dir, "manifest.jsonl")
  switch codegen3ManifestAppend(manifest, filepath.Join(dir, "prelude"), [generated])
    case Err(err) => t.Fatalf("append manifest: %v", err)
    case Ok(_) => ()
  end
  let overlay = filepath.Join(dir, "overlay.json")
  switch codegen3OverlayResult(dir, manifest, overlay)
    case Err(err) => t.Fatalf("overlay: %v", err)
    case Ok(_) => ()
  end
  switch os.ReadFile(overlay)
    case Err(err) => t.Fatal(err)
    case Ok(raw) then
      var decoded = codegen3OverlayDecoded { Replace: {} }
      switch json.Unmarshal(raw, Ref.new(decoded))
        case Err(err) => t.Fatal(err)
        case Ok(_) then
          let target = filepath.Join(dir, "prelude", "zz_option.gen.go")
          if decoded.Replace.Get(target).UnwrapOr("") != generated then
            t.Fatalf("prelude overlay = %q, want %q", decoded.Replace.Get(target).UnwrapOr(""), generated)
          end
        end
      end
    end
  end
  let paths = codegen3ManifestCanonicalPackages(manifest)
  if paths.Len() != 1 || paths.Get(0).UnwrapOr("") != "github.com/mygo-lang/mygo/prelude" then
    t.Fatalf("canonical paths = %v", paths)
  end
end

func TestCodegen3OverlaySkipsExternalModuleTargets(t: Ref[testing.T]) -> ()
  let workspace = t.TempDir()
  let module = filepath.Join(t.TempDir(), "gomodcache", "example.invalid", "dep@v1.0.0")
  let source = filepath.Join(module, "prelude")
  let output = filepath.Join(workspace, "external", "example.invalid%2Fdep", "prelude")
  switch os.MkdirAll(source, 0o755 as os.FileMode)
    case Err(err) => t.Fatal(err)
    case Ok(_) => ()
  end
  writeFixture(t, module, "go.mod", "module example.invalid/dep\n\ngo 1.24\n")
  switch os.MkdirAll(output, 0o755 as os.FileMode)
    case Err(err) => t.Fatal(err)
    case Ok(_) => ()
  end
  let staged = filepath.Join(output, "zz_prelude.gen.go")
  switch os.WriteFile(staged, "package prelude\n" as Slice[Byte], 0o600 as os.FileMode)
    case Err(err) => t.Fatal(err)
    case Ok(_) => ()
  end
  let manifest = filepath.Join(workspace, "manifest.jsonl")
  switch codegen3ManifestAppend(manifest, source, [staged])
    case Err(err) => t.Fatalf("append manifest: %v", err)
    case Ok(_) => ()
  end
  let overlay = filepath.Join(workspace, "overlay.json")
  switch codegen3OverlayResult(workspace, manifest, overlay)
    case Err(err) => t.Fatalf("overlay: %v", err)
    case Ok(_) => ()
  end
  switch os.ReadFile(overlay)
    case Err(err) => t.Fatal(err)
    case Ok(raw) then
      var decoded = codegen3OverlayDecoded { Replace: {} }
      switch json.Unmarshal(raw, Ref.new(decoded))
        case Err(err) => t.Fatal(err)
        case Ok(_) then
          if decoded.Replace.Len() != 0 then
            t.Fatalf("external module unexpectedly has overlay targets: %v", decoded.Replace)
          end
        end
      end
    end
  end
  if codegen3FileExists(filepath.Join(source, "zz_prelude.gen.go")) then
    t.Fatal("overlay construction wrote generated output beside external source")
  end
end

func codegen3TestPackageOutputDir(
  outputRoot: String,
  moduleRoot: String,
  packageDir: String,
  importPath: String
) -> Result[String, Error]
  go[Result[String, Error]] {
    code: "bootstrapOutcome(codegen3PackageOutputDir({outputRoot}, {moduleRoot}, {packageDir}, {importPath}))"
    in outputRoot = outputRoot
    in moduleRoot = moduleRoot
    in packageDir = packageDir
    in importPath = importPath
  }
end

func codegen3TestPackageOutputLocation(
  outputRoot: String,
  moduleRoot: String,
  packageDir: String,
  importPath: String
) -> Result[Slice[String], Error]
  go[Result[Slice[String], Error]] {
    code: "bootstrapOutcome(codegen3PackageOutputLocation({outputRoot}, {moduleRoot}, {packageDir}, {importPath}))"
    in outputRoot = outputRoot
    in moduleRoot = moduleRoot
    in packageDir = packageDir
    in importPath = importPath
  }
end

func codegen3TestTemporaryModFile(moduleRoot: String, buildRoot: String) -> Result[String, Error]
  go[Result[String, Error]] {
    code: "bootstrapOutcome(codegen3CreateTemporaryModFile({moduleRoot}, {buildRoot}))"
    in moduleRoot = moduleRoot
    in buildRoot = buildRoot
  }
end

func codegen3TestContainedPath(root: String, candidate: String) -> Result[(), Error]
  go[Result[(), Error]] {
    code: "bootstrapOutcome(func() (struct{}, error) { return struct{}{}, verifyContainedOutputPath({root}, {candidate}) }())"
    in root = root
    in candidate = candidate
  }
end

func codegen3TestStrictImportPath(dir: String) -> Result[String, Error]
  go[Result[String, Error]] {
    code: "bootstrapOutcome(strictGoImportPathForDir({dir}))"
    in dir = dir
  }
end

func TestCodegen3PackageOutputPathMapping(t: Ref[testing.T]) -> ()
  let root = t.TempDir()
  let module = filepath.Join(root, "module")
  let output = filepath.Join(root, "build")
  let source = filepath.Join(module, "internal", "pkg")
  [module, output, source].Each(func(path: String) -> ()
    switch os.MkdirAll(path, 0o755 as os.FileMode)
      case Err(err) => t.Fatal(err)
      case Ok(_) => ()
    end
  end)
  switch codegen3TestPackageOutputDir(output, module, source, "example.invalid/mod/internal/pkg")
    case Err(err) => t.Fatal(err)
    case Ok(path) then
      let want = filepath.Join(output, "internal", "pkg")
      if path != want then t.Fatalf("module package output = %q, want %q", path, want) end
    end
  end
  let external = filepath.Join(root, "gomodcache", "example.invalid", "dep@v1.0.0", "prelude")
  switch os.MkdirAll(external, 0o755 as os.FileMode)
    case Err(err) => t.Fatal(err)
    case Ok(_) => ()
  end
  writeFixture(
    t,
    filepath.Dir(external),
    "go.mod",
    "module example.invalid/dep\n\ngo 1.24\n"
  )
  switch codegen3TestPackageOutputDir(output, module, external, "example.invalid/dep/prelude")
    case Err(err) => t.Fatal(err)
    case Ok(path) then
      let want = filepath.Join(output, "external", "example.invalid%2Fdep", "prelude")
      if path != want then t.Fatalf("external package output = %q, want %q", path, want) end
      switch codegen3TestContainedPath(output, path)
        case Err(err) => t.Fatalf("external output containment: %v", err)
        case Ok(_) => ()
      end
    end
  end
  switch codegen3TestPackageOutputDir(output, module, external, "example.invalid/other")
    case Ok(path) => t.Fatalf("mismatched canonical import path mapped to %q", path)
    case Err(err) then
      if !strings.Contains(err.Error(), "does not match module path") then
        t.Fatalf("canonical import mismatch diagnostic = %v", err)
      end
    end
  end
  switch codegen3TestPackageOutputDir(output, module, external, "")
    case Ok(path) => t.Fatalf("external package without import path mapped to %q", path)
    case Err(err) then
      if !strings.Contains(err.Error(), "no canonical import path") then
        t.Fatalf("missing import path diagnostic = %v", err)
      end
    end
  end
  let collisionRootA = filepath.Join(root, "module-a")
  let collisionRootB = filepath.Join(root, "module-b")
  let packageA = filepath.Join(collisionRootA, "pkg")
  let packageB = filepath.Join(collisionRootB, "pkg")
  [packageA, packageB].Each(func(path: String) -> ()
    switch os.MkdirAll(path, 0o755 as os.FileMode)
      case Err(err) => t.Fatal(err)
      case Ok(_) => ()
    end
  end)
  writeFixture(t, collisionRootA, "go.mod", "module example.invalid/a/b\n\ngo 1.24\n")
  writeFixture(t, collisionRootB, "go.mod", "module example.invalid/a%2Fb\n\ngo 1.24\n")
  switch codegen3TestPackageOutputDir(output, module, packageA, "example.invalid/a/b/pkg")
    case Err(err) => t.Fatal(err)
    case Ok(pathA) then
      switch codegen3TestPackageOutputDir(output, module, packageB, "example.invalid/a%2Fb/pkg")
        case Err(err) => t.Fatal(err)
        case Ok(pathB) then
          if pathA == pathB then
            t.Fatalf("distinct module paths collided at %q", pathA)
          end
        end
      end
    end
  end
  switch codegen3TestPackageOutputDir(output, module, t.TempDir(), "example.invalid/no-module")
    case Ok(path) => t.Fatalf("package without a module root mapped to %q", path)
    case Err(err) then
      if !strings.Contains(err.Error(), "no module root") then
        t.Fatalf("missing module root diagnostic = %v", err)
      end
    end
  end
end

func TestCodegen3OutputPathRejectsTraversalAndSymlinkEscape(t: Ref[testing.T]) -> ()
  let root = t.TempDir()
  let outside = t.TempDir()
  switch codegen3TestContainedPath(root, outside)
    case Ok(_) => t.Fatal("absolute outside path was accepted")
    case Err(_) => ()
  end
  switch codegen3TestContainedPath(root, filepath.Join(root, "..", "outside"))
    case Ok(_) => t.Fatal("parent traversal was accepted")
    case Err(_) => ()
  end
  let link = filepath.Join(root, "external")
  switch os.Symlink(outside, link)
    case Err(_) => ()
    case Ok(_) then
      switch codegen3TestContainedPath(root, filepath.Join(link, "pkg"))
        case Ok(_) => t.Fatal("symlink escape was accepted")
        case Err(_) => ()
      end
      if codegen3FileExists(filepath.Join(outside, "pkg")) then
        t.Fatal("containment validation created a path outside the output root")
      end
    end
  end
end

func TestCodegen3StrictImportPathForReplacementModule(t: Ref[testing.T]) -> ()
  let module = t.TempDir()
  writeFixture(t, module, "go.mod", "module example.invalid/replaced\n\ngo 1.24\n")
  let pkg = filepath.Join(module, "prelude")
  switch os.MkdirAll(pkg, 0o755 as os.FileMode)
    case Err(err) => t.Fatal(err)
    case Ok(_) => ()
  end
  switch codegen3TestStrictImportPath(pkg)
    case Err(err) => t.Fatal(err)
    case Ok(path) then
      if path != "example.invalid/replaced/prelude" then
        t.Fatalf("replacement import path = %q", path)
      end
    end
  end
  switch codegen3TestStrictImportPath(t.TempDir())
    case Ok(path) => t.Fatalf("directory without go.mod got import path %q", path)
    case Err(_) => ()
  end
end

func TestCodegen3StagesExternalModuleAndUsesTemporaryModFile(t: Ref[testing.T]) -> ()
  let project = t.TempDir()
  let build = filepath.Join(project, "build", "cache")
  let module = filepath.Join(t.TempDir(), "gomodcache", "example.invalid", "dep@v1.0.0")
  let pkg = filepath.Join(module, "prelude")
  writeFixture(t, project, "go.mod", "module example.invalid/app\n\ngo 1.24\n\nrequire example.invalid/dep v1.0.0\n")
  writeFixture(t, project, "go.sum", "example.invalid/dep v1.0.0 h1:unchanged\n")
  writeFixture(t, module, "go.mod", "module example.invalid/dep\n\ngo 1.24\n")
  writeFixture(t, module, "prelude/value.mygo", "package prelude\n")
  switch codegen3TestPackageOutputLocation(build, project, pkg, "example.invalid/dep/prelude")
    case Err(err) => t.Fatalf("stage external package: %v", err)
    case Ok(paths) then
      let output = paths.Get(0).UnwrapOr("")
      let stage = paths.Get(1).UnwrapOr("")
      if output != filepath.Join(build, "external", "example.invalid%2Fdep", "prelude") then
        t.Fatalf("staged package output = %q", output)
      end
      if stage != filepath.Join(build, "external", "example.invalid%2Fdep") then
        t.Fatalf("staged module root = %q", stage)
      end
      if !codegen3FileExists(filepath.Join(stage, "prelude", "value.mygo")) then
        t.Fatal("external MyGO source was not copied into the build root")
      end
      if codegen3FileExists(filepath.Join(pkg, "zz_value.gen.go")) then
        t.Fatal("staging wrote generated output beside the original source")
      end
    end
  end
  switch codegen3TestTemporaryModFile(project, build)
    case Err(err) => t.Fatalf("create temporary modfile: %v", err)
    case Ok(modFile) then
      switch os.ReadFile(modFile)
        case Err(err) => t.Fatal(err)
        case Ok(raw) then
          let content = raw as String
          if !strings.Contains(content, "replace example.invalid/dep => "+filepath.Join(build, "external", "example.invalid%2Fdep")) then
            t.Fatalf("temporary modfile has no staged replacement: %s", content)
          end
        end
      end
      if codegen3FileExists(filepath.Join(project, "codegen3.mod")) || codegen3FileExists(filepath.Join(project, "codegen3.sum")) then
        t.Fatal("temporary module files were written into the source project")
      end
      switch os.ReadFile(filepath.Join(project, "go.mod"))
        case Err(err) => t.Fatal(err)
        case Ok(raw) then
          if !strings.Contains(raw as String, "require example.invalid/dep v1.0.0") then
            t.Fatal("project go.mod was changed")
          end
        end
      end
      switch os.ReadFile(filepath.Join(project, "go.sum"))
        case Err(err) => t.Fatal(err)
        case Ok(raw) then
          if (raw as String) != "example.invalid/dep v1.0.0 h1:unchanged\n" then
            t.Fatal("project go.sum was changed")
          end
        end
      end
      writeFixture(t, build, "codegen3.sum", "temporary checksum added by go list\n")
      switch codegen3TestTemporaryModFile(project, build)
        case Err(err) => t.Fatalf("refresh temporary modfile: %v", err)
        case Ok(_) =>
          switch os.ReadFile(filepath.Join(build, "codegen3.sum"))
            case Err(err) => t.Fatal(err)
            case Ok(raw) then
              if (raw as String) != "temporary checksum added by go list\n" then
                t.Fatal("refreshing the temporary modfile discarded generated checksums")
              end
            end
          end
      end
    end
  end
end

func TestCodegen3GenericMethodNoneUsesDeclaredReturnType(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  t.Setenv("MYGO_CACHE", t.TempDir())
  writeFixture(t, dir, "go.mod", "module github.com/mygo-lang/mygo/prelude\n\ngo 1.24\n")
  writeFixture(
    t,
    dir,
    "option.mygo",
    "package prelude\nenum Option[A]\n  Some(A)\n  None\nend\nimpl[A] Option[A]\n  func Default() -> Option[A]\n    None\n  end\nend\n"
  )
  switch buildCodegen3(
    dir,
    PipelineOptions {
      Codegen3: true,
      OptimizationLevel: 2,
      IR3Dump: "",
      EmitDir: "",
      NoPrelude: true,
    },
    false,
    []
  )
    case Err(err) => t.Fatalf("generic None method: %v", err)
    case Ok(_) => ()
  end
end

func TestCodegen3GenericCallReceivesUsingDictionary(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  t.Setenv("MYGO_CACHE", t.TempDir())
  writeFixture(t, dir, "go.mod", "module example.invalid/generic-dictionary\n\ngo 1.24\n")
  writeFixture(
    t,
    dir,
    "main.mygo",
    """package main
interface Render[A]
  func Render(value: A) -> String
end

impl Int: Render[Int]
  func Render(value: Int) -> String
    "int"
  end
end

struct Box[A]
  value: A
end

func describe[A](box: Box[A]) -> String using Render[A]
  box.value.Render()
end

func use(value: Int) -> String
  describe(Box[Int] { value: value })
end

func main() -> ()
  let _ = use(1)
  ()
end
"""
  )
  switch buildCodegen3(
    dir,
    PipelineOptions {
      Codegen3: true,
      OptimizationLevel: 1,
      IR3Dump: "",
      EmitDir: "",
      NoPrelude: true,
    },
    false,
    ["-buildvcs=false", "-o", filepath.Join(dir, "app")]
  )
    case Err(err) => t.Fatalf("generic using dictionary: %v", err)
    case Ok(_) => ()
  end
end

func TestCodegen3OptionRefGenericMethodBoundary(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  t.Setenv("MYGO_CACHE", t.TempDir())
  writeFixture(t, dir, "go.mod", "module github.com/mygo-lang/mygo/prelude\n\ngo 1.24\n")
  writeFixture(
    t,
    dir,
    "option.mygo",
    """package prelude
enum Option[A]
  Some(A)
  None
end
impl[A] Option[A]
  func Echo(value: Option[A]) -> Option[A]
    value
  end
end
impl[A] Option[Option[A]]
  func Flatten(value: Option[Option[A]]) -> Option[A]
    switch value
      case Some(inner) => inner
      case None => None
    end
  end
end
func convert(value: Option[Ref[Int]]) -> Option[Ref[Int]]
  value.Echo()
end
func identity[A](value: Option[A]) -> Option[A]
  value
end
func convertDirect(value: Option[Ref[Int]]) -> Option[Ref[Int]]
  identity(value)
end
func shadow(identity: func(Option[Ref[Int]]) -> Option[Ref[Int]], value: Option[Ref[Int]]) -> Option[Ref[Int]]
  identity(value)
end
func flatten(value: Option[Option[Int]]) -> Option[Int]
  value.Flatten()
end
func present(value: Option[Ref[Int]]) -> Bool
  switch value
    case Some(_) => true
    case None => false
  end
end
func bothPresent(first: Option[Ref[Int]], second: Option[Ref[Int]]) -> Bool
  let a = switch first
    case Some(_) => true
    case None => false
  end
  let b = switch second
    case Some(_) => true
    case None => false
  end
  a && b
end
func pair(left: Option[(Int, Int)], right: Option[(Int, Int)]) -> Int
  switch (left, right)
    case (Some((a, b)), Some((c, d))) => a + b + c + d
    case _ => 0
  end
end
"""
  )
  writeFixture(
    t,
    dir,
    "option_test.go",
    """package prelude
import "testing"
func TestRoundTrip(t *testing.T) {
  value := 7
  if convert(&value) != &value { t.Fatal("lost reference") }
  if convert(nil) != nil { t.Fatal("lost None") }
  if convertDirect(&value) != &value || convertDirect(nil) != nil { t.Fatal("incorrect generic function boundary") }
  if shadow(func(p *int) *int { return p }, &value) != &value { t.Fatal("shadowed function was misclassified") }
  if !present(&value) || present(nil) { t.Fatal("incorrect reference match") }
  if !bothPresent(&value, &value) || bothPresent(&value, nil) { t.Fatal("incorrect repeated matches") }
  nested := Option__Some(Option__Some(8))
  if flatten(nested).Some.F0 != 8 { t.Fatal("incorrect nested generic instance") }
  a := Option__Some(struct{ F0 int; F1 int }{1, 2})
  b := Option__Some(struct{ F0 int; F1 int }{3, 4})
  if pair(a, b) != 10 { t.Fatal("incorrect nested tuple match") }
}
"""
  )
  switch buildCodegen3(
    dir,
    PipelineOptions {
      Codegen3: true,
      OptimizationLevel: 2,
      IR3Dump: "",
      EmitDir: "",
      NoPrelude: true,
    },
    true,
    []
  )
    case Err(err) => t.Fatalf("generic Option reference boundary: %v", err)
    case Ok(_) => ()
  end
end

func TestCodegen3BuildStaysOutsideSourceTree(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  t.Setenv("MYGO_CACHE", t.TempDir())
  writeFixture(t, dir, "go.mod", "module example.invalid/codegen3-fixture\n\ngo 1.24\n")
  writeFixture(
    t,
    dir,
    "main.mygo",
    "package main\n\nfunc Add(a: Int, b: Int) -> Int\n  a + b\nend\n\nfunc main() -> ()\n  ()\nend\n"
  )
  let binary = filepath.Join(dir, "app")
  switch buildCodegen3(
    dir,
    PipelineOptions {
      Codegen3: true,
      OptimizationLevel: 1,
      IR3Dump: "",
      EmitDir: "",
      NoPrelude: true,
    },
    false,
    ["-o", binary]
  )
    case Err(err) => t.Fatalf("codegen3 build: %v", err)
    case Ok(_) => ()
  end
  if !codegen3FileExists(binary) then
    t.Fatal("codegen3 build did not produce a binary")
  end
  if codegen3FileExists(filepath.Join(dir, "build")) then
    t.Fatal("codegen3 created a project-local build directory")
  end
  let cached = codegen3CachedFile(t, "zz_main.gen.go")
  if !strings.Contains(cached, codegen3CacheRootPath()) then
    t.Fatalf("cached file %q is outside the cache root %q", cached, codegen3CacheRootPath())
  end
  assertNoGeneratedSources(t, dir)
end

func TestSyncBootstrapWithOptionsSelectsCodegen3(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  t.Setenv("MYGO_CACHE", t.TempDir())
  writeFixture(t, dir, "go.mod", "module example.invalid/codegen3-sync\n\ngo 1.24\n")
  writeFixture(t, dir, "main.mygo", "package main\n\nfunc main() -> ()\n  ()\nend\n")
  switch codegen3NewBuildRoot()
    case Err(err) => t.Fatalf("build root: %v", err)
    case Ok(buildRoot) then
      let manifest = filepath.Join(buildRoot, "manifest.jsonl")
      switch syncBootstrapMyGO3NoPrelude(dir, 0, buildRoot, manifest, "")
        case Err(err) => t.Fatalf("codegen3 sync: %v", err)
        case Ok(written) then
          if written.Len() == 0 then
            t.Fatal("codegen3 sync produced no files")
          end
          written.Each(func(path: String) -> ()
            if !strings.Contains(path, codegen3CacheRootPath()) then
              t.Fatalf("codegen3 wrote %q outside the cache root %s", path, codegen3CacheRootPath())
            end
          end)
        end
      end
      let _ = os.RemoveAll(buildRoot)
    end
  end
  if codegen3FileExists(filepath.Join(dir, "build")) then
    t.Fatal("codegen3 created a project-local build directory")
  end
  if codegen3CachedFile(t, "zz_main.gen.go") == "" then
    t.Fatal("expected zz_main.gen.go in the codegen3 cache")
  end
  switch syncBootstrapMyGONoPrelude(dir)
    case Err(err) => t.Fatalf("codegen2 sync: %v", err)
    case Ok(_) then
      if !codegen3FileExists(filepath.Join(dir, "zz_main.gen.go")) then
        t.Fatal("default backend did not write beside the source")
      end
    end
  end
end

func TestCodegen3RemainsOptInAndRollsBackToLegacyABI(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  let cache = t.TempDir()
  t.Setenv("MYGO_CACHE", cache)
  writeFixture(t, dir, "go.mod", "module example.invalid/codegen3-rollback\n\ngo 1.24\n")
  writeFixture(
    t,
    dir,
    "main.mygo",
    """package main
enum Color
  Red
  Blue
end
func main() -> ()
  let _ = Color.Red
  ()
end
"""
  )
  let gocache = t.TempDir()
  let defaultBinary = filepath.Join(dir, "default-app")
  switch syncBootstrapMyGONoPrelude(dir)
    case Err(err) => t.Fatalf("default codegen2 sync: %v", err)
    case Ok(_) => ()
  end
  let generatedPath = filepath.Join(dir, "zz_main.gen.go")
  switch os.ReadFile(generatedPath)
    case Err(err) => t.Fatal(err)
    case Ok(raw) then
      if !strings.Contains(raw as String, "type Color interface") then
        t.Fatal("default backend did not emit the legacy interface ABI")
      end
    end
  end
  runCodegen3FixtureGoBuild(t, dir, gocache, defaultBinary)
  switch os.Remove(generatedPath)
    case Err(err) => t.Fatal(err)
    case _ => ()
  end
  let codegen3Binary = filepath.Join(dir, "codegen3-app")
  switch buildCodegen3(
    dir,
    PipelineOptions {
      Codegen3: true,
      OptimizationLevel: 2,
      IR3Dump: "",
      EmitDir: "",
      NoPrelude: true,
    },
    false,
    ["-buildvcs=false", "-o", codegen3Binary]
  )
    case Err(err) => t.Fatalf("explicit codegen3 build: %v", err)
    case Ok(_) => ()
  end
  if codegen3FileExists(generatedPath) then
    t.Fatal("explicit codegen3 build wrote generated Go into the source tree")
  end
  switch os.ReadFile(codegen3CachedFile(t, "zz_main.gen.go"))
    case Err(err) => t.Fatal(err)
    case Ok(raw) then
      if !strings.Contains(raw as String, "type Color struct") ||
        strings.Contains(raw as String, "type Color interface") then
        t.Fatal("codegen3 cache did not use the canonical ABI")
      end
    end
  end
  switch syncBootstrapMyGONoPrelude(dir)
    case Err(err) => t.Fatalf("rollback codegen2 sync: %v", err)
    case Ok(_) => ()
  end
  switch os.ReadFile(generatedPath)
    case Err(err) => t.Fatal(err)
    case Ok(raw) then
      if !strings.Contains(raw as String, "type Color interface") then
        t.Fatal("rollback did not restore the legacy interface ABI")
      end
    end
  end
  runCodegen3FixtureGoBuild(t, dir, gocache, filepath.Join(dir, "rollback-app"))
end

func runCodegen3FixtureGoBuild(
  t: Ref[testing.T],
  dir: String,
  gocache: String,
  output: String
) -> ()
  t.Helper()
  let command = exec.Command("go", "build", "-buildvcs=false", "-o", output, ".")
  command.Dir = dir
  command.Env = os.Environ().Concat(["GOCACHE=" + gocache])
  switch command.CombinedOutput()
    case Err(err) => t.Fatalf("fixture go build failed: %v", err)
    case Ok(_) then
      if !codegen3FileExists(output) then
        t.Fatal("fixture go build produced no binary")
      end
    end
  end
end

func TestCodegen3PackagePatternsSkipsFlagsAndValues(t: Ref[testing.T]) -> ()
  let cases = [
    codegen3PatternCase {
      Name: "output and package",
      Args: ["-o", "out", "./cmd/mygo"],
      Want: ["./cmd/mygo"],
    },
    codegen3PatternCase { Name: "equals form", Args: ["-o=out", "./a"], Want: ["./a"] },
    codegen3PatternCase {
      Name: "several packages",
      Args: ["-tags", "x", "./a", "./b"],
      Want: [
        "./a",
        "./b",
      ],
    },
    codegen3PatternCase { Name: "flags only", Args: ["-v"], Want: [] },
  ]
  cases.Each(func(item: codegen3PatternCase) -> ()
    let got = codegen3PackagePatterns(item.Args)
    if strings.Join(got, ",") != strings.Join(item.Want, ",") then
      t.Fatalf("%s: patterns = %v, want %v", item.Name, got, item.Want)
    end
  end)
end

func TestCodegen3TargetDirsFollowsGoImports(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  writeFixture(t, dir, "go.mod", "module example.com/scoped\n\ngo 1.24\n")
  writeFixture(
    t,
    dir,
    "main/main.go",
    "package main\n\nimport _ \"example.com/scoped/dep\"\n\nfunc main() {}\n"
  )
  writeFixture(t, dir, "dep/dep.go", "package dep\n")
  writeFixture(t, dir, "dep/dep.mygo", "package dep\n")
  writeFixture(t, dir, "unused/unused.go", "package unused\n")
  writeFixture(t, dir, "unused/unused.mygo", "package unused\n")
  let scratch = t.TempDir()
  switch codegen3TestTemporaryModFile(dir, scratch)
    case Err(err) => t.Fatalf("create test modfile: %v", err)
    case Ok(modFile) then
      switch codegen3TargetDirs(dir, false, ["-o", "out", "./main"], "", scratch, modFile)
        case Err(err) => t.Fatalf("codegen3TargetDirs: %v", err)
        case Ok(dirs) then
          if dirs.Len() != 1 || filepath.Base(dirs.Get(0).UnwrapOr("")) != "dep" then
            t.Fatalf("scoped dirs = %v, want only the imported dep package", dirs)
          end
        end
      end
    end
  end
end

func TestCodegen3TestCommandRunsExternalTestPackage(t: Ref[testing.T]) -> ()
  let dir = t.TempDir()
  t.Setenv("MYGO_CACHE", t.TempDir())
  writeFixture(t, dir, "go.mod", "module example.invalid/exttest\n\ngo 1.24\n")
  writeFixture(t, dir, "lib.mygo", "package lib\n\nfunc Double(n: Int) -> Int\n  n * 2\nend\n")
  writeFixture(
    t,
    dir,
    "lib_test.mygo",
    "package lib_test\n\nimport testing \"go:testing\"\n\nfunc TestDouble(t: Ref[testing.T]) -> ()\n  if Double(2) != 4 then\n    t.Fatal(\"bad double\")\n  end\nend\n"
  )
  switch buildCodegen3(
    dir,
    PipelineOptions {
      Codegen3: true,
      OptimizationLevel: 2,
      IR3Dump: "",
      EmitDir: "",
      NoPrelude: true,
    },
    true,
    []
  )
    case Err(err) => t.Fatalf("external test package: %v", err)
    case Ok(_) => ()
  end
  ["zz_lib.gen_test.go", "lib.gen_test.go"].Each(func(name: String) -> ()
    if codegen3FileExists(filepath.Join(dir, name)) then
      t.Fatalf("generated test wrapper %s was written beside the source", name)
    end
  end)
end
