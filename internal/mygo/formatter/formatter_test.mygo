package formatter

import testing "go:testing"
import strings "go:strings"
import parser2 "github.com/mygo-lang/mygo/internal/mygo/parser2"
import os "go:os"

func TestFormatterLayoutIsIdempotent(t: Ref[testing.T]) -> ()
  let src = "package sample\n\nfunc f() -> Int\n    1\nend\n"
  let first = formattedOrFail(t, FormatSource("sample.mygo", src))
  let second = formattedOrFail(t, FormatSource("sample.mygo", first))
  if first != second then
    t.Fatalf("formatter is not idempotent: %s", first)
  end
end

func formattedOrFail(t: Ref[testing.T], result: Result[String, String]) -> String
  switch result
    case Ok(value) => value
    case Err(message) then
      t.Fatalf("format failed: %s", message)
      ""
    end
  end
end

func TestFormatterPreservesProtectedLines(t: Ref[testing.T]) -> ()
  let src = "package sample\n# keep   comment\nfunc f() -> String\n  \"hello   world\"\nend\n"
  let got = formatLayout(src)
  if !strings.Contains(got, "hello   world") || !strings.Contains(got, "keep   comment") then
    t.Fatal("formatted output unexpectedly lost protected content")
  end
end

func TestFormatterPreservesInlineGoLine(t: Ref[testing.T]) -> ()
  let src = "package sample\nfunc f() -> String\n  go[String]{code: `strings.TrimSpace(x)` in x = \" value \"}\nend\n"
  let got = formatLayout(src)
  if !strings.Contains(got, "strings.TrimSpace(x)") then
    t.Fatal("formatted output unexpectedly changed inline Go")
  end
end

func TestFormatterKeepsDeclarationsAfterInterfaceTopLevel(t: Ref[testing.T]) -> ()
  let src = "package sample\ninterface IThing[A]\n  func Len(value: A) -> Int\nend\n\nfunc outside() -> Int\n  go[Int] {\n    code: \"1\"\n  }\nend\n"
  let want = "package sample\ninterface IThing[A]\n  func Len(value: A) -> Int\nend\n\nfunc outside() -> Int\n  go[Int] {\n    code: \"1\"\n  }\nend\n"
  let got = formattedOrFail(t, FormatSource("interface.mygo", src))
  if got != want then
    t.Fatalf("declarations after interface were not kept top-level: %s", got)
  end
end

func TestFormatterPreservesMultilineTripleString(t: Ref[testing.T]) -> ()
  let source = "package sample\nfunc f() -> String\n  \"\"\"first   line\n  second   line\n  \"\"\"\nend\n"
  let got = formatLayout(source)
  if !strings.Contains(got, "  second   line") then
    t.Fatal("multiline string contents changed")
  end
end

func TestFormatterReportsParser2Location(t: Ref[testing.T]) -> ()
  switch FormatSource("broken.mygo", "package sample\n\nfunc")
    case Ok(_) => t.Fatal("invalid source unexpectedly formatted")
    case Err(message) =>
      if !strings.Contains(message, "broken.mygo") then
        t.Fatalf("error lacks source name: %s", message)
      end
  end
end

func TestFormatterRepresentativeGolden(t: Ref[testing.T]) -> ()
  let src = "package sample\nstruct  Point\n  value: Int\nend\nfunc f() -> Int\n  let xs = [1,  2,  3]\n  xs.Len()\nend\n"
  let want = "package sample\nstruct Point\n  value: Int\nend\nfunc f() -> Int\n  let xs = [1, 2, 3]\n  xs.Len()\nend\n"
  if formatLayout(src) != want then
    t.Fatalf("representative golden mismatch: %s", formatLayout(src))
  end
end

func TestFormatterIfAndCaseGolden(t: Ref[testing.T]) -> ()
  let src = "package sample\nfunc f(x: Bool) -> Int\n if   x => 1 else 2\nend\nfunc g(x: Int) -> Int\n switch x\n  case 1 => 10\n  case _ then\n   0\n  end\n end\nend\n"
  let want = "package sample\nfunc f(x: Bool) -> Int\n  if x => 1 else 2\nend\nfunc g(x: Int) -> Int\n  switch x\n    case 1 => 10\n    case _ then\n      0\n    end\n  end\nend\n"
  if formatLayout(src) != want then
    t.Fatalf("if/case golden mismatch: %s", formatLayout(src))
  end
end

func TestFormatterUsesBranchEventLines(t: Ref[testing.T]) -> ()
  let source = "package sample\nfunc f(value: Bool) -> Int\n  if value then\n    1\n  else\n    2\n  end\nend\n"
  let got = formattedOrFail(t, FormatSource("events.mygo", source))
  if !strings.Contains(got, "  if value then") || !strings.Contains(got, "    1") || !strings.Contains(got, "    2") then
    t.Fatalf("branch event lines were not applied: %s", got)
  end
end

func TestFormatterCollectsExpectedBlockEventLines(t: Ref[testing.T]) -> ()
  let source = "package sample\nfunc f(value: Bool) -> Int\n  if value then\n    1\n  else\n    2\n  end\nend\n"
  switch parser2.ParseFileLossless("events.mygo", source)
    case Err(message) => t.Fatalf("lossless parse failed: %s", message)
    case Ok(parsed) =>
      if !hasLayoutEvent(parsed.LayoutEvents, "enter:decl:func", 2) || !hasLayoutEvent(parsed.LayoutEvents, "enter:if-then", 3) || !hasLayoutEvent(parsed.LayoutEvents, "enter:if-else", 5) then
        t.Fatal("missing parser-owned block anchors")
      end
  end
end

func TestFormatterDoesNotTreatScalarBodyAsBlock(t: Ref[testing.T]) -> ()
  let source = "package sample\nfunc f() -> Int\n  1\nend\n"
  switch parser2.ParseFileLossless("scalar.mygo", source)
    case Err(message) => t.Fatalf("lossless parse failed: %s", message)
    case Ok(parsed) =>
      if hasLayoutEvent(parsed.LayoutEvents, "enter:expr", 3) then
        t.Fatal("scalar expression was incorrectly classified as a block")
      end
  end
end

func hasLayoutEvent(events: Slice[parser2.LayoutEvent], kind: String, line: Int) -> Bool
  events.Filter(func(item: parser2.LayoutEvent) -> Bool item.Kind == kind && item.Anchor.Start.Line == line end).Len() > 0
end

func TestFormatterExpandsSingleLineFunctionBody(t: Ref[testing.T]) -> ()
  let source = "package sample\nfunc f() -> Int 1 end\n"
  let got = formattedOrFail(t, FormatSource("single-line.mygo", source))
  let want = "package sample\nfunc f() -> Int\n  1\nend\n"
  if got != want then
    t.Fatalf("single-line function body was not expanded: %s", got)
  end
end

func TestFormatterExpandsInlineIfExpression(t: Ref[testing.T]) -> ()
  let source = "package sample\nfunc f(value: Bool) -> Int\n  let rendered = if value then 1 else 2 end\n  rendered\nend\n"
  let got = formattedOrFail(t, FormatSource("inline-if.mygo", source))
  if !strings.Contains(got, "let rendered = if value then\n") || !strings.Contains(got, "else\n") || !strings.Contains(got, "end\n") then
    t.Fatalf("inline if expression was not expanded: %s", got)
  end
end


func TestFormatterWrapsLongCommaLists(t: Ref[testing.T]) -> ()
  let src = "package sample\nfunc f() -> Int\n  let values = [1111111111, 2222222222, 3333333333, 4444444444, 5555555555, 6666666666, 7777777777, 8888888888, 9999999999]\n  0\nend\n"
  let got = formatLayout(src)
  if !strings.Contains(got, ",\n  ") then
    t.Fatal("long comma list was not wrapped")
  end
end

func TestFormatterOutputRemainsParser2Valid(t: Ref[testing.T]) -> ()
  let source = "package sample\nenum Color\n  Red\n  Blue\nend\nfunc f(c: Color) -> Int\n  switch c\n    case Red => 1\n    case Blue => 2\n  end\nend\n"
  let formatted = formattedOrFail(t, FormatSource("sample.mygo", source))
  switch FormatSource("formatted.mygo", formatted)
    case Ok(_) => ()
    case Err(message) => t.Fatalf("formatted source failed parser2: %s", message)
  end
end

func TestFormatterPatternAndMultilineGolden(t: Ref[testing.T]) -> ()
  let source = "package sample\nfunc f(value: Option[Int]) -> Int\n  switch value\n    case Some(x) then\n      let y = x + 1\n      y\n    end\n    case None => 0\n  end\nend\n"
  let want = "package sample\nfunc f(value: Option[Int]) -> Int\n  switch value\n    case Some(x) then\n      let y = x + 1\n      y\n    end\n    case None => 0\n  end\nend\n"
  if formatLayout(source) != want then
    t.Fatalf("pattern/multiline golden mismatch: %s", formatLayout(source))
  end
end

func TestFormatterWideControlUsesBlocks(t: Ref[testing.T]) -> ()
  let condition = "veryLongConditionNameThatKeepsGoingAndGoingAndGoing"
  let branch = "veryLongBranchExpressionNameThatKeepsGoingAndGoingAndGoing"
  let ifLine = "if " + condition + " => " + branch + " else " + branch
  let caseLine = "case " + condition + " => " + branch
  let ifOutput = formatLayout("package sample\nfunc f() -> Int\n  " + ifLine + "\nend\n")
  let caseOutput = formatLayout("package sample\nfunc f(x: Int) -> Int\n  switch x\n    " + caseLine + "\n  end\nend\n")
  if !strings.Contains(ifOutput, "else\n") || !strings.Contains(ifOutput, "end\n") then
    t.Fatal("wide if was not converted to a block")
  end
  if !strings.Contains(caseOutput, " then\n") || !strings.Contains(caseOutput, "end\n") then
    t.Fatal("wide case was not converted to a block")
  end
end

func TestFormatterWideControlRemainsValidMyGO(t: Ref[testing.T]) -> ()
  let source = "package sample\nfunc f(veryLongConditionNameThatKeepsGoingAndGoingAndGoing: Bool) -> Int\n  if veryLongConditionNameThatKeepsGoingAndGoingAndGoing => veryLongBranchExpressionNameThatKeepsGoingAndGoingAndGoing else 0\nend\n"
  let result = FormatSource("wide.mygo", source)
  switch result
    case Err(message) => t.Fatalf("wide source rejected before formatting: %s", message)
    case Ok(formatted) =>
      switch FormatSource("wide-formatted.mygo", formatted)
        case Ok(_) => ()
        case Err(message) => t.Fatalf("wide formatted source is invalid: %s\nOUTPUT:\n%s", message, formatted)
      end
  end
end

func TestFormatterFunctionLiteralRemainsGeneric(t: Ref[testing.T]) -> ()
  let source = "package sample\nfunc outer() -> Int\n  let f = func(x: Int) -> Int\n  x + 1\n  end\n  f(1)\nend\n"
  let first = formattedOrFail(t, FormatSource("literal.mygo", source))
  let second = formattedOrFail(t, FormatSource("literal.mygo", first))
  if first != second || !strings.Contains(first, "func(x: Int) -> Int") then
    t.Fatalf("generic function literal handling mismatch: %s", first)
  end
end

func TestFormatterPreservesNestedFunctionLiteral(t: Ref[testing.T]) -> ()
  let source = "package sample\nfunc f(source: String) -> String\n  let state = source.Apply(\"value\", func(value: String) -> String transform(value) end)\n  state\nend\n"
  let got = formatLayout(source)
  if !strings.Contains(got, "source.Apply(\"value\", func(value: String) -> String transform(value) end)") then
    t.Fatalf("nested function literal was changed: %s", got)
  end
end

func TestFormatterGenericNestedLayoutIsIdempotent(t: Ref[testing.T]) -> ()
  let source = "package sample\n# retain   spacing\nfunc outer(value: String) -> String\n  let apply = func(item: String) -> String item end\n  value.Apply(\"  literal  \", apply).Apply(\"next\", func(item: String) -> String item end)\nend\n"
  let first = formattedOrFail(t, FormatSource("nested.mygo", source))
  let second = formattedOrFail(t, FormatSource("nested.mygo", first))
  if first != second then
    t.Fatalf("generic nested layout is not idempotent: %s", first)
  end
  if !strings.Contains(first, "literal") || !strings.Contains(first, "retain   spacing") then
    t.Fatalf("generic protected content changed: %s", first)
  end
end

func TestFormatterCaseThenBodyKeepsIndent(t: Ref[testing.T]) -> ()
  let src = "package sample\nfunc g(x: Int) -> Int\n  switch x\n    case 1 => 10\n    case _ then\n      0\n    end\n  end\nend\n"
  let got = formatLayout(src)
  if got != src then
    t.Fatalf("then-style case body layout changed: %s", got)
  end
end

# An arrow case with a BLOCK body (multi-row statements after the arrow, no
# then) has no keyword terminator.  The case exit must anchor on the next arm or
# the enclosing switch end, not on the case header: anchoring on the header
# cancels the indent bump the case contributes, under-indenting the whole body
# and swallowing the following arm into it.  Formatting round-trips and is a
# fixpoint.
func TestFormatterArrowCaseBlockBodyIndents(t: Ref[testing.T]) -> ()
  let src = """package sample
func scan(tokens: Slice[Int], index: Int) -> Int
  switch tokens.Get(index)
    case Some(token) =>
      let first = one(token)
      let second = two(token)
      three(first, second)
    case None => fallback
  end
end
"""
  let first = formattedOrFail(t, FormatSource("arrow-case.mygo", src))
  if first != src then
    t.Fatalf("arrow case block body did not keep its indent:\nGOT:\n%s\nWANT:\n%s", first, src)
  end
  let second = formattedOrFail(t, FormatSource("arrow-case.mygo", first))
  if second != first then
    t.Fatalf("arrow case block body is not idempotent:\nPASS1:\n%s\nPASS2:\n%s", first, second)
  end
end

func TestFormatterIfElsifElseBlockLayout(t: Ref[testing.T]) -> ()
  let src = "package sample\nfunc f(x: Int) -> Int\n  if x == 1 then\n    1\n  elsif x == 2 then\n    2\n  else\n    3\n  end\nend\n"
  let got = formatLayout(src)
  if got != src then
    t.Fatalf("if/elsif/else block layout changed: %s", got)
  end
end

# Task 12 (GOAL A): when an `if`'s else-branch is itself a block `if`, the
# enclosing `else` keyword must render at the `if` indent level (not +1).  A
# mis-indented source exercises the target-depth engine: it closes the
# then-branch at the `else` row via the emitted `if-else` event.
func TestFormatterElseWithBlockBodyIndents(t: Ref[testing.T]) -> ()
  let src = "package sample\nfunc f(x: Int) -> Int\n  if x > 0 then\n    1\n      else\n        if x == 0 then\n      2\n      else\n      3\n        end\n      end\nend\n"
  let want = "package sample\nfunc f(x: Int) -> Int\n  if x > 0 then\n    1\n  else\n    if x == 0 then\n      2\n    else\n      3\n    end\n  end\nend\n"
  let got = formatLayout(src)
  if got != want then
    t.Fatalf("else-block branch indent wrong:\nGOT:\n%s\nWANT:\n%s", got, want)
  end
  if formatLayout(got) != got then
    t.Fatalf("else-block branch is not idempotent: %s", formatLayout(got))
  end
end

func TestFormatterRawStringLinesVerbatim(t: Ref[testing.T]) -> ()
  let src = "package sample\nfunc f() -> Int\n  go[Int] {\n    code: \"\"\"\n      func() int {\n        return 1\n      }()\n    \"\"\"\n  }\n  0\nend\n"
  let got = formatLayout(src)
  if !strings.Contains(got, "\n        return 1\n") then
    t.Fatalf("raw string interior lines were re-indented: %s", got)
  end
  if got != src then
    t.Fatalf("inline Go raw string layout changed: %s", got)
  end
end

# Group 14: a keyword `if` in a value position whose CONDITION contains a branch
# keyword word inside a string literal (`== "case"`) must expand without dropping the
# then/else VALUES. The lexer splits `"case"` into `" case "` tokens, so a naive
# backward scan mis-counted the `then` and mis-bound the `if` exit anchor, which made
# the branch reflow render an EMPTY else branch (invalid). Re-parsing the output proves
# both branch values survived.
func TestFormatterValueIfWithKeywordInStringKeepsBranches(t: Ref[testing.T]) -> ()
  let src = "package sample\nfunc f(item: Node, items: Slice[Node]) -> Int\n  let bodyAnchor = if item.Kind == \"case\" then caseBodyAnchor(items, item, 0) else item.Span end\n  bodyAnchor\nend\n"
  let got = formattedOrFail(t, FormatSource("vif.mygo", src))
  if !strings.Contains(got, "caseBodyAnchor(items, item, 0)") || !strings.Contains(got, "item.Span") then
    t.Fatalf("value-if with a string keyword dropped a branch value:\n%s", got)
  end
  if !strings.Contains(formattedOrFail(t, FormatSource("vif.mygo", got)), "item.Span") then
    t.Fatalf("value-if reformat lost the else-branch value (output does not re-parse):\n%s", got)
  end
end

# Group 14: a value-position `if/elsif/else/end` chain on one source row is left inline
# (the single-pair branch reflow cannot own an `elsif` chain) and must keep every branch
# value. Before the guard the branch pass sliced the pair and dropped intermediate
# `elsif` values, emitting invalid output.
func TestFormatterValueIfElsifChainKeepsBranches(t: Ref[testing.T]) -> ()
  let src = "package sample\nfunc f(kind: String) -> Int\n  let x = if kind.HasPrefix(\"d\") then p(a) elsif kind == \"i\" then q(a) else item.Span end\n  x\nend\n"
  let got = formattedOrFail(t, FormatSource("elsif.mygo", src))
  if !strings.Contains(got, "p(a)") || !strings.Contains(got, "q(a)") || !strings.Contains(got, "item.Span") then
    t.Fatalf("value-if elsif chain dropped a branch value:\n%s", got)
  end
  let reparsed = formattedOrFail(t, FormatSource("elsif.mygo", got))
  if !strings.Contains(reparsed, "p(a)") || !strings.Contains(reparsed, "item.Span") then
    t.Fatalf("value-if elsif chain does not re-parse cleanly:\n%s", reparsed)
  end
end

# Group 16: a single-line VALUE-position `if/elsif/else/end` chain glues each body
# to its keyword header (`if a then b elsif c then d else e end`).  A glued body is
# non-canonical wherever it sits, so the whole-span pass owns the chain and expands
# EVERY branch to block form, re-attaching the enclosing `let x = ` prefix on the
# header row and any text after the shared `end` on the closing row.  The expanded
# block must re-parse and be a fixpoint.
func TestFormatterSingleLineValueIfElsifChainExpands(t: Ref[testing.T]) -> ()
  let src = """package sample

func m() -> Int
  let a = 1
  let x = if a then b elsif c then d else e end
  let dd = 4
end
"""
  let want = """package sample

func m() -> Int
  let a = 1
  let x = if a then
    b
  elsif c then
    d
  else
    e
  end
  let dd = 4
end
"""
  let got = formattedOrFail(t, FormatSource("inlineif.mygo", src))
  if got != want then
    t.Fatalf("single-line value-if elsif chain did not expand to a block:\nGOT:\n%s\nWANT:\n%s", got, want)
  end
  if formattedOrFail(t, FormatSource("inlineif.mygo", got)) != got then
    t.Fatalf("expanded value-if elsif chain is not idempotent:\n%s", got)
  end
end

# Task 13 (GOAL B): a func literal whose body is on its own row is indented one level
# under the func header, and the trailing `end` returns to the base indent.  An inline
# func literal (body on one row) is left byte-identical (depth-transparent).
func TestFormatterFuncLitBlockBodyIndents(t: Ref[testing.T]) -> ()
  let blockSrc = "package sample\nfunc f(tokens: Slice[Token], index: Int, raw: String) -> Bool\n  tokens.Get(index).Map(func(token: Token) -> Bool\n  token.Raw == raw\n  end).UnwrapOr(false)\nend\n"
  let want = "package sample\nfunc f(tokens: Slice[Token], index: Int, raw: String) -> Bool\n  tokens.Get(index).Map(func(token: Token) -> Bool\n    token.Raw == raw\n  end).UnwrapOr(false)\nend\n"
  let got = formatLayout(blockSrc)
  if got != want then
    t.Fatalf("func-lit block body indent wrong:\nGOT:\n%s\nWANT:\n%s", got, want)
  end
  if formatLayout(got) != got then
    t.Fatalf("func-lit block body is not idempotent: %s", formatLayout(got))
  end
  let inlineSrc = "package sample\nfunc f(tokens: Slice[Token], index: Int, raw: String) -> Bool\n  tokens.Get(index).Map(func(token: Token) -> Bool token.Raw == raw end).UnwrapOr(false)\nend\n"
  if formatLayout(inlineSrc) != inlineSrc then
    t.Fatalf("inline func-lit call chain changed: %s", formatLayout(inlineSrc))
  end
end

func TestFormatterWrappedListAdjacentToRawString(t: Ref[testing.T]) -> ()
  let src = "package sample\nfunc f() -> Int\n  let values = [1111111111, 2222222222, 3333333333, 4444444444, 5555555555, 6666666666, 7777777777, 8888888888, 9999999999]\n  go[Int] {\n    code: \"\"\"\n      func() int {\n        return 1\n      }()\n    \"\"\"\n  }\n  0\nend\n"
  let got = formatLayout(src)
  if !strings.Contains(got, "let values = [\n    1111111111,\n    2222222222,") then
    t.Fatalf("long list next to a raw string lost its wrap: %s", got)
  end
  if !strings.Contains(got, "\n        return 1\n") then
    t.Fatalf("raw string after a wrapped list lost verbatim lines: %s", got)
  end
  if formatLayout(got) != got then
    t.Fatalf("wrapped list plus raw string is not idempotent: %s", formatLayout(got))
  end
end

func TestFormatterWrappedDelimitedPreservesContent(t: Ref[testing.T]) -> ()
  let src = "package sample\nfunc f() -> Int\n  if reply.Ok then\n    ps.ReplyX { Ok: true, Consumed: reply.Consumed, Value: SpannedX { Value: reply.Value, Span: stateSpan(state, reply.State) }, State: reply.State, Error: reply.Error }\n  else\n    0\n  end\nend\n"
  let got = formatLayout(src)
  let flat = collapseWhitespace(got)
  if !strings.Contains(flat, "stateSpan(state,reply.State)") then
    t.Fatalf("wrapped delimited dropped callee name: %s", got)
  end
  if !strings.Contains(flat, "Span:") || !strings.Contains(flat, "Value:") || !strings.Contains(flat, "State:") || !strings.Contains(flat, "Error:") then
    t.Fatalf("wrapped delimited dropped a field label: %s", got)
  end
  if !strings.Contains(flat, "ps.ReplyX") then
    t.Fatalf("wrapped delimited dropped the outer callee: %s", got)
  end
  if formatLayout(got) != got then
    t.Fatalf("wrapped delimited is not idempotent: %s", formatLayout(got))
  end
end

func collapseWhitespace(text: String) -> String
  strings.ReplaceAll(strings.ReplaceAll(strings.ReplaceAll(text, " ", ""), "\t", ""), "\n", "")
end

# Task 9.1/9.3a: an over-long delimited literal whose nested construct is itself
# over-long must wrap BOTH levels in a SINGLE pass, with final indentation baked
# (base + 2 spaces per nesting level), a comma after every multiline item, and be
# byte-identical on a second pass (idempotent).  This is the (A) regression: the
# flat path wrapped only the outer level and re-wrapped the inner on pass 2.
func TestFormatterWrapsNestedOverLongLiteral(t: Ref[testing.T]) -> ()
  let src = "package sample\n\nfunc build(state: ScanState, reply: Reply) -> Int\n  Result { Ok: true, Consumed: reply.Consumed, Value: SpannedX { Value: reply.Value, Span: ps.SourceSpan { Filename: state.Filename, Offset: state.Offset, Line: state.Line, Column: state.Column } }, Error: none }\n  0\nend\n"
  let want = "package sample\n\nfunc build(state: ScanState, reply: Reply) -> Int\n  Result {\n    Ok: true,\n    Consumed: reply.Consumed,\n    Value: SpannedX {\n      Value: reply.Value,\n      Span: ps.SourceSpan {\n        Filename: state.Filename,\n        Offset: state.Offset,\n        Line: state.Line,\n        Column: state.Column,\n      },\n    },\n    Error: none,\n  }\n  0\nend\n"
  let got = formattedOrFail(t, FormatSource("nested.mygo", src))
  if got != want then
    t.Fatalf("nested over-long literal not wrapped in one pass:\nGOT:\n%s\nWANT:\n%s", got, want)
  end
  let second = formattedOrFail(t, FormatSource("nested.mygo", got))
  if second != got then
    t.Fatalf("nested over-long literal is not idempotent:\nPASS1:\n%s\nPASS2:\n%s", got, second)
  end
end

# Task 9.3b: the deep field `Filename:` must land on its own line two levels
# inside the outer literal (8 spaces), proving the recursion reached the innermost
# over-long span rather than leaving `ps.SourceSpan { ... }` inline.
func TestFormatterWrapsNestedOverLongReachesDeepestField(t: Ref[testing.T]) -> ()
  let src = "package sample\n\nfunc build(state: ScanState, reply: Reply) -> Int\n  Result { Ok: true, Consumed: reply.Consumed, Value: SpannedX { Value: reply.Value, Span: ps.SourceSpan { Filename: state.Filename, Offset: state.Offset, Line: state.Line, Column: state.Column } }, Error: none }\n  0\nend\n"
  let got = formatLayout(src)
  if !strings.Contains(got, "\n        Filename: state.Filename,\n") then
    t.Fatalf("innermost over-long field did not wrap two levels deep: %s", got)
  end
end

# Task 14.1 (GOAL C): a keyword `if` whose `then` value sits on the `then` row
# while the whole construct spans several source rows cannot be expanded by the
# single-line branch pass (it can add rows to one line but cannot consume a
# multi-line span).  The whole-span reflow takes ownership and renders the
# canonical block form (`then`/`else`/`end` on their own rows, branches indented
# one level, the nested `else if` recursed), and the result is idempotent.
func TestFormatterMultiLineStatementIfBecomesBlock(t: Ref[testing.T]) -> ()
  let src = "package sample\nfunc f(a: Int) -> Int\n  if a >= 10 then -1\n  else if a >= 0 then a else f(a - 1) end end\nend\n"
  let want = "package sample\nfunc f(a: Int) -> Int\n  if a >= 10 then\n    -1\n  else\n    if a >= 0 then\n      a\n    else\n      f(a - 1)\n    end\n  end\nend\n"
  let got = formatLayout(src)
  if got != want then
    t.Fatalf("multi-line statement-if did not render canonical block form:\nGOT:\n%s\nWANT:\n%s", got, want)
  end
  if formatLayout(got) != got then
    t.Fatalf("multi-line statement-if block form is not idempotent:\nPASS1:\n%s\nPASS2:\n%s", got, formatLayout(got))
  end
end

# Task 16.4 (golden b / GOAL C): an over-long call whose argument-anchor line also
# holds a double-quoted string containing a backtick (like "`") has that backtick
# mis-paired with a later string-literal backtick by the lossless raw-string line
# protection, which used to verbatim-freeze the wrapped call body and drop its closing
# `)` to column 0. The depth engine now lays out the synthetic wrap rows, so the close
# sits at the argument-anchor base indent (2). Formatting round-trips (a re-format
# re-parses) and is byte-identical (idempotent).
func TestFormatterWrappedDelimitedCloseKeepsAnchorIndent(t: Ref[testing.T]) -> ()
  let src = "package sample\n\nfunc collectProtectedLines(file: LosslessFile) -> Slice[Int]\n  joinProtectedLines(joinProtectedLines(protectedTriviaLines(file.Trivia, 0), tripleQuotedLines(file.Tokens, 0)), pairedQuotedLines(file.Tokens, \"`\", 0))\nend\n\nfunc classify(raw: String) -> Bool\n  raw == \"`\"\nend\n"
  let first = formattedOrFail(t, FormatSource("goldb.mygo", src))
  if !strings.Contains(first, "\n  )\nend\n") then
    t.Fatalf("wrapped delimited close did not keep the anchor indent:\n%s", first)
  end
  if strings.Contains(first, "\n)\nend\n") then
    t.Fatalf("wrapped delimited close fell to column 0:\n%s", first)
  end
  let second = formattedOrFail(t, FormatSource("goldb.mygo", first))
  if second != first then
    t.Fatalf("wrapped delimited close indent is not idempotent:\nPASS1:\n%s\nPASS2:\n%s", first, second)
  end
end

# An over-long single-line arrow `if cond => then else value` in value position
# reflows to the keyword block form.  The arrow form carries no `end` token, so
# the then-branch ExitAnchor names the then VALUE rather than a closing token;
# the else body must therefore be bounded by the else branch's own ExitAnchor,
# otherwise the whole else value is silently dropped during the reflow.
func TestFormatterWideArrowIfKeepsElseBranch(t: Ref[testing.T]) -> ()
  let src = """package sample
func f(noPrelude: Bool, workspaceRoot: String, dir: String) -> String
  let resolved = if noPrelude => Ok(dir) else resolveBootstrapImport(workspaceRoot, dir, "github.com/mygo-lang/mygo/prelude")
  resolved
end
"""
  let first = formattedOrFail(t, FormatSource("arrow-else.mygo", src))
  if !strings.Contains(first, "else\n    resolveBootstrapImport(workspaceRoot, dir, \"github.com/mygo-lang/mygo/prelude\")\n  end") then
    t.Fatalf("wide arrow if lost its else branch:\n%s", first)
  end
  let second = formattedOrFail(t, FormatSource("arrow-else.mygo", first))
  if second != first then
    t.Fatalf("wide arrow if is not idempotent:\nPASS1:\n%s\nPASS2:\n%s", first, second)
  end
end

# An over-long arrow `if` in value position may be followed by a postfix that
# belongs to the ENCLOSING expression: the if itself ends before `.Sources`
# below.  Expanding that shape would paste the dangling suffix right after the
# synthesized `end` (`end.Sources` does not re-parse), so the formatter keeps
# the line inline; the inline arrow form stays valid, stable and lossless.
func TestFormatterArrowIfWithTrailingPostfixStaysInline(t: Ref[testing.T]) -> ()
  let src = """package sample
func f(dir: String, preludeDir: String) -> Int
  let externalSources = if dir == preludeDir => [] as Slice[bootstrapPkgDeclSource] else prelude.Sources
  externalSources.Len()
end
"""
  let first = formattedOrFail(t, FormatSource("arrow-postfix.mygo", src))
  if strings.Contains(first, "end.") then
    t.Fatalf("arrow if postfix was pasted after the synthesized end:\n%s", first)
  end
  let second = formattedOrFail(t, FormatSource("arrow-postfix.mygo", first))
  if second != first then
    t.Fatalf("arrow if with trailing postfix is not idempotent:\nPASS1:\n%s\nPASS2:\n%s", first, second)
  end
end
# Task 16.1a (golden a / GOAL C, D12): a statement-position `if ... elsif ... else`
# chain renders as a FLAT keyword chain at the source base indent: `if COND then`,
# `elsif COND then`, `else` and ONE shared `end` all at the `if`'s indent, every
# branch body one level deeper.  A multi-row branch body keeps its interior
# structure; formatting round-trips and is a fixpoint.
func TestFormatterStatementElsifChainRendersFlatBlockChain(t: Ref[testing.T]) -> ()
  let src = """package sample

func tripleQuotedLines(tokens: Slice[Int], index: Int) -> Slice[Int]
  if index + 2 >= tokens.Len() then []
  elsif quoteTripleAt(tokens, index) then
    let finish = nextQuoteTriple(tokens, index + 3)
    if finish < 0 then []
    else
      let start = tokens.Get(index).UnwrapOr(0)
      let finishToken = tokens.Get(finish + 2).UnwrapOr(start)
      let protected = if start == finishToken then [] else spanLines(start, finishToken) end
      joinProtectedLines(protected, tripleQuotedLines(tokens, finish + 3))
    end
  else tripleQuotedLines(tokens, index + 1) end
end"""
  let want = """package sample

func tripleQuotedLines(tokens: Slice[Int], index: Int) -> Slice[Int]
  if index + 2 >= tokens.Len() then
    []
  elsif quoteTripleAt(tokens, index) then
    let finish = nextQuoteTriple(tokens, index + 3)
    if finish < 0 then
      []
    else
      let start = tokens.Get(index).UnwrapOr(0)
      let finishToken = tokens.Get(finish + 2).UnwrapOr(start)
      let protected = if start == finishToken then
        []
      else
        spanLines(start, finishToken)
      end
      joinProtectedLines(protected, tripleQuotedLines(tokens, finish + 3))
    end
  else
    tripleQuotedLines(tokens, index + 1)
  end
end
"""
  let first = formattedOrFail(t, FormatSource("golda.mygo", src))
  if first != want then
    t.Fatalf("statement elsif chain did not render the flat block chain:\nGOT:\n%s\nWANT:\n%s", first, want)
  end
  let second = formattedOrFail(t, FormatSource("golda.mygo", first))
  if second != first then
    t.Fatalf("statement elsif chain is not idempotent:\nPASS1:\n%s\nPASS2:\n%s", first, second)
  end
end

# Task 16.1a follow-up: a statement `if ... elsif ...` chain written on ONE
# physical line where the `elsif` condition is an inline delimited call
# (`elsif quoteTripleAt(tokens, index) then`).  The whole-span renderer owns it
# and renders the same flat block chain, keeping the inline call as the header
# condition (it never splits a single-row `elsif COND` condition), and the
# result is idempotent.  Regression for the `nextQuoteTriple` mis-format where
# a wrapped elsif condition was empty-sliced into an invalid `elsif  then`.
func TestFormatterSingleLineElsifChainRendersFlatBlockChain(t: Ref[testing.T]) -> ()
  let src = """package sample
func nextQuoteTriple(tokens: Slice[ps.PositionedToken], index: Int) -> Int
  if index + 2 >= tokens.Len() then -1 elsif quoteTripleAt(tokens, index) then index else nextQuoteTriple(tokens, index + 1) end
end
"""
  let want = """package sample
func nextQuoteTriple(tokens: Slice[ps.PositionedToken], index: Int) -> Int
  if index + 2 >= tokens.Len() then
    -1
  elsif quoteTripleAt(tokens, index) then
    index
  else
    nextQuoteTriple(tokens, index + 1)
  end
end
"""
  let first = formattedOrFail(t, FormatSource("nq.mygo", src))
  if first != want then
    t.Fatalf("single-line elsif chain did not render the flat block chain:\nGOT:\n%s\nWANT:\n%s", first, want)
  end
  let second = formattedOrFail(t, FormatSource("nq.mygo", first))
  if second != first then
    t.Fatalf("single-line elsif chain is not idempotent:\nPASS1:\n%s\nPASS2:\n%s", first, second)
  end
end

# A statement `if`/`else` whose `then` and `else` bodies are glued to their
# keyword rows (`if x then aaa` / `else bbb` / `end`) is non-canonical: the
# whole-span pass owns the chain and expands both bodies to block form at the
# branch indent.  The result re-parses and is a fixpoint.  Regression for the
# user-reported glued keyword-header shape.
func TestFormatterGluedBranchBodiesExpandToBlock(t: Ref[testing.T]) -> ()
  let src = """package sample

func f(x: Int) -> Int
  if x == 1 then aaa
  else bbb
  end
end
"""
  let want = """package sample

func f(x: Int) -> Int
  if x == 1 then
    aaa
  else
    bbb
  end
end
"""
  let first = formattedOrFail(t, FormatSource("glued-else.mygo", src))
  if first != want then
    t.Fatalf("glued branch bodies did not expand to a block:\nGOT:\n%s\nWANT:\n%s", first, want)
  end
  let second = formattedOrFail(t, FormatSource("glued-else.mygo", first))
  if second != first then
    t.Fatalf("glued branch expansion is not idempotent:\nPASS1:\n%s\nPASS2:\n%s", first, second)
  end
end

# D11 body recursion: a nested statement `if` whose source block is RAGGED (the
# body sits at or left of the closing `end` column) inside an owned block body.
# Before the body recursion the nested `if finish < 0 then []` was copied
# verbatim (glued `then` value) and its ragged `else` body froze at the source
# indentation, which cascaded once a later pass re-expanded the value-`if` at a
# conflicting depth.  The owned body now renders recursively: every construct is
# block-expanded and re-indented from the layout events, and the ragged closing
# `end` lands back at its construct's depth.  Regression for `pairedQuotedLines`.
func TestFormatterRaggedNestedIfInOwnedBodyRendersCanonical(t: Ref[testing.T]) -> ()
  let src = """package sample
func pairedQuotedLines(tokens: Slice[ps.PositionedToken], quote: String, index: Int) -> Slice[Int]
  let start = nextRawToken(tokens, quote, index)
  if start < 0 then []
  else
    let finish = nextRawToken(tokens, quote, start + 1)
    if finish < 0 then []
    else
    let startToken = tokens.Get(start).UnwrapOr(emptyPositionedToken())
    let finishToken = tokens.Get(finish).UnwrapOr(startToken)
    let protected = if startToken.Span.Start.Line == finishToken.Span.End.Line then [] else spanLines(startToken.Span.Start.Line, finishToken.Span.End.Line) end
    joinProtectedLines(protected, pairedQuotedLines(tokens, quote, finish + 1))
    end
  end
end
"""
  let want = """package sample
func pairedQuotedLines(tokens: Slice[ps.PositionedToken], quote: String, index: Int) -> Slice[Int]
  let start = nextRawToken(tokens, quote, index)
  if start < 0 then
    []
  else
    let finish = nextRawToken(tokens, quote, start + 1)
    if finish < 0 then
      []
    else
      let startToken = tokens.Get(start).UnwrapOr(emptyPositionedToken())
      let finishToken = tokens.Get(finish).UnwrapOr(startToken)
      let protected = if startToken.Span.Start.Line == finishToken.Span.End.Line then
        []
      else
        spanLines(startToken.Span.Start.Line, finishToken.Span.End.Line)
      end
      joinProtectedLines(protected, pairedQuotedLines(tokens, quote, finish + 1))
    end
  end
end
"""
  let first = formattedOrFail(t, FormatSource("pq.mygo", src))
  if first != want then
    t.Fatalf("ragged nested if did not render the canonical block chain:\nGOT:\n%s\nWANT:\n%s", first, want)
  end
  let second = formattedOrFail(t, FormatSource("pq.mygo", first))
  if second != first then
    t.Fatalf("ragged nested if is not idempotent:\nPASS1:\n%s\nPASS2:\n%s", first, second)
  end
end

# Real-corpus regression: `internal/mygo/parser2/lossless.mygo` carries a glued
# (single-line) value `if ... then [] else spanLines(...) end` inside a nested
# owned `if` body, preceded in the file by constructs the earlier passes expand.
# The branch pass reflows that glued line through the recursive engine (baking
# its canonical base and `+1` bodies), but a prior pass line shift used to keep
# the expanded rows OUT of the verbatim-lock set, so the depth engine re-indented
# them a second time: the `then`/`else` bodies landed two levels below the `let`
# continuation instead of one.  The branch pass owned lines now join the lock
# set, so the baked rows are reproduced byte-for-byte.
func TestFormatterGluedValueIfInRealFileExpandsAtCanonicalDepth(t: Ref[testing.T]) -> ()
  let path = "../parser2/lossless.mygo"
  let src = switch os.ReadFile(path)
    case Ok(bytes) => bytes as String
    case Err(err) then
      t.Fatalf("read %s: %v", path, err)
      ""
    end
  end
  let anchor = "let protected = if start.Span.Start.Line == finishToken.Span.End.Line then"
  if !strings.Contains(src, anchor + " [] else") then
    t.Fatalf("%s no longer carries the glued value-if anchor; update this golden", path)
  end
  let first = formattedOrFail(t, FormatSource("lossless.mygo", src))
  let wantBlock = """
      let protected = if start.Span.Start.Line == finishToken.Span.End.Line then
        []
      else
        spanLines(start.Span.Start.Line, finishToken.Span.End.Line)
      end
"""
  if !strings.Contains(first, wantBlock) then
    t.Fatalf("glued value-if did not expand at canonical depth (+2 bodies):\n%s", first)
  end
  let second = formattedOrFail(t, FormatSource("lossless.mygo", first))
  if second != first then
    t.Fatalf("glued value-if expansion is not idempotent:\nPASS1:\n%s\nPASS2:\n%s", first, second)
  end
end

# Real-corpus regression: `internal/mygo/parser2/lossless.mygo` carries a block
# `if ... then / else / end` whose then-body struct stays on one source row but
# whose else-body struct holds a WIDER nested literal that the delimited pass
# expands onto its own rows.  The nested expansion owns the else-body source row,
# so keying a branch event on its body span dropped `enter:if-else` while keeping
# `enter:if-then`; the unpaired `if-then` then held its `+1` until the shared
# `end` and the `else` keyword leaked one level.  Branch events are now measured
# by their keyword anchor, so the pair survives and `else` closes the then-branch
# at its construct depth.  Regression for `spannedPattern`.
func TestFormatterRealFileBlockElseRendersCanonicalDepth(t: Ref[testing.T]) -> ()
  let path = "../parser2/lossless.mygo"
  let src = switch os.ReadFile(path)
    case Ok(bytes) => bytes as String
    case Err(err) then
      t.Fatalf("read %s: %v", path, err)
      ""
    end
  end
  let thenBody = """      ps.Reply[Spanned[ast2.Pattern]] { Ok: true, Consumed: reply.Consumed, Value: Spanned[ast2.Pattern] { Value: reply.Value, Span: stateSpan(state, reply.State) }, State: reply.State, Error: reply.Error }
"""
  if !strings.Contains(src, thenBody) then
    t.Fatalf("%s no longer carries the wide then-body anchor; update this golden", path)
  end
  let first = formattedOrFail(t, FormatSource("lossless.mygo", src))
  let wantBlock = """      }
    else
      ps.Reply[Spanned[ast2.Pattern]] {
        Ok: false,
        Consumed: reply.Consumed,
        Value: Spanned[ast2.Pattern] {
          Value: ast2.Pattern.WildcardPattern,
          Span: stateSpan(state, reply.State),
        },
        State: reply.State,
        Error: reply.Error,
      }
    end
"""
  if !strings.Contains(first, wantBlock) then
    t.Fatalf("block else did not close the then-branch at its own depth:\n%s", first)
  end
end
