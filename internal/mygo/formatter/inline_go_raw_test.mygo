package formatter

import strings "go:strings"
import testing "go:testing"

func TestFormatterPreservesInlineGoRaw(t: Ref[testing.T]) -> ()
  let source = "package sample\n\nfunc f() -> Option[Ref[Int]]\n  go[Option[Ref[Int]]] {\n    raw: Ref[Int]\n    code: \"nil\"\n  }\nend\n"
  let first = formattedOrFail(t, FormatSource("raw.mygo", source))
  let second = formattedOrFail(t, FormatSource("raw.mygo", first))
  if first != second || !strings.Contains(first, "raw: Ref[Int]") then
    t.Fatal("formatter must preserve inline-Go raw declarations")
  end
end
