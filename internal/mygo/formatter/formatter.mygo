package formatter

import strings "go:strings"
import parser2 "github.com/mygo-lang/mygo/internal/mygo/parser2"

# FormatSource is strict: syntax diagnostics return an error, while successful
# rendering uses only the lossless Syntax Tree.
func FormatSource(sourceName: String, source: String) -> Result[String, String]
  let tree = parser2.ParseSyntaxAt(sourceName, source)
  if tree.Diagnostics.Len() != 0 then
    switch tree.Diagnostics.Get(0)
      case Some(diagnostic) => Err(formatSyntaxDiagnosticError(sourceName, diagnostic))
      case None => Err(sourceName + ":1:1: parse error")
    end
  else
    Ok(formatSyntaxFixpoint(sourceName, source, tree, 0))
  end
end

func formatSyntaxDiagnosticError(sourceName: String, diagnostic: parser2.SyntaxDiagnostic) -> String
  let detail = if diagnostic.Expected.Len() == 0 then
    if diagnostic.Message == "" then "parse error" else "parse error: " + diagnostic.Message end
  else
    "parse error: expected " + strings.Join(diagnostic.Expected, " / ")
  end
  sourceName + ":" + diagnostic.Span.Start.Line.ToString() + ":" + diagnostic.Span.Start.Column.ToString() + ": " + detail
end

# Syntax rendering can expose block ownership obscured by ragged source layout.
# Iterate until the text is stable so the public formatter always returns a
# canonical fixed point rather than requiring a second invocation to settle it.
func formatSyntaxFixpoint(sourceName: String, source: String, tree: parser2.SyntaxTree, iteration: Int) -> String
  let rendered = FormatSyntaxBlocks(tree)
  if iteration >= 6 || rendered == source then
    rendered
  else
    let nextTree = parser2.ParseSyntaxAt(sourceName, rendered)
    if nextTree.Diagnostics.Len() != 0 then
      rendered
    else
      formatSyntaxFixpoint(sourceName, rendered, nextTree, iteration + 1)
    end
  end
end
