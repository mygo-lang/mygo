package formatter

import strings "go:strings"
import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import parser2 "github.com/mygo-lang/mygo/internal/mygo/parser2"

struct LayoutState
  Lines: Slice[String]
  SourceLine: Int
  LineMap: Slice[LineMapping]
  Segments: Slice[ExpansionSegment]
  SyntheticEvents: Slice[SyntheticLayoutEvent]
  Indent: Int
  Protected: Bool
  ProtectedLines: Slice[Int]
  VerbatimLines: Slice[Int]
  BlockLines: Slice[Int]
  DedentLines: Slice[Int]
  TargetIndents: Slice[Int]
  EventDriven: Bool
end

struct LineMapping
  SourceLine: Int
  RenderedLine: Int
  Delta: Int
  Synthetic: Bool
  AnchorSourceLine: Int
  Boundary: String
  Depth: Int
end

struct PassEdit
  Anchor: Int
  SourceLine: Int
  Added: Int
  SourceStart: Int
  SourceEnd: Int
  Kind: String
  Depths: Slice[Int]
end

# DelimitedRender carries the rewritten text plus one PassEdit per expanded
# source line.  Each edit owns the exact per-row indentation depths its
# expansion produced, so unrelated source lines keep their identity mapping.
struct DelimitedRender
  Text: String
  Edits: Slice[PassEdit]
end

# DelimitedBlock is one recursive fragment of a wrapped delimited literal:
# its rendered rows plus the indentation depth of every produced line.
struct DelimitedBlock
  Text: String
  Depths: Slice[Int]
end

# ReflowRow is one canonical row produced by the whole-span `if` reflow: its
# relative text (no leading indent), its nesting depth (0 = the `if` itself),
# and the ORIGINAL source line the row came from (used to group the produced
# rows back onto the source lines the per-source-line composition model owns).
struct ReflowRow
  Text: String
  Depth: Int
  Origin: Int
end

# ReflowEdit pairs a per-source-line replacement (built from the grouped rows of
# one whole-span `if`) with the PassEdit that reserves its rows in the
# composition layer.
struct ReflowEdit
  Origin: Int
  Text: String
  Edit: PassEdit
end

# NestedBlock pairs the canonical rows a nested block construct rendered inside
# an owned block body with the ORIGINAL source line of the construct's closing
# `end`, so the body loop can resume directly below the recursive expansion.
struct NestedBlock
  Rows: Slice[ReflowRow]
  ExitLine: Int
end

# ArrowIf records the absolute 1-based column span of one inline keyword
# `if ... then ... else ... end` found inside a delimited item.  The columns
# point at the `then` separator, the `else` separator, and the closing `end` so
# the item text can be rewritten to the compact arrow form
# (`if <cond> => <then> else <else>`).
struct ArrowIf
  ThenStart: Int
  ThenEnd: Int
  ElseStart: Int
  ElseEnd: Int
  EndStart: Int
  EndEnd: Int
end

struct SyntheticLayoutEvent
  Kind: String
  RenderedLine: Int
  SegmentKind: String
  DepthDelta: Int
end

struct ExpansionSegment
  SourceStart: Int
  SourceEnd: Int
  RenderedStart: Int
  RenderedEnd: Int
  Kind: String
end

struct RenderedLayoutEvent
  Kind: String
  Path: Slice[Int]
  SourceLine: Int
  ExitSourceLine: Int
  RenderedLine: Int
  RenderedStart: Int
  RenderedEnd: Int
  BodyLine: Int
  BodyLayout: String
  AffectsIndent: Bool
  ExpandsAfter: Bool
  Depth: Int
  Delta: Int
  Boundary: String
end

struct RenderedLayoutPlan
  Lines: Slice[LineMapping]
  Events: Slice[RenderedLayoutEvent]
  Targets: Slice[Int]
end

struct ExpandedBlocks
  Text: String
  SourceSpan: ast2.SourceSpan
  Segment: ExpansionSegment
  Segments: Slice[ExpansionSegment]
  Lines: Slice[LineMapping]
  Edits: Slice[PassEdit]
end

struct BlockRenderResult
  Text: String
  Segments: Slice[ExpansionSegment]
  Lines: Slice[LineMapping]
  Edits: Slice[PassEdit]
end

func joinSyntheticEvents(left: Slice[SyntheticLayoutEvent], right: Slice[SyntheticLayoutEvent]) -> Slice[SyntheticLayoutEvent]
  right.Fold(left, func(acc: Slice[SyntheticLayoutEvent], e: SyntheticLayoutEvent) -> Slice[SyntheticLayoutEvent] acc.Append(e) end)
end

func expandedLineMap(source: String, rendered: String, line: Int) -> Slice[LineMapping]
  expandedLineMapFrom(source.Split("\n").Len(), rendered.Split("\n").Len(), line, [])
end

# The source/rendered line counts are computed once by the wrapper above; the
# walk only appends each row (amortized O(1)) instead of rebuilding the whole
# downstream mapping list at every line.
func expandedLineMapFrom(sourceLines: Int, renderedLines: Int, line: Int, acc: Slice[LineMapping]) -> Slice[LineMapping]
  if line > renderedLines then acc
  else
    let synthetic = line > sourceLines
    let sourceLine = if synthetic then sourceLines else line end
    let boundary = if synthetic then "after" else "" end
    expandedLineMapFrom(sourceLines, renderedLines, line + 1,
      acc.Append(LineMapping { SourceLine: sourceLine, RenderedLine: line, Delta: line - sourceLine, Synthetic: synthetic, AnchorSourceLine: sourceLine, Boundary: boundary, Depth: 0 }))
  end
end

func joinLineMappings(left: Slice[LineMapping], right: Slice[LineMapping]) -> Slice[LineMapping]
  if right.Len() == 0 then left
  else
    switch right.Get(0)
      case Some(item) => joinLineMappings(left.Append(item), right.Slice(1, right.Len()).UnwrapOr([]))
      case None => left
    end
  end
end
# The formatter's layout pass is authored in MyGO. The generated Go function
# is called by the small Go bridge after parser2 validation.
func FormatSource(sourceName: String, source: String) -> Result[String, String]
  # Function-signature headers are normalized to a single physical line before
  # parsing and re-wrapped after the fixpoint so the layout engine - which has no
  # model for a wrapped parameter list and would mis-indent a multi-line header -
  # only ever sees an inline signature.  Normalizing before parsing keeps every
  # node span consistent with the text it indexes.  The wrap is the inverse of the
  # normalize, so re-parsing the wrapped output rejoins it to the same inline form
  # and the result is an idempotent fixpoint at the `FormatSource` boundary.
  let normalized = normalizeSignatures(source)
  let parsed: Result[parser2.LosslessFile, String] = parser2.ParseFileLossless(sourceName, normalized)
  switch parsed
    case Ok(parsed) => Ok(wrapLongSignatures(formatFixpoint(sourceName, parsed, normalized, 0)))
    case Err(message) => Err(message)
  end
end

# Canonical-form fixpoint. A single `renderASTSpans` pass is not guaranteed to
# be a fixed point: the width model measures a construct differently when it
# sits as an item window inside a parent delimited span than when the same
# construct is hoisted onto its own physical line, so a construct sitting at the
# wrap threshold can flip between "fits" and "must wrap" across runs. Rather
# than let a single pass emit a form a second pass would rewrite, iterate the
# whole render until the text is stable (or the guard bound is hit, or a
# re-parse fails - in which case the last well-formed render is returned). The
# rendered output of `FormatSource` is therefore always an idempotent fixpoint:
# `format(format(x)) == format(x)`.
func formatFixpoint(sourceName: String, parsed: parser2.LosslessFile, source: String, iteration: Int) -> String
  let rendered = formatLossless(parsed, source)
  if iteration >= 6 || rendered == source then rendered
  else
    switch parser2.ParseFileLossless(sourceName, rendered)
      case Ok(next) => formatFixpoint(sourceName, next, rendered, iteration + 1)
      case Err(_) => rendered
    end
  end
end

# The lossless parse result is the single input to rendering. Layout decisions
# can use AST shape and source spans; raw source remains available for opaque
# token emission. Keeping this boundary explicit prevents a future formatter
# pass from falling back to reparsing or function-specific string rules.
func formatLossless(parsed: parser2.LosslessFile, source: String) -> String
  let declarationCount = parsed.AST.Decls.Len()
  let spans = parsed.NodeSpans
  if declarationCount >= 0 && spans.Len() >= 0 then
    renderASTSpans(parsed.AST, spans, parsed.Delimited, parsed.LayoutEvents, parser2.LosslessProtectedLines(parsed), source)
  else
    source
  end
end

# --- Function-signature header wrapping -----------------------------------
#
# A function/method parameter list has no `DelimitedSpan` in parser2 and the
# layout engine has no block-depth model for an unclosed `(` at end of a
# physical line: fed a pre-wrapped header it re-indents the closing `) -> Ret`
# row a level too deep (the `(` opens an implicit block with no matching dedent
# event).  The formatter therefore keeps signature headers inline for the entire
# layout pipeline (`normalizeSignatures`, run before parsing, joins any
# multi-line header back onto one line) and applies the one-parameter-per-line
# split only as a final cosmetic step (`wrapLongSignatures`) on the settled text.
# The split is exactly inverted by the join, so re-parsing the wrapped output
# yields the same inline header and `FormatSource` is idempotent by construction.

# Collapse every multi-line function/method signature header onto a single
# physical line.  A header is recognized by a physical line whose trimmed text
# starts with the `func ` keyword and whose bracket depth (over `()[]{}`) does
# not return to zero on that line; the following lines are appended (whitespace
# collapsed to single spaces) until the depth balances.  A header already on one
# line has balanced depth and is passed through unchanged.
func normalizeSignatures(text: String) -> String
  strings.Join(signatureJoin(text.Split("\n"), 0, 0, "", []), "\n")
end

func signatureJoin(lines: Slice[String], index: Int, depth: Int, pending: String, acc: Slice[String]) -> Slice[String]
  if index >= lines.Len() then
    if depth > 0 && pending.Len() > 0 then acc.Append(pending) else acc end
  else
    let raw = lines.Get(index).UnwrapOr("")
    if depth <= 0 then
      let trimmed = strings.TrimSpace(raw)
      let delta = bracketDelta(raw, 0, 0)
      if strings.HasPrefix(trimmed, "func ") && delta > 0 then
        signatureJoin(lines, index + 1, delta, trimmed, acc)
      else signatureJoin(lines, index + 1, 0, "", acc.Append(raw)) end
    else
      let joined = pending + " " + strings.TrimSpace(raw)
      let next = depth + bracketDelta(raw, 0, 0)
      if next <= 0 then signatureJoin(lines, index + 1, 0, "", acc.Append(joined))
      else signatureJoin(lines, index + 1, next, joined, acc) end
    end
  end
end

# Net bracket balance of a string over `()`, `[]` and `{}`.
func bracketDelta(text: String, index: Int, depth: Int) -> Int
  if index >= text.Len() then depth
  else
    let c = text.Slice(index, index + 1).UnwrapOr("")
    let next = if c == "(" || c == "[" || c == "{" then depth + 1
      elsif c == ")" || c == "]" || c == "}" then depth - 1
      else depth end
    bracketDelta(text, index + 1, next)
  end
end

# Split every single-line function/method signature header wider than the
# 100-column cap into the canonical one-parameter-per-line form:
#   func name(
#     param1,
#     param2
#   ) -> Ret
# Each parameter sits on its own line at the header indent plus one level, every
# item but the last is followed by a comma, and the return-type suffix is kept on
# the closing-paren line.  Function parameter lists forbid a trailing comma
# (the parser rejects a multi-line parameter list that ends in one), so the last
# parameter is comma-free.  Lines that are not a wrappable header - a func
# literal, an empty parameter list, or a header already spanning lines - are
# passed through verbatim.
func wrapLongSignatures(text: String) -> String
  strings.Join(signatureWrap(text.Split("\n"), 0, []), "\n")
end

func signatureWrap(lines: Slice[String], index: Int, acc: Slice[String]) -> Slice[String]
  if index >= lines.Len() then acc
  else
    let raw = lines.Get(index).UnwrapOr("")
    let wrapped = wrapSignatureLine(raw)
    signatureWrap(lines, index + 1, joinStrings(acc, [wrapped]))
  end
end

func wrapSignatureLine(raw: String) -> String
  let body = strings.TrimLeft(raw, " \t")
  let base = indentPrefix(raw)
  if raw.Len() <= 100 || !strings.HasPrefix(body, "func ") then raw
  else
    switch funcHeaderOpen(body, 5)
      case None => raw
      case Some(open) =>
        switch funcHeaderClose(body, open + 1, 0)
          case None => raw
          case Some(close) =>
            let inner = body.Slice(open + 1, close).UnwrapOr("")
            let name = strings.TrimSpace(body.Slice(5, open).UnwrapOr(""))
            if strings.TrimSpace(inner).Len() == 0 || name.Len() == 0 || name.Len() != strings.TrimRight(name, " \t").Len() then raw
            else
              let params = splitTopLevelParams(inner, 0, 0, "", [])
              let suffix = strings.TrimRight(body.Slice(close, body.Len()).UnwrapOr(")"), " \t")
              let head = base + "func " + name + "("
              let rows = signatureParamRows(params, base + "  ", 0, [head])
              strings.Join(joinStrings(rows, [base + suffix]), "\n")
            end
          end
      end
  end
end

# Index of the parameter-list `(` in a `func <name>(...)` header, searched from
# the first byte after the `func ` keyword.  A func literal (`func(`, `func ()`)
# has no name and so yields `None` here, keeping literals out of the wrap.
func funcHeaderOpen(body: String, index: Int) -> Option[Int]
  if index >= body.Len() then None
  elsif body.Slice(index, index + 1).UnwrapOr("") == "(" then Some(index)
  else funcHeaderOpen(body, index + 1) end
end

# Index of the `)` that closes the parameter list opened just before `index`,
# tracking nesting over `()[]{}` so a `(` inside a parameter or return type never
# ends the list early.
func funcHeaderClose(body: String, index: Int, depth: Int) -> Option[Int]
  if index >= body.Len() then None
  else
    let c = body.Slice(index, index + 1).UnwrapOr("")
    if c == "(" || c == "[" || c == "{" then funcHeaderClose(body, index + 1, depth + 1)
    elsif c == ")" && depth == 0 then Some(index)
    elsif c == ")" || c == "]" || c == "}" then funcHeaderClose(body, index + 1, depth - 1)
    else funcHeaderClose(body, index + 1, depth) end
  end
end

# Split a parameter-list body at top-level commas (depth 0 over all bracket
# kinds), trimming each parameter.  A comma nested inside `()[]{}` - a function
# type parameter `(Int, String) -> Bool`, a generic `Map[String, Int]` - does not
# split.
func splitTopLevelParams(inner: String, index: Int, depth: Int, cur: String, acc: Slice[String]) -> Slice[String]
  if index >= inner.Len() then
    let last = strings.TrimSpace(cur)
    if last.Len() > 0 then acc.Append(last) else acc end
  else
    let c = inner.Slice(index, index + 1).UnwrapOr("")
    if c == "(" || c == "[" || c == "{" then splitTopLevelParams(inner, index + 1, depth + 1, cur + c, acc)
    elsif c == ")" || c == "]" || c == "}" then splitTopLevelParams(inner, index + 1, depth - 1, cur + c, acc)
    elsif c == "," && depth == 0 then splitTopLevelParams(inner, index + 1, depth, "", acc.Append(strings.TrimSpace(cur)))
    else splitTopLevelParams(inner, index + 1, depth, cur + c, acc) end
  end
end

# Emit one row per parameter at `indent`, appending a comma to every item but
# the last (function parameter lists reject a trailing comma).
func signatureParamRows(params: Slice[String], indent: String, index: Int, acc: Slice[String]) -> Slice[String]
  if index >= params.Len() then acc
  else
    let param = params.Get(index).UnwrapOr("")
    let row = if index + 1 == params.Len() then indent + param else indent + param + "," end
    signatureParamRows(params, indent, index + 1, acc.Append(row))
  end
end

# AST/span renderer. This layer derives all layout decisions from parser2's
# AST/span renderer. This layer derives all layout decisions from parser2's
# structural model. The text renderer below only applies the resulting layout
# plan to source lines and does not inspect syntax names.
func renderASTSpans(file: ast2.File, spans: Slice[parser2.NodeSpan], delimited: Slice[parser2.DelimitedSpan], events: Slice[parser2.LayoutEvent], protectedLines: Slice[Int], source: String) -> String
  # Each reflow pass grows the text in place, but every span is keyed by its
  # ORIGINAL parser2 line.  A later pass therefore reads its anchor from a
  # row that earlier (upper) expansions have already shifted downward.  We
  # thread the cumulative per-expansion edits of every prior pass into the
  # next pass so it can translate an original line to its current row via
  # `lineShift`, keeping the coordinate-correct mapping that the composition
  # layer relies on.
  let blockResult = renderBlockSpans(source, spans)
  let blockEdits = blockResult.Edits
  # The recursive reflow pass runs before the flat branch/case/delimited passes
  # so it can take whole ownership of the multi-construct source lines.  The
  # lines it replaces become "owned": the later passes are guarded to skip them,
  # and their rendered rows are verbatim-locked at the end so the reflowed block
  # is reproduced byte-for-byte rather than re-indented a second time.
  let reflowRender = reflowPass(blockResult.Text, events, delimited, blockEdits)
  let reflowText = reflowRender.Text
  let reflowEdits = reflowRender.Edits
  let arrowLines = arrowCaseSourceLines(events, 0, [])
  # The whole-span `if` reflow runs after the arrow-case reflow so it inherits
  # its text and prior edits, and takes ownership of multi-line statement `if`s
  # the single-line branch pass cannot consume.  It skips arrow-case lines.
  let spanRender = spanIfPass(reflowText, events, delimited, joinEdits(blockEdits, reflowEdits), arrowLines)
  let spanText = spanRender.Text
  let spanEdits = spanRender.Edits
  let spanLines = ownedSourceLines(spanEdits, 0, [])
  let ownedLines = joinInts(ownedSourceLines(reflowEdits, 0, []), spanLines)
  let preEdits = joinEdits(joinEdits(blockEdits, reflowEdits), spanEdits)
  # `reflowLines` is every source line the recursive reflow pass has authority
  # over (any line hosting an arrow `case`), whether it broke the line into a
  # block or deliberately kept it inline.  The flat branch/delimited passes are
  # guarded against these lines so they can never re-wrap a construct the reflow
  # pass already canonicalized -- the delimited pass measures physical line width
  # (>100) while reflow measures construct width, and letting both act on the same
  # line breaks idempotence (e.g. re-wrapping an intentionally inline nested
  # `case ... => call(...)`).  `ownedLines` (a subset) still drives verbatim-locking
  # and the case pass, which only re-touch lines reflow left as a single row.
  let reflowLines = joinInts(arrowLines, spanLines)
  let thenEvents = events.Filter(func(item: parser2.LayoutEvent) -> Bool item.Kind == "enter:if-then" end)
  let branchRender = renderBranchSpanAt(spanText, thenEvents, events, delimited, preEdits, 0, reflowLines)
  let ifText = branchRender.Text
  let branchEdits = branchRender.Edits
  let caseEvents = events.Filter(func(item: parser2.LayoutEvent) -> Bool item.Kind == "enter:case" && item.SeparatorAnchor.Start.Line > 0 end)
  let caseRender = renderCaseSpanAt(ifText, caseEvents, events, delimited, joinEdits(preEdits, branchEdits), 0, ownedLines)
  let caseText = caseRender.Text
  let caseEdits = caseRender.Edits
  let delimitedRender = renderDelimitedPass(caseText, delimited, events, joinEdits(joinEdits(preEdits, branchEdits), caseEdits), reflowLines)
  let delimitedText = delimitedRender.Text
  let delimEdits = delimitedRender.Edits
  let reflowCount = sumPassAdded(reflowEdits, 0)
  let spanCount = sumPassAdded(spanEdits, 0)
  let ifCount = sumPassAdded(branchEdits, 0)
  let caseCount = sumPassAdded(caseEdits, 0)
  let delimCount = sumPassAdded(delimEdits, 0)
  let goal = blockResult.Lines.Len() + reflowCount + spanCount + ifCount + caseCount + delimCount
  let composedLines = composePassLines(blockResult.Lines, joinEdits(joinEdits(joinEdits(reflowEdits, spanEdits), joinEdits(branchEdits, caseEdits)), delimEdits), goal, 0)
  # The recursive (nested) delimited renderer bakes each wrapped row's FINAL
  # indentation into the text it emits (base = the anchor line's own leading
  # whitespace, +1 level per nesting depth).  Those source lines must therefore
  # join the verbatim-lock set so the render step reproduces them byte-for-byte
  # and never re-indents them through the target-depth engine (which applies a
  # single uniform level and cannot express nested literal depth).
  let nestedDelimLines = nestedDelimitedSourceLines(delimEdits, 0, [])
  # The flat branch pass reflows a glued single-line value `if` through the
  # SAME recursive engine (`branchReflowText` -> `reflowRegion`), which bakes
  # the anchor line's own leading whitespace as the block's base indent and
  # emits canonical +1-relative body rows.  Those lines must join the
  # verbatim-lock set (like the nested-delimited rows above): otherwise the
  # depth engine re-indents the already-canonical rows through the value-if's
  # own layout events and over-indents the bodies by one extra level.
  let branchOwnedLines = ownedSourceLines(branchEdits, 0, [])
  let verbatimOwned = joinInts(joinInts(ownedLines, branchOwnedLines), nestedDelimLines)
  let verbatimLines = projectOwnedRows(verbatimOwned, composedLines, 0)
  # Specific AST expansion segments must win over the generic pass-through
  # segments.  Otherwise segmentForRenderedLine observes the source-wide
  # segment first and loses the synthetic function-body boundary.
  let sourceFallback = ExpansionSegment { SourceStart: 1, SourceEnd: goal, RenderedStart: 1, RenderedEnd: goal, Kind: "source" }
  let composedSegments = joinSegments(joinSegments(joinSegments(joinSegments(joinSegments(joinSegments(blockResult.Segments, editSegments(reflowEdits)), editSegments(spanEdits)), editSegments(branchEdits)), editSegments(caseEdits)), editSegments(delimEdits)), [sourceFallback])
  # The delimited pass already re-rendered every value-position `if` that lived
  # on a single source line inside a wrapped literal into the inline `=>` form,
  # so it no longer introduces an expansion row.  Its layout events still carry
  # `AffectsIndent`/`ExpandsAfter`, which would add a phantom indent level to the
  # block, so drop exactly those events from the indent projection while keeping
  # them in the full `events` list that the arrowize pass reads.
  # A single-line value-position `if/elsif/else/end` chain is deliberately kept
  # inline (the flat branch pass cannot slice an elsif chain), yet its branch
  # events still claim an expansion the pass never performed.  Collect the host
  # lines of those kept-inline chains so `renderLayoutEvents` drops them too.
  let valueIfLines = valueIfChainLines(events, source.Split("\n"), 0, [])
  let layoutEvents = renderLayoutEvents(events, delimited, verbatimOwned, valueIfLines, 0, [])
  let renderedEvents = remapLayoutEvents(layoutEvents, composedLines, composedSegments, 0, [])
  # Block and dedent targets are projected from semantic event boundaries.
  # A source line may expand to several rendered lines, so remapping the old
  # line-only collections would incorrectly apply both operations to every
  # expansion fragment.
  let renderedPlan = makeRenderedLayoutPlan(composedLines, renderedEvents)
  let delimiterTargets = projectDelimitedTargets(renderedPlan.Targets, composedLines, delimited, 0)
  let delimiterPlan = RenderedLayoutPlan { Lines: renderedPlan.Lines, Events: renderedPlan.Events, Targets: delimiterTargets }
  # Protected rows are keyed by rendered line: the projection above already
  # maps every protected source line onto its expansion rows.  Joining the
  # raw source-line keys back in would protect unrelated rendered rows once
  # an earlier pass (for example a wrapped list) shifts line numbers.
  renderRenderedLayoutPlan(delimitedText, projectProtectedLines(protectedLines, composedLines, 0), verbatimLines, composedSegments, layoutEvents, [], delimiterPlan)
end

# Project the event stream that drives the indent engine by removing the
# `if-then`/`if-else` branch events the delimited pass already flattened to the
# inline `=>` form: a keyword/`if-else` branch that is marked `AffectsIndent` +
# `ExpandsAfter` yet sits entirely on one source line inside a same-line
# delimited literal.  Those events must not add an expansion-driven indent
# level because the corresponding text no longer expands into its own rows.
#
# Additionally, every construct that lives on an owned (reflowed) source line is
# dropped: the reflow pass bakes that construct's internal indentation into its
# verbatim output, so its enter/exit events must contribute no indent to the
# surrounding rows.  Dropping them keeps a reflowed `case ... end` block
# depth-transparent, so its following sibling cases keep the enclosing switch's
# indent instead of inheriting a phantom branch depth.
#
# `inlineChainLines` (see `valueIfChainLines`) names the source lines that host
# a single-line value-position `if/elsif` chain kept inline: the flat branch pass
# never expanded them, so their `if-then`/`if-else` events are phantom too and
# must be dropped from the projection or they sink the host line's indent.
#
# A branch event is measured by its keyword anchor line, never by its body span:
# `if-then` spans the then-body and `if-else` spans the else-body, and a nested
# pass may own one body's row while leaving the other untouched.  Testing the
# span would then drop only one half of the branch pair, and since the survivor's
# matching row is resolved through its sibling, the depth would leak until the
# shared `end`.  An `if` whose header line is owned is still dropped whole.
func renderLayoutEvents(events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], ownedLines: Slice[Int], inlineChainLines: Slice[Int], index: Int, acc: Slice[parser2.LayoutEvent]) -> Slice[parser2.LayoutEvent]
  if index >= events.Len() then acc
  else
    switch events.Get(index)
      case None => renderLayoutEvents(events, delimited, ownedLines, inlineChainLines, index + 1, acc)
      case Some(ev) then
        let isIfBranch = ev.Kind == "enter:if-then" || ev.Kind == "exit:if-then" || ev.Kind == "enter:if-else" || ev.Kind == "exit:if-else"
        let isElsifTransition = ev.Kind == "transition:if-elsif"
        let onOneLine = ev.Anchor.Start.Line > 0 && ev.Anchor.Start.Line == ev.Anchor.End.Line
        let onOwned = if isIfBranch then ev.Anchor.Start.Line > 0 && containsInt(ownedLines, ev.Anchor.Start.Line)
          else (ev.Anchor.Start.Line > 0 && containsInt(ownedLines, ev.Anchor.Start.Line)) || (ev.Span.Start.Line > 0 && containsInt(ownedLines, ev.Span.Start.Line)) end
        let branchPhantom = isIfBranch && ev.AffectsIndent && ev.ExpandsAfter && onOneLine
        let onInlineChainLine = ev.Span.Start.Line > 0 && containsInt(inlineChainLines, ev.Span.Start.Line)
        let onInlineChain = onInlineChainLine && (branchPhantom || isElsifTransition)
        let flatten = onOwned || onInlineChain || (branchPhantom && insideSameLineDelimited(delimited, ev.Anchor.Start.Line, ev.Anchor.Start.Column))
        renderLayoutEvents(events, delimited, ownedLines, inlineChainLines, index + 1, if flatten then acc else acc.Append(ev) end)
      end
    end
  end
end

# A single-line `if … elsif … else … end` chain in VALUE position (its `if`
# keyword is not the first token on the source line) is kept inline by the flat
# branch pass, which refuses to slice an elsif chain.  The parser still marks its
# `if-then`/`if-else` events `AffectsIndent` + `ExpandsAfter`, so without this
# set the depth projection counts a phantom branch level and sinks the host line
# while lifting its following siblings.  Collect one entry (the source line) per
# such chain so `renderLayoutEvents` can drop the phantom events.
func valueIfChainLines(events: Slice[parser2.LayoutEvent], lines: Slice[String], index: Int, acc: Slice[Int]) -> Slice[Int]
  if index >= events.Len() then acc
  else
    switch events.Get(index)
      case None => valueIfChainLines(events, lines, index + 1, acc)
      case Some(ev) then
        let line = ev.Span.Start.Line
        let singleLineChain = ev.Kind == "enter:if" && line > 0 && line == ev.Span.End.Line
        if singleLineChain && !containsInt(acc, line) && isValueIfLine(ev, lines) then
          valueIfChainLines(events, lines, index + 1, acc.Append(line))
        else
          valueIfChainLines(events, lines, index + 1, acc)
        end
      end
    end
  end
end

# True when the whole-span `if` event's keyword sits after the first token of
# its source line, i.e. the construct is in value position (`let x = if …`)
# rather than opening the line as a statement.
func isValueIfLine(ev: parser2.LayoutEvent, lines: Slice[String]) -> Bool
  switch lines.Get(ev.Span.Start.Line - 1)
    case None => false
    case Some(raw) => ev.Anchor.Start.Column > trimStartCol(raw, 1)
  end
end

func projectDelimitedTargets(targets: Slice[Int], mappings: Slice[LineMapping], spans: Slice[parser2.DelimitedSpan], index: Int) -> Slice[Int]
  if index >= spans.Len() then targets
  else
    switch spans.Get(index)
      case None => projectDelimitedTargets(targets, mappings, spans, index + 1)
      case Some(span) then
        # Only the wrapped (outermost) spans produce expansion rows to indent; a
        # nested span stays verbatim inside its enclosing item and must not add an
        # extra indent level to those rows (which would break idempotence).
        let next = if containedInSameLineSpan(spans, span.Span, 0) then
          targets
        else
          addDelimitedIndent(targets, mappings, span.Span, 0, [])
        end
        projectDelimitedTargets(next, mappings, spans, index + 1)
      end
    end
  end
end

func addDelimitedIndent(targets: Slice[Int], mappings: Slice[LineMapping], span: ast2.SourceSpan, index: Int, acc: Slice[Int]) -> Slice[Int]
  if index >= targets.Len() then
    acc
  else
    switch targets.Get(index)
      case None => acc
      case Some(target) then
        # Two shapes receive the item-level indent bump: rows strictly between
        # the delimiters of a hand-written multiline literal, and the body rows a
        # single-line literal expansion produced.  The expansion's closing row
        # (boundary after) stays at the anchor indent, matching the canonical
        # block form where the delimiter aligns with the declaration.  A row with
        # no mapping is neither shape, so it stays unbumped.
        let bump = switch mappings.Get(index)
          case None => false
          case Some(mapping) then
            let handWritten = !mapping.Synthetic && mapping.SourceLine > span.Start.Line && mapping.SourceLine < span.End.Line
            let expandedBody = mapping.Synthetic && mapping.AnchorSourceLine == span.Start.Line && mapping.Boundary == "body"
            handWritten || expandedBody
          end
        end
        let current = if bump => target + 1 else target
        addDelimitedIndent(targets, mappings, span, index + 1, acc.Append(current))
      end
    end
  end
end

# Prior-pass insertions shift every later original source line downward by the
# number of rows each upper expansion added to the growing text.  Summing
# `Added` over edits whose SourceLine precedes the queried line recovers that
# line's current row so a pass reads/writes the physical line it targets.
func lineShift(edits: Slice[PassEdit], sourceLine: Int) -> Int
  edits.Fold(0, func(total: Int, edit: PassEdit) -> Int
    if edit.SourceLine < sourceLine => total + edit.Added else total
  end)
end

func composePassLines(base: Slice[LineMapping], edits: Slice[PassEdit], goal: Int, index: Int) -> Slice[LineMapping]
  composePassRows(base, edits, 1, 0)
end

# A single merge walk places every pass edit at its own source line.  Each
# edit owns the exact rows its expansion produced, so later source lines
# keep their identity mapping and are renumbered instead of drifting.
func composePassRows(base: Slice[LineMapping], edits: Slice[PassEdit], row: Int, index: Int) -> Slice[LineMapping]
  if index >= base.Len() then
    []
  else
    switch base.Get(index)
      case None => []
      case Some(src) then
        let head = LineMapping { SourceLine: src.SourceLine, RenderedLine: row, Delta: row - src.SourceLine, Synthetic: src.Synthetic, AnchorSourceLine: src.AnchorSourceLine, Boundary: src.Boundary, Depth: src.Depth }
        switch editForSourceLine(edits, src, 0)
          case Some(edit) => joinLineMappings([head], joinLineMappings(expandedPassRows(edit, row + 1, edit.Added), composePassRows(base, edits, row + 1 + edit.Added, index + 1)))
          case None => joinLineMappings([head], composePassRows(base, edits, row + 1, index + 1))
        end
      end
    end
  end
end

func editForSourceLine(edits: Slice[PassEdit], mapping: LineMapping, index: Int) -> Option[PassEdit]
  if mapping.Synthetic then None
  elsif index >= edits.Len() then None
  else
    switch edits.Get(index)
      case None => editForSourceLine(edits, mapping, index + 1)
      case Some(edit) => if edit.SourceLine == mapping.SourceLine then Some(edit) else editForSourceLine(edits, mapping, index + 1) end
    end
  end
end

func expandedPassRows(edit: PassEdit, row: Int, remaining: Int) -> Slice[LineMapping]
  if remaining <= 0 then
    []
  else
    let boundary = if remaining == 1 then "after" elsif edit.Kind == "if-branch" && remaining == 3 then "else" else "body" end
    let depth = editDepthsAt(edit.Depths, edit.Added - remaining, 0)
    joinLineMappings([LineMapping { SourceLine: edit.SourceLine, RenderedLine: row, Delta: row - edit.SourceLine, Synthetic: true, AnchorSourceLine: edit.SourceLine, Boundary: boundary, Depth: depth }], expandedPassRows(edit, row + 1, remaining - 1))
  end
end

func editDepthsAt(depths: Slice[Int], index: Int, fallback: Int) -> Int
  if index < 0 || index >= depths.Len() then fallback
  else
    switch depths.Get(index)
      case None => fallback
      case Some(d) => d
    end
  end
end

func sumPassAdded(edits: Slice[PassEdit], index: Int) -> Int
  if index >= edits.Len() then 0
  else
    switch edits.Get(index)
      case None => sumPassAdded(edits, index + 1)
      case Some(edit) => edit.Added + sumPassAdded(edits, index + 1)
    end
  end
end

func truncateMappings(mappings: Slice[LineMapping], goal: Int, index: Int) -> Slice[LineMapping]
  if index >= mappings.Len() || index >= goal then
    []
  else
    switch mappings.Get(index)
      case None => []
      case Some(src) then
        let item = LineMapping { SourceLine: src.SourceLine, RenderedLine: index + 1, Delta: index + 1 - src.SourceLine, Synthetic: src.Synthetic, AnchorSourceLine: src.AnchorSourceLine, Boundary: src.Boundary }
        joinLineMappings([item], truncateMappings(mappings, goal, index + 1))
      end
    end
  end
end

func editSegments(edits: Slice[PassEdit]) -> Slice[ExpansionSegment]
  switch edits.Get(0)
    case None => []
    case Some(edit) then
      let main = ExpansionSegment { SourceStart: edit.SourceStart, SourceEnd: edit.SourceEnd, RenderedStart: edit.SourceStart, RenderedEnd: edit.SourceStart + edit.Added, Kind: edit.Kind }
      let endSegment = ExpansionSegment { SourceStart: edit.SourceStart, SourceEnd: edit.SourceStart, RenderedStart: edit.SourceStart + edit.Added, RenderedEnd: edit.SourceStart + edit.Added, Kind: edit.Kind + "-end" }
      joinSegments([main], [endSegment])
    end
  end
end

func joinEdits(left: Slice[PassEdit], right: Slice[PassEdit]) -> Slice[PassEdit]
  right.Fold(left, func(acc: Slice[PassEdit], e: PassEdit) -> Slice[PassEdit] acc.Append(e) end)
end

func projectProtectedLines(sourceLines: Slice[Int], mappings: Slice[LineMapping], index: Int) -> Slice[Int]
  if index >= mappings.Len() then []
  else
    switch mappings.Get(index)
      case None => projectProtectedLines(sourceLines, mappings, index + 1)
      case Some(mapping) then
        let sourceLine = if mapping.SourceLine > 0 then mapping.SourceLine else mapping.AnchorSourceLine end
        # Only an ORIGINAL (non-synthetic) source row can carry line protection.
        # A synthetic row is the formatter's own reflow output (a wrapped-delimited
        # body/close row, an expanded branch row, ...): it must be laid out by the
        # depth engine, never verbatim-locked from an unrelated protected source
        # range.  A genuine multi-line literal or comment interior is always an
        # identity (non-synthetic) row, so it stays byte-verbatim regardless.
        let current = if !mapping.Synthetic && containsInt(sourceLines, sourceLine) then [mapping.RenderedLine] else [] end
        joinInts(current, projectProtectedLines(sourceLines, mappings, index + 1))
      end
    end
  end
end

func makeRenderedLayoutPlan(lines: Slice[LineMapping], events: Slice[RenderedLayoutEvent]) -> RenderedLayoutPlan
  RenderedLayoutPlan { Lines: lines, Events: events, Targets: projectRenderedEventTargets(events, lines, 0, 0) }
end

func renderRenderedLayoutPlan(source: String, protectedLines: Slice[Int], verbatimLines: Slice[Int], segments: Slice[ExpansionSegment], layoutEvents: Slice[parser2.LayoutEvent], syntheticEvents: Slice[SyntheticLayoutEvent], plan: RenderedLayoutPlan) -> String
  renderSourceLinesWithTargets(source, protectedLines, verbatimLines, [], [], plan.Targets, plan.Lines, segments, layoutEvents, syntheticEvents, plan.Events)
end

func firstSpanOfKind(spans: Slice[parser2.NodeSpan], kind: String, index: Int) -> ast2.SourceSpan
  if index >= spans.Len() then ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: 1, Column: 0 }, End: ast2.SourcePos { SourceName: "", Line: 1, Column: 0 } }
  else
    switch spans.Get(index)
      case None => firstSpanOfKind(spans, kind, index + 1)
      case Some(item) => if item.Kind == kind then item.Span else firstSpanOfKind(spans, kind, index + 1) end
    end
  end
end

func remapLayoutEvents(events: Slice[parser2.LayoutEvent], mappings: Slice[LineMapping], segments: Slice[ExpansionSegment], index: Int, acc: Slice[RenderedLayoutEvent]) -> Slice[RenderedLayoutEvent]
  if index >= events.Len() then acc
  else
    switch events.Get(index)
      case None => remapLayoutEvents(events, mappings, segments, index + 1, acc)
      case Some(item) => remapLayoutEvents(events, mappings, segments, index + 1,
        remapLayoutEvent(item, events, mappings, segments).Fold(acc, func(a: Slice[RenderedLayoutEvent], e: RenderedLayoutEvent) -> Slice[RenderedLayoutEvent] a.Append(e) end))
    end
  end
end

func renderBlockSpans(source: String, spans: Slice[parser2.NodeSpan]) -> ExpandedBlocks
  let blocks = spans.Filter(func(item: parser2.NodeSpan) -> Bool item.Kind == "block-body" && item.Span.Start.Line == item.Span.End.Line && item.Span.Start.Line > 0 && hasSameLineParent(spans, item, 0) end)
  let renderedResult = renderBlockResult(source, blocks, 0)
  let rendered = renderedResult.Text
  let sourceSpan = firstSpanOfKind(spans, "block-body", 0)
  let renderedStart = sourceSpan.Start.Line
  let renderedEnd = if sourceSpan.Start.Line == sourceSpan.End.Line then renderedStart + 2 else sourceSpan.End.Line end
  let fallbackSegment = ExpansionSegment { SourceStart: sourceSpan.Start.Line, SourceEnd: sourceSpan.End.Line, RenderedStart: renderedStart, RenderedEnd: renderedEnd, Kind: "block-body" }
  ExpandedBlocks { Text: rendered, SourceSpan: sourceSpan, Segment: fallbackSegment, Segments: renderedResult.Segments, Lines: renderedResult.Lines, Edits: renderedResult.Edits }
end

func renderBlockResult(source: String, blocks: Slice[parser2.NodeSpan], index: Int) -> BlockRenderResult
  renderBlockResultAt(source, blocks, index, 0, expandedLineMap(source, source, 1))
end

func renderBlockResultAt(source: String, blocks: Slice[parser2.NodeSpan], index: Int, lineDelta: Int, mappings: Slice[LineMapping]) -> BlockRenderResult
  if index >= blocks.Len() then BlockRenderResult { Text: source, Segments: [], Lines: mappings, Edits: [] }
  else
    switch blocks.Get(index)
      case None => BlockRenderResult { Text: source, Segments: [], Lines: mappings, Edits: [] }
      case Some(bodySpan) then
        let sourceLine = bodySpan.Span.Start.Line
        let lineIndex = sourceLine + lineDelta - 1
        let lines = source.Split("\n")
        let raw = lines.Get(lineIndex).UnwrapOr("")
        let expands = bodySpan.Span.Start.Column > 0 && bodySpan.Span.End.Column > bodySpan.Span.Start.Column
        let expanded = if expands then replaceSourceLine(lines, lineIndex, expandBlockSourceLine(raw, bodySpan.Span.Start.Column, bodySpan.Span.End.Column)) else source end
        let lineChange = if expands then 2 else 0 end
        let current = ExpansionSegment { SourceStart: sourceLine, SourceEnd: bodySpan.Span.End.Line, RenderedStart: sourceLine + lineDelta, RenderedEnd: sourceLine + lineDelta + lineChange, Kind: "block-body" }
        let nextMappings = if expands then expandBlockMappings(mappings, lineIndex, sourceLine, 0) else mappings end
        let rest = renderBlockResultAt(expanded, blocks, index + 1, lineDelta + lineChange, nextMappings)
        let blockEdit = PassEdit { Anchor: sourceLine - 1, SourceLine: sourceLine, Added: lineChange, SourceStart: sourceLine, SourceEnd: bodySpan.Span.End.Line, Kind: "block-body", Depths: [] }
        let nextEdits = if expands then joinEdits([blockEdit], rest.Edits) else rest.Edits end
        BlockRenderResult { Text: rest.Text, Segments: joinSegments([current], rest.Segments), Lines: rest.Lines, Edits: nextEdits }
      end
    end
  end
end

func expandBlockMappings(mappings: Slice[LineMapping], lineIndex: Int, sourceLine: Int, index: Int) -> Slice[LineMapping]
  if index >= mappings.Len() then
    []
  else
    switch mappings.Get(index)
      case None => []
      case Some(item) then
        if index == lineIndex then
          let header = LineMapping { SourceLine: item.SourceLine, RenderedLine: index + 1, Delta: index + 1 - item.SourceLine, Synthetic: false, AnchorSourceLine: item.AnchorSourceLine, Boundary: item.Boundary }
          let body = LineMapping { SourceLine: sourceLine, RenderedLine: index + 2, Delta: index + 2 - sourceLine, Synthetic: true, AnchorSourceLine: sourceLine, Boundary: "body" }
          let endMapping = LineMapping { SourceLine: sourceLine, RenderedLine: index + 3, Delta: index + 3 - sourceLine, Synthetic: true, AnchorSourceLine: sourceLine, Boundary: "after" }
          joinLineMappings([header, body, endMapping], expandBlockMappings(mappings, lineIndex, sourceLine, index + 1))
        else
          let shift = if index > lineIndex then 2 else 0 end
          let renderedLine = index + 1 + shift
          let mapped = LineMapping { SourceLine: item.SourceLine, RenderedLine: renderedLine, Delta: renderedLine - item.SourceLine, Synthetic: item.Synthetic, AnchorSourceLine: item.AnchorSourceLine, Boundary: item.Boundary }
          joinLineMappings([mapped], expandBlockMappings(mappings, lineIndex, sourceLine, index + 1))
        end
      end
    end
  end
end

func joinSegments(left: Slice[ExpansionSegment], right: Slice[ExpansionSegment]) -> Slice[ExpansionSegment]
  right.Fold(left, func(acc: Slice[ExpansionSegment], s: ExpansionSegment) -> Slice[ExpansionSegment] acc.Append(s) end)
end

func hasSameLineParent(spans: Slice[parser2.NodeSpan], child: parser2.NodeSpan, index: Int) -> Bool
  if index >= spans.Len() then false
  else
    switch spans.Get(index)
      case None => hasSameLineParent(spans, child, index + 1)
      case Some(item) => if isDirectNodeChild(child.Path, item.Path, 0) && item.Kind.Slice(0, 5).UnwrapOr("") == "decl:" && item.Span.Start.Line == child.Span.Start.Line then true else hasSameLineParent(spans, child, index + 1) end
    end
  end
end

func isDirectNodeChild(child: Slice[Int], parent: Slice[Int], index: Int) -> Bool
  if child.Len() != parent.Len() + 1 then false
  elsif index >= parent.Len() then true
  elsif child.Get(index).UnwrapOr(-1) != parent.Get(index).UnwrapOr(-2) then false
  else isDirectNodeChild(child, parent, index + 1) end
end

func expandBlockSourceLine(raw: String, bodyStartColumn: Int, bodyEndColumn: Int) -> String
  let bodyStart = bodyStartColumn - 1
  let bodyEnd = bodyEndColumn - 1
  let body = strings.TrimSpace(raw.Slice(bodyStart, bodyEnd).UnwrapOr(""))
  let header = strings.TrimRight(raw.Slice(0, bodyStart).UnwrapOr(raw), " \t")
  header + "\n  " + body + "\nend"
end


# Entry point for the delimited-expansion pass (design D10, task 9.2).  It is
# SINGLE-OWNER-PER-SOURCE-LINE: each over-long physical line is wrapped by one
# replacement that lays out every eligible same-line span on it, and one
# `PassEdit` records exactly the rows that line produces.  The previous per-span
# walk emitted one edit per span, so a line hosting two sibling spans both
# contributed an `Added`, the text pass clobbered the first, and the composed
# line count fell out of step with the real text - a global one-row shift that
# made every later wrapped literal's `TargetIndents` depth drift on the second
# pass.  Single-owner keeps `composedLines`, `goal` and the physical text at the
# same line count, so the composition layer and the depth engine stay aligned.
# `priorEdits` are the cumulative expansions of every earlier pass; a line's
# original number is shifted by `lineShift` before it reads its anchor row.
func renderDelimitedPass(source: String, spans: Slice[parser2.DelimitedSpan], events: Slice[parser2.LayoutEvent], priorEdits: Slice[PassEdit], ownedLines: Slice[Int]) -> DelimitedRender
  let sourceLines = source.Split("\n")
  let selected = selectedWrapSpans(sourceLines, spans, spans, events, priorEdits, 0, [], ownedLines)
  if selected.Len() == 0 then DelimitedRender { Text: source, Edits: [] }
  else
    let lines = candidateLinesFrom(selected, 0, [])
    DelimitedRender { Text: renderDelimitedLinesText(source, spans, selected, events, priorEdits, lines, 0), Edits: renderDelimitedLinesEdits(sourceLines, spans, selected, events, priorEdits, lines, 0, []) }
  end
end

# A same-line delimited span the pass may expand: it has separators, is not
# nested inside another same-line span (only the outermost is expanded; inner
# constructs reflow inside it), is not an inline keyword `if`'s interior (those
# keep the arrowize/branch handling), and sits on a line wider than the 100
# column cap that the recursive-reflow pass does not already own.
func spanWrapEligible(sourceLines: Slice[String], allSpans: Slice[parser2.DelimitedSpan], events: Slice[parser2.LayoutEvent], priorEdits: Slice[PassEdit], ownedLines: Slice[Int], item: parser2.DelimitedSpan) -> Bool
  let line = item.Span.Start.Line
  let raw = sourceLines.Get(line + lineShift(priorEdits, line) - 1).UnwrapOr("")
  strings.TrimSpace(raw).Len() > 100 && item.Separators.Len() > 0 && item.Span.Start.Line == item.Span.End.Line && !containedInSameLineSpan(allSpans, item.Span, 0) && !containsInt(ownedLines, line) && !spanInArrowRegion(events, item)
end

# Every wrap-eligible span, scanned once (the containment test is O(spans) each,
# so this replaces the per-line re-scans the old walk performed).
func selectedWrapSpans(sourceLines: Slice[String], allSpans: Slice[parser2.DelimitedSpan], spans: Slice[parser2.DelimitedSpan], events: Slice[parser2.LayoutEvent], priorEdits: Slice[PassEdit], index: Int, acc: Slice[parser2.DelimitedSpan], ownedLines: Slice[Int]) -> Slice[parser2.DelimitedSpan]
  if index >= spans.Len() then acc
  else
    switch spans.Get(index)
      case None => selectedWrapSpans(sourceLines, allSpans, spans, events, priorEdits, index + 1, acc, ownedLines)
      case Some(item) then
        let next = if spanWrapEligible(sourceLines, allSpans, events, priorEdits, ownedLines, item) then acc.Append(item) else acc end
        selectedWrapSpans(sourceLines, allSpans, spans, events, priorEdits, index + 1, next, ownedLines)
      end
    end
  end
end

# Distinct source lines (ascending by first appearance) that own >=1 eligible
# span.  The text pass walks this list from the end first, i.e. highest line
# first, so a lower line's expansion never shifts a higher line's anchor row.
func candidateLinesFrom(selected: Slice[parser2.DelimitedSpan], index: Int, acc: Slice[Int]) -> Slice[Int]
  if index >= selected.Len() then acc
  else
    switch selected.Get(index)
      case None => candidateLinesFrom(selected, index + 1, acc)
      case Some(item) then
        let next = if containsInt(acc, item.Span.Start.Line) then acc else acc.Append(item.Span.Start.Line) end
        candidateLinesFrom(selected, index + 1, next)
      end
    end
  end
end

# Descending walk: replace each candidate line's raw text with its single-owner
# wrapped form.  Replacements grow rows below the anchor, so processing highest
# line first keeps every not-yet-written anchor at `line + lineShift(priorEdits)`.
func renderDelimitedLinesText(source: String, allSpans: Slice[parser2.DelimitedSpan], selected: Slice[parser2.DelimitedSpan], events: Slice[parser2.LayoutEvent], priorEdits: Slice[PassEdit], lines: Slice[Int], index: Int) -> String
  if index >= lines.Len() then source
  else
    let rendered = renderDelimitedLinesText(source, allSpans, selected, events, priorEdits, lines, index + 1)
    switch lines.Get(index)
      case None => rendered
      case Some(line) then
        let target = line + lineShift(priorEdits, line)
        let src = rendered.Split("\n")
        let raw = src.Get(target - 1).UnwrapOr("")
        let replacement = delimitedLineReplacement(raw, allSpans, selected, events, line)
        if replacement == raw then rendered else replaceSourceLine(src, target - 1, replacement) end
      end
    end
  end
end

# One `PassEdit` per candidate line whose `Added` equals exactly the row growth
# the text pass produced (both call `delimitedLineReplacement`), so
# `composedLines` cannot drift from the physical text.
func renderDelimitedLinesEdits(sourceLines: Slice[String], allSpans: Slice[parser2.DelimitedSpan], selected: Slice[parser2.DelimitedSpan], events: Slice[parser2.LayoutEvent], priorEdits: Slice[PassEdit], lines: Slice[Int], index: Int, acc: Slice[PassEdit]) -> Slice[PassEdit]
  if index >= lines.Len() then acc
  else
    switch lines.Get(index)
      case None => renderDelimitedLinesEdits(sourceLines, allSpans, selected, events, priorEdits, lines, index + 1, acc)
      case Some(line) then
        let raw = sourceLines.Get(line + lineShift(priorEdits, line) - 1).UnwrapOr("")
        let added = delimitedLineReplacement(raw, allSpans, selected, events, line).Split("\n").Len() - 1
        let next = if added > 0 then acc.Append(PassEdit { Anchor: line - 1, SourceLine: line, Added: added, SourceStart: line, SourceEnd: line, Kind: if lineUsesBaked(raw, allSpans, selected, events, line) then "delimited-nested" else "delimited" end, Depths: [] }) else acc end
        renderDelimitedLinesEdits(sourceLines, allSpans, selected, events, priorEdits, lines, index + 1, next)
      end
    end
  end
end

func spanInArrowRegion(events: Slice[parser2.LayoutEvent], item: parser2.DelimitedSpan) -> Bool
  insideArrowRegion(collectArrowIfs(events, item.Span.Start.Line, 0, []), item.Span.Start.Column, item.Span.End.Column)
end

# A nested delimited construct must never be wrapped on its own: rewriting an
# inner span re-slices its anchor line and drops the field label / callee name
# that sit between the enclosing item's start and the inner opening delimiter
# (`Span:`, `stateSpan(`). Only outermost same-line spans are expanded; nested
# constructs are reproduced verbatim inside their enclosing item's text.
func containedInSameLineSpan(spans: Slice[parser2.DelimitedSpan], span: ast2.SourceSpan, index: Int) -> Bool
  if index >= spans.Len() then false
  else
    switch spans.Get(index)
      case Some(other) =>
        let contains = other.Span.Start.Line == span.Start.Line && other.Span.Start.Column <= span.Start.Column && (other.Span.End.Line > span.End.Line || (other.Span.End.Line == span.End.Line && other.Span.End.Column >= span.End.Column))
        let strictlyLarger = other.Span.Start.Line < span.Start.Line || other.Span.Start.Column < span.Start.Column || other.Span.End.Column > span.End.Column
        if contains && strictlyLarger then true else containedInSameLineSpan(spans, span, index + 1) end
      case None => containedInSameLineSpan(spans, span, index + 1)
    end
  end
end

# The single-owner wrapped form of one over-long physical line.  The overwhelmingly
# common case is exactly one eligible span on the line: `delimitedReplacement`
# reproduces the previous byte-for-byte output (flat block body, or the baked
# recursive body for a nested over-long span).  A line hosting two or more
# sibling spans is stitched left-to-right so both expand in one replacement
# (instead of clobbering), baked to final indent and verbatim-locked.
func delimitedLineReplacement(raw: String, allSpans: Slice[parser2.DelimitedSpan], selected: Slice[parser2.DelimitedSpan], events: Slice[parser2.LayoutEvent], line: Int) -> String
  switch firstSelectedFrom(selected, line, 1, 0, 0, None)
    case None => raw
    case Some(sp) =>
      switch firstSelectedFrom(selected, line, sp.Span.End.Column, 0, 0, None)
        case None => delimitedReplacement(raw, sp, allSpans, events)
        case Some(_) => bakeDelimStitch(raw, allSpans, selected, events, line)
      end
  end
end

func lineUsesBaked(raw: String, allSpans: Slice[parser2.DelimitedSpan], selected: Slice[parser2.DelimitedSpan], events: Slice[parser2.LayoutEvent], line: Int) -> Bool
  switch firstSelectedFrom(selected, line, 1, 0, 0, None)
    case None => false
    case Some(sp) =>
      switch firstSelectedFrom(selected, line, sp.Span.End.Column, 0, 0, None)
        case Some(_) => true
        case None => nestedWrapped(sp, allSpans, events)
      end
  end
end

# The leftmost eligible span on `line` whose opening delimiter sits at or after
# column `pos`, chosen from the pre-filtered `selected` set.
func firstSelectedFrom(selected: Slice[parser2.DelimitedSpan], line: Int, pos: Int, index: Int, bestCol: Int, best: Option[parser2.DelimitedSpan]) -> Option[parser2.DelimitedSpan]
  if index >= selected.Len() then best
  else
    switch selected.Get(index)
      case Some(sp) =>
        let qualifies = sp.Span.Start.Line == line && (sp.Span.Start.Column - 1) >= pos - 1 && (bestCol == 0 || sp.Span.Start.Column < bestCol)
        if qualifies then firstSelectedFrom(selected, line, pos, index + 1, sp.Span.Start.Column, Some(sp)) else firstSelectedFrom(selected, line, pos, index + 1, bestCol, best) end
      case None => firstSelectedFrom(selected, line, pos, index + 1, bestCol, best)
    end
  end
end

# Stitch >=2 sibling spans on one line into a single baked replacement: text
# before each span lands on the current row, the span becomes a baked node, and
# any trailing text continues after its closing delimiter.  Rows are baked to
# final indent (base = the line's leading whitespace) so the caller verbatim-locks
# them and the depth engine never touches this rare shape.
func bakeDelimStitch(raw: String, allSpans: Slice[parser2.DelimitedSpan], selected: Slice[parser2.DelimitedSpan], events: Slice[parser2.LayoutEvent], line: Int) -> String
  strings.Join(stitchRows(allSpans, selected, raw, events, collectArrowIfs(events, line, 0, []), line, 1, "", []), "\n")
end

func stitchRows(allSpans: Slice[parser2.DelimitedSpan], selected: Slice[parser2.DelimitedSpan], raw: String, events: Slice[parser2.LayoutEvent], regions: Slice[ArrowIf], line: Int, pos: Int, cur: String, acc: Slice[String]) -> Slice[String]
  switch firstSelectedFrom(selected, line, pos, 0, 0, None)
    case Some(sp) =>
      let before = raw.Slice(pos - 1, sp.Span.Start.Column - 1).UnwrapOr("")
      let node = bakedDelimNode(raw, sp, events, allSpans, line, regions, cur + before)
      stitchRows(allSpans, selected, raw, events, regions, line, sp.Span.End.Column, "", joinStrings(acc, node))
    case None =>
      let tail = cur + raw.Slice(pos - 1, raw.Len()).UnwrapOr("")
      if strings.TrimSpace(tail) == "" then acc else acc.Append(tail) end
  end
end

# Canonical block form: the opening delimiter stays on the anchor line, every
# item occupies its own line one indent level deeper, the final item carries a
# trailing comma where the grammar allows one (tuples do not), and the closing
# delimiter sits alone on the last line at the anchor indent.
func renderDelimitedBlockBody(raw: String, item: parser2.DelimitedSpan, events: Slice[parser2.LayoutEvent]) -> String
  let open = raw.Slice(item.Span.Start.Column - 1, item.Span.Start.Column).UnwrapOr("")
  let items = delimitedBlockItems(raw, item, 0, item.Span.Start.Column, collectArrowIfs(events, item.Span.Start.Line, 0, []))
  let tail = if item.Kind == "delimited:tuple" then "" else "," end
  open + joinDelimitedItemLines(items, tail, 0) + "\n" + raw.Slice(item.Span.End.Column - 2, raw.Len()).UnwrapOr("")
end

# Collect every inline keyword `if ... then ... else ... end` on `line`.  A
# keyword `if` (HeaderForm "then") in value position reflows to the compact
# arrow form when it stays inside a wrapped delimited item; a value `if` always
# carries an `else`, so the sibling `if-else` branch must be present.
func collectArrowIfs(events: Slice[parser2.LayoutEvent], line: Int, index: Int, acc: Slice[ArrowIf]) -> Slice[ArrowIf]
  if index >= events.Len() then acc
  else
    switch events.Get(index)
      case None => collectArrowIfs(events, line, index + 1, acc)
      case Some(ev) then
        let isInlineKeywordIf = ev.Kind == "enter:if-then" && ev.BodyLayout == "inline" && ev.HeaderForm == "then" && ev.Anchor.Start.Line == line && ev.Anchor.End.Line == line && ev.ExitAnchor.Start.Line == line && ev.ExitAnchor.End.Line == line
        let region = if isInlineKeywordIf then arrowIfForThen(events, ev, 0) else None end
        switch region
          case Some(found) => collectArrowIfs(events, line, index + 1, acc.Append(found))
          case None => collectArrowIfs(events, line, index + 1, acc)
        end
      end
    end
  end
end

func arrowIfForThen(events: Slice[parser2.LayoutEvent], thenEvent: parser2.LayoutEvent, index: Int) -> Option[ArrowIf]
  if index >= events.Len() then None
  else
    switch events.Get(index)
      case None => arrowIfForThen(events, thenEvent, index + 1)
      case Some(ev) => if ev.Kind == "enter:if-else" && ev.Anchor.Start.Line == thenEvent.Anchor.Start.Line && sameBranchParent(ev.Path, thenEvent.Path, 0) then Some(ArrowIf { ThenStart: thenEvent.Anchor.Start.Column, ThenEnd: thenEvent.Anchor.End.Column, ElseStart: ev.Anchor.Start.Column, ElseEnd: ev.Anchor.End.Column, EndStart: thenEvent.ExitAnchor.Start.Column, EndEnd: thenEvent.ExitAnchor.End.Column }) else arrowIfForThen(events, thenEvent, index + 1) end
    end
  end
end

# Rewrite the arrow regions that fall inside this item's absolute column window
# `[cursor + 1, windowHigh]`, highest-first so edits never disturb a lower
# (left-ward) region's columns.  `prefix` keeps the field label + `if <cond>`,
# the `then`/`end` keywords are dropped, and `then` becomes `=>`.
func arrowizeItemText(text: String, cursor: Int, windowHigh: Int, regions: Slice[ArrowIf], index: Int) -> String
  if index < 0 then text
  else
    switch regions.Get(index)
      case None => arrowizeItemText(text, cursor, windowHigh, regions, index - 1)
      case Some(r) then
        let inWindow = r.ThenStart >= cursor + 1 && r.EndEnd <= windowHigh
        if !inWindow then arrowizeItemText(text, cursor, windowHigh, regions, index - 1)
        else
          let t0 = r.ThenStart - 1 - cursor
          let t1 = r.ThenEnd - 1 - cursor
          let e0 = r.ElseStart - 1 - cursor
          let e1 = r.ElseEnd - 1 - cursor
          let x0 = r.EndStart - 1 - cursor
          let x1 = r.EndEnd - 1 - cursor
          let next = text.Slice(0, t0).UnwrapOr("") + "=>" + text.Slice(t1, e0).UnwrapOr("") + "else" + text.Slice(e1, x0).UnwrapOr("") + text.Slice(x1, text.Len()).UnwrapOr("")
          arrowizeItemText(next, cursor, windowHigh, regions, index - 1)
        end
      end
    end
  end
end

func delimitedBlockItems(raw: String, item: parser2.DelimitedSpan, index: Int, cursor: Int, regions: Slice[ArrowIf]) -> Slice[String]
  if index >= item.Separators.Len() then
    let endByte = item.Span.End.Column - 2
    let last = strings.TrimSpace(arrowizeItemText(raw.Slice(cursor, endByte).UnwrapOr(""), cursor, endByte + 1, regions, regions.Len() - 1))
    if last == "" then [] else [last] end
  else
      switch item.Separators.Get(index)
        case None => []
        case Some(separator) then
          let endByte = separator.Start.Column - 1
          let text = strings.TrimSpace(arrowizeItemText(raw.Slice(cursor, endByte).UnwrapOr(""), cursor, endByte + 1, regions, regions.Len() - 1))
          joinStrings([text], delimitedBlockItems(raw, item, index + 1, separator.End.Column - 1, regions))
        end
      end
    end
end

func joinDelimitedItemLines(items: Slice[String], tail: String, index: Int) -> String
  if index >= items.Len() then ""
  else
    switch items.Get(index)
      case None => joinDelimitedItemLines(items, tail, index + 1)
      case Some(text) then
        let comma = if index + 1 == items.Len() then tail else "," end
        "\n  " + text + comma + joinDelimitedItemLines(items, tail, index + 1)
      end
    end
  end
end

# ---- Recursive nested delimited wrapping (M3 / design D10, task 9.1) --------
# The flat block renderer above wraps only the outermost same-line delimited
# span and reproduces every nested construct verbatim inside its item text.  When
# a nested span is itself over-long (a `Field: Label { ... }` that still exceeds
# 100 columns once hoisted onto its own row) the flat path leaves it inline, so a
# second `fmt` pass re-wraps it and the output is not idempotent.  These helpers
# render the whole literal in a SINGLE pass, recursing into each over-long nested
# same-line span and baking every produced row's FINAL indentation (base = the
# anchor line's own leading whitespace, `+2` spaces per nesting level).  The
# caller verbatim-locks those rows so the depth engine never touches them.

# The full replacement text (anchor-line prefix inclusive) for wrapping the
# outermost delimited `item`.  Selects between the flat block body (no nested
# over-long span) and the recursively baked body (a nested over-long span
# exists).  Both callers - the text pass and the edit pass - route through here
# so their computed line counts agree exactly.
func delimitedReplacement(raw: String, item: parser2.DelimitedSpan, allSpans: Slice[parser2.DelimitedSpan], events: Slice[parser2.LayoutEvent]) -> String
  let line = item.Span.Start.Line
  let regions = collectArrowIfs(events, line, 0, [])
  let prefix = raw.Slice(0, item.Span.Start.Column - 1).UnwrapOr("")
  if anyWindowOverLong(allSpans, regions, line, item) then
    let node = appendLastLine(bakedDelimNode(raw, item, events, allSpans, line, regions, prefix), raw.Slice(item.Span.End.Column - 1, raw.Len()).UnwrapOr(""), 0)
    strings.Join(node, "\n")
  else prefix + renderDelimitedBlockBody(raw, item, events) end
end

# True when wrapping `item` requires the recursive path because some nested
# same-line span is itself over-long (task 9.3b: `Span: ps.SourceSpan { ... }`).
func nestedWrapped(item: parser2.DelimitedSpan, allSpans: Slice[parser2.DelimitedSpan], events: Slice[parser2.LayoutEvent]) -> Bool
  let line = item.Span.Start.Line
  let regions = collectArrowIfs(events, line, 0, [])
  anyWindowOverLong(allSpans, regions, line, item)
end

# The source lines whose delimited expansion used the recursively baked path;
# these rows carry their final indentation and must be verbatim-locked.
func nestedDelimitedSourceLines(edits: Slice[PassEdit], index: Int, acc: Slice[Int]) -> Slice[Int]
  if index >= edits.Len() then acc
  else
    switch edits.Get(index)
      case None => nestedDelimitedSourceLines(edits, index + 1, acc)
      case Some(e) then
        let next = if e.Kind == "delimited-nested" && !containsInt(acc, e.SourceLine) then acc.Append(e.SourceLine) else acc end
        nestedDelimitedSourceLines(edits, index + 1, next)
      end
    end
  end
end

# Render one delimited node `d` to baked-indent rows.  `firstPrefix` is the
# already-baked text before the opening delimiter (anchor leading whitespace +
# callee/field label + a trailing space for struct literals, none for calls);
# the first produced row is `firstPrefix + <open delimiter>`, child rows are
# indented two spaces deeper than the anchor's leading whitespace, and the final
# row is the closing delimiter at the anchor indent.  Nested over-long items
# recurse through `nestedDelimItem`.
func bakedDelimNode(raw: String, d: parser2.DelimitedSpan, events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], line: Int, regions: Slice[ArrowIf], firstPrefix: String) -> Slice[String]
  let openChar = sl(raw, d.Span.Start.Column, d.Span.Start.Column)
  let closeChar = sl(raw, d.Span.End.Column - 1, d.Span.End.Column - 1)
  let anchorIndent = leadingWs(firstPrefix)
  let childIndent = anchorIndent + "  "
  let tail = if d.Kind == "delimited:tuple" then "" else "," end
  let items = nestedDelimItems(raw, d, events, delimited, line, regions, 0, d.Span.Start.Column, childIndent, tail)
  joinStrings([firstPrefix + openChar], joinStrings(items, [anchorIndent + closeChar]))
end

# One row per top-level item of `d`, each carrying a trailing comma (or `tail`
# for the final item; none for tuples).  Item windows are the absolute 0-based
# column ranges between the opening delimiter, the separators, and the closing
# delimiter (`d.Span.End.Column - 2` stops just before the closer).
func nestedDelimItems(raw: String, d: parser2.DelimitedSpan, events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], line: Int, regions: Slice[ArrowIf], index: Int, cursor: Int, childIndent: String, tail: String) -> Slice[String]
  let seps = d.Separators
  if index >= seps.Len() then nestedDelimItem(raw, events, delimited, line, regions, cursor, d.Span.End.Column - 2, childIndent, tail)
  else
    switch seps.Get(index)
      case None => nestedDelimItem(raw, events, delimited, line, regions, cursor, d.Span.End.Column - 2, childIndent, tail)
      case Some(sep) => joinStrings(
        nestedDelimItem(raw, events, delimited, line, regions, cursor, sep.Start.Column - 1, childIndent, ","),
        nestedDelimItems(raw, d, events, delimited, line, regions, index + 1, sep.End.Column - 1, childIndent, tail))
    end
  end
end

# Render the item text in window `[lo, hi)` (absolute 0-based).  If a nested
# same-line span inside the window is over-long, split the window into the
# label/callee prefix (arrowized, keeping the space before the delimiter), the
# recursively baked inner node, and any trailing text (arrowized); the trailing
# `comma` lands on the node's final row.  Otherwise emit a single indented row.
func nestedDelimItem(raw: String, events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], line: Int, regions: Slice[ArrowIf], lo: Int, hi: Int, childIndent: String, comma: String) -> Slice[String]
  switch overLongItemWindow(delimited, regions, line, lo, hi)
    case Some(inner) =>
      let open0 = inner.Span.Start.Column - 1
      let afterClose0 = inner.Span.End.Column - 1
      let prefixTrim = strings.TrimLeft(arrowizeItemText(raw.Slice(lo, open0).UnwrapOr(""), lo, open0 + 1, regions, regions.Len() - 1), " \t")
      let node = bakedDelimNode(raw, inner, events, delimited, line, regions, childIndent + prefixTrim)
      let rest = strings.TrimSpace(arrowizeItemText(raw.Slice(afterClose0, hi).UnwrapOr(""), afterClose0, hi + 1, regions, regions.Len() - 1))
      appendLastLine(node, rest + comma, 0)
    case None =>
      let text = strings.TrimSpace(arrowizeItemText(raw.Slice(lo, hi).UnwrapOr(""), lo, hi + 1, regions, regions.Len() - 1))
      if text == "" then [] else [childIndent + text + comma] end
  end
end

# True when wrapping `d` needs the recursive path: any of `d`'s item windows both
# (a) exceeds the 100-column construct-width cap and (b) contains a same-line
# delimited span (not inside an inline keyword `if`) that therefore must be
# hoisted onto its own nested rows.  When no window qualifies, `d`'s children all
# fit inline and the flat block body already reproduces them verbatim, so the
# recursive path is skipped (keeping single-level wraps byte-identical).
func anyWindowOverLong(delimited: Slice[parser2.DelimitedSpan], regions: Slice[ArrowIf], line: Int, d: parser2.DelimitedSpan) -> Bool
  anyWindowOverLongAt(delimited, regions, line, d, 0, d.Span.Start.Column)
end

func anyWindowOverLongAt(delimited: Slice[parser2.DelimitedSpan], regions: Slice[ArrowIf], line: Int, d: parser2.DelimitedSpan, index: Int, cursor: Int) -> Bool
  let seps = d.Separators
  if index >= seps.Len() then
    switch overLongItemWindow(delimited, regions, line, cursor, d.Span.End.Column - 2)
      case Some(_) => true
      case None => false
    end
  else
    switch seps.Get(index)
      case None => switch overLongItemWindow(delimited, regions, line, cursor, d.Span.End.Column - 2)
        case Some(_) => true
        case None => false
      end
      case Some(sep) => switch overLongItemWindow(delimited, regions, line, cursor, sep.Start.Column - 1)
        case Some(_) => true
        case None => anyWindowOverLongAt(delimited, regions, line, d, index + 1, sep.End.Column - 1)
      end
    end
  end
end

# The leftmost same-line delimited span whose braces sit entirely inside item
# window `[lo, hi)` (absolute 0-based) and that must be hoisted because the whole
# item text (`hi - lo`) exceeds 100 columns and the span is not inside an inline
# keyword `if` region.  Returns None when the window fits (<=100) or has no
# eligible delimited span.  Matches the reflow engine's decision: wrap on the
# construct's full text width (label + callee + braces), not the brace span.
func overLongItemWindow(delimited: Slice[parser2.DelimitedSpan], regions: Slice[ArrowIf], line: Int, lo: Int, hi: Int) -> Option[parser2.DelimitedSpan]
  if hi - lo <= 100 then None
  else leftmostSpanInside(delimited, regions, line, lo, hi, 0, 0, None) end
end

func leftmostSpanInside(delimited: Slice[parser2.DelimitedSpan], regions: Slice[ArrowIf], line: Int, lo: Int, hi: Int, index: Int, bestCol: Int, best: Option[parser2.DelimitedSpan]) -> Option[parser2.DelimitedSpan]
  if index >= delimited.Len() then best
  else
    switch delimited.Get(index)
      case Some(sp) =>
        let sameLine = sp.Span.Start.Line == line && sp.Span.End.Line == line
        let open0 = sp.Span.Start.Column - 1
        let afterClose0 = sp.Span.End.Column - 1
        let qualifies = sameLine && open0 > lo && afterClose0 <= hi && !insideArrowRegion(regions, sp.Span.Start.Column, sp.Span.End.Column) && (bestCol == 0 || sp.Span.Start.Column < bestCol)
        if qualifies then leftmostSpanInside(delimited, regions, line, lo, hi, index + 1, sp.Span.Start.Column, Some(sp)) else leftmostSpanInside(delimited, regions, line, lo, hi, index + 1, bestCol, best) end
      case None => leftmostSpanInside(delimited, regions, line, lo, hi, index + 1, bestCol, best)
    end
  end
end

func insideArrowRegion(regions: Slice[ArrowIf], startCol: Int, endCol: Int) -> Bool
  insideArrowRegionAt(regions, startCol, endCol, 0)
end

func insideArrowRegionAt(regions: Slice[ArrowIf], startCol: Int, endCol: Int, index: Int) -> Bool
  if index >= regions.Len() then false
  else
    switch regions.Get(index)
      case None => insideArrowRegionAt(regions, startCol, endCol, index + 1)
      case Some(r) => if r.ThenStart > 0 && r.ThenStart <= startCol && endCol <= r.EndEnd then true else insideArrowRegionAt(regions, startCol, endCol, index + 1) end
    end
  end
end

func leadingWs(s: String) -> String
  s.Slice(0, leadingWsWidth(s, 0)).UnwrapOr("")
end

func leadingWsWidth(s: String, i: Int) -> Int
  if i < s.Len() && (charAt(s, i + 1) == " " || charAt(s, i + 1) == "\t") then leadingWsWidth(s, i + 1) else i end
end

# ---- Recursive single-owner reflow (M2) -------------------------------------
# The line-replacement passes cannot share a single physical source line among
# several expandable constructs: a `case ... => body` whose body nests a wide
# delimited call, a value `switch`, or a keyword `if`.  Whichever pass rewrites
# that line first moves the others' columns, dropping callee names and
# scrambling indentation.  `reflowRegion` renders one such region to canonical
# *relative*-indented lines (the first line carries no leading indent; the
# caller prepends the base indent), deciding inline `=>` versus block
# `then`/`end` and recursing into nested constructs.  A `case` source line is
# owned by this reflow only when its body reflows to more than one line;
# single-line cases are left to the layout engine untouched.

func sl(lineText: String, c0: Int, c1: Int) -> String
  let hi = if c1 > lineText.Len() then lineText.Len() else c1 end
  if c0 - 1 >= hi then "" else lineText.Slice(c0 - 1, hi).UnwrapOr("") end
end

func charAt(lineText: String, c: Int) -> String
  if c < 1 || c > lineText.Len() then "" else lineText.Slice(c - 1, c).UnwrapOr("") end
end

func trimStartCol(lineText: String, c: Int) -> Int
  if charAt(lineText, c) == " " || charAt(lineText, c) == "\t" then trimStartCol(lineText, c + 1) else c end
end

func trimEndCol(lineText: String, c: Int) -> Int
  if c > 0 && (charAt(lineText, c) == " " || charAt(lineText, c) == "\t") then trimEndCol(lineText, c - 1) else c end
end

func firstOpenCol(lineText: String, c: Int, c1: Int) -> Int
  if c > c1 then -1
  else
    let ch = charAt(lineText, c)
    if ch == "(" || ch == "{" || ch == "[" then c else firstOpenCol(lineText, c + 1, c1) end
  end
end

func shiftLines(lines: Slice[String], depth: Int) -> Slice[String]
  lines.Fold([] as Slice[String], func(acc: Slice[String], line: String) -> Slice[String]
    acc.Append(if line == "" then line else strings.Repeat("  ", depth) + line end)
  end)
end

func appendLastLine(lines: Slice[String], suffix: String, index: Int) -> Slice[String]
  if index >= lines.Len() then []
  else
    let line = lines.Get(index).UnwrapOr("")
    let out = if index + 1 == lines.Len() then line + suffix else line end
    joinStrings([out], appendLastLine(lines, suffix, index + 1))
  end
end

func lookupSwitchAt(events: Slice[parser2.LayoutEvent], line: Int, col: Int, index: Int) -> Option[parser2.LayoutEvent]
  if index >= events.Len() then None
  else
    switch events.Get(index)
      case None => lookupSwitchAt(events, line, col, index + 1)
      case Some(e) then
        if e.Kind == "enter:switch" && e.Anchor.Start.Line == line && e.Anchor.Start.Column == col then
          Some(e)
        else
          lookupSwitchAt(events, line, col, index + 1)
        end
      end
    end
  end
end

func lookupIfAt(events: Slice[parser2.LayoutEvent], line: Int, col: Int, index: Int) -> Option[parser2.LayoutEvent]
  if index >= events.Len() then
    None
  else
    switch events.Get(index)
      case None => lookupIfAt(events, line, col, index + 1)
      case Some(e) then
        if e.Kind == "enter:if" && e.Span.Start.Line == line && e.Span.Start.Column == col then
          Some(e)
        else
          lookupIfAt(events, line, col, index + 1)
        end
      end
    end
  end
end

func lookupDelimAt(spans: Slice[parser2.DelimitedSpan], line: Int, col: Int, index: Int) -> Option[parser2.DelimitedSpan]
  if index >= spans.Len() then
    None
  else
    switch spans.Get(index)
      case None => lookupDelimAt(spans, line, col, index + 1)
      case Some(d) => if d.Span.Start.Line == line && d.Span.Start.Column == col then Some(d) else lookupDelimAt(spans, line, col, index + 1) end
    end
  end
end

func thenOfLine(events: Slice[parser2.LayoutEvent], line: Int, afterCol: Int, index: Int, best: Option[parser2.LayoutEvent]) -> Option[parser2.LayoutEvent]
  if index >= events.Len() then
    best
  else
    switch events.Get(index)
      case None => thenOfLine(events, line, afterCol, index + 1, best)
      case Some(e) then
        let hit = e.Kind == "enter:if-then" && e.Anchor.Start.Line == line && e.Anchor.Start.Column > afterCol
        let closer = switch best
          case None => true
          case Some(b) => e.Anchor.Start.Column < b.Anchor.Start.Column
        end
        let better = hit && closer
        thenOfLine(events, line, afterCol, index + 1, if better then Some(e) else best end)
      end
    end
  end
end

func elseOfLine(events: Slice[parser2.LayoutEvent], line: Int, afterCol: Int, index: Int, best: Option[parser2.LayoutEvent]) -> Option[parser2.LayoutEvent]
  if index >= events.Len() then
    best
  else
    switch events.Get(index)
      case None => elseOfLine(events, line, afterCol, index + 1, best)
      case Some(e) then
        let hit = e.Kind == "enter:if-else" && e.Anchor.Start.Line == line && e.Anchor.Start.Column > afterCol
        let closer = switch best
          case None => true
          case Some(b) => e.Anchor.Start.Column < b.Anchor.Start.Column
        end
        let better = hit && closer
        elseOfLine(events, line, afterCol, index + 1, if better then Some(e) else best end)
      end
    end
  end
end

func arrowCaseOnLine(events: Slice[parser2.LayoutEvent], line: Int, index: Int) -> Option[parser2.LayoutEvent]
  if index >= events.Len() then
    None
  else
    switch events.Get(index)
      case None => arrowCaseOnLine(events, line, index + 1)
      case Some(e) => if e.Kind == "enter:case" && e.Anchor.Start.Line == line && e.SeparatorAnchor.Start.Line == line then Some(e) else arrowCaseOnLine(events, line, index + 1) end
    end
  end
end

func reflowRegion(lineText: String, events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], line: Int, c0: Int, c1: Int, inDelim: Bool) -> Slice[String]
  let cs = trimStartCol(lineText, c0)
  let ce = trimEndCol(lineText, c1)
  let text = strings.TrimSpace(sl(lineText, cs, ce))
  switch lookupSwitchAt(events, line, cs, 0)
    case Some(_) => reflowSwitchLines(lineText, events, line, cs, ce)
    case None then
      switch lookupIfAt(events, line, cs, 0)
        case Some(ife) => reflowIfLines(lineText, events, delimited, line, cs, ce, ife, inDelim)
        case None => reflowCallLines(lineText, events, delimited, line, cs, ce, text)
      end
    end
  end
end

func reflowCallLines(lineText: String, events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], line: Int, cs: Int, ce: Int, text: String) -> Slice[String]
  let open = firstOpenCol(lineText, cs, ce)
  if open < 0 then
    [text]
  else
    let callee = strings.TrimRight(sl(lineText, cs, open - 1), " \t")
    if text.Len() <= 100 then
      [callee + sl(lineText, open, ce)]
    else
      switch lookupDelimAt(delimited, line, open, 0)
        case Some(d) => reflowDelimLines(lineText, events, delimited, line, d, callee)
        case None => [text]
      end
    end
  end
end

func reflowDelimLines(
  lineText: String,
  events: Slice[parser2.LayoutEvent],
  delimited: Slice[parser2.DelimitedSpan],
  line: Int,
  d: parser2.DelimitedSpan,
  callee: String
) -> Slice[String]
  let openChar = sl(lineText, d.Span.Start.Column, d.Span.Start.Column)
  let closeChar = sl(lineText, d.Span.End.Column - 1, d.Span.End.Column - 1)
  let tail = if d.Kind == "delimited:tuple" => "" else ","
  let items = delimItemLoop(lineText, events, delimited, line, d, d.Span.Start.Column + 1, 0, tail, [])
  joinStrings([callee + openChar], joinStrings(items, [closeChar]))
end

# The last item's content must stop BEFORE the closing delimiter.  `closeChar`
# sits at `End.Column - 1`, so the item body ends at `End.Column - 2`; using
# `End.Column - 1` let the final item swallow the closing `)`/`]`/`}`, which
# reflowCallLines then echoed verbatim (a bare `call(...)` last item rendered as
# `call(...))`).  Items reconstructed from a `switch` hid this because
# reflowSwitchLines rebuilds its text from the case events.
func delimItemLoop(
  lineText: String,
  events: Slice[parser2.LayoutEvent],
  delimited: Slice[parser2.DelimitedSpan],
  line: Int,
  d: parser2.DelimitedSpan,
  start: Int,
  index: Int,
  tail: String,
  acc: Slice[String]
) -> Slice[String]
  let seps = d.Separators
  let stop = if index >= seps.Len() then
    d.Span.End.Column - 2
  else
    switch seps.Get(index)
      case None => d.Span.End.Column - 2
      case Some(sep) => sep.Start.Column - 1
    end
  end
  let sub = reflowRegion(lineText, events, delimited, line, start, stop, true)
  let next = joinStrings(acc, appendLastLine(shiftLines(sub, 1), tail, 0))
  if index >= seps.Len() then
    next
  else
    switch seps.Get(index)
      case None => next
      case Some(sep) => delimItemLoop(lineText, events, delimited, line, d, sep.End.Column, index + 1, tail, next)
    end
  end
end

func casesInRegion(events: Slice[parser2.LayoutEvent], line: Int, cs: Int, ce: Int, index: Int, acc: Slice[parser2.LayoutEvent]) -> Slice[parser2.LayoutEvent]
  if index >= events.Len() then
    acc
  else
    switch events.Get(index)
      case None => casesInRegion(events, line, cs, ce, index + 1, acc)
      case Some(e) => casesInRegion(events, line, cs, ce, index + 1, if e.Kind == "enter:case" && e.Anchor.Start.Line == line && e.Anchor.Start.Column > cs && e.Span.End.Column - 1 <= ce then acc.Append(e) else acc end)
    end
  end
end

func switchCaseLines(lineText: String, cases: Slice[parser2.LayoutEvent], index: Int, acc: Slice[String]) -> Slice[String]
  if index >= cases.Len() then
    acc
  else
    switch cases.Get(index)
      case None => switchCaseLines(lineText, cases, index + 1, acc)
      case Some(c) => switchCaseLines(lineText, cases, index + 1, acc.Append("  " + strings.TrimSpace(sl(lineText, c.Anchor.Start.Column, c.Span.End.Column - 1))))
    end
  end
end

func reflowSwitchLines(lineText: String, events: Slice[parser2.LayoutEvent], line: Int, cs: Int, ce: Int) -> Slice[String]
  let cases = casesInRegion(events, line, cs, ce, 0, [])
  if cases.Len() == 0 then
    [strings.TrimSpace(sl(lineText, cs, ce))]
  else
    switch cases.Get(0)
      case None => [strings.TrimSpace(sl(lineText, cs, ce))]
      case Some(first) then
        let header = strings.TrimRight(sl(lineText, cs, first.Anchor.Start.Column - 1), " \t")
        let body = switchCaseLines(lineText, cases, 0, [])
        joinStrings([header], joinStrings(body, ["end"]))
      end
    end
  end
end

func reflowIfLines(lineText: String, events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], line: Int, cs: Int, ce: Int, ife: parser2.LayoutEvent, inDelim: Bool) -> Slice[String]
  let thenEopt = thenOfLine(events, line, ife.Anchor.End.Column, 0, None)
  let elseEopt = switch thenEopt
    case None => None
    case Some(t) => elseOfLine(events, line, t.Anchor.Start.Column, 0, None)
  end
  # Right boundary of the else value, exclusive.  A keyword `if ... end` carries
  # an end token and the then-branch ExitAnchor points at it, so the value ends
  # one column before.  An arrow `if cond => then else value` has no end token:
  # the then ExitAnchor is the then VALUE itself, so it cannot bound the else
  # body.  The else-branch ExitAnchor spans its value exclusively, which keeps
  # the same one-past-last-value convention for both forms.
  switch thenEopt
    case None => []
    case Some(thenE) => switch elseEopt
      case None => []
      case Some(elseE) then
        let endCol = if thenE.HeaderForm == "arrow" then elseE.ExitAnchor.End.Column else thenE.ExitAnchor.Start.Column end
        let cond = strings.TrimSpace(sl(lineText, ife.Anchor.End.Column, thenE.Anchor.Start.Column - 1))
        let thenB0 = thenE.Anchor.End.Column
        let thenB1 = elseE.Anchor.Start.Column - 1
        let elseB0 = elseE.Anchor.End.Column
        let elseB1 = endCol - 1
        let inlineLen = ce - cs + 1
        if inDelim && inlineLen <= 100 then
          ["if " + cond + " => " + strings.TrimSpace(sl(lineText, thenB0, thenB1)) + " else " + strings.TrimSpace(sl(lineText, elseB0, elseB1))]
        else
          let tb = reflowRegion(lineText, events, delimited, line, thenB0, thenB1, false)
          let eb = reflowRegion(lineText, events, delimited, line, elseB0, elseB1, false)
          joinStrings(["if " + cond + " then"], joinStrings(joinStrings(shiftLines(tb, 1), ["else"]), joinStrings(shiftLines(eb, 1), ["end"])))
        end
      end
    end
  end
end

func caseReflowLines(lineText: String, events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], line: Int) -> Slice[String]
  switch arrowCaseOnLine(events, line, 0)
    case Some(c) =>
      let pat = strings.TrimSpace(sl(lineText, c.Anchor.End.Column, c.SeparatorAnchor.Start.Column - 1))
      let b0 = trimStartCol(lineText, c.SeparatorAnchor.End.Column)
      let b1 = trimEndCol(lineText, c.Span.End.Column - 1)
      let body = reflowRegion(lineText, events, delimited, line, b0, b1, false)
      if body.Len() <= 1 then []
      else joinStrings(["case " + pat + " then"], joinStrings(shiftLines(body, 1), ["end"]))
      end
    case None => []
  end
end

# The recursive reflow pass owns the physical source lines of an arrow `case`
# whose body (a call, a value `switch`, or a value `if`) must expand to more
# than one rendered row.  Those lines carry several constructs on a single
# source row, which the flat per-line branch/case/delimited passes cannot
# reflow without slicing the same row twice and dropping the callee / field
# label between delimiters.  This pass replaces each such source line with a
# pre-indented canonical block (base = the line's own leading whitespace) and
# records one `case-reflow` PassEdit so the composition layer reserves the
# produced rows.  The emitted rows are then verbatim-locked in the render step.
func reflowPass(source: String, events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], priorEdits: Slice[PassEdit]) -> DelimitedRender
  let candidateLines = arrowCaseSourceLines(events, 0, [])
  let edits = reflowPassEdits(source.Split("\n"), events, delimited, priorEdits, candidateLines, 0, [])
  if edits.Len() == 0 then DelimitedRender { Text: source, Edits: [] }
  else DelimitedRender { Text: reflowPassText(source, events, delimited, priorEdits, candidateLines, 0), Edits: edits } end
end

# Distinct source lines that host an arrow `case` (its `=>` separator sits on
# the case's own anchor line), collected in ascending source order so the text
# pass can apply replacements highest-line-first.
func arrowCaseSourceLines(events: Slice[parser2.LayoutEvent], index: Int, acc: Slice[Int]) -> Slice[Int]
  if index >= events.Len() then acc
  else
    switch events.Get(index)
      case None => arrowCaseSourceLines(events, index + 1, acc)
      case Some(e) then
        let isArrow = e.Kind == "enter:case" && e.Anchor.Start.Line > 0 && e.Anchor.Start.Line == e.SeparatorAnchor.Start.Line
        let line = e.Anchor.Start.Line
        let next = if isArrow && !containsInt(acc, line) then acc.Append(line) else acc end
        arrowCaseSourceLines(events, index + 1, next)
      end
    end
  end
end

# Descending-index application: a replacement on a lower (higher-numbered)
# source line only grows rows beneath it, so an upper line's target row is
# still `line + lineShift(priorEdits, line)` when it is rewritten.
func reflowPassText(source: String, events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], priorEdits: Slice[PassEdit], lines: Slice[Int], index: Int) -> String
  if index >= lines.Len() then source
  else
    let rendered = reflowPassText(source, events, delimited, priorEdits, lines, index + 1)
    switch lines.Get(index)
      case None => rendered
      case Some(line) then
        let target = line + lineShift(priorEdits, line)
        let srcLines = rendered.Split("\n")
        let raw = srcLines.Get(target - 1).UnwrapOr("")
        let refl = reflowRegionForLine(raw, events, delimited, line)
        if refl.Len() <= 0 then rendered else replaceSourceLine(srcLines, target - 1, reflowBlock(raw, refl, 0, "")) end
      end
    end
  end
end

func reflowRegionForLine(raw: String, events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], line: Int) -> Slice[String]
  caseReflowLines(raw, events, delimited, line)
end

# The source span of the arrow `case` the reflow pass owns on this line.
func reflowLineSpan(events: Slice[parser2.LayoutEvent], line: Int) -> ast2.SourceSpan
  switch arrowCaseOnLine(events, line, 0)
    case Some(c) => c.Span
    case None => ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, End: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 } }
  end
end

func reflowPassEdits(sourceLines: Slice[String], events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], priorEdits: Slice[PassEdit], lines: Slice[Int], index: Int, acc: Slice[PassEdit]) -> Slice[PassEdit]
  if index >= lines.Len() then
    acc
  else
    switch lines.Get(index)
      case None => reflowPassEdits(sourceLines, events, delimited, priorEdits, lines, index + 1, acc)
      case Some(line) then
        let raw = sourceLines.Get(line + lineShift(priorEdits, line) - 1).UnwrapOr("")
        let refl = reflowRegionForLine(raw, events, delimited, line)
        let span = reflowLineSpan(events, line)
        let next = if refl.Len() <= 0 then
          acc
        else
          acc.Append(PassEdit { Anchor: line - 1, SourceLine: line, Added: refl.Len() - 1, SourceStart: span.Start.Line, SourceEnd: span.End.Line, Kind: "case-reflow", Depths: [] })
        end
        reflowPassEdits(sourceLines, events, delimited, priorEdits, lines, index + 1, next)
      end
    end
  end
end

# Prepend the source line's own leading whitespace to every reflowed row so the
# block lands at the indentation the source line already carried (input is
# canonical/idempotent, so that indentation is already the correct final one).
func reflowBlock(raw: String, refl: Slice[String], index: Int, acc: String) -> String
  if index >= refl.Len() then
    acc
  else
    let piece = indentPrefix(raw) + refl.Get(index).UnwrapOr("")
    let next = if index == 0 then
      piece
    else
      acc + "\n" + piece
    end
    reflowBlock(raw, refl, index + 1, next)
  end
end

func indentPrefix(raw: String) -> String
  sl(raw, 1, indentWidth(raw, 1))
end

func indentWidth(raw: String, c: Int) -> Int
  if charAt(raw, c) == " " || charAt(raw, c) == "\t" then
    indentWidth(raw, c + 1)
  else
    c - 1
  end
end

# --- Group 14: single-authority whole-span reflow for multi-line statement `if` ---
#
# A keyword `if` block whose branches sit on DIFFERENT source rows cannot be
# expanded by the single-line branch pass (which can add rows to one line but
# cannot consume a multi-line span).  This pass takes whole ownership of such a
# construct: it renders the `if` into canonical block rows directly from the
# layout-event structure, tagging every produced row with the ORIGINAL source
# line it came from, then groups the rows back onto those source lines and
# emits one ordinary additive PassEdit per source line so the per-source-line
# composition model reserves the produced rows.  The rows are verbatim-locked
# (the owned source lines join the reflow guard) so the target-depth engine
# never re-indents them.  Ownership is deliberately narrow - a statement
# position, multi-line, non-canonical, elsif-free `if` whose every branch body
# is a single row or a recursively-owned nested `if` - so canonical and
# multi-statement bodies are left to the existing passes untouched.

func spanSpaces(n: Int) -> String
  if n <= 0 then "" else strings.Repeat(" ", n) end
end

func countNewlines(text: String) -> Int
  text.Split("\n").Len() - 1
end

func joinRows(left: Slice[ReflowRow], right: Slice[ReflowRow]) -> Slice[ReflowRow]
  right.Fold(left, func(acc: Slice[ReflowRow], r: ReflowRow) -> Slice[ReflowRow] acc.Append(r) end)
end

func joinReflowEdits(left: Slice[ReflowEdit], right: Slice[ReflowEdit]) -> Slice[ReflowEdit]
  right.Fold(left, func(acc: Slice[ReflowEdit], r: ReflowEdit) -> Slice[ReflowEdit] acc.Append(r) end)
end

func childOfKind(
  events: Slice[parser2.LayoutEvent],
  parent: Slice[Int],
  idx: Int,
  kind: String,
  index: Int
) -> Option[parser2.LayoutEvent]
  if index >= events.Len() then
    None
  else
    switch events.Get(index)
      case None => childOfKind(events, parent, idx, kind, index + 1)
      case Some(e) => if e.Kind == kind && sameIntPath(e.Path, parent.Append(idx), 0) then Some(e) else childOfKind(events, parent, idx, kind, index + 1) end
    end
  end
end

# `spanIfRows` renders a statement `if ... elsif ...` chain only when every
# `elsif` link keeps its condition on a single header row: `elsif COND then`
# behaves like `if COND then` - the `then` closes the header and the body
# follows on its own line, so `spanElsifCond` slices the condition from the
# `transition:if-elsif` keyword to that link's `enter:if-then` keyword ON THE
# SAME ROW.  A delimited pass can wrap a long `elsif COND` call across rows
# (e.g. `elsif quoteTripleAt(` / args / `) then`), which would put the `then`
# on a later row and empty-slice the condition into an invalid `elsif  then`.
# Walk the chain; return false (decline whole-span ownership, leaving the
# generic passes to handle the multi-row form) if any link's `then` row
# differs from its `elsif` transition row.  `path` is the current `enter:if`.
func spanElsifCondsInline(events: Slice[parser2.LayoutEvent], path: Slice[Int]) -> Bool
  switch transitionForPath(events, pathWithIdx(path, 1), 0)
    case None => true
    case Some(trans) then
      switch childOfKind(events, path, 2, "enter:if", 0)
        case None => true
        case Some(nestedIf) then
          switch childOfKind(events, nestedIf.Path, 1, "enter:if-then", 0)
            case None => false
            case Some(te) => if te.Anchor.Start.Line != trans.Anchor.Start.Line then false else spanElsifCondsInline(events, nestedIf.Path) end
          end
        end
      end
    end
  end
end

func spanCond(lines: Slice[String], shift: Int, ifEv: parser2.LayoutEvent, thenEv: parser2.LayoutEvent) -> String
  let raw = lines.Get(ifEv.Anchor.Start.Line + shift - 1).UnwrapOr("")
  strings.TrimSpace(sl(raw, ifEv.Anchor.End.Column, thenEv.Anchor.Start.Column - 1))
end

# Render one branch body.  Three shapes are supported:
#  * the body is itself an `if` (found at the body anchor) -> recurse (a nested
#    `else if`, or an `end end` tail that shares a row);
#  * a single-row value: a `then` body runs to the sibling `else` on the same row
#    (or the row end when the `else` is on a later row), an `else` body runs to
#    the enclosing `if`'s own `end` on the same row;
#  * a MULTI-ROW block body (only for `else`, since a `then` value sitting on the
#    `then` row is by definition one row): rendered as a per-source-row verbatim
#    re-indent so the interior keeps its RELATIVE indentation, each produced row
#    is attributed to its OWN source line (so the per-source-line additive edit
#    model still holds), and the rows are verbatim-locked (stable across passes).
# Anything that cannot be reproduced on a single row or as a clean verbatim block
# yields `None`, dropping ownership of the whole enclosing `if`.

func spanSingleRow(raw: String, from: Int, to: Int, depth: Int, origin: Int) -> Option[Slice[ReflowRow]]
  if to <= 0 || from > to then None
  else
    let body = strings.TrimSpace(sl(raw, from, to))
    if body == "" then
      None
    else
      Some([ReflowRow { Text: body, Depth: depth, Origin: origin }])
    end
  end
end

func spanThenRows(lines: Slice[String], events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], shift: Int, base: Int, thenEv: parser2.LayoutEvent, elseEv: parser2.LayoutEvent, depth: Int, ragged: Bool) -> Option[Slice[ReflowRow]]
  let line = thenEv.Anchor.Start.Line
  let raw = lines.Get(line + shift - 1).UnwrapOr("")
  let from = trimStartCol(raw, thenEv.Anchor.End.Column)
  if from > raw.Len() || strings.TrimSpace(sl(raw, from, raw.Len())).Len() == 0 then
    # Nothing follows the `then` keyword: the body is a MULTI-ROW block that
    # starts on the next source row and runs up to the terminator's row.
    spanBodyRows(lines, events, delimited, shift, base, depth, line + 1, elseEv.Anchor.Start.Line, elseEv.Anchor.Start.Column, false, -1, ragged, [])
  else
    switch lookupIfAt(events, thenEv.BodyAnchor.Start.Line, thenEv.BodyAnchor.Start.Column, 0)
      case Some(innerIf) => spanIfRows(lines, events, delimited, shift, base, innerIf, depth, true)
      case None then
        let to = if elseEv.Anchor.Start.Line == line then
          elseEv.Anchor.Start.Column - 1
        else
          raw.Len()
        end
        spanSingleRow(raw, from, to, depth, line)
      end
    end
  end
end

# Render a MULTI-ROW block body verbatim: source rows [loLine .. termLine-1]
# become rows carrying their ORIGINAL relative indentation (the first body row
# lands at base + one level, deeper rows keep their source offset from it), each
# attributed to its own origin line so the additive per-source-line edit model
# and the verbatim lock still hold row-by-row.  The body must be a clean block:
# every non-empty row strictly deeper than the terminator keyword's column (so
# no row outside the construct is swallowed).  `requireAlone` additionally
# demands the terminator row to hold nothing past the construct (else-body):
# trailing text there would be dropped by the ownership boundary.  Returns
# `None` on any shape the verbatim copy cannot reproduce, dropping ownership of
# the whole enclosing `if`.
# D11 body recursion: render a nested statement `if` that starts a body row with
# the whole-span renderer instead of copying it verbatim.  The verbatim path
# preserves the SOURCE shape, so a glued `if COND then VALUE` inside an owned
# block body would freeze non-canonically and cascade once a later pass
# re-expands it at a conflicting depth.  The nested construct must terminate
# strictly ABOVE the enclosing terminator row (`termLine`) and pass the same
# eligibility gate the top-level candidates use; otherwise fall back to the
# verbatim copy.
func spanNestedBodyIf(
  lines: Slice[String],
  events: Slice[parser2.LayoutEvent],
  delimited: Slice[parser2.DelimitedSpan],
  shift: Int,
  base: Int,
  depth: Int,
  loLine: Int,
  termLine: Int
) -> Option[NestedBlock]
  let raw = lines.Get(loLine + shift - 1).UnwrapOr("")
  let col = trimStartCol(raw, 1)
  switch lookupIfAt(events, loLine, col, 0)
    case None => None
    case Some(inner) then
      let exitLine = inner.ExitAnchor.Start.Line
      if exitLine >= termLine || !spanIfEligible(lines, events, delimited, inner, shift) then
        None
      else
        switch spanIfRows(lines, events, delimited, shift, base, inner, depth, true)
          case None => None
          case Some(rows) => Some(NestedBlock { Rows: rows, ExitLine: exitLine })
        end
      end
    end
  end
end

func spanBodyRows(lines: Slice[String], events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], shift: Int, base: Int, depth: Int, loLine: Int, termLine: Int, termCol: Int, requireAlone: Bool, relMin: Int, ragged: Bool, acc: Slice[ReflowRow]) -> Option[Slice[ReflowRow]]
  if loLine > termLine then
    None
  else
    let raw = lines.Get(loLine + shift - 1).UnwrapOr("")
    if loLine == termLine then
      if !requireAlone || strings.TrimSpace(sl(raw, 1, termCol - 1)) == "" then
        Some(acc)
      else
        None
      end
    elsif strings.TrimSpace(raw).Len() == 0 then
      spanBodyRows(
        lines,
        events,
        delimited,
        shift,
        base,
        depth,
        loLine + 1,
        termLine,
        termCol,
        requireAlone,
        relMin,
        ragged,
        acc.Append(ReflowRow { Text: "", Depth: depth, Origin: loLine }),
      )
    else
      switch spanNestedBodyIf(lines, events, delimited, shift, base, depth, loLine, termLine)
        case Some(nested) then
          spanBodyRows(
            lines,
            events,
            delimited,
            shift,
            base,
            depth,
            nested.ExitLine + 1,
            termLine,
            termCol,
            requireAlone,
            relMin,
            ragged,
            joinRows(acc, nested.Rows),
          )
        end
        case None then
          let width = indentWidth(raw, 1)
          let rel = if relMin < 0 => width else relMin
          # In RAGGED mode (a construct reached through the D11 body recursion)
          # the layout events already bound the body rows [loLine, termLine)
          # exactly, so a body row may sit at or left of the terminator keyword
          # column - ragged source routinely writes a block body shallower than
          # its closing `end`.  The remaining `width < rel` bound still guards
          # the relative-depth model, which measures depth from the first body
          # row.  Non-ragged (top-level candidate) mode keeps the strict
          # terminator-column bound so its ownership never absorbs a dedented
          # sibling row of an outer construct.
          if (!ragged && width <= termCol) || width < rel then
            None
          else
            spanBodyRows(
              lines,
              events,
              delimited,
              shift,
              base,
              depth,
              loLine + 1,
              termLine,
              termCol,
              requireAlone,
              rel,
              ragged,
              acc.Append(ReflowRow { Text: strings.TrimSpace(raw), Depth: depth + (width - rel) / 2, Origin: loLine }),
            )
          end
        end
      end
    end
  end
end

func spanElseRows(
  lines: Slice[String],
  events: Slice[parser2.LayoutEvent],
  delimited: Slice[parser2.DelimitedSpan],
  shift: Int,
  base: Int,
  elseEv: parser2.LayoutEvent,
  ifExit: ast2.SourceSpan,
  depth: Int,
  ragged: Bool
) -> Option[Slice[ReflowRow]]
  let line = elseEv.Anchor.Start.Line
  let raw = lines.Get(line + shift - 1).UnwrapOr("")
  let from = trimStartCol(raw, elseEv.Anchor.End.Column)
  if from > raw.Len() || strings.TrimSpace(sl(raw, from, raw.Len())).Len() == 0 then
    # The `else` keyword stands alone on its row: MULTI-ROW block body running
    # to the enclosing construct's shared `end` row.
    spanBodyRows(lines, events, delimited, shift, base, depth, line + 1, ifExit.Start.Line, ifExit.Start.Column, true, -1, ragged, [])
  else
    switch lookupIfAt(events, elseEv.BodyAnchor.Start.Line, elseEv.BodyAnchor.Start.Column, 0)
      case Some(innerIf) => spanIfRows(lines, events, delimited, shift, base, innerIf, depth, true)
      case None then
        if ifExit.Start.Line != line then
          None
        else
          spanSingleRow(raw, from, ifExit.Start.Column - 1, depth, line)
        end
      end
    end
  end
end

func spanIfRows(
  lines: Slice[String],
  events: Slice[parser2.LayoutEvent],
  delimited: Slice[parser2.DelimitedSpan],
  shift: Int,
  base: Int,
  ifEv: parser2.LayoutEvent,
  depth: Int,
  ragged: Bool
) -> Option[Slice[ReflowRow]]
  let p = ifEv.Path
  switch childOfKind(events, p, 1, "enter:if-then", 0)
    case None => None
    case Some(thenEv) then
      let header = ReflowRow {
        Text: "if " + spanCond(lines, shift, ifEv, thenEv) + " then",
        Depth: depth,
        Origin: ifEv.Anchor.Start.Line
      }
      switch childOfKind(events, p, 2, "enter:if-else", 0)
        case None then
          # No `enter:if-else` in slot [2].  If slot [2] is instead a nested
          # `enter:if` reached through a `transition:if-elsif`, this is a
          # statement `if ... elsif ...` chain: the whole chain is a right-nested
          # `if` tree that shares ONE `end`, so render the then-branch here (bounded
          # by the `elsif` transition) and hand the remaining links to
          # `spanElsifRows`, which emits the flat `elsif` keyword form at the SAME
          # depth and the single shared `end`.  Anything else (a bare `if` with no
          # `else`) is out of scope here -> drop ownership.
          switch childOfKind(events, p, 2, "enter:if", 0)
            case None => None
            case Some(nestedIf) then
              switch transitionForPath(events, pathWithIdx(p, 1), 0)
                case None => None
                case Some(trans) then
                  switch spanThenRows(lines, events, delimited, shift, base, thenEv, trans, depth + 1, ragged)
                    case None => None
                    case Some(tb) then
                      switch spanElsifRows(lines, events, delimited, shift, base, nestedIf, depth, ragged)
                        case None => None
                        case Some(er) => Some(joinRows(joinRows([header], tb), er))
                      end
                    end
                  end
                end
              end
            end
          end
        end
        case Some(elseEv) then
          let elseRow = ReflowRow { Text: "else", Depth: depth, Origin: elseEv.Anchor.Start.Line }
          let endRow = ReflowRow { Text: "end", Depth: depth, Origin: ifEv.ExitAnchor.Start.Line }
          switch spanThenRows(lines, events, delimited, shift, base, thenEv, elseEv, depth + 1, ragged)
            case None => None
            case Some(tb) then
              switch spanElseRows(lines, events, delimited, shift, base, elseEv, ifEv.ExitAnchor, depth + 1, ragged)
                case None => None
                case Some(eb) => Some(joinRows(joinRows([header], tb), joinRows(joinRows([elseRow], eb), [endRow])))
              end
            end
          end
        end
      end
    end
  end
end

# Locate the `transition:if-elsif` event carrying `path` (the enclosing `if`'s
# then-branch slot: parent ++ [1]).  Its Anchor is the `elsif` keyword, which
# bounds the preceding branch's single-row value and supplies the following
# link's condition start.
func transitionForPath(events: Slice[parser2.LayoutEvent], path: Slice[Int], index: Int) -> Option[parser2.LayoutEvent]
  if index >= events.Len() then None
  else
    switch events.Get(index)
      case None => transitionForPath(events, path, index + 1)
      case Some(e) => if e.Kind == "transition:if-elsif" && sameIntPath(e.Path, path, 0) then Some(e) else transitionForPath(events, path, index + 1) end
    end
  end
end

# Build a FRESH `base ++ [idx]` path.  A plain `base.Append(idx)` on a slice that
# shares a longer slice's backing array (e.g. a `Slice(0, len-1)` view of a node
# `Path`) mutates that array in place at index `len(base)`, corrupting the
# original path element and every later reader of it - a real hazard when the
# caller still needs `base` after computing the child path.
func pathWithIdx(base: Slice[Int], idx: Int) -> Slice[Int]
  base.Fold([], func(acc: Slice[Int], x: Int) -> Slice[Int]
    acc.Append(x)
  end).Append(idx)
end

# Condition text of an `elsif` link: the nested `enter:if`'s own `Anchor` points
# at the OUTER `if` row, so the condition must be sliced from the `transition:if-
# elsif` keyword end to the link's own `enter:if-then` anchor start, on the
# transition's row.
func spanElsifCond(lines: Slice[String], shift: Int, trans: parser2.LayoutEvent, thenEv: parser2.LayoutEvent) -> String
  let raw = lines.Get(trans.Anchor.Start.Line + shift - 1).UnwrapOr("")
  strings.TrimSpace(sl(raw, trans.Anchor.End.Column, thenEv.Anchor.Start.Column - 1))
end

# Render the remaining links of a statement `if ... elsif ...` chain starting at
# `elsifIf` (a nested `enter:if` reached via an `elsif` transition).  Emits rows
# WITHOUT a leading `if`/`then` of the caller's - each link renders `elsif COND
# then` + then-body at `depth + 1` - and, when the chain terminates, the single
# `else` (if present) and the ONE shared `end`, both at `depth`.  Deeper links
# recurse at the SAME depth (a flat chain, not nesting).
func spanElsifRows(lines: Slice[String], events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], shift: Int, base: Int, elsifIf: parser2.LayoutEvent, depth: Int, ragged: Bool) -> Option[Slice[ReflowRow]]
  let q = elsifIf.Path
  switch childOfKind(events, q, 1, "enter:if-then", 0)
    case None => None
    case Some(te) then
      let parentPath = q.Slice(0, q.Len() - 1).UnwrapOr([])
      switch transitionForPath(events, pathWithIdx(parentPath, 1), 0)
        case None => None
        case Some(trans) then
          let header = ReflowRow { Text: "elsif " + spanElsifCond(lines, shift, trans, te) + " then", Depth: depth, Origin: trans.Anchor.Start.Line }
          switch childOfKind(events, q, 2, "enter:if-else", 0)
            case Some(elseEv) then
              let elseRow = ReflowRow { Text: "else", Depth: depth, Origin: elseEv.Anchor.Start.Line }
              let endRow = ReflowRow { Text: "end", Depth: depth, Origin: elsifIf.ExitAnchor.Start.Line }
              switch spanThenRows(lines, events, delimited, shift, base, te, elseEv, depth + 1, ragged)
                case None => None
                case Some(tb) then
                  switch spanElseRows(lines, events, delimited, shift, base, elseEv, elsifIf.ExitAnchor, depth + 1, ragged)
                    case None => None
                    case Some(eb) => Some(joinRows(joinRows([header], tb), joinRows(joinRows([elseRow], eb), [endRow])))
                  end
                end
              end
            end
            case None then
              switch childOfKind(events, q, 2, "enter:if", 0)
                case Some(deeper) then
                  switch transitionForPath(events, pathWithIdx(q, 1), 0)
                    case None => None
                    case Some(deeperTrans) then
                      switch spanThenRows(lines, events, delimited, shift, base, te, deeperTrans, depth + 1, ragged)
                        case None => None
                        case Some(tb) then
                          switch spanElsifRows(lines, events, delimited, shift, base, deeper, depth, ragged)
                            case None => None
                            case Some(er) => Some(joinRows(joinRows([header], tb), er))
                          end
                        end
                      end
                    end
                  end
                end
                case None => None
              end
            end
          end
        end
      end
    end
  end
end

func makeReflowEdit(origin: Int, text: String, srcStart: Int, srcEnd: Int) -> ReflowEdit
  ReflowEdit { Origin: origin, Text: text, Edit: PassEdit { Anchor: origin - 1, SourceLine: origin, Added: countNewlines(text), SourceStart: srcStart, SourceEnd: srcEnd, Kind: "span-if", Depths: [] } }
end

func groupRows(rows: Slice[ReflowRow], base: Int, srcStart: Int, srcEnd: Int, index: Int, curOrigin: Int, curText: String, acc: Slice[ReflowEdit]) -> Slice[ReflowEdit]
  if index >= rows.Len() then
    if curOrigin <= 0 then acc else acc.Append(makeReflowEdit(curOrigin, curText, srcStart, srcEnd)) end
  else
    switch rows.Get(index)
      case None => acc
      case Some(r) then
        let lineText = if r.Depth < 0 then
          r.Text
        elsif r.Text == "" then
          ""
        else
          spanSpaces(base + r.Depth * 2) + r.Text
        end
        if curOrigin <= 0 then
          groupRows(rows, base, srcStart, srcEnd, index + 1, r.Origin, lineText, acc)
        elsif r.Origin == curOrigin then
          groupRows(rows, base, srcStart, srcEnd, index + 1, curOrigin, curText + "\n" + lineText, acc)
        else
          groupRows(
            rows,
            base,
            srcStart,
            srcEnd,
            index + 1,
            r.Origin,
            lineText,
            acc.Append(makeReflowEdit(curOrigin, curText, srcStart, srcEnd)),
          )
        end
      end
    end
  end
end

func spanIfCandidateEdits(
  lines: Slice[String],
  events: Slice[parser2.LayoutEvent],
  delimited: Slice[parser2.DelimitedSpan],
  shift: Int,
  cand: parser2.LayoutEvent
) -> Slice[ReflowEdit]
  let base = indentWidth(lines.Get(cand.Anchor.Start.Line + shift - 1).UnwrapOr(""), 1)
  switch spanIfRows(lines, events, delimited, shift, base, cand, 0, false)
    case None => []
    case Some(rows) => groupRows(rows, base, cand.Anchor.Start.Line, cand.ExitAnchor.Start.Line, 0, 0, "", [])
  end
end

func overlapsLines(lines: Slice[Int], lo: Int, hi: Int) -> Bool
  lines.Fold(false, func(hit: Bool, l: Int) -> Bool hit || (l >= lo && l <= hi) end)
end

func uniformShift(priorEdits: Slice[PassEdit], lo: Int, hi: Int) -> Bool
  lineShift(priorEdits, lo) == lineShift(priorEdits, hi)
end

func spanIfEligible(
  lines: Slice[String],
  events: Slice[parser2.LayoutEvent],
  delimited: Slice[parser2.DelimitedSpan],
  cand: parser2.LayoutEvent,
  shift: Int
) -> Bool
  let s = cand.Anchor.Start.Line
  let e = cand.ExitAnchor.Start.Line
  let raw = lines.Get(s + shift - 1).UnwrapOr("")
  let stmtStart = trimStartCol(raw, 1) == cand.Anchor.Start.Column
  let nonCanon = switch childOfKind(events, cand.Path, 1, "enter:if-then", 0)
    case Some(te) => te.BodyAnchor.Start.Line == te.Anchor.Start.Line && te.Anchor.Start.Line == s
    case None => false
  end
  e >= s && cand.Kind == "enter:if" && cand.Span.Start.Line == s && stmtStart && nonCanon && !insideSameLineDelimited(delimited, s, cand.Anchor.Start.Column) && spanElsifCondsInline(events, cand.Path)
end

func spanIfCandidates(
  lines: Slice[String],
  events: Slice[parser2.LayoutEvent],
  delimited: Slice[parser2.DelimitedSpan],
  priorEdits: Slice[PassEdit],
  skipLines: Slice[Int],
  index: Int,
  lastEnd: Int,
  acc: Slice[parser2.LayoutEvent]
) -> Slice[parser2.LayoutEvent]
  if index >= events.Len() then
    acc
  else
    switch events.Get(index)
      case None => spanIfCandidates(lines, events, delimited, priorEdits, skipLines, index + 1, lastEnd, acc)
      case Some(cand) then
    let s = cand.Anchor.Start.Line
    let e = cand.ExitAnchor.Start.Line
    let shift = lineShift(priorEdits, s)
    let ok = cand.Kind == "enter:if" && s > lastEnd && e >= s && !overlapsLines(skipLines, s, e) && uniformShift(priorEdits, s, e) && spanIfEligible(lines, events, delimited, cand, shift)
        if ok then
          spanIfCandidates(lines, events, delimited, priorEdits, skipLines, index + 1, e, acc.Append(cand))
        else
          spanIfCandidates(lines, events, delimited, priorEdits, skipLines, index + 1, lastEnd, acc)
        end
      end
    end
  end
end

func spanIfEditsOf(
  lines: Slice[String],
  events: Slice[parser2.LayoutEvent],
  delimited: Slice[parser2.DelimitedSpan],
  priorEdits: Slice[PassEdit],
  skipLines: Slice[Int]
) -> Slice[ReflowEdit]
  let cands = spanIfCandidates(lines, events, delimited, priorEdits, skipLines, 0, 0, [])
  cands.Fold([], func(acc: Slice[ReflowEdit], c: parser2.LayoutEvent) -> Slice[ReflowEdit]
    joinReflowEdits(acc, spanIfCandidateEdits(lines, events, delimited, lineShift(priorEdits, c.Anchor.Start.Line), c))
  end)
end

func mapReflowEdits(rens: Slice[ReflowEdit], index: Int, acc: Slice[PassEdit]) -> Slice[PassEdit]
  if index >= rens.Len() then
    acc
  else
    switch rens.Get(index)
      case None => acc
      case Some(r) => mapReflowEdits(rens, index + 1, acc.Append(r.Edit))
    end
  end
end

func spanIfApplyText(src: String, priorEdits: Slice[PassEdit], rens: Slice[ReflowEdit], index: Int) -> String
  if index < 0 then
    src
  else
    switch rens.Get(index)
      case None => spanIfApplyText(src, priorEdits, rens, index - 1)
      case Some(r) then
        let target = r.Origin + lineShift(priorEdits, r.Origin)
        let edited = replaceSourceLine(src.Split("\n"), target - 1, r.Text)
        spanIfApplyText(edited, priorEdits, rens, index - 1)
      end
    end
  end
end

func spanIfPass(
  source: String,
  events: Slice[parser2.LayoutEvent],
  delimited: Slice[parser2.DelimitedSpan],
  priorEdits: Slice[PassEdit],
  skipLines: Slice[Int]
) -> DelimitedRender
  let rens = spanIfEditsOf(source.Split("\n"), events, delimited, priorEdits, skipLines)
  if rens.Len() == 0 then
    DelimitedRender { Text: source, Edits: [] }
  else
    DelimitedRender { Text: spanIfApplyText(source, priorEdits, rens, rens.Len() - 1), Edits: mapReflowEdits(rens, 0, []) }
  end
end

func ownedSourceLines(edits: Slice[PassEdit], index: Int, acc: Slice[Int]) -> Slice[Int]
  if index >= edits.Len() then acc
  else
    switch edits.Get(index)
      case None => ownedSourceLines(edits, index + 1, acc)
      case Some(e) => ownedSourceLines(edits, index + 1, acc.Append(e.SourceLine))
    end
  end
end

# Map the owned (reflowed) source lines onto the rendered rows their expansion
# produced.  `composePassRows` stamps both the identity head row and every
# synthetic body/after row with `SourceLine = edit.SourceLine`, so filtering the
# composed mapping by owned source lines yields exactly the rows to lock.
func projectOwnedRows(owned: Slice[Int], mappings: Slice[LineMapping], index: Int) -> Slice[Int]
  if index >= mappings.Len() then []
  else
    switch mappings.Get(index)
      case None => projectOwnedRows(owned, mappings, index + 1)
      case Some(m) then
        let current = if containsInt(owned, m.SourceLine) then [m.RenderedLine] else [] end
        joinInts(current, projectOwnedRows(owned, mappings, index + 1))
      end
    end
  end
end

# A same-line arrow `case` needs the flat force-block only when its body is a
# bare expression (no `switch`/`if` at the body start and no opening delimiter,
# so nothing recursive can split it) whose physical line still overflows 100
# columns.  Any construct body belongs to the recursive reflow pass instead.
func caseBodyNeedsFlatBlock(raw: String, events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], line: Int, item: parser2.LayoutEvent) -> Bool
  let b0 = trimStartCol(raw, item.SeparatorAnchor.End.Column)
  let b1 = trimEndCol(raw, item.Span.End.Column - 1)
  let bare = switch lookupSwitchAt(events, line, b0, 0)
    case Some(_) => false
    case None =>
      switch lookupIfAt(events, line, b0, 0)
        case Some(_) => false
        case None => firstOpenCol(raw, b0, b1) < 0
      end
    end
  bare && raw.Len() > 100
end

func renderCaseSpanAt(source: String, cases: Slice[parser2.LayoutEvent], events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], priorEdits: Slice[PassEdit], index: Int, ownedLines: Slice[Int]) -> DelimitedRender
  if index >= cases.Len() then
    DelimitedRender { Text: source, Edits: [] }
  else
    switch cases.Get(index)
      case None => renderCaseSpanAt(source, cases, events, delimited, priorEdits, index + 1, ownedLines)
      case Some(item) then
        let rendered = renderCaseSpanAt(source, cases, events, delimited, priorEdits, index + 1, ownedLines)
    let line = item.Anchor.Start.Line
    let target = line + lineShift(priorEdits, line)
    let lines = rendered.Text.Split("\n")
    let raw = lines.Get(target - 1).UnwrapOr("")
    # A same-line arrow `case` is force-blocked by this flat pass ONLY when its
    # body is a bare expression (no call/`switch`/`if` construct the recursive
    # reflow pass would own) that still cannot fit within 100 columns.  When the
    # body IS such a construct, the reflow pass owns the inline-vs-block decision
    # -- either it reflowed the line (owned, already skipped above) or it kept
    # the construct inline -- so re-running this pass on the canonical output
    # would re-split an intentionally inline body and drop the callee (the
    # BodyAnchor sits on the opening delimiter).  Keeping this pass to bare
    # bodies makes it agree with the reflow pass, which is what idempotence needs.
    if item.ExpandsAfter && item.Anchor.Start.Line > 0 && item.BodyAnchor.Start.Line > 0 && item.Anchor.Start.Line == item.SeparatorAnchor.Start.Line && item.SeparatorAnchor.Start.Line == item.BodyAnchor.Start.Line && item.SeparatorAnchor.End.Column <= item.BodyAnchor.Start.Column && !insideSameLineDelimited(delimited, line, item.Anchor.Start.Column) && !containsInt(ownedLines, line) && caseBodyNeedsFlatBlock(raw, events, delimited, line, item) then
      let replacement = expandCaseSourceLine(raw, item)
      let edit = PassEdit { Anchor: line - 1, SourceLine: line, Added: replacement.Split("\n").Len() - 1, SourceStart: item.Span.Start.Line, SourceEnd: item.Span.End.Line, Kind: "case-branch", Depths: [] }
      DelimitedRender { Text: replaceSourceLine(lines, target - 1, replacement), Edits: joinEdits(rendered.Edits, [edit]) }
      else rendered end
      end
    end
  end
end

func expandCaseSourceLine(raw: String, item: parser2.LayoutEvent) -> String
  let separator = item.SeparatorAnchor
  let prefix = strings.TrimRight(raw.Slice(0, separator.Start.Column - 1).UnwrapOr(raw), " \t")
  let body = strings.TrimSpace(raw.Slice(item.BodyAnchor.Start.Column - 1, raw.Len()).UnwrapOr(""))
  prefix + " then\n  " + body + "\nend"
end

func renderBranchSpanAt(source: String, thenEvents: Slice[parser2.LayoutEvent], events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], priorEdits: Slice[PassEdit], index: Int, ownedLines: Slice[Int]) -> DelimitedRender
  if index >= thenEvents.Len() then DelimitedRender { Text: source, Edits: [] }
  else
    switch thenEvents.Get(index)
      case None => renderBranchSpanAt(source, thenEvents, events, delimited, priorEdits, index + 1, ownedLines)
      case Some(thenEvent) then
        let elseEvents = events.Filter(func(item: parser2.LayoutEvent) -> Bool item.Kind == "enter:if-else" && sameBranchParent(item.Path, thenEvent.Path, 0) end)
        let rendered = renderBranchSpanAt(source, thenEvents, events, delimited, priorEdits, index + 1, ownedLines)
        if elseEvents.Len() == 0 then rendered
        else switch elseEvents.Get(0)
          case None => rendered
          case Some(elseEvent) then
        let exit = branchExitAnchor(events, thenEvent.Path, 0)
        let line = thenEvent.Anchor.Start.Line
        let target = line + lineShift(priorEdits, line)
        let lines = rendered.Text.Split("\n")
        let raw = lines.Get(target - 1).UnwrapOr("")
      if shouldExpandBranch(raw, thenEvent, elseEvent, exit) && branchArrowSuffixEmpty(raw, thenEvent, exit) && !insideSameLineDelimited(delimited, line, thenEvent.Anchor.Start.Column) && !containsInt(ownedLines, line) && !hasElsifTransition(events, thenEvent.Path) && !hasElsifInRange(events, line, branchIfStart(events, thenEvent.Path, 0), exit.End.Column) && branchIsIfKeyword(raw, events, thenEvent.Path) then
        let ifCol = branchIfStart(events, thenEvent.Path, 0)
        let replacement = branchReflowText(raw, events, delimited, line, ifCol, exit)
        let edit = PassEdit { Anchor: line - 1, SourceLine: line, Added: replacement.Split("\n").Len() - 1, SourceStart: line, SourceEnd: if thenEvent.Span.End.Line > 0 then thenEvent.Span.End.Line else line end, Kind: "if-branch", Depths: [] }
        DelimitedRender { Text: replaceSourceLine(lines, target - 1, replacement), Edits: joinEdits(rendered.Edits, [edit]) }
      else rendered end
          end
        end
        end
      end
    end
  end
end

# A branch or case whose anchor sits inside a same-line delimited literal must
# not be reflowed on its own: the delimited pass owns that physical line and,
# once it splits the literal, the inner construct lands on its own row and stays
# inline there.  Expanding both would slice the same row twice and drop content.
func insideSameLineDelimited(spans: Slice[parser2.DelimitedSpan], line: Int, column: Int) -> Bool
  spans.Fold(false, func(found: Bool, item: parser2.DelimitedSpan) -> Bool
    if found then true
    else item.Span.Start.Line == line && item.Span.End.Line == line && item.Span.Start.Column <= column && column <= item.Span.End.Column end
  end)
end

func sameBranchParent(left: Slice[Int], right: Slice[Int], index: Int) -> Bool
  if left.Len() != right.Len() || left.Len() == 0 then false
  elsif index + 1 >= left.Len() then left.Get(index).UnwrapOr(-1) == 2 && right.Get(index).UnwrapOr(-2) == 1
  elsif left.Get(index).UnwrapOr(-1) != right.Get(index).UnwrapOr(-2) then false
  else sameBranchParent(left, right, index + 1) end
end

func branchExitAnchor(events: Slice[parser2.LayoutEvent], branchPath: Slice[Int], index: Int) -> ast2.SourceSpan
  if index >= events.Len() then ast2.SourceSpan { Start: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 }, End: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 } }
  else
    switch events.Get(index)
      case None => branchExitAnchor(events, branchPath, index + 1)
      case Some(item) => if item.Kind == "enter:if" && isBranchParent(item.Path, branchPath, 0) then item.ExitAnchor else branchExitAnchor(events, branchPath, index + 1) end
    end
  end
end

func isBranchParent(parent: Slice[Int], branch: Slice[Int], index: Int) -> Bool
  if branch.Len() != parent.Len() + 1 then false
  elsif index >= parent.Len() then true
  elsif parent.Get(index).UnwrapOr(-1) != branch.Get(index).UnwrapOr(-2) then false
  else isBranchParent(parent, branch, index + 1) end
end

# Only a keyword `if` whose ENTIRE `if ... then <value> else <value> end` fits
# on a single source line may be sliced by `expandBranchSourceLine` (it reads the
# `else` body and the `end` column out of the one raw line).  The `then` and
# `else` anchors can share a line even when the `else` body is a multi-row block
# whose `end` sits on a later row; slicing that from the single raw line yields
# an empty `else` body plus a spurious `end` and orphans the real body, which
# does not re-parse.  Requiring the `end` (`exit`) to share the anchor line
# restricts this flat reflow to genuinely single-line value `if`s; a multi-row
# `else` block is left to the depth engine / verbatim paths that reproduce it.
#
func shouldExpandBranch(raw: String, thenEvent: parser2.LayoutEvent, elseEvent: parser2.LayoutEvent, exit: ast2.SourceSpan) -> Bool
  thenEvent.ExpandsAfter && thenEvent.Anchor.Start.Line > 0 && thenEvent.BodyAnchor.Start.Line > 0 && thenEvent.Anchor.Start.Line == thenEvent.BodyAnchor.Start.Line && thenEvent.Anchor.Start.Line == elseEvent.Anchor.Start.Line && thenEvent.Anchor.Start.Line == exit.Start.Line
end

# An arrow `if` in value position may be followed by a postfix (a field access,
# a call's `(args)`, ...) that belongs to the ENCLOSING expression: the lossless
# branch span ends before it, and the flat branch reflow would paste that
# trailing text right after the synthesized `end` (`end.field` / `end(...)`,
# which does not re-parse).  Only expand an arrow `if` when nothing but
# whitespace trails its own span; a keyword `if` always ends on its `end`
# token, so it is unaffected.
func branchArrowSuffixEmpty(raw: String, thenEvent: parser2.LayoutEvent, exit: ast2.SourceSpan) -> Bool
  thenEvent.HeaderForm != "arrow" || strings.TrimSpace(raw.Slice(exit.End.Column - 1, raw.Len()).UnwrapOr("")).Len() == 0
end

# `expandBranchSourceLine` only reflows a single `then … else …` pair. A value-position
# keyword `if` that also carries `elsif` clauses (a full `if/elsif/…/else/end` chain on one
# source line) cannot be sliced by that helper — doing so drops the intermediate `elsif`
# branch values and corrupts parse. Defer those to the delimited/single-authority pass by
# leaving them inline, which stays valid and idempotent.
func hasElsifTransition(events: Slice[parser2.LayoutEvent], branchPath: Slice[Int]) -> Bool
  events.Fold(false, func(found: Bool, item: parser2.LayoutEvent) -> Bool
    found || (item.Kind == "transition:if-elsif" && sameIntPath(item.Path, branchPath, 0))
  end)
end

# True when any `elsif` link sits on `line` within column range [lo, hi].  The
# recursive `reflowRegion` engine renders a keyword `if` as `then / else / end`
# only; it has no notion of `elsif`, so feeding it an if that carries an `elsif`
# (parsed as a nested `if` in the else slot) mis-splits the branch and duplicates
# the head.  `hasElsifTransition` matches by exact node path and misses a chain
# because the transition lives on the enclosing `if` path while the reflow fires
# on the branch path; this line/range check catches every elsif inside the span.
func hasElsifInRange(events: Slice[parser2.LayoutEvent], line: Int, lo: Int, hi: Int) -> Bool
  events.Fold(false, func(found: Bool, item: parser2.LayoutEvent) -> Bool
    found || (item.Kind == "transition:if-elsif" && item.Anchor.Start.Line == line && item.Anchor.Start.Column >= lo && item.Anchor.Start.Column <= hi)
  end)
end

func branchThenSpansShareLine(thenEvent: parser2.LayoutEvent, elseEvent: parser2.LayoutEvent, exit: ast2.SourceSpan) -> Bool
  thenEvent.Anchor.Start.Line > 0 && thenEvent.Anchor.Start.Line == elseEvent.Anchor.Start.Line && elseEvent.Anchor.Start.Line == exit.Start.Line && thenEvent.Anchor.End.Column <= elseEvent.Anchor.Start.Column && elseEvent.Anchor.End.Column <= exit.Start.Column
end

func branchArrowSpansShareLine(thenEvent: parser2.LayoutEvent, elseEvent: parser2.LayoutEvent) -> Bool
  thenEvent.Anchor.Start.Line > 0 && thenEvent.Anchor.Start.Line == elseEvent.Anchor.Start.Line && elseEvent.Anchor.Start.Line == elseEvent.Span.End.Line && thenEvent.Anchor.End.Column <= elseEvent.Anchor.Start.Column && elseEvent.Anchor.End.Column <= elseEvent.Span.End.Column
end

func replaceSourceLine(lines: Slice[String], index: Int, replacement: String) -> String
  let before = lines.Slice(0, index).UnwrapOr([])
  let after = lines.Slice(index + 1, lines.Len()).UnwrapOr([])
  strings.Join(joinStrings(joinStrings(before, [replacement]), after), "\n")
end

func joinStrings(left: Slice[String], right: Slice[String]) -> Slice[String]
  if right.Len() == 0 then left
  else joinStrings(left.Append(right.Get(0).UnwrapOr("")), right.Slice(1, right.Len()).UnwrapOr([])) end
end

# Single-authority branch reflow: render a single-line keyword
# `if ... then ... else ... end` to canonical block rows by delegating to the
# SAME recursive reflow engine the case / delimited passes use (`reflowRegion`),
# instead of slicing fixed 2-space bodies out of the raw line.  This keeps any
# nested call / value `if` in the branches correctly reflowed, keeps the text
# before the `if` (e.g. a call's prefix `acc.Append(`) on the first row and the
# text after the `end` (e.g. the call's closing `)`) on the last row, and bakes
# the line's own leading whitespace as the base indent so the block lands at the
# enclosing depth.  `reflowRegion`'s `reflowIfLines` always emits the block
# form (R1) with `+1`-relative bodies, recursively.
func branchReflowText(raw: String, events: Slice[parser2.LayoutEvent], delimited: Slice[parser2.DelimitedSpan], line: Int, ifCol: Int, exit: ast2.SourceSpan) -> String
  let prefix = raw.Slice(0, ifCol - 1).UnwrapOr("")
  let suffix = raw.Slice(exit.End.Column - 1, raw.Len()).UnwrapOr("")
  let rows = reflowRegion(raw, events, delimited, line, ifCol, raw.Len(), false)
  let base = indentPrefix(raw)
  strings.Join(stitchBranchRows(prefix, base, rows, suffix, 0, []), "\n")
end

# The column of the enclosing `if` keyword for a branch. `lookupIfAt` matches an
# `enter:if` event by its Span start, and the `enter:if-then` anchor sits on the
# `then` keyword (a different column), so the region handed to `reflowRegion`
# must start at the parent `enter:if` Span column, not the `then` anchor.
func branchIfStart(events: Slice[parser2.LayoutEvent], branchPath: Slice[Int], index: Int) -> Int
  if index >= events.Len() then 0
  else
    switch events.Get(index)
      case None => branchIfStart(events, branchPath, index + 1)
      case Some(item) => if item.Kind == "enter:if" && isBranchParent(item.Path, branchPath, 0) then item.Span.Start.Column else branchIfStart(events, branchPath, index + 1) end
    end
  end
end

# An `elsif` is parsed as an `if` in the else slot WITHOUT an `if` keyword, so its
# span starts on the condition, not on an `if` token.  `reflowRegion` renders the
# branch back with a literal `if` header, which duplicates / corrupts an `elsif`
# chain.  Only expand a branch whose construct genuinely begins with the `if`
# keyword at the located column.
func branchIsIfKeyword(raw: String, events: Slice[parser2.LayoutEvent], branchPath: Slice[Int]) -> Bool
  let col = branchIfStart(events, branchPath, 0)
  col > 0 && raw.Slice(col - 1, col + 1).UnwrapOr("") == "if"
end

func stitchBranchRows(prefix: String, base: String, rows: Slice[String], suffix: String, index: Int, acc: Slice[String]) -> Slice[String]
  if index >= rows.Len() then acc
  else
    let text = rows.Get(index).UnwrapOr("")
    let head = if index == 0 then prefix else base end
    let tail = if index + 1 == rows.Len() then suffix else "" end
    stitchBranchRows(prefix, base, rows, suffix, index + 1, acc.Append(head + text + tail))
  end
end

func expandBranchSourceLineOld(raw: String, thenEvent: parser2.LayoutEvent, elseEvent: parser2.LayoutEvent, exit: ast2.SourceSpan) -> String
  let header = thenEvent.Anchor
  let alternative = elseEvent.Anchor
  let headerStart = header.Start.Column - 1
  let headerEnd = header.End.Column - 1
  let alternativeStart = alternative.Start.Column - 1
  let alternativeEnd = alternative.End.Column - 1
  let prefix = strings.TrimRight(raw.Slice(0, headerStart).UnwrapOr(raw), " \t")
  let thenBody = strings.TrimSpace(raw.Slice(headerEnd, alternativeStart).UnwrapOr(""))
  let elseEnd = if thenEvent.HeaderForm == "arrow" then raw.Len() else exit.Start.Column - 1 end
  let elseBody = strings.TrimSpace(raw.Slice(alternativeEnd, elseEnd).UnwrapOr(""))
  prefix + " then\n  " + thenBody + "\nelse\n  " + elseBody + "\nend"
end

func renderSourceLinesWithTargets(source: String, protectedLines: Slice[Int], verbatimLines: Slice[Int], blockLines: Slice[Int], dedentLines: Slice[Int], targets: Slice[Int], lineMap: Slice[LineMapping], segments: Slice[ExpansionSegment], layoutEvents: Slice[parser2.LayoutEvent], syntheticEvents: Slice[SyntheticLayoutEvent], renderedEvents: Slice[RenderedLayoutEvent]) -> String
  let normalized = strings.ReplaceAll(source, "\r\n", "\n")
  let projectedTargets = targets
  let initial = LayoutState { Lines: [], SourceLine: 1, LineMap: lineMap, Segments: segments, SyntheticEvents: syntheticEvents, Indent: 0, Protected: false, ProtectedLines: protectedLines, VerbatimLines: verbatimLines, BlockLines: blockLines, DedentLines: dedentLines, TargetIndents: projectedTargets, EventDriven: true }
  let state = normalized.Split("\n").Fold(initial, func(state: LayoutState, raw: String) -> LayoutState foldLine(state, raw) end)
  strings.TrimRight(strings.Join(state.Lines, "\n"), "\n") + "\n"
end

# The projection walks the composed line mapping in rendered order.  Each
# mapping names the source line it renders plus its role within an expansion
# (identity, "body", or "after").  An event's enter fires at the identity row
# of its source line; its exit fires either at that same row (non-expanding
# blocks) or at the "after" row that closes its expansion.  The target list is
# sized to the final rendered text, so the renderer never needs a fallback.
func projectRenderedEventTargets(events: Slice[RenderedLayoutEvent], mappings: Slice[LineMapping], index: Int, depth: Int) -> Slice[Int]
  projectRenderedEventTargetsWith(events, elsifTransitionPaths(events), mappings, 0, 0)
end

func projectRenderedEventTargetsWith(events: Slice[RenderedLayoutEvent], elsifPaths: Slice[Slice[Int]], mappings: Slice[LineMapping], index: Int, depth: Int) -> Slice[Int]
  projectRenderedEventTargetsAcc(events, elsifPaths, mappings, index, depth, [])
end

# The target list is built left-to-right with an accumulator so each rendered
# row appends a single element (amortized O(1)) instead of rebuilding the whole
# downstream list at every level.  Values and ordering are unchanged.
func projectRenderedEventTargetsAcc(events: Slice[RenderedLayoutEvent], elsifPaths: Slice[Slice[Int]], mappings: Slice[LineMapping], index: Int, depth: Int, acc: Slice[Int]) -> Slice[Int]
  if index >= mappings.Len() then acc
  else
    switch mappings.Get(index)
      case None => projectRenderedEventTargetsAcc(events, elsifPaths, mappings, index + 1, depth, acc)
      case Some(mapping) then
        let exits = renderedEventCount(events, elsifPaths, mapping, "exit")
        let current = if depth > exits then depth - exits else 0 end
        let transitions = renderedTransitionCount(events, mapping)
        let target = if current > transitions then current - transitions else 0 end
        let enters = renderedEventCount(events, elsifPaths, mapping, "enter")
        projectRenderedEventTargetsAcc(events, elsifPaths, mappings, index + 1, target + enters, acc.Append(target))
      end
    end
  end
end

func renderedTransitionCount(events: Slice[RenderedLayoutEvent], mapping: LineMapping) -> Int
  events.Fold(0, func(count: Int, item: RenderedLayoutEvent) -> Int
    if item.Kind == "transition:if-elsif" && !mapping.Synthetic && mapping.SourceLine == item.SourceLine then count + 1 else count end
  end)
end

func renderedEventCount(events: Slice[RenderedLayoutEvent], elsifPaths: Slice[Slice[Int]], mapping: LineMapping, phase: String) -> Int
  events.Fold(0, func(count: Int, item: RenderedLayoutEvent) -> Int
    let structural = item.AffectsIndent && !(phase == "exit" && item.Kind == "exit:if-then" && memberIntPath(elsifPaths, item.Path))
    let matches = if phase == "enter" then item.Boundary == "enter-header" else item.Boundary == "exit-anchor" || item.Boundary == "body-end" || item.Boundary == "block-end" end
    let isEnter = phase == "enter"
    let keyLine = if isEnter then item.SourceLine else item.ExitSourceLine end
    let row = if item.ExpandsAfter then
        if isEnter then
          if strings.Contains(item.Kind, "enter:if-else") then mapping.Synthetic && mapping.Boundary == "else" && mapping.SourceLine == keyLine
          else !mapping.Synthetic && mapping.SourceLine == keyLine end
        else
          if strings.Contains(item.Kind, "exit:if-then") then mapping.Synthetic && mapping.Boundary == "else" && mapping.SourceLine == keyLine
          else mapping.Synthetic && mapping.Boundary == "after" && mapping.SourceLine == keyLine end
        end
      else !mapping.Synthetic && mapping.SourceLine == keyLine end
    if structural && matches && row then count + 1 else count end
  end)
end

# Precompute the set of branch paths that carry an `if-elsif` transition so the
# per-line projection can test membership in O(#transitions) instead of rescanning
# the whole event list for every exit event.
func elsifTransitionPaths(events: Slice[RenderedLayoutEvent]) -> Slice[Slice[Int]]
  events.Fold([], func(acc: Slice[Slice[Int]], item: RenderedLayoutEvent) -> Slice[Slice[Int]]
    if item.Kind == "transition:if-elsif" then
      acc.Append(item.Path)
    else
      acc
    end
  end)
end

func memberIntPath(paths: Slice[Slice[Int]], target: Slice[Int]) -> Bool
  paths.Fold(false, func(found: Bool, p: Slice[Int]) -> Bool
    found || sameIntPath(p, target, 0)
  end)
end

func sameIntPath(left: Slice[Int], right: Slice[Int], index: Int) -> Bool
  if left.Len() != right.Len() then
    false
  elsif index >= left.Len() then
    true
  elsif left.Get(index).UnwrapOr(-1) != right.Get(index).UnwrapOr(-2) then
    false
  else
    sameIntPath(left, right, index + 1)
  end
end


func joinInts(left: Slice[Int], right: Slice[Int]) -> Slice[Int]
  if right.Len() == 0 then
    left
  else
    joinInts(left.Append(right.Get(0).UnwrapOr(0)), right.Slice(1, right.Len()).UnwrapOr([]))
  end
end

func layoutEventLine(item: parser2.LayoutEvent) -> Int
  if item.Kind == "enter:case-body" then
    if item.BodyAnchor.Start.Line > 0 then
      item.BodyAnchor.Start.Line
    else
      item.Span.Start.Line
    end
  elsif item.Kind == "enter:case" then
    if item.Anchor.Start.Line > 0 then
      item.Anchor.Start.Line
    else
      item.Span.Start.Line
    end
  elsif strings.Contains(item.Kind, "enter:if-then") || strings.Contains(item.Kind, "enter:if-else") || strings.Contains(item.Kind, "enter:switch") then
    item.HeaderLine
  else
    item.Span.Start.Line
  end
end

func formatLayout(source: String) -> String
  switch FormatSource("layout.mygo", source)
    case Ok(formatted) => formatted
    case Err(_) => source
  end
end

func foldLine(state: LayoutState, raw: String) -> LayoutState
  if containsInt(state.VerbatimLines, state.SourceLine) then
    verbatimLine(state, raw)
  elsif state.Protected || containsInt(state.ProtectedLines, state.SourceLine) then
    protectedLine(state, raw)
  else
    normalLine(state, raw)
  end
end

# Verbatim rows are the output of the recursive reflow pass: they already carry
# their final indentation (baked by the reflow engine, whose base was the source
# line's own leading whitespace).  Reproduce them byte-for-byte and skip the
# event-depth indent engine entirely, so nested switches/ifs/delimited bodies are
# never re-indented a second time.
func verbatimLine(state: LayoutState, raw: String) -> LayoutState
  advanceLayoutState(state, state.Lines.Append(raw), currentTargetIndent(state), false)
end

func containsInt(values: Slice[Int], target: Int) -> Bool
  containsIntAt(values, target, 0)
end

func containsIntAt(values: Slice[Int], target: Int, index: Int) -> Bool
  if index >= values.Len() then
    false
  elsif values.Get(index).UnwrapOr(-1) == target then
    true
  else
    containsIntAt(values, target, index + 1)
  end
end

func protectedLine(state: LayoutState, raw: String) -> LayoutState
  let indent = currentTargetIndent(state)
  let rendered = if state.Protected then
    raw
  else
    strings.Repeat("  ", indent) + strings.TrimLeft(raw, " \t")
  end
  # Continuation lines of a multiline protected literal reproduce the source
  # line byte-for-byte: no trim, no re-indent, closing delimiter included.
  advanceLayoutState(state, state.Lines.Append(rendered), indent, containsInt(state.ProtectedLines, state.SourceLine + 1))
end

func advanceLayoutState(state: LayoutState, lines: Slice[String], indent: Int, protected: Bool) -> LayoutState
  LayoutState {
    Lines: lines,
    SourceLine: state.SourceLine + 1,
    LineMap: state.LineMap,
    Segments: state.Segments,
    SyntheticEvents: state.SyntheticEvents,
    Indent: indent,
    Protected: protected,
    ProtectedLines: state.ProtectedLines,
    VerbatimLines: state.VerbatimLines,
    BlockLines: state.BlockLines,
    DedentLines: state.DedentLines,
    TargetIndents: state.TargetIndents,
    EventDriven: state.EventDriven,
  }
end

func normalLine(state: LayoutState, raw: String) -> LayoutState
  let line = strings.TrimSpace(raw)
  if line == "" then
    advanceLayoutState(state, state.Lines.Append(""), state.Indent, false)
  else
    let next = nonEmptyLine(state, line)
    next
  end
end

func nonEmptyLine(state: LayoutState, line: String) -> LayoutState
  let target = currentTargetIndent(state)
  let eventIndent = syntheticDepthDelta(state.SyntheticEvents, state.SourceLine, 0)
  let effectiveIndent = target + eventIndent
  let rendered = strings.Repeat(" ", effectiveIndent * 2) + normalizeLine(line)
  advanceLayoutState(state, state.Lines.Append(rendered), effectiveIndent, false)
end

func syntheticDepthDelta(events: Slice[SyntheticLayoutEvent], renderedLine: Int, index: Int) -> Int
  if index >= events.Len() then 0
  else
    switch events.Get(index)
      case Some(event) then
        if event.RenderedLine == renderedLine then
          event.DepthDelta + syntheticDepthDelta(events, renderedLine, index + 1)
        else
          syntheticDepthDelta(events, renderedLine, index + 1)
        end
      end
      case None => syntheticDepthDelta(events, renderedLine, index + 1)
    end
  end
end

func currentTargetIndent(state: LayoutState) -> Int
  let renderedLine = state.SourceLine
  let target = if state.TargetIndents.Len() >= renderedLine then
    state.TargetIndents.Get(renderedLine - 1).UnwrapOr(state.Indent)
  else
    state.Indent
  end
  target
end

func segmentForRenderedLine(segments: Slice[ExpansionSegment], renderedLine: Int, index: Int) -> Option[ExpansionSegment]
  if index >= segments.Len() then
    None
  else
    switch segments.Get(index)
      case Some(segment) then
        if renderedLine >= segment.RenderedStart && renderedLine <= segment.RenderedEnd then
          Some(segment)
        else
          segmentForRenderedLine(segments, renderedLine, index + 1)
        end
      end
      case None => segmentForRenderedLine(segments, renderedLine, index + 1)
    end
  end
end

func remapEventLines(lines: Slice[Int], mappings: Slice[LineMapping], segments: Slice[ExpansionSegment], index: Int) -> Slice[Int]
  if index >= lines.Len() then
    []
  else
    switch lines.Get(index)
      case Some(sourceLine) => joinInts(remapOneEventLine(sourceLine, mappings, segments, 0), remapEventLines(lines, mappings, segments, index + 1))
      case None => remapEventLines(lines, mappings, segments, index + 1)
    end
  end
end

func remapLayoutEvent(item: parser2.LayoutEvent, events: Slice[parser2.LayoutEvent], mappings: Slice[LineMapping], segments: Slice[ExpansionSegment]) -> Slice[RenderedLayoutEvent]
  let sourceLine = remapEventSourceLine(item)
  let renderedStart = firstRenderedLine(remapOneEventLineRegular(sourceLine, mappings, segments, 0), 0)
  let exitSourceLine = if item.ExitAnchor.Start.Line > 0 then item.ExitAnchor.Start.Line else item.ExitLine end
  let exitKey = if strings.HasPrefix(item.Kind, "exit:") && item.ExpandsAfter then item.Anchor.Start.Line
    elsif strings.Contains(item.Kind, "exit:if-then") then siblingElseLine(events, item, 0)
    else exitSourceLine end
  let renderedEnd = if item.ExpandsAfter then
    switch syntheticEndLine(segments, sourceLine, 0)
      case Some(line) => line
      case None => lastRenderedLine(remapOneEventLine(exitSourceLine, mappings, segments, 0), renderedStart, 0)
    end
  else lastRenderedLine(remapOneEventLine(exitSourceLine, mappings, segments, 0), renderedStart, 0) end
  let bodySourceLine = if item.BodyAnchor.Start.Line > 0 then item.BodyAnchor.Start.Line else sourceLine end
  let bodyLine = firstRenderedLine(remapOneEventLineRegular(bodySourceLine, mappings, segments, 0), renderedStart)
  let bodyLayout = if renderedEnd > renderedStart then "block" else item.BodyLayout end
  let explicitExit = item.ExitAnchor.Start.Line > item.Span.End.Line
  let boundary = if strings.HasPrefix(item.Kind, "enter:") then "enter-header" elsif explicitExit then "exit-anchor" elsif strings.Contains(item.Kind, "exit:case") then "body-end" else "block-end" end
  [RenderedLayoutEvent { Kind: item.Kind, Path: item.Path, SourceLine: sourceLine, ExitSourceLine: exitKey, RenderedLine: renderedStart, RenderedStart: renderedStart, RenderedEnd: renderedEnd, BodyLine: bodyLine, BodyLayout: bodyLayout, AffectsIndent: item.AffectsIndent, ExpandsAfter: item.ExpandsAfter, Depth: item.Depth, Delta: 0, Boundary: boundary }]
end

func siblingElseLine(events: Slice[parser2.LayoutEvent], item: parser2.LayoutEvent, index: Int) -> Int
  if index >= events.Len() then item.ExitLine
  else
    switch events.Get(index)
      case None => siblingElseLine(events, item, index + 1)
      case Some(other) => if other.Kind == "enter:if-else" && sameBranchParent(other.Path, item.Path, 0) && other.Anchor.Start.Line > 0 then other.Anchor.Start.Line else siblingElseLine(events, item, index + 1) end
    end
  end
end

func firstRenderedLine(lines: Slice[Int], fallback: Int) -> Int
  if lines.Len() == 0 then fallback else lines.Get(0).UnwrapOr(fallback) end
end

func lastRenderedLine(lines: Slice[Int], fallback: Int, index: Int) -> Int
  if index >= lines.Len() then fallback
  else lastRenderedLine(lines, lines.Get(index).UnwrapOr(fallback), index + 1) end
end

func remapEventSourceLine(item: parser2.LayoutEvent) -> Int
  if strings.HasPrefix(item.Kind, "exit:") then item.ExitLine
  elsif item.Kind == "enter:case-body" then
    if item.BodyAnchor.Start.Line > 0 then item.BodyAnchor.Start.Line else layoutEventLine(item) end
  elsif item.Anchor.Start.Line > 0 then item.Anchor.Start.Line
  else layoutEventLine(item) end
end

func remapOneEventLine(sourceLine: Int, mappings: Slice[LineMapping], segments: Slice[ExpansionSegment], index: Int) -> Slice[Int]
  if index == 0 then
    switch syntheticEndLine(segments, sourceLine, 0)
      case Some(line) => [line]
      case None => remapOneEventLineRegular(sourceLine, mappings, segments, 0)
    end
  elsif index >= mappings.Len() then []
  else
    switch mappings.Get(index)
      case Some(item) =>
        if item.SourceLine == sourceLine || (item.Synthetic && item.AnchorSourceLine == sourceLine) then
          switch segmentForRenderedLine(segments, item.RenderedLine, 0)
            case Some(_) => [item.RenderedLine]
            case None => remapOneEventLine(sourceLine, mappings, segments, index + 1)
          end
        else remapOneEventLine(sourceLine, mappings, segments, index + 1) end
      case None => remapOneEventLine(sourceLine, mappings, segments, index + 1)
    end
  end
end

func remapOneEventLineRegular(sourceLine: Int, mappings: Slice[LineMapping], segments: Slice[ExpansionSegment], index: Int) -> Slice[Int]
  if index >= mappings.Len() then []
  else
    switch mappings.Get(index)
      case Some(item) =>
        if item.SourceLine == sourceLine || (item.Synthetic && item.AnchorSourceLine == sourceLine) then
          switch segmentForRenderedLine(segments, item.RenderedLine, 0)
            case Some(_) => joinInts([item.RenderedLine], remapOneEventLineRegular(sourceLine, mappings, segments, index + 1))
            case None => remapOneEventLineRegular(sourceLine, mappings, segments, index + 1)
          end
        else remapOneEventLineRegular(sourceLine, mappings, segments, index + 1) end
      case None => remapOneEventLineRegular(sourceLine, mappings, segments, index + 1)
    end
  end
end

func syntheticEndLine(segments: Slice[ExpansionSegment], sourceLine: Int, index: Int) -> Option[Int]
  if index >= segments.Len() then None
  else
    switch segments.Get(index)
      case Some(segment) =>
        if strings.Contains(segment.Kind, "-end") && segment.SourceStart == sourceLine then Some(segment.RenderedStart)
        elsif segment.Kind == "block-body" && segment.SourceStart == sourceLine && segment.RenderedStart < segment.RenderedEnd then Some(segment.RenderedEnd)
        else syntheticEndLine(segments, sourceLine, index + 1) end
      case None => syntheticEndLine(segments, sourceLine, index + 1)
    end
  end
end

struct NormState
  Out: String
  Index: Int
  Started: Bool
  Spacing: Bool
end

# Collapse runs of whitespace outside literals to a single space (dropping any
# leading whitespace) while reproducing every `"…"`, `'…'`, and raw-backtick
# literal byte-for-byte.  The renderer calls this on each physical line, so a
# wrapped or reflowed code line normalizes its spacing without ever corrupting
# a string literal's interior - which is why such literals no longer need their
# whole source line protected.
func normalizeLine(line: String) -> String
  normalizeStep(NormState { Out: "", Index: 0, Started: false, Spacing: false }, line)
end

func separator(state: NormState) -> String
  if state.Started && state.Spacing then " " else "" end
end

func normalizeStep(state: NormState, line: String) -> String
  if state.Index >= line.Len() then state.Out
  else
    let c = line.Slice(state.Index, state.Index + 1).UnwrapOr("")
    if c == " " || c == "\t" || c == "\r" then
      normalizeStep(NormState { Out: state.Out, Index: state.Index + 1, Started: state.Started, Spacing: state.Started }, line)
    elsif c == "\"" || c == "'" || c == "`" then
      normalizeStep(scanLiteral(line, NormState { Out: state.Out + separator(state), Index: state.Index, Started: true, Spacing: false }), line)
    else
      normalizeStep(NormState { Out: state.Out + separator(state) + c, Index: state.Index + 1, Started: true, Spacing: false }, line)
    end
  end
end

# Copy a literal from `state.Index` (the opening quote) through its closing
# delimiter verbatim.  Backslash escapes are honored inside `"…"`/`'…'`; raw
# backtick literals carry no escapes.
func scanLiteral(line: String, state: NormState) -> NormState
  let quote = line.Slice(state.Index, state.Index + 1).UnwrapOr("")
  literalTail(line, state.Index + 1, NormState { Out: state.Out + quote, Index: state.Index + 1, Started: true, Spacing: false }, quote)
end

func literalTail(line: String, index: Int, state: NormState, quote: String) -> NormState
  if index >= line.Len() then state
  else
    let c = line.Slice(index, index + 1).UnwrapOr("")
    if quote != "`" && c == "\\" then
      let nxt = line.Slice(index + 1, index + 2).UnwrapOr("")
      literalTail(line, index + 2, NormState { Out: state.Out + c + nxt, Index: index + 2, Started: true, Spacing: false }, quote)
    elsif c == quote then
      NormState { Out: state.Out + c, Index: index + 1, Started: true, Spacing: false }
    else
      literalTail(line, index + 1, NormState { Out: state.Out + c, Index: index + 1, Started: true, Spacing: false }, quote)
    end
  end
end
