package ast2

# ast2 is the compact AST used by the self-hosted parser2 pipeline.
# It mirrors the syntax currently produced by parser2 and intentionally keeps
# positions out until parser2 starts carrying source spans.

struct SourcePos
  SourceName: String
  Line: Int
  Column: Int
end

struct File
  PackageName: String
  Decls: Slice[Decl]
  SourceName: String
  Line: Int
  Column: Int
  DeclPositions: Slice[SourcePos]
end

enum Decl
  ImportDecl(String, String)
  # `type A = B` preserves B's identity; `type A B` is a distinct nominal type.
  TypeAliasDecl(String, Slice[String], TypeExpr)
  TypeDecl(String, Slice[String], TypeExpr)
  # Keep Body before Using so the established generated Go API retains F4.
  FuncDecl(String, Slice[String], Slice[Param], Option[TypeExpr], Expr, Slice[Constraint])
  StructDecl(String, Slice[String], Slice[Field])
  EnumDecl(String, Slice[String], Slice[Variant])
  InterfaceDecl(String, Slice[String], Slice[FuncSig])
  ImplDecl(Slice[String], TypeExpr, Option[TypeExpr], Slice[ImplMethod])
end

struct Param
  Name: String
  Type: TypeExpr
end

struct Field
  Name: String
  Type: TypeExpr
  Tag: Option[String]
end

struct Variant
  Name: String
  Fields: Slice[TypeExpr]
end

struct FuncSig
  Pos: SourcePos
  Name: String
  TypeParams: Slice[String]
  Params: Slice[Param]
  Ret: Option[TypeExpr]
  Using: Slice[Constraint]
end

# Constraint is a typeclass requirement carried by a function or interface
# method. BindName is populated by `using Local: Class[Args]`.
struct Constraint
  Name: String
  BindName: Option[String]
  Args: Slice[TypeExpr]
end

struct ImplMethod
  Pos: SourcePos
  Sig: FuncSig
  Body: Expr
end

struct StructLitField
  Name: String
  Value: Expr
end

struct StructLitHead
  Name: String
  TypeArgs: Slice[TypeExpr]
end

struct SwitchCase
  Pattern: Pattern
  Body: Expr
end

enum Pattern
  # A binding pattern introduces the matched value under a local name.
  BindPattern(String)
  VariantPattern(String, Slice[Pattern])
  TuplePattern(Slice[Pattern])
  LiteralPattern(String, String)
  WildcardPattern
end

enum TypeExpr
  NamedType(String, Slice[TypeExpr])
  FuncType(Slice[TypeExpr], Ref[TypeExpr])
  TupleType(Slice[TypeExpr])
  UnitType
  # Inline Golang: go[T]{...}
  InlineGo(Ref[TypeExpr], String)
end

struct Bind
  Name: String
  Type: Option[TypeExpr]
  Value: Expr
end

# A letrec binding is always annotated.  The annotation lets the entire group
# enter scope before any initializer is inferred or lowered.
struct LetRecBind
  Name: String
  Type: TypeExpr
  Value: Expr
end

struct GoOperand
  Name: String
  Value: Expr
end

struct GoTypeOperand
  Name: String
  Type: TypeExpr
end

# Stmt statement type, used for independent statements within a block.
# Expr within each Stmt variant is a pure expression (a syntax node without statement semantics).
enum Stmt
  # expression statement, use expr as stmt
  ExprStmt(Expr)
  # let immutable variable declaration
  LetStmt(Bind)
  # mutually-recursive immutable bindings
  LetRecStmt(Slice[LetRecBind])
  # tuple destructuring declaration
  TupleLetStmt(Slice[String], Expr)
  # var mutable variable declaration
  VarStmt(Bind)
  # while loop
  WhileStmt(Expr, Expr)
  # assignment statement
  AssignStmt(Expr, Expr)
  # return statement (without return value)
  ReturnStmt
  # return statement (with return value)
  ReturnWithStmt(Expr)
  # leave the innermost while loop
  BreakStmt
  # begin the next iteration of the innermost while loop
  ContinueStmt
end

# `ExprKind` is a pure expression shape, containing no statement semantics.
# All control flow structures and syntax nodes with side effects are `Stmt`.
enum ExprKind
  IdentExpr(String)
  NumberExpr(String)
  StringExpr(String)
  RuneExpr(String)
  BoolExpr(Bool)
  UnitExpr
  # tuple expression; an empty tuple is represented by UnitExpr
  TupleExpr(Slice[Expr])
  CallExpr(Expr, Slice[TypeExpr], Slice[Expr])
  # DictionaryCallExpr is introduced by type inference after a method call is
  # unified with a lexical `using` constraint.  The key identifies that exact
  # inferred dictionary; parser2 never produces this node directly.
  DictionaryCallExpr(String, Expr, Slice[Expr])
  FieldExpr(Expr, String)
  UnaryExpr(String, Expr)
  BinaryExpr(String, Expr, Expr)
  IfExpr(Expr, Expr, Expr)
  BlockExpr(Slice[Stmt])
  SwitchExpr(Expr, Slice[SwitchCase])
  FuncLitExpr(Slice[Param], Option[TypeExpr], Expr)
  SliceLitExpr(Slice[Expr])
  TypeAsExpr(Expr, TypeExpr)
  StructLitExpr(String, Slice[StructLitField])
  GenericStructLitExpr(String, Slice[TypeExpr], Slice[StructLitField])
  InlineGoExpr(Ref[TypeExpr], String, Slice[GoOperand], Slice[GoTypeOperand])
  # Map literal: {"key": value, ...}
  # Uses Slice[Expr] for keys and values, stored as alternating key1, val1, key2, val2, ...
  MapLitExpr(Slice[(Expr, Expr)])
  # Set literal: {"a", "b", ...}
  SetLitExpr(Slice[Expr])
end

# `Expr` is the positioned expression node.  Expression shape belongs to
# `ExprKind`, so every expression—including recursive children—has one
# canonical source location.
# `ID` is a unique identifier assigned after parsing so type inference
# results can be looked up by code generation via pointer-identity in the
# generated Go (the ID field is copied with every value copy, so the
# mapping from Expr → MonoType in TypedInfo.ExprTypes can be recovered
# by comparing the ID carried in the caller's local copy with the ID
# stored alongside the MonoType during inference).
struct Expr
  ID: Int
  Pos: SourcePos
  Kind: ExprKind
  Type: Option[MonoType]
end



func typeExprSliceEq(left: Slice[TypeExpr], right: Slice[TypeExpr]) -> Bool
  if left.Len() != right.Len() then
    false
  else
    typeExprSliceEqElems(left, right, 0)
  end
end

func typeExprSliceEqElems(left: Slice[TypeExpr], right: Slice[TypeExpr], index: Int) -> Bool
  if index >= left.Len() then
    true
  else
    let l = left.Get(index).UnwrapOr(TypeExpr.UnitType)
    let r = right.Get(index).UnwrapOr(TypeExpr.UnitType)
    if l.Equals(r) then
      typeExprSliceEqElems(left, right, index + 1)
    else
      false
    end
  end
end

func EmptyExpr() -> Expr
  Expr {
    ID: 0,
    Pos: SourcePos{SourceName: "", Line: 0, Column: 0},
    Kind: ExprKind.UnitExpr,
    Type: None
  }
end

impl TypeExpr: Eq[TypeExpr]
  func Equals(left: TypeExpr, right: TypeExpr) -> Bool
    switch left
      case NamedType(nameL, argsL) =>
        switch right
          case NamedType(nameR, argsR) => nameL == nameR && typeExprSliceEq(argsL, argsR)
          case _ => false
        end
      case FuncType(paramsL, retL) =>
        switch right
          case FuncType(paramsR, retR) =>
            typeExprSliceEq(paramsL, paramsR) && retL.value().Equals(retR.value())
          case _ => false
        end
      case TupleType(itemsL) =>
        switch right
          case TupleType(itemsR) => typeExprSliceEq(itemsL, itemsR)
          case _ => false
        end
      case UnitType =>
        switch right
          case UnitType => true
          case _ => false
        end
      case InlineGo(innerL, codeL) =>
        switch right
          case InlineGo(innerR, codeR) =>
            innerL.value().Equals(innerR.value()) && codeL == codeR
          case _ => false
        end
    end
  end
end

func TypesEqual(a: TypeExpr, b: TypeExpr) -> Bool
  a.Equals(b)
end
