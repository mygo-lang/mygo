package ast2

# ABI-neutral construction and inspection for hand-written Go code.
#
# MyGO enums have two possible Go shapes: the legacy interface form (variant
# types plus `__Ctor` functions) and the canonical tagged-struct form. Hand-
# written Go cannot name either shape without breaking the other, so everything
# that builds or inspects an enum goes through the functions here. They are
# ordinary MyGO functions, so they exist — with the same signature — in both
# ABIs.

# --- TypeExpr construction -------------------------------------------------

func NamedTypeExpr(name: String, args: Slice[TypeExpr]) -> TypeExpr
  TypeExpr.NamedType(name, args)
end

func UnitTypeExpr() -> TypeExpr
  TypeExpr.UnitType
end

func TupleTypeExpr(items: Slice[TypeExpr]) -> TypeExpr
  TypeExpr.TupleType(items)
end

func FuncTypeExpr(params: Slice[TypeExpr], ret: TypeExpr) -> TypeExpr
  TypeExpr.FuncType(params, Ref.new(ret))
end

func ArrayTypeExpr(element: TypeExpr, length: Int) -> TypeExpr
  TypeExpr.ArrayType(Ref.new(element), length)
end

func InlineGoTypeExpr(inner: TypeExpr, code: String) -> TypeExpr
  TypeExpr.InlineGo(Ref.new(inner), code)
end

# --- TypeExpr inspection ---------------------------------------------------

func TypeIsNamed(typ: TypeExpr) -> Bool
  switch typ
    case NamedType(_, _) => true
    case _ => false
  end
end

func TypeNamedName(typ: TypeExpr) -> String
  switch typ
    case NamedType(name, _) => name
    case _ => ""
  end
end

func TypeNamedArgs(typ: TypeExpr) -> Slice[TypeExpr]
  switch typ
    case NamedType(_, args) => args
    case _ => []
  end
end

func TypeIsFunc(typ: TypeExpr) -> Bool
  switch typ
    case FuncType(_, _) => true
    case _ => false
  end
end

func TypeFuncParams(typ: TypeExpr) -> Slice[TypeExpr]
  switch typ
    case FuncType(params, _) => params
    case _ => []
  end
end

func TypeFuncRet(typ: TypeExpr) -> TypeExpr
  switch typ
    case FuncType(_, ret) => ret.value()
    case _ => TypeExpr.UnitType
  end
end

func TypeIsTuple(typ: TypeExpr) -> Bool
  switch typ
    case TupleType(_) => true
    case _ => false
  end
end

func TypeTupleItems(typ: TypeExpr) -> Slice[TypeExpr]
  switch typ
    case TupleType(items) => items
    case _ => []
  end
end

func TypeIsUnit(typ: TypeExpr) -> Bool
  switch typ
    case UnitType => true
    case _ => false
  end
end

func TypeIsArray(typ: TypeExpr) -> Bool
  switch typ
    case ArrayType(_, _) => true
    case _ => false
  end
end

func TypeArrayElement(typ: TypeExpr) -> TypeExpr
  switch typ
    case ArrayType(element, _) => element.value()
    case _ => TypeExpr.UnitType
  end
end

func TypeArrayLength(typ: TypeExpr) -> Int
  switch typ
    case ArrayType(_, length) => length
    case _ => 0
  end
end

func TypeIsInlineGo(typ: TypeExpr) -> Bool
  switch typ
    case InlineGo(_, _) => true
    case _ => false
  end
end

func TypeInlineGoInner(typ: TypeExpr) -> TypeExpr
  switch typ
    case InlineGo(inner, _) => inner.value()
    case _ => TypeExpr.UnitType
  end
end

func TypeInlineGoCode(typ: TypeExpr) -> String
  switch typ
    case InlineGo(_, code) => code
    case _ => ""
  end
end

# --- MonoType construction -------------------------------------------------

func TConType(name: String) -> MonoType
  MonoType.TCon(name)
end

func TParamType(id: Int) -> MonoType
  MonoType.TParam(id)
end

func TQualifiedType(path: String, inner: MonoType) -> MonoType
  MonoType.TQualifiedName(path, Ref.new(inner))
end

func TAppType(ctor: MonoType, args: Slice[MonoType]) -> MonoType
  MonoType.TApp(Ref.new(ctor), args)
end

func TArrayType(element: MonoType, length: Int) -> MonoType
  MonoType.TArray(Ref.new(element), length)
end

func TTupleType(items: Slice[MonoType]) -> MonoType
  MonoType.TTuple(items)
end

func TFuncType(params: Slice[MonoType], ret: MonoType) -> MonoType
  MonoType.TFunc(params, Ref.new(ret))
end

func TVariadicType(params: Slice[MonoType], ret: MonoType) -> MonoType
  MonoType.TVariadic(params, Ref.new(ret))
end

func TUnitType() -> MonoType
  MonoType.TUnit
end

# --- Pattern construction --------------------------------------------------

func BindPatternNode(name: String) -> Pattern
  Pattern.BindPattern(name)
end

func VariantPatternNode(name: String, items: Slice[Pattern]) -> Pattern
  Pattern.VariantPattern(name, items)
end

func TuplePatternNode(items: Slice[Pattern]) -> Pattern
  Pattern.TuplePattern(items)
end

func LiteralPatternNode(kind: String, value: String) -> Pattern
  Pattern.LiteralPattern(kind, value)
end

func StructVariantPatternNode(name: String, fields: Slice[StructPatternField]) -> Pattern
  Pattern.StructVariantPattern(name, fields)
end

func WildcardPatternNode() -> Pattern
  Pattern.WildcardPattern
end

# --- Stmt construction -----------------------------------------------------

func ExprStmtNode(expr: Expr) -> Stmt
  Stmt.ExprStmt(expr)
end

func LetStmtNode(bind: Bind) -> Stmt
  Stmt.LetStmt(bind)
end

func TupleLetStmtNode(pattern: Pattern, value: Expr) -> Stmt
  Stmt.TupleLetStmt(pattern, value)
end

func VarStmtNode(bind: Bind) -> Stmt
  Stmt.VarStmt(bind)
end

func ReturnWithStmtNode(value: Expr) -> Stmt
  Stmt.ReturnWithStmt(value)
end

# --- ExprKind inspection ---------------------------------------------------

struct CallExprView
  Callee: Expr
  TypeArgs: Slice[TypeExpr]
  Args: Slice[Expr]
end

struct FieldExprView
  Receiver: Expr
  Name: String
end

struct UnaryExprView
  Operator: String
  Operand: Expr
end

struct BinaryExprView
  Operator: String
  Left: Expr
  Right: Expr
end

struct IfExprView
  Condition: Expr
  Then: Expr
  Else: Expr
end

struct SwitchExprView
  Target: Expr
  Cases: Slice[SwitchCase]
end

struct FuncLitExprView
  Params: Slice[Param]
  Ret: Option[TypeExpr]
  Body: Expr
end

struct TypeAsExprView
  Value: Expr
  Target: TypeExpr
end

struct StructLitExprView
  Name: String
  Fields: Slice[StructLitField]
end

struct GenericStructLitExprView
  Name: String
  TypeArgs: Slice[TypeExpr]
  Fields: Slice[StructLitField]
end

func ExprIsBlock(expr: Expr) -> Bool
  switch expr.Kind
    case BlockExpr(_) => true
    case _ => false
  end
end

func BlockExprNode(statements: Slice[Stmt]) -> Expr
  Expr {
    ID: 0,
    Pos: SourcePos { SourceName: "", Line: 0, Column: 0 },
    Span: SourceSpan {
      Start: SourcePos { SourceName: "", Line: 0, Column: 0 },
      End: SourcePos { SourceName: "", Line: 0, Column: 0 },
    },
    Kind: ExprKind.BlockExpr(statements),
    Type: None,
  }
end

func IdentExprNode(name: String) -> Expr
  Expr {
    ID: 0,
    Pos: SourcePos { SourceName: "", Line: 0, Column: 0 },
    Span: SourceSpan {
      Start: SourcePos { SourceName: "", Line: 0, Column: 0 },
      End: SourcePos { SourceName: "", Line: 0, Column: 0 },
    },
    Kind: ExprKind.IdentExpr(name),
    Type: None,
  }
end

func UnitExprKindNode() -> Expr
  Expr {
    ID: 0,
    Pos: SourcePos { SourceName: "", Line: 0, Column: 0 },
    Span: SourceSpan {
      Start: SourcePos { SourceName: "", Line: 0, Column: 0 },
      End: SourcePos { SourceName: "", Line: 0, Column: 0 },
    },
    Kind: ExprKind.UnitExpr,
    Type: None,
  }
end

func WithExprType(expr: Expr, typ: MonoType) -> Expr
  Expr {
    ID: expr.ID,
    Pos: expr.Pos,
    Span: expr.Span,
    Kind: expr.Kind,
    Type: Some(typ),
  }
end

func ExprBlockStatements(expr: Expr) -> Slice[Stmt]
  switch expr.Kind
    case BlockExpr(statements) => statements
    case _ => []
  end
end

func ExprIsCall(expr: Expr) -> Bool
  switch expr.Kind
    case CallExpr(_, _, _) => true
    case _ => false
  end
end

func ExprCall(expr: Expr) -> CallExprView
  switch expr.Kind
    case CallExpr(callee, typeArgs, args) =>
      CallExprView { Callee: callee, TypeArgs: typeArgs, Args: args }
    case _ =>
      CallExprView { Callee: EmptyExpr(), TypeArgs: [], Args: [] }
  end
end

func ExprIsField(expr: Expr) -> Bool
  switch expr.Kind
    case FieldExpr(_, _) => true
    case _ => false
  end
end

func ExprField(expr: Expr) -> FieldExprView
  switch expr.Kind
    case FieldExpr(receiver, name) =>
      FieldExprView { Receiver: receiver, Name: name }
    case _ =>
      FieldExprView { Receiver: EmptyExpr(), Name: "" }
  end
end

func ExprIsUnary(expr: Expr) -> Bool
  switch expr.Kind
    case UnaryExpr(_, _) => true
    case _ => false
  end
end

func ExprUnary(expr: Expr) -> UnaryExprView
  switch expr.Kind
    case UnaryExpr(operator, operand) =>
      UnaryExprView { Operator: operator, Operand: operand }
    case _ =>
      UnaryExprView { Operator: "", Operand: EmptyExpr() }
  end
end

func ExprIsBinary(expr: Expr) -> Bool
  switch expr.Kind
    case BinaryExpr(_, _, _) => true
    case _ => false
  end
end

func ExprBinary(expr: Expr) -> BinaryExprView
  switch expr.Kind
    case BinaryExpr(operator, left, right) =>
      BinaryExprView { Operator: operator, Left: left, Right: right }
    case _ =>
      BinaryExprView { Operator: "", Left: EmptyExpr(), Right: EmptyExpr() }
  end
end

func ExprIsIf(expr: Expr) -> Bool
  switch expr.Kind
    case IfExpr(_, _, _) => true
    case _ => false
  end
end

func ExprIf(expr: Expr) -> IfExprView
  switch expr.Kind
    case IfExpr(condition, thenBranch, elseBranch) =>
      IfExprView { Condition: condition, Then: thenBranch, Else: elseBranch }
    case _ =>
      IfExprView { Condition: EmptyExpr(), Then: EmptyExpr(), Else: EmptyExpr() }
  end
end

func ExprIsSwitch(expr: Expr) -> Bool
  switch expr.Kind
    case SwitchExpr(_, _, _) => true
    case _ => false
  end
end

func ExprSwitch(expr: Expr) -> SwitchExprView
  switch expr.Kind
    case SwitchExpr(target, cases, _) =>
      SwitchExprView { Target: target, Cases: cases }
    case _ =>
      SwitchExprView { Target: EmptyExpr(), Cases: [] }
  end
end

func ExprIsFuncLit(expr: Expr) -> Bool
  switch expr.Kind
    case FuncLitExpr(_, _, _) => true
    case _ => false
  end
end

func ExprFuncLit(expr: Expr) -> FuncLitExprView
  switch expr.Kind
    case FuncLitExpr(params, ret, body) =>
      FuncLitExprView { Params: params, Ret: ret, Body: body }
    case _ =>
      FuncLitExprView { Params: [], Ret: None, Body: EmptyExpr() }
  end
end

func ExprIsSliceLit(expr: Expr) -> Bool
  switch expr.Kind
    case SliceLitExpr(_) => true
    case _ => false
  end
end

func ExprSliceItems(expr: Expr) -> Slice[Expr]
  switch expr.Kind
    case SliceLitExpr(items) => items
    case _ => []
  end
end

func ExprIsTypeAs(expr: Expr) -> Bool
  switch expr.Kind
    case TypeAsExpr(_, _) => true
    case _ => false
  end
end

func ExprTypeAs(expr: Expr) -> TypeAsExprView
  switch expr.Kind
    case TypeAsExpr(value, target) =>
      TypeAsExprView { Value: value, Target: target }
    case _ =>
      TypeAsExprView { Value: EmptyExpr(), Target: UnitTypeExpr() }
  end
end

func ExprIsStructLit(expr: Expr) -> Bool
  switch expr.Kind
    case StructLitExpr(_, _) => true
    case _ => false
  end
end

func ExprStructLit(expr: Expr) -> StructLitExprView
  switch expr.Kind
    case StructLitExpr(name, fields) =>
      StructLitExprView { Name: name, Fields: fields }
    case _ =>
      StructLitExprView { Name: "", Fields: [] }
  end
end

func ExprIsGenericStructLit(expr: Expr) -> Bool
  switch expr.Kind
    case GenericStructLitExpr(_, _, _) => true
    case _ => false
  end
end

func ExprGenericStructLit(expr: Expr) -> GenericStructLitExprView
  switch expr.Kind
    case GenericStructLitExpr(name, typeArgs, fields) =>
      GenericStructLitExprView { Name: name, TypeArgs: typeArgs, Fields: fields }
    case _ =>
      GenericStructLitExprView { Name: "", TypeArgs: [], Fields: [] }
  end
end

func ExprIsNumber(expr: Expr) -> Bool
  switch expr.Kind
    case NumberExpr(_) => true
    case _ => false
  end
end

func ExprNumberLiteral(expr: Expr) -> String
  switch expr.Kind
    case NumberExpr(value) => value
    case _ => ""
  end
end

func ExprIsString(expr: Expr) -> Bool
  switch expr.Kind
    case StringExpr(_) => true
    case _ => false
  end
end

func ExprStringLiteral(expr: Expr) -> String
  switch expr.Kind
    case StringExpr(value) => value
    case _ => ""
  end
end

func ExprIsRune(expr: Expr) -> Bool
  switch expr.Kind
    case RuneExpr(_) => true
    case _ => false
  end
end

func ExprRuneLiteral(expr: Expr) -> String
  switch expr.Kind
    case RuneExpr(value) => value
    case _ => ""
  end
end

# --- Stmt inspection -------------------------------------------------------

func StmtIsExpr(statement: Stmt) -> Bool
  switch statement
    case ExprStmt(_) => true
    case _ => false
  end
end

func StmtExpr(statement: Stmt) -> Expr
  switch statement
    case ExprStmt(expr) => expr
    case _ => EmptyExpr()
  end
end

func StmtIsLet(statement: Stmt) -> Bool
  switch statement
    case LetStmt(_) => true
    case _ => false
  end
end

func StmtLetBind(statement: Stmt) -> Bind
  switch statement
    case LetStmt(bind) => bind
    case _ =>
      Bind {
        Name: "",
        Type: None,
        TypeSpan: None,
        Value: EmptyExpr(),
        Span: SourceSpan {
          Start: SourcePos { SourceName: "", Line: 0, Column: 0 },
          End: SourcePos { SourceName: "", Line: 0, Column: 0 },
        },
      }
  end
end

func StmtIsLetRec(statement: Stmt) -> Bool
  switch statement
    case LetRecStmt(_) => true
    case _ => false
  end
end

func StmtLetRecBindings(statement: Stmt) -> Slice[LetRecBind]
  switch statement
    case LetRecStmt(bindings) => bindings
    case _ => []
  end
end

func StmtIsTupleLet(statement: Stmt) -> Bool
  switch statement
    case TupleLetStmt(_, _) => true
    case _ => false
  end
end

func StmtTupleLetPattern(statement: Stmt) -> Pattern
  switch statement
    case TupleLetStmt(pattern, _) => pattern
    case _ => Pattern.WildcardPattern
  end
end

func StmtTupleLetValue(statement: Stmt) -> Expr
  switch statement
    case TupleLetStmt(_, value) => value
    case _ => EmptyExpr()
  end
end

func StmtIsVar(statement: Stmt) -> Bool
  switch statement
    case VarStmt(_) => true
    case _ => false
  end
end

func StmtVarBind(statement: Stmt) -> Bind
  switch statement
    case VarStmt(bind) => bind
    case _ =>
      Bind {
        Name: "",
        Type: None,
        TypeSpan: None,
        Value: EmptyExpr(),
        Span: SourceSpan {
          Start: SourcePos { SourceName: "", Line: 0, Column: 0 },
          End: SourcePos { SourceName: "", Line: 0, Column: 0 },
        },
      }
  end
end

func StmtIsWhile(statement: Stmt) -> Bool
  switch statement
    case WhileStmt(_, _) => true
    case _ => false
  end
end

func StmtWhileCondition(statement: Stmt) -> Expr
  switch statement
    case WhileStmt(condition, _) => condition
    case _ => EmptyExpr()
  end
end

func StmtWhileBody(statement: Stmt) -> Expr
  switch statement
    case WhileStmt(_, body) => body
    case _ => EmptyExpr()
  end
end

func StmtIsAssign(statement: Stmt) -> Bool
  switch statement
    case AssignStmt(_, _) => true
    case _ => false
  end
end

func StmtAssignTarget(statement: Stmt) -> Expr
  switch statement
    case AssignStmt(target, _) => target
    case _ => EmptyExpr()
  end
end

func StmtAssignValue(statement: Stmt) -> Expr
  switch statement
    case AssignStmt(_, value) => value
    case _ => EmptyExpr()
  end
end

func StmtIsReturn(statement: Stmt) -> Bool
  switch statement
    case ReturnStmt => true
    case _ => false
  end
end

func StmtIsReturnWith(statement: Stmt) -> Bool
  switch statement
    case ReturnWithStmt(_) => true
    case _ => false
  end
end

func StmtReturnValue(statement: Stmt) -> Expr
  switch statement
    case ReturnWithStmt(value) => value
    case _ => EmptyExpr()
  end
end

# --- Pattern inspection ----------------------------------------------------

struct VariantPatternView
  Name: String
  Items: Slice[Pattern]
end

struct StructVariantPatternView
  Name: String
  Fields: Slice[StructPatternField]
end

func PatternIsBind(pattern: Pattern) -> Bool
  switch pattern
    case BindPattern(_) => true
    case _ => false
  end
end

func PatternBindName(pattern: Pattern) -> String
  switch pattern
    case BindPattern(name) => name
    case _ => ""
  end
end

func PatternIsVariant(pattern: Pattern) -> Bool
  switch pattern
    case VariantPattern(_, _) => true
    case _ => false
  end
end

func PatternVariant(pattern: Pattern) -> VariantPatternView
  switch pattern
    case VariantPattern(name, items) =>
      VariantPatternView { Name: name, Items: items }
    case _ =>
      VariantPatternView { Name: "", Items: [] }
  end
end

func PatternIsStructVariant(pattern: Pattern) -> Bool
  switch pattern
    case StructVariantPattern(_, _) => true
    case _ => false
  end
end

func PatternStructVariant(pattern: Pattern) -> StructVariantPatternView
  switch pattern
    case StructVariantPattern(name, fields) =>
      StructVariantPatternView { Name: name, Fields: fields }
    case _ =>
      StructVariantPatternView { Name: "", Fields: [] }
  end
end

func PatternIsTuple(pattern: Pattern) -> Bool
  switch pattern
    case TuplePattern(_) => true
    case _ => false
  end
end

func PatternTupleItems(pattern: Pattern) -> Slice[Pattern]
  switch pattern
    case TuplePattern(items) => items
    case _ => []
  end
end

func PatternIsLiteral(pattern: Pattern) -> Bool
  switch pattern
    case LiteralPattern(_, _) => true
    case _ => false
  end
end

func PatternLiteralKind(pattern: Pattern) -> String
  switch pattern
    case LiteralPattern(kind, _) => kind
    case _ => ""
  end
end

func PatternLiteralValue(pattern: Pattern) -> String
  switch pattern
    case LiteralPattern(_, value) => value
    case _ => ""
  end
end

func PatternIsWildcard(pattern: Pattern) -> Bool
  switch pattern
    case WildcardPattern => true
    case _ => false
  end
end

# --- Expr construction and inspection --------------------------------------

func UnitExprNode() -> Expr
  EmptyExpr()
end

func InlineGoExprNode(
  typ: TypeExpr,
  code: String,
  operands: Slice[GoOperand],
  typeOperands: Slice[GoTypeOperand]
) -> Expr
  let pos = SourcePos { SourceName: "", Line: 0, Column: 0 }
  Expr {
    ID: 0,
    Pos: pos,
    Span: SourceSpan { Start: pos, End: pos },
    Kind: ExprKind.InlineGoExpr(Ref.new(typ), code, operands, typeOperands),
    Type: None,
  }
end

func ExprIsIdent(expr: Expr) -> Bool
  switch expr.Kind
    case IdentExpr(_) => true
    case _ => false
  end
end

func ExprIdentName(expr: Expr) -> String
  switch expr.Kind
    case IdentExpr(name) => name
    case _ => ""
  end
end

func ExprIsInlineGo(expr: Expr) -> Bool
  switch expr.Kind
    case InlineGoExpr(_, _, _, _) => true
    case _ => false
  end
end

func ExprInlineGoType(expr: Expr) -> TypeExpr
  switch expr.Kind
    case InlineGoExpr(typ, _, _, _) => typ.value()
    case _ => TypeExpr.UnitType
  end
end

func ExprInlineGoCode(expr: Expr) -> String
  switch expr.Kind
    case InlineGoExpr(_, code, _, _) => code
    case _ => ""
  end
end

func ExprInlineGoOperands(expr: Expr) -> Slice[GoOperand]
  switch expr.Kind
    case InlineGoExpr(_, _, operands, _) => operands
    case _ => []
  end
end

func ExprInlineGoTypeOperands(expr: Expr) -> Slice[GoTypeOperand]
  switch expr.Kind
    case InlineGoExpr(_, _, _, typeOperands) => typeOperands
    case _ => []
  end
end

# --- Decl construction -----------------------------------------------------

func ImportDeclNode(alias: String, path: String) -> Decl
  Decl.ImportDecl(alias, path)
end

func LetDeclNode(bind: Bind) -> Decl
  Decl.LetDecl(bind)
end

func VarDeclNode(bind: Bind) -> Decl
  Decl.VarDecl(bind)
end

func StructDeclNode(name: String, typeParams: Slice[String], fields: Slice[Field]) -> Decl
  Decl.StructDecl(name, typeParams, fields)
end

func EnumDeclNode(name: String, typeParams: Slice[String], variants: Slice[Variant]) -> Decl
  Decl.EnumDecl(name, typeParams, variants)
end

func TypeDeclNode(name: String, typeParams: Slice[String], target: TypeExpr) -> Decl
  Decl.TypeDecl(name, typeParams, target)
end

func TypeAliasDeclNode(name: String, typeParams: Slice[String], target: TypeExpr) -> Decl
  Decl.TypeAliasDecl(name, typeParams, target)
end

func FuncDeclNode(
  name: String,
  typeParams: Slice[String],
  params: Slice[Param],
  ret: Option[TypeExpr],
  body: Expr,
  using: Slice[Constraint]
) -> Decl
  Decl.FuncDecl(name, typeParams, params, ret, body, using)
end

func InterfaceDeclNode(
  name: String,
  typeParams: Slice[String],
  methods: Slice[FuncSig]
) -> Decl
  Decl.InterfaceDecl(name, typeParams, methods)
end

func ImplDeclNode(
  typeParams: Slice[String],
  target: TypeExpr,
  iface: Option[TypeExpr],
  methods: Slice[ImplMethod]
) -> Decl
  Decl.ImplDecl(typeParams, target, iface, methods)
end

# --- Decl inspection -------------------------------------------------------

func DeclIsImport(decl: Decl) -> Bool
  switch decl
    case ImportDecl(_, _) => true
    case _ => false
  end
end

func DeclImportAlias(decl: Decl) -> String
  switch decl
    case ImportDecl(alias, _) => alias
    case _ => ""
  end
end

func DeclImportPath(decl: Decl) -> String
  switch decl
    case ImportDecl(_, path) => path
    case _ => ""
  end
end

func DeclIsLet(decl: Decl) -> Bool
  switch decl
    case LetDecl(_) => true
    case _ => false
  end
end

func DeclLetBind(decl: Decl) -> Bind
  switch decl
    case LetDecl(bind) => bind
    case _ =>
      Bind {
        Name: "",
        Type: None,
        TypeSpan: None,
        Value: EmptyExpr(),
        Span: SourceSpan {
          Start: SourcePos { SourceName: "", Line: 0, Column: 0 },
          End: SourcePos { SourceName: "", Line: 0, Column: 0 },
        },
      }
  end
end

func DeclIsVar(decl: Decl) -> Bool
  switch decl
    case VarDecl(_) => true
    case _ => false
  end
end

func DeclVarBind(decl: Decl) -> Bind
  switch decl
    case VarDecl(bind) => bind
    case _ =>
      Bind {
        Name: "",
        Type: None,
        TypeSpan: None,
        Value: EmptyExpr(),
        Span: SourceSpan {
          Start: SourcePos { SourceName: "", Line: 0, Column: 0 },
          End: SourcePos { SourceName: "", Line: 0, Column: 0 },
        },
      }
  end
end

func DeclIsType(decl: Decl) -> Bool
  switch decl
    case TypeDecl(_, _, _) => true
    case _ => false
  end
end

func DeclTypeName(decl: Decl) -> String
  switch decl
    case TypeDecl(name, _, _) => name
    case _ => ""
  end
end

func DeclTypeParams(decl: Decl) -> Slice[String]
  switch decl
    case TypeDecl(_, typeParams, _) => typeParams
    case _ => []
  end
end

func DeclTypeTarget(decl: Decl) -> TypeExpr
  switch decl
    case TypeDecl(_, _, target) => target
    case _ => TypeExpr.UnitType
  end
end

func DeclIsTypeAlias(decl: Decl) -> Bool
  switch decl
    case TypeAliasDecl(_, _, _) => true
    case _ => false
  end
end

func DeclTypeAliasName(decl: Decl) -> String
  switch decl
    case TypeAliasDecl(name, _, _) => name
    case _ => ""
  end
end

func DeclTypeAliasParams(decl: Decl) -> Slice[String]
  switch decl
    case TypeAliasDecl(_, typeParams, _) => typeParams
    case _ => []
  end
end

func DeclTypeAliasTarget(decl: Decl) -> TypeExpr
  switch decl
    case TypeAliasDecl(_, _, target) => target
    case _ => TypeExpr.UnitType
  end
end

func DeclIsStruct(decl: Decl) -> Bool
  switch decl
    case StructDecl(_, _, _) => true
    case _ => false
  end
end

func DeclStructName(decl: Decl) -> String
  switch decl
    case StructDecl(name, _, _) => name
    case _ => ""
  end
end

func DeclStructParams(decl: Decl) -> Slice[String]
  switch decl
    case StructDecl(_, typeParams, _) => typeParams
    case _ => []
  end
end

func DeclStructFields(decl: Decl) -> Slice[Field]
  switch decl
    case StructDecl(_, _, fields) => fields
    case _ => []
  end
end

func DeclIsEnum(decl: Decl) -> Bool
  switch decl
    case EnumDecl(_, _, _) => true
    case _ => false
  end
end

func DeclEnumName(decl: Decl) -> String
  switch decl
    case EnumDecl(name, _, _) => name
    case _ => ""
  end
end

func DeclEnumParams(decl: Decl) -> Slice[String]
  switch decl
    case EnumDecl(_, typeParams, _) => typeParams
    case _ => []
  end
end

func DeclEnumVariants(decl: Decl) -> Slice[Variant]
  switch decl
    case EnumDecl(_, _, variants) => variants
    case _ => []
  end
end

func DeclIsFunc(decl: Decl) -> Bool
  switch decl
    case FuncDecl(_, _, _, _, _, _) => true
    case _ => false
  end
end

func DeclFuncName(decl: Decl) -> String
  switch decl
    case FuncDecl(name, _, _, _, _, _) => name
    case _ => ""
  end
end

func DeclFuncParams(decl: Decl) -> Slice[String]
  switch decl
    case FuncDecl(_, typeParams, _, _, _, _) => typeParams
    case _ => []
  end
end

func DeclFuncArguments(decl: Decl) -> Slice[Param]
  switch decl
    case FuncDecl(_, _, params, _, _, _) => params
    case _ => []
  end
end

func DeclFuncHasResult(decl: Decl) -> Bool
  switch decl
    case FuncDecl(_, _, _, ret, _, _) then
      switch ret
        case Some(_) => true
        case None => false
      end
    end
    case _ => false
  end
end

func DeclFuncResult(decl: Decl) -> TypeExpr
  switch decl
    case FuncDecl(_, _, _, ret, _, _) then
      switch ret
        case Some(typ) => typ
        case None => TypeExpr.UnitType
      end
    end
    case _ => TypeExpr.UnitType
  end
end

func DeclFuncResultOption(decl: Decl) -> Option[TypeExpr]
  switch decl
    case FuncDecl(_, _, _, ret, _, _) => ret
    case _ => None
  end
end

func DeclFuncBody(decl: Decl) -> Expr
  switch decl
    case FuncDecl(_, _, _, _, body, _) => body
    case _ => EmptyExpr()
  end
end

func DeclFuncUsing(decl: Decl) -> Slice[Constraint]
  switch decl
    case FuncDecl(_, _, _, _, _, constraints) => constraints
    case _ => []
  end
end

func DeclIsInterface(decl: Decl) -> Bool
  switch decl
    case InterfaceDecl(_, _, _) => true
    case _ => false
  end
end

func DeclInterfaceName(decl: Decl) -> String
  switch decl
    case InterfaceDecl(name, _, _) => name
    case _ => ""
  end
end

func DeclInterfaceParams(decl: Decl) -> Slice[String]
  switch decl
    case InterfaceDecl(_, typeParams, _) => typeParams
    case _ => []
  end
end

func DeclInterfaceMethods(decl: Decl) -> Slice[FuncSig]
  switch decl
    case InterfaceDecl(_, _, methods) => methods
    case _ => []
  end
end

func DeclIsImpl(decl: Decl) -> Bool
  switch decl
    case ImplDecl(_, _, _, _) => true
    case _ => false
  end
end

func DeclImplParams(decl: Decl) -> Slice[String]
  switch decl
    case ImplDecl(typeParams, _, _, _) => typeParams
    case _ => []
  end
end

func DeclImplTarget(decl: Decl) -> TypeExpr
  switch decl
    case ImplDecl(_, target, _, _) => target
    case _ => TypeExpr.UnitType
  end
end

func DeclImplHasInterface(decl: Decl) -> Bool
  switch decl
    case ImplDecl(_, _, iface, _) then
      switch iface
        case Some(_) => true
        case None => false
      end
    end
    case _ => false
  end
end

func DeclImplInterfaceOption(decl: Decl) -> Option[TypeExpr]
  switch decl
    case ImplDecl(_, _, iface, _) => iface
    case _ => None
  end
end

func DeclImplInterface(decl: Decl) -> TypeExpr
  switch decl
    case ImplDecl(_, _, iface, _) then
      switch iface
        case Some(typ) => typ
        case None => TypeExpr.UnitType
      end
    end
    case _ => TypeExpr.UnitType
  end
end

func DeclImplMethods(decl: Decl) -> Slice[ImplMethod]
  switch decl
    case ImplDecl(_, _, _, methods) => methods
    case _ => []
  end
end
