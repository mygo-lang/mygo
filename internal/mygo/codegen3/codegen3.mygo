package codegen3
# codegen3 is the first IR-based Go backend slice. It covers function/value
# declarations, literals, let/var, assignment, if, while, return/break/continue,
# and direct/closured/method calls. Type declarations and pattern matching are
# owned by later tasks; unsupported nodes are reported rather than emitted.

import ir3 "github.com/mygo-lang/mygo/internal/mygo/ir3"
import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import goast "go:github.com/mygo-lang/mygo/internal/mygo/codegen2/goast"
import strconv "go:strconv"
import strings "go:strings"
# Cross-package code generation needs to know which imported packages were
# themselves generated by codegen3. Those packages expose canonical tagged
# enums; all others still use the legacy interface representation. Generation
# handles one package at a time, so the active metadata is set at entry.
var activeCanonicalPackages: Slice[String] = []
var activeCanonicalAliases: Slice[String] = []

func setCanonicalPackages(pkg: ir3.Package) -> ()
  # Loop labels are per generated file, so reset the counter at entry.
  resetLoopLabels()
  # Pitch the tagged-case context too: it must never leak across files.
  activeTaggedSubject = ""
  activeTaggedVariant = ""
  # The package being emitted is canonical even before its files exist in the
  # overlay, including when it declares the prelude's own Option and Result.
  activeCanonicalPackages = pkg.CanonicalPackages.Append(pkg.ImportPath)
  activeCanonicalAliases = canonicalAliases(pkg.Imports, activeCanonicalPackages, 0, [])
  # The `Option[Ref[T]] -> *T` layout is only valid when the package declaring
  # Option is itself canonical; a legacy prelude keeps its interface shape.
  ir3.SetCanonicalOptionRepresentation(isCanonicalImportPath(preludeImportPath()))
  ir3.SetGoImports(goImportPaths(pkg.Imports, 0, []))
end

func goImportPaths(imports: Slice[ir3.ImportSpec], index: Int, out: Slice[String]) -> Slice[String]
  if index >= imports.Len() then
    out
  else
    switch imports.Get(index)
      case Some(item) then
        if isGoImport(item.Path) then
          goImportPaths(imports, index + 1, out.Append(goImportPath(item.Path)))
        else
          goImportPaths(imports, index + 1, out)
        end
      end
      case None => goImportPaths(imports, index + 1, out)
    end
  end
end

func canonicalAliases(
  imports: Slice[ir3.ImportSpec],
  packages: Slice[String],
  index: Int,
  out: Slice[String]
) -> Slice[String]
  if index >= imports.Len() then
    out
  else
    switch imports.Get(index)
      case Some(item) then
        if !isGoImport(item.Path) && packages.Contains(item.Path) then
          canonicalAliases(
            imports,
            packages,
            index + 1,
            appendUniqueAlias(out, effectiveImportAlias(item))
          )
        else
          canonicalAliases(imports, packages, index + 1, out)
        end
      end
      case None => canonicalAliases(imports, packages, index + 1, out)
    end
  end
end

func appendUniqueAlias(aliases: Slice[String], alias: String) -> Slice[String]
  if aliases.Contains(alias) then
    aliases
  else
    aliases.Append(alias)
  end
end

func isCanonicalImportPath(path: String) -> Bool
  activeCanonicalPackages.Contains(path)
end

func isCanonicalAlias(alias: String) -> Bool
  activeCanonicalAliases.Contains(alias)
end

# A generated file only imports the prelude because MyGO code in the package
# depends on it. The prelude package itself owns Option/Result/List and their
# constructors, so it never imports itself.
func pkgIsPrelude(pkg: ir3.Package) -> Bool
  pkg.ImportPath == preludeImportPath()
end

func GenerateFiles(pkg: ir3.Package) -> Result[Map[String, String], String]
  setCanonicalPackages(pkg)
  refreshGenericReturnFunctions(pkg.Decls)
  let paths = declarationPaths(pkg.Decls, 0, [])
  generateFilesAt(pkg, paths, 0, {})
end

func GenerateFile(pkg: ir3.Package, path: String) -> Result[String, String]
  setCanonicalPackages(pkg)
  refreshGenericReturnFunctions(pkg.Decls)
  # Qualified types must use the alias this file imports, not the path base.
  ir3.SetGoImportAliases(fileImportAliases(pkg.Imports, path, 0, {}))
  let decls = filterDeclsByPath(pkg.Decls, path, 0, [])
  switch lowerGoDecls(decls, pkg.TypeShapes, pkg.InterfaceTypes, 0, [])
    case Ok(baseDecls) then
      let goDecls = appendInterfaceWrappers(pkg.InterfaceTypes, pkg.Decls, path, 0, baseDecls)
      let aliases = goast.ReferencedImportAliases(goDecls)
      # Types inferred from another package's signature can make the generated
      # file reference an alias it never imported itself; the package-wide
      # import list supplies it.
      let imports = appendInferredImports(
        pkg.Imports,
        aliases,
        0,
        goImportsForFile(pkg.Imports, path, aliases, 0, [])
      )
      # The prelude defines Option/Result and their constructors itself. Its own
      # references to those names are local, so the implicit prelude import must
      # never be added there (it would be a self-import cycle).
      let withPrelude = if pkgIsPrelude(pkg) then
        imports
      elsif goast.NeedsPreludeImportWithHelpers(
        goDecls,
        localHelperNames(pkg.Decls, 0, [])
      ) then
        imports.Append(goast.Import {
          Alias: ".",
          Path: preludeImportPath(),
        })
      else
        imports
      end
      switch goast.RenderWithLegacy(pkg.Name, withPrelude, goDecls, [])
        case Ok(source) then
          let origins = goast.NewOrigins()
          if goDecls.Len() == decls.Len() then
            markDeclOrigins(origins, decls, goDecls, 0)
          end
          let finalized = goast.ApplyLineDirectives(
            origins,
            source,
            goDecls,
            path,
            generatedName(path)
          )
          if finalized.Failure != "" then
            Err("codegen3 line directives: " + finalized.Failure + "\n" + source)
          else
            Ok(finalized.Source)
          end
        end
        case Err(error) => Err("codegen3 render: " + error.Error())
      end
    end
    case Err(message) => Err(message)
  end
end

# Only Go imports that the generated file actually references survive. Dot and
# blank imports are preserved because their effect is not an identifier use.
func appendInferredImports(
  imports: Slice[ir3.ImportSpec],
  aliases: Slice[String],
  index: Int,
  out: Slice[goast.Import]
) -> Slice[goast.Import]
  if index >= imports.Len() then
    out
  else
    switch imports.Get(index)
      case Some(item) then
        let alias = effectiveImportAlias(item)
        if alias != "" &&
          alias != "." &&
          alias != "_" &&
          aliases.Contains(alias) &&
          !hasGoImportAlias(out, alias, 0) then
          appendInferredImports(
            imports,
            aliases,
            index + 1,
            out.Append(goast.Import {
              Alias: importAliasFor(item),
              Path: importPathFor(item),
            })
          )
        else
          appendInferredImports(imports, aliases, index + 1, out)
        end
      end
      case None => appendInferredImports(imports, aliases, index + 1, out)
    end
  end
end

func hasGoImportAlias(imports: Slice[goast.Import], alias: String, index: Int) -> Bool
  if index >= imports.Len() then
    false
  else
    switch imports.Get(index)
      case Some(item) then
        let current = if item.Alias == "" then
          goPathBase(item.Path)
        else
          item.Alias
        end
        if current == alias then
          true
        else
          hasGoImportAlias(imports, alias, index + 1)
        end
      end
      case None => hasGoImportAlias(imports, alias, index + 1)
    end
  end
end

func goImportsForFile(
  imports: Slice[ir3.ImportSpec],
  path: String,
  aliases: Slice[String],
  index: Int,
  out: Slice[goast.Import]
) -> Slice[goast.Import]
  if index >= imports.Len() then
    out
  else
    switch imports.Get(index)
      case Some(item) then
        if item.File == path && keepImport(item, aliases) then
          goImportsForFile(
            imports,
            path,
            aliases,
            index + 1,
            out.Append(goast.Import {
              Alias: importAliasFor(item),
              Path: importPathFor(item),
            })
          )
        else
          goImportsForFile(imports, path, aliases, index + 1, out)
        end
      end
      case None => goImportsForFile(imports, path, aliases, index + 1, out)
    end
  end
end

# The import aliases declared by one source file, keyed by import path.
func fileImportAliases(
  imports: Slice[ir3.ImportSpec],
  path: String,
  index: Int,
  out: Map[String, String]
) -> Map[String, String]
  if index >= imports.Len() then
    out
  else
    switch imports.Get(index)
      case Some(item) then
        if item.File == path && item.Alias != "" && item.Alias != "." && item.Alias != "_" then
          out.Set(importPathFor(item), item.Alias)
          fileImportAliases(imports, path, index + 1, out)
        else
          fileImportAliases(imports, path, index + 1, out)
        end
      end
      case None => fileImportAliases(imports, path, index + 1, out)
    end
  end
end

func isGoImport(path: String) -> Bool
  strings.HasPrefix(path, "go:")
end

func goImportPath(path: String) -> String
  strings.TrimPrefix(path, "go:")
end

func effectiveImportAlias(item: ir3.ImportSpec) -> String
  if item.Alias == "" then
    goPathBase(goImportPath(item.Path))
  else
    item.Alias
  end
end

# Both `go:` imports and ordinary MyGO package imports become Go imports when
# the generated file references their alias. MyGO packages compile to Go
# packages under the same canonical path, so the path is used unchanged.
func keepImport(item: ir3.ImportSpec, aliases: Slice[String]) -> Bool
  if isGoImport(item.Path) then
    importAliasReferenced(item, aliases)
  else
    let alias = effectiveImportAlias(item)
    alias == "." || alias == "_" || importAliasReferenced(item, aliases)
  end
end

func importPathFor(item: ir3.ImportSpec) -> String
  if isGoImport(item.Path) then
    goImportPath(item.Path)
  else
    item.Path
  end
end

func importAliasFor(item: ir3.ImportSpec) -> String
  if isGoImport(item.Path) then
    goImportAlias(item)
  else
    item.Alias
  end
end

func goImportAlias(item: ir3.ImportSpec) -> String
  let alias = effectiveImportAlias(item)
  if alias == goPathBase(goImportPath(item.Path)) then
    ""
  else
    alias
  end
end

func importAliasReferenced(item: ir3.ImportSpec, aliases: Slice[String]) -> Bool
  let alias = effectiveImportAlias(item)
  if alias == "." || alias == "_" then
    true
  else
    aliases.Contains(alias)
  end
end

func goPathBase(path: String) -> String
  let parts = strings.Split(path, "/")
  switch parts.Get(parts.Len() - 1)
    case Some(base) => base
    case None => path
  end
end

func markDeclOrigins(
  origins: Ref[goast.Origins],
  decls: Slice[ir3.Decl],
  goDecls: Slice[goast.Decl],
  index: Int
) -> ()
  if index >= decls.Len() then
    ()
  else
    switch decls.Get(index)
      case Some(decl) then
        switch goDecls.Get(index)
          case Some(goDecl) then
            goast.MarkDeclAt(origins, goDecl, decl.Pos.SourceName, decl.Pos.Line, decl.Pos.Column)
            markDeclOrigins(origins, decls, goDecls, index + 1)
          end
          case None => markDeclOrigins(origins, decls, goDecls, index + 1)
        end
      end
      case None => markDeclOrigins(origins, decls, goDecls, index + 1)
    end
  end
end

func declarationPaths(decls: Slice[ir3.Decl], index: Int, out: Slice[String]) -> Slice[String]
  if index >= decls.Len() then
    out
  else
    switch decls.Get(index)
      case Some(decl) => declarationPaths(decls, index + 1, appendPath(out, decl.Path))
      case None => declarationPaths(decls, index + 1, out)
    end
  end
end

func appendPath(paths: Slice[String], path: String) -> Slice[String]
  if paths.Contains(path) then
    paths
  else
    paths.Append(path)
  end
end

func filterDeclsByPath(
  decls: Slice[ir3.Decl],
  path: String,
  index: Int,
  out: Slice[ir3.Decl]
) -> Slice[ir3.Decl]
  if index >= decls.Len() then
    out
  else
    switch decls.Get(index)
      case Some(decl) then
        if decl.Path == path then
          filterDeclsByPath(decls, path, index + 1, out.Append(decl))
        else
          filterDeclsByPath(decls, path, index + 1, out)
        end
      end
      case None => filterDeclsByPath(decls, path, index + 1, out)
    end
  end
end

func generateFilesAt(
  pkg: ir3.Package,
  paths: Slice[String],
  index: Int,
  out: Map[String, String]
) -> Result[Map[String, String], String]
  if index >= paths.Len() then
    Ok(out)
  else
    switch paths.Get(index)
      case Some(path) then
        switch GenerateFile(pkg, path)
          case Ok(source) then
            out.Set(generatedName(path), source)
            generateFilesAt(pkg, paths, index + 1, out)
          end
          # Attribute a per-file failure to its source file: lowering diagnostics
          # do not always carry a source position once expressions are synthetic.
          case Err(message) => Err(path + ": " + message)
        end
      end
      case None => generateFilesAt(pkg, paths, index + 1, out)
    end
  end
end

# `foo_test.mygo` belongs to the package's test scope, so its Go file must be
# `_test.go`-suffixed; otherwise `go build` compiles test-only declarations and
# helpers from hand-written test files are missing.
func generatedName(path: String) -> String
  let base = strings.TrimSuffix(pathBase(path), ".mygo")
  if strings.HasSuffix(base, "_test") then
    "zz_" + strings.TrimSuffix(base, "_test") + ".gen_test.go"
  else
    "zz_" + base + ".gen.go"
  end
end

func pathBase(path: String) -> String
  let parts = strings.Split(path, "/")
  switch parts.Get(parts.Len() - 1)
    case Some(base) => base
    case None => path
  end
end

func lowerGoDecls(
  decls: Slice[ir3.Decl],
  shapes: Map[String, ir3.TypeShape],
  interfaces: Slice[String],
  index: Int,
  out: Slice[goast.Decl]
) -> Result[Slice[goast.Decl], String]
  if index >= decls.Len() then
    Ok(out)
  else
    switch decls.Get(index)
      case Some(decl) then
        switch lowerGoDecl(decl, shapes, interfaces)
          case Ok(items) then
            lowerGoDecls(decls, shapes, interfaces, index + 1, appendGoDecls(out, items, 0))
          end
          # Name the declaration: backend diagnostics raised below it carry no
          # source position of their own.
          case Err(message) => Err(decl.Name + ": " + message)
        end
      end
      case None => lowerGoDecls(decls, shapes, interfaces, index + 1, out)
    end
  end
end

# Dynamic typeclass value wrappers are package-level declarations, so exactly one
# generated file may emit them. Ownership follows the interface declaration's
# own file; emitting them per file would redeclare the same Go types.
func appendInterfaceWrappers(
  interfaces: Slice[String],
  decls: Slice[ir3.Decl],
  path: String,
  index: Int,
  out: Slice[goast.Decl]
) -> Slice[goast.Decl]
  if index >= interfaces.Len() then
    out
  else
    switch interfaces.Get(index)
      case Some(name) then
        if interfaceDeclaredIn(decls, name, path, 0) then
          appendInterfaceWrappers(
            interfaces,
            decls,
            path,
            index + 1,
            appendGoDecls(out, goast.DynamicValueDecls("MygoDynamic" + name), 0)
          )
        else
          appendInterfaceWrappers(interfaces, decls, path, index + 1, out)
        end
      end
      case None => appendInterfaceWrappers(interfaces, decls, path, index + 1, out)
    end
  end
end

# `InterfaceTypes` only ever lists source interface names, and a package cannot
# declare another value or type under the same name, so name plus owning file
# identifies the declaration.
func interfaceDeclaredIn(decls: Slice[ir3.Decl], name: String, path: String, index: Int) -> Bool
  if index >= decls.Len() then
    false
  else
    switch decls.Get(index)
      case Some(decl) then
        if decl.Path == path && decl.Name == name then
          true
        else
          interfaceDeclaredIn(decls, name, path, index + 1)
        end
      end
      case None => interfaceDeclaredIn(decls, name, path, index + 1)
    end
  end
end

func appendGoDecls(
  out: Slice[goast.Decl],
  items: Slice[goast.Decl],
  index: Int
) -> Slice[goast.Decl]
  if index >= items.Len() then
    out
  else
    switch items.Get(index)
      case Some(item) => appendGoDecls(out.Append(item), items, index + 1)
      case None => appendGoDecls(out, items, index + 1)
    end
  end
end

func lowerGoDecl(
  decl: ir3.Decl,
  shapes: Map[String, ir3.TypeShape],
  interfaces: Slice[String]
) -> Result[Slice[goast.Decl], String]
  switch decl.Kind
    case FunctionDecl(typeParams, params, results, body) then
      # Inferred expression types can mention the function's own parameters.
      ir3.SetGoTypeParams(typeParams)
      # `names` keeps the IR spelling for body bookkeeping (hoists, self-tail
      # temporaries); `goNames` is the escaped Go signature.
      let names = paramNames(params, 0, [])
      let goNames = goParamNames(params, 0, [])
      let types = paramTypes(params, 0, [])
      let returns = goReturnTypes(results, 0, [])
      switch functionBodyStmtsFunction(decl.Name, names, body)
        case Ok(stmts) then
          Ok([goast.ConstrainMapKeyParams(goast.MustFuncDeclFromStmtsMulti(
            localGoName(decl.Name),
            typeParams,
            goNames,
            types,
            returns,
            stmts,
            false
          ))])
        end
        case Err(message) => Err(message)
      end
    end
    case ValueDecl(annotation, body) then
      ir3.SetGoTypeParams([])
      switch annotation
        case Some(typ) then
          switch goExpr(body)
            case Ok(value) then
              Ok([goast.PackageVarDecl(localGoName(decl.Name), goast.TypeName(ir3.GoTypeString(typ, [])), value)])
            end
            case Err(message) => Err(message)
          end
        end
        case None => Err("codegen3 requires a type annotation for package value declarations")
      end
    end
    case ImplDecl(data) => implDeclGo(data)
    case TypeDecl(typeParams, repr) then
      if interfaces.Contains(decl.Name) then
        Ok([])
      else
        switch typeDeclGo(decl.Name, typeParams, repr, shapes)
          case Ok(item) then
            switch shapes.Get(decl.Name)
              case Some(EnumShape(variants)) then
                Ok(([item] as Slice[goast.Decl]).Concat(enumCtorDecls(decl.Name, typeParams, variants, isRecursiveRepr(repr))))
              end
              case _ => Ok([item])
            end
          end
          case Err(message) => Err(message)
        end
      end
    end
    case ExternalDecl(params, results) => Err("codegen3 does not emit external declarations")
  end
end

func isInterfaceRepr(repr: Option[ir3.Repr]) -> Bool
  switch repr
    case Some(value) => isInterfaceReprValue(value)
    case None => false
  end
end

func isInterfaceReprValue(value: ir3.Repr) -> Bool
  switch value
    case ir3.Repr.InterfaceRepr(_) => true
    case _ => false
  end
end

func paramNames(params: Slice[ir3.Param], index: Int, out: Slice[String]) -> Slice[String]
  if index >= params.Len() then
    out
  else
    switch params.Get(index)
      case Some(param) => paramNames(params, index + 1, out.Append(param.Name))
      case None => paramNames(params, index + 1, out)
    end
  end
end

# goParamNames escapes keyword-shaped parameter names for the Go signature.
func goParamNames(params: Slice[ir3.Param], index: Int, out: Slice[String]) -> Slice[String]
  if index >= params.Len() then
    out
  else
    switch params.Get(index)
      case Some(param) => goParamNames(params, index + 1, out.Append(localGoName(param.Name)))
      case None => goParamNames(params, index + 1, out)
    end
  end
end

func paramTypes(params: Slice[ir3.Param], index: Int, out: Slice[String]) -> Slice[String]
  if index >= params.Len() then
    out
  else
    switch params.Get(index)
      case Some(param) then
        paramTypes(params, index + 1, out.Append(ir3.GoTypeString(param.Type, [])))
      end
      case None => paramTypes(params, index + 1, out)
    end
  end
end

func goReturnTypes(results: Slice[ast2.MonoType], index: Int, out: Slice[String]) -> Slice[String]
  if index >= results.Len() then
    out
  else
    switch results.Get(index)
      case Some(result) then
        if isUnitMono(result) then
          goReturnTypes(results, index + 1, out)
        else
          goReturnTypes(results, index + 1, out.Append(ir3.GoTypeString(result, [])))
        end
      end
      case None => goReturnTypes(results, index + 1, out)
    end
  end
end

func goTypeArgs(
  types: Slice[ast2.MonoType],
  index: Int,
  out: Slice[goast.Expr]
) -> Slice[goast.Expr]
  if index >= types.Len() then
    out
  else
    switch types.Get(index)
      case Some(mono) then
        goTypeArgs(
          types,
          index + 1,
          out.Append(goast.MustTypeExpr(ir3.GoTypeString(mono, [])))
        )
      end
      case None => goTypeArgs(types, index + 1, out)
    end
  end
end

func goExpr(expr: ir3.Expr) -> Result[goast.Expr, String]
  switch expr.Kind
    case VarExpr(name) then
      if name == "None" && isOptionRefType(expr.Type) then
        switch expr.Type
          case Some(typ) => Ok(goast.MustExpr("(" + ir3.GoTypeString(typ, []) + ")(nil)"))
          case None => Err("codegen3 requires a type for None")
        end
      elsif name == "None" && isOptionType(expr.Type) then
        # Go cannot infer None's type parameter from the result context.
        Ok(goast.Call(goast.MustExpr(preludeCtorName("Option", "None") + optionTypeArgText(expr.Type)), []))
      else
        Ok(goast.Ident(localGoName(name)))
      end
    end
    case ConstExpr(value) => Ok(constantExpr(value, expr.Type))
    case PrimExpr(primitive, args, effect) then
      if args.Len() == 1 then
        switch args.Get(0)
          case Some(arg) then
            switch goExpr(arg)
              case Ok(value) => Ok(goast.Unary(primitive, value))
              case Err(message) => Err(message)
            end
          end
          case None => Err("codegen3 primitive argument is missing")
        end
      else
        if args.Len() == 2 then
          switch args.Get(0)
            case Some(left) then
              switch args.Get(1)
                case Some(right) then
                  switch goExpr(left)
                    case Ok(goLeft) then
                      switch goExpr(right)
                        case Ok(goRight) => Ok(goast.Binary(goLeft, primitive, goRight))
                        case Err(message) => Err(message)
                      end
                    end
                    case Err(message) => Err(message)
                  end
                end
                case None => Err("codegen3 primitive right operand is missing")
              end
            end
            case None => Err("codegen3 primitive left operand is missing")
          end
        else
          Err("codegen3 supports only unary and binary primitives for now")
        end
      end
    end
    case ApplyExpr(callee, args, kind, tail, effect) then
      applyExprDispatch(expr, callee.value(), args, kind)
    end
    case FieldNamedExpr(receiver, name) then
      switch enumCtorValue(expr, receiver.value(), name)
        case Err(message) => Err(message)
        case Ok(Some(value)) => Ok(value)
        case Ok(None) then
          switch goExpr(receiver.value())
            case Ok(goReceiver) => Ok(goast.Selector(goReceiver, name))
            case Err(message) => Err(message)
          end
        end
      end
    end
    case FieldExpr(receiver, index) then
      switch goExpr(receiver.value())
        case Ok(goReceiver) then
          # Inside a tagged case the subject still names the whole tagged value,
          # so a positional payload read must select the variant's field group.
          if activeTaggedSubject != "" &&
            activeTaggedVariant != "" &&
            irVarName(receiver.value()) == activeTaggedSubject then
            Ok(goast.Selector(
              goast.Selector(goReceiver, activeTaggedVariant),
              "F" + index.ToString()
            ))
          else
            Ok(goast.Selector(goReceiver, "F" + index.ToString()))
          end
        end
        case Err(message) => Err(message)
      end
    end
    case CastExpr(value, target) then
      if isEmptyCollectionAlloc(value.value()) then
        Ok(goast.Composite(goast.MustTypeExpr(ir3.GoTypeString(target, [])), []))
      else
        switch goExpr(value.value())
          case Ok(goValue) then
            Ok(goast.Call(goast.MustTypeExpr(ir3.GoTypeString(target, [])), [goValue]))
          end
          case Err(message) => Err(message)
        end
      end
    end
    case TypeApplyExpr(base, typeArgs) then
      switch goExpr(base.value())
        case Ok(goBase) => Ok(goast.TypeApply(goBase, goTypeArgs(typeArgs, 0, [])))
        case Err(message) => Err(message)
      end
    end
    case FunctionExpr(params, body) => functionLiteralExpr(params, body.value(), expr.Type)
    case AllocExpr(kind, args) then
      allocExprGo(expr, kind, args)
      # Statement-shaped expressions in value position become an immediately
      # invoked function literal so joins, lets, and guards keep their statement
      # lowering (including hoisted locals and labels).
    end
    case IfExpr(condition, thenExpr, elseExpr) => iifeExpr(expr)
    case SwitchExpr(subject, cases, defaultCase) => iifeExpr(expr)
    case SeqExpr(first, second) => iifeExpr(expr)
    case LetExpr(name, value, body) => iifeExpr(expr)
    case LetRecExpr(bindings, body) => iifeExpr(expr)
    case BlockExpr(label, params, body) => iifeExpr(expr)
    case MultiLetExpr(bindings, producer, rest) => iifeExpr(expr)
    case AssignExpr(name, value) => iifeExpr(expr)
    case SetFieldNamedExpr(receiver, name, value) => iifeExpr(expr)
    case SetFieldExpr(receiver, index, value) => iifeExpr(expr)
    case JumpExpr(label, args) => Err("codegen3 cannot use a jump as a value: " + label)
    case RaiseExpr(label, args) => Err("codegen3 cannot use a raise as a value: " + label)
    case ReturnExpr(value) => Err("codegen3 cannot use a return as a value")
    case BreakExpr => Err("codegen3 cannot use break as a value")
    case ContinueExpr => Err("codegen3 cannot use continue as a value")
    case WhileExpr(condition, body) => Err("codegen3 cannot use a while loop as a value")
    case MultiReturnExpr(values) => Err("codegen3 cannot use a multi-return as a value")
    case UnsupportedExpr(reason) => Err("codegen3 cannot emit unsupported IR: " + reason)
    case ForeignExpr(code, typeOperands, operands, effect) then
      foreignExprGo(expr, code, typeOperands, operands)
    end
    case DynamicBoxExpr(value, interfacePackage, interfaceName, implementationID, constructorName) then
      switch goExpr(value.value())
        case Ok(payload) then
          Ok(goast.Call(
            goast.Ident("NewMygoDynamic" + interfaceName),
            [payload, goast.MustExpr("\"" + implementationID + "\"")]
          ))
        end
        case Err(message) => Err(message)
      end
    end
    case ZeroExpr(typ) then
      Ok(goast.Unary(
        "*",
        goast.Call(goast.Ident("new"), [goast.TypeName(ir3.GoTypeString(typ, []))])
      ))
    end
    case _ => Err("codegen3 expression lowering is pending for this IR node")
  end
end

# An empty collection cast changes only the Go slice/map type. Emitting a
# composite literal of the destination type avoids invalid conversions such as
# `json.RawMessage([]any{})` when inference inferred the source as `Slice[Any]`.
func isEmptyCollectionAlloc(expr: ir3.Expr) -> Bool
  switch expr.Kind
    case AllocExpr(kind, args) => (kind == "Slice" || kind == "Map" || kind == "Set") && args.Len() == 0
    case _ => false
  end
end

# Wrap statement lowering in a function literal for expression positions. The
# join machinery already knows how to produce a value (or a bare return) in the
# body's tail position, so the wrapper only supplies the signature.
func iifeExpr(expr: ir3.Expr) -> Result[goast.Expr, String]
  switch expr.Type
    case None => Err("codegen3 needs a type for a statement expression")
    case Some(typ) then
      # Use the function-body driver so outer labels are collected and locals
      # that a forward goto can skip are hoisted before the statements.
      switch functionBodyStmtsCore(expr, [] as Slice[String], "")
        case Err(message) => Err(message)
        case Ok(stmts) then
          let results = if isUnitMono(typ) then
            [] as Slice[String]
          else
            [ir3.GoTypeString(typ, [])]
          end
          Ok(goast.Call(
            goast.FuncLitFromStmts([] as Slice[String], [] as Slice[String], results, stmts),
            []
          ))
        end
      end
    end
  end
end

# Call dispatch order matters: compiler intrinsics first (Ref), then enum
# constructors, Result boundary adaptation, impl helpers, and finally ordinary
# calls/dictionary diagnostics.
# Explicit generic instantiation is transparent to call resolution; the callee
# still names the function or constructor being called.
# irVarName names the IR variable an expression reads, or "" when it is not a
# plain variable reference.
func irVarName(expr: ir3.Expr) -> String
  switch expr.Kind
    case VarExpr(name) => name
    case _ => ""
  end
end

func typeApplyBase(callee: ir3.Expr) -> ir3.Expr
  switch callee.Kind
    case TypeApplyExpr(base, _) => base.value()
    case _ => callee
  end
end

func applyExprDispatch(
  expr: ir3.Expr,
  callee: ir3.Expr,
  args: Slice[ir3.Expr],
  kind: ir3.CallKind
) -> Result[goast.Expr, String]
  let base = typeApplyBase(callee)
  switch refIntrinsicApply(expr, base, args)
    case Err(message) => Err(message)
    case Ok(Some(value)) => Ok(value)
    case Ok(None) then
      switch resultCtorApply(expr, base, args)
        case Err(message) => Err(message)
        case Ok(Some(value)) => Ok(value)
        case Ok(None) => applyDispatchAfterCtors(expr, callee, args, kind)
      end
    end
  end
end

func applyDispatchAfterCtors(
  expr: ir3.Expr,
  callee: ir3.Expr,
  args: Slice[ir3.Expr],
  kind: ir3.CallKind
) -> Result[goast.Expr, String]
  let base = typeApplyBase(callee)
  switch enumCtorApply(expr, base, args)
    case Err(message) => Err(message)
    case Ok(Some(value)) => Ok(value)
    case Ok(None) then
      switch ffiResultApply(expr, base, args, kind)
        case Ok(wrapped) then
          switch wrapped
            case Some(value) => Ok(value)
            case None then
              switch implMethodApply(base, args)
                case Ok(implValue) then
                  switch implValue
                    case Some(value) => Ok(value)
                    case None => applyExprOrDictionary(expr, callee, args, kind)
                  end
                end
                case Err(message) => Err(message)
              end
            end
          end
        end
        case Err(message) => Err(message)
      end
    end
  end
end

# A function whose only result is its only type parameter (`Zero[A]() -> A`)
# needs that parameter spelled at the call site: Go cannot infer it from the
# result, and the call's inferred type is exactly the argument.
var genericReturnFunctions: Set[String] = Set.New[String]()

func refreshGenericReturnFunctions(decls: Slice[ir3.Decl]) -> ()
  genericReturnFunctions = Set.New[String]()
  setGenericReturnFunctions(decls, 0)
end

func setGenericReturnFunctions(decls: Slice[ir3.Decl], index: Int) -> ()
  if index >= decls.Len() then
    ()
  else
    switch decls.Get(index)
      case Some(decl) then
        switch decl.Kind
          case FunctionDecl(typeParams, _, results, _) then
            if isGenericReturnSignature(typeParams, results) then
              # Set.Add returns the updated set; assigning keeps this branch
              # Unit-valued instead of tail-returning a value.
              genericReturnFunctions = genericReturnFunctions.Add(decl.Name)
            end
          end
          case _ => ()
        end
        setGenericReturnFunctions(decls, index + 1)
      end
      case None => setGenericReturnFunctions(decls, index + 1)
    end
  end
end

func isGenericReturnSignature(typeParams: Slice[String], results: Slice[ast2.MonoType]) -> Bool
  if typeParams.Len() != 1 then
    false
  else
    switch results.Get(0)
      case Some(TCon(name)) => name == typeParams.Get(0).UnwrapOr("")
      case _ => false
    end
  end
end

func genericReturnCallee(expr: ir3.Expr, callee: ir3.Expr, goCallee: goast.Expr) -> goast.Expr
  switch callee.Kind
    case VarExpr(name) then
      # `Zero` is declared in the prelude, which is not part of this package's
      # declarations; its contract is exactly "result is the type argument".
      if genericReturnFunctions.Contains(name) || name == "Zero" then
        switch expr.Type
          case Some(mono) => goast.TypeApply(goCallee, [goast.MustExpr(ir3.GoTypeString(mono, []))])
          case None => goCallee
        end
      else
        goCallee
      end
    end
    case _ => goCallee
  end
end

func applyExprGo(
  expr: ir3.Expr,
  callee: ir3.Expr,
  args: Slice[ir3.Expr]
) -> Result[goast.Expr, String]
  switch optionRefApply(expr, callee, args)
    case Ok(wrapped) then
      switch wrapped
        case Some(value) => Ok(value)
        case None then
          switch goExpr(callee)
            case Ok(goCallee) then
              switch goGenericBoundaryArgs(args, callee.Type, 0, [])
                case Ok(goArgs) then
                  let call = goast.Call(genericReturnCallee(expr, callee, goCallee), goArgs)
                  Ok(goGenericBoundaryResult(call, expr.Type, callee.Type))
                end
                case Err(message) => Err(message)
              end
            end
            case Err(message) => Err(message)
          end
        end
      end
    end
    case Err(message) => Err(message)
  end
end

func goCallArgs(
  args: Slice[ir3.Expr],
  index: Int,
  out: Slice[goast.Expr]
) -> Result[Slice[goast.Expr], String]
  if index >= args.Len() then
    Ok(out)
  else
    switch args.Get(index)
      case Some(arg) then
        switch goExpr(arg)
          case Ok(value) => goCallArgs(args, index + 1, out.Append(value))
          case Err(message) => Err(message)
        end
      end
      case None => goCallArgs(args, index + 1, out)
    end
  end
end

func functionLiteralExpr(
  params: Slice[ir3.Param],
  body: ir3.Expr,
  typ: Option[ast2.MonoType]
) -> Result[goast.Expr, String]
  let names = paramNames(params, 0, [])
  let types = paramTypes(params, 0, [])
  let returns = functionLiteralReturnTypes(typ)
  switch functionBodyStmtsBound(body, names)
    case Ok(stmts) => Ok(goast.FuncLitFromStmts(goParamNames(params, 0, []), types, returns, stmts))
    case Err(message) => Err(message)
  end
end

func functionLiteralReturnTypes(typ: Option[ast2.MonoType]) -> Slice[String]
  switch typ
    case Some(mono) then
      switch mono
        case TFunc(params, ret) then
          if isUnitMono(ret.value()) then
            []
          else
            [ir3.GoTypeString(ret.value(), [])]
          end
        end
        case _ => []
      end
    end
    case None => []
  end
end

# IR constants keep surface literal text for numbers and booleans, while
# inference stores String/Rune constants as decoded values. A decoded string can
# itself begin and end with a quote character (for example after decoding an
# escaped quoted word), so it must still be re-quoted as a Go literal; treating
# it as pre-quoted Go text would silently drop those quotes.
func constantExpr(raw: String, typ: Option[ast2.MonoType]) -> goast.Expr
  # "()" is the Unit constant only when its inferred type says so; a String
  # literal with that text must stay a string.
  if raw == "()" && isUnitTypeOption(typ) then
    goast.Unit()
  elsif isNamedTypeOption(typ, "String") then
    goast.MustExpr(strconv.Quote(raw))
  elsif isNamedTypeOption(typ, "Rune") then
    goast.MustExpr(runeConstantText(raw))
  else
    numericConstantExpr(raw, typ)
  end
end

# MyGO numeric literals carry their type as a suffix (`42i16`, `3.14f32`) and
# the IR keeps the raw text because the suffix drives inference. Go needs the
# bare number plus an explicit conversion: `int16(42)`.
func numericConstantExpr(raw: String, typ: Option[ast2.MonoType]) -> goast.Expr
  switch typ
    case Some(mono) then
      let normalized = stripNumericLiteralSuffix(raw, 0)
      if normalized != raw then
        goast.Call(goast.MustExpr(ir3.GoTypeString(mono, [])), [numericLiteralExpr(normalized)])
      else
        plainConstantExpr(raw)
      end
    end
    case None => plainConstantExpr(raw)
  end
end

# Numbers, booleans, and pre-quoted literals parse as expressions. Any other
# text is a decoded string constant whose type was lost (for example a
# dictionary key or pattern literal), so quote it rather than throwing a parser
# panic.
func plainConstantExpr(raw: String) -> goast.Expr
  switch goast.ParseExpression(raw)
    case Ok(parsed) => parsed
    case Err(_) => goast.String(strconv.Quote(raw))
  end
end

func numericLiteralExpr(text: String) -> goast.Expr
  if strings.HasPrefix(text, "-") then
    goast.Unary("-", goast.Number(strings.TrimPrefix(text, "-")))
  else
    goast.Number(text)
  end
end

func stripNumericLiteralSuffix(value: String, index: Int) -> String
  let suffixes = ["i8", "u8", "i16", "u16", "i32", "u32", "i64", "u64", "u", "f32", "f64"] as Slice[String]
  if index >= suffixes.Len() then
    value
  else
    switch suffixes.Get(index)
      case Some(suffix) then
        if strings.HasSuffix(value, suffix) then
          strings.TrimSuffix(value, suffix)
        else
          stripNumericLiteralSuffix(value, index + 1)
        end
      end
      case None => stripNumericLiteralSuffix(value, index + 1)
    end
  end
end

func isNamedTypeOption(typ: Option[ast2.MonoType], name: String) -> Bool
  switch typ
    case Some(TCon(value)) => value == name
    case _ => false
  end
end

func runeConstantText(raw: String) -> String
  let runes = raw as Slice[Rune]
  if runes.Len() == 1 then
    strconv.QuoteRune(runes.Get(0).Unwrap())
  else
    strconv.Quote(raw)
  end
end

func isOptionType(typ: Option[ast2.MonoType]) -> Bool
  switch typ
    case Some(TApp(ctor, args)) then
      switch ctor.value()
        case TCon(name) => name == "Option"
        case _ => false
      end
    end
    case _ => false
  end
end

# Go cannot infer None's type parameter from the result context, so None calls
# need the option's element type spelled out.
func optionTypeArgText(typ: Option[ast2.MonoType]) -> String
  switch typ
    case Some(TApp(ctor, args)) then
      switch args.Get(0)
        case Some(arg) => "[" + ir3.GoTypeString(arg, []) + "]"
        case None => ""
      end
    end
    case _ => ""
  end
end

func isUnitMono(mono: ast2.MonoType) -> Bool
  switch mono
    case TUnit => true
    case _ => false
  end
end
