end

func TestCodegen3DynamicBoxing(t: Ref[testing.T]) -> ()
  t.Helper()
  var shapes: Map[String, ir3.TypeShape] = {}
  shapes.Set("Show", ir3.TypeShape.InterfaceShape)
  let iface = ir3.Decl {
    Name: "Show",
    Exported: true,
    Kind: ir3.DeclKind.TypeDecl([], Some(ir3.Repr.InterfaceRepr("Show"))),
    Path: "sample.mygo",
    Pos: cg3Pos(),
  }
  let boxed = cg3TypedExpr(
    ir3.ExprKind.DynamicBoxExpr(
      Ref.new(cg3IntExpr(ir3.ExprKind.VarExpr("x"))),
      "",
      "Show",
      "show-int",
      "ShowInt"
    ),
    ast2.MonoType.TCon("MygoDynamicShow")
  )
  let boxDecl = cg3Function(
    "box",
    [cg3Param("x", "Int")],
    [ast2.MonoType.TCon("MygoDynamicShow")],
    boxed,
    "sample.mygo"
  )
  let pkg = ir3.Package {
    Name: "sample",
    ImportPath: "example.com/sample",
    Decls: [iface, boxDecl],
    Imports: [],
    TypeShapes: shapes,
    InterfaceTypes: ["Show"],
  }
  switch GenerateFiles(pkg)
    case Ok(files) then
      let source = cg3Source(t, files, "zz_sample.gen.go")
      if !strings.Contains(source, "type MygoDynamicShow struct") then
        t.Fatal("dynamic wrapper type is missing:\n" + source)
      end
      if !strings.Contains(source, "type Show = MygoDynamicShow") then
        t.Fatal("interface alias is missing from generated Go:\n" + source)
      end
      if !strings.Contains(source, "NewMygoDynamicShow(x, \"show-int\")") then
        t.Fatal("dynamic boxing call is missing:\n" + source)
      end
      let failure = goast.TypeCheckSource(source)
      if failure != "" then
        t.Fatal("dynamic boxing output does not type-check: " + failure + "\n" + source)
      end
    end
    case Err(message) => t.Fatal("GenerateFiles() failed: " + message)
  end
end

func TestCodegen3DynamicRoundTrip(t: Ref[testing.T]) -> ()
  t.Helper()
  let intType = ast2.MonoType.TCon("Int")
  let refInt = ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Ref")), [intType])
  let optRef = ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Option")), [refInt])
  let boxType = ast2.MonoType.TCon("MygoDynamicShow")
  let boxed = cg3TypedExpr(
    ir3.ExprKind.DynamicBoxExpr(
      Ref.new(cg3TypedExpr(
        ir3.ExprKind.ApplyExpr(
          Ref.new(cg3TypedExpr(ir3.ExprKind.VarExpr("Some"), optRef)),
          [cg3TypedExpr(ir3.ExprKind.VarExpr("ref"), refInt)],
          ir3.CallKind.Direct,
          false,
          ir3.Effect.Pure
        ),
        optRef
      )),
      "",
      "Show",
      "show-int",
      "ShowInt"
    ),
    boxType
  )
  let boxDecl = cg3Function(
    "box",
    [ir3.Param { Name: "ref", Type: refInt, Repr: None }],
    [boxType],
    boxed,
    "sample.mygo"
  )
  let payloadBody = cg3TypedExpr(
    ir3.ExprKind.FieldNamedExpr(Ref.new(cg3Expr(ir3.ExprKind.VarExpr("boxed"))), "payload"),
    ast2.MonoType.TCon("Any")
  )
  let payloadDecl = cg3Function(
    "payloadOf",
    [ir3.Param { Name: "boxed", Type: boxType, Repr: None }],
    [ast2.MonoType.TCon("Any")],
    payloadBody,
    "sample.mygo"
  )
  var shapes: Map[String, ir3.TypeShape] = {}
  shapes.Set("Show", ir3.TypeShape.InterfaceShape)
  let iface = ir3.Decl {
    Name: "Show",
    Exported: true,
    Kind: ir3.DeclKind.TypeDecl([], Some(ir3.Repr.InterfaceRepr("Show"))),
    Path: "sample.mygo",
    Pos: cg3Pos(),
  }
  let pkg = ir3.Package {
    Name: "sample",
    ImportPath: "example.com/sample",
    Decls: [iface, boxDecl, payloadDecl],
    Imports: [],
    TypeShapes: shapes,
    InterfaceTypes: ["Show"],
    CanonicalPackages: [preludeImportPath()],
  }
  switch GenerateFiles(pkg)
    case Ok(files) then
      let source = cg3Source(t, files, "zz_sample.gen.go")
      if !strings.Contains(source, "NewMygoDynamicShow(ref, \"show-int\")") then
        t.Fatal("dynamic boxing lost the canonical Option[Ref] payload:\n" + source)
      end
      if !strings.Contains(source, "return boxed.payload") then
        t.Fatal("dynamic round-trip lost the boxed payload:\n" + source)
      end
      if !strings.Contains(source, "func MygoDynamicShowPayload(") then
        t.Fatal("dynamic wrapper accessors are missing:\n" + source)
      end
      let failure = goast.TypeCheckSource(source)
      if failure != "" then
        t.Fatal("dynamic round-trip output does not type-check: " + failure + "\n" + source)
      end
    end
    case Err(message) => t.Fatal("GenerateFiles() failed: " + message)
  end
end

func TestCodegen3SelfTailCallLoop(t: Ref[testing.T]) -> ()
  t.Helper()
  let intType = ast2.MonoType.TCon("Int")
  let done = cg3UnitExpr(ir3.ExprKind.ReturnExpr(Some(Ref.new(cg3IntExpr(ir3.ExprKind.VarExpr("acc"))))))
  let recurse = cg3TypedExpr(
    ir3.ExprKind.ApplyExpr(
      Ref.new(cg3TypedExpr(ir3.ExprKind.VarExpr("sum"), intType)),
      [
        cg3IntExpr(ir3.ExprKind.PrimExpr(
          "-",
          [cg3IntExpr(ir3.ExprKind.VarExpr("n")), cg3IntExpr(ir3.ExprKind.ConstExpr("1"))],
          ir3.Effect.Pure
        )),
        cg3IntExpr(ir3.ExprKind.PrimExpr(
          "+",
          [cg3IntExpr(ir3.ExprKind.VarExpr("acc")), cg3IntExpr(ir3.ExprKind.VarExpr("n"))],
          ir3.Effect.Pure
        )),
      ],
      ir3.CallKind.Direct,
      true,
      ir3.Effect.Pure
    ),
    intType
  )
  let body = cg3TypedExpr(
    ir3.ExprKind.IfExpr(
      Ref.new(cg3TypedExpr(
        ir3.ExprKind.PrimExpr(
          "==",
          [cg3IntExpr(ir3.ExprKind.VarExpr("n")), cg3IntExpr(ir3.ExprKind.ConstExpr("0"))],
          ir3.Effect.Pure
        ),
        ast2.MonoType.TCon("Bool")
      )),
      Ref.new(done),
      Ref.new(recurse)
    ),
    intType
  )
  let decl = cg3Function(
    "sum",
    [cg3Param("n", "Int"), cg3Param("acc", "Int")],
    [intType],
    body,
    "sample.mygo"
  )
  switch GenerateFiles(cg3Package([decl]))
    case Ok(files) then
      let source = cg3Source(t, files, "zz_sample.gen.go")
      if !strings.Contains(source, "for {") || !strings.Contains(source, "continue") then
        t.Fatal("self tail call was not lowered to a loop:\n" + source)
      end
      if strings.Contains(source, "return sum(") then
        t.Fatal("self tail call still grows the stack:\n" + source)
      end
      let failure = goast.TypeCheckSource(source)
      if failure != "" then
        t.Fatal("tail-call loop does not type-check: " + failure + "\n" + source)
      end
    end
    case Err(message) => t.Fatal("GenerateFiles() failed: " + message)
  end
end

func cg3TailStep(target: String, argument: ir3.Expr) -> ir3.Expr
  cg3TypedExpr(
    ir3.ExprKind.ApplyExpr(
      Ref.new(cg3TypedExpr(ir3.ExprKind.VarExpr(target), ast2.MonoType.TCon("Bool"))),
      [argument],
      ir3.CallKind.Direct,
      false,
      ir3.Effect.Pure
    ),
    ast2.MonoType.TCon("Bool")
  )
end

func cg3MinusOne(name: String) -> ir3.Expr
  cg3IntExpr(ir3.ExprKind.PrimExpr(
    "-",
    [cg3IntExpr(ir3.ExprKind.VarExpr(name)), cg3IntExpr(ir3.ExprKind.ConstExpr("1"))],
    ir3.Effect.Pure
  ))
end

func cg3IsZero(name: String) -> ir3.Expr
  cg3TypedExpr(
    ir3.ExprKind.PrimExpr(
      "==",
      [cg3IntExpr(ir3.ExprKind.VarExpr(name)), cg3IntExpr(ir3.ExprKind.ConstExpr("0"))],
      ir3.Effect.Pure
    ),
    ast2.MonoType.TCon("Bool")
  )
end

func cg3PrivateFunction(
  name: String,
  params: Slice[ir3.Param],
  results: Slice[ast2.MonoType],
  body: ir3.Expr,
  path: String
) -> ir3.Decl
  ir3.Decl {
    Name: name,
    Exported: false,
    Kind: ir3.DeclKind.FunctionDecl([] as Slice[String], params, results, body),
    Path: path,
    Pos: cg3Pos(),
  }
end

func cg3OptionInt() -> ast2.MonoType
  ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Option")), [ast2.MonoType.TCon("Int")])
end

func cg3Constructor(name: String, args: Slice[ir3.Expr], typ: ast2.MonoType) -> ir3.Expr
  cg3TypedExpr(
    ir3.ExprKind.ApplyExpr(
      Ref.new(cg3Expr(ir3.ExprKind.VarExpr(name))),
      args,
      ir3.CallKind.Direct,
      false,
      ir3.Effect.Pure
    ),
    typ
  )
end

func cg3OptionCase(tag: String, binding: String, body: ir3.Expr) -> ir3.SwitchCase
  ir3.SwitchCase {
    Tag: tag,
    Bindings: [binding],
    Guard: None,
    Body: Ref.new(body),
    Pos: cg3Pos(),
  }
end

func TestCodegen3InlinedLeafCall(t: Ref[testing.T]) -> ()
  t.Helper()
  let intType = ast2.MonoType.TCon("Int")
  let incBody = cg3IntExpr(ir3.ExprKind.PrimExpr(
    "+",
    [cg3IntExpr(ir3.ExprKind.VarExpr("x")), cg3IntExpr(ir3.ExprKind.ConstExpr("1"))],
    ir3.Effect.Pure
  ))
  let inc = cg3PrivateFunction("inc", [cg3Param("x", "Int")], [intType], incBody, "sample.mygo")
  let mainBody = cg3TypedExpr(
    ir3.ExprKind.LetExpr(
      "a",
      Ref.new(cg3TypedExpr(
        ir3.ExprKind.ApplyExpr(
          Ref.new(cg3Expr(ir3.ExprKind.VarExpr("inc"))),
          [cg3IntExpr(ir3.ExprKind.ConstExpr("2"))],
          ir3.CallKind.Direct,
          false,
          ir3.Effect.Pure
        ),
        intType
      )),
      Ref.new(cg3Expr(ir3.ExprKind.VarExpr("a")))
    ),
    intType
  )
  let main = cg3Function("main", [], [intType], mainBody, "sample.mygo")
  let optimized = optimizer3.Inline3(cg3Package([inc, main]))
  switch GenerateFiles(optimized)
    case Ok(files) then
      let source = cg3Source(t, files, "zz_sample.gen.go")
      if strings.Contains(source, "= inc(") || !strings.Contains(source, "2 + 1") then
        t.Fatal("inlined call was not substituted:\n" + source)
      end
      let failure = goast.TypeCheckSource(source)
      if failure != "" then
        t.Fatal("inlined output does not type-check: " + failure + "\n" + source)
      end
    end
    case Err(message) => t.Fatal("GenerateFiles() failed: " + message)
  end
end

func cg3DictParam(name: String) -> ir3.Param
  ir3.Param {
    Name: name,
    Type: ast2.MonoType.TFunc(
      [ast2.MonoType.TCon("Int"), ast2.MonoType.TCon("Int")],
      Ref.new(ast2.MonoType.TCon("Bool"))
    ),
    Repr: None,
  }
end

func TestCodegen3SpecializedDictionaryCall(t: Ref[testing.T]) -> ()
  t.Helper()
  let boolType = ast2.MonoType.TCon("Bool")
  let eqBody = cg3TypedExpr(
    ir3.ExprKind.PrimExpr(
      "==",
      [cg3Expr(ir3.ExprKind.VarExpr("a")), cg3Expr(ir3.ExprKind.VarExpr("b"))],
      ir3.Effect.Pure
    ),
    boolType
  )
  let eqInt = cg3PrivateFunction(
    "eqInt",
    [cg3Param("a", "Int"), cg3Param("b", "Int")],
    [boolType],
    eqBody,
    "sample.mygo"
  )
  let sameBody = cg3TypedExpr(
    ir3.ExprKind.ApplyExpr(
      Ref.new(cg3Expr(ir3.ExprKind.VarExpr("dict"))),
      [cg3Expr(ir3.ExprKind.VarExpr("x")), cg3IntExpr(ir3.ExprKind.ConstExpr("0"))],
      ir3.CallKind.Direct,
      false,
      ir3.Effect.Pure
    ),
    boolType
  )
  let same = cg3PrivateFunction(
    "same",
    [cg3DictParam("dict"), cg3Param("x", "Int")],
    [boolType],
    sameBody,
    "sample.mygo"
  )
  let mainBody = cg3TypedExpr(
    ir3.ExprKind.ApplyExpr(
      Ref.new(cg3Expr(ir3.ExprKind.VarExpr("same"))),
      [cg3Expr(ir3.ExprKind.VarExpr("eqInt")), cg3IntExpr(ir3.ExprKind.ConstExpr("5"))],
      ir3.CallKind.Direct,
      false,
      ir3.Effect.Pure
    ),
    boolType
  )
  let main = cg3Function("main", [], [boolType], mainBody, "sample.mygo")
  let optimized = optimizer3.Specialize3(cg3Package([eqInt, same, main]))
  switch GenerateFiles(optimized)
    case Ok(files) then
      let source = cg3Source(t, files, "zz_sample.gen.go")
      if !strings.Contains(source, "func __mygo_spec_same_0_eqInt(x int) bool") then
        t.Fatal("Specialize3 clone is missing from generated Go:\n" + source)
      end
      if strings.Contains(source, "same(eqInt") then
        t.Fatal("specialized call site still passes the dictionary:\n" + source)
      end
      let failure = goast.TypeCheckSource(source)
      if failure != "" then
        t.Fatal("specialized output does not type-check: " + failure + "\n" + source)
      end
    end
    case Err(message) => t.Fatal("GenerateFiles() failed: " + message)
  end
end

func TestCodegen3LiftedClosedLambda(t: Ref[testing.T]) -> ()
  t.Helper()
  let intType = ast2.MonoType.TCon("Int")
  let funcType = ast2.MonoType.TFunc([intType], Ref.new(intType))
  let lambda = cg3TypedExpr(
    ir3.ExprKind.FunctionExpr(
      [cg3Param("x", "Int")],
      Ref.new(cg3IntExpr(ir3.ExprKind.PrimExpr(
        "+",
        [cg3IntExpr(ir3.ExprKind.VarExpr("x")), cg3IntExpr(ir3.ExprKind.ConstExpr("1"))],
        ir3.Effect.Pure
      )))
    ),
    funcType
  )
  let body = cg3TypedExpr(
    ir3.ExprKind.LetExpr(
      "f",
      Ref.new(lambda),
      Ref.new(cg3TypedExpr(
        ir3.ExprKind.ApplyExpr(
          Ref.new(cg3Expr(ir3.ExprKind.VarExpr("f"))),
          [cg3IntExpr(ir3.ExprKind.ConstExpr("2"))],
          ir3.CallKind.Closure,
          false,
          ir3.Effect.Pure
        ),
        intType
      ))
    ),
    intType
  )
  let decl = cg3Function("run", [], [intType], body, "sample.mygo")
  let optimized = optimizer3.Closure3(cg3Package([decl]))
  switch GenerateFiles(optimized)
    case Ok(files) then
      let source = cg3Source(t, files, "zz_sample.gen.go")
      if !strings.Contains(source, "func __mygo_lift_run_0") then
        t.Fatal("lifted lambda is missing from generated Go:\n" + source)
      end
      let failure = goast.TypeCheckSource(source)
      if failure != "" then
        t.Fatal("lifted lambda output does not type-check: " + failure + "\n" + source)
      end
    end
    case Err(message) => t.Fatal("GenerateFiles() failed: " + message)
  end
end

func TestCodegen3UnboxedOptionMultiReturn(t: Ref[testing.T]) -> ()
  t.Helper()
  let intType = ast2.MonoType.TCon("Int")
  let optionType = cg3OptionInt()
  let someBody = cg3TypedExpr(
    ir3.ExprKind.IfExpr(
      Ref.new(cg3IsZero("n")),
      Ref.new(cg3Constructor("Some", [cg3IntExpr(ir3.ExprKind.ConstExpr("7"))], optionType)),
      Ref.new(cg3Constructor("None", [], optionType))
    ),
    optionType
  )
  let chooseDecl = cg3PrivateFunction(
    "choose",
    [cg3Param("n", "Int")],
    [optionType],
    someBody,
    "sample.mygo"
  )
  let matchBody = cg3TypedExpr(
    ir3.ExprKind.SwitchExpr(
      Ref.new(cg3IntExpr(ir3.ExprKind.VarExpr("v"))),
      [
        cg3OptionCase("Some", "y", cg3IntExpr(ir3.ExprKind.VarExpr("y"))),
        ir3.SwitchCase {
          Tag: "None",
          Bindings: [],
          Guard: None,
          Body: Ref.new(cg3IntExpr(ir3.ExprKind.ConstExpr("0"))),
          Pos: cg3Pos(),
        },
      ],
      None
    ),
    intType
  )
  let call = cg3TypedExpr(
    ir3.ExprKind.ApplyExpr(
      Ref.new(cg3Expr(ir3.ExprKind.VarExpr("choose"))),
      [cg3IntExpr(ir3.ExprKind.VarExpr("n"))],
      ir3.CallKind.Direct,
      false,
      ir3.Effect.Foreign
    ),
    optionType
  )
  let useBody = cg3TypedExpr(
    ir3.ExprKind.LetExpr("v", Ref.new(call), Ref.new(matchBody)),
    intType
  )
  let useDecl = cg3PrivateFunction("use", [cg3Param("n", "Int")], [intType], useBody, "sample.mygo")
  let optimized = optimizer3.Unbox3(cg3Package([chooseDecl, useDecl]))
  switch GenerateFiles(optimized)
    case Ok(files) then
      let source = cg3Source(t, files, "zz_sample.gen.go")
      if !strings.Contains(source, "return true, 7") then
        t.Fatal("unboxed Some did not return a multi-value pair:\n" + source)
      end
      if !strings.Contains(source, "*new(int)") then
        t.Fatal("unboxed None did not use a zero value:\n" + source)
      end
      if !strings.Contains(source, ":= choose(n)") then
        t.Fatal("the call site did not consume the multi-value result:\n" + source)
      end
      let failure = goast.TypeCheckSource(source)
      if failure != "" then
        t.Fatal("unboxed Option output does not type-check: " + failure + "\n" + source)
      end
    end
    case Err(message) => t.Fatal("GenerateFiles() failed: " + message)
  end
end

func TestCodegen3MutualTailCallSccLoop(t: Ref[testing.T]) -> ()
  t.Helper()
  let boolType = ast2.MonoType.TCon("Bool")
  let evenBody = cg3TypedExpr(
    ir3.ExprKind.IfExpr(
      Ref.new(cg3IsZero("n")),
      Ref.new(cg3TypedExpr(ir3.ExprKind.ConstExpr("true"), boolType)),
      Ref.new(cg3TailStep("odd", cg3MinusOne("n")))
    ),
    boolType
  )
  let oddBody = cg3TypedExpr(
    ir3.ExprKind.IfExpr(
      Ref.new(cg3IsZero("n")),
      Ref.new(cg3TypedExpr(ir3.ExprKind.ConstExpr("false"), boolType)),
      Ref.new(cg3TailStep("even", cg3MinusOne("n")))
    ),
    boolType
  )
  let evenDecl = cg3Function("even", [cg3Param("n", "Int")], [boolType], evenBody, "sample.mygo")
  let oddDecl = cg3Function("odd", [cg3Param("n", "Int")], [boolType], oddBody, "sample.mygo")
  let optimized = optimizer3.Tailcall3(cg3Package([evenDecl, oddDecl]))
  switch GenerateFiles(optimized)
    case Ok(files) then
      let source = cg3Source(t, files, "zz_sample.gen.go")
      if !strings.Contains(source, "for {") || !strings.Contains(source, "continue") then
        t.Fatal("mutual tail calls were not lowered to a loop:\n" + source)
      end
      if strings.Contains(source, "return odd(") || strings.Contains(source, "return even(") then
        t.Fatal("mutual tail call still grows the stack:\n" + source)
      end
      if !strings.Contains(source, "func even(") || !strings.Contains(source, "func odd(") then
        t.Fatal("mutual tail-call lowering dropped an exported symbol:\n" + source)
      end
      let failure = goast.TypeCheckSource(source)
      if failure != "" then
        t.Fatal("mutual tail-call loop does not type-check: " + failure + "\n" + source)
      end
    end
    case Err(message) => t.Fatal("GenerateFiles() failed: " + message)
  end
end
