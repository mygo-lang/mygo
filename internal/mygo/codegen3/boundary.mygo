package codegen3
# Inline Go and canonical boundary emission. The IR keeps `{name}` operand
# spellings so codegen3 can substitute values and types into user-authored Go.
# Snippets that require the retired interface-based ADT shape are rejected with
# a located diagnostic instead of being emitted.

import ir3 "github.com/mygo-lang/mygo/internal/mygo/ir3"
import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import goast "go:github.com/mygo-lang/mygo/internal/mygo/codegen2/goast"

# Generic functions accepting Option[A] use the value layout even when A is a
# reference. At a concrete Option[Ref[T]] call site, bridge that value layout
# to the specialized pointer layout without evaluating the operand twice.
func genericOptionBoundary(formal: ast2.MonoType, actual: Option[ast2.MonoType]) -> Bool
  if !isOptionRefType(actual) then
    false
  else
    switch formal
      case TApp(ctor, args) then
        switch ctor.value()
          case TCon(name) then
            if name == "Option" && args.Len() == 1 then
              switch args.Get(0)
                case Some(inner) => !isRefMono(inner)
                case None => false
              end
            else
              false
            end
          end
          case _ => false
        end
      end
      case _ => false
    end
  end
end

func genericFormalParam(typ: Option[ast2.MonoType], index: Int) -> Option[ast2.MonoType]
  switch typ
    case Some(TFunc(params, _)) => params.Get(index)
    case _ => None
  end
end

func goGenericBoundaryArgs(
  args: Slice[ir3.Expr],
  formal: Option[ast2.MonoType],
  index: Int,
  out: Slice[goast.Expr]
) -> Result[Slice[goast.Expr], String]
  if index >= args.Len() then
    Ok(out)
  else
    switch args.Get(index)
      case None => Err("codegen3 missing generic call argument")
      case Some(arg) then
        switch goExpr(arg)
          case Err(message) => Err(message)
          case Ok(value) then
            let adapted = switch genericFormalParam(formal, index)
              case Some(param) then
                if genericOptionBoundary(param, arg.Type) then
                  optionRefToGeneric(value, arg.Type)
                else
                  value
                end
              end
              case None => value
            end
            goGenericBoundaryArgs(args, formal, index + 1, out.Append(adapted))
          end
        end
      end
    end
  end
end

func optionRefToGeneric(value: goast.Expr, typ: Option[ast2.MonoType]) -> goast.Expr
  switch typ
    case Some(mono) then
      let ptrType = ir3.GoTypeString(mono, [])
      let optionType = "Option[" + ptrType + "]"
      let param = goast.Ident("__mygo_option_ref")
      let none = goast.Call(goast.MustExpr(preludeCtorName("Option", "None") + "[" + ptrType + "]"), [])
      let some = goast.Call(goast.MustExpr(preludeCtorName("Option", "Some") + "[" + ptrType + "]"), [param])
      let body = [
        goast.IfOnly(goast.Binary(param, "==", goast.Ident("nil")), [goast.Return([none])]),
        goast.Return([some]),
      ]
      goast.Call(goast.FuncLitFromStmts(["__mygo_option_ref"], [ptrType], [optionType], body), [value])
    end
    case None => value
  end
end

func goGenericBoundaryResult(value: goast.Expr, actual: Option[ast2.MonoType], formal: Option[ast2.MonoType]) -> Result[goast.Expr, String]
  switch formal
    case Some(TFunc(_, ret)) then
      if genericOptionBoundary(ret.value(), actual) then
        optionRefFromGeneric(value, actual)
      else
        Ok(value)
      end
    end
    case _ => Ok(value)
  end
end

func optionRefFromGeneric(value: goast.Expr, typ: Option[ast2.MonoType]) -> Result[goast.Expr, String]
  switch typ
    case Some(mono) then
      let ptrType = ir3.GoTypeString(mono, [])
      let param = goast.Ident("__mygo_option_value")
      switch enumTagLayoutForType(typ)
        case None => Err("codegen3 has no enum tag layout for generic Option boundary")
        case Some(layout) then
          switch layout.VariantIDs.Get("Some")
            case None => Err("codegen3 enum tag layout has no Some variant")
            case Some(tagID) then
              let condition = goast.Binary(
                goast.Selector(param, layout.FieldName),
                "==",
                goast.MustExpr(tagID.ToString())
              )
              let payload = if isCompactTaggedType(typ) then
                goast.MustExpr(
                  "(" + goast.MustExprSource(param) + ").Data.(" +
                    compactPayloadGoType(typ, "Some") + ").F0"
                )
              else
                goast.Selector(goast.Selector(param, "Some"), "F0")
              end
              let body = [
                goast.IfOnly(condition, [goast.Return([payload])]),
                goast.Return([goast.Ident("nil")]),
              ]
              Ok(goast.Call(goast.FuncLitFromStmts(["__mygo_option_value"], ["Option[" + ptrType + "]"], [ptrType], body), [value]))
            end
          end
      end
    end
    end
    case None => Ok(value)
  end
end

struct InlineGoRawPlan
  Kind: String
  Payload: ast2.MonoType
  ErrorGo: String
end

func inlineGoRawCtorName(t: ast2.MonoType) -> Option[String]
  switch t
    case TCon(name) => Some(name)
    case TApp(ctor, _) then
      switch ctor.value()
        case TCon(name) => Some(name)
        case TQualifiedName(_, inner) => inlineGoRawCtorName(inner.value())
        case _ => None
      end
    end
    case TQualifiedName(_, inner) => inlineGoRawCtorName(inner.value())
    case _ => None
  end
end

func inlineGoRawSame(a: ast2.MonoType, b: ast2.MonoType) -> Bool
  if ast2.MonoEqual(a, b) then
    true
  else
    ir3.GoTypeString(a, []) == ir3.GoTypeString(b, [])
  end
end

func inlineGoRawOptionInner(t: ast2.MonoType) -> Option[ast2.MonoType]
  switch inlineGoRawCtorName(t)
    case Some(name) =>
      if name != "Option" then
        None
      else
        switch t
          case TApp(_, args) => if args.Len() == 1 then args.Get(0) else None end
          case TQualifiedName(_, inner) => inlineGoRawOptionInner(inner.value())
          case _ => None
        end
      end
    case None => None
  end
end

func inlineGoRawResultArgs(t: ast2.MonoType) -> Option[(ast2.MonoType, ast2.MonoType)]
  switch inlineGoRawCtorName(t)
    case Some(name) =>
      if name != "Result" then
        None
      else
        switch t
          case TApp(_, args) =>
            if args.Len() == 2 then
              switch (args.Get(0), args.Get(1))
                case (Some(payload), Some(errType)) => Some((payload, errType))
                case _ => None
              end
            else
              None
            end
          case TQualifiedName(_, inner) => inlineGoRawResultArgs(inner.value())
          case _ => None
        end
      end
    case None => None
  end
end

func inlineGoRawTuplePair(t: ast2.MonoType) -> Option[(ast2.MonoType, ast2.MonoType)]
  switch t
    case TTuple(items) then
      if items.Len() == 2 then
        switch (items.Get(0), items.Get(1))
          case (Some(first), Some(second)) => Some((first, second))
          case _ => None
        end
      else
        None
      end
    end
    case _ => None
  end
end

func inlineGoRawIsBool(t: ast2.MonoType) -> Bool
  switch inlineGoRawCtorName(t)
    case Some(name) => name == "Bool"
    case None => false
  end
end

func inlineGoRawIsString(t: ast2.MonoType) -> Bool
  switch inlineGoRawCtorName(t)
    case Some(name) => name == "String"
    case None => false
  end
end

func inlineGoRawIsErrorOrString(t: ast2.MonoType) -> Bool
  isErrorMono(t) || inlineGoRawIsString(t)
end

func inlineGoRawPlan(target: ast2.MonoType, raw: ast2.MonoType) -> InlineGoRawPlan
  if ast2.MonoEqual(target, raw) then
    InlineGoRawPlan { Kind: "Identity", Payload: ast2.MonoType.TUnit, ErrorGo: "" }
  else
    switch inlineGoRawOptionInner(target)
      case Some(inner) then
        if isRefMono(inner) then
          if ast2.MonoEqual(inner, raw) then
            InlineGoRawPlan { Kind: "OptionRef", Payload: inner, ErrorGo: "" }
          else
            InlineGoRawPlan { Kind: "Unsupported", Payload: ast2.MonoType.TUnit, ErrorGo: "" }
          end
        else
          switch inlineGoRawTuplePair(raw)
            case Some(pair) then
              let (first, second) = pair
              if inlineGoRawSame(first, inner) && inlineGoRawIsBool(second) then
                InlineGoRawPlan { Kind: "Option", Payload: inner, ErrorGo: "" }
              else
                InlineGoRawPlan { Kind: "Unsupported", Payload: ast2.MonoType.TUnit, ErrorGo: "" }
              end
            end
            case None =>
              InlineGoRawPlan { Kind: "Unsupported", Payload: ast2.MonoType.TUnit, ErrorGo: "" }
          end
        end
      end
      case None =>
        switch inlineGoRawResultArgs(target)
          case Some(pair) then
            let (payload, errType) = pair
            if !inlineGoRawIsErrorOrString(errType) then
              InlineGoRawPlan { Kind: "Unsupported", Payload: ast2.MonoType.TUnit, ErrorGo: "" }
            else
              let errGo = if inlineGoRawIsString(errType) then "string" else "error" end
              switch inlineGoRawTuplePair(raw)
                case Some(rawPair) then
                  let (rawPayload, rawErr) = rawPair
                  if inlineGoRawSame(rawPayload, payload) && isErrorMono(rawErr) then
                    InlineGoRawPlan { Kind: "Result", Payload: payload, ErrorGo: errGo }
                  else
                    InlineGoRawPlan { Kind: "Unsupported", Payload: ast2.MonoType.TUnit, ErrorGo: "" }
                  end
                end
                case None =>
                  if isUnitMono(payload) && isErrorMono(raw) then
                    InlineGoRawPlan { Kind: "ResultLoneError", Payload: payload, ErrorGo: errGo }
                  else
                    InlineGoRawPlan { Kind: "Unsupported", Payload: ast2.MonoType.TUnit, ErrorGo: "" }
                  end
              end
            end
          end
          case None =>
            InlineGoRawPlan { Kind: "Unsupported", Payload: ast2.MonoType.TUnit, ErrorGo: "" }
        end
    end
  end
end

func inlineGoRawTypeText(t: ast2.MonoType) -> String
  ir3.GoTypeString(t, [])
end

func inlineGoRawErrorValue(errName: String, errGo: String) -> goast.Expr
  if errGo == "string" then
    goast.Call(goast.Selector(goast.Ident(errName), "Error"), [] as Slice[goast.Expr])
  else
    goast.Ident(errName)
  end
end

func inlineGoRawEmit(
  target: ast2.MonoType,
  raw: goast.Expr,
  plan: InlineGoRawPlan
) -> Result[goast.Expr, String]
  switch plan.Kind
    case "Identity" => Ok(raw)
    case "OptionRef" then
      if ir3.CanonicalOptionRepresentation() then
        Ok(raw)
      else
        inlineGoRawEmitOptionRef(target, raw, plan.Payload)
      end
    end
    case "Option" => inlineGoRawEmitOption(target, raw, plan.Payload)
    case "Result" => inlineGoRawEmitResult(target, raw, plan)
    case "ResultLoneError" => inlineGoRawEmitLoneError(target, raw, plan)
    case _ => Err("unsupported inline-Go raw boundary")
  end
end

func inlineGoRawEmitOptionRef(
  target: ast2.MonoType,
  raw: goast.Expr,
  payload: ast2.MonoType
) -> Result[goast.Expr, String]
  let optionGo = ir3.GoTypeString(target, [])
  let innerGo = ir3.GoTypeString(payload, [])
  let refName = "__mygo_raw_ref"
  let bind = goast.Assign([goast.Ident(refName)], ":=", [goast.Paren(raw)])
  let none = goast.GenericCall(goast.Ident(preludeCtorName("Option", "None")), [innerGo], [] as Slice[goast.Expr])
  let some = goast.GenericCall(goast.Ident(preludeCtorName("Option", "Some")), [innerGo], [goast.Ident(refName)])
  let body = [
    bind,
    goast.IfOnly(goast.Binary(goast.Ident(refName), "==", goast.Ident("nil")), [goast.Return([none])]),
    goast.Return([some]),
  ]
  Ok(goast.Call(goast.FuncLitFromStmts([] as Slice[String], [] as Slice[String], [optionGo], body), [] as Slice[goast.Expr]))
end

func inlineGoRawEmitOption(
  target: ast2.MonoType,
  raw: goast.Expr,
  payload: ast2.MonoType
) -> Result[goast.Expr, String]
  let optionGo = ir3.GoTypeString(target, [])
  let innerGo = ir3.GoTypeString(payload, [])
  let valueName = "__mygo_raw_value"
  let okName = "__mygo_raw_ok"
  let bind = goast.Assign([goast.Ident(valueName), goast.Ident(okName)], ":=", [goast.Paren(raw)])
  let none = goast.GenericCall(goast.Ident(preludeCtorName("Option", "None")), [innerGo], [] as Slice[goast.Expr])
  let some = goast.GenericCall(goast.Ident(preludeCtorName("Option", "Some")), [innerGo], [goast.Ident(valueName)])
  let body = [
    bind,
    goast.IfOnly(goast.Unary("!", goast.Ident(okName)), [goast.Return([none])]),
    goast.Return([some]),
  ]
  Ok(goast.Call(goast.FuncLitFromStmts([] as Slice[String], [] as Slice[String], [optionGo], body), [] as Slice[goast.Expr]))
end

func inlineGoRawEmitResult(
  target: ast2.MonoType,
  raw: goast.Expr,
  plan: InlineGoRawPlan
) -> Result[goast.Expr, String]
  let resultGo = ir3.GoTypeString(target, [])
  let payloadGo = ir3.GoTypeString(plan.Payload, [])
  let valueName = "__mygo_raw_value"
  let errName = "__mygo_raw_err"
  let bind = goast.Assign([goast.Ident(valueName), goast.Ident(errName)], ":=", [goast.Paren(raw)])
  let ok = goast.GenericCall(goast.Ident(preludeCtorName("Result", "Ok")), [payloadGo, plan.ErrorGo], [goast.Ident(valueName)])
  let err = goast.GenericCall(goast.Ident(preludeCtorName("Result", "Err")), [payloadGo, plan.ErrorGo], [inlineGoRawErrorValue(errName, plan.ErrorGo)])
  let body = [
    bind,
    goast.IfOnly(goast.Binary(goast.Ident(errName), "!=", goast.Ident("nil")), [goast.Return([err])]),
    goast.Return([ok]),
  ]
  Ok(goast.Call(goast.FuncLitFromStmts([] as Slice[String], [] as Slice[String], [resultGo], body), [] as Slice[goast.Expr]))
end

func inlineGoRawEmitLoneError(
  target: ast2.MonoType,
  raw: goast.Expr,
  plan: InlineGoRawPlan
) -> Result[goast.Expr, String]
  let resultGo = ir3.GoTypeString(target, [])
  let payloadGo = ir3.GoTypeString(plan.Payload, [])
  let errName = "__mygo_raw_err"
  let bind = goast.Assign([goast.Ident(errName)], ":=", [goast.Paren(raw)])
  let ok = goast.GenericCall(goast.Ident(preludeCtorName("Result", "Ok")), [payloadGo, plan.ErrorGo], [goast.Unit()])
  let err = goast.GenericCall(goast.Ident(preludeCtorName("Result", "Err")), [payloadGo, plan.ErrorGo], [inlineGoRawErrorValue(errName, plan.ErrorGo)])
  let body = [
    bind,
    goast.IfOnly(goast.Binary(goast.Ident(errName), "!=", goast.Ident("nil")), [goast.Return([err])]),
    goast.Return([ok]),
  ]
  Ok(goast.Call(goast.FuncLitFromStmts([] as Slice[String], [] as Slice[String], [resultGo], body), [] as Slice[goast.Expr]))
end

func foreignRawTypeOperand(
  operands: Slice[ir3.ForeignTypeOperand],
  index: Int
) -> Option[ast2.MonoType]
  if index >= operands.Len() then
    None
  else
    switch operands.Get(index)
      case Some(operand) =>
        if operand.Name == "__mygo_inline_raw" then Some(operand.Type) else foreignRawTypeOperand(operands, index + 1) end
      case None => foreignRawTypeOperand(operands, index + 1)
    end
  end
end

func foreignExprGo(
  expr: ir3.Expr,
  code: String,
  typeOperands: Slice[ir3.ForeignTypeOperand],
  operands: Slice[ir3.ForeignOperand]
) -> Result[goast.Expr, String]
  let rawType = foreignRawTypeOperand(typeOperands, 0)
  switch expr.Type
    case Some(typ) then
      switch rawType
        case Some(rawMono) then
          let rawPlan = inlineGoRawPlan(typ, rawMono)
          if rawPlan.Kind == "Unsupported" then
            Err(locatedBoundaryError(
              expr.Pos,
              "unsupported inline-Go raw boundary: target " +
                inlineGoRawTypeText(typ) +
                ", raw " +
                inlineGoRawTypeText(rawMono)
            ))
          else
            let valueNames = foreignValueNames(operands, 0, [])
            let typeNames = foreignTypeNames(typeOperands, 0, [])
            let typeSources = foreignTypeSources(typeOperands, 0, [])
            switch foreignValueSources(operands, 0, [])
              case Ok(valueSources) then
                if !goast.IsInlineGoExpressionWithOperands(code, valueNames, valueSources, typeNames, typeSources) then
                  Err(locatedBoundaryError(expr.Pos, "inline-Go raw declaration requires an expression-form body"))
                else
                  let raw = goast.MustInlineGoExprWithOperands(code, valueNames, valueSources, typeNames, typeSources)
                  inlineGoRawEmit(typ, raw, rawPlan)
                end
              end
              case Err(message) => Err(message)
            end
          end
        end
        case None then
          let canonicalPrelude = isCanonicalImportPath(preludeImportPath())
          let plan = ir3.PlanInlineGoBoundaryForABI(typ, code, canonicalPrelude)
          switch plan.Kind
            case Incompatible => Err(locatedBoundaryError(expr.Pos, plan.Reason))
            case _ then
              let valueNames = foreignValueNames(operands, 0, [])
              let typeNames = foreignTypeNames(typeOperands, 0, [])
              let typeSources = foreignTypeSources(typeOperands, 0, [])
              switch foreignValueSources(operands, 0, [])
                case Ok(valueSources) then
                  Ok(goast.MustInlineGoExprWithOperands(
                    code,
                    valueNames,
                    valueSources,
                    typeNames,
                    typeSources
                  ))
                end
                case Err(message) => Err(message)
              end
            end
          end
        end
      end
    end
    case None => Err(locatedBoundaryError(expr.Pos, "inline Go value has no type"))
  end
end

# Inline Go in statement position is a Go statement list, not an expression:
# `x := ...`, `if ... {}` and assignments are all valid there. `final` selects
# the tail form, where an expression snippet becomes the returned value.
func foreignStmtStmts(
  expr: ir3.Expr,
  code: String,
  typeOperands: Slice[ir3.ForeignTypeOperand],
  operands: Slice[ir3.ForeignOperand],
  final: Bool
) -> Result[Slice[goast.Stmt], String]
  let rawType = foreignRawTypeOperand(typeOperands, 0)
  switch expr.Type
    case Some(typ) then
      switch rawType
        case Some(rawMono) then
          if !final then
            Err(locatedBoundaryError(expr.Pos, "inline-Go raw declaration requires a value context"))
          else
            let rawPlan = inlineGoRawPlan(typ, rawMono)
            if rawPlan.Kind == "Unsupported" then
              Err(locatedBoundaryError(
                expr.Pos,
                "unsupported inline-Go raw boundary: target " +
                  inlineGoRawTypeText(typ) +
                  ", raw " +
                  inlineGoRawTypeText(rawMono)
              ))
            else
              let valueNames = foreignValueNames(operands, 0, [])
              let typeNames = foreignTypeNames(typeOperands, 0, [])
              let typeSources = foreignTypeSources(typeOperands, 0, [])
              switch foreignValueSources(operands, 0, [])
                case Ok(valueSources) then
                  if !goast.IsInlineGoExpressionWithOperands(code, valueNames, valueSources, typeNames, typeSources) then
                    Err(locatedBoundaryError(expr.Pos, "inline-Go raw declaration requires an expression-form body"))
                  else
                    let raw = goast.MustInlineGoExprWithOperands(code, valueNames, valueSources, typeNames, typeSources)
                    switch inlineGoRawEmit(typ, raw, rawPlan)
                      case Ok(value) => Ok([goast.Return([value])])
                      case Err(message) => Err(locatedBoundaryError(expr.Pos, message))
                    end
                  end
                end
                case Err(message) => Err(message)
              end
            end
          end
        end
        case None then
          let canonicalPrelude = isCanonicalImportPath(preludeImportPath())
          let plan = ir3.PlanInlineGoBoundaryForABI(typ, code, canonicalPrelude)
          switch plan.Kind
            case Incompatible => Err(locatedBoundaryError(expr.Pos, plan.Reason))
            case _ then
              let valueNames = foreignValueNames(operands, 0, [])
              let typeNames = foreignTypeNames(typeOperands, 0, [])
              let typeSources = foreignTypeSources(typeOperands, 0, [])
              switch foreignValueSources(operands, 0, [])
                case Ok(valueSources) then
                  if final then
                    Ok(goast.MustInlineGoFinalStatementsWithOperands(
                      code,
                      valueNames,
                      valueSources,
                      typeNames,
                      typeSources
                    ))
                  else
                    Ok(goast.MustInlineGoStatementsWithOperands(
                      code,
                      valueNames,
                      valueSources,
                      typeNames,
                      typeSources
                    ))
                  end
                end
                case Err(message) => Err(message)
              end
            end
          end
        end
      end
    end
    case None => Err(locatedBoundaryError(expr.Pos, "inline Go statements have no type"))
  end
end

func isOptionRefType(typ: Option[ast2.MonoType]) -> Bool
  switch typ
    case Some(mono) => isOptionRefMono(mono)
    case None => false
  end
end

func isOptionRefMono(mono: ast2.MonoType) -> Bool
  # Only the canonical ABI lays Option[Ref[T]] out as *T.  With a legacy
  # prelude the value keeps the interface shape, so nil checks do not apply.
  if !ir3.CanonicalOptionRepresentation() then
    false
  else
    switch mono
      case TApp(ctor, args) then
        switch ctor.value()
          case TCon(name) => name == "Option" && args.Len() == 1 && firstArgIsRef(args)
          case _ => false
        end
      end
      case _ => false
    end
  end
end

func firstArgIsRef(args: Slice[ast2.MonoType]) -> Bool
  switch args.Get(0)
    case Some(inner) => isRefMono(inner)
    case None => false
  end
end

func isRefMono(mono: ast2.MonoType) -> Bool
  switch inlineGoRawCtorName(mono)
    case Some(name) => name == "Ref"
    case None => false
  end
end

func optionRefApply(
  expr: ir3.Expr,
  callee: ir3.Expr,
  args: Slice[ir3.Expr]
) -> Result[Option[goast.Expr], String]
  if !isOptionRefType(expr.Type) then
    Ok(None)
  else
    switch callee.Kind
      case VarExpr(name) then
        if name == "None" && args.Len() == 0 then
          Ok(Some(goast.MustExpr("nil")))
        elsif name == "Some" && args.Len() == 1 then
          someRefValue(args)
        else
          Ok(None)
        end
      end
      case _ => Ok(None)
    end
  end
end

func someRefValue(args: Slice[ir3.Expr]) -> Result[Option[goast.Expr], String]
  switch args.Get(0)
    case Some(arg) then
      switch goExpr(arg)
        case Ok(value) => Ok(Some(value))
        case Err(message) => Err(message)
      end
    end
    case None => Err("Some() argument is missing")
  end
end

func locatedBoundaryError(pos: ast2.SourcePos, message: String) -> String
  pos.SourceName +
    ":" +
    pos.Line.ToString() +
    ":" +
    pos.Column.ToString() +
    ": inline Go boundary: " +
    message
end

func locatedFFIError(pos: ast2.SourcePos, message: String) -> String
  pos.SourceName +
    ":" +
    pos.Line.ToString() +
    ":" +
    pos.Column.ToString() +
    ": Go FFI boundary: " +
    message
end

func foreignValueNames(
  operands: Slice[ir3.ForeignOperand],
  index: Int,
  out: Slice[String]
) -> Slice[String]
  if index >= operands.Len() then
    out
  else
    switch operands.Get(index)
      case Some(operand) => foreignValueNames(operands, index + 1, out.Append(operand.Name))
      case None => foreignValueNames(operands, index + 1, out)
    end
  end
end

func foreignValueSources(
  operands: Slice[ir3.ForeignOperand],
  index: Int,
  out: Slice[String]
) -> Result[Slice[String], String]
  if index >= operands.Len() then
    Ok(out)
  else
    switch operands.Get(index)
      case Some(operand) then
        switch goExpr(operand.Value)
          case Ok(value) then
            foreignValueSources(
              operands,
              index + 1,
              out.Append(goast.MustExprSource(value))
            )
          end
          case Err(message) => Err(message)
        end
      end
      case None => foreignValueSources(operands, index + 1, out)
    end
  end
end

func foreignTypeNames(
  operands: Slice[ir3.ForeignTypeOperand],
  index: Int,
  out: Slice[String]
) -> Slice[String]
  if index >= operands.Len() then
    out
  else
    switch operands.Get(index)
      case Some(operand) => foreignTypeNames(operands, index + 1, out.Append(operand.Name))
      case None => foreignTypeNames(operands, index + 1, out)
    end
  end
end

func foreignTypeSources(
  operands: Slice[ir3.ForeignTypeOperand],
  index: Int,
  out: Slice[String]
) -> Slice[String]
  if index >= operands.Len() then
    out
  else
    switch operands.Get(index)
      case Some(operand) then
        foreignTypeSources(
          operands,
          index + 1,
          out.Append(ir3.GoTypeString(operand.Type, []))
        )
      end
      case None => foreignTypeSources(operands, index + 1, out)
    end
  end
end
