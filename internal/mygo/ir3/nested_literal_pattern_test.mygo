package ir3

import testing "go:testing"
import strings "go:strings"
import parser2 "github.com/mygo-lang/mygo/internal/mygo/parser2"

# A literal nested in a variant pattern must survive parsing and lowering as a
# comparison, not degrade into "matches any TCon".
func TestNestedLiteralPatternLowering(t: Ref[testing.T]) -> ()
  let source = """package sample
func pick(t: Tag) -> Int
  switch t
    case TCon("Option") => 1
    case _ => 0
  end
end
"""
  switch parser2.ParseFileAt("sample.mygo", source)
    case Ok(file) then
      let dump = DumpPackage(LowerFile(file, "example.com/sample"))
      if !strings.Contains(dump, "literal:string:Option") then
        t.Fatal("nested literal pattern was dropped during lowering: " + dump)
      end
    end
    case Err(message) => t.Fatal(message)
  end
end

func TestBooleanLiteralPatternLowering(t: Ref[testing.T]) -> ()
  let source = """package sample
func pick(flag: Bool) -> Int
  switch flag
    case true => 1
    case false => 0
  end
end
"""
  switch parser2.ParseFileAt("sample.mygo", source)
    case Ok(file) then
      let dump = DumpPackage(LowerFile(file, "example.com/sample"))
      if !strings.Contains(dump, "literal:bool:true") || !strings.Contains(dump, "literal:bool:false") then
        t.Fatal("boolean literal patterns must keep their kind and value in IR tags: " + dump)
      end
    end
    case Err(message) => t.Fatal(message)
  end
end
