package codegen2

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import goast "go:github.com/mygo-lang/mygo/internal/mygo/codegen2/goast"
import fmt "go:fmt"

func expressionPanicDiagnostic(expr: ast2.Expr, message: String) -> ast2.Diagnostic
  let category = switch expr.Kind
    case InlineGoExpr(_, _, _, _) => "source"
    case _ => "internal"
  end
  ast2.DiagnosticAtExpr(
    ast2.NewDiagnostic("generate", "go-ast-expression", category, message),
    expr
  )
end

func locateStatementResult(
  result: Result[Slice[goast.Stmt], ast2.Diagnostic],
  expr: ast2.Expr,
  ctx: Ref[egCtx]
) -> Result[Slice[goast.Stmt], ast2.Diagnostic]
  switch result
    case Err(diagnostic) => Err(ast2.DiagnosticAtExpr(diagnostic, expr))
    case Ok(items) then
      let _ = items.Fold(
        0,
        func(count: Int, item: goast.Stmt) -> Int
          go[()] { code: "goast.Mark({ctx}.origins, {item}, expressionOrigin({expr}))" in ctx = ctx in item = item in expr = expr }
          count + 1
        end
      )
      Ok(items)
    end
  end
end

func protectStatementGeneration(
  expr: ast2.Expr,
  work: func() -> Result[Slice[goast.Stmt], ast2.Diagnostic]
) -> Result[Slice[goast.Stmt], ast2.Diagnostic]
  # `recover` runs in the Go helper's deferred frame; the recovered cause
  # becomes a diagnostic through the ABI-neutral Result constructors there.
  go[Result[Slice[goast.Stmt], ast2.Diagnostic]] {
    code: "protectStatementRun({expr}, {work})"
    in expr = expr
    in work = work
  }
end

# recover must execute in a deferred Go frame; classification and enrichment
# remain ordinary MyGO functions.
func protectExpressionGeneration(
  expr: ast2.Expr,
  ctx: Ref[egCtx],
  expected: ast2.MonoType
) -> Result[AstExprResult, ast2.Diagnostic]
  go[Result[AstExprResult, ast2.Diagnostic]] {
    code: "protectExpressionRun({expr}, {ctx}, {expected})"
    in expr = expr
    in ctx = ctx
    in expected = expected
  }
end

func protectDeclarationGeneration(
  g: Ref[Generator2],
  decls: Slice[ast2.Decl],
  index: Int,
  out: Slice[goast.Decl]
) -> Result[Slice[goast.Decl], ast2.Diagnostic]
  go[Result[Slice[goast.Decl], ast2.Diagnostic]] {
    code: "protectDeclRun({g}, {decls}, {index}, {out})"
    in g = g
    in decls = decls
    in index = index
    in out = out
    in fmt = fmt
  }
end
