package codegen2

import testing "go:testing"
import strings "go:strings"

func TestMutualTailSortStringsPreservesInput(t: Ref[testing.T]) -> ()
  let input = ["z", "a", "b", "a", ""]
  let sorted = mtSortStrings(input)
  if strings.Join(sorted, "|") != "|a|a|b|z" || strings.Join(input, "|") != "z|a|b|a|" then
    t.Fatalf("unexpected sorted values %v or modified input %v", sorted, input)
  end
  sorted.Set(0, "changed")
  if strings.Join(input, "|") != "z|a|b|a|" then
    t.Fatal("sorted result aliases input")
  end
  let empty = mtSortStrings(Zero[Slice[String]]())
  if empty.Len() != 0 || go[Bool] { code: "{items} == nil"; in items = empty } then
    t.Fatal("empty result should be a non-nil empty slice")
  end
end
