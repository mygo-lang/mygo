package codegen2
import common2 "github.com/mygo-lang/mygo/internal/mygo/common2"

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import goast "go:github.com/mygo-lang/mygo/internal/mygo/codegen2/goast"
import typeinference2 "github.com/mygo-lang/mygo/internal/mygo/typeinference2"
import strings "go:strings"

struct GoFileParts
  PackageName: String
  Imports: Slice[GoImportPart]
  AstDecls: Slice[goast.Decl]
  Decls: Slice[String]
  Origins: Ref[goast.Origins]
  SourceName: String
  GeneratedName: String
end

struct GoImportPart
  Alias: String
  Path: String
end

struct SourceFileInput
  Path: String
  File: ast2.File
  AutomaticImports: Slice[GoImportPart]
  PackageImportPath: String
end

func NewSourceFileInput(path: String, file: ast2.File) -> SourceFileInput
  SourceFileInput { Path: path, File: file, AutomaticImports: [], PackageImportPath: "" }
end

func SourceFileInputWithPackageImportPath(
  input: SourceFileInput,
  importPath: String
) -> SourceFileInput
  SourceFileInput {
    Path: input.Path,
    File: input.File,
    AutomaticImports: input.AutomaticImports,
    PackageImportPath: importPath,
  }
end

func SourceFileInputWithAutomaticImport(
  input: SourceFileInput,
  alias: String,
  path: String
) -> SourceFileInput
  SourceFileInput {
    Path: input.Path,
    File: input.File,
    AutomaticImports: input.AutomaticImports.Append(GoImportPart {
      Alias: alias,
      Path: path,
    }),
    PackageImportPath: input.PackageImportPath,
  }
end

func GenerateDiagnostic(
  file: ast2.File,
  info: typeinference2.PackageInfo
) -> Result[String, ast2.Diagnostic]
  let path = file.PackageName + ".mygo"
  let files = GenerateFilesDiagnostic(
    [SourceFileInput { Path: path, File: file, AutomaticImports: [] }],
    info
  )
  switch files
    case Ok(out) then
      switch out.Get(sourceToGenName(path))
        case Some(source) => Ok(source)
        case None => Err(generationDiagnostic("generated source is missing for " + path))
      end
    end
    case Err(msg) => Err(msg)
  end
end

func GenerateFilesDiagnostic(
  files: Slice[SourceFileInput],
  info: typeinference2.PackageInfo
) -> Result[Map[String, String], ast2.Diagnostic]
  GenerateFilesCore(files, info)
end

func GenerateFilesCore(
  files: Slice[SourceFileInput],
  info: typeinference2.PackageInfo
) -> Result[Map[String, String], ast2.Diagnostic]
  # Merge all file declarations so cross-file method dispatch (e.g. tail.Map
  # from list.mygo resolving to the Option IEnumerable impl in option.mygo)
  # works through seedPackageDictionaries / seedImplCandidates.
  let allDecls = mergeFileDecls(files, 0, [] as Slice[ast2.Decl])
  let visibleDecls = mergeDeclSlices(info.ExternalTypedDecls, info.TypedDecls)
  # All emitted files in this package share the same declaration universe, so
  # build lowering metadata once for the complete GenerateFiles invocation.
  let packageIndex = newPackageIndexWithImports(visibleDecls, info.MyGoPackages)
  let typedByPath = typedDeclSourceMap(info.TypedDeclSources, 0, {})
  # The mutual tail-call plan spans every source file of the package, so it is
  # also built once here and threaded through the per-file generator contexts.
  # The analysis reads the typed declaration bodies (TypedDeclSources) so the
  # trampoline member lowering sees the inferred type annotations.
  switch files.Get(0)
    case None then
      if files.Len() == 0 then
        Ok({})
      else
        Err(generationDiagnostic("source file index is missing before code generation"))
      end
    end
    case Some(first) then
      let mutualTail = buildMutualTailPlans(first.File.PackageName, files, info.TypedDeclSources)
      let out: Map[String, String] = {}
      let generated = generateFilesLoop(files, info, allDecls, packageIndex, typedByPath, mutualTail, 0, out)
      switch generated
        case Err(msg) => Err(msg)
        case Ok(outputs) then
          switch appendDynamicDispatchFile(outputs, files, info.MyGoPackages)
            case Err(msg) => Err(msg)
            case Ok(withDynamicDispatch) then
              appendDynamicMetadataFile(withDynamicDispatch, files, info.MyGoPackages)
            end
          end
        end
      end
    end
  end
end

# dynamicDispatchDeclsDiagnosticBridge calls the Go bridge that wraps the
# generated-support declarations in a MyGO Result. The Go side uses the
# ABI-neutral prelude constructors, so no ADT is named in the inline snippet.
func dynamicDispatchDeclsDiagnosticBridge(
  packageName: String,
  packageImportPath: String,
  files: Slice[SourceFileInput],
  dependencies: Slice[typeinference2.MyGoPackageInfo]
) -> Result[Slice[ast2.Decl], ast2.Diagnostic]
  go[Result[Slice[ast2.Decl], ast2.Diagnostic]] {
    code: "dynamicDispatchDeclsDiagnostic({packageName}, {packageImportPath}, {files}, {dependencies})"
    in packageName = packageName
    in packageImportPath = packageImportPath
    in files = files
    in dependencies = dependencies
  }
end

func DynamicDispatchDeclsDiagnostic(
  files: Slice[SourceFileInput],
  dependencies: Slice[typeinference2.MyGoPackageInfo]
) -> Result[Slice[ast2.Decl], ast2.Diagnostic]
  switch files.Get(0)
    case None => Ok([])
    case Some(first) then
      dynamicDispatchDeclsDiagnosticBridge(
        first.File.PackageName,
        first.PackageImportPath,
        files,
        dependencies
      )
    end
  end
end

# The generated files are Go maps owned by the Go side; the bridge wraps them in
# the caller's Result representation without naming any ADT in inline Go.
func appendDynamicDispatchFileBridge(
  outputs: Map[String, String],
  files: Slice[SourceFileInput],
  dependencies: Slice[typeinference2.MyGoPackageInfo]
) -> Result[Map[String, String], ast2.Diagnostic]
  go[Result[Map[String, String], ast2.Diagnostic]] {
    code: "appendDynamicDispatchOutput({outputs}, {files}, {dependencies})"
    in outputs = outputs
    in files = files
    in dependencies = dependencies
  }
end

func appendDynamicDispatchFile(
  outputs: Map[String, String],
  files: Slice[SourceFileInput],
  dependencies: Slice[typeinference2.MyGoPackageInfo]
) -> Result[Map[String, String], ast2.Diagnostic]
  appendDynamicDispatchFileBridge(outputs, files, dependencies)
end

func appendDynamicMetadataFileBridge(
  outputs: Map[String, String],
  files: Slice[SourceFileInput],
  dependencies: Slice[typeinference2.MyGoPackageInfo]
) -> Result[Map[String, String], ast2.Diagnostic]
  go[Result[Map[String, String], ast2.Diagnostic]] {
    code: "appendDynamicMetadataOutput({outputs}, {files}, {dependencies})"
    in outputs = outputs
    in files = files
    in dependencies = dependencies
  }
end

func appendDynamicMetadataFile(
  outputs: Map[String, String],
  files: Slice[SourceFileInput],
  dependencies: Slice[typeinference2.MyGoPackageInfo]
) -> Result[Map[String, String], ast2.Diagnostic]
  appendDynamicMetadataFileBridge(outputs, files, dependencies)
end

func importedMyGoDecls(
  packages: Slice[typeinference2.MyGoPackageInfo],
  index: Int,
  out: Slice[ast2.Decl]
) -> Slice[ast2.Decl]
  if index >= packages.Len() then
    out
  else
    switch packages.Get(index)
      case None => importedMyGoDecls(packages, index + 1, out)
      case Some(pkg) => importedMyGoDecls(packages, index + 1, mergeDeclSlices(out, pkg.Decls))
    end
  end
end

func mergeFileDecls(
  files: Slice[SourceFileInput],
  index: Int,
  acc: Slice[ast2.Decl]
) -> Slice[ast2.Decl]
  if index >= files.Len() then
    acc
  else
    switch files.Get(index)
      case None => mergeFileDecls(files, index + 1, acc)
      case Some(input) => mergeFileDecls(files, index + 1, mergeDeclSlices(acc, input.File.Decls))
    end
  end
end

func mergeDeclSlices(dst: Slice[ast2.Decl], src: Slice[ast2.Decl]) -> Slice[ast2.Decl]
  if src.Len() == 0 then
    dst
  else
    switch src.Get(0)
      case None => dst
      case Some(item) => mergeDeclSlices(dst.Append(item), common2.SliceDrop(src, 1))
    end
  end
end

func generateFilesLoop(
  files: Slice[SourceFileInput],
  info: typeinference2.PackageInfo,
  allDecls: Slice[ast2.Decl],
  packageIndex: PackageIndex,
  typedByPath: Map[String, Slice[ast2.Decl]],
  mutualTail: MutualTailPlans,
  index: Int,
  out: Map[String, String]
) -> Result[Map[String, String], ast2.Diagnostic]
  if index >= files.Len() then
    Ok(out)
  else
    switch files.Get(index)
      case None => Err(generationDiagnostic("source file index is missing during code generation"))
      case Some(input) then
        let typedDecls = typedDeclsForInput(info.TypedDeclSources, typedByPath, input.Path)
        let src = generateOneFile(
          input.File,
          input.Path,
          input.AutomaticImports,
          info,
          allDecls,
          packageIndex,
          typedDecls,
          mutualTail,
          index == 0,
          input.PackageImportPath
        )
        switch src
          case Ok(code) then
            out.Set(sourceToGenName(input.Path), code)
            generateFilesLoop(files, info, allDecls, packageIndex, typedByPath, mutualTail, index + 1, out)
          end
          case Err(msg) => Err(generationSourceContext(msg, input.File.SourceName))
        end
      end
    end
  end
end

func GenerateSourceDiagnostic(input: String) -> Result[String, ast2.Diagnostic]
  GenerateSourceAtDiagnostic("<input>", input)
end

# GenerateSourceAt is the file-aware bootstrap entry point.  In particular it
# preserves parser2's source location in errors instead of reducing every
# input to an anonymous string.
func GenerateSourceAtDiagnostic(
  sourceName: String,
  input: String
) -> Result[String, ast2.Diagnostic]
  let parsed = parseSourceAsAst2At(sourceName, input)
  switch parsed
    case Err(msg) => Err(msg)
    case Ok(file) then
      # Assign unique IDs to every expression node so that codegen2 can
      # look up type-inference results by comparing the ID field (which is
      # preserved across value copies) instead of relying on pointer identity.
      switch ast2.AssignFileExprIDs(file)
        case None then
          Err(generationDiagnostic("malformed AST: missing indexed value while assigning expression IDs"))
        end
        case Some(fileWithIDs) then
          let inferred = typeinference2.InferFileDiagnostic(fileWithIDs)
          switch inferred
            case Err(msg) => Err(msg)
            case Ok(info) => GenerateDiagnostic(fileWithIDs, info)
          end
        end
      end
    end
  end
end

func generateOneFile(
  file: ast2.File,
  path: String,
  automaticImports: Slice[GoImportPart],
  info: typeinference2.PackageInfo,
  allDecls: Slice[ast2.Decl],
  packageIndex: PackageIndex,
  fileTypedDecls: Slice[ast2.Decl],
  mutualTail: MutualTailPlans,
  includeHKT: Bool,
  packageImportPath: String
) -> Result[String, ast2.Diagnostic]
  # Method dispatch must see every impl visible to this package: its complete
  # typed declaration set plus externally supplied declarations (the prelude).
  # `fileTypedDecls` below still limits emitted Go declarations to this file.
  let visibleDecls = mergeDeclSlices(info.ExternalTypedDecls, info.TypedDecls)
  let imports = mergeGoImports(collectImports(file.Decls), automaticImports)
  let goCandidates = inferredGoImports(info.GoPackages, imports, 0, [] as Slice[GoImportPart])
  let typeCandidates = inferredMyGoTypeImports(
    inferredTypeImportPaths(fileTypedDecls),
    info.MyGoPackages,
    packageImportPath,
    mergeGoImports(imports, goCandidates)
  )
  let candidateImports = mergeGoImports(goCandidates, typeCandidates)
  let renderImports = mergeGoImports(imports, candidateImports)
  let g = Ref.new(newGenerator2(
    file.PackageName,
    visibleDecls,
    renderImports,
    info.GoPackages,
    info,
    packageIndex
  ))
  g.mutualTail = mutualTail
  g.currentFile = path
  g.positions = info.TypedDeclSources.Find(func(source: typeinference2.PkgDeclSource) -> Bool source.Path == path end).Map(func(source: Ref[typeinference2.PkgDeclSource]) -> Slice[ast2.SourcePos] source.DeclPositions end).UnwrapOr([] as Slice[ast2.SourcePos])
  g.pathAliases.Set("$mygo$strict", "true")
  if packageImportPath != "" then
    g.pathAliases.Set(packageImportPath, "")
  end
  let decls = translateDeclsAst(g, fileTypedDecls, 0, [] as Slice[goast.Decl])
  if g.pathAliases.Get("$mygo$error").IsSome() then
    return Err(generationDiagnostic(g.pathAliases.Get("$mygo$error").UnwrapOr("unresolved foreign type")))
  end
  switch decls
    case Err(msg) => Err(msg)
    case Ok(items) then
      let withHKT = if file.PackageName == "prelude" && includeHKT && needsHKTDecls(allDecls) then
        goast.AppendDecls(goast.HKTDecls(), items)
      else
        items
      end
      # Decide this from the MyGO declarations, before they are lowered to Go.
      # In particular, typeclass dictionaries become mangled Go identifiers;
      # inspecting those identifiers cannot reliably reveal their origin.
      let preludeDecls = preludeDeclsForInfo(info)
      let sourcePrelude = file.PackageName != "prelude" &&
        declsNeedPreludeImport(file.Decls, preludeDecls)
      let importAliases = goast.ReferencedImportAliases(withHKT)
      let emittedImports = mergeGoImports(
        importsUsedByAliases(imports, importAliases, 0, [] as Slice[GoImportPart]),
        importsUsedByAliases(candidateImports, importAliases, 0, [] as Slice[GoImportPart])
      )
      let withoutPrelude = renderGoFile(GoFileParts {
        PackageName: file.PackageName,
        Imports: emittedImports,
        AstDecls: withHKT,
        Origins: g.origins,
        SourceName: path,
        GeneratedName: sourceToGenName(path),
        Decls: [] as Slice[String],
      })
      switch withoutPrelude
        case Err(msg) => Err(msg)
        case Ok(source) then
          let needsPrelude = sourcePrelude || generatedSourceUsesPreludeHelper(source, preludeDecls)
          let withPrelude = if needsPrelude then
            emittedImports.Append(GoImportPart {
              Alias: ".",
              Path: "github.com/mygo-lang/mygo/prelude",
            })
          else
            emittedImports
          end
          if needsPrelude then
            renderFinalGoFile(GoFileParts {
              PackageName: file.PackageName,
              Imports: withPrelude,
              AstDecls: withHKT,
              Origins: g.origins,
              SourceName: path,
              GeneratedName: sourceToGenName(path),
              Decls: [] as Slice[String],
            })
          else
            renderFinalGoFile(GoFileParts {
              PackageName: file.PackageName,
              Imports: emittedImports,
              AstDecls: withHKT,
              Origins: g.origins,
              SourceName: path,
              GeneratedName: sourceToGenName(path),
              Decls: [] as Slice[String],
            })
          end
        end
      end
    end
  end
end

func preludeDeclsForInfo(info: typeinference2.PackageInfo) -> Slice[ast2.Decl]
  if info.ExternalTypedDeclSources.Len() == 0 then
    info.ExternalTypedDecls
  else
    let sourced = preludeDeclsFromSources(info.ExternalTypedDeclSources, 0, [] as Slice[ast2.Decl])
    if sourced.Len() == 0 then
      info.ExternalTypedDecls
    else
      sourced
    end
  end
end

func preludeDeclsFromSources(
  sources: Slice[typeinference2.PkgDeclSource],
  index: Int,
  out: Slice[ast2.Decl]
) -> Slice[ast2.Decl]
  if index >= sources.Len() then
    out
  else
    switch sources.Get(index)
      case None => preludeDeclsFromSources(sources, index + 1, out)
      case Some(source) then
        if isPreludeSourcePath(source.Path) then
          preludeDeclsFromSources(sources, index + 1, appendDeclSlices(out, source.Decls, 0))
        else
          preludeDeclsFromSources(sources, index + 1, out)
        end
      end
    end
  end
end

func appendDeclSlices(
  out: Slice[ast2.Decl],
  decls: Slice[ast2.Decl],
  index: Int
) -> Slice[ast2.Decl]
  if index >= decls.Len() then
    out
  else
    switch decls.Get(index)
      case None => appendDeclSlices(out, decls, index + 1)
      case Some(decl) => appendDeclSlices(out.Append(decl), decls, index + 1)
    end
  end
end

func isPreludeSourcePath(path: String) -> Bool
  strings.Contains("/" + path, "/prelude/")
end

func inferredGoImports(
  packages: Slice[typeinference2.GoPackageEntry],
  existing: Slice[GoImportPart],
  index: Int,
  out: Slice[GoImportPart]
) -> Slice[GoImportPart]
  if index >= packages.Len() then
    out
  else
    switch packages.Get(index)
      case None => inferredGoImports(packages, existing, index + 1, out)
      case Some(pkg) then
        let path = importPathForGo(pkg.Path)
        let alias = if pkg.Alias != "" then
          pkg.Alias
        else
          importAliasForPath(pkg.Path)
        end
        if path == "" || goImportPathExists(path, existing) || goImportPathExists(path, out) then
          inferredGoImports(packages, existing, index + 1, out)
        else
          let uniqueAlias = availableGoImportAlias(alias, path, existing, out, 2)
          inferredGoImports(
            packages,
            existing,
            index + 1,
            out.Append(GoImportPart {
              Alias: uniqueAlias,
              Path: path,
            })
          )
        end
      end
    end
  end
end

func goImportPathExists(path: String, imports: Slice[GoImportPart]) -> Bool
  imports.Fold(false, func(found: Bool, item: GoImportPart) -> Bool found || item.Path == path end)
end

func goImportAliasExists(alias: String, path: String, imports: Slice[GoImportPart]) -> Bool
  imports.Fold(
    false,
    func(found: Bool, item: GoImportPart) -> Bool found || (item.Alias == alias && item.Path != path) end
  )
end

func availableGoImportAlias(
  alias: String,
  path: String,
  existing: Slice[GoImportPart],
  candidates: Slice[GoImportPart],
  suffix: Int
) -> String
  let base = if alias == "" || alias == "_" || alias == "." then
    importAliasForPath(path)
  else
    alias
  end
  if !goImportAliasExists(base, path, existing) && !goImportAliasExists(base, path, candidates) then
    base
  else
    let numbered = base + suffix.ToString()
    if !goImportAliasExists(numbered, path, existing) &&
      !goImportAliasExists(numbered, path, candidates) then
      numbered
    else
      availableGoImportAlias(base, path, existing, candidates, suffix + 1)
    end
  end
end

func importsUsedByAliases(
  candidates: Slice[GoImportPart],
  aliases: Slice[String],
  index: Int,
  out: Slice[GoImportPart]
) -> Slice[GoImportPart]
  if index >= candidates.Len() then
    out
  else
    switch candidates.Get(index)
      case None => importsUsedByAliases(candidates, aliases, index + 1, out)
      case Some(item) then
        if item.Alias == "." ||
          item.Alias == "_" ||
          common2.ContainsString(aliases, item.Alias) then
          importsUsedByAliases(candidates, aliases, index + 1, out.Append(item))
        else
          importsUsedByAliases(candidates, aliases, index + 1, out)
        end
      end
    end
  end
end

# This is deliberately parallel to legacy codegen's declsNeedPreludeImport.
# `ExternalTypedDecls` is the prelude supplied to this package by bootstrap,
# so its enum/interface names are the names made available by the dot import.
func declsNeedPreludeImport(decls: Slice[ast2.Decl], external: Slice[ast2.Decl]) -> Bool
  let names = preludeImportNames(external, [] as Slice[String])
  declsUsePreludeName(decls, names)
end

func preludeImportNames(decls: Slice[ast2.Decl], names: Slice[String]) -> Slice[String]
  if decls.Len() == 0 then
    names
  else
    switch decls.Get(0)
      case None => names
      case Some(decl) then
        let next = switch decl
          case TypeAliasDecl(name, _, _) => names.Append(name)
          case TypeDecl(name, _, _) => names.Append(name)
          case EnumDecl(name, _, variants) => variantImportNames(variants, names.Append(name))
          case InterfaceDecl(name, _, _) then
            names.Append(name)
            # Prelude functions can have FFI signatures expressed with Go
            # built-ins (for example Panic(msg: String) is recorded with
            # `string`). Their names still need to trigger the dot import.
          end
          case FuncDecl(name, _, _, _, _, _) => names.Append(name)
          case _ => names
        end
        preludeImportNames(common2.SliceDrop(decls, 1), next)
      end
    end
  end
end

func variantImportNames(variants: Slice[ast2.Variant], names: Slice[String]) -> Slice[String]
  if variants.Len() == 0 then
    names
  else
    switch variants.Get(0)
      case None => names
      case Some(variant) then
        variantImportNames(common2.SliceDrop(variants, 1), names.Append(variant.Name))
      end
    end
  end
end

func declsUsePreludeName(decls: Slice[ast2.Decl], names: Slice[String]) -> Bool
  if decls.Len() == 0 then
    false
  else
    switch decls.Get(0)
      case None => false
      case Some(decl) then
        declUsesPreludeName(decl, names) || declsUsePreludeName(common2.SliceDrop(decls, 1), names)
      end
    end
  end
end

func declUsesPreludeName(decl: ast2.Decl, names: Slice[String]) -> Bool
  switch decl
    case TypeAliasDecl(_, _, target) => typeUsesPreludeName(target, names)
    case TypeDecl(_, _, target) => typeUsesPreludeName(target, names)
    case FuncDecl(_, _, params, ret, body, requirements) then
      paramsUsePreludeName(params, names) ||
        optionTypeUsesPreludeName(ret, names) ||
        constraintsUsePreludeName(requirements, names) ||
        exprUsesPreludeName(body, names)
    end
    case StructDecl(_, _, fields) => fieldsUsePreludeName(fields, names)
    case EnumDecl(_, _, variants) then
      variantsUsePreludeName(variants, names)
      # Typeclass interfaces are erased by codegen2. Their signatures must not
      # cause a per-file Go import that has no emitted use.
    end
    case InterfaceDecl(_, _, _) => false
    case ImplDecl(_, target, iface, methods) then
      typeUsesPreludeName(target, names) ||
        optionTypeUsesPreludeName(iface, names) ||
        implMethodsUsePreludeName(methods, names)
    end
    case _ => false
  end
end

func typeUsesPreludeName(typ: ast2.TypeExpr, names: Slice[String]) -> Bool
  switch typ
    case ArrayType(elem, _) => typeUsesPreludeName(elem.value(), names)
    case NamedType(name, args) then
      common2.ContainsString(names, name) || typeExprsUsePreludeName(args, names)
    end
    case FuncType(params, ret) then
      typeExprsUsePreludeName(params, names) || typeUsesPreludeName(ret.value(), names)
    end
    case TupleType(items) => typeExprsUsePreludeName(items, names)
    case InlineGo(inner, _) => typeUsesPreludeName(inner.value(), names)
    case _ => false
  end
end

func typeExprsUsePreludeName(types: Slice[ast2.TypeExpr], names: Slice[String]) -> Bool
  if types.Len() == 0 then
    false
  else
    switch types.Get(0)
      case None => false
      case Some(typ) then
        typeUsesPreludeName(typ, names) ||
          typeExprsUsePreludeName(common2.SliceDrop(types, 1), names)
      end
    end
  end
end

func optionTypeUsesPreludeName(typ: Option[ast2.TypeExpr], names: Slice[String]) -> Bool
  switch typ
    case Some(value) => typeUsesPreludeName(value, names)
    case None => false
  end
end

func paramsUsePreludeName(params: Slice[ast2.Param], names: Slice[String]) -> Bool
  if params.Len() == 0 then
    false
  else
    switch params.Get(0)
      case None => false
      case Some(param) then
        typeUsesPreludeName(param.Type, names) ||
          paramsUsePreludeName(common2.SliceDrop(params, 1), names)
      end
    end
  end
end

func fieldsUsePreludeName(fields: Slice[ast2.Field], names: Slice[String]) -> Bool
  if fields.Len() == 0 then
    false
  else
    switch fields.Get(0)
      case None => false
      case Some(field) then
        typeUsesPreludeName(field.Type, names) ||
          fieldsUsePreludeName(common2.SliceDrop(fields, 1), names)
      end
    end
  end
end

func variantsUsePreludeName(variants: Slice[ast2.Variant], names: Slice[String]) -> Bool
  if variants.Len() == 0 then
    false
  else
    switch variants.Get(0)
      case None => false
      case Some(variant) then
        typeExprsUsePreludeName(variant.Fields, names) ||
          variantsUsePreludeName(common2.SliceDrop(variants, 1), names)
      end
    end
  end
end

func constraintsUsePreludeName(constraints: Slice[ast2.Constraint], names: Slice[String]) -> Bool
  if constraints.Len() == 0 then
    false
  else
    switch constraints.Get(0)
      case None => false
      case Some(constraint) then
        common2.ContainsString(names, constraint.Name) ||
          typeExprsUsePreludeName(constraint.Args, names) ||
          constraintsUsePreludeName(common2.SliceDrop(constraints, 1), names)
      end
    end
  end
end

func funcSigsUsePreludeName(sigs: Slice[ast2.FuncSig], names: Slice[String]) -> Bool
  if sigs.Len() == 0 then
    false
  else
    switch sigs.Get(0)
      case None => false
      case Some(sig) then
        paramsUsePreludeName(sig.Params, names) ||
          optionTypeUsesPreludeName(sig.Ret, names) ||
          constraintsUsePreludeName(sig.Using, names) ||
          funcSigsUsePreludeName(common2.SliceDrop(sigs, 1), names)
      end
    end
  end
end

func implMethodsUsePreludeName(methods: Slice[ast2.ImplMethod], names: Slice[String]) -> Bool
  if methods.Len() == 0 then
    false
  else
    switch methods.Get(0)
      case None => false
      case Some(method) then
        funcSigsUsePreludeName([method.Sig], names) ||
          exprUsesPreludeName(method.Body, names) ||
          implMethodsUsePreludeName(common2.SliceDrop(methods, 1), names)
      end
    end
  end
end

func exprUsesPreludeName(expr: ast2.Expr, names: Slice[String]) -> Bool
  switch expr.Kind
    case IdentExpr(name) => common2.ContainsString(names, name)
    case CallExpr(callee, typeArgs, args) then
      exprUsesPreludeName(callee, names) ||
        typeExprsUsePreludeName(typeArgs, names) ||
        exprsUsePreludeName(args, names)
      # Method dispatch becomes a mangled helper call during lowering. The
      # receiver and arguments alone do not expose that helper name, so retain
      # the Prelude import for a generated dictionary call; ordinary source
      # references are handled by the remaining cases.
    end
    case DictionaryCallExpr(_, _, _) => true
    case FieldExpr(receiver, _) => exprUsesPreludeName(receiver, names)
    case UnaryExpr(_, value) => exprUsesPreludeName(value, names)
    case BinaryExpr(_, left, right) then
      exprUsesPreludeName(left, names) || exprUsesPreludeName(right, names)
    end
    case IfExpr(cond, thenBody, elseBody) then
      exprUsesPreludeName(cond, names) ||
        exprUsesPreludeName(thenBody, names) ||
        exprUsesPreludeName(elseBody, names)
    end
    case BlockExpr(stmts) => stmtsUsePreludeName(stmts, names)
    case SwitchExpr(target, cases, _) then
      exprUsesPreludeName(target, names) || switchCasesUsePreludeName(cases, names)
    end
    case FuncLitExpr(params, ret, body) then
      paramsUsePreludeName(params, names) ||
        optionTypeUsesPreludeName(ret, names) ||
        exprUsesPreludeName(body, names)
    end
    case SliceLitExpr(items) => exprsUsePreludeName(items, names)
    case TypeAsExpr(value, typ) then
      exprUsesPreludeName(value, names) || typeUsesPreludeName(typ, names)
    end
    case DynamicBoxExpr(value, _, _, _, _) => exprUsesPreludeName(value, names)
    case StructLitExpr(name, fields) then
      common2.ContainsString(names, name) || structLitFieldsUsePreludeName(fields, names)
    end
    case GenericStructLitExpr(name, typeArgs, fields) then
      common2.ContainsString(names, name) ||
        typeExprsUsePreludeName(typeArgs, names) ||
        structLitFieldsUsePreludeName(fields, names)
    end
    case InlineGoExpr(typ, _, values, types) then
      typeUsesPreludeName(typ.value(), names) ||
        goOperandsUsePreludeName(values, names) ||
        goTypeOperandsUsePreludeName(types, names)
    end
    case MapLitExpr(pairs) => exprPairsUsePreludeName(pairs, names)
    case SetLitExpr(items) => exprsUsePreludeName(items, names)
    case TupleExpr(items) => exprsUsePreludeName(items, names)
    case _ => false
  end
end

func generatedSourceUsesPreludeHelper(source: String, decls: Slice[ast2.Decl]) -> Bool
  if decls.Len() == 0 then
    false
  else
    switch decls.Get(0)
      case None => false
      case Some(decl) then
        let uses = switch decl
          case ImplDecl(tps, target, iface, methods) then
            generatedSourceUsesImplHelpers(source, implStem(target, iface, typeParamSet(tps)), methods)
          end
          case _ => false
        end
        uses || generatedSourceUsesPreludeHelper(source, common2.SliceDrop(decls, 1))
      end
    end
  end
end

func generatedSourceUsesImplHelpers(
  source: String,
  stem: String,
  methods: Slice[ast2.ImplMethod]
) -> Bool
  if methods.Len() == 0 then
    false
  else
    switch methods.Get(0)
      case None => generatedSourceUsesImplHelpers(source, stem, common2.SliceDrop(methods, 1))
      case Some(method) then
        strings.Contains(source, implMethodSymbol(stem, method.Sig.Name)) ||
          generatedSourceUsesImplHelpers(source, stem, common2.SliceDrop(methods, 1))
      end
    end
  end
end

func exprsUsePreludeName(exprs: Slice[ast2.Expr], names: Slice[String]) -> Bool
  if exprs.Len() == 0 then
    false
  else
    switch exprs.Get(0)
      case None => false
      case Some(expr) then
        exprUsesPreludeName(expr, names) || exprsUsePreludeName(common2.SliceDrop(exprs, 1), names)
      end
    end
  end
end

func structLitFieldsUsePreludeName(fields: Slice[ast2.StructLitField], names: Slice[String]) -> Bool
  if fields.Len() == 0 then
    false
  else
    switch fields.Get(0)
      case None => false
      case Some(field) then
        exprUsesPreludeName(field.Value, names) ||
          structLitFieldsUsePreludeName(common2.SliceDrop(fields, 1), names)
      end
    end
  end
end

func goOperandsUsePreludeName(operands: Slice[ast2.GoOperand], names: Slice[String]) -> Bool
  if operands.Len() == 0 then
    false
  else
    switch operands.Get(0)
      case None => false
      case Some(operand) then
        exprUsesPreludeName(operand.Value, names) ||
          goOperandsUsePreludeName(common2.SliceDrop(operands, 1), names)
      end
    end
  end
end

func goTypeOperandsUsePreludeName(operands: Slice[ast2.GoTypeOperand], names: Slice[String]) -> Bool
  if operands.Len() == 0 then
    false
  else
    switch operands.Get(0)
      case None => false
      case Some(operand) then
        typeUsesPreludeName(operand.Type, names) ||
          goTypeOperandsUsePreludeName(common2.SliceDrop(operands, 1), names)
      end
    end
  end
end

func exprPairsUsePreludeName(pairs: Slice[(ast2.Expr, ast2.Expr)], names: Slice[String]) -> Bool
  if pairs.Len() == 0 then
    false
  else
    switch pairs.Get(0)
      case None => false
      case Some(pair) then
        let (key, value) = pair
        exprUsesPreludeName(key, names) ||
          exprUsesPreludeName(value, names) ||
          exprPairsUsePreludeName(common2.SliceDrop(pairs, 1), names)
      end
    end
  end
end

func switchCasesUsePreludeName(cases: Slice[ast2.SwitchCase], names: Slice[String]) -> Bool
  if cases.Len() == 0 then
    false
  else
    switch cases.Get(0)
      case None => false
      case Some(item) then
        patternUsesPreludeName(item.Pattern, names) ||
          exprUsesPreludeName(item.Body, names) ||
          switchCasesUsePreludeName(common2.SliceDrop(cases, 1), names)
      end
    end
  end
end

func patternUsesPreludeName(pattern: ast2.Pattern, names: Slice[String]) -> Bool
  switch pattern
    case VariantPattern(name, _) => common2.ContainsString(names, name)
    case TuplePattern(items) => patternsUsePreludeName(items, names)
    case _ => false
  end
end

func patternsUsePreludeName(patterns: Slice[ast2.Pattern], names: Slice[String]) -> Bool
  if patterns.Len() == 0 then
    false
  else
    switch patterns.Get(0)
      case None => false
      case Some(pattern) then
        patternUsesPreludeName(pattern, names) ||
          patternsUsePreludeName(common2.SliceDrop(patterns, 1), names)
      end
    end
  end
end

func stmtsUsePreludeName(stmts: Slice[ast2.Stmt], names: Slice[String]) -> Bool
  if stmts.Len() == 0 then
    false
  else
    switch stmts.Get(0)
      case None => false
      case Some(stmt) then
        stmtUsesPreludeName(stmt, names) || stmtsUsePreludeName(common2.SliceDrop(stmts, 1), names)
      end
    end
  end
end

func stmtUsesPreludeName(stmt: ast2.Stmt, names: Slice[String]) -> Bool
  switch stmt
    case ExprStmt(expr) => exprUsesPreludeName(expr, names)
    case LetStmt(bind) then
      optionTypeUsesPreludeName(bind.Type, names) || exprUsesPreludeName(bind.Value, names)
    end
    case LetRecStmt(bindings) => letRecBindsUsePreludeName(bindings, names)
    case TupleLetStmt(_, value) => exprUsesPreludeName(value, names)
    case VarStmt(bind) then
      optionTypeUsesPreludeName(bind.Type, names) || exprUsesPreludeName(bind.Value, names)
    end
    case WhileStmt(cond, body) then
      exprUsesPreludeName(cond, names) || exprUsesPreludeName(body, names)
    end
    case AssignStmt(target, value) then
      exprUsesPreludeName(target, names) || exprUsesPreludeName(value, names)
    end
    case ReturnWithStmt(value) => exprUsesPreludeName(value, names)
    case _ => false
  end
end

func letRecBindsUsePreludeName(bindings: Slice[ast2.LetRecBind], names: Slice[String]) -> Bool
  if bindings.Len() == 0 then
    false
  else
    switch bindings.Get(0)
      case None => false
      case Some(bind) then
        typeUsesPreludeName(bind.Type, names) ||
          exprUsesPreludeName(bind.Value, names) ||
          letRecBindsUsePreludeName(common2.SliceDrop(bindings, 1), names)
      end
    end
  end
end

# This mirrors legacy genHKTDecls: helper declarations are emitted only for
# declarations that actually declare a higher-kinded parameter such as C[A].
func needsHKTDecls(decls: Slice[ast2.Decl]) -> Bool
  if decls.Len() == 0 then
    false
  else
    switch decls.Get(0)
      case None => false
      case Some(head) then
        let here = switch head
          case TypeAliasDecl(_, tps, _) => hasHKTTypeParam(tps)
          case TypeDecl(_, tps, _) => hasHKTTypeParam(tps)
          case InterfaceDecl(_, tps, _) => hasHKTTypeParam(tps)
          case StructDecl(_, tps, _) => hasHKTTypeParam(tps)
          case EnumDecl(_, tps, _) => hasHKTTypeParam(tps)
          case FuncDecl(_, tps, _, _, _, _) => hasHKTTypeParam(tps)
          case ImplDecl(tps, _, _, _) => hasHKTTypeParam(tps)
          case _ => false
        end
        here || needsHKTDecls(common2.SliceDrop(decls, 1))
      end
    end
  end
end

func hasHKTTypeParam(tps: Slice[String]) -> Bool
  if tps.Len() == 0 then
    false
  else
    switch tps.Get(0)
      case Some(current) then
        strings.Index(current, "[") >= 0 || hasHKTTypeParam(common2.SliceDrop(tps, 1))
      end
      case None => false
    end
  end
end

func typedDeclSourceMap(
  sources: Slice[typeinference2.PkgDeclSource],
  index: Int,
  out: Map[String, Slice[ast2.Decl]]
) -> Map[String, Slice[ast2.Decl]]
  if index >= sources.Len() then
    out
  else
    switch sources.Get(index)
      case Some(source) then
        out.Set(source.Path, source.Decls)
        typedDeclSourceMap(sources, index + 1, out)
      end
      case None => typedDeclSourceMap(sources, index + 1, out)
    end
  end
end

# GenerateSource uses a synthetic path while InferFile retains its source
# name.  The single-source fallback preserves that convenience API; package
# compilation always resolves the exact source path from the map above.
func typedDeclsForInput(
  sources: Slice[typeinference2.PkgDeclSource],
  byPath: Map[String, Slice[ast2.Decl]],
  path: String
) -> Slice[ast2.Decl]
  switch byPath.Get(path)
    case Some(decls) => decls
    case None then
      if sources.Len() == 1 then
        switch sources.Get(0)
          case Some(source) => source.Decls
          case None => []
        end
      else
        []
      end
    end
  end
end
