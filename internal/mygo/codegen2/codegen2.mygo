package codegen2
import common2 "github.com/mygo-lang/mygo/internal/mygo/common2"

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import goast "go:github.com/mygo-lang/mygo/internal/mygo/codegen2/goast"
import typeinference2 "github.com/mygo-lang/mygo/internal/mygo/typeinference2"
import strings "go:strings"

struct GoFileParts
  PackageName: String
  Imports: Slice[GoImportPart]
  AstDecls: Slice[goast.Decl]
  Decls: Slice[String]
end

struct GoImportPart
  Alias: String
  Path: String
end

struct SourceFileInput
  Path: String
  File: ast2.File
  AutomaticImports: Slice[GoImportPart]
end

func NewSourceFileInput(path: String, file: ast2.File) -> SourceFileInput
  SourceFileInput { Path: path, File: file, AutomaticImports: [] }
end

func SourceFileInputWithAutomaticImport(input: SourceFileInput, alias: String, path: String) -> SourceFileInput
  SourceFileInput { Path: input.Path, File: input.File, AutomaticImports: input.AutomaticImports.Append(GoImportPart { Alias: alias, Path: path }) }
end

func Generate(file: ast2.File, info: typeinference2.PackageInfo) -> Result[String, String]
  let path = file.PackageName + ".mygo"
  let files = GenerateFiles([SourceFileInput { Path: path, File: file, AutomaticImports: [] }], info)
  switch files
    case Ok(out) =>
      switch out.Get(sourceToGenName(path))
        case Some(source) => Ok(source)
        case None => Err("generated source is missing for " + path)
      end
    case Err(msg) => Err(msg)
  end
end

func GenerateFiles(files: Slice[SourceFileInput], info: typeinference2.PackageInfo) -> Result[Map[String, String], String]
  # Merge all file declarations so cross-file method dispatch (e.g. tail.Map
  # from list.mygo resolving to the Option IEnumerable impl in option.mygo)
  # works through seedPackageDictionaries / seedImplCandidates.
  let allDecls = mergeFileDecls(files, 0, [] as Slice[ast2.Decl])
  let visibleDecls = mergeDeclSlices(info.ExternalTypedDecls, info.TypedDecls)
  # All emitted files in this package share the same declaration universe, so
  # build lowering metadata once for the complete GenerateFiles invocation.
  let packageIndex = newPackageIndexWithImports(visibleDecls, info.MyGoPackages)
  let typedByPath = typedDeclSourceMap(info.TypedDeclSources, 0, {})
  # The mutual tail-call plan spans every source file of the package, so it is
  # also built once here and threaded through the per-file generator contexts.
  # The analysis reads the typed declaration bodies (TypedDeclSources) so the
  # trampoline member lowering sees the inferred type annotations.
  switch files.Get(0)
    case None =>
      if files.Len() == 0 then Ok({}) else Err("source file index is missing before code generation")
      end
    case Some(first) =>
      let mutualTail = buildMutualTailPlans(first.File.PackageName, files, info.TypedDeclSources)
      let out: Map[String, String] = {}
      generateFilesLoop(files, info, allDecls, packageIndex, typedByPath, mutualTail, 0, out)
  end
end

func importedMyGoDecls(packages: Slice[typeinference2.MyGoPackageInfo], index: Int, out: Slice[ast2.Decl]) -> Slice[ast2.Decl]
  if index >= packages.Len() then out else
    switch packages.Get(index)
      case None => importedMyGoDecls(packages, index + 1, out)
      case Some(pkg) => importedMyGoDecls(packages, index + 1, mergeDeclSlices(out, pkg.Decls))
    end
  end
end

func mergeFileDecls(files: Slice[SourceFileInput], index: Int, acc: Slice[ast2.Decl]) -> Slice[ast2.Decl]
  if index >= files.Len() then
    acc
  else
    switch files.Get(index)
      case None => mergeFileDecls(files, index + 1, acc)
      case Some(input) => mergeFileDecls(files, index + 1, mergeDeclSlices(acc, input.File.Decls))
    end
  end
end

func mergeDeclSlices(dst: Slice[ast2.Decl], src: Slice[ast2.Decl]) -> Slice[ast2.Decl]
  if src.Len() == 0 then
    dst
  else
    switch src.Get(0)
      case None => dst
      case Some(item) => mergeDeclSlices(dst.Append(item), common2.SliceDrop(src, 1))
    end
  end
end

func generateFilesLoop(files: Slice[SourceFileInput], info: typeinference2.PackageInfo, allDecls: Slice[ast2.Decl], packageIndex: PackageIndex, typedByPath: Map[String, Slice[ast2.Decl]], mutualTail: MutualTailPlans, index: Int, out: Map[String, String]) -> Result[Map[String, String], String]
  if index >= files.Len() then
    Ok(out)
  else
    switch files.Get(index)
      case None => Err("source file index is missing during code generation")
      case Some(input) =>
        let typedDecls = typedDeclsForInput(info.TypedDeclSources, typedByPath, input.Path)
        let src = generateOneFile(input.File, input.Path, input.AutomaticImports, info, allDecls, packageIndex, typedDecls, mutualTail, index == 0)
        switch src
          case Ok(code) =>
            out.Set(sourceToGenName(input.Path), code)
            generateFilesLoop(files, info, allDecls, packageIndex, typedByPath, mutualTail, index + 1, out)
          case Err(msg) => Err(common2.WithExpressionSourceName(msg, input.File.SourceName))
        end
    end
  end
end

func GenerateSource(input: String) -> Result[String, String]
  GenerateSourceAt("<input>", input)
end

# GenerateSourceAt is the file-aware bootstrap entry point.  In particular it
# preserves parser2's source location in errors instead of reducing every
# input to an anonymous string.
func GenerateSourceAt(sourceName: String, input: String) -> Result[String, String]
  let parsed = parseSourceAsAst2At(sourceName, input)
  switch parsed
    case Err(msg) => Err(msg)
    case Ok(file) =>
      # Assign unique IDs to every expression node so that codegen2 can
      # look up type-inference results by comparing the ID field (which is
      # preserved across value copies) instead of relying on pointer identity.
      switch ast2.AssignFileExprIDs(file)
        case None => Err("malformed AST: missing indexed value while assigning expression IDs")
        case Some(fileWithIDs) =>
          let inferred = typeinference2.InferFile(fileWithIDs)
          switch inferred
            case Err(msg) => Err(msg)
            case Ok(info) => Generate(fileWithIDs, info)
          end
      end
  end
end

func generateOneFile(file: ast2.File, path: String, automaticImports: Slice[GoImportPart], info: typeinference2.PackageInfo, allDecls: Slice[ast2.Decl], packageIndex: PackageIndex, fileTypedDecls: Slice[ast2.Decl], mutualTail: MutualTailPlans, includeHKT: Bool) -> Result[String, String]
  # Method dispatch must see every impl visible to this package: its complete
  # typed declaration set plus externally supplied declarations (the prelude).
  # `fileTypedDecls` below still limits emitted Go declarations to this file.
  let visibleDecls = mergeDeclSlices(info.ExternalTypedDecls, info.TypedDecls)
  let imports = mergeGoImports(collectImports(file.Decls), automaticImports)
  let g = Ref.new(newGenerator2(file.PackageName, visibleDecls, imports, info.GoPackages, info, packageIndex))
  g.mutualTail = mutualTail
  g.currentFile = path
  let decls = translateDeclsAst(g, fileTypedDecls, 0, [] as Slice[goast.Decl])
  switch decls
    case Err(msg) => Err(msg)
    case Ok(items) =>
      # HKT helper types are owned by prelude.  Non-prelude packages receive
      # them through the automatically-added dot import, so emitting them
      # locally would redeclare the imported names.
      let withHKT = if file.PackageName == "prelude" && includeHKT && needsHKTDecls(allDecls) then goast.AppendDecls(goast.HKTDecls(), items) else items end
      # Decide this from the MyGO declarations, before they are lowered to Go.
      # In particular, typeclass dictionaries become mangled Go identifiers;
      # inspecting those identifiers cannot reliably reveal their origin.
      let sourcePrelude = file.PackageName != "prelude" && declsNeedPreludeImport(file.Decls, info.ExternalTypedDecls)
      let withoutPrelude = renderGoFile(GoFileParts { PackageName: file.PackageName, Imports: imports, AstDecls: withHKT, Decls: [] as Slice[String] })
      switch withoutPrelude
        case Err(msg) => Err(msg)
        case Ok(source) =>
          let needsPrelude = sourcePrelude || generatedSourceUsesPreludeHelper(source, info.ExternalTypedDecls)
          let withPrelude = if needsPrelude then imports.Append(GoImportPart { Alias: ".", Path: "github.com/mygo-lang/mygo/prelude" }) else imports end
          if needsPrelude then renderGoFile(GoFileParts { PackageName: file.PackageName, Imports: withPrelude, AstDecls: withHKT, Decls: [] as Slice[String] }) else Ok(source) end
      end
  end
end

# This is deliberately parallel to legacy codegen's declsNeedPreludeImport.
# `ExternalTypedDecls` is the prelude supplied to this package by bootstrap,
# so its enum/interface names are the names made available by the dot import.
func declsNeedPreludeImport(decls: Slice[ast2.Decl], external: Slice[ast2.Decl]) -> Bool
  let names = preludeImportNames(external, [] as Slice[String])
  declsUsePreludeName(decls, names)
end

func preludeImportNames(decls: Slice[ast2.Decl], names: Slice[String]) -> Slice[String]
  if decls.Len() == 0 then
    names
  else
    switch decls.Get(0)
      case None => names
      case Some(decl) then
        let next = switch decl
          case TypeAliasDecl(name, _, _) => names.Append(name)
          case TypeDecl(name, _, _) => names.Append(name)
          case EnumDecl(name, _, variants) => variantImportNames(variants, names.Append(name))
          case InterfaceDecl(name, _, _) => names.Append(name)
          case _ => names
        end
        preludeImportNames(common2.SliceDrop(decls, 1), next)
      end
    end
  end
end

func variantImportNames(variants: Slice[ast2.Variant], names: Slice[String]) -> Slice[String]
  if variants.Len() == 0 then names else
    switch variants.Get(0)
      case None => names
      case Some(variant) => variantImportNames(common2.SliceDrop(variants, 1), names.Append(variant.Name))
    end
  end
end

func declsUsePreludeName(decls: Slice[ast2.Decl], names: Slice[String]) -> Bool
  if decls.Len() == 0 then false else
    switch decls.Get(0)
      case None => false
      case Some(decl) => declUsesPreludeName(decl, names) || declsUsePreludeName(common2.SliceDrop(decls, 1), names)
    end
  end
end

func declUsesPreludeName(decl: ast2.Decl, names: Slice[String]) -> Bool
  switch decl
    case TypeAliasDecl(_, _, target) => typeUsesPreludeName(target, names)
    case TypeDecl(_, _, target) => typeUsesPreludeName(target, names)
    case FuncDecl(_, _, params, ret, body, requirements) => paramsUsePreludeName(params, names) || optionTypeUsesPreludeName(ret, names) || constraintsUsePreludeName(requirements, names) || exprUsesPreludeName(body, names)
    case StructDecl(_, _, fields) => fieldsUsePreludeName(fields, names)
    case EnumDecl(_, _, variants) => variantsUsePreludeName(variants, names)
    # Typeclass interfaces are erased by codegen2. Their signatures must not
    # cause a per-file Go import that has no emitted use.
    case InterfaceDecl(_, _, _) => false
    case ImplDecl(_, target, iface, methods) => typeUsesPreludeName(target, names) || optionTypeUsesPreludeName(iface, names) || implMethodsUsePreludeName(methods, names)
    case _ => false
  end
end

func typeUsesPreludeName(typ: ast2.TypeExpr, names: Slice[String]) -> Bool
  switch typ
    case NamedType(name, args) => common2.ContainsString(names, name) || typeExprsUsePreludeName(args, names)
    case FuncType(params, ret) => typeExprsUsePreludeName(params, names) || typeUsesPreludeName(ret.value(), names)
    case TupleType(items) => typeExprsUsePreludeName(items, names)
    case InlineGo(inner, _) => typeUsesPreludeName(inner.value(), names)
    case _ => false
  end
end

func typeExprsUsePreludeName(types: Slice[ast2.TypeExpr], names: Slice[String]) -> Bool
  if types.Len() == 0 then false else
    switch types.Get(0)
      case None => false
      case Some(typ) => typeUsesPreludeName(typ, names) || typeExprsUsePreludeName(common2.SliceDrop(types, 1), names)
    end
  end
end

func optionTypeUsesPreludeName(typ: Option[ast2.TypeExpr], names: Slice[String]) -> Bool
  switch typ
    case Some(value) => typeUsesPreludeName(value, names)
    case None => false
  end
end

func paramsUsePreludeName(params: Slice[ast2.Param], names: Slice[String]) -> Bool
  if params.Len() == 0 then false else
    switch params.Get(0)
      case None => false
      case Some(param) => typeUsesPreludeName(param.Type, names) || paramsUsePreludeName(common2.SliceDrop(params, 1), names)
    end
  end
end

func fieldsUsePreludeName(fields: Slice[ast2.Field], names: Slice[String]) -> Bool
  if fields.Len() == 0 then false else
    switch fields.Get(0)
      case None => false
      case Some(field) => typeUsesPreludeName(field.Type, names) || fieldsUsePreludeName(common2.SliceDrop(fields, 1), names)
    end
  end
end

func variantsUsePreludeName(variants: Slice[ast2.Variant], names: Slice[String]) -> Bool
  if variants.Len() == 0 then
    false
  else
    switch variants.Get(0)
      case None => false
      case Some(variant) => typeExprsUsePreludeName(variant.Fields, names) || variantsUsePreludeName(common2.SliceDrop(variants, 1), names)
    end
  end
end

func constraintsUsePreludeName(constraints: Slice[ast2.Constraint], names: Slice[String]) -> Bool
  if constraints.Len() == 0 then false else
    switch constraints.Get(0)
      case None => false
      case Some(constraint) => common2.ContainsString(names, constraint.Name) || typeExprsUsePreludeName(constraint.Args, names) || constraintsUsePreludeName(common2.SliceDrop(constraints, 1), names)
    end
  end
end

func funcSigsUsePreludeName(sigs: Slice[ast2.FuncSig], names: Slice[String]) -> Bool
  if sigs.Len() == 0 then false else
    switch sigs.Get(0)
      case None => false
      case Some(sig) => paramsUsePreludeName(sig.Params, names) || optionTypeUsesPreludeName(sig.Ret, names) || constraintsUsePreludeName(sig.Using, names) || funcSigsUsePreludeName(common2.SliceDrop(sigs, 1), names)
    end
  end
end

func implMethodsUsePreludeName(methods: Slice[ast2.ImplMethod], names: Slice[String]) -> Bool
  if methods.Len() == 0 then false else
    switch methods.Get(0)
      case None => false
      case Some(method) => funcSigsUsePreludeName([method.Sig], names) || exprUsesPreludeName(method.Body, names) || implMethodsUsePreludeName(common2.SliceDrop(methods, 1), names)
    end
  end
end

func exprUsesPreludeName(expr: ast2.Expr, names: Slice[String]) -> Bool
  switch expr.Kind
    case IdentExpr(name) => common2.ContainsString(names, name)
    case CallExpr(callee, typeArgs, args) => exprUsesPreludeName(callee, names) || typeExprsUsePreludeName(typeArgs, names) || exprsUsePreludeName(args, names)
    # Method dispatch becomes a mangled helper call during lowering. The
    # receiver and arguments alone do not expose that helper name, so retain
    # the Prelude import for a generated dictionary call; ordinary source
    # references are handled by the remaining cases.
    case DictionaryCallExpr(_, _, _) => true
    case FieldExpr(receiver, _) => exprUsesPreludeName(receiver, names)
    case UnaryExpr(_, value) => exprUsesPreludeName(value, names)
    case BinaryExpr(_, left, right) => exprUsesPreludeName(left, names) || exprUsesPreludeName(right, names)
    case IfExpr(cond, thenBody, elseBody) => exprUsesPreludeName(cond, names) || exprUsesPreludeName(thenBody, names) || exprUsesPreludeName(elseBody, names)
    case BlockExpr(stmts) => stmtsUsePreludeName(stmts, names)
    case SwitchExpr(target, cases, _) => exprUsesPreludeName(target, names) || switchCasesUsePreludeName(cases, names)
    case FuncLitExpr(params, ret, body) => paramsUsePreludeName(params, names) || optionTypeUsesPreludeName(ret, names) || exprUsesPreludeName(body, names)
    case SliceLitExpr(items) => exprsUsePreludeName(items, names)
    case TypeAsExpr(value, typ) => exprUsesPreludeName(value, names) || typeUsesPreludeName(typ, names)
    case StructLitExpr(name, fields) => common2.ContainsString(names, name) || structLitFieldsUsePreludeName(fields, names)
    case GenericStructLitExpr(name, typeArgs, fields) => common2.ContainsString(names, name) || typeExprsUsePreludeName(typeArgs, names) || structLitFieldsUsePreludeName(fields, names)
    case InlineGoExpr(typ, _, values, types) => typeUsesPreludeName(typ.value(), names) || goOperandsUsePreludeName(values, names) || goTypeOperandsUsePreludeName(types, names)
    case MapLitExpr(pairs) => exprPairsUsePreludeName(pairs, names)
    case SetLitExpr(items) => exprsUsePreludeName(items, names)
    case TupleExpr(items) => exprsUsePreludeName(items, names)
    case _ => false
  end
end

func generatedSourceUsesPreludeHelper(source: String, decls: Slice[ast2.Decl]) -> Bool
  if decls.Len() == 0 then false else
    switch decls.Get(0)
      case None => false
      case Some(decl) then
        let uses = switch decl
          case ImplDecl(tps, target, iface, methods) => generatedSourceUsesImplHelpers(source, implStem(target, iface, typeParamSet(tps)), methods)
          case _ => false
        end
        uses || generatedSourceUsesPreludeHelper(source, common2.SliceDrop(decls, 1))
      end
    end
  end
end

func generatedSourceUsesImplHelpers(source: String, stem: String, methods: Slice[ast2.ImplMethod]) -> Bool
  if methods.Len() == 0 then false else
    switch methods.Get(0)
      case None => generatedSourceUsesImplHelpers(source, stem, common2.SliceDrop(methods, 1))
      case Some(method) => strings.Contains(source, implMethodSymbol(stem, method.Sig.Name)) || generatedSourceUsesImplHelpers(source, stem, common2.SliceDrop(methods, 1))
    end
  end
end

func exprsUsePreludeName(exprs: Slice[ast2.Expr], names: Slice[String]) -> Bool
  if exprs.Len() == 0 then false else
    switch exprs.Get(0)
      case None => false
      case Some(expr) => exprUsesPreludeName(expr, names) || exprsUsePreludeName(common2.SliceDrop(exprs, 1), names)
    end
  end
end

func structLitFieldsUsePreludeName(fields: Slice[ast2.StructLitField], names: Slice[String]) -> Bool
  if fields.Len() == 0 then false else
    switch fields.Get(0)
      case None => false
      case Some(field) => exprUsesPreludeName(field.Value, names) || structLitFieldsUsePreludeName(common2.SliceDrop(fields, 1), names)
    end
  end
end

func goOperandsUsePreludeName(operands: Slice[ast2.GoOperand], names: Slice[String]) -> Bool
  if operands.Len() == 0 then false else
    switch operands.Get(0)
      case None => false
      case Some(operand) => exprUsesPreludeName(operand.Value, names) || goOperandsUsePreludeName(common2.SliceDrop(operands, 1), names)
    end
  end
end

func goTypeOperandsUsePreludeName(operands: Slice[ast2.GoTypeOperand], names: Slice[String]) -> Bool
  if operands.Len() == 0 then false else
    switch operands.Get(0)
      case None => false
      case Some(operand) => typeUsesPreludeName(operand.Type, names) || goTypeOperandsUsePreludeName(common2.SliceDrop(operands, 1), names)
    end
  end
end

func exprPairsUsePreludeName(pairs: Slice[(ast2.Expr, ast2.Expr)], names: Slice[String]) -> Bool
  if pairs.Len() == 0 then false else
    switch pairs.Get(0)
      case None => false
      case Some(pair) then
        let (key, value) = pair
        exprUsesPreludeName(key, names) || exprUsesPreludeName(value, names) || exprPairsUsePreludeName(common2.SliceDrop(pairs, 1), names)
      end
    end
  end
end

func switchCasesUsePreludeName(cases: Slice[ast2.SwitchCase], names: Slice[String]) -> Bool
  if cases.Len() == 0 then false else
    switch cases.Get(0)
      case None => false
      case Some(item) => patternUsesPreludeName(item.Pattern, names) || exprUsesPreludeName(item.Body, names) || switchCasesUsePreludeName(common2.SliceDrop(cases, 1), names)
    end
  end
end

func patternUsesPreludeName(pattern: ast2.Pattern, names: Slice[String]) -> Bool
  switch pattern
    case VariantPattern(name, _) => common2.ContainsString(names, name)
    case TuplePattern(items) => patternsUsePreludeName(items, names)
    case _ => false
  end
end

func patternsUsePreludeName(patterns: Slice[ast2.Pattern], names: Slice[String]) -> Bool
  if patterns.Len() == 0 then false else
    switch patterns.Get(0)
      case None => false
      case Some(pattern) => patternUsesPreludeName(pattern, names) || patternsUsePreludeName(common2.SliceDrop(patterns, 1), names)
    end
  end
end

func stmtsUsePreludeName(stmts: Slice[ast2.Stmt], names: Slice[String]) -> Bool
  if stmts.Len() == 0 then false else
    switch stmts.Get(0)
      case None => false
      case Some(stmt) => stmtUsesPreludeName(stmt, names) || stmtsUsePreludeName(common2.SliceDrop(stmts, 1), names)
    end
  end
end

func stmtUsesPreludeName(stmt: ast2.Stmt, names: Slice[String]) -> Bool
  switch stmt
    case ExprStmt(expr) => exprUsesPreludeName(expr, names)
    case LetStmt(bind) => optionTypeUsesPreludeName(bind.Type, names) || exprUsesPreludeName(bind.Value, names)
    case LetRecStmt(bindings) => letRecBindsUsePreludeName(bindings, names)
    case TupleLetStmt(_, value) => exprUsesPreludeName(value, names)
    case VarStmt(bind) => optionTypeUsesPreludeName(bind.Type, names) || exprUsesPreludeName(bind.Value, names)
    case WhileStmt(cond, body) => exprUsesPreludeName(cond, names) || exprUsesPreludeName(body, names)
    case AssignStmt(target, value) => exprUsesPreludeName(target, names) || exprUsesPreludeName(value, names)
    case ReturnWithStmt(value) => exprUsesPreludeName(value, names)
    case _ => false
  end
end

func letRecBindsUsePreludeName(bindings: Slice[ast2.LetRecBind], names: Slice[String]) -> Bool
  if bindings.Len() == 0 then false else
    switch bindings.Get(0)
      case None => false
      case Some(bind) => typeUsesPreludeName(bind.Type, names) || exprUsesPreludeName(bind.Value, names) || letRecBindsUsePreludeName(common2.SliceDrop(bindings, 1), names)
    end
  end
end

# This mirrors legacy genHKTDecls: helper declarations are emitted only for
# declarations that actually declare a higher-kinded parameter such as C[A].
func needsHKTDecls(decls: Slice[ast2.Decl]) -> Bool
  if decls.Len() == 0 then
    false
  else
    switch decls.Get(0)
      case None => false
      case Some(head) then
        let here = switch head
          case TypeAliasDecl(_, tps, _) => hasHKTTypeParam(tps)
          case TypeDecl(_, tps, _) => hasHKTTypeParam(tps)
          case InterfaceDecl(_, tps, _) => hasHKTTypeParam(tps)
          case StructDecl(_, tps, _) => hasHKTTypeParam(tps)
          case EnumDecl(_, tps, _) => hasHKTTypeParam(tps)
          case FuncDecl(_, tps, _, _, _, _) => hasHKTTypeParam(tps)
          case ImplDecl(tps, _, _, _) => hasHKTTypeParam(tps)
          case _ => false
        end
        here || needsHKTDecls(common2.SliceDrop(decls, 1))
      end
    end
  end
end

func hasHKTTypeParam(tps: Slice[String]) -> Bool
  if tps.Len() == 0 then
    false
  else
    switch tps.Get(0)
      case Some(current) => strings.Index(current, "[") >= 0 || hasHKTTypeParam(common2.SliceDrop(tps, 1))
      case None => false
    end
  end
end

func typedDeclSourceMap(sources: Slice[typeinference2.PkgDeclSource], index: Int, out: Map[String, Slice[ast2.Decl]]) -> Map[String, Slice[ast2.Decl]]
  if index >= sources.Len() then
    out
  else
    switch sources.Get(index)
      case Some(source) then
        out.Set(source.Path, source.Decls)
        typedDeclSourceMap(sources, index + 1, out)
      end
      case None => typedDeclSourceMap(sources, index + 1, out)
    end
  end
end

# GenerateSource uses a synthetic path while InferFile retains its source
# name.  The single-source fallback preserves that convenience API; package
# compilation always resolves the exact source path from the map above.
func typedDeclsForInput(sources: Slice[typeinference2.PkgDeclSource], byPath: Map[String, Slice[ast2.Decl]], path: String) -> Slice[ast2.Decl]
  switch byPath.Get(path)
    case Some(decls) => decls
    case None =>
      if sources.Len() == 1 then
        switch sources.Get(0)
          case Some(source) => source.Decls
          case None => []
        end
      else
        []
      end
  end
end
