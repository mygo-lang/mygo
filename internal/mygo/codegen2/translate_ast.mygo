package codegen2

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import goast "go:github.com/mygo-lang/mygo/internal/mygo/codegen2/goast"
import typeinference2 "github.com/mygo-lang/mygo/internal/mygo/typeinference2"
import strings "go:strings"
import strconv "go:strconv"

# translateExprAst 是替代 translateExpr 的新入口。当前覆盖无副作用的
# 基础表达式；控制流和绑定将在同一结果模型上继续扩展。
func translateExprAst(expr: ast2.Expr, ctx: Ref[egCtx]) -> Result[AstExprResult, String]
  translateExprAstExpected(expr, ctx, ast2.MonoType.TUnit)
end

func translateExprAstExpected(expr: ast2.Expr, ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  # An expression's inferred type is authoritative when its parent has no
  # contextual expectation (notably call arguments). This preserves types of
  # literals such as ["digit"] instead of lowering them as []any.
  let effectiveExpected = switch expected
    case TUnit => switch expr.Type
      case Some(t) => t
      case None => expected
    end
    case _ => expected
  end
  let result = translateExprAstExpectedInner(expr, ctx, effectiveExpected)
  switch result
    case Ok(value) => Ok(value)
    case Err(msg) => Err(errorAtExpr(expr, msg))
  end
end

func errorAtExpr(expr: ast2.Expr, msg: String) -> String
  if strings.Contains(msg, ":") then
    msg
  else
    let source = if expr.Pos.SourceName == "" then "<input>" else expr.Pos.SourceName end
    source + ":" + expr.Pos.Line.ToString() + ":" + expr.Pos.Column.ToString() + ": " + msg
  end
end

func translateExprAstExpectedInner(expr: ast2.Expr, ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  switch expr.Kind
    case IdentExpr(name) =>
      # None is a zero-argument generic constructor and is commonly written
      # without parentheses.  Go still requires its type argument.
      if name == "None" && noneTypeArg(expected, ctx) != "" then
        Ok(newAstExprResult(goast.GenericCall(goast.Ident("None"), [noneTypeArg(expected, ctx)], [] as Slice[goast.Expr])))
      else
        # A `using` dictionary shadows package-level typeclass dispatch, just
        # like ordinary lexical bindings shadow top-level functions.
        Ok(newAstExprResult(goast.Ident(ctx.constraintFuncs.Get(name).UnwrapOr(ctxGetBinding(ctx, name).UnwrapOr(sanitizeIdent(name))))))
      end
    case NumberExpr(v) => Ok(newAstExprResult(goast.Number(normalizeNumberLiteral(v))))
    case StringExpr(v) => Ok(newAstExprResult(goast.String(strconv.Quote(v))))
    case RuneExpr(v) => Ok(newAstExprResult(goast.Rune(v)))
    case SliceLitExpr(items) => translateSliceLitAst(items, ctx, expected)
    case TypeAsExpr(value, typ) => translateTypeAsAst(value, typ, ctx)
    case BoolExpr(v) => if v then Ok(newAstExprResult(goast.Ident("true"))) else Ok(newAstExprResult(goast.Ident("false"))) end
    case UnitExpr => Ok(newAstExprResult(goast.Unit()))
    case InlineGoExpr(typ, body, values, types) =>
      switch inlineGoBoundaryKind(typ.value(), expected)
        case Some(kind) => translateInlineGoBoundary(kind, body, values, types, expected, ctx)
        case None =>
          let parts = translateInlineOperands(values, types, ctx, 0, [] as Slice[String], [] as Slice[String], [] as Slice[String], [] as Slice[String], [] as Slice[goast.Stmt])
          switch parts
            case Err(msg) => Err(msg)
            case Ok(p) => Ok(astExprWithPre(goast.MustInlineGoExprWithOperands(body, p.ValueNames, p.ValueSources, p.TypeNames, p.TypeSources), p.Pre))
          end
      end
    case TupleExpr(items) => translateTupleLitAst(items, ctx, expected)
    case FieldExpr(base, field) =>
      switch base.Kind
        case IdentExpr(name) =>
          switch ctx.enumValueConstructors.Get(name + "." + field)
            case Some(ctor) => Ok(newAstExprResult(goast.Call(goast.Ident(ctor), [] as Slice[goast.Expr])))
            case None => translateFieldAst(base, field, ctx, expected)
          end
        # Imported enum constructors are parsed as nested selectors:
        # `ast2.Decl.ImportDecl` lowers to
        # FieldExpr(FieldExpr(Ident("ast2"), "Decl"), "ImportDecl").
        case FieldExpr(pkgBase, enumName) =>
          switch pkgBase.Kind
            case IdentExpr(alias) =>
              switch importedEnumVariantCtor(alias, enumName, field, ctx)
                case Some(ctor) => Ok(newAstExprResult(goast.Call(goast.Ident(ctor), [] as Slice[goast.Expr])))
                case None => translateFieldAst(base, field, ctx, expected)
              end
            case _ => translateFieldAst(base, field, ctx, expected)
          end
        case _ => translateFieldAst(base, field, ctx, expected)
      end
    case UnaryExpr(op, inner) =>
      let value = translateExprAstExpected(inner, ctx, expected)
      switch value
        case Ok(v) => Ok(astExprWithPre(goast.Unary(op, v.Expr), v.Pre))
        case Err(msg) => Err(msg)
      end
    case BinaryExpr(op, left, right) => translateBinaryAstExpected(op, left, right, ctx, expected)
    case CallExpr(callee, typeArgs, args) => translateCallAstExpected(callee, typeArgs, args, ctx, expected)
    case DictionaryCallExpr(key, receiver, args) => translateDictionaryCallAst(key, receiver, args, ctx)
    case StructLitExpr(typeName, fields) => translateStructLitAstExpected(typeName, fields, ctx, expected)
    case GenericStructLitExpr(typeName, typeArgs, fields) => translateGenericStructLitAstExpected(typeName, typeArgs, fields, ctx, expected)
    case MapLitExpr(pairs) => translateMapLitAstExpected(pairs, ctx, expected)
    case SetLitExpr(items) => translateSetLitAstExpected(items, ctx, expected)
    case IfExpr(cond, thenExpr, elseExpr) => translateIfAst(cond, thenExpr, elseExpr, ctx, expected)
    case SwitchExpr(target, cases, targetType) =>
      translateSwitchAstWithTargetType(target, cases, targetType, ctx, expected)
    case BlockExpr(items) => translateBlockExprAstExpected(items, ctx, 0, [] as Slice[goast.Stmt], expected)
    case FuncLitExpr(params, ret, body) => translateFuncLitAst(params, ret, body, ctx)
    case _ => Err("AST lowering for this expression is not implemented")
  end
end

func expectedGoType(expected: ast2.MonoType, aliases: Map[String, String]) -> String
  switch expected
    case TUnit => ""
    case _ => monoTypeToGoStrIn(expected, aliases)
  end
end

func noneTypeArg(expected: ast2.MonoType, ctx: Ref[egCtx]) -> String
  let opt = switch expected
    case TApp(typeRef, args) then
      switch typeRef.value()
        case TCon(name) then
          if name == "Option" && args.Len() == 1 then
            Some(args)
          else
            None
          end
        end
        case _ => None
      end
    end
    case _ => None
  end
  switch opt
    case Some(args) => monoTypeToGoStrWithParamsIn(args.Get(0).UnwrapOr(ast2.MonoType.TUnit), ctx.typeParamNames, ctx.pathAliases)
    case _ then
      ctx.typeParams.Fold("", func(found: String, item: String) -> String
        if found != "" || strings.HasSuffix(item, "#hkt") || strings.Index(item, "[") >= 0 then
          found
        else
          item
        end
      end)
    end
  end
end

func translateFieldAst(base: ast2.Expr, field: String, ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  let value = translateExprAstExpected(base, ctx, expected)
  switch value
    case Ok(v) => Ok(astExprWithPre(goast.Selector(v.Expr, sanitizeIdent(field)), v.Pre))
    case Err(msg) => Err(msg)
  end
end

# translateTupleLitAst lowers a TupleExpr in value context (non-return position).
# It generates an anonymous struct literal like the old TupleLitExpr:
#   (1, "hello")  =>  struct{F0 int; F1 string}{F0: 1, F1: "hello"}
# This is the value-position lowering; the return-position expansion (multi-return)
# is handled in translateAstReturnValue in translate_expr.mygo.
func translateTupleLitAst(items: Slice[ast2.Expr], ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  if items.Len() == 0 then
    Ok(newAstExprResult(goast.Unit()))
  else
    let values = translateAstArgs(items, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], [] as Slice[ast2.MonoType])
    switch values
      case Err(msg) => Err(msg)
      case Ok(v) =>
        # Build anonymous struct type: struct{F0 type0; F1 type1; ...}
        var types: Slice[String] = []
        var i: Int = 0
        while i < items.Len()
          types = types.Append("any")
          i = i + 1
        end
        let expectedTypes = switch expected
          case TUnit => types
          case _ => inferTupleTypesFromExpected(ctx, expected, items.Len())
        end
        var fields: Slice[String] = []
        var j: Int = 0
        while j < items.Len()
          let fieldType = expectedTypes.Get(j).UnwrapOr("any")
          fields = fields.Append("F" + j.ToString() + " " + fieldType)
          j = j + 1
        end
        let structTypeStr = "struct { " + joinStrings(fields, "; ") + " }"
        # Wrap each positional element in an `F0: x` keyed composite so the
        # generated Go CompositeLit initializes struct fields by name rather
        # than by position.  Position-only literals are valid for arrays and
        # slices but the struct lowering here needs explicit field names.
        let keyed = wrapExprsAsStructFields(v.Exprs, 0, [] as Slice[goast.Expr])
        Ok(astExprWithPre(goast.Composite(goast.MustTypeExpr(structTypeStr), keyed), v.Pre))
    end
  end
end

func wrapExprsAsStructFields(elts: Slice[goast.Expr], index: Int, out: Slice[goast.Expr]) -> Slice[goast.Expr]
  if index >= elts.Len() then out else
    let elt = elts.Get(index).UnwrapOr(goast.Unit())
    let keyed = goast.KeyValue(goast.Ident("F" + index.ToString()), elt)
    wrapExprsAsStructFields(elts, index + 1, out.Append(keyed))
  end
end

# inferTupleTypesFromExpected extracts element types from an expected
# tuple type.  When the expected type is a `TTuple` the elements are
# rendered through the type parameter substitution so the generated
# anonymous struct carries the precise Go types for each `F<n>` field.
# Falls back to `any` for each position when the expected type is not
# a tuple (e.g. a raw struct string that the old parser could not split).
func inferTupleTypesFromExpected(ctx: Ref[egCtx], expected: ast2.MonoType, count: Int) -> Slice[String]
  var types: Slice[String] = []
  var i: Int = 0
  let elementTypes = switch expected
      case TTuple(items) => items
      case _ => []
  end

  while i < count
    let elementType = elementTypes.Get(i).UnwrapOr(ast2.MonoType.TUnit)
    types = types.Append(monoTypeToGoStrWithParamsIn(elementType, ctx.typeParamNames, ctx.pathAliases))
    i = i + 1
  end
  types
end

func translateFuncLitAst(params: Slice[ast2.Param], ret: Option[ast2.TypeExpr], body: ast2.Expr, ctx: Ref[egCtx]) -> Result[AstExprResult, String]
  var child = Ref.new(ctxChild(ctx))
  # A function literal is a new function boundary: a recursive call inside its
  # body can never be a tail call of the enclosing function (Go `continue`
  # cannot cross a closure), so drop the inherited tail-recursion context.
  child.tailRecFuncName = None
  child.tailRecParamCount = 0
  child.tailRecParamNames = []
  child.mtPlan = None
  child.mtShared = []
  var retMono = returnMonoType(ret)
  child.retType = retMono
  # A tuple-returning function literal passed as a value (e.g. a PMap
  # callback) must expose the tuple as a single anonymous struct type, not as
  # Go multi-values.  The return statement lowering uses the same flag to wrap
  # the tuple expression in a matching struct composite.
  let returnTypes = switch retMono
    case TTuple(items) =>
      if items.Len() > 1 then
        [monoTypeToGoStrWithParamsIn(retMono, child.typeParamNames, child.pathAliases)]
      else
        goReturnTypesFromOption(ret, child.typeParams)
      end
    case _ => goReturnTypesFromOption(ret, child.typeParams)
  end
  var tupleStructReturn = switch retMono
    case TTuple(items) => items.Len() > 1
    case _ => false
  end
  child.tupleReturnStruct = tupleStructReturn
  var names: Slice[String] = []
  var index: Int = 0
  while index < params.Len()
    let param = params.Get(index).UnwrapOr(ast2.Param { Name: "", Type: ast2.TypeExpr.UnitType })
    let name = ctxFreshBinding(child, param.Name)
    ctxSetLocal(child, param.Name, typeinference2.TypeFromAST(param.Type))
    names = names.Append(name)
    index = index + 1
  end
  let lowered = translateFuncBodyAst(body, child)
  switch lowered
    case Err(msg) => Err(msg)
    case Ok(stmts) => Ok(newAstExprResult(goast.FuncLitFromStmts(names, params.Map(func(p: ast2.Param) -> String goType(p.Type, child.typeParams) end), returnTypes, stmts)))
  end
end

func translateGenericStructLitAstExpected(typeName: String, typeArgs: Slice[ast2.TypeExpr], fields: Slice[ast2.StructLitField], ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  let owner = typeinference2.TypeFromAST(ast2.TypeExpr.NamedType(typeName, typeArgs))
  let result = translateAstCompositeFields(fields, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], expected, owner)
  switch result
    case Err(msg) => Err(msg)
    case Ok(value) =>
      let typ = goType(ast2.TypeExpr.NamedType(typeName, typeArgs), ctx.typeParams)
      Ok(astExprWithPre(goast.Composite(goast.MustTypeExpr(typ), value.Elts), value.Pre))
  end
end

func translateTypeAsAst(value: ast2.Expr, typ: ast2.TypeExpr, ctx: Ref[egCtx]) -> Result[AstExprResult, String]
  let target = typeinference2.TypeFromAST(typ)
  switch value.Kind
    case SliceLitExpr(items) => translateSliceLitAst(items, ctx, target)
    case _ =>
      let translated = translateExprAstExpected(value, ctx, target)
      switch translated
        case Err(msg) => Err(msg)
        case Ok(v) => Ok(astExprWithPre(goast.Convert(monoTypeToGoStrIn(target, ctx.pathAliases), v.Expr), v.Pre))
      end
  end
end

func translateSliceLitAst(items: Slice[ast2.Expr], ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  let values = translateAstArgs(items, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], [] as Slice[ast2.MonoType])
  switch values
    case Err(msg) => Err(msg)
    case Ok(v) then
      let typ = switch expected
        case TUnit => emptySliceTypeFromReturn(ctx.retType, ctx.typeParamNames, ctx.pathAliases)
        case _ => monoTypeToGoStrWithParamsIn(expected, ctx.typeParamNames, ctx.pathAliases)
      end
      Ok(astExprWithPre(goast.SliceLiteral(typ, v.Exprs), v.Pre))
    end
  end
end

# A bare `[]` nested in a call has no direct expected type while its enclosing
# function often does (for example PSepBy returns Parser[Slice[A]]).  Preserve
# that element type instead of eagerly falling back to []any.
func emptySliceTypeFromReturn(typ: ast2.MonoType, typeParams: Slice[String], aliases: Map[String, String]) -> String
  switch typ
    case TApp(typeRef, args) then
      switch typeRef.value()
        case TCon(name) then
          if name == "Slice" then
            monoTypeToGoStrWithParamsIn(typ, typeParams, aliases)
          else
            findSliceTypeInMonos(args, typeParams, aliases, 0)
          end
        end
        case _ => findSliceTypeInMonos(args, typeParams, aliases, 0)
      end
    end
    case _ => "[]any"
  end
end

func findSliceTypeInMonos(items: Slice[ast2.MonoType], typeParams: Slice[String], aliases: Map[String, String], index: Int) -> String
  if index >= items.Len() then "[]any" else
    let found = emptySliceTypeFromReturn(items.Get(index).UnwrapOr(ast2.MonoType.TUnit), typeParams, aliases)
    if found == "[]any" then findSliceTypeInMonos(items, typeParams, aliases, index + 1) else found end
  end
end

# Switch cases lower to an if/else chain. Enum variants use a Go type assertion;
# the target enum's type arguments are preserved in the asserted variant type.
# When expected is "" or a unit type, the switch is in statement context and
# no temp variable is created — the if/else chain stands alone.
#
# A non-trivial subject (a call or selector such as `switch inferExpr(...)`) is
# hoisted into a temp variable before the branch chain.  Each branch lowers to
# `if v, ok := <subject>.(Variant); ok`, so embedding the raw expression would
# re-evaluate it once per pattern arm — exponential for deeply nested switches.
func translateSwitchAst(target: ast2.Expr, cases: Slice[ast2.SwitchCase], targetType: Option[ast2.MonoType], ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  let subject = translateSwitchSubject(target, ctx)
  switch subject
    case Err(msg) => Err(msg)
    case Ok(value) =>
      let hoisted = switch target.Kind
        case IdentExpr(_) => value
        case CallExpr(_, _, _) => hoistSwitchSubject(value, cases, ctx)
        case FieldExpr(_, _) => hoistSwitchSubject(value, cases, ctx)
        case _ => value
      end
      let isStmt = switch expected
        case TUnit => true
        case _ => false
      end
      if isStmt then
        # Statement context: emit only the if/else chain, no result temp.
        let branches = translateSwitchBranchesStmt(cases, targetType, target, hoisted.Expr, ctx)
        switch branches
          case Err(msg) => Err(msg)
          case Ok(stmts) => Ok(astExprWithPre(goast.Unit(), goast.AppendStmts(hoisted.Pre, stmts)))
        end
      else
        # Expression context: use a temp variable to hold the case result.
        let temp = ctxFreshExprTemp(ctx)
        let branches = translateSwitchBranches(cases, targetType, target, hoisted.Expr, temp, ctx, expected)
        switch branches
          case Err(msg) => Err(msg)
          case Ok(stmts) => Ok(astExprWithPre(goast.Ident(temp), goast.AppendStmts(hoisted.Pre, goast.AppendStmts(astSingleStmt(goast.DeclareFromType(temp, monoTypeToGoStrIn(expected, ctx.pathAliases))), stmts))))
        end
      end
  end
end

# Evaluate a non-trivial switch subject once and reference it through a temp.
# With zero cases the subject is never used by a branch, so no temp is created.
func hoistSwitchSubject(value: AstExprResult, cases: Slice[ast2.SwitchCase], ctx: Ref[egCtx]) -> AstExprResult
  if cases.Len() == 0 then value else
    let tmp = ctxFreshExprTemp(ctx)
    let decl = astSingleStmt(goast.Assign([goast.Ident(tmp)] as Slice[goast.Expr], ":=", [value.Expr] as Slice[goast.Expr]))
    AstExprResult { Expr: goast.Ident(tmp), Pre: goast.AppendStmts(value.Pre, decl) }
  end
end

func translateSwitchAstWithTargetType(target: ast2.Expr, cases: Slice[ast2.SwitchCase], targetType: Option[ast2.MonoType], ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  switch targetType
    case Some(typ) then
      let typedTarget = ast2.Expr { ID: target.ID, Pos: target.Pos, Kind: target.Kind, Type: Some(typ) }
      translateSwitchAst(typedTarget, cases, Some(typ), ctx, expected)
    end
    case None => translateSwitchAst(target, cases, None, ctx, expected)
  end
end

# patternArgsUsedInBody reports whether any name bound by a variant pattern is
# actually referenced by the case body.  When none are, the generated
# `if v, ok := expr.(Type); ok` assertion must bind `_` instead of v — a bound
# but unused v makes the emitted Go fail with "declared and not used".
func patternArgsUsedInBody(args: Slice[ast2.Pattern], body: ast2.Expr) -> Bool
  patternArgsUsedInBodyAt(args, body, 0)
end

func patternArgsUsedInBodyAt(args: Slice[ast2.Pattern], body: ast2.Expr, index: Int) -> Bool
  if index >= args.Len() then false else
    let pattern = args.Get(index).UnwrapOr(ast2.Pattern.WildcardPattern)
    switch pattern
      case BindPattern(name) => exprUsesName(body, name) || patternArgsUsedInBodyAt(args, body, index + 1)
      case TuplePattern(items) => patternItemsUsedInBody(items, body, 0) || patternArgsUsedInBodyAt(args, body, index + 1)
      case VariantPattern(_, subArgs) => patternArgsUsedInBody(subArgs, body) || patternArgsUsedInBodyAt(args, body, index + 1)
      case _ => patternArgsUsedInBodyAt(args, body, index + 1)
    end
  end
end

# patternItemsUsedInBody checks names bound by the items of a TuplePattern.
func patternItemsUsedInBody(items: Slice[ast2.Pattern], body: ast2.Expr, index: Int) -> Bool
  if index >= items.Len() then false else
    let pattern = items.Get(index).UnwrapOr(ast2.Pattern.WildcardPattern)
    switch pattern
      case BindPattern(name) => exprUsesName(body, name) || patternItemsUsedInBody(items, body, index + 1)
      case TuplePattern(subItems) => patternItemsUsedInBody(subItems, body, 0) || patternItemsUsedInBody(items, body, index + 1)
      case VariantPattern(_, subArgs) => patternArgsUsedInBody(subArgs, body) || patternItemsUsedInBody(items, body, index + 1)
      case _ => patternItemsUsedInBody(items, body, index + 1)
    end
  end
end

func exprUsesName(expr: ast2.Expr, name: String) -> Bool
  switch expr.Kind
    case IdentExpr(n) => n == name
    case CallExpr(callee, _, args) => exprUsesName(callee, name) || exprsUseName(args, name)
    case DictionaryCallExpr(_, receiver, args) => exprUsesName(receiver, name) || exprsUseName(args, name)
    case FieldExpr(receiver, _) => exprUsesName(receiver, name)
    case UnaryExpr(_, value) => exprUsesName(value, name)
    case BinaryExpr(_, left, right) => exprUsesName(left, name) || exprUsesName(right, name)
    case IfExpr(cond, thenBody, elseBody) => exprUsesName(cond, name) || exprUsesName(thenBody, name) || exprUsesName(elseBody, name)
    case BlockExpr(stmts) => stmtsUseName(stmts, name)
    case SwitchExpr(target, cases, _) => exprUsesName(target, name) || switchCasesUseName(cases, name)
    case FuncLitExpr(_, _, body) => exprUsesName(body, name)
    case SliceLitExpr(items) => exprsUseName(items, name)
    case TypeAsExpr(value, _) => exprUsesName(value, name)
    case StructLitExpr(_, fields) => structLitFieldsUseName(fields, name)
    case GenericStructLitExpr(_, _, fields) => structLitFieldsUseName(fields, name)
    case InlineGoExpr(_, _, values, _) => goOperandsUseName(values, name)
    case MapLitExpr(pairs) => exprPairsUseName(pairs, name)
    case SetLitExpr(items) => exprsUseName(items, name)
    case TupleExpr(items) => exprsUseName(items, name)
    case _ => false
  end
end

func exprsUseName(items: Slice[ast2.Expr], name: String) -> Bool
  if items.Len() == 0 then false else
    exprUsesName(items.Get(0).UnwrapOr(ast2.EmptyExpr()), name) || exprsUseName(sliceDrop(items, 1), name)
  end
end

func stmtsUseName(items: Slice[ast2.Stmt], name: String) -> Bool
  if items.Len() == 0 then false else
    stmtUsesName(items.Get(0).UnwrapOr(ast2.Stmt.ExprStmt(ast2.EmptyExpr())), name) || stmtsUseName(sliceDrop(items, 1), name)
  end
end

func stmtUsesName(stmt: ast2.Stmt, name: String) -> Bool
  switch stmt
    case ExprStmt(e) => exprUsesName(e, name)
    case LetStmt(bind) => exprUsesName(bind.Value, name)
    case VarStmt(bind) => exprUsesName(bind.Value, name)
    case TupleLetStmt(_, value) => exprUsesName(value, name)
    case LetRecStmt(bindings) => letRecBindingsUseName(bindings, name)
    case AssignStmt(target, value) => exprUsesName(target, name) || exprUsesName(value, name)
    case ReturnWithStmt(e) => exprUsesName(e, name)
    case WhileStmt(cond, body) => exprUsesName(cond, name) || exprUsesName(body, name)
    case _ => false
  end
end

func letRecBindingsUseName(bindings: Slice[ast2.LetRecBind], name: String) -> Bool
  if bindings.Len() == 0 then false else
    let b = bindings.Get(0).UnwrapOr(ast2.LetRecBind { Name: "", Type: ast2.TypeExpr.UnitType, Value: ast2.EmptyExpr() })
    exprUsesName(b.Value, name) || letRecBindingsUseName(sliceDrop(bindings, 1), name)
  end
end

func goOperandsUseName(items: Slice[ast2.GoOperand], name: String) -> Bool
  if items.Len() == 0 then false else
    let o = items.Get(0).UnwrapOr(ast2.GoOperand { Name: "", Value: ast2.EmptyExpr() })
    exprUsesName(o.Value, name) || goOperandsUseName(sliceDrop(items, 1), name)
  end
end

func switchCasesUseName(cases: Slice[ast2.SwitchCase], name: String) -> Bool
  if cases.Len() == 0 then false else
    let current = cases.Get(0).UnwrapOr(ast2.SwitchCase { Pattern: ast2.Pattern.WildcardPattern, Body: ast2.EmptyExpr() })
    exprUsesName(current.Body, name) || switchCasesUseName(sliceDrop(cases, 1), name)
  end
end

func structLitFieldsUseName(fields: Slice[ast2.StructLitField], name: String) -> Bool
  if fields.Len() == 0 then false else
    let f = fields.Get(0).UnwrapOr(ast2.StructLitField { Name: "", Value: ast2.EmptyExpr() })
    exprUsesName(f.Value, name) || structLitFieldsUseName(sliceDrop(fields, 1), name)
  end
end

func exprPairsUseName(pairs: Slice[(ast2.Expr, ast2.Expr)], name: String) -> Bool
  if pairs.Len() == 0 then false else
    let pair = pairs.Get(0).UnwrapOr((ast2.EmptyExpr(), ast2.EmptyExpr()))
    let (k, v) = pair
    exprUsesName(k, name) || exprUsesName(v, name) || exprPairsUseName(sliceDrop(pairs, 1), name)
  end
end

# translateSwitchBranchesStmt is the statement-context version that does not
# create a temp variable — each case body emits plain statements directly.
func translateSwitchBranchesStmt(cases: Slice[ast2.SwitchCase], targetType: Option[ast2.MonoType], sourceTarget: ast2.Expr, target: goast.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  if cases.Len() == 0 then
    let empty: Slice[goast.Stmt] = []
    Ok(empty)
  else
    let current = cases.Get(0).UnwrapOr(ast2.SwitchCase { Pattern: ast2.Pattern.WildcardPattern, Body: ast2.EmptyExpr() })
    switch current.Pattern
      case WildcardPattern =>
        translateSwitchCaseBodyStmt(current.Body, ctx)
      case VariantPattern(name, args) then
        let rest = translateSwitchBranchesStmt(sliceDrop(cases, 1), targetType, sourceTarget, target, ctx)
        switch rest
          case Err(msg) => Err(msg)
          case Ok(next) then
            let targetMono = targetType
            switch targetMono
              case Some(tm) then
                let typ = switchVariantType(sourceTarget, tm, ctx)
                let valueName = if args.Len() == 0 || allWildcards(args, 0) || !patternArgsUsedInBody(args, current.Body) then
                  "_"
                else
                  "__mygo_match_" + ctxFreshExprTemp(ctx)
                end
                let child = Ref.new(ctxChild(ctx))
                bindPatternArgumentsWithTypes(child, args, valueName, 0, name, tm, ctx)
                let body = translateSwitchCaseBodyStmt(current.Body, child)
                switch body
                  case Err(msg) => Err(msg)
                  case Ok(branchStmts) => Ok(astSingleStmt(goast.VariantIf(target, goast.VariantTypeForTarget(typ, name), valueName, branchStmts, next)))
                end
              end
              case None => Err("cannot resolve switch target type")
            end
          end
        end
      end
      case _ => Err("unsupported pattern in statement-context switch")
    end
  end
end

# translateSwitchCaseBodyStmt translates a switch case body as statements
# without assigning the result to a temp variable or adding trailing return.
func translateSwitchCaseBodyStmt(body: ast2.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  switch body.Kind
    case BlockExpr(items) =>
      let stmts = translateAstBlockAsStmts(items, ctx, 0, [] as Slice[goast.Stmt])
      switch stmts
        case Err(msg) => Err(msg)
        case Ok(v) => Ok(v)
      end
    case UnitExpr =>
      let empty: Slice[goast.Stmt] = []
      Ok(empty)
    case IfExpr(cond, thenExpr, elseExpr) =>
      translateAstIfStmt(cond, thenExpr, elseExpr, ctx)
    case _ then
      # Statement-form switch bodies discard their value.  Lowering an FFI
      # call such as fmt.Println(...) through translateExprAst would wrap the
      # result in a Result temp that is assigned but never read (Go's
      # "declared and not used" error).  translateDiscardBindingValue keeps the
      # call as a plain statement and drops the boundary wrapping.
      let value = translateDiscardBindingValue(body, ctx)
      switch value
        case Ok(v) => Ok(translateUnitBranchStmts(body, v))
        case Err(msg) => Err(msg)
      end
    end
  end
end

func translateSwitchSubject(target: ast2.Expr, ctx: Ref[egCtx]) -> Result[AstExprResult, String]
  switch target.Kind
    case CallExpr(fn, typeArgs, args) then
      switch ffiResultSignature(fn, ctx)
        case Some(sig) then
          let valueType = sig.Results.Get(0).UnwrapOr("")
          if valueType == "" then
            Err("Go FFI function has no value return type")
          else
            let resultType = ast2.MonoType.TApp(
              Ref.new(ast2.MonoType.TCon("Result")),
              [
                ast2.MonoType.TCon(valueType),
                ast2.MonoType.TCon("Error"),
              ]
            )
            translateFFIResultCall(fn, typeArgs, args, ctx, resultType, sig)
          end
        end
        case None => translateExprAst(target, ctx)
      end
    end
    case _ => translateExprAst(target, ctx)
  end
end

func normalizeNumberLiteral(value: String) -> String
  let suffixes = ["i8", "u8", "i16", "u16", "i32", "u32", "i64", "u64", "u", "f32", "f64"] as Slice[String]
  normalizeNumberLiteralSuffix(value, suffixes)
end

func normalizeNumberLiteralSuffix(value: String, suffixes: Slice[String]) -> String
  if suffixes.Len() == 0 then value else
    let suffix = suffixes.Get(0).UnwrapOr("")
    if strings.HasSuffix(value, suffix) then strings.TrimSuffix(value, suffix) else normalizeNumberLiteralSuffix(value, sliceDrop(suffixes, 1)) end
  end
end

func translateSwitchBranches(cases: Slice[ast2.SwitchCase], targetType: Option[ast2.MonoType], sourceTarget: ast2.Expr, target: goast.Expr, temp: String, ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[Slice[goast.Stmt], String]
  if cases.Len() == 0 then
    # Enum cases are lowered to a type-assertion if/else chain.  A final
    # variant needs no synthetic wildcard branch: for an exhaustive enum
    # match (for example Some/None) every runtime value is already covered.
    # Leaving the final else absent also keeps the generated Go valid for
    # switches whose exhaustiveness is checked by the type layer.
    let noBranches: Slice[goast.Stmt] = []
    Ok(noBranches)
  else
    let current = cases.Get(0).UnwrapOr(ast2.SwitchCase { Pattern: ast2.Pattern.WildcardPattern, Body: ast2.EmptyExpr() })
    switch current.Pattern
      case BindPattern(name) then
        # Inference leaves this form only when the bare name was not a
        # zero-field enum constructor in the surrounding environment.
        let child = Ref.new(ctxChild(ctx))
        ctxSetBinding(child, name, temp)
        translateSwitchCaseBody(current.Body, child, expected, temp)
      end
      case WildcardPattern => translateSwitchCaseBody(current.Body, ctx, expected, temp)
      case TuplePattern(items) then
        let child = Ref.new(ctxChild(ctx))
        bindTuplePattern(child, items, temp, 0)
        translateSwitchCaseBody(current.Body, child, expected, temp)
      end
      case LiteralPattern(kind, literal) then
        let body = translateSwitchCaseBody(current.Body, ctx, expected, temp)
        let rest = translateSwitchBranches(sliceDrop(cases, 1), targetType, sourceTarget, target, temp, ctx, expected)
        switch body
          case Err(msg) => Err(msg)
          case Ok(bodyStmts) =>
            switch rest
              case Err(msg) => Err(msg)
              case Ok(next) =>
                let pattern = if kind == "string" then goast.String(strconv.Quote(literal)) elsif kind == "rune" then goast.Rune(literal) else goast.Number(literal) end
                Ok(astSingleStmt(goast.If(goast.Binary(target, "==", pattern), bodyStmts, next)))
            end
        end
      end
      case VariantPattern(name, args) then
        let rest = translateSwitchBranches(sliceDrop(cases, 1), targetType, sourceTarget, target, temp, ctx, expected)
        switch rest
          case Err(msg) => Err(msg)
          case Ok(next) then
            let targetMono = targetType
            switch targetMono
              case Some(tm) =>
                let typ = switchVariantType(sourceTarget, tm, ctx)
                let valueName = if args.Len() == 0 || allWildcards(args, 0) || !patternArgsUsedInBody(args, current.Body) then "_" else "__mygo_match_" + ctxFreshExprTemp(ctx) end
                let child = Ref.new(ctxChild(ctx))
                bindPatternArgumentsWithTypes(child, args, valueName, 0, name, tm, ctx)
                let body = translateSwitchCaseBody(current.Body, child, expected, temp)
                switch body
                  case Err(msg) => Err(msg)
                  case Ok(branchStmts) => Ok(astSingleStmt(goast.VariantIf(target, goast.VariantTypeForTarget(typ, name), valueName, branchStmts, next)))
                end
              case None => Err("cannot resolve switch target type for variant " + name)
            end
          end
        end
      end
    end
  end
end

# switchVariantType renders the enum type used by a variant assertion.  For a
# switch directly on an FFI call returning Result[T, error] the assertion type
# must come from the Go signature: translateSwitchSubject builds the boundary
# wrapper from sig.Results[0], so Result__Ok[T, error] only matches when T is the
# raw Go type.  The inferred MonoType degrades unrepresentable Go types such as
# os.Stat's os.FileInfo to `any`, which would make the assertion Result__Ok[any,
# error] and never match the runtime Result__Ok[os.FileInfo, error].
func switchVariantType(target: ast2.Expr, tm: ast2.MonoType, ctx: Ref[egCtx]) -> String
  switch target.Kind
    case CallExpr(fn, _, _) =>
      switch ffiResultSignature(fn, ctx)
        case Some(sig) =>
          let valueType = sig.Results.Get(0).UnwrapOr("")
          if valueType == "" then
            monoTypeToGoStrWithParamsIn(tm, ctx.typeParamNames, ctx.pathAliases)
          else
            "Result[" + valueType + ", error]"
          end
        case None => monoTypeToGoStrWithParamsIn(tm, ctx.typeParamNames, ctx.pathAliases)
      end
    case _ => monoTypeToGoStrWithParamsIn(tm, ctx.typeParamNames, ctx.pathAliases)
  end
end

# translateSwitchBranchesBindPattern handles a BindPattern that is NOT an enum
# variant, i.e. a true variable-binding pattern.
func translateSwitchBranchesBindPattern(name: String, body: ast2.Expr, target: goast.Expr, temp: String, ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[Slice[goast.Stmt], String]
  let child = Ref.new(ctxChild(ctx))
  ctxSetBinding(child, name, temp)
  translateSwitchCaseBody(body, child, expected, temp)
end

func translateSwitchCaseBody(body: ast2.Expr, ctx: Ref[egCtx], expected: ast2.MonoType, temp: String) -> Result[Slice[goast.Stmt], String]
  let value = translateExprAstExpected(body, ctx, expected)
  switch value
    case Err(msg) => Err(msg)
    # A case body ending in `return` exits the enclosing function; the switch
    # result temp is dead after it and must not be assigned (the emitted Go
    # would otherwise mix `return X` with a bogus `temp = <unit>` assignment).
    case Ok(v) =>
      if caseBodyEndsInReturn(body) then
        Ok(v.Pre)
      else
        Ok(goast.AppendStmts(v.Pre, astSingleStmt(goast.Assign(astSingleExpr(goast.Ident(temp)), "=", astSingleExpr(v.Expr)))))
      end
  end
end

func caseBodyEndsInReturn(body: ast2.Expr) -> Bool
  switch body.Kind
    case BlockExpr(items) => blockEndsInReturn(items)
    case _ => false
  end
end

func blockEndsInReturn(items: Slice[ast2.Stmt]) -> Bool
  if items.Len() == 0 then false else
    let last = items.Get(items.Len() - 1).UnwrapOr(ast2.Stmt.ExprStmt(ast2.EmptyExpr()))
    switch last
      case ReturnWithStmt(_) => true
      case ReturnStmt => true
      case _ => false
    end
  end
end

func bindPatternArguments(ctx: Ref[egCtx], args: Slice[ast2.Pattern], valueName: String, index: Int) -> ()
  if index < args.Len() then
    bindPattern(ctx, args.Get(index).UnwrapOr(ast2.Pattern.WildcardPattern), valueName + ".F" + index.ToString())
    bindPatternArguments(ctx, args, valueName, index + 1)
  end
end

# bindPatternArgumentsWithTypes is like bindPatternArguments but also sets
# the local type for each bound variable by looking up the enum variant's
# field types from sourceTypes (seeded by seedEnumVariantFieldTypes).
func bindPatternArgumentsWithTypes(ctx: Ref[egCtx], args: Slice[ast2.Pattern], valueName: String, index: Int, variantName: String, targetMono: ast2.MonoType, outerCtx: Ref[egCtx]) -> ()
  if index < args.Len() then
    let pattern = args.Get(index).UnwrapOr(ast2.Pattern.WildcardPattern)
    bindPattern(ctx, pattern, valueName + ".F" + index.ToString())
    switch pattern
      case BindPattern(name) then
        let fieldMono = extractVariantFieldType(targetMono, index, variantName, ctx)
        ctxSetLocal(ctx, name, fieldMono)
        ctxSetLocal(outerCtx, name, fieldMono)
        ctx.patternTypes.Set(name, fieldMono)
        bindPatternArgumentsWithTypes(ctx, args, valueName, index + 1, variantName, targetMono, outerCtx)
      end
      case _ then
        bindPatternArgumentsWithTypes(ctx, args, valueName, index + 1, variantName, targetMono, outerCtx)
      end
    end
  end
end

func extractVariantFieldType(targetMono: ast2.MonoType, index: Int, variantName: String, ctx: Ref[egCtx]) -> ast2.MonoType
  let fieldTypes = ctx.variantFieldMonoTypes.Get(variantName)
  switch fieldTypes
    case Some(monos) => resolveVariantFieldMono(monos.Get(index).UnwrapOr(ast2.MonoType.TUnit), targetMono)
    case None =>
      switch targetMono
        case TApp(ctor, args) then
          let argIdx = if args.Len() == 1 => 0 else index
          args.Get(argIdx).UnwrapOr(ast2.MonoType.TUnit)
        end
        case _ => ast2.MonoType.TUnit
      end
  end
end

# Enum declarations store their field types with TParam IDs (for example
# Result[A, E].Ok(A) stores TParam(-1)).  At a match site substitute those
# IDs with the actual receiver arguments, preserving Result[A, E] rather
# than emitting Result[any, any].
func resolveVariantFieldMono(fieldMono: ast2.MonoType, targetMono: ast2.MonoType) -> ast2.MonoType
  switch targetMono
    case TApp(_, args) => typeinference2.ApplySubst(typeinference2.SubstFromEntries(bindTypeArgs(variantTypeParamIDs(args, 1, [] as Slice[Int]), args, 0, [] as Slice[typeinference2.SubstEntry])), fieldMono)
    case _ => fieldMono
  end
end

func variantTypeParamIDs(args: Slice[ast2.MonoType], index: Int, out: Slice[Int]) -> Slice[Int]
  if index > args.Len() then out else
    variantTypeParamIDs(args, index + 1, out.Append(-index))
  end
end


# allWildcards returns true when all patterns in the slice (from index onward)
# are WildcardPattern. Used to decide whether to emit "_" as the match variable
# name instead of a named temp, avoiding "declared and not used" Go errors.
func allWildcards(patterns: Slice[ast2.Pattern], index: Int) -> Bool
  if index >= patterns.Len() then
    true
  else
    let p = patterns.Get(index).UnwrapOr(ast2.Pattern.WildcardPattern)
    switch p
      case WildcardPattern => allWildcards(patterns, index + 1)
      case _ => false
    end
  end
end

func bindPattern(ctx: Ref[egCtx], pattern: ast2.Pattern, valueName: String) -> ()
  switch pattern
    case BindPattern(name) => ctxSetBinding(ctx, name, valueName)
    case WildcardPattern => ()
    case VariantPattern(name, args) =>
      if args.Len() == 0 then ctxSetBinding(ctx, name, valueName) else bindPatternArguments(ctx, args, valueName, 0) end
    case TuplePattern(items) => bindTuplePattern(ctx, items, valueName, 0)
    case _ => ()
  end
end

func bindTuplePattern(ctx: Ref[egCtx], items: Slice[ast2.Pattern], valueName: String, index: Int) -> ()
  if index < items.Len() then
    bindPattern(ctx, items.Get(index).UnwrapOr(ast2.Pattern.WildcardPattern), valueName + ".F" + index.ToString())
    bindTuplePattern(ctx, items, valueName, index + 1)
  end
end

func switchTargetGoType(target: ast2.Expr, ctx: Ref[egCtx]) -> Result[String, String]
  switch target.Kind
    case IdentExpr(name) =>
      let found = ctxGetLocal(ctx, name)
      switch found
        case Some(typ) => Ok(monoTypeToGoStrIn(typ, ctx.pathAliases))
        case None => Err("unresolved identifier " + name + " in switch target")
      end
    case FieldExpr(base, field) =>
      let baseMono = resolveExprMonoType(base, ctx)
      switch baseMono
        case Some(bt) =>
          switch lookupFieldInMonoType(bt, field, ctx)
            case Some(fieldMono) => Ok(monoTypeToGoStrIn(fieldMono, ctx.pathAliases))
            case None =>
              let btStr = monoTypeToMygoStr(bt)
              Err("unresolved field " + field + " on " + btStr)
          end
        case None => Err("cannot resolve base type for field " + field)
      end
    case _ =>
      switch ffiResultSignature(target, ctx)
        case Some(sig) =>
          let valueType = sig.Results.Get(0).UnwrapOr("")
          Ok("Result[" + valueType + ", error]")
        case None => Err("cannot determine switch target type")
      end
  end
end

# resolveExprMonoType resolves an expression to its MonoType.
func resolveExprMonoType(expr: ast2.Expr, ctx: Ref[egCtx]) -> Option[ast2.MonoType]
  switch expr.Type
    case Some(t) => Some(t)
    case None =>
      switch expr.Kind
        case IdentExpr(name) =>
          switch ctxGetLocal(ctx, name)
            case Some(t) => Some(t)
            case None => None
          end
        case FieldExpr(base, field) =>
          switch resolveExprMonoType(base, ctx)
            case Some(bt) then
              let resolvedBase = switch bt
                case TApp(typeRef, args) then
                  switch typeRef.value()
                    case TCon(name) then
                      if name == "Ref" && args.Len() == 1 then
                        args.Get(0).UnwrapOr(bt)
                      else
                        bt
                      end
                    end
                    case _ => bt
                  end
                end
                case _ => bt
              end
              switch resolvedBase
                case TQualifiedName(path, inner) =>
                  switch ffiResultSignatureInPackages(ctx.goPackages, path, field)
                    case Some(sig) => Some(goSignatureToMono(sig))
                    case None =>
                      switch ffiSignatureInPackages(ctx.goPackages, path, field)
                        case Some(sig) => Some(goSignatureToMono(sig))
                        case None => lookupFieldInMonoType(resolvedBase, field, ctx)
                      end
                  end
                case _ => lookupFieldInMonoType(resolvedBase, field, ctx)
              end
            end
            case None => None
          end
        case CallExpr(fn, typeArgs, args) =>
          let fnMono = resolveExprMonoType(fn, ctx)
          switch fnMono
            case Some(m) =>
              switch m
                case TFunc(tfnArgs, tret) => Some(tret.value())
                case TVariadic(tfnArgs, tret) => Some(tret.value())
                case _ => None
              end
            case None => None
          end
        case _ => None
      end
  end
end

func isGoPackageAlias(alias: String, packages: Slice[typeinference2.GoPackageEntry]) -> Bool
  if packages.Len() == 0 then false else
    switch packages.Get(0)
      case Some(pkg) => (pkg.Alias == alias) || isGoPackageAlias(alias, sliceDrop(packages, 1))
      case None => isGoPackageAlias(alias, sliceDrop(packages, 1))
    end
  end
end

func goSignatureToMono(sig: typeinference2.GoFuncSignature) -> ast2.MonoType
  typeinference2.GoSignatureType(sig)
end

# extractTypeArgs extracts type arguments from a Go type string.
# e.g. "*List[T]" → ["T"], "Option[*List[T]]" → ["*List[T]"]
func extractTypeArgs(typ: String) -> Slice[String]
  let parts = splitTypeArgs(typ)
  parts.Args
end

# substituteTypeParams replaces struct type parameter names with actual type
# arguments in a type string. Processes params in order so param[i]→args[i].
func substituteTypeParams(typ: String, params: Slice[String], args: Slice[String], index: Int) -> String
  if index >= params.Len() || index >= args.Len() then
    typ
  else
    let param = params.Get(index).UnwrapOr("")
    let arg = args.Get(index).UnwrapOr("")
    if param != "" && arg != "" then
      substituteTypeParams(strings.ReplaceAll(typ, param, arg), params, args, index + 1)
    else
      substituteTypeParams(typ, params, args, index + 1)
    end
  end
end

func translateBlockExprAstExpected(items: Slice[ast2.Stmt], ctx: Ref[egCtx], index: Int, pre: Slice[goast.Stmt], expected: ast2.MonoType) -> Result[AstExprResult, String]
  if items.Len() == 0 then
    Ok(astExprWithPre(goast.Unit(), pre))
  else
    let stmt: ast2.Stmt = items.Get(index).UnwrapOr(ast2.Stmt.ExprStmt(ast2.EmptyExpr()))
    if index == items.Len() - 1 then
      switch stmt
        case ExprStmt(expr) =>
          let value = translateExprAstExpected(expr, ctx, expected)
          switch value
            case Ok(v) => Ok(astExprWithPre(v.Expr, goast.AppendStmts(pre, v.Pre)))
            case Err(msg) => Err(msg)
          end
        case WhileStmt(cond, body) =>
          let value = translateAstWhileExpr(cond, body, ctx)
          switch value
            case Ok(v) => Ok(astExprWithPre(v.Expr, goast.AppendStmts(pre, v.Pre)))
            case Err(msg) => Err(msg)
          end
        case _ =>
          # A statement-only tail still gives the block the unit value.
          let stmts = translateAstLeadingStmt(stmt, ctx)
          switch stmts
            case Err(msg) => Err(msg)
            case Ok(v) => Ok(astExprWithPre(goast.Unit(), goast.AppendStmts(pre, v)))
          end
      end
    else
      let leading = translateAstLeadingStmt(stmt, ctx)
      switch leading
        case Ok(stmts) => translateBlockExprAstExpected(items, ctx, index + 1, goast.AppendStmts(pre, stmts), expected)
        case Err(msg) => Err(msg)
      end
    end
  end
end

# While is unit-valued in a block expression. Keep the loop in the prelude
# and expose an explicit unit expression to the surrounding value context.
func translateAstWhileExpr(cond: ast2.Expr, body: ast2.Expr, ctx: Ref[egCtx]) -> Result[AstExprResult, String]
  let stmts = translateAstWhileStmt(cond, body, ctx)
  switch stmts
    case Err(msg) => Err(msg)
    case Ok(v) => Ok(astExprWithPre(goast.Unit(), v))
  end
end

func translateBlockExprAst(items: Slice[ast2.Stmt], ctx: Ref[egCtx], index: Int, pre: Slice[goast.Stmt]) -> Result[AstExprResult, String]
  if items.Len() == 0 then
    Ok(astExprWithPre(goast.Unit(), pre))
  else
    let stmt: ast2.Stmt = items.Get(index).UnwrapOr(ast2.Stmt.ExprStmt(ast2.EmptyExpr()))
    if index == items.Len() - 1 then
      switch stmt
        case ExprStmt(expr) =>
          let value = translateExprAst(expr, ctx)
          switch value
            case Ok(v) => Ok(astExprWithPre(v.Expr, goast.AppendStmts(pre, v.Pre)))
            case Err(msg) => Err(msg)
          end
        case _ =>
          # A statement-only tail still gives the block the unit value.
          let stmts = translateAstLeadingStmt(stmt, ctx)
          switch stmts
            case Err(msg) => Err(msg)
            case Ok(v) => Ok(astExprWithPre(goast.Unit(), goast.AppendStmts(pre, v)))
          end
      end
    else
      let leading = translateAstLeadingStmt(stmt, ctx)
      switch leading
        case Ok(stmts) => translateBlockExprAst(items, ctx, index + 1, goast.AppendStmts(pre, stmts))
        case Err(msg) => Err(msg)
      end
    end
  end
end

func translateIfAst(cond: ast2.Expr, thenExpr: ast2.Expr, elseExpr: ast2.Expr, ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  let c = translateExprAst(cond, ctx)
  let t = translateExprAstExpected(thenExpr, ctx, expected)
  let e = translateExprAstExpected(elseExpr, ctx, expected)
  switch c
    case Err(msg) => Err(msg)
    case Ok(cv) =>
      switch t
        case Err(msg) => Err(msg)
        case Ok(tv) =>
          switch e
            case Err(msg) => Err(msg)
            case Ok(ev) =>
              switch expected
                # A Unit-valued conditional is statement control flow.  Do
                # not synthesize an `any` result slot: calls such as
                # testing.T.Fatalf have no Go value to assign into it.
                case TUnit =>
                  let thenStmts = translateUnitBranchStmts(thenExpr, tv)
                  let elseStmts = translateUnitBranchStmts(elseExpr, ev)
                  Ok(astExprWithPre(goast.Unit(), goast.AppendStmts(cv.Pre, astSingleStmt(goast.If(cv.Expr, thenStmts, elseStmts)))))
                case _ =>
                  let temp = ctxFreshExprTemp(ctx)
                  let expStr = expectedGoType(expected, ctx.pathAliases)
                  let typ = if expStr == "" then "any" else expStr end
                  let thenStmts = goast.AppendStmts(tv.Pre, astSingleStmt(goast.Assign(astSingleExpr(goast.Ident(temp)), "=", astSingleExpr(tv.Expr))))
                  let elseStmts = goast.AppendStmts(ev.Pre, astSingleStmt(goast.Assign(astSingleExpr(goast.Ident(temp)), "=", astSingleExpr(ev.Expr))))
                  let pre = goast.AppendStmts(
                    cv.Pre,
                    astTwoStmts(goast.DeclareFromType(temp, typ), goast.If(cv.Expr, thenStmts, elseStmts)),
                  )
                  Ok(astExprWithPre(goast.Ident(temp), pre))
              end
          end
      end
  end
end

func translateUnitBranchStmts(source: ast2.Expr, value: AstExprResult) -> Slice[goast.Stmt]
  switch source.Kind
    # `()` has no Go statement representation. Its prelude (if any) is still
    # significant, but emitting the lowered `struct{}{}` as an expression
    # statement produces Go's "value ... is not used" error.
    case UnitExpr => value.Pre
    case _ => goast.AppendStmts(value.Pre, astSingleStmt(goast.ExpressionStmt(value.Expr)))
  end
end

func translateStructLitAst(typeName: String, fields: Slice[ast2.StructLitField], ctx: Ref[egCtx]) -> Result[AstExprResult, String]
  translateStructLitAstExpected(typeName, fields, ctx, ast2.MonoType.TUnit)
end

func translateStructLitAstExpected(typeName: String, fields: Slice[ast2.StructLitField], ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  let owner = typeinference2.TypeFromAST(ast2.TypeExpr.NamedType(typeName, [] as Slice[ast2.TypeExpr]))
  let result = translateAstCompositeFields(fields, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], expected, owner)
  switch result
    case Err(msg) => Err(msg)
    # The source may omit generic arguments (`Pair { ... }`) when its
    # expected/inferred type supplies them. Go requires those arguments on a
    # composite literal, so retain the instantiated expected type here.
    case Ok(value) => Ok(astExprWithPre(goast.Composite(goast.MustTypeExpr(structLitGoType(typeName, expected, ctx.pathAliases)), value.Elts), value.Pre))
  end
end

func structLitGoType(typeName: String, expected: ast2.MonoType, aliases: Map[String, String]) -> String
  switch expected
    case TApp(ctor, _) then
      switch ctor.value()
        case TCon(name) => if name == typeName then monoTypeToGoStrIn(expected, aliases) else typeName end
        case _ => typeName
      end
    end
    case _ => typeName
  end
end

func translateAstCompositeFields(fields: Slice[ast2.StructLitField], ctx: Ref[egCtx], index: Int, out: Slice[goast.Expr], pre: Slice[goast.Stmt], expected: ast2.MonoType, owner: ast2.MonoType) -> Result[AstCompositeFields, String]
  if index >= fields.Len() then
    Ok(AstCompositeFields { Elts: out, Pre: pre })
  else
    let field = fields.Get(index).UnwrapOr(ast2.StructLitField { Name: "", Value: ast2.EmptyExpr() })
    # The field's inferred type is the most precise expected type for its
    # value: it is already unified with the struct's instantiated field type
    # (e.g. `Value` of `ps.Reply[JsonValue]` is `JsonValue`), and it stays
    # correct even when the struct's generic arguments were omitted in the
    # source or when the struct comes from an imported package.  Fall back to
    # the struct-field table, then to the whole struct type.
    let fieldExpected = switch field.Value.Type
      case Some(t) => t
      case None => lookupFieldInMonoType(owner, field.Name, ctx).UnwrapOr(expected)
    end
    let value = translateExprAstExpected(field.Value, ctx, fieldExpected)
    switch value
      case Err(msg) => Err(msg)
      case Ok(v) => translateAstCompositeFields(
        fields,
        ctx,
        index + 1,
        out.Append(goast.KeyValue(goast.Ident(sanitizeIdent(field.Name)), v.Expr)),
        goast.AppendStmts(pre, v.Pre),
        expected,
        owner,
      )
    end
  end
end

func translateBinaryAst(op: String, left: ast2.Expr, right: ast2.Expr, ctx: Ref[egCtx]) -> Result[AstExprResult, String]
  translateBinaryAstExpected(op, left, right, ctx, ast2.MonoType.TUnit)
end

func translateBinaryAstExpected(op: String, left: ast2.Expr, right: ast2.Expr, ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  let l = translateExprAstExpected(left, ctx, expected)
  let r = translateExprAstExpected(right, ctx, expected)
  switch l
    case Err(msg) => Err(msg)
    case Ok(lv) =>
      switch r
        case Err(msg) => Err(msg)
        case Ok(rv) =>
          let pre = goast.AppendStmts(lv.Pre, rv.Pre)
          if op == "|>" then
            Ok(astExprWithPre(goast.Call(rv.Expr, astSingleExpr(lv.Expr)), pre))
          else
            if op == "<|" then
              Ok(astExprWithPre(goast.Call(lv.Expr, astSingleExpr(rv.Expr)), pre))
            else
              Ok(astExprWithPre(goast.Binary(lv.Expr, op, rv.Expr), pre))
            end
          end
      end
  end
end

func translateCallAst(callee: ast2.Expr, typeArgs: Slice[ast2.TypeExpr], args: Slice[ast2.Expr], ctx: Ref[egCtx]) -> Result[AstExprResult, String]
  translateCallAstExpected(callee, typeArgs, args, ctx, ast2.MonoType.TUnit)
end

func translateCallAstExpected(callee: ast2.Expr, typeArgs: Slice[ast2.TypeExpr], args: Slice[ast2.Expr], ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  switch translateRefCall(callee, args, ctx, expected)
    case Some(result) => result
    case None => translateCallAstExpectedNonRef(callee, typeArgs, args, ctx, expected)
  end
end

# Ref is a compiler boundary type, not a Go value with exported methods.
# Keep these two spellings aligned with the legacy backend:
#   Ref.new(x) -> &x
#   ref.value() -> *ref
func translateRefCall(callee: ast2.Expr, args: Slice[ast2.Expr], ctx: Ref[egCtx], expected: ast2.MonoType) -> Option[Result[AstExprResult, String]]
  switch callee.Kind
    case FieldExpr(base, field) =>
      switch base.Kind
        case IdentExpr(name) =>
          if name == "Ref" && field == "new" then
            if args.Len() != 1 then Some[Result[AstExprResult, String]](Err[AstExprResult, String]("Ref.new expects exactly one argument")) else
              let refFallback = ctx.retType
              let innerMono = refInnerExpected(expected, refFallback)
              let value = translateExprAstExpected(args.Get(0).UnwrapOr(ast2.EmptyExpr()), ctx, innerMono)
              switch value
                case Ok(v) => Some(Ok(astExprWithPre(goast.RefNew(v.Expr, monoTypeToGoStrIn(innerMono, ctx.pathAliases)), v.Pre)))
                case Err(msg) => Some(Err(msg))
              end
            end
          else
            if field == "value" && args.Len() == 0 then
              let value = translateExprAstExpected(base, ctx, ast2.MonoType.TUnit)
              switch value
                case Ok(v) => Some(Ok(astExprWithPre(goast.Unary("*", v.Expr), v.Pre)))
                case Err(msg) => Some(Err(msg))
              end
            else
              None
            end
          end
        case _ =>
          if field == "value" && args.Len() == 0 then
            let value = translateExprAstExpected(base, ctx, ast2.MonoType.TUnit)
            switch value
              case Ok(v) => Some(Ok(astExprWithPre(goast.Unary("*", v.Expr), v.Pre)))
              case Err(msg) => Some(Err(msg))
            end
          else
            None
          end
      end
    case _ => None
  end
end

# expected is normally *T for a Ref[T] binding.  When Ref.new occurs under an
# Option constructor, the current function return type supplies the same hint.
func refInnerExpected(expected: ast2.MonoType, fallback: ast2.MonoType) -> ast2.MonoType
  switch expected
    case TApp(typeRef, args) then
      switch typeRef.value()
        case TCon(name) then
          if name == "Ref" && args.Len() == 1 then
            args.Get(0).UnwrapOr(ast2.MonoType.TUnit)
          else
            fallback
          end
        end
        case _ => fallback
      end
    end
    case _ => fallback
  end
end

func translateCallAstExpectedNonRef(callee: ast2.Expr, typeArgs: Slice[ast2.TypeExpr], args: Slice[ast2.Expr], ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  switch translateEnumVariantCallAst(callee, args, ctx)
    case Some(result) => result
    case None =>
      let isOption = switch expected
        case TCon(name) => name == "Option"
        case TApp(typeRef, _) then
          switch typeRef.value()
            case TCon(name) => name == "Option"
            case _ => false
          end
        end
        case _ => false
      end
      switch ffiOptionSignature(callee, ctx)
        case Some(sig) =>
          if isOption then
            translateFFIOptionCall(callee, typeArgs, args, ctx, expected, sig)
          else
            translatePlainCallAstExpected(callee, typeArgs, args, ctx, expected)
          end
        case None =>
          switch ffiResultSignature(callee, ctx)
            case Some(sig) =>
              translateFFIResultCall(callee, typeArgs, args, ctx, expected, sig)
            case None => translatePlainCallAstExpected(callee, typeArgs, args, ctx, expected)
          end
      end
  end
end

# Recognize `EnumName.VariantName(args...)` as an enum variant constructor
# call.  The variant table populated by seedEnumVariantsForVariants exposes
# every variant (zero- and non-zero-arity) under `EnumName.VariantName`.
# Without this lowering, the call form would route through the plain call
# path and codegen2 would emit a Go call against a non-existent field
# selector, breaking constructors such as `Decl.FuncDecl(name, ...)`.
func translateEnumVariantCallAst(callee: ast2.Expr, args: Slice[ast2.Expr], ctx: Ref[egCtx]) -> Option[Result[AstExprResult, String]]
  switch callee.Kind
    case FieldExpr(base, field) =>
      switch base.Kind
        case IdentExpr(name) =>
          switch ctx.enumValueConstructors.Get(name + "." + field)
            case Some(ctor) =>
              let values = translateAstArgs(args, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], callArgExpectedTypes(callee))
              switch values
                case Ok(v) => Some(Ok(astExprWithPre(goast.Call(goast.Ident(ctor), v.Exprs), v.Pre)))
                case Err(msg) => Some(Err(msg))
              end
            case None => None
          end
        # Imported enum constructors are parsed as nested selectors:
        # `ast2.Decl.LetDecl(bind)` lowers to
        # FieldExpr(FieldExpr(Ident("ast2"), "Decl"), "LetDecl").  The package
        # environment confirms the two-dot selector is a variant constructor
        # (Go-FFI members only register one-dot alias.Type keys).
        case FieldExpr(pkgBase, enumName) =>
          switch pkgBase.Kind
            case IdentExpr(alias) =>
              switch importedEnumVariantCtor(alias, enumName, field, ctx)
                case Some(ctor) =>
                  let values = translateAstArgs(args, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], callArgExpectedTypes(callee))
                  switch values
                    case Ok(v) => Some(Ok(astExprWithPre(goast.Call(goast.Ident(ctor), v.Exprs), v.Pre)))
                    case Err(msg) => Some(Err(msg))
                  end
                case None => None
              end
            case _ => None
          end
        case _ => None
      end
    case _ => None
  end
end

# importedEnumVariantCtor resolves `alias.Enum.Variant` as a constructor for an
# enum imported from another MyGO package.  The package environment
# (PackageInfo.Env) registers qualified enum-variant members under the
# `alias.Enum.Variant` key (see typeinference2's exportMyGoPackageEnumVariants),
# so a hit confirms the selector is a variant constructor rather than a Go-FFI
# package member or an inherent static method.  Returns the fully-qualified Go
# constructor name (e.g. `ast2.Decl__LetDecl__Ctor`) or None.
func importedEnumVariantCtor(alias: String, enumName: String, variantName: String, ctx: Ref[egCtx]) -> Option[String]
  switch ctx.pkgInfo
    case Some(pkgInfo) =>
      switch typeinference2.LookupEnvEntries(pkgInfo.Env, alias + "." + enumName + "." + variantName)
        case Some(_) => Some(alias + "." + enumConstructorGoName(sanitizeIdent(enumName), variantName))
        case None => None
      end
    case None => None
  end
end

func translatePlainCallAstExpected(callee: ast2.Expr, typeArgs: Slice[ast2.TypeExpr], args: Slice[ast2.Expr], ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  switch translateImplMethodCall(callee, typeArgs, args, ctx, expected)
    case Some(result) => result
    case None => translatePlainCallAstExpectedOrdinary(callee, typeArgs, args, ctx, expected)
  end
end

func translateDictionaryCallAst(key: String, receiver: ast2.Expr, args: Slice[ast2.Expr], ctx: Ref[egCtx]) -> Result[AstExprResult, String]
  switch ctx.dictionaryCallFuncs.Get(key)
    case Some(fn) =>
      let recv = translateExprAstExpected(receiver, ctx, ast2.MonoType.TUnit)
      let values = translateAstArgs(args, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], [] as Slice[ast2.MonoType])
      switch recv
        case Ok(rv) =>
          switch values
            case Ok(v) => Ok(astExprWithPre(goast.Call(goast.Ident(fn), v.Exprs.Prepend(rv.Expr)), goast.AppendStmts(rv.Pre, v.Pre)))
            case Err(msg) => Err(msg)
          end
        case Err(msg) => Err(msg)
      end
    case None => Err("unresolved inferred dictionary call " + key)
  end
end

# A method call is syntax sugar for an impl helper.  Candidates are selected
# from the receiver shape recorded by the impl interface arguments, rather
# than from a hard-coded interface such as IEnumerable.
# Dictionaries from `using` constraints (e.g. equalsFn for Eq.Equals) are
# checked before package-level impl candidates; this mirrors the legacy
# codegen's resolution order: lexical bindings → package dispatch.
func translateImplMethodCall(callee: ast2.Expr, typeArgs: Slice[ast2.TypeExpr], args: Slice[ast2.Expr], ctx: Ref[egCtx], expected: ast2.MonoType) -> Option[Result[AstExprResult, String]]
  switch callee.Kind
    case FieldExpr(base, method) =>
      switch base.Kind
        # Static inherent methods have TypeName.method(args) syntax.  TypeName
        # is not a value, so resolve these before receiver-method dispatch.
        case IdentExpr(typeName) =>
          switch ctx.packageCandidates.Get("$static$" + typeName + "." + method)
            case Some(candidates) =>
              switch candidates.Get(0)
                case Some(candidate) =>
                  let values = translateAstArgs(args, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], [] as Slice[ast2.MonoType])
                  switch values
                    # The helper is generic (`MygoIN3SetM3New`); a zero-argument
                    # static call such as Set.New[String]() needs its type
                    # arguments spelled out or Go cannot infer them.
                    case Ok(v) =>
                      let inferredArgs = staticImplCallTypeArgs(candidate, typeArgs, expected, ctx)
                      Some(Ok(astExprWithPre(goast.GenericCall(goast.Ident(candidate.Helper), inferredArgs, v.Exprs), v.Pre)))
                    case Err(msg) => Some(Err(msg))
                  end
                case None => translateReceiverImplMethodCall(base, method, args, ctx)
              end
            case None => translateReceiverImplMethodCall(base, method, args, ctx)
          end
        case _ => translateReceiverImplMethodCall(base, method, args, ctx)
      end
    case _ => None
  end
end

# staticImplCallTypeArgs resolves the Go type arguments for a static inherent
# method call.  Explicit source type arguments render directly; otherwise the
# element types are recovered from the expected type by matching the receiver
# constructor (`Set[String]` yields `string`), so the emitted helper call
# `MygoIN3SetM3New[string]()` stays instantiable.
func staticImplCallTypeArgs(candidate: ImplDictionaryCandidate, typeArgs: Slice[ast2.TypeExpr], expected: ast2.MonoType, ctx: Ref[egCtx]) -> Slice[String]
  if typeArgs.Len() > 0 then
    typeExprsToStrings(typeArgs, ctx.typeParams)
  else
    implReceiverArgsFromExpected(candidate.Receiver, expected, ctx)
  end
end

func implReceiverArgsFromExpected(receiver: ast2.MonoType, expected: ast2.MonoType, ctx: Ref[egCtx]) -> Slice[String]
  switch expected
    case TApp(expCtor, expArgs) =>
      switch expCtor.value()
        case TCon(expName) => matchingReceiverArgs(receiver, expName, expArgs, ctx)
        case _ => [] as Slice[String]
      end
    case _ => [] as Slice[String]
  end
end

func matchingReceiverArgs(receiver: ast2.MonoType, expName: String, expArgs: Slice[ast2.MonoType], ctx: Ref[egCtx]) -> Slice[String]
  switch receiver
    case TApp(recvCtor, _) =>
      switch recvCtor.value()
        case TCon(recvName) => if recvName == expName then monoTypesToGoStrs(expArgs, ctx.typeParamNames, ctx.pathAliases) else [] as Slice[String] end
        case _ => [] as Slice[String]
      end
    case TCon(recvName) => if recvName == expName then monoTypesToGoStrs(expArgs, ctx.typeParamNames, ctx.pathAliases) else [] as Slice[String] end
    case _ => [] as Slice[String]
  end
end

func monoTypesToGoStrs(items: Slice[ast2.MonoType], params: Slice[String], aliases: Map[String, String]) -> Slice[String]
  monoTypesToGoStrsInto(items, params, aliases, 0, [] as Slice[String])
end

func monoTypesToGoStrsInto(items: Slice[ast2.MonoType], params: Slice[String], aliases: Map[String, String], index: Int, out: Slice[String]) -> Slice[String]
  if index >= items.Len() then out else
    monoTypesToGoStrsInto(items, params, aliases, index + 1, out.Append(monoTypeToGoStrWithParamsIn(items.Get(index).UnwrapOr(ast2.MonoType.TUnit), params, aliases)))
  end
end

func translateReceiverImplMethodCall(base: ast2.Expr, method: String, args: Slice[ast2.Expr], ctx: Ref[egCtx]) -> Option[Result[AstExprResult, String]]
  # Inference writes the receiver type onto every typed expression. Codegen
  # dispatches from that annotation and never reconstructs it as a fallback.
  let receiverType = base.Type
  # 1. Lexical dictionary from `using` constraint (e.g. equalsFn for Eq.Equals).
  # When multiple constraints of the same interface exist (e.g. Eq[A], Eq[E]),
  # match the receiver type against each constraint's type arg.
  let fn = dictFuncForMethod(method, receiverType, ctx)
  switch fn
        case Some(fnName) =>
          let receiver = translateExprAstExpected(base, ctx, ast2.MonoType.TUnit)
          let values = translateAstArgs(args, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], [] as Slice[ast2.MonoType])
          switch receiver
            case Err(msg) => Some[Result[AstExprResult, String]](Err[AstExprResult, String](msg))
            case Ok(rv) => switch values
              case Err(msg) => Some[Result[AstExprResult, String]](Err[AstExprResult, String](msg))
              case Ok(v) => Some[Result[AstExprResult, String]](Ok[AstExprResult, String](astExprWithPre(goast.Call(goast.Ident(fnName), v.Exprs.Prepend(rv.Expr)), goast.AppendStmts(rv.Pre, v.Pre))))
            end
          end
        case None =>
          # 2. Inherent impls belong to the receiver's nominal type and do
          # not need typeclass evidence. They take precedence over a global
          # typeclass instance with the same method name.
  switch matchingReceiverCandidate(ctx.inherentCandidates, method, receiverType)
            case Some(candidate) =>
              let receiver = translateExprAstExpected(base, ctx, ast2.MonoType.TUnit)
              let values = translateAstArgs(args, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], [] as Slice[ast2.MonoType])
              switch receiver
                case Err(msg) => Some[Result[AstExprResult, String]](Err[AstExprResult, String](msg))
                case Ok(rv) => switch values
                  case Err(msg) => Some[Result[AstExprResult, String]](Err[AstExprResult, String](msg))
                  case Ok(v) => Some[Result[AstExprResult, String]](Ok[AstExprResult, String](astExprWithPre(goast.Call(goast.Ident(candidate.Helper), v.Exprs.Prepend(rv.Expr)), goast.AppendStmts(rv.Pre, v.Pre))))
                end
              end
            case None =>
              # 3. Package-level typeclass fallback. Lexical dictionaries
              # were handled above; this path selects a concrete instance.
              switch matchingReceiverCandidate(ctx.typeclassCandidates, method, receiverType)
                case Some(candidate) =>
                  let receiver = translateExprAstExpected(base, ctx, ast2.MonoType.TUnit)
                  let values = translateAstArgs(args, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], [] as Slice[ast2.MonoType])
                  switch receiver
                    case Err(msg) => Some[Result[AstExprResult, String]](Err[AstExprResult, String](msg))
                    case Ok(rv) => switch values
                      case Err(msg) => Some[Result[AstExprResult, String]](Err[AstExprResult, String](msg))
                      case Ok(v) => Some[Result[AstExprResult, String]](Ok[AstExprResult, String](astExprWithPre(goast.Call(goast.Ident(candidate.Helper), v.Exprs.Prepend(rv.Expr)), goast.AppendStmts(rv.Pre, v.Pre))))
                    end
                  end
                case None => None
              end
          end
      end
  end

# dictFuncForMethod looks up the correct dictionary function for a method
# call originating from a `using` constraint.  When multiple constraints of
# the same interface exist (e.g. using Eq[A], Eq[E]), it matches the
# receiver's static type against each constraint's type arg.
func dictFuncForMethod(method: String, receiverType: Option[ast2.MonoType], ctx: Ref[egCtx]) -> Option[String]
  let names = ctx.constraintFuncNames.Get(method)
  let argMonoTypes = ctx.constraintFuncArgMonoTypes.Get(method)
  switch names
    case Some(nameList) =>
      switch argMonoTypes
        case Some(monoList) =>
          switch receiverType
            case Some(recvMono) => matchDictFuncByMono(nameList, monoList, recvMono, 0)
            case None => None
          end
        case None => None
      end
    case None => None
  end
end

func matchDictFuncByMono(names: Slice[String], monoTypes: Slice[ast2.MonoType], receiverMono: ast2.MonoType, index: Int) -> Option[String]
  if index >= names.Len() || index >= monoTypes.Len() then
    None
  else
    if ast2.MonoEqual(monoTypes.Get(index).UnwrapOr(ast2.MonoType.TUnit), receiverMono) then
      names.Get(index)
    else
      matchDictFuncByMono(names, monoTypes, receiverMono, index + 1)
    end
  end
end

func receiverStaticType(receiver: ast2.Expr, ctx: Ref[egCtx]) -> Option[ast2.MonoType]
  # A selector's annotation describes the selected field, and may be stale
  # after a later inference substitution.  For a nested receiver such as
  # `tail.Value.Prepend(...)`, recover the field type from the receiver chain
  # first so that `tail: Reply[Slice[A]]` retains `Value: Slice[A]`.
  switch receiver.Kind
    # For a local receiver, the declaration's fully inferred type is more
    # reliable than the identifier node's earlier annotation.
    case IdentExpr(name) => receiverStaticTypeFromKind(receiver, ctx)
    case FieldExpr(base, field) then
      switch receiverStaticTypeFromKind(receiver, ctx)
        # A field lookup reconstructed from the context can still expose the
        # struct's bare type parameter.  Prefer it only when it identifies a
        # concrete receiver constructor; otherwise the field node's typed-AST
        # annotation carries the instantiated type (for example Slice[A]).
        case Some(t) =>
          switch monoTypeConstructor(t)
            case Some(_) => Some(t)
            case None => receiver.Type
          end
        # Synthetic selectors may not have a recoverable base; retain their
        # annotation as the fallback in that case.
        case None => receiver.Type
      end
    end
    case _ then
      switch receiver.Type
        # A bare inference variable is not enough to select an impl helper.
        case Some(t) then
          switch t
            case TCon(_) => Some(t)
            case _ => receiverStaticTypeFromKind(receiver, ctx)
          end
        end
        case None => receiverStaticTypeFromKind(receiver, ctx)
      end
    end
  end
end

func receiverStaticTypeFromKind(receiver: ast2.Expr, ctx: Ref[egCtx]) -> Option[ast2.MonoType]
  switch receiver.Kind
    case IdentExpr(name) =>
      let pt = ctx.patternTypes.Get(name)
      switch pt
        case Some(v) => Some(v)
        case None =>
          let lt = ctx.locals.Get(name)
          switch lt
            case Some(mono) => Some(mono)
            case None => resolveExprMonoType(receiver, ctx)
          end
      end
    case FieldExpr(base, field) =>
      # Preserve the statically inferred type through every selector in a
      # chain (for example `tail.Value.Prepend(...)`).  resolveExprMonoType
      # only consults ordinary locals for an identifier, while this helper
      # also knows pattern bindings; recursing here keeps both sources of
      # type information available for nested field receivers.
      let baseMono = receiverStaticType(base, ctx)
      switch baseMono
        case Some(bt) =>
          switch lookupFieldInMonoType(bt, field, ctx)
            case Some(fieldMono) => Some(fieldMono)
            case None => None
          end
        case None => None
      end
    case _ => None
  end
end

# resolveStructOwner extracts the struct type name from a MyGO type string,
# unwrapping Ref[T] and Go pointer *T to find the underlying struct name.
# e.g. "Ref[List[T]]" -> "List", "*List[T]" -> "List"
func resolveStructOwner(typ: String) -> String
  let raw = typeConstructor(typ)
  if raw == "Ref" then
    let args = extractTypeArgs(typ)
    let inner = args.Get(0).UnwrapOr("")
    typeConstructor(inner)
  else
    if strings.HasPrefix(raw, "*") then
      strings.TrimPrefix(raw, "*")
    else
      raw
    end
  end
end

func matchingReceiverCandidate(candidates: Slice[ImplDictionaryCandidate], method: String, receiverType: Option[ast2.MonoType]) -> Option[ImplDictionaryCandidate]
  if candidates.Len() == 0 then None else
    let candidate = candidates.Get(0).UnwrapOr(ImplDictionaryCandidate { Interface: "", Method: "", InterfaceArgs: [] as Slice[ast2.TypeExpr], Receiver: ast2.MonoType.TUnit, TypeParams: [] as Slice[String], Helper: "" })
    let matched = switch receiverType
      case Some(receiver) => candidate.Method == method && receiverMonoMatches(candidate.Receiver, receiver)
      case None => false
    end
    if matched then Some(candidate) else matchingReceiverCandidate(sliceDrop(candidates, 1), method, receiverType) end
  end
end

func receiverMonoMatches(pattern: ast2.MonoType, actual: ast2.MonoType) -> Bool
  switch monoTypeConstructor(pattern)
    case Some(patternName) => switch monoTypeConstructor(actual)
      case Some(actualName) => patternName == actualName
      case None => false
    end
    case None => ast2.MonoEqual(pattern, actual)
  end
end

# HKT applications may be represented as TApp(TCon("Slice"), [A]) rather
# than TCon("Slice", [A]).  Compare their MonoType constructors directly.
func monoTypeConstructor(typ: ast2.MonoType) -> Option[String]
  switch typ
    case TCon(name) => Some(name)
    case TApp(ctor, _) => switch ctor.value()
      case TCon(name) => Some(name)
      case _ => None
    end
    case _ => None
  end
end

# typeConstructor is used only when resolving an inherent struct owner for
# emitted Go names.  Receiver typeclass dispatch uses receiverMonoMatches.
func typeConstructor(typ: String) -> String
  let bracket = strings.Index(typ, "[")
  if bracket >= 0 then strings.TrimSpace(strings.Split(typ, "[").Get(0).UnwrapOr("")) else
    if strings.HasPrefix(typ, "[]") then "Slice" else
      if strings.HasPrefix(typ, "map[") then "map" else strings.TrimSpace(typ) end
    end
  end
end

func translatePlainCallAstExpectedOrdinary(callee: ast2.Expr, typeArgs: Slice[ast2.TypeExpr], args: Slice[ast2.Expr], ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  let c = translateExprAstExpected(callee, ctx, expected)
  # Derive per-argument expected types from the callee's inferred function
  # type so tuple literals like `(EmptyExpr(), EmptyExpr())` keep their
  # element types when passed to a generic prelude function such as
  # `Option.UnwrapOr`.  Without this the literal falls back to
  # `struct{F0 any; F1 any}` and the call fails to type-check.
  let argExpected = callArgExpectedTypes(callee)
  let values = translateAstArgs(args, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], argExpected)
  switch c
    case Err(msg) => Err(msg)
    case Ok(cv) =>
      switch values
        case Err(msg) => Err(msg)
        case Ok(v) =>
          let injected = dictionaryArgsForCall(callee, ctx, v.Exprs)
          let constructorExpected = switch expected
            case TUnit => ctx.retType
            case _ => expected
          end
          let inferredArgs = if typeArgs.Len() > 0 then typeExprsToStrings(typeArgs, ctx.typeParams) else inferredConstructorArgs(callee, constructorExpected, ctx) end
          Ok(astExprWithPre(goast.GenericCall(cv.Expr, inferredArgs, injected), goast.AppendStmts(cv.Pre, v.Pre)))
      end
  end
end

func inferredConstructorArgs(callee: ast2.Expr, expected: ast2.MonoType, ctx: Ref[egCtx]) -> Slice[String]
  switch callee.Kind
    case IdentExpr(name) =>
      inferredConstructorArgsByName(name, ctx.enumVariantOwners.Get(name), expected, ctx)
    case FieldExpr(base, name) =>
      switch base.Kind
        case IdentExpr(enumName) => inferredConstructorArgsByName(name, Some(enumName), expected, ctx)
        case _ => inferredConstructorArgsByName(name, ctx.enumVariantOwners.Get(name), expected, ctx)
      end
    case _ => [] as Slice[String]
  end
end

func inferredConstructorArgsByName(name: String, enumName: Option[String], expected: ast2.MonoType, ctx: Ref[egCtx]) -> Slice[String]
  switch enumName
    case Some(owner) => enumTypeArgs(owner, expected, ctx.typeParamNames, ctx.pathAliases)
    case None => inferredBuiltinConstructorArgs(name, expected, ctx)
  end
end

func enumTypeArgs(enumName: String, expected: ast2.MonoType, params: Slice[String], aliases: Map[String, String]) -> Slice[String]
  switch expected
    case TApp(typeRef, args) then
      switch typeRef.value()
        case TCon(n) then
          if n == enumName then
            args.Map(func(a: ast2.MonoType) -> String
              monoTypeToGoStrWithParamsIn(a, params, aliases)
            end)
          else
            []
          end
        end
        case _ => []
      end
    end
    case _ => []
  end
end

func inferredBuiltinConstructorArgs(name: String, expected: ast2.MonoType, ctx: Ref[egCtx]) -> Slice[String]
  if name == "Zero" then
    [monoTypeToGoStrWithParamsIn(expected, ctx.typeParamNames, ctx.pathAliases)]
  else
    switch expected
      case TApp(typeRef, args) then
        switch typeRef.value()
          case TCon(n) then
            if name == "None" && n == "Option" && args.Len() == 1 then
              [
                monoTypeToGoStrWithParamsIn(args.Get(0).UnwrapOr(ast2.MonoType.TUnit),
                ctx.typeParamNames, ctx.pathAliases)
              ]
            elsif (name == "Ok" || name == "Err") && n == "Result" && args.Len() == 2 then
              [
                monoTypeToGoStrWithParamsIn(args.Get(0).UnwrapOr(ast2.MonoType.TUnit), ctx.typeParamNames, ctx.pathAliases),
                monoTypeToGoStrWithParamsIn(args.Get(1).UnwrapOr(ast2.MonoType.TUnit), ctx.typeParamNames, ctx.pathAliases)
              ]
            else
              [] as Slice[String]
            end
          end
          case _ => [] as Slice[String]
        end
      end
      case _ => [] as Slice[String]
    end
  end
end

func ffiOptionSignature(callee: ast2.Expr, ctx: Ref[egCtx]) -> Option[typeinference2.GoFuncSignature]
  switch callee.Kind
    case CallExpr(fn, _, _) => ffiOptionSignature(fn, ctx)
    case FieldExpr(base, field) =>
      switch base.Kind
        case IdentExpr(alias) => ffiSignatureInPackages(ctx.goPackages, alias, field)
        case _ => None
      end
    case _ => None
  end
end

func ffiMultiResultSignature(expr: ast2.Expr, ctx: Ref[egCtx]) -> Option[typeinference2.GoFuncSignature]
  switch expr.Kind
    case CallExpr(callee, _, _) => ffiMultiResultSignatureFromCallee(callee, ctx.goPackages)
    case _ => None
  end
end

func ffiMultiResultSignatureFromCallee(callee: ast2.Expr, packages: Slice[typeinference2.GoPackageEntry]) -> Option[typeinference2.GoFuncSignature]
  switch callee.Kind
    case FieldExpr(base, field) then
      switch base.Kind
        case IdentExpr(alias) => ffiMultiResultSignatureInPackages(alias, field, packages)
        case _ => None
      end
    end
    case _ => None
  end
end

func ffiMultiResultSignatureInPackages(alias: String, name: String, packages: Slice[typeinference2.GoPackageEntry]) -> Option[typeinference2.GoFuncSignature]
  if packages.Len() == 0 then
    None
  else
    switch packages.Get(0)
      case Some(pkg) then
        if pkg.Alias == alias then
          ffiMultiResultSignatureInFuncs(name, pkg.Funcs)
        else
          ffiMultiResultSignatureInPackages(alias, name, sliceDrop(packages, 1))
        end
      end
      case None => None
    end
  end
end

func ffiMultiResultSignatureInFuncs(name: String, funcs: Slice[typeinference2.GoFuncSignature]) -> Option[typeinference2.GoFuncSignature]
  if funcs.Len() == 0 then
    None
  else
    switch funcs.Get(0)
      case Some(sig) then
        if sig.Name == name && sig.Results.Len() > 1 then
          Some(sig)
        else
          ffiMultiResultSignatureInFuncs(name, sliceDrop(funcs, 1))
        end
      end
      case None => None
    end
  end
end

func ffiSignatureInPackages(packages: Slice[typeinference2.GoPackageEntry], alias: String, name: String) -> Option[typeinference2.GoFuncSignature]
  if packages.Len() == 0 then
    None
  else
    switch packages.Get(0)
      case Some(pkg) => if pkg.Alias == alias then ffiSignatureInFuncs(pkg.Funcs, name) else ffiSignatureInPackages(sliceDrop(packages, 1), alias, name) end
      case None => None
    end
  end
end

func ffiSignatureInFuncs(funcs: Slice[typeinference2.GoFuncSignature], name: String) -> Option[typeinference2.GoFuncSignature]
  if funcs.Len() == 0 then
    None
  else
    switch funcs.Get(0)
      case Some(sig) then
        if sig.Name == name && sig.Results.Len() == 2 && sig.Results.Get(1).UnwrapOr("") == "bool" then
          Some(sig)
        else
          ffiSignatureInFuncs(sliceDrop(funcs, 1), name)
        end
      end
      case None => None
    end
  end
end

func translateFFIOptionCall(callee: ast2.Expr, typeArgs: Slice[ast2.TypeExpr], args: Slice[ast2.Expr], ctx: Ref[egCtx], expected: ast2.MonoType, _: typeinference2.GoFuncSignature) -> Result[AstExprResult, String]
  let c = translateExprAstExpected(callee, ctx, ast2.MonoType.TUnit)
  let values = translateAstArgs(args, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], [] as Slice[ast2.MonoType])
  switch c
    case Err(msg) => Err(msg)
    case Ok(cv) => switch values
      case Err(msg) => Err(msg)
      case Ok(v) =>
        let valueName = ctxFreshExprTemp(ctx)
        let okName = ctxFreshExprTemp(ctx)
        let optionName = ctxFreshExprTemp(ctx)
        let inner = switch expected
          case TApp(typeRef, args) then
            switch typeRef.value()
              case TCon(n) then
                if n == "Option" && args.Len() == 1 then
                  monoTypeToGoStrWithParamsIn(args.Get(0).UnwrapOr(ast2.MonoType.TUnit), ctx.typeParamNames, ctx.pathAliases)
                else
                  "any"
                end
              end
              case _ => "any"
            end
          end
          case _ => "any"
        end
        let call = goast.GenericCall(cv.Expr, typeExprsToStrings(typeArgs, ctx.typeParams), v.Exprs)
        let define = goast.Assign([goast.Ident(valueName), goast.Ident(okName)], ":=", [call])
        let some = goast.GenericCall(goast.Ident("Some"), [inner], [goast.Ident(valueName)])
        let none = goast.GenericCall(goast.Ident("None"), [inner], [] as Slice[goast.Expr])
        let yes = astSingleStmt(goast.Assign(astSingleExpr(goast.Ident(optionName)), "=", astSingleExpr(some)))
        let no = astSingleStmt(goast.Assign(astSingleExpr(goast.Ident(optionName)), "=", astSingleExpr(none)))
        let pre = goast.AppendStmts(goast.AppendStmts(cv.Pre, v.Pre), goast.AppendStmts(astTwoStmts(goast.DeclareFromType(optionName, monoTypeToGoStrWithParamsIn(expected, ctx.typeParamNames, ctx.pathAliases)), define), astSingleStmt(goast.If(goast.Ident(okName), yes, no))))
        Ok(astExprWithPre(goast.Ident(optionName), pre))
    end
  end
end

# Go functions with a trailing error return are decoded at the boundary into
# Result[T, String], matching the prelude's dedicated error-bearing type.
func ffiResultSignature(callee: ast2.Expr, ctx: Ref[egCtx]) -> Option[typeinference2.GoFuncSignature]
  switch callee.Kind
    case CallExpr(fn, _, _) => ffiResultSignature(fn, ctx)
    case FieldExpr(base, field) =>
      switch base.Kind
        case IdentExpr(alias) => ffiResultSignatureInPackages(ctx.goPackages, alias, field)
        case _ => None
      end
    case _ => None
  end
end

func ffiResultSignatureInPackages(packages: Slice[typeinference2.GoPackageEntry], alias: String, name: String) -> Option[typeinference2.GoFuncSignature]
  if packages.Len() == 0 then None else
    switch packages.Get(0)
      case Some(pkg) => if pkg.Alias == alias then ffiResultSignatureInFuncs(pkg.Funcs, name) else ffiResultSignatureInPackages(sliceDrop(packages, 1), alias, name) end
      case None => None
    end
  end
end

func ffiResultSignatureInFuncs(funcs: Slice[typeinference2.GoFuncSignature], name: String) -> Option[typeinference2.GoFuncSignature]
  if funcs.Len() == 0 then None else
    switch funcs.Get(0)
      case Some(sig) => if sig.Name == name && sig.Results.Len() == 2 && sig.Results.Get(1).UnwrapOr("") == "error" then Some(sig) else ffiResultSignatureInFuncs(sliceDrop(funcs, 1), name) end
      case None => None
    end
  end
end

func translateFFIResultCall(callee: ast2.Expr, typeArgs: Slice[ast2.TypeExpr], args: Slice[ast2.Expr], ctx: Ref[egCtx], expected: ast2.MonoType, _: typeinference2.GoFuncSignature) -> Result[AstExprResult, String]
  let c = translateExprAstExpected(callee, ctx, ast2.MonoType.TUnit)
  let values = translateAstArgs(args, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], [] as Slice[ast2.MonoType])
  switch c
    case Err(msg) => Err(msg)
    case Ok(cv) => switch values
      case Err(msg) => Err(msg)
      case Ok(v) =>
        let valueName = ctxFreshExprTemp(ctx)
        let errorName = ctxFreshExprTemp(ctx)
        let resultName = ctxFreshExprTemp(ctx)
        let inner = switch expected
          case TApp(typeRef, args) then
            switch typeRef.value()
              case TCon(n) then
                if n == "Result" && args.Len() == 2 then
                  monoTypeToGoStrWithParamsIn(args.Get(0).UnwrapOr(ast2.MonoType.TUnit), ctx.typeParamNames, ctx.pathAliases)
                else
                  "any"
                end
              end
              case _ => "any"
            end
          end
          case _ => "any"
        end
        let errorGoType = switch expected
          case TApp(typeRef, args) then
            switch typeRef.value()
              case TCon(n) then
                if n == "Result" && args.Len() == 2 then
                  monoTypeToGoStrWithParamsIn(args.Get(1).UnwrapOr(ast2.MonoType.TUnit), ctx.typeParamNames, ctx.pathAliases)
                else
                  "string"
                end
              end
              case _ => "string"
            end
          end
          case _ => "string"
        end
        let errorType = if errorGoType == "error" then "error" else "string" end
        let call = goast.GenericCall(cv.Expr, typeExprsToStrings(typeArgs, ctx.typeParams), v.Exprs)
        let define = goast.Assign([goast.Ident(valueName), goast.Ident(errorName)], ":=", [call])
        let ok = goast.GenericCall(goast.Ident("Ok"), [inner, errorType], [goast.Ident(valueName)])
        let message = if errorType == "error" then goast.Ident(errorName) else goast.Call(goast.Selector(goast.Ident(errorName), "Error"), [] as Slice[goast.Expr]) end
        let err = goast.GenericCall(goast.Ident("Err"), [inner, errorType], [message])
        let failed = astSingleStmt(goast.Assign(astSingleExpr(goast.Ident(resultName)), "=", astSingleExpr(err)))
        let succeeded = astSingleStmt(goast.Assign(astSingleExpr(goast.Ident(resultName)), "=", astSingleExpr(ok)))
        let pre = goast.AppendStmts(goast.AppendStmts(cv.Pre, v.Pre), goast.AppendStmts(astTwoStmts(goast.DeclareFromType(resultName, monoTypeToGoStrWithParamsIn(expected, ctx.typeParamNames, ctx.pathAliases)), define), astSingleStmt(goast.If(goast.Binary(goast.Ident(errorName), "!=", goast.Ident("nil")), failed, succeeded))))
        Ok(astExprWithPre(goast.Ident(resultName), pre))
    end
  end
end

# A tuple-typed inline Go block (`go[(T, error)]`) declares its native Go
# result shape.  Following the Go FFI boundary convention it is decoded into
# Result[T, error] / Option[T] whenever the enclosing context expects that
# ergonomic form.  Returns Some("Result") / Some("Option") when the wrap
# applies, None when the raw tuple expression must be emitted as-is.
func inlineGoBoundaryKind(declared: ast2.TypeExpr, expected: ast2.MonoType) -> Option[String]
  switch declared
    case TupleType(elems) =>
      if elems.Len() == 2 then
        let second = elems.Get(1).UnwrapOr(ast2.TypeExpr.UnitType)
        if isBoolTypeExpr(second) then
          if expectedKindIs(expected, "Option") then Some("Option") else None end
        else
          if expectedKindIs(expected, "Result") then Some("Result") else None end
        end
      else
        None
      end
    case _ => None
  end
end

func isBoolTypeExpr(t: ast2.TypeExpr) -> Bool
  switch t
    case NamedType(name, _) => name == "Bool"
    case _ => false
  end
end

func expectedKindIs(expected: ast2.MonoType, kind: String) -> Bool
  switch expected
    case TApp(typeRef, args) =>
      if args.Len() > 0 then
        switch typeRef.value()
          case TCon(name) => name == kind
          case _ => false
        end
      else
        false
      end
    case _ => false
  end
end

# translateInlineGoBoundary wraps a tuple-returning inline Go expression into
# Result[T, error] / Option[T] using the same temp-variable lowering as Go FFI
# call decoding (no IIFE): the raw Go tuple is assigned to a value/error pair,
# then the boundary constructor is selected with an if/else.
func translateInlineGoBoundary(kind: String, body: String, values: Slice[ast2.GoOperand], types: Slice[ast2.GoTypeOperand], expected: ast2.MonoType, ctx: Ref[egCtx]) -> Result[AstExprResult, String]
  let parts = translateInlineOperands(values, types, ctx, 0, [] as Slice[String], [] as Slice[String], [] as Slice[String], [] as Slice[String], [] as Slice[goast.Stmt])
  switch parts
    case Err(msg) => Err(msg)
    case Ok(p) =>
      let raw = goast.MustInlineGoExprWithOperands(body, p.ValueNames, p.ValueSources, p.TypeNames, p.TypeSources)
      let resultName = ctxFreshExprTemp(ctx)
      switch kind
        case "Result" =>
          let resultType = monoTypeToGoStrWithParamsIn(expected, ctx.typeParamNames, ctx.pathAliases)
          let inner = resultBoundaryArgs(expected, ctx)
          let valName = ctxFreshExprTemp(ctx)
          let errName = ctxFreshExprTemp(ctx)
          let define = astSingleStmt(goast.Assign([goast.Ident(valName), goast.Ident(errName)], ":=", [goast.Paren(raw)]))
          let errCall = goast.GenericCall(goast.Ident("Err"), inner, [goast.Ident(errName)])
          let okCall = goast.GenericCall(goast.Ident("Ok"), inner, [goast.Ident(valName)])
          let failed = astSingleStmt(goast.Assign(astSingleExpr(goast.Ident(resultName)), "=", astSingleExpr(errCall)))
          let succeeded = astSingleStmt(goast.Assign(astSingleExpr(goast.Ident(resultName)), "=", astSingleExpr(okCall)))
          let decl = astSingleStmt(goast.DeclareFromType(resultName, resultType))
          let branch = astSingleStmt(goast.If(goast.Binary(goast.Ident(errName), "!=", goast.Ident("nil")), failed, succeeded))
          let pre = goast.AppendStmts(goast.AppendStmts(decl, define), branch)
          Ok(astExprWithPre(goast.Ident(resultName), goast.AppendStmts(p.Pre, pre)))
        case "Option" =>
          let optionType = monoTypeToGoStrWithParamsIn(expected, ctx.typeParamNames, ctx.pathAliases)
          let inner = optionBoundaryArgs(expected, ctx)
          let valName = ctxFreshExprTemp(ctx)
          let okName = ctxFreshExprTemp(ctx)
          let define = astSingleStmt(goast.Assign([goast.Ident(valName), goast.Ident(okName)], ":=", [goast.Paren(raw)]))
          let someCall = goast.GenericCall(goast.Ident("Some"), inner, [goast.Ident(valName)])
          let noneCall = goast.GenericCall(goast.Ident("None"), inner, [] as Slice[goast.Expr])
          let failed = astSingleStmt(goast.Assign(astSingleExpr(goast.Ident(resultName)), "=", astSingleExpr(noneCall)))
          let succeeded = astSingleStmt(goast.Assign(astSingleExpr(goast.Ident(resultName)), "=", astSingleExpr(someCall)))
          let decl = astSingleStmt(goast.DeclareFromType(resultName, optionType))
          let branch = astSingleStmt(goast.If(goast.Ident(okName), succeeded, failed))
          let pre = goast.AppendStmts(goast.AppendStmts(decl, define), branch)
          Ok(astExprWithPre(goast.Ident(resultName), goast.AppendStmts(p.Pre, pre)))
        case _ => Ok(astExprWithPre(goast.Unit(), [] as Slice[goast.Stmt]))
      end
  end
end

func resultBoundaryArgs(expected: ast2.MonoType, ctx: Ref[egCtx]) -> Slice[String]
  switch expected
    case TApp(typeRef, args) =>
      switch typeRef.value()
        case TCon(name) =>
          if name == "Result" && args.Len() == 2 then
            [
              monoTypeToGoStrWithParamsIn(args.Get(0).UnwrapOr(ast2.MonoType.TUnit), ctx.typeParamNames, ctx.pathAliases),
              monoTypeToGoStrWithParamsIn(args.Get(1).UnwrapOr(ast2.MonoType.TUnit), ctx.typeParamNames, ctx.pathAliases)
            ]
          else
            ["any", "error"]
          end
        case _ => ["any", "error"]
      end
    case _ => ["any", "error"]
  end
end

func optionBoundaryArgs(expected: ast2.MonoType, ctx: Ref[egCtx]) -> Slice[String]
  switch expected
    case TApp(typeRef, args) =>
      switch typeRef.value()
        case TCon(name) =>
          if name == "Option" && args.Len() == 1 then
            [monoTypeToGoStrWithParamsIn(args.Get(0).UnwrapOr(ast2.MonoType.TUnit), ctx.typeParamNames, ctx.pathAliases)]
          else
            ["any"]
          end
        case _ => ["any"]
      end
    case _ => ["any"]
  end
end

func dictionaryArgsForCall(callee: ast2.Expr, ctx: Ref[egCtx], args: Slice[goast.Expr]) -> Slice[goast.Expr]
  switch callee.Kind
    case IdentExpr(name) => appendRequirementArgs(args, ctx.callRequirements.Get(name).UnwrapOr([] as Slice[DictionaryRequirement]), ctx)
    case _ => args
  end
end

func appendRequirementArgs(args: Slice[goast.Expr], requirements: Slice[DictionaryRequirement], ctx: Ref[egCtx]) -> Slice[goast.Expr]
  if requirements.Len() == 0 then
    args
  else
    let requirement = requirements.Get(0).UnwrapOr(DictionaryRequirement { Interface: "", Method: "", Args: [] as Slice[ast2.TypeExpr] })
    switch ctx.constraintFuncs.Get(requirement.Method)
      case Some(fn) => appendRequirementArgs(args.Append(goast.Ident(fn)), sliceDrop(requirements, 1), ctx)
      case None =>
        switch matchingCandidate(ctx.packageCandidates.Get(requirement.Interface + "." + requirement.Method).UnwrapOr([] as Slice[ImplDictionaryCandidate]), requirement)
          case Some(candidate) => appendRequirementArgs(args.Append(goast.Ident(candidate.Helper)), sliceDrop(requirements, 1), ctx)
          case None =>
            switch ctx.packageDictionaries.Get(requirement.Interface + "." + requirement.Method)
              case Some(helper) => appendRequirementArgs(args.Append(goast.Ident(helper)), sliceDrop(requirements, 1), ctx)
              case None => appendRequirementArgs(args, sliceDrop(requirements, 1), ctx)
            end
        end
    end
  end
end

func matchingCandidate(candidates: Slice[ImplDictionaryCandidate], requirement: DictionaryRequirement) -> Option[ImplDictionaryCandidate]
  if candidates.Len() == 0 then
    None
  else
    let candidate = candidates.Get(0).UnwrapOr(ImplDictionaryCandidate { Interface: "", Method: "", InterfaceArgs: [] as Slice[ast2.TypeExpr], Receiver: ast2.MonoType.TUnit, TypeParams: [] as Slice[String], Helper: "" })
    if typeExprListMatches(candidate.InterfaceArgs, requirement.Args, typeParamSet(candidate.TypeParams)) then Some(candidate) else matchingCandidate(sliceDrop(candidates, 1), requirement) end
  end
end

func typeExprListMatches(patterns: Slice[ast2.TypeExpr], actuals: Slice[ast2.TypeExpr], variables: Set[String]) -> Bool
  if patterns.Len() != actuals.Len() then false else
    if patterns.Len() == 0 then true else
      typeExprMatches(patterns.Get(0).UnwrapOr(ast2.TypeExpr.UnitType), actuals.Get(0).UnwrapOr(ast2.TypeExpr.UnitType), variables) && typeExprListMatches(sliceDrop(patterns, 1), sliceDrop(actuals, 1), variables)
    end
  end
end

func typeExprMatches(pattern: ast2.TypeExpr, actual: ast2.TypeExpr, variables: Set[String]) -> Bool
  switch pattern
    case NamedType(name, args) =>
      if setContainsString(variables, name) && args.Len() == 0 then true else
        switch actual
          case NamedType(actualName, actualArgs) => name == actualName && typeExprListMatches(args, actualArgs, variables)
          case _ => false
        end
      end
    case UnitType => switch actual case UnitType => true case _ => false end
    case _ => typeString(pattern) == typeString(actual)
  end
end

func appendDictionaryArgs(args: Slice[goast.Expr], methods: Slice[String], ctx: Ref[egCtx]) -> Slice[goast.Expr]
  if methods.Len() == 0 then
    args
  else
    let method = methods.Get(0).UnwrapOr("")
    let next = ctx.constraintFuncs.Get(method)
    switch next
      case Some(fn) => appendDictionaryArgs(args.Append(goast.Ident(fn)), sliceDrop(methods, 1), ctx)
      case None =>
        switch ctx.packageDictionaries.Get(method)
          case Some(helper) => appendDictionaryArgs(args.Append(goast.Ident(helper)), sliceDrop(methods, 1), ctx)
          case None => appendDictionaryArgs(args, sliceDrop(methods, 1), ctx)
        end
    end
  end
end

func translateAstArgs(args: Slice[ast2.Expr], ctx: Ref[egCtx], index: Int, out: Slice[goast.Expr], pre: Slice[goast.Stmt], expectedTypes: Slice[ast2.MonoType]) -> Result[AstArgsResult, String]
  if index >= args.Len() then
    Ok(AstArgsResult { Exprs: out, Pre: pre })
  else
    let arg = args.Get(index).UnwrapOr(ast2.EmptyExpr())
    # When no expected type is available (e.g. a typeclass helper call whose
    # callee lost its annotation), fall back to the argument's own inferred
    # type so tuple/slice literals keep their element types instead of
    # degrading to `any`.
    let expected = expectedTypes.Get(index).UnwrapOr(arg.Type.UnwrapOr(ast2.MonoType.TUnit))
    let value = translateExprAstExpected(arg, ctx, expected)
    switch value
      case Err(msg) => Err(msg)
      case Ok(v) => translateAstArgs(args, ctx, index + 1, out.Append(v.Expr), goast.AppendStmts(pre, v.Pre), expectedTypes)
    end
  end
end

func translateMapLitAstExpected(pairs: Slice[(ast2.Expr, ast2.Expr)], ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  let typ = switch expected
    case TUnit => "map[string]any"
    case _ => monoTypeToGoStrIn(expected, ctx.pathAliases)
  end
  let result = translateMapLitPairs(pairs, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], expected)
  switch result
    case Err(msg) => Err(msg)
    case Ok(v) => Ok(astExprWithPre(goast.Composite(goast.MustTypeExpr(typ), v.Elts), v.Pre))
  end
end

func translateMapLitPairs(pairs: Slice[(ast2.Expr, ast2.Expr)], ctx: Ref[egCtx], index: Int, out: Slice[goast.Expr], pre: Slice[goast.Stmt], expected: ast2.MonoType) -> Result[AstCompositeFields, String]
  if index >= pairs.Len() then
    Ok(AstCompositeFields { Elts: out, Pre: pre })
  else
    let pair = pairs.Get(index).UnwrapOr((ast2.EmptyExpr(), ast2.EmptyExpr()))
    let (key, value) = pair
    let k = translateExprAstExpected(key, ctx, ast2.MonoType.TUnit)
    switch k
      case Err(msg) => Err(msg)
      case Ok(kv) then
        let v = translateExprAstExpected(value, ctx, ast2.MonoType.TUnit)
        switch v
          case Err(msg) => Err(msg)
          case Ok(vv) then
            translateMapLitPairs(pairs, ctx, index + 1, out.Append(goast.KeyValue(kv.Expr, vv.Expr)), goast.AppendStmts(goast.AppendStmts(pre, kv.Pre), vv.Pre), expected)
          end
        end
      end
    end
  end
end

func translateSetLitAstExpected(items: Slice[ast2.Expr], ctx: Ref[egCtx], expected: ast2.MonoType) -> Result[AstExprResult, String]
  let typ = switch expected
    case TUnit => "map[string]struct{}"
    case _ => monoTypeToGoStrIn(expected, ctx.pathAliases)
  end
  let result = translateSetLitItems(items, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], expected)
  switch result
    case Err(msg) => Err(msg)
    case Ok(v) => Ok(astExprWithPre(goast.Composite(goast.MustTypeExpr(typ), v.Elts), v.Pre))
  end
end

func translateSetLitItems(items: Slice[ast2.Expr], ctx: Ref[egCtx], index: Int, out: Slice[goast.Expr], pre: Slice[goast.Stmt], expected: ast2.MonoType) -> Result[AstCompositeFields, String]
  if index >= items.Len() then
    Ok(AstCompositeFields { Elts: out, Pre: pre })
  else
    let elem = items.Get(index).UnwrapOr(ast2.EmptyExpr())
    let e = translateExprAstExpected(elem, ctx, ast2.MonoType.TUnit)
    switch e
      case Err(msg) => Err(msg)
      case Ok(ev) then
        let kv = goast.KeyValue(ev.Expr, goast.Composite(goast.Ident("struct{}"), [] as Slice[goast.Expr]))
        translateSetLitItems(items, ctx, index + 1, out.Append(kv), goast.AppendStmts(pre, ev.Pre), expected)
      end
    end
  end
end

# lookupExprTypeInTypedInfo searches TypedInfo.ExprTypes for an expression
# whose ID matches the given expression's ID.  Because the ID is copied along
# with the value-type Expr struct, this lookup works across the value copies
# that occur between type inference and code generation.
func lookupExprTypeInTypedInfo(expr: ast2.Expr) -> Option[ast2.MonoType]
  expr.Type
end

# Extract the parameter types from the callee's inferred `TFunc` so that
# tuple and other composite literals carried as arguments can be lowered
# with their element types intact.  The result is empty when the callee
# has no inferred function type (e.g. a Go FFI call), so callers can
# safely fall back to no per-argument expectations.
func callArgExpectedTypes(callee: ast2.Expr) -> Slice[ast2.MonoType]
  switch callee.Type
    case Some(t) =>
      switch t
        case TFunc(items, _) => items
        case TVariadic(items, _) => items
        case _ => [] as Slice[ast2.MonoType]
      end
    case None => [] as Slice[ast2.MonoType]
  end
end
