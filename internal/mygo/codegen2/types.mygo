package codegen2

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import goast "go:github.com/mygo-lang/mygo/internal/mygo/codegen2/goast"
import typeinference2 "github.com/mygo-lang/mygo/internal/mygo/typeinference2"

# egCtx 是表达式/语句翻译的上下文
struct egCtx
  # 局部变量名 → MonoType（不再使用字符串拼接查找 field）
  locals: Map[String, ast2.MonoType]
  # MyGO 名 → Go 名
  bindings: Map[String, String]
  # TODO: 需要存储 enum 变体的字段类型
  # Struct 字段类型：TypeName → [FieldEntry]
  structFields: Map[String, Slice[typeinference2.FieldEntry]]
  # Struct 类型参数 ID：TypeName → Bound IDs
  structTypeParams: Map[String, Slice[Int]]
  # 变量是否可变
  mutable: Map[String, Bool]
  # SSA 风格命名计数
  usedNames: Map[String, Int]
  # 表达式位置展开为语句时使用的临时变量序号
  exprSeq: Int
  # 表达式位置展开出的前置语句
  preStmts: Slice[String]
  # AST 原生的前置语句，供控制流迁移使用。
  astPreStmts: Slice[goast.Stmt]
  # 当前作用域的类型参数
  typeParams: Set[String]
  # 保留声明顺序，用于把推断中的 TParam(-1/-2) 渲染为 Go 的 A/E。
  typeParamNames: Slice[String]
  # 当前函数的返回类型
  retType: ast2.MonoType
  # 多返回值类型
  retTypes: Slice[ast2.MonoType]
  # 尾递归候选函数名
  tailRecFuncName: Option[String]
  # 参数数量
  tailRecParamCount: Int
  # 尾递归参数 Go 名
  tailRecParamNames: Slice[String]
  constraintFuncs: Map[String, String]
  constraintFuncNames: Map[String, Slice[String]]
  constraintFuncArgTypes: Map[String, Slice[String]]
  constraintFuncArgMonoTypes: Map[String, Slice[ast2.MonoType]]
  dictionaryCallFuncs: Map[String, String]
  callDictionaries: Map[String, Slice[String]]
  packageDictionaries: Map[String, String]
  callRequirements: Map[String, Slice[DictionaryRequirement]]
  packageCandidates: Map[String, Slice[ImplDictionaryCandidate]]
  goPackages: Slice[typeinference2.GoPackageEntry]
  pkgInfo: Option[typeinference2.PackageInfo]
  enumValueConstructors: Map[String, String]
  enumVariantOwners: Map[String, String]
  patternTypes: Map[String, ast2.MonoType]
  patternFuncIdx: Map[String, Int]
  variantFieldMonoTypes: Map[String, Slice[ast2.MonoType]]
end

struct Generator2
  pkgName: String
  importPaths: Slice[String]
  currentFile: String
  localSeq: Int
  switchVarSeq: Int
  needsCallAny: Bool
  allDecls: Slice[ast2.Decl]
  decls: Slice[ast2.Decl]
  goPackages: Slice[typeinference2.GoPackageEntry]
  pkgInfo: Option[typeinference2.PackageInfo]
end

struct AstExprResult
  Expr: goast.Expr
  Pre: Slice[goast.Stmt]
end

struct AstArgsResult
  Exprs: Slice[goast.Expr]
  Pre: Slice[goast.Stmt]
end

struct AstCompositeFields
  Elts: Slice[goast.Expr]
  Pre: Slice[goast.Stmt]
end

struct AstInlineOperands
  ValueNames: Slice[String]
  ValueSources: Slice[String]
  TypeNames: Slice[String]
  TypeSources: Slice[String]
  Pre: Slice[goast.Stmt]
end

struct DictionaryRequirement
  Interface: String
  Method: String
  Args: Slice[ast2.TypeExpr]
end

struct ImplDictionaryCandidate
  Interface: String
  Method: String
  InterfaceArgs: Slice[ast2.TypeExpr]
  TypeParams: Slice[String]
  Helper: String
end

func newAstExprResult(expr: goast.Expr) -> AstExprResult
  AstExprResult { Expr: expr, Pre: [] }
end

func astExprWithPre(expr: goast.Expr, pre: Slice[goast.Stmt]) -> AstExprResult
  AstExprResult { Expr: expr, Pre: pre }
end

func newEgCtx() -> egCtx
  egCtx {
    locals: {},
    bindings: {},
    structFields: {},
    structTypeParams: {},
    mutable: {},
    usedNames: {},
    exprSeq: 0,
    preStmts: [],
    astPreStmts: [],
    typeParams: Set.New[String](),
    typeParamNames: [],
    retType: ast2.MonoType.TUnit,
    retTypes: [],
    tailRecFuncName: None,
    tailRecParamCount: 0,
    tailRecParamNames: [],
    constraintFuncs: {},
    constraintFuncNames: {},
    constraintFuncArgTypes: {},
    constraintFuncArgMonoTypes: {},
    dictionaryCallFuncs: {},
    callDictionaries: {},
    packageDictionaries: {},
    callRequirements: {},
    packageCandidates: {},
    goPackages: [],
    pkgInfo: None,
    enumValueConstructors: {},
    enumVariantOwners: {},
    patternTypes: {},
    patternFuncIdx: {},
    variantFieldMonoTypes: {},
  }
end

func newEgCtxWithTypeParams(params: Slice[String]) -> egCtx
  egCtx {
    locals: {},
    bindings: {},
    structFields: {},
    structTypeParams: {},
    mutable: {},
    usedNames: {},
    exprSeq: 0,
    preStmts: [],
    astPreStmts: [],
    typeParams: typeParamSet(params),
    typeParamNames: params,
    retType: ast2.MonoType.TUnit,
    retTypes: [],
    tailRecFuncName: None,
    tailRecParamCount: 0,
    tailRecParamNames: [],
    constraintFuncs: {},
    constraintFuncNames: {},
    constraintFuncArgTypes: {},
    constraintFuncArgMonoTypes: {},
    dictionaryCallFuncs: {},
    callDictionaries: {},
    packageDictionaries: {},
    callRequirements: {},
    packageCandidates: {},
    goPackages: [],
    pkgInfo: None,
    enumValueConstructors: {},
    enumVariantOwners: {},
    patternTypes: {},
    patternFuncIdx: {},
    variantFieldMonoTypes: {},
  }
end

func newFuncEgCtx(params: Slice[String], retType: ast2.MonoType, tailName: String, paramCount: Int) -> egCtx
  egCtx {
    locals: {},
    bindings: {},
    structFields: {},
    structTypeParams: {},
    mutable: {},
    usedNames: {},
    exprSeq: 0,
    preStmts: [],
    astPreStmts: [],
    typeParams: typeParamSet(params),
    typeParamNames: params,
    retType: retType,
    retTypes: [],
    tailRecFuncName: Some(tailName),
    tailRecParamCount: paramCount,
    tailRecParamNames: [],
    constraintFuncs: {},
    constraintFuncNames: {},
    constraintFuncArgTypes: {},
    constraintFuncArgMonoTypes: {},
    dictionaryCallFuncs: {},
    callDictionaries: {},
    packageDictionaries: {},
    callRequirements: {},
    packageCandidates: {},
    goPackages: [],
    pkgInfo: None,
    enumValueConstructors: {},
    enumVariantOwners: {},
    patternTypes: {},
    patternFuncIdx: {},
    variantFieldMonoTypes: {},
  }
end

func newGenerator2(pkgName: String, typedDecls: Slice[ast2.Decl], goPackages: Slice[typeinference2.GoPackageEntry], pkgInfo: typeinference2.PackageInfo) -> Generator2
  Generator2 {
    pkgName: pkgName,
    importPaths: [],
    currentFile: "",
    localSeq: 0,
    switchVarSeq: 0,
    needsCallAny: false,
    allDecls: [] as Slice[ast2.Decl],
    decls: typedDecls,
    goPackages: goPackages,
    pkgInfo: Some(pkgInfo),
  }
end

func ctxChild(ctx: Ref[egCtx]) -> egCtx
  egCtx {
    locals: ctx.locals,
    bindings: ctx.bindings,
    structFields: ctx.structFields,
    structTypeParams: ctx.structTypeParams,
    mutable: ctx.mutable,
    usedNames: ctx.usedNames,
    exprSeq: ctx.exprSeq,
    preStmts: [],
    astPreStmts: [],
    typeParams: ctx.typeParams,
    typeParamNames: ctx.typeParamNames,
    retType: ctx.retType,
    retTypes: ctx.retTypes,
    tailRecFuncName: ctx.tailRecFuncName,
    tailRecParamCount: ctx.tailRecParamCount,
    tailRecParamNames: ctx.tailRecParamNames,
    constraintFuncs: ctx.constraintFuncs,
    constraintFuncNames: ctx.constraintFuncNames,
    constraintFuncArgTypes: ctx.constraintFuncArgTypes,
    constraintFuncArgMonoTypes: ctx.constraintFuncArgMonoTypes,
    dictionaryCallFuncs: ctx.dictionaryCallFuncs,
    callDictionaries: ctx.callDictionaries,
    packageDictionaries: ctx.packageDictionaries,
    callRequirements: ctx.callRequirements,
    packageCandidates: ctx.packageCandidates,
    goPackages: ctx.goPackages,
    pkgInfo: ctx.pkgInfo,
    enumValueConstructors: ctx.enumValueConstructors,
    enumVariantOwners: ctx.enumVariantOwners,
    patternTypes: ctx.patternTypes,
    patternFuncIdx: ctx.patternFuncIdx,
    variantFieldMonoTypes: ctx.variantFieldMonoTypes,
  }
end

func ctxSetLocal(ctx: Ref[egCtx], name: String, typ: ast2.MonoType) -> ()
  ctx.locals.Set(name, typ)
end

func ctxGetLocal(ctx: Ref[egCtx], name: String) -> Option[ast2.MonoType]
  ctx.locals.Get(name)
end

func ctxSetBinding(ctx: Ref[egCtx], name: String, goName: String) -> ()
  ctx.bindings.Set(name, goName)
end

func ctxFreshBinding(ctx: Ref[egCtx], name: String) -> String
  let base = sanitizeIdent(name)
  let count = ctx.usedNames.Get(base).UnwrapOr(0)
  ctx.usedNames.Set(base, count + 1)
  if count == 0 then
    ctx.bindings.Set(name, base)
    return base
  end
  let actual = base + "_" + count.ToString()
  ctx.bindings.Set(name, actual)
  actual
end

func ctxSetMutable(ctx: Ref[egCtx], name: String, isMutable: Bool) -> ()
  ctx.mutable.Set(name, isMutable)
end

func ctxSetTailRecParamNames(ctx: Ref[egCtx], names: Slice[String]) -> ()
  go[()] {
    code: "ctx.tailRecParamNames = names"
    in ctx = ctx
    in names = names
  }
end

func ctxFreshExprTemp(ctx: Ref[egCtx]) -> String
  let name = "__mygo_expr_" + ctx.exprSeq.ToString()
  go[()] {
    code: "ctx.exprSeq = ctx.exprSeq + 1"
    in ctx = ctx
  }
  name
end

func ctxPushPreStmt(ctx: Ref[egCtx], stmt: String) -> ()
  go[()] {
    code: "ctx.preStmts = append(ctx.preStmts, stmt)"
    in ctx = ctx
    in stmt = stmt
  }
end

func ctxDrainPreStmts(ctx: Ref[egCtx]) -> String
  let out = joinStrings(ctx.preStmts, "\n")
  go[()] {
    code: "ctx.preStmts = nil"
    in ctx = ctx
  }
  out
end

func ctxPushAstPreStmt(ctx: Ref[egCtx], stmt: goast.Stmt) -> ()
  go[()] {
    code: "ctx.astPreStmts = append(ctx.astPreStmts, stmt)"
    in ctx = ctx
    in stmt = stmt
  }
end

func ctxDrainAstPreStmts(ctx: Ref[egCtx]) -> Slice[goast.Stmt]
  let out = ctx.astPreStmts
  go[()] {
    code: "ctx.astPreStmts = nil"
    in ctx = ctx
  }
  out
end

func ctxAdoptExprSeq(ctx: Ref[egCtx], child: Ref[egCtx]) -> ()
  go[()] {
    code: """
      if child.exprSeq > ctx.exprSeq {
        ctx.exprSeq = child.exprSeq
      }
    """
    in ctx = ctx
    in child = child
  }
end

func ctxGetBinding(ctx: Ref[egCtx], name: String) -> Option[String]
  ctx.bindings.Get(name)
end

func ctxAddTypeParam(ctx: Ref[egCtx], tp: String) -> ()
  ctx.typeParams.Add(tp)
  ()
end

func ctxHasTypeParam(ctx: Ref[egCtx], tp: String) -> Bool
  ctx.typeParams.Fold(false, func(found: Bool, current: String) -> Bool
    found || current == tp
  end)
end

# lookupFieldInMonoType: 对 MonoType.TCon(typeName, args) 查找字段 field，
# 替换 typeName 的类型参数 args 后返回字段的 MonoType。
func lookupFieldInMonoType(base: ast2.MonoType, field: String, ctx: Ref[egCtx]) -> Option[ast2.MonoType]
  switch base
    case TCon(typeName, args) =>
      let fields = ctx.structFields.Get(typeName)
      switch fields
        case Some(list) =>
          let found = findFieldInSlice(list, field, 0)
          switch found
            case Some(fieldEntry) =>
              let bound = ctx.structTypeParams.Get(typeName).UnwrapOr([] as Slice[Int])
              if bound.Len() == 0 || args.Len() == 0 then
                Some(fieldEntry.Type)
              else
                let subst = bindTypeArgs(bound, args, 0, [] as Slice[typeinference2.SubstEntry])
                Some(typeinference2.ApplySubst(subst, fieldEntry.Type))
              end
            case None => None
          end
        case None => None
      end
    case _ => None
  end
end

func findFieldInSlice(fields: Slice[typeinference2.FieldEntry], name: String, index: Int) -> Option[typeinference2.FieldEntry]
  if index >= fields.Len() then None else
    let f = fields.Get(index).UnwrapOr(typeinference2.FieldEntry { TypeName: "", FieldName: "", Type: ast2.MonoType.TUnit })
    if f.FieldName == name then Some(f) else findFieldInSlice(fields, name, index + 1) end
  end
end

func bindTypeArgs(bound: Slice[Int], args: Slice[ast2.MonoType], index: Int, out: Slice[typeinference2.SubstEntry]) -> Slice[typeinference2.SubstEntry]
  if index >= bound.Len() || index >= args.Len() then out else
    let id = bound.Get(index).UnwrapOr(0)
    let typ = args.Get(index).UnwrapOr(ast2.MonoType.TUnit)
    let next = out.Prepend(typeinference2.SubstEntry { ID: id, Type: typ })
    bindTypeArgs(bound, args, index + 1, next)
  end
end

# monoTypeToGoStr: 将 MonoType 转换为 Go 类型字符串，用于 goast 调用。
func monoTypeToGoStr(t: ast2.MonoType) -> String
  switch t
    case TCon(name, args) =>
      if args.Len() == 0 then goPrimitiveTypeName(name) else
        let argStrs = args.Map(func(a: ast2.MonoType) -> String monoTypeToGoStr(a) end)
        mygoToGoTypeStr(name + "[" + joinStrings(argStrs, ", ") + "]")
      end
    case TFunc(params, ret) =>
      let paramStrs = params.Map(func(p: ast2.MonoType) -> String monoTypeToGoStr(p) end)
      let retStr = monoTypeToGoStr(ret.value())
      if retStr == "struct{}" then
        "func(" + joinStrings(paramStrs, ", ") + ")"
      else
        "func(" + joinStrings(paramStrs, ", ") + ") " + retStr
      end
    case TApp(ctor, args) =>
      let ctorStr = monoTypeToGoStr(ctor.value())
      let argStrs = args.Map(func(a: ast2.MonoType) -> String monoTypeToGoStr(a) end)
      if argStrs.Len() == 0 then ctorStr else ctorStr + "[" + joinStrings(argStrs, ", ") + "]" end
    case TTuple(items) =>
      let parts = items.Map(func(i: ast2.MonoType) -> String monoTypeToGoStr(i) end)
      "struct { " + joinStrings(parts, "; ") + " }"
    case TUnit => "struct{}"
    case TVar(_) => "any"
    case TKVar(_) => "any"
    case TParam(_) => "any"
    case TGoPackage(_) => "any"
  end
end

# monoTypeToGoStrWithParams renders inference TParams using the ordered
# type-parameter names of the current function/impl context.
func monoTypeToGoStrWithParams(t: ast2.MonoType, params: Slice[String]) -> String
  switch t
    case TParam(id) =>
      let index = -id - 1
      params.Get(index).UnwrapOr("any")
    case TCon(name, args) =>
      if args.Len() == 0 then goPrimitiveTypeName(name) else
        let argStrs = args.Map(func(arg: ast2.MonoType) -> String monoTypeToGoStrWithParams(arg, params) end)
        mygoToGoTypeStr(name + "[" + joinStrings(argStrs, ", ") + "]")
      end
    case TFunc(items, ret) =>
      let argStrs = items.Map(func(arg: ast2.MonoType) -> String monoTypeToGoStrWithParams(arg, params) end)
      let retStr = monoTypeToGoStrWithParams(ret.value(), params)
      if retStr == "struct{}" then "func(" + joinStrings(argStrs, ", ") + ")" else "func(" + joinStrings(argStrs, ", ") + ") " + retStr end
    case TTuple(items) =>
      let parts = items.Map(func(item: ast2.MonoType) -> String monoTypeToGoStrWithParams(item, params) end)
      "struct { " + joinStrings(parts, "; ") + " }"
    case _ => monoTypeToGoStr(t)
  end
end

# monoTypeToMygoStr: 将 MonoType 转换为 MyGO 类型字符串（用于打印/调试）。
func monoTypeToMygoStr(t: ast2.MonoType) -> String
  typeinference2.MonoStringFull(t)
end
