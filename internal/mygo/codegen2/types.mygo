package codegen2

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import goast "go:github.com/mygo-lang/mygo/internal/mygo/codegen2/goast"
import typeinference2 "github.com/mygo-lang/mygo/internal/mygo/typeinference2"

# egCtx 是表达式/语句翻译的上下文
struct egCtx
  # 局部变量名 → MonoType（不再使用字符串拼接查找 field）
  locals: Map[String, ast2.MonoType]
  # MyGO 名 → Go 名
  bindings: Map[String, String]
  # TODO: 需要存储 enum 变体的字段类型
  # Struct 字段类型：TypeName → [FieldEntry]
  structFields: Map[String, Slice[typeinference2.FieldEntry]]
  # Struct 类型参数 ID：TypeName → Bound IDs
  structTypeParams: Map[String, Slice[Int]]
  # 变量是否可变
  mutable: Map[String, Bool]
  # SSA 风格命名计数
  usedNames: Map[String, Int]
  # 表达式位置展开为语句时使用的临时变量序号
  exprSeq: Int
  # 表达式位置展开出的前置语句
  preStmts: Slice[String]
  # AST 原生的前置语句，供控制流迁移使用。
  astPreStmts: Slice[goast.Stmt]
  # 当前作用域的类型参数
  typeParams: Set[String]
  # 保留声明顺序，用于把推断中的 TParam(-1/-2) 渲染为 Go 的 A/E。
  typeParamNames: Slice[String]
  # 当前函数的返回类型
  retType: ast2.MonoType
  # 多返回值类型
  retTypes: Slice[ast2.MonoType]
  # 尾递归候选函数名
  tailRecFuncName: Option[String]
  # 参数数量
  tailRecParamCount: Int
  # 尾递归参数 Go 名
  tailRecParamNames: Slice[String]
  constraintFuncs: Map[String, String]
  constraintFuncNames: Map[String, Slice[String]]
  constraintFuncArgTypes: Map[String, Slice[String]]
  constraintFuncArgMonoTypes: Map[String, Slice[ast2.MonoType]]
  dictionaryCallFuncs: Map[String, String]
  callDictionaries: Map[String, Slice[String]]
  packageDictionaries: Map[String, String]
  callRequirements: Map[String, Slice[DictionaryRequirement]]
  packageCandidates: Map[String, Slice[ImplDictionaryCandidate]]
  # Inherent impls and typeclass instances share receiver-call syntax but
  # differ in how they are selected. Keep their candidate pools distinct.
  inherentCandidates: Slice[ImplDictionaryCandidate]
  typeclassCandidates: Slice[ImplDictionaryCandidate]
  goPackages: Slice[typeinference2.GoPackageEntry]
  pkgInfo: Option[typeinference2.PackageInfo]
  # import path → source alias, so TQualifiedName(path, ...) can be rendered
  # back to `alias.member` in the generated Go code.
  pathAliases: Map[String, String]
  enumValueConstructors: Map[String, String]
  enumVariantOwners: Map[String, String]
  patternTypes: Map[String, ast2.MonoType]
  patternFuncIdx: Map[String, Int]
  variantFieldMonoTypes: Map[String, Slice[ast2.MonoType]]
  interfaceMethods: Map[String, Slice[ast2.FuncSig]]
  interfaceTypeParams: Map[String, Slice[String]]
  namedImpls: Map[String, Bool]
end

# PackageIndex is immutable lowering metadata shared by every function and
# impl-method context in a generated file.  It deliberately contains only
# package facts; lexical bindings and per-expression state remain in egCtx.
struct PackageIndex
  StructFields: Map[String, Slice[typeinference2.FieldEntry]]
  StructTypeParams: Map[String, Slice[Int]]
  CallDictionaries: Map[String, Slice[String]]
  PackageDictionaries: Map[String, String]
  CallRequirements: Map[String, Slice[DictionaryRequirement]]
  PackageCandidates: Map[String, Slice[ImplDictionaryCandidate]]
  InherentCandidates: Slice[ImplDictionaryCandidate]
  TypeclassCandidates: Slice[ImplDictionaryCandidate]
  EnumValueConstructors: Map[String, String]
  EnumVariantOwners: Map[String, String]
  VariantFieldMonoTypes: Map[String, Slice[ast2.MonoType]]
  InterfaceMethods: Map[String, Slice[ast2.FuncSig]]
  InterfaceTypeParams: Map[String, Slice[String]]
  NamedImpls: Map[String, Bool]
end

struct Generator2
  pkgName: String
  importPaths: Slice[String]
  currentFile: String
  localSeq: Int
  switchVarSeq: Int
  needsCallAny: Bool
  allDecls: Slice[ast2.Decl]
  decls: Slice[ast2.Decl]
  goPackages: Slice[typeinference2.GoPackageEntry]
  pkgInfo: Option[typeinference2.PackageInfo]
  pathAliases: Map[String, String]
  packageIndex: PackageIndex
end

struct AstExprResult
  Expr: goast.Expr
  Pre: Slice[goast.Stmt]
end

struct AstArgsResult
  Exprs: Slice[goast.Expr]
  Pre: Slice[goast.Stmt]
end

struct AstCompositeFields
  Elts: Slice[goast.Expr]
  Pre: Slice[goast.Stmt]
end

struct AstInlineOperands
  ValueNames: Slice[String]
  ValueSources: Slice[String]
  TypeNames: Slice[String]
  TypeSources: Slice[String]
  Pre: Slice[goast.Stmt]
end

struct DictionaryRequirement
  Interface: String
  Method: String
  Args: Slice[ast2.TypeExpr]
end

struct ImplDictionaryCandidate
  Interface: String
  Method: String
  InterfaceArgs: Slice[ast2.TypeExpr]
  Receiver: ast2.MonoType
  TypeParams: Slice[String]
  Helper: String
end

func newAstExprResult(expr: goast.Expr) -> AstExprResult
  AstExprResult { Expr: expr, Pre: [] }
end

func astExprWithPre(expr: goast.Expr, pre: Slice[goast.Stmt]) -> AstExprResult
  AstExprResult { Expr: expr, Pre: pre }
end

func newEgCtx() -> egCtx
  egCtx {
    locals: {},
    bindings: {},
    structFields: {},
    structTypeParams: {},
    mutable: {},
    usedNames: {},
    exprSeq: 0,
    preStmts: [],
    astPreStmts: [],
    typeParams: Set.New[String](),
    typeParamNames: [],
    retType: ast2.MonoType.TUnit,
    retTypes: [],
    tailRecFuncName: None,
    tailRecParamCount: 0,
    tailRecParamNames: [],
    constraintFuncs: {},
    constraintFuncNames: {},
    constraintFuncArgTypes: {},
    constraintFuncArgMonoTypes: {},
    dictionaryCallFuncs: {},
    callDictionaries: {},
    packageDictionaries: {},
    callRequirements: {},
    packageCandidates: {},
    inherentCandidates: [],
    typeclassCandidates: [],
    goPackages: [],
    pkgInfo: None,
    pathAliases: {},
    enumValueConstructors: {},
    enumVariantOwners: {},
    patternTypes: {},
    patternFuncIdx: {},
    variantFieldMonoTypes: {},
    interfaceMethods: {},
    interfaceTypeParams: {},
    namedImpls: {},
  }
end

func newEgCtxWithTypeParams(params: Slice[String]) -> egCtx
  egCtx {
    locals: {},
    bindings: {},
    structFields: {},
    structTypeParams: {},
    mutable: {},
    usedNames: {},
    exprSeq: 0,
    preStmts: [],
    astPreStmts: [],
    typeParams: typeParamSet(params),
    typeParamNames: params,
    retType: ast2.MonoType.TUnit,
    retTypes: [],
    tailRecFuncName: None,
    tailRecParamCount: 0,
    tailRecParamNames: [],
    constraintFuncs: {},
    constraintFuncNames: {},
    constraintFuncArgTypes: {},
    constraintFuncArgMonoTypes: {},
    dictionaryCallFuncs: {},
    callDictionaries: {},
    packageDictionaries: {},
    callRequirements: {},
    packageCandidates: {},
    inherentCandidates: [],
    typeclassCandidates: [],
    goPackages: [],
    pkgInfo: None,
    pathAliases: {},
    enumValueConstructors: {},
    enumVariantOwners: {},
    patternTypes: {},
    patternFuncIdx: {},
    variantFieldMonoTypes: {},
    interfaceMethods: {},
    interfaceTypeParams: {},
    namedImpls: {},
  }
end

func newFuncEgCtx(params: Slice[String], retType: ast2.MonoType, tailName: String, paramCount: Int) -> egCtx
  egCtx {
    locals: {},
    bindings: {},
    structFields: {},
    structTypeParams: {},
    mutable: {},
    usedNames: {},
    exprSeq: 0,
    preStmts: [],
    astPreStmts: [],
    typeParams: typeParamSet(params),
    typeParamNames: params,
    retType: retType,
    retTypes: [],
    tailRecFuncName: Some(tailName),
    tailRecParamCount: paramCount,
    tailRecParamNames: [],
    constraintFuncs: {},
    constraintFuncNames: {},
    constraintFuncArgTypes: {},
    constraintFuncArgMonoTypes: {},
    dictionaryCallFuncs: {},
    callDictionaries: {},
    packageDictionaries: {},
    callRequirements: {},
    packageCandidates: {},
    inherentCandidates: [],
    typeclassCandidates: [],
    goPackages: [],
    pkgInfo: None,
    pathAliases: {},
    enumValueConstructors: {},
    enumVariantOwners: {},
    patternTypes: {},
    patternFuncIdx: {},
    variantFieldMonoTypes: {},
    interfaceMethods: {},
    interfaceTypeParams: {},
    namedImpls: {},
  }
end

func newGenerator2(pkgName: String, typedDecls: Slice[ast2.Decl], imports: Slice[GoImportPart], goPackages: Slice[typeinference2.GoPackageEntry], pkgInfo: typeinference2.PackageInfo, packageIndex: PackageIndex) -> Generator2
  Generator2 {
    pkgName: pkgName,
    importPaths: [],
    currentFile: "",
    localSeq: 0,
    switchVarSeq: 0,
    needsCallAny: false,
    allDecls: [] as Slice[ast2.Decl],
    decls: typedDecls,
    goPackages: goPackages,
    pkgInfo: Some(pkgInfo),
    pathAliases: pathAliasesFromImports(imports),
    packageIndex: packageIndex,
  }
end

func ctxChild(ctx: Ref[egCtx]) -> egCtx
  egCtx {
    locals: ctx.locals,
    bindings: ctx.bindings,
    structFields: ctx.structFields,
    structTypeParams: ctx.structTypeParams,
    mutable: ctx.mutable,
    usedNames: ctx.usedNames,
    exprSeq: ctx.exprSeq,
    preStmts: [],
    astPreStmts: [],
    typeParams: ctx.typeParams,
    typeParamNames: ctx.typeParamNames,
    retType: ctx.retType,
    retTypes: ctx.retTypes,
    tailRecFuncName: ctx.tailRecFuncName,
    tailRecParamCount: ctx.tailRecParamCount,
    tailRecParamNames: ctx.tailRecParamNames,
    constraintFuncs: ctx.constraintFuncs,
    constraintFuncNames: ctx.constraintFuncNames,
    constraintFuncArgTypes: ctx.constraintFuncArgTypes,
    constraintFuncArgMonoTypes: ctx.constraintFuncArgMonoTypes,
    dictionaryCallFuncs: ctx.dictionaryCallFuncs,
    callDictionaries: ctx.callDictionaries,
    packageDictionaries: ctx.packageDictionaries,
    callRequirements: ctx.callRequirements,
    packageCandidates: ctx.packageCandidates,
    inherentCandidates: ctx.inherentCandidates,
    typeclassCandidates: ctx.typeclassCandidates,
    goPackages: ctx.goPackages,
    pkgInfo: ctx.pkgInfo,
    pathAliases: ctx.pathAliases,
    enumValueConstructors: ctx.enumValueConstructors,
    enumVariantOwners: ctx.enumVariantOwners,
    patternTypes: ctx.patternTypes,
    patternFuncIdx: ctx.patternFuncIdx,
    variantFieldMonoTypes: ctx.variantFieldMonoTypes,
    interfaceMethods: ctx.interfaceMethods,
    interfaceTypeParams: ctx.interfaceTypeParams,
    namedImpls: ctx.namedImpls,
  }
end

func ctxSetLocal(ctx: Ref[egCtx], name: String, typ: ast2.MonoType) -> ()
  ctx.locals.Set(name, typ)
end

func ctxGetLocal(ctx: Ref[egCtx], name: String) -> Option[ast2.MonoType]
  ctx.locals.Get(name)
end

func ctxSetBinding(ctx: Ref[egCtx], name: String, goName: String) -> ()
  ctx.bindings.Set(name, goName)
end

func ctxFreshBinding(ctx: Ref[egCtx], name: String) -> String
  let base = sanitizeIdent(name)
  let count = ctx.usedNames.Get(base).UnwrapOr(0)
  ctx.usedNames.Set(base, count + 1)
  if count == 0 then
    ctx.bindings.Set(name, base)
    return base
  end
  let actual = base + "_" + count.ToString()
  ctx.bindings.Set(name, actual)
  actual
end

func ctxSetMutable(ctx: Ref[egCtx], name: String, isMutable: Bool) -> ()
  ctx.mutable.Set(name, isMutable)
end

func ctxSetTailRecParamNames(ctx: Ref[egCtx], names: Slice[String]) -> ()
  go[()] {
    code: "ctx.tailRecParamNames = names"
    in ctx = ctx
    in names = names
  }
end

func ctxFreshExprTemp(ctx: Ref[egCtx]) -> String
  let name = "__mygo_expr_" + ctx.exprSeq.ToString()
  go[()] {
    code: "ctx.exprSeq = ctx.exprSeq + 1"
    in ctx = ctx
  }
  name
end

func ctxPushPreStmt(ctx: Ref[egCtx], stmt: String) -> ()
  go[()] {
    code: "ctx.preStmts = append(ctx.preStmts, stmt)"
    in ctx = ctx
    in stmt = stmt
  }
end

func ctxDrainPreStmts(ctx: Ref[egCtx]) -> String
  let out = joinStrings(ctx.preStmts, "\n")
  go[()] {
    code: "ctx.preStmts = nil"
    in ctx = ctx
  }
  out
end

func ctxPushAstPreStmt(ctx: Ref[egCtx], stmt: goast.Stmt) -> ()
  go[()] {
    code: "ctx.astPreStmts = append(ctx.astPreStmts, stmt)"
    in ctx = ctx
    in stmt = stmt
  }
end

func ctxDrainAstPreStmts(ctx: Ref[egCtx]) -> Slice[goast.Stmt]
  let out = ctx.astPreStmts
  go[()] {
    code: "ctx.astPreStmts = nil"
    in ctx = ctx
  }
  out
end

func ctxAdoptExprSeq(ctx: Ref[egCtx], child: Ref[egCtx]) -> ()
  go[()] {
    code: """
      if child.exprSeq > ctx.exprSeq {
        ctx.exprSeq = child.exprSeq
      }
    """
    in ctx = ctx
    in child = child
  }
end

func ctxGetBinding(ctx: Ref[egCtx], name: String) -> Option[String]
  ctx.bindings.Get(name)
end

func ctxAddTypeParam(ctx: Ref[egCtx], tp: String) -> ()
  ctx.typeParams.Add(tp)
  ()
end

func ctxHasTypeParam(ctx: Ref[egCtx], tp: String) -> Bool
  ctx.typeParams.Fold(false, func(found: Bool, current: String) -> Bool
    found || current == tp
  end)
end

# lookupFieldInMonoType: 对 MonoType.TCon(typeName, args) 查找字段 field，
# 替换 typeName 的类型参数 args 后返回字段的 MonoType。
func lookupFieldInMonoType(base: ast2.MonoType, field: String, ctx: Ref[egCtx]) -> Option[ast2.MonoType]
  switch base
    case TApp(typeRef, args) then
      switch typeRef.value()
        case TCon(typeName) then
          let fields = ctx.structFields.Get(typeName)
          switch fields
            case Some(list) then
              let found = findFieldInSlice(list, field, 0)
              switch found
                case Some(fieldEntry) then
                  let bound = ctx.structTypeParams.Get(typeName).UnwrapOr([] as Slice[Int])
                  if bound.Len() == 0 || args.Len() == 0 then
                    Some(fieldEntry.Type)
                  else
                    let subst = bindTypeArgs(bound, args, 0, [] as Slice[typeinference2.SubstEntry])
                    Some(typeinference2.ApplySubst(typeinference2.SubstFromEntries(subst), fieldEntry.Type))
                  end
                end
                case None => None
              end
            end
            case None => None
          end
        end
        case _ => None
      end
    end
    case TCon(typeName) =>
      let fields = ctx.structFields.Get(typeName)
      switch fields
        case Some(list) then
          let found = findFieldInSlice(list, field, 0)
          switch found
            case Some(fieldEntry) then
              Some(fieldEntry.Type)
            end
            case None => None
          end
        end
        case None => None
      end
    case _ => None
  end
end

func findFieldInSlice(fields: Slice[typeinference2.FieldEntry], name: String, index: Int) -> Option[typeinference2.FieldEntry]
  if index >= fields.Len() then None else
    let f = fields.Get(index).UnwrapOr(typeinference2.FieldEntry { TypeName: "", FieldName: "", Type: ast2.MonoType.TUnit })
    if f.FieldName == name then Some(f) else findFieldInSlice(fields, name, index + 1) end
  end
end

func bindTypeArgs(bound: Slice[Int], args: Slice[ast2.MonoType], index: Int, out: Slice[typeinference2.SubstEntry]) -> Slice[typeinference2.SubstEntry]
  if index >= bound.Len() || index >= args.Len() then out else
    let id = bound.Get(index).UnwrapOr(0)
    let typ = args.Get(index).UnwrapOr(ast2.MonoType.TUnit)
    let next = out.Prepend(typeinference2.SubstEntry { ID: id, Type: typ })
    bindTypeArgs(bound, args, index + 1, next)
  end
end

# pathAliasesFromImports builds an import path → source alias table from the
# file's Go import parts.  Keys are Go import paths (the `go:` prefix already
# stripped), matching the TQualifiedName path after importPathForGo.
func pathAliasesFromImports(imports: Slice[GoImportPart]) -> Map[String, String]
  pathAliasesFromImportsAt(imports, 0, {})
end

func pathAliasesFromImportsAt(imports: Slice[GoImportPart], index: Int, out: Map[String, String]) -> Map[String, String]
  if index >= imports.Len() then out else
    switch imports.Get(index)
      case Some(im) =>
        let existing = out.Get(im.Path).UnwrapOr("")
        if existing == "" then
          out.Set(im.Path, im.Alias)
          pathAliasesFromImportsAt(imports, index + 1, out)
        else
          pathAliasesFromImportsAt(imports, index + 1, out)
        end
      case None => pathAliasesFromImportsAt(imports, index + 1, out)
    end
  end
end

# monoTypeToGoStr: 将 MonoType 转换为 Go 类型字符串，用于 goast 调用。
# Entry point without a file context; TQualifiedName cannot be restored to an
# alias here (equivalent to an empty alias table).
func monoTypeToGoStr(t: ast2.MonoType) -> String
  monoTypeToGoStrIn(t, {})
end

# monoTypeToGoStrIn renders a MonoType as a Go type string, resolving
# TQualifiedName(path, inner) back to `alias.member` using the current file's
# import path → alias table (`aliases`).
func monoTypeToGoStrIn(t: ast2.MonoType, aliases: Map[String, String]) -> String
  switch t
    case TCon(name) => goPrimitiveTypeName(name)
    case TFunc(params, ret) then
      let paramStrs = params.Map(func(p: ast2.MonoType) -> String monoTypeToGoStrIn(p, aliases) end)
      let retStr = monoTypeToGoStrIn(ret.value(), aliases)
      if retStr == "struct{}" then
        "func(" + joinStrings(paramStrs, ", ") + ")"
      else
        "func(" + joinStrings(paramStrs, ", ") + ") " + retStr
      end
    end
    case TApp(ctor, args) then
      switch ctor.value()
        # Ref is a compiler-recognised boundary type, never a generated Go
        # generic.  This path is used for typed local declarations, unlike
        # goType which already handles Ref in source signatures.
        case TCon(name) then
          if name == "Ref" && args.Len() == 1 then
            "*" + monoTypeToGoStrIn(args.Get(0).UnwrapOr(ast2.MonoType.TUnit), aliases)
          elsif name == "Slice" && args.Len() == 1 then
            "[]" + monoTypeToGoStrIn(args.Get(0).UnwrapOr(ast2.MonoType.TUnit), aliases)
          elsif name == "Map" && args.Len() == 2 then
            "map[" + monoTypeToGoStrIn(args.Get(0).UnwrapOr(ast2.MonoType.TUnit), aliases) + "]" + monoTypeToGoStrIn(args.Get(1).UnwrapOr(ast2.MonoType.TUnit), aliases)
          elsif name == "Set" && args.Len() == 1 then
            "map[" + monoTypeToGoStrIn(args.Get(0).UnwrapOr(ast2.MonoType.TUnit), aliases) + "]struct{}"
          else
            let ctorStr = monoTypeToGoStrIn(ctor.value(), aliases)
            let argStrs = args.Map(func(a: ast2.MonoType) -> String monoTypeToGoStrIn(a, aliases) end)
            if argStrs.Len() == 0 then ctorStr else ctorStr + "[" + joinStrings(argStrs, ", ") + "]" end
          end
        end
        case _ =>
          let ctorStr = monoTypeToGoStrIn(ctor.value(), aliases)
          let argStrs = args.Map(func(a: ast2.MonoType) -> String monoTypeToGoStrIn(a, aliases) end)
          if argStrs.Len() == 0 then ctorStr else ctorStr + "[" + joinStrings(argStrs, ", ") + "]" end
      end
    end
    case TTuple(items) =>
      "struct { " + joinStrings(tupleMonoElemsToStringsIn(items, [] as Slice[String], aliases, 0, [] as Slice[String]), "; ") + " }"
    case TUnit => "struct{}"
    case TVar(_) => "any"
    case TKVar(_) => "any"
    case TParam(_) => "any"
    case TQualifiedName(path, inner) then
      let member = monoTypeToGoStrIn(inner.value(), aliases)
      let alias = aliases.Get(importPathForGo(path)).UnwrapOr("")
      if alias == "" || alias == "." then member else alias + "." + member end
    end
  end
end

# monoTypeToGoAstWithParams is the structured counterpart used for typed local
# declarations.  String rendering remains available for diagnostic/text-only
# paths, but lowering no longer reparses those rendered types.
func monoTypeToGoAstWithParams(t: ast2.MonoType, params: Slice[String]) -> goast.Expr
  switch t
    case TCon(name) => if name == "Unit" then goast.EmptyStructType() else goast.TypeName(goPrimitiveTypeName(name)) end
    case TParam(id) => goast.TypeName(params.Get(-id - 1).UnwrapOr("any"))
    case TApp(ctor, args) then
      let lowered = args.Map(func(arg: ast2.MonoType) -> goast.Expr monoTypeToGoAstWithParams(arg, params) end)
      switch ctor.value()
        case TCon(name) then
          if name == "Ref" && lowered.Len() == 1 then goast.TypePointer(lowered.Get(0).UnwrapOr(goast.TypeName("any")))
          elsif name == "Slice" && lowered.Len() == 1 then goast.TypeSlice(lowered.Get(0).UnwrapOr(goast.TypeName("any")))
          elsif name == "Map" && lowered.Len() == 2 then goast.TypeMap(lowered.Get(0).UnwrapOr(goast.TypeName("any")), lowered.Get(1).UnwrapOr(goast.TypeName("any")))
          elsif name == "Set" && lowered.Len() == 1 then goast.TypeMap(lowered.Get(0).UnwrapOr(goast.TypeName("any")), goast.EmptyStructType())
          else goast.TypeApply(goast.TypeName(goPrimitiveTypeName(name)), lowered)
          end
        end
        case _ => goast.TypeApply(monoTypeToGoAstWithParams(ctor.value(), params), lowered)
      end
    end
    case TFunc(items, ret) => goast.TypeFunc(items.Map(func(item: ast2.MonoType) -> goast.Expr monoTypeToGoAstWithParams(item, params) end), monoTypeToGoAstWithParams(ret.value(), params), !monoIsUnit(ret.value()))
    case TTuple(items) => goast.TypeTuple(items.Map(func(item: ast2.MonoType) -> goast.Expr monoTypeToGoAstWithParams(item, params) end))
    case TUnit => goast.EmptyStructType()
    case TQualifiedName(_, inner) => monoTypeToGoAstWithParams(inner.value(), params)
    case _ => goast.TypeName("any")
  end
end

func monoIsUnit(t: ast2.MonoType) -> Bool
  switch t
    case TUnit => true
    case TCon(name) => name == "Unit"
    case _ => false
  end
end

# monoTypeToGoStrWithParams renders inference TParams using the ordered
# type-parameter names of the current function/impl context.
func monoTypeToGoStrWithParams(t: ast2.MonoType, params: Slice[String]) -> String
  monoTypeToGoStrWithParamsIn(t, params, {})
end

# monoTypeToGoStrWithParamsIn additionally resolves TQualifiedName back to
# `alias.member` through the file's import path → alias table.
func monoTypeToGoStrWithParamsIn(t: ast2.MonoType, params: Slice[String], aliases: Map[String, String]) -> String
  switch t
    case TParam(id) then
      let index = -id - 1
      params.Get(index).UnwrapOr("any")
    end
    case TApp(typeRef, args) then
      switch typeRef.value()
        case TCon(name) then
          let argStrs = args.Map(func(arg: ast2.MonoType) -> String
            monoTypeToGoStrWithParamsIn(arg, params, aliases)
          end)
          if name == "Ref" && argStrs.Len() == 1 then
            "*" + argStrs.Get(0).UnwrapOr("any")
          elsif name == "Slice" && argStrs.Len() == 1 then
            "[]" + argStrs.Get(0).UnwrapOr("any")
          elsif name == "Map" && argStrs.Len() == 2 then
            "map[" + argStrs.Get(0).UnwrapOr("any") + "]" + argStrs.Get(1).UnwrapOr("any")
          elsif name == "Set" && argStrs.Len() == 1 then
            "map[" + argStrs.Get(0).UnwrapOr("any") + "]struct{}"
          else
            mygoToGoTypeStr(name + "[" + joinStrings(argStrs, ", ") + "]")
          end
        end
        case _ => monoTypeToGoStrIn(t, aliases)
      end
    end
    case TCon(name) => goPrimitiveTypeName(name)
    case TFunc(items, ret) then
      let argStrs = items.Map(func(arg: ast2.MonoType) -> String monoTypeToGoStrWithParamsIn(arg, params, aliases) end)
      let retStr = monoTypeToGoStrWithParamsIn(ret.value(), params, aliases)
      if retStr == "struct{}" then "func(" + joinStrings(argStrs, ", ") + ")" else "func(" + joinStrings(argStrs, ", ") + ") " + retStr end
    end
    case TTuple(items) =>
      "struct { " + joinStrings(tupleMonoElemsToStringsIn(items, params, aliases, 0, [] as Slice[String]), "; ") + " }"
    case _ => monoTypeToGoStrIn(t, aliases)
  end
end

# monoTypeToMygoStr: 将 MonoType 转换为 MyGO 类型字符串（用于打印/调试）。
func monoTypeToMygoStr(t: ast2.MonoType) -> String
  typeinference2.MonoStringFull(t)
end

# tupleMonoElemsToStrings renders each tuple element as a `F<n> <GoType>`
# pair so the resulting anonymous struct literal can be matched field by
# field.  Recursive instead of `Map(func(i: Int, item: T) ...)` because
# the mygo type for `items.Map` only exposes the element value, not its
# index.  This mirrors tupleElemsToStringsLoop in types_util.mygo.
func tupleMonoElemsToStrings(items: Slice[ast2.MonoType], params: Slice[String], index: Int, out: Slice[String]) -> Slice[String]
  tupleMonoElemsToStringsIn(items, params, {}, index, out)
end

func tupleMonoElemsToStringsIn(items: Slice[ast2.MonoType], params: Slice[String], aliases: Map[String, String], index: Int, out: Slice[String]) -> Slice[String]
  if items.Len() == 0 then out else
    let head = items.Get(0).UnwrapOr(ast2.MonoType.TUnit)
    let tail = tupleMonoElemsToStringsIn(sliceDrop(items, 1), params, aliases, index + 1, out)
    tail.Prepend("F" + index.ToString() + " " + monoTypeToGoStrWithParamsIn(head, params, aliases))
  end
end
