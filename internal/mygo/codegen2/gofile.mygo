package codegen2
import common2 "github.com/mygo-lang/mygo/internal/mygo/common2"

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import parser2 "github.com/mygo-lang/mygo/internal/mygo/parser2"
import typeinference2 "github.com/mygo-lang/mygo/internal/mygo/typeinference2"
import goast "go:github.com/mygo-lang/mygo/internal/mygo/codegen2/goast"
import strings "go:strings"

func funcSignature(
  prefix: String,
  tps: Slice[String],
  params: Slice[ast2.Param],
  ret: Option[ast2.TypeExpr],
  outer: Set[String]
) -> String
  var allTypes: Set[String] = outer
  allTypes = tps.Fold(allTypes, func(acc: Set[String], tp: String) -> Set[String] acc.Add(tp) end)
  let ps = params.Map(func(p: ast2.Param) -> String
    sanitizeIdent(p.Name) + " " + goType(p.Type, allTypes)
  end)
  prefix + typeParamDecl(tps) + "(" + common2.JoinStrings(ps, ", ") + ")" + returnTypeString(
    ret,
    allTypes
  )
end

func returnTypeString(ret: Option[ast2.TypeExpr], tps: Set[String]) -> String
  switch ret
    case Some(t) then
      let r = goReturnType(t, tps)
      if r == "" => "" else " " + r
    end
    case None => ""
  end
end

func returnMonoType(ret: Option[ast2.TypeExpr]) -> ast2.MonoType
  switch ret
    case Some(t) => typeinference2.TypeFromAST(t)
    case None => ast2.MonoType.TUnit
  end
end

func typeParamDecl(tps: Slice[String]) -> String
  if tps.Len() == 0 then
    ""
  else
    let parts = tps.Map(func(tp: String) -> String hktTypeParamName(tp) + " any" end)
    "[" + common2.JoinStrings(parts, ", ") + "]"
  end
end

func typeParamUse(tps: Slice[String]) -> String
  if tps.Len() == 0 then
    ""
  else
    let parts = tps.Map(func(tp: String) -> String hktTypeParamName(tp) end)
    "[" + common2.JoinStrings(parts, ", ") + "]"
  end
end

# Go has no higher-kinded generic parameters. For a source parameter C[A],
# declare the constructor placeholder as C and use HKT[C, A] at use sites.
func hktTypeParamName(tp: String) -> String
  let index = strings.Index(tp, "[")
  if index < 0 then
    sanitizeIdent(tp)
  else
    sanitizeIdent(hktTypeParamHead(strings.Split(tp, "["), tp))
  end
end

func hktTypeParamHead(parts: Slice[String], fallback: String) -> String
  switch parts.Get(0)
    case Some(head) => head
    case None => fallback
  end
end

func sourceToGenName(path: String) -> String
  let parts = strings.Split(path, "/")
  var base: String = sourcePathLastPart(parts, path)
  base = strings.TrimSuffix(base, ".mygo")
  if base == "" then
    base = "mygo"
  end
  if strings.HasSuffix(base, "_test") then
    return "zz_" + strings.TrimSuffix(base, "_test") + ".gen_test.go"
  end
  "zz_" + base + ".gen.go"
end

func sourcePathLastPart(parts: Slice[String], fallback: String) -> String
  switch parts.Get(parts.Len() - 1)
    case Some(part) => part
    case None => fallback
  end
end

func renderGoFileSource(parts: GoFileParts) -> Result[String, ast2.Diagnostic]
  let imports = parts.Imports.Map(func(im: GoImportPart) -> goast.Import
    if im.Alias == importAliasForPath(im.Path) then
      goast.Import { Alias: "", Path: im.Path }
    else
      goast.Import { Alias: im.Alias, Path: im.Path }
    end
  end)
  switch goast.RenderWithLegacy(parts.PackageName, imports, parts.AstDecls, parts.Decls)
    case Err(err) => Err(ast2.NewDiagnostic("generate", "go-render", "internal", "goast render: " + err.Error()))
    case Ok(source) => Ok(source)
  end
end

func renderGoFile(parts: GoFileParts) -> Result[String, ast2.Diagnostic]
  renderGoFileSource(parts)
end

func renderFinalGoFile(parts: GoFileParts) -> Result[String, ast2.Diagnostic]
  switch renderGoFileSource(parts)
    case Err(diagnostic) => Err(diagnostic)
    case Ok(source) then
      let finalized = goast.ApplyLineDirectives(parts.Origins, source, parts.AstDecls, parts.SourceName, parts.GeneratedName)
      if finalized.Failure != "" then
        Err(ast2.NewDiagnostic("generate", "line-directive", "internal", finalized.Failure))
      else
        Ok(finalized.Source)
      end
    end
  end
end

func parseSourceAsAst2Diagnostic(input: String) -> Result[ast2.File, ast2.Diagnostic]
  parseSourceAsAst2At("<input>", input)
end

func parseSourceAsAst2At(sourceName: String, input: String) -> Result[ast2.File, ast2.Diagnostic]
  parser2.ParseFileAtDiagnostic(sourceName, input)
end
