package codegen2

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import typeinference2 "github.com/mygo-lang/mygo/internal/mygo/typeinference2"
import goast "go:github.com/mygo-lang/mygo/internal/mygo/codegen2/goast"
import strings "go:strings"


# translateFuncBodyAst is the direct go/ast lowering path for function bodies
# whose result can be represented without statement-expansion temporaries.
func translateFuncBodyAst(body: ast2.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  switch body.Kind
    case BlockExpr(items) => translateAstBlock(items, ctx, 0, [] as Slice[goast.Stmt])
    case _ => translateAstReturnExpr(body, ctx)
  end
end

func translateAstBlock(items: Slice[ast2.Stmt], ctx: Ref[egCtx], index: Int, out: Slice[goast.Stmt]) -> Result[Slice[goast.Stmt], String]
  if items.Len() == 0 then
    switch ctx.retType
      case TUnit => Ok(astSingleStmt(goast.Return([] as Slice[goast.Expr])))
      case _ => Err("non-unit function has empty body")
    end
  else
    switch items.Get(index)
      case Some(stmt) =>
        if index == items.Len() - 1 then
          let final = translateAstReturnStmt(stmt, ctx)
          switch final
            case Ok(stmts) => Ok(goast.AppendStmts(out, stmts))
            case Err(msg) => Err(msg)
          end
        else
          let leading = translateAstLeadingStmt(stmt, ctx)
          switch leading
            case Ok(stmts) => translateAstBlock(items, ctx, index + 1, goast.AppendStmts(out, stmts))
            case Err(msg) => Err(msg)
          end
        end
      case None => Err("malformed AST: missing block statement")
    end
  end
end

func translateAstLeadingStmt(stmt: ast2.Stmt, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  switch stmt
    case ExprStmt(expr) then
      switch expr.Kind
        case InlineGoExpr(typ, body, values, types) => translateInlineGoAst(body, values, types, ctx)
        case IfExpr(cond, thenExpr, elseExpr) => translateAstIfStmt(cond, thenExpr, elseExpr, ctx)
        case SwitchExpr(target, cases, targetType) then
          # Switch in statement context: lower through the statement-form path
          # (translateSwitchAstWithTargetType with an explicit TUnit expected)
          # so the discarded switch value does not create an unused temp
          # variable.  Going through translateExprAst would let
          # translateExprAstExpected substitute the switch's own inferred type
          # for TUnit and route into the expression path instead.
          let value = translateSwitchAstWithTargetType(target, cases, targetType, ctx, ast2.MonoType.TUnit)
          switch value
            case Ok(v) => Ok(v.Pre)
            case Err(msg) => Err(msg)
          end
        end
        case CallExpr(fn, typeArgs, args) then
          # A Go FFI call in statement position discards its Result/Option
          # decoding entirely: Go permits a call statement to drop every
          # return value.  Lowering it through translateExprAst would emit a
          # temp assignment plus a bare identifier statement, which Go rejects
          # as an unused variable.
          switch ffiResultSignature(fn, ctx)
            case Some(_) => translateFFIDiscardStmt(fn, typeArgs, args, ctx)
            case None =>
              switch ffiOptionSignature(fn, ctx)
                case Some(_) => translateFFIDiscardStmt(fn, typeArgs, args, ctx)
                case None => translateLeadingExprStmt(expr, ctx)
              end
          end
        end
        case _ => translateLeadingExprStmt(expr, ctx)
      end
    end
    case LetStmt(bind) => translateAstBinding(bind, ctx)
    case LetRecStmt(bindings) => translateAstLetRec(bindings, ctx)
    case VarStmt(bind) => translateAstBinding(bind, ctx)
    case AssignStmt(target, value) then
      let t = translateExprAst(target, ctx)
      let v = translateExprAst(value, ctx)
      switch t
        case Err(msg) => Err(msg)
        case Ok(tv) then
          switch v
            case Ok(vv) => Ok(goast.AppendStmts(
              goast.AppendStmts(tv.Pre, vv.Pre),
              astSingleStmt(goast.Assign(astSingleExpr(tv.Expr), "=", astSingleExpr(vv.Expr))),
            ))
            case Err(msg) => Err(msg)
          end
        end
      end
    end
    case WhileStmt(cond, body) => translateAstWhileStmt(cond, body, ctx)
    case BreakStmt(_) => Ok(astSingleStmt(goast.Break()))
    case ContinueStmt(_) => Ok(astSingleStmt(goast.Continue()))
    case ReturnStmt => Ok(astSingleStmt(goast.Return([] as Slice[goast.Expr])))
    case ReturnWithStmt(expr) => translateAstReturnExpr(expr, ctx)
    case TupleLetStmt(names, value) => translateAstTupleLetStmt(names, value, ctx)
    case _ => Err("statement requires control-flow lowering")
  end
end

# translateLeadingExprStmt lowers an arbitrary expression appearing as a
# statement: side effects from its pre-statements run, and a non-unit value is
# discarded with an expression statement.
func translateLeadingExprStmt(expr: ast2.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  let value = translateExprAst(expr, ctx)
  switch value
    case Ok(v) then
      if goast.IsUnitExpr(v.Expr) then
        Ok(v.Pre)
      else
        Ok(goast.AppendStmts(v.Pre, astSingleStmt(goast.ExpressionStmt(v.Expr))))
      end
    end
    case Err(msg) => Err(msg)
  end
end

# A Go FFI call in statement position emits the raw call and discards every
# return value (Go allows call statements to drop results).  This avoids
# building a Result/Option temp that a bare identifier statement would leave
# unused.
func translateFFIDiscardStmt(fn: ast2.Expr, typeArgs: Slice[ast2.TypeExpr], args: Slice[ast2.Expr], ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  let raw = translatePlainCallAstExpectedOrdinary(fn, typeArgs, args, ctx, ast2.MonoType.TUnit)
  switch raw
    case Err(msg) => Err(msg)
    case Ok(v) => Ok(goast.AppendStmts(v.Pre, astSingleStmt(goast.ExpressionStmt(v.Expr))))
  end
end

# Tuple destructuring lowers to a sequence of individual let-bindings.  The
# inferred types in TypedInfo do not yet expose tuple element types per
# source position, so we conservatively introduce each bound name with the
# unit type and rely on subsequent uses to widen it via unification.  This
# keeps the bootstrap pipeline compiling packages like ast2_ids.mygo that
# use an explicit `switch expr.Get(0)` to handle a missing tuple element in
# their helper functions.
func translateAstTupleLetStmt(pattern: ast2.Pattern, value: ast2.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  switch value.Kind
    # Top-level MyGO functions with tuple returns, like Go FFI functions,
    # expose native multiple return values.  Destructure those values before
    # falling back to the single tuple-value lowering used for tuple literals.
    case CallExpr(callee, typeArgs, args) =>
      if isTupleReturningLocalCall(callee, ctx) then
        let raw = translatePlainCallAstExpectedOrdinary(callee, typeArgs, args, ctx, ast2.MonoType.TUnit)
        switch raw
          case Err(msg) => Err(msg)
          case Ok(call) then
            switch value.Type
              case None => Err("tuple-returning call has no inferred result type")
              case Some(tupleType) => translateRawTupleLet(pattern, tupleType, call.Expr, call.Pre, ctx)
            end
          end
        end
      else
        switch ffiMultiResultSignatureWithPackage(value, ctx)
          case Some(pair) =>
            let (sig, pkg) = pair
            translateFFITupleLetStmt(pattern, value, sig, pkg, ctx)
          case None => translateAstTupleLetStmtOrdinary(pattern, value, ctx)
        end
      end
    # A tuple-typed inline Go block keeps its raw multiple-return form under
    # tuple destructuring, exactly like a Go FFI multi-result call.
    case InlineGoExpr(typ, body, values, types) =>
      switch typ.value()
        case TupleType(_) => translateInlineGoTupleLet(pattern, body, values, types, value, ctx)
        case _ => translateAstTupleLetStmtOrdinary(pattern, value, ctx)
      end
    case _ =>
      switch ffiMultiResultSignatureWithPackage(value, ctx)
        case Some(pair) =>
          let (sig, pkg) = pair
          translateFFITupleLetStmt(pattern, value, sig, pkg, ctx)
        case None => translateAstTupleLetStmtOrdinary(pattern, value, ctx)
      end
  end
end

func isTupleReturningLocalCall(callee: ast2.Expr, ctx: Ref[egCtx]) -> Bool
  switch callee.Kind
    case IdentExpr(name) =>
      switch ctx.pkgInfo
        case Some(info) => switch localTupleFunctionReturn(info.TypedDecls, name, 0)
          case Some(found) => found
          case None => false
        end
        case None => false
      end
    case _ => false
  end
end

func localTupleFunctionReturn(decls: Slice[ast2.Decl], name: String, index: Int) -> Option[Bool]
  if index >= decls.Len() then Some(false) else
    switch decls.Get(index)
      case Some(decl) => switch decl
        case FuncDecl(fnName, _, _, ret, _, _) =>
          if fnName == name then
            switch ret
              case Some(retType) =>
                switch retType
                  case TupleType(items) => Some(items.Len() > 1)
                  case _ => Some(false)
                end
              case None => Some(false)
            end
          else
            localTupleFunctionReturn(decls, name, index + 1)
          end
        case _ => localTupleFunctionReturn(decls, name, index + 1)
      end
      case None => None
    end
  end
end

# `let (a, b) = go[(T, error)] {...}` lowers to `a, b := <inline go expr>`,
# bypassing the Result/Option boundary wrapping.
func translateInlineGoTupleLet(pattern: ast2.Pattern, body: String, values: Slice[ast2.GoOperand], types: Slice[ast2.GoTypeOperand], value: ast2.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  let parts = translateInlineOperands(values, types, ctx, 0, [] as Slice[String], [] as Slice[String], [] as Slice[String], [] as Slice[String], [] as Slice[goast.Stmt])
  switch parts
    case Err(msg) => Err(msg)
    case Ok(p) =>
      let raw = goast.MustInlineGoExprWithOperands(body, p.ValueNames, p.ValueSources, p.TypeNames, p.TypeSources)
      switch value.Type
        case None => Err("inline-Go tuple binding has no inferred result type")
        case Some(tupleMono) => translateRawTupleLet(pattern, tupleMono, raw, p.Pre, ctx)
      end
  end
end

# A tuple binding explicitly preserves Go's native multiple return values.
# It bypasses Option/Result boundary wrapping and emits `a, b := call()`.
func translateFFITupleLetStmt(pattern: ast2.Pattern, value: ast2.Expr, sig: typeinference2.GoFuncSignature, pkg: typeinference2.GoPackageEntry, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  if tuplePatternArity(pattern) != sig.Results.Len() then
    Err("tuple binding count does not match Go function result count")
  else
    switch value.Kind
      case CallExpr(callee, typeArgs, args) then
        let raw = translatePlainCallAstExpectedOrdinary(callee, typeArgs, args, ctx, ast2.MonoType.TUnit)
        switch raw
          case Err(msg) => Err(msg)
          case Ok(call) then
            # The raw multiple-return shape comes straight from the Go
            # signature; an unresolvable element type is a hard error rather
            # than a silent `any`.
            switch typeinference2.GoSignatureRawResultTypeWithPackage(sig, pkg)
              case Ok(resultTypes) => translateRawTupleLet(pattern, resultTypes, call.Expr, call.Pre, ctx)
              case Err(msg) => Err(msg)
            end
          end
        end
      end
      case _ => Err("Go multi-return tuple binding requires a call")
    end
  end
end

func translateAstTupleLetStmtOrdinary(pattern: ast2.Pattern, value: ast2.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  # `let (a, b) = expr` lowers to a single evaluation of `expr` followed
  # by per-name bindings to the corresponding `F<n>` field on the
  # resulting tuple.  Using one evaluation site guards against repeated
  # evaluation of side-effecting expressions; the temp also carries a
  # precise anonymous-struct type so each bound name is typed instead of
  # falling back to `interface{}`.
  switch value.Type
    case None => Err("tuple binding expression has no inferred result type")
    case Some(monoType) => translateAstTupleLetStmtOrdinaryWithType(pattern, value, tupleInnerType(monoType), ctx)
  end
end

func translateAstTupleLetStmtOrdinaryWithType(pattern: ast2.Pattern, value: ast2.Expr, tupleMono: ast2.MonoType, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  switch translateExprAst(value, ctx)
    case Err(msg) => Err(msg)
    case Ok(rv) then
      let tempName = ctxFreshExprTemp(ctx)
      let tempDecl = astSingleStmt(goast.VarDecl(tempName, monoTypeToGoAstWithParams(tupleMono, ctx.typeParamNames, ctx.pathAliases)))
      let tempAssign = astSingleStmt(goast.Assign(astSingleExpr(goast.Ident(tempName)), "=", astSingleExpr(rv.Expr)))
      let stmts = goast.AppendStmts(goast.AppendStmts(goast.AppendStmts(rv.Pre, tempDecl), tempAssign), [] as Slice[goast.Stmt])
      bindTupleLetPattern(pattern, tempName, tupleMono, ctx, stmts)
    end
  end
end

func translateRawTupleLet(pattern: ast2.Pattern, tupleType: ast2.MonoType, raw: goast.Expr, pre: Slice[goast.Stmt], ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  switch pattern
    case TuplePattern(items) =>
      switch rawTupleBindingNames(items, tupleType, ctx, 0, [] as Slice[goast.Expr])
        case Err(msg) => Err(msg)
        case Ok(names) then
          let assigned = goast.AppendStmts(pre, astSingleStmt(goast.Assign(names, ":=", astSingleExpr(raw))))
          bindNestedTuplePatternItems(items, tupleType, ctx, assigned, 0)
        end
      end
    case _ => Err("tuple binding requires a tuple pattern")
  end
end

func rawTupleBindingNames(items: Slice[ast2.Pattern], tupleType: ast2.MonoType, ctx: Ref[egCtx], index: Int, out: Slice[goast.Expr]) -> Result[Slice[goast.Expr], String]
  if index >= items.Len() then Ok(out) else
    switch items.Get(index)
      case None => Err("malformed tuple pattern: missing item")
      case Some(pattern) => rawTupleBindingNameAt(items, tupleType, ctx, index, out, pattern)
    end
  end
end

func rawTupleBindingNameAt(items: Slice[ast2.Pattern], tupleType: ast2.MonoType, ctx: Ref[egCtx], index: Int, out: Slice[goast.Expr], pattern: ast2.Pattern) -> Result[Slice[goast.Expr], String]
  switch tupleElementType(tupleType, index)
    case None => Err("tuple pattern index has no inferred element type")
    case Some(typ) => rawTupleBindingNameWithType(items, tupleType, ctx, index, out, pattern, typ)
  end
end

func rawTupleBindingNameWithType(items: Slice[ast2.Pattern], tupleType: ast2.MonoType, ctx: Ref[egCtx], index: Int, out: Slice[goast.Expr], pattern: ast2.Pattern, typ: ast2.MonoType) -> Result[Slice[goast.Expr], String]
  switch pattern
    case BindPattern(name) then
      let goName = ctxFreshBinding(ctx, name)
      ctxSetLocal(ctx, name, typ)
      rawTupleBindingNames(items, tupleType, ctx, index + 1, out.Append(goast.Ident(goName)))
    end
    case WildcardPattern => rawTupleBindingNames(items, tupleType, ctx, index + 1, out.Append(goast.Ident("_")))
    case _ => rawTupleBindingNames(items, tupleType, ctx, index + 1, out.Append(goast.Ident(rawTupleTempName(index))))
  end
end

func bindNestedTuplePatternItems(items: Slice[ast2.Pattern], tupleType: ast2.MonoType, ctx: Ref[egCtx], stmts: Slice[goast.Stmt], index: Int) -> Result[Slice[goast.Stmt], String]
  if index >= items.Len() then Ok(stmts) else
    switch items.Get(index)
      case None => Err("malformed tuple pattern: missing item")
      case Some(pattern) then
        switch pattern
          case TuplePattern(_) then
            let tempName = rawTupleTempName(index)
            switch tupleElementType(tupleType, index)
              case None => Err("nested tuple pattern index has no inferred element type")
              case Some(innerType) then
                let nested = bindTupleLetPattern(pattern, tempName, innerType, ctx, stmts)
                switch nested
                  case Err(msg) => Err(msg)
                  case Ok(nestedStmts) => bindNestedTuplePatternItems(items, tupleType, ctx, nestedStmts, index + 1)
                end
              end
            end
          end
          case _ => bindNestedTuplePatternItems(items, tupleType, ctx, stmts, index + 1)
        end
      end
    end
  end
end

func rawTupleTempName(index: Int) -> String
  "__mygo_tuple_raw_" + index.ToString()
end

func tuplePatternArity(pattern: ast2.Pattern) -> Int
  switch pattern
    case TuplePattern(items) => items.Len()
    case _ => 0
  end
end

func bindTupleLetPattern(pattern: ast2.Pattern, valueName: String, tupleType: ast2.MonoType, ctx: Ref[egCtx], stmts: Slice[goast.Stmt]) -> Result[Slice[goast.Stmt], String]
  switch pattern
    case TuplePattern(items) => bindTupleLetPatternItems(items, valueName, tupleType, ctx, stmts, 0)
    case BindPattern(name) => Ok(bindTupleLetPatternName(name, valueName, tupleType, ctx, stmts))
    case _ => Ok(stmts)
  end
end

func bindTupleLetPatternItems(items: Slice[ast2.Pattern], valueName: String, tupleType: ast2.MonoType, ctx: Ref[egCtx], stmts: Slice[goast.Stmt], index: Int) -> Result[Slice[goast.Stmt], String]
  if index >= items.Len() then Ok(stmts) else
    switch items.Get(index)
      case None => Err("malformed tuple pattern: missing item")
      case Some(pattern) => bindTupleLetPatternItem(items, valueName, tupleType, ctx, stmts, index, pattern)
    end
  end
end

func bindTupleLetPatternItem(items: Slice[ast2.Pattern], valueName: String, tupleType: ast2.MonoType, ctx: Ref[egCtx], stmts: Slice[goast.Stmt], index: Int, pattern: ast2.Pattern) -> Result[Slice[goast.Stmt], String]
  switch tupleElementType(tupleType, index)
    case None => Err("tuple pattern index has no inferred element type")
    case Some(fieldType) => bindTupleLetPatternItemWithType(items, valueName, tupleType, ctx, stmts, index, pattern, fieldType)
  end
end

func bindTupleLetPatternItemWithType(items: Slice[ast2.Pattern], valueName: String, tupleType: ast2.MonoType, ctx: Ref[egCtx], stmts: Slice[goast.Stmt], index: Int, pattern: ast2.Pattern, fieldType: ast2.MonoType) -> Result[Slice[goast.Stmt], String]
  let fieldName = "F" + index.ToString()
  switch pattern
    case BindPattern(name) => bindTupleLetPatternItems(items, valueName, tupleType, ctx, bindTupleLetPatternFieldName(name, valueName, fieldName, fieldType, ctx, stmts), index + 1)
    case TuplePattern(_) =>
      let tempName = ctxFreshExprTemp(ctx)
      let decl = astSingleStmt(goast.VarDecl(tempName, monoTypeToGoAstWithParams(fieldType, ctx.typeParamNames, ctx.pathAliases)))
      let assignStmt = astSingleStmt(goast.Assign(astSingleExpr(goast.Ident(tempName)), "=", astSingleExpr(goast.Selector(goast.Ident(valueName), fieldName))))
      switch bindTupleLetPattern(pattern, tempName, fieldType, ctx, goast.AppendStmts(goast.AppendStmts(stmts, decl), assignStmt))
        case Err(msg) => Err(msg)
        case Ok(nextStmts) => bindTupleLetPatternItems(items, valueName, tupleType, ctx, nextStmts, index + 1)
      end
    case _ => bindTupleLetPatternItems(items, valueName, tupleType, ctx, stmts, index + 1)
  end
end

func bindTupleLetPatternName(name: String, valueName: String, typ: ast2.MonoType, ctx: Ref[egCtx], stmts: Slice[goast.Stmt]) -> Slice[goast.Stmt]
  let goName = ctxFreshBinding(ctx, name)
  let decl = astSingleStmt(goast.VarDecl(goName, monoTypeToGoAstWithParams(typ, ctx.typeParamNames, ctx.pathAliases)))
  let source = goast.Ident(valueName)
  ctxSetLocal(ctx, name, typ)
  goast.AppendStmts(goast.AppendStmts(stmts, decl), astSingleStmt(goast.Assign(astSingleExpr(goast.Ident(goName)), "=", astSingleExpr(source))))
end

func bindTupleLetPatternFieldName(name: String, valueName: String, fieldName: String, typ: ast2.MonoType, ctx: Ref[egCtx], stmts: Slice[goast.Stmt]) -> Slice[goast.Stmt]
  let goName = ctxFreshBinding(ctx, name)
  let decl = astSingleStmt(goast.VarDecl(goName, monoTypeToGoAstWithParams(typ, ctx.typeParamNames, ctx.pathAliases)))
  let source = goast.Selector(goast.Ident(valueName), fieldName)
  ctxSetLocal(ctx, name, typ)
  goast.AppendStmts(goast.AppendStmts(stmts, decl), astSingleStmt(goast.Assign(astSingleExpr(goast.Ident(goName)), "=", astSingleExpr(source))))
end

# Strip one layer of Slice / TApp(Slice, ...) to recover the tuple type
# that the let expression produces.  Falls back to the input type when
# the source expression is not a slice-of-tuple, so other destructuring
# call sites still type-check.
func tupleInnerType(t: ast2.MonoType) -> ast2.MonoType
  switch t
    case TApp(ctor, args) then
      let ctorStr = ctor.value()
      switch ctorStr
        case TCon(name) then
          if name == "Slice" && args.Len() == 1 then
            switch args.Get(0)
              case Some(inner) => inner
              case None => t
            end
          else t end
        end
        case _ => t
      end
    end
    case _ => t
  end
end

func tupleElementType(t: ast2.MonoType, index: Int) -> Option[ast2.MonoType]
  switch t
    case TTuple(items) => items.Get(index)
    case _ => None
  end
end

# Lower letrec in two passes: typed Go vars first, then their initializers.
# The first pass installs every source binding in ctx, so each initializer can
# refer to itself and to every other binding in the group.
func translateAstLetRec(bindings: Slice[ast2.LetRecBind], ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  let declared = declareAstLetRec(bindings, ctx, 0, [] as Slice[goast.Stmt])
  switch declared
    case Err(msg) => Err(msg)
    case Ok(vars) => initializeAstLetRec(bindings, ctx, 0, vars)
  end
end

func declareAstLetRec(bindings: Slice[ast2.LetRecBind], ctx: Ref[egCtx], index: Int, out: Slice[goast.Stmt]) -> Result[Slice[goast.Stmt], String]
  if index >= bindings.Len() then
    Ok(out)
  else
    switch bindings.Get(index)
      case None => Err("malformed letrec statement: missing binding")
      case Some(binding) => declareAstLetRecBinding(bindings, binding, ctx, index, out)
    end
  end
end

func declareAstLetRecBinding(bindings: Slice[ast2.LetRecBind], binding: ast2.LetRecBind, ctx: Ref[egCtx], index: Int, out: Slice[goast.Stmt]) -> Result[Slice[goast.Stmt], String]
  let name = ctxFreshBinding(ctx, binding.Name)
  ctxSetLocal(ctx, binding.Name, typeinference2.TypeFromAST(binding.Type))
  ctxSetMutable(ctx, name, false)
  declareAstLetRec(bindings, ctx, index + 1, goast.AppendStmts(out, astSingleStmt(goast.VarDecl(name, goTypeAst(binding.Type, ctx.typeParams)))) )
end

func initializeAstLetRec(bindings: Slice[ast2.LetRecBind], ctx: Ref[egCtx], index: Int, out: Slice[goast.Stmt]) -> Result[Slice[goast.Stmt], String]
  if index >= bindings.Len() then
    Ok(out)
  else
    switch bindings.Get(index)
      case None => Err("malformed letrec statement: missing binding")
      case Some(binding) => initializeAstLetRecBinding(bindings, binding, ctx, index, out)
    end
  end
end

func initializeAstLetRecBinding(bindings: Slice[ast2.LetRecBind], binding: ast2.LetRecBind, ctx: Ref[egCtx], index: Int, out: Slice[goast.Stmt]) -> Result[Slice[goast.Stmt], String]
  switch translateAstBindingValue(binding.Value, Some(binding.Type), ctx)
    case Err(msg) => Err(msg)
    case Ok(value) then
      let name = switch ctxGetBinding(ctx, binding.Name)
        case Some(found) => found
        case None => binding.Name
      end
      let assign = goast.Assign(astSingleExpr(goast.Ident(name)), "=", astSingleExpr(value.Expr))
      initializeAstLetRec(bindings, ctx, index + 1, goast.AppendStmts(goast.AppendStmts(out, value.Pre), astSingleStmt(assign)))
    end
  end
end

func translateAstWhileStmt(cond: ast2.Expr, body: ast2.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  let c = translateExprAst(cond, ctx)
  switch c
    case Err(msg) => Err(msg)
    case Ok(cv) =>
      let b = translateAstLoopBody(body, ctx)
      switch b
        case Err(msg) => Err(msg)
        case Ok(stmts) => Ok(goast.AppendStmts(cv.Pre, astSingleStmt(goast.For(cv.Expr, stmts))))
      end
  end
end

func translateAstLoopBody(body: ast2.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  switch body.Kind
    case BlockExpr(items) => translateAstLoopItems(items, ctx, 0, [] as Slice[goast.Stmt])
    case _ =>
      let value = translateExprAst(body, ctx)
      switch value
        case Ok(v) => Ok(goast.AppendStmts(v.Pre, astSingleStmt(goast.ExpressionStmt(v.Expr))))
        case Err(msg) => Err(msg)
      end
  end
end

func translateAstLoopItems(items: Slice[ast2.Stmt], ctx: Ref[egCtx], index: Int, out: Slice[goast.Stmt]) -> Result[Slice[goast.Stmt], String]
  if index >= items.Len() then
    Ok(out)
  else
    switch items.Get(index)
      case None => Err("malformed loop block: missing statement")
      case Some(stmt) then
        let lowered = translateAstLoopStmt(stmt, ctx)
        switch lowered
          case Ok(stmts) => translateAstLoopItems(items, ctx, index + 1, goast.AppendStmts(out, stmts))
          case Err(msg) => Err(msg)
        end
      end
    end
  end
end

func translateAstLoopStmt(stmt: ast2.Stmt, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  switch stmt
    case ExprStmt(expr) =>
      switch expr.Kind
        case IfExpr(cond, thenExpr, elseExpr) => translateAstIfStmt(cond, thenExpr, elseExpr, ctx)
        case _ => translateAstLeadingStmt(stmt, ctx)
      end
    case _ => translateAstLeadingStmt(stmt, ctx)
  end
end

# translateAstIfStmt lowers an if-expression as a statement (no return wrapping).
# This mirrors the legacy codegen's translateWhileStmt which emits plain if/else
# Go blocks instead of IIFE-based expression lowering.
func translateAstIfStmt(cond: ast2.Expr, thenExpr: ast2.Expr, elseExpr: ast2.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  let c = translateExprAst(cond, ctx)
  switch c
    case Err(msg) => Err(msg)
    case Ok(cv) =>
      let t = translateAstIfStmtBranch(thenExpr, ctx)
      switch t
        case Err(msg) => Err(msg)
        case Ok(tv) =>
          let e = translateAstIfStmtBranch(elseExpr, ctx)
          switch e
            case Err(msg) => Err(msg)
            case Ok(ev) =>
              if ev.Len() == 0 then
                Ok(goast.AppendStmts(cv.Pre, astSingleStmt(goast.If(cv.Expr, tv, ev))))
              else
                Ok(goast.AppendStmts(cv.Pre, astSingleStmt(goast.If(cv.Expr, tv, ev))))
              end
          end
      end
  end
end

func translateAstIfStmtBranch(expr: ast2.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  switch expr.Kind
    case BlockExpr(items) => translateAstBlockAsStmts(items, ctx, 0, [] as Slice[goast.Stmt])
    case UnitExpr =>
      let empty: Slice[goast.Stmt] = []
      Ok(empty)
    case IfExpr(cond, thenExpr, elseExpr) => translateAstIfStmt(cond, thenExpr, elseExpr, ctx)
    case _ =>
      let value = translateExprAst(expr, ctx)
      switch value
        case Ok(v) =>
          if goast.IsUnitExpr(v.Expr) then
            Ok(v.Pre)
          else
            Ok(goast.AppendStmts(v.Pre, astSingleStmt(goast.ExpressionStmt(v.Expr))))
          end
        case Err(msg) => Err(msg)
      end
  end
end

# translateAstBlockAsStmts translates a block of statements without adding a
# trailing return — intended for if/else branches inside loop bodies.
func translateAstBlockAsStmts(items: Slice[ast2.Stmt], ctx: Ref[egCtx], index: Int, out: Slice[goast.Stmt]) -> Result[Slice[goast.Stmt], String]
  if items.Len() == 0 then
    Ok(out)
  else
    switch items.Get(index)
      case None => Err("malformed block: missing statement")
      case Some(stmt) => translateAstBlockStatement(items, stmt, ctx, index, out)
    end
  end
end

func translateAstBlockStatement(items: Slice[ast2.Stmt], stmt: ast2.Stmt, ctx: Ref[egCtx], index: Int, out: Slice[goast.Stmt]) -> Result[Slice[goast.Stmt], String]
  if index == items.Len() - 1 then
    switch stmt
      case ExprStmt(expr) => translateAstBlockFinalExpr(expr, ctx, out)
      case ReturnStmt => Ok(goast.AppendStmts(out, astSingleStmt(goast.Return([] as Slice[goast.Expr]))))
      case ReturnWithStmt(value) then
        switch translateExprAstExpected(value, ctx, ast2.MonoType.TUnit)
          case Ok(v) => Ok(goast.AppendStmts(goast.AppendStmts(out, v.Pre), astSingleStmt(goast.Return(astSingleExpr(v.Expr)))))
          case Err(msg) => Err(msg)
        end
      end
      case _ then
        switch translateAstLeadingStmt(stmt, ctx)
          case Ok(stmts) => Ok(goast.AppendStmts(out, stmts))
          case Err(msg) => Err(msg)
        end
      end
    end
  else
    switch translateAstLeadingStmt(stmt, ctx)
      case Ok(stmts) => translateAstBlockAsStmts(items, ctx, index + 1, goast.AppendStmts(out, stmts))
      case Err(msg) => Err(msg)
    end
  end
end

func translateAstBlockFinalExpr(expr: ast2.Expr, ctx: Ref[egCtx], out: Slice[goast.Stmt]) -> Result[Slice[goast.Stmt], String]
  switch expr.Kind
    case IfExpr(cond, thenExpr, elseExpr) =>
      switch translateAstIfStmt(cond, thenExpr, elseExpr, ctx)
        case Ok(stmts) => Ok(goast.AppendStmts(out, stmts))
        case Err(msg) => Err(msg)
      end
    case SwitchExpr(target, cases, targetType) =>
      switch translateSwitchAstWithTargetType(target, cases, targetType, ctx, ast2.MonoType.TUnit)
        case Ok(v) => Ok(goast.AppendStmts(out, v.Pre))
        case Err(msg) => Err(msg)
      end
    case _ =>
      switch translateExprAst(expr, ctx)
        case Ok(v) =>
          if goast.IsUnitExpr(v.Expr) then
            Ok(goast.AppendStmts(out, v.Pre))
          else
            Ok(goast.AppendStmts(goast.AppendStmts(out, v.Pre), astSingleStmt(goast.ExpressionStmt(v.Expr))))
          end
        case Err(msg) => Err(msg)
      end
  end
end

func translateAstBinding(bind: ast2.Bind, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  if bind.Name == "_" then
    switch translateDiscardBindingValue(bind.Value, ctx)
      case Ok(d) => Ok(goast.AppendStmts(d.Pre, astSingleStmt(goast.ExpressionStmt(d.Expr))))
      case Err(msg) => Err(msg)
    end
  else
    let value = translateAstBindingValue(bind.Value, bind.Type, ctx)
    switch value
      case Err(msg) => Err(msg)
      case Ok(v) =>
        let monoType = switch bind.Type
          case Some(t) => Some(typeinference2.TypeFromAST(t))
          case None => inferredBindingMonoType(bind, ctx)
        end
        switch monoType
          case Some(t) => ctxSetLocal(ctx, bind.Name, t)
          case None => ()
        end
        let name = ctxFreshBinding(ctx, bind.Name)
        switch bind.Type
          case Some(t) then
            let decl = goast.Var(name, goast.MustTypeExpr(monoTypeToGoStrIn(typeinference2.TypeFromAST(t), ctx.pathAliases)), v.Expr)
            Ok(goast.AppendStmts(v.Pre, astSingleStmt(decl)))
          end
          case None then
            let decl = goast.Define(name, v.Expr)
            Ok(goast.AppendStmts(v.Pre, astSingleStmt(decl)))
          end
        end
    end
  end
end

# Go permits a call statement to discard every return value. Do that directly
# for FFI calls returning `(value, error)` or `(value, bool)`: lowering them
# through Result/Option first would leave a non-call `Result` expression
# statement, which Go rejects as an unused value.
func translateDiscardBindingValue(value: ast2.Expr, ctx: Ref[egCtx]) -> Result[AstExprResult, String]
  switch value.Kind
    case CallExpr(callee, typeArgs, args) then
      switch ffiOptionSignature(callee, ctx)
        case Some(_) => translatePlainCallAstExpectedOrdinary(callee, typeArgs, args, ctx, ast2.MonoType.TUnit)
        case None =>
          switch ffiResultSignature(callee, ctx)
            case Some(_) => translatePlainCallAstExpectedOrdinary(callee, typeArgs, args, ctx, ast2.MonoType.TUnit)
            case None => translateExprAst(value, ctx)
          end
      end
    end
    case _ => translateExprAst(value, ctx)
  end
end

# The inferred type of a `let` binding.  Most expressions carry their
# monotype on the AST node.  A Go-FFI struct literal (`http.Server { ... }`)
# is synthesized from its dotted source spelling (see structLitBindingType):
# inference leaves it untyped in some pipelines, and where a monotype is
# attached it is a bare TCon that method dispatch cannot resolve, so the
# qualified spelling is always preferred for struct literals.  Non-struct
# bindings use their AST-carried monotype as before.
func inferredBindingMonoType(bind: ast2.Bind, ctx: Ref[egCtx]) -> Option[ast2.MonoType]
  switch bind.Value.Kind
    case StructLitExpr(typeName, _) => structLitBindingType(typeName, ctx)
    case GenericStructLitExpr(typeName, _, _) => structLitBindingType(typeName, ctx)
    case _ => bind.Value.Type
  end
end

# A local bound from a Go-FFI struct literal had no recorded MonoType, so
# method calls on it (for example `srv.ListenAndServe()` where
# `let srv = http.Server { ... }`) could not resolve against the Go FFI method
# table and the error-bearing FFI boundary wrap was skipped.  Synthesize a
# TQualifiedName from the alias and member of the dotted source spelling,
# keyed by the canonical import path so GoSignatureInPackages and
# GoMethodSignatureInPackages can find the owning package.  Non-Go aliases
# (MyGO imports, local types) keep their previous untyped behavior.
func structLitBindingType(typeName: String, ctx: Ref[egCtx]) -> Option[ast2.MonoType]
  let parts = strings.Split(typeName, ".")
  if parts.Len() == 2 then
    switch (parts.Get(0), parts.Get(1))
      case (Some(alias), Some(member)) =>
        let path = goPackagePathForAlias(alias, ctx.goPackages, 0)
        if path == "" then None else Some(ast2.MonoType.TQualifiedName(path, Ref.new(ast2.MonoType.TCon(member)))) end
      case _ => None
    end
  else
    None
  end
end

func goPackagePathForAlias(alias: String, pkgs: Slice[typeinference2.GoPackageEntry], index: Int) -> String
  if index >= pkgs.Len() then
    ""
  else
    switch pkgs.Get(index)
      case Some(p) => if p.Alias == alias then p.Path else goPackagePathForAlias(alias, pkgs, index + 1) end
      case None => goPackagePathForAlias(alias, pkgs, index + 1)
    end
  end
end

func extractLetBindingType(expr: ast2.Expr) -> Option[ast2.TypeExpr]
  switch expr.Kind
    case InlineGoExpr(typ, _, _, _) => Some(typ.value())
    case TypeAsExpr(_, typ) => Some(typ)
    case _ => None
  end
end

func translateAstBindingValue(expr: ast2.Expr, typ: Option[ast2.TypeExpr], ctx: Ref[egCtx]) -> Result[AstExprResult, String]
  switch typ
    case Some(t) => translateAstBindingValueWithExpected(expr, typeinference2.TypeFromAST(t), ctx)
    case None =>
      switch expr.Type
        case None => Err("let binding has no inferred type")
        case Some(expected) => translateAstBindingValueWithExpected(expr, expected, ctx)
      end
  end
end

func translateAstBindingValueWithExpected(expr: ast2.Expr, expected: ast2.MonoType, ctx: Ref[egCtx]) -> Result[AstExprResult, String]
  switch expr.Kind
    case IfExpr(cond, thenExpr, elseExpr) => translateIfAst(cond, thenExpr, elseExpr, ctx, expected)
    case _ => translateExprAstExpected(expr, ctx, expected)
  end
end

func translateAstReturnStmt(stmt: ast2.Stmt, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  switch stmt
    case ExprStmt(expr) => translateAstReturnExpr(expr, ctx)
    case ReturnStmt => Ok(astSingleStmt(goast.Return([] as Slice[goast.Expr])))
    case ReturnWithStmt(expr) =>
      # An explicit `return F(...)` to a planned member is a tail call: it must
      # become the state/continue sequence rather than a stack-growing call.
      if isMtTailCall(expr, ctx) then
        mtTailCallAst(expr, ctx)
      else
        translateAstReturnValue(expr, ctx)
      end
        case _ =>
          # Statement-only blocks have unit as their implicit final value.
          let stmts = translateAstLeadingStmt(stmt, ctx)
          switch stmts
            case Err(msg) => Err(msg)
            case Ok(v) =>
              switch ctx.retType
                case TUnit => Ok(goast.AppendStmts(v, astSingleStmt(goast.Return([] as Slice[goast.Expr]))))
                case _ => Ok(v)
              end
          end
  end
end

func translateAstReturnExpr(expr: ast2.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  switch expr.Kind
    case InlineGoExpr(typ, body, values, types) =>
      # A tuple-typed inline Go block is decoded into Result/Option at the
      # boundary (writeOneMessage pattern).  Route it through the value path
      # so translateInlineGoBoundary emits the Ok/Err or Some/None lowering.
      switch inlineGoBoundaryKind(typ.value(), ctx.retType)
        case Some(_) => translateAstReturnValue(expr, ctx)
        case None =>
          let parts = translateInlineOperands(values, types, ctx, 0, [] as Slice[String], [] as Slice[String], [] as Slice[String], [] as Slice[String], [] as Slice[goast.Stmt])
          switch parts
            case Err(msg) => Err(msg)
            case Ok(p) =>
              # For unit-returning inline Go expressions, use statement form
              # (no "return" wrapper) to avoid "no value used as value" errors.
              if isUnitType(typ.value()) then
                Ok(goast.AppendStmts(p.Pre, goast.MustInlineGoStatementsWithOperands(body, p.ValueNames, p.ValueSources, p.TypeNames, p.TypeSources)))
              else
                Ok(goast.AppendStmts(p.Pre, goast.MustInlineGoFinalStatementsWithOperands(body, p.ValueNames, p.ValueSources, p.TypeNames, p.TypeSources)))
              end
          end
      end
    case IfExpr(cond, thenExpr, elseExpr) => translateAstReturnIf(cond, thenExpr, elseExpr, ctx)
    case BlockExpr(items) => translateAstReturnBlock(items, ctx, 0, [] as Slice[goast.Stmt])
    case SwitchExpr(target, cases, targetType) =>
      # A tuple-returning top-level function needs `return left, right`, not a
      # return of the anonymous tuple value used by expression-position switch
      # lowering. Mutual-tail trampolines always use the tail-aware path so
      # member calls can be rewritten into state transitions.
      switch ctx.mtPlan
        case Some(_) =>
          switch ctx.retType
            case TUnit => translateAstReturnValue(expr, ctx)
            case _ => translateAstReturnSwitch(target, cases, targetType, ctx)
          end
        case None =>
          if returnsMultipleValues(ctx.retType) then
            translateAstReturnSwitch(target, cases, targetType, ctx)
          else
            translateAstReturnValue(expr, ctx)
          end
      end
    case _ =>
      if isMtTailCall(expr, ctx) then
        mtTailCallAst(expr, ctx)
      else
        if isTailSelfCall(expr, ctx) then
          tailCallAst(expr, ctx)
        else
          translateAstReturnValue(expr, ctx)
        end
      end
  end
end

func returnsMultipleValues(typ: ast2.MonoType) -> Bool
  switch typ
    case TTuple(items) => items.Len() > 1
    case _ => false
  end
end

func translateAstReturnBlock(items: Slice[ast2.Stmt], ctx: Ref[egCtx], index: Int, out: Slice[goast.Stmt]) -> Result[Slice[goast.Stmt], String]
  if index >= items.Len() then
    Ok(out)
  else
    switch items.Get(index)
      case None => Err("malformed return block: missing statement")
      case Some(stmt) => translateAstReturnStatement(items, stmt, ctx, index, out)
    end
  end
end

func translateAstReturnStatement(items: Slice[ast2.Stmt], stmt: ast2.Stmt, ctx: Ref[egCtx], index: Int, out: Slice[goast.Stmt]) -> Result[Slice[goast.Stmt], String]
  if index == items.Len() - 1 then
    switch stmt
      case ExprStmt(value) =>
        switch translateAstReturnExpr(value, ctx)
          case Ok(stmts) => Ok(goast.AppendStmts(out, stmts))
          case Err(msg) => Err(msg)
        end
      case ReturnStmt => Ok(goast.AppendStmts(out, astSingleStmt(goast.Return([] as Slice[goast.Expr]))))
      case ReturnWithStmt(value) =>
        let ret = if isMtTailCall(value, ctx) then mtTailCallAst(value, ctx) else translateAstReturnValue(value, ctx) end
        switch ret
          case Ok(stmts) => Ok(goast.AppendStmts(out, stmts))
          case Err(msg) => Err(msg)
        end
      case _ => Err("block expression ends with a non-value statement")
    end
  else
    switch translateAstLeadingStmt(stmt, ctx)
      case Ok(stmts) => translateAstReturnBlock(items, ctx, index + 1, goast.AppendStmts(out, stmts))
      case Err(msg) => Err(msg)
    end
  end
end

func translateInlineGoAst(body: String, values: Slice[ast2.GoOperand], types: Slice[ast2.GoTypeOperand], ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  let parts = translateInlineOperands(values, types, ctx, 0, [] as Slice[String], [] as Slice[String], [] as Slice[String], [] as Slice[String], [] as Slice[goast.Stmt])
  switch parts
    case Err(msg) => Err(msg)
    case Ok(p) => Ok(goast.AppendStmts(p.Pre, goast.MustInlineGoStatementsWithOperands(body, p.ValueNames, p.ValueSources, p.TypeNames, p.TypeSources)))
  end
end

func translateInlineOperands(values: Slice[ast2.GoOperand], types: Slice[ast2.GoTypeOperand], ctx: Ref[egCtx], index: Int, valueNames: Slice[String], valueSources: Slice[String], typeNames: Slice[String], typeSources: Slice[String], pre: Slice[goast.Stmt]) -> Result[AstInlineOperands, String]
  if index < values.Len() then
    switch values.Get(index)
      case None => Err("malformed inline-Go expression: missing value operand")
      case Some(operand) => translateInlineValueOperand(values, types, ctx, index, valueNames, valueSources, typeNames, typeSources, pre, operand)
    end
  elsif index - values.Len() < types.Len() then
    switch types.Get(index - values.Len())
      case None => Err("malformed inline-Go expression: missing type operand")
      case Some(operand) => translateInlineTypeOperand(values, types, ctx, index, valueNames, valueSources, typeNames, typeSources, pre, operand)
    end
  else
    Ok(AstInlineOperands { ValueNames: valueNames, ValueSources: valueSources, TypeNames: typeNames, TypeSources: typeSources, Pre: pre })
  end
end

func translateInlineValueOperand(values: Slice[ast2.GoOperand], types: Slice[ast2.GoTypeOperand], ctx: Ref[egCtx], index: Int, valueNames: Slice[String], valueSources: Slice[String], typeNames: Slice[String], typeSources: Slice[String], pre: Slice[goast.Stmt], operand: ast2.GoOperand) -> Result[AstInlineOperands, String]
  switch translateExprAst(operand.Value, ctx)
    case Err(msg) => Err(msg)
    case Ok(value) => translateInlineOperands(values, types, ctx, index + 1, valueNames.Append(operand.Name), valueSources.Append(goast.MustExprSource(value.Expr)), typeNames, typeSources, goast.AppendStmts(pre, value.Pre))
  end
end

func translateInlineTypeOperand(values: Slice[ast2.GoOperand], types: Slice[ast2.GoTypeOperand], ctx: Ref[egCtx], index: Int, valueNames: Slice[String], valueSources: Slice[String], typeNames: Slice[String], typeSources: Slice[String], pre: Slice[goast.Stmt], operand: ast2.GoTypeOperand) -> Result[AstInlineOperands, String]
  translateInlineOperands(values, types, ctx, index + 1, valueNames, valueSources, typeNames.Append(operand.Name), typeSources.Append(goType(operand.Type, ctx.typeParams)), pre)
end

func translateAstReturnIf(cond: ast2.Expr, thenExpr: ast2.Expr, elseExpr: ast2.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  let c = translateExprAst(cond, ctx)
  let t = translateAstBranchReturn(thenExpr, ctx)
  let e = translateAstBranchReturn(elseExpr, ctx)
  switch c
    case Err(msg) => Err(msg)
    case Ok(cv) =>
      switch t
        case Err(msg) => Err(msg)
        case Ok(tv) =>
          switch e
            case Err(msg) => Err(msg)
            case Ok(ev) => Ok(goast.AppendStmts(cv.Pre, astSingleStmt(goast.If(cv.Expr, tv, ev))))
          end
      end
  end
end

func translateAstBranchReturn(expr: ast2.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  switch expr.Kind
    case BlockExpr(items) => translateAstBlock(items, ctx, 0, [] as Slice[goast.Stmt])
    case _ => translateAstReturnExpr(expr, ctx)
  end
end

func translateAstReturnValue(expr: ast2.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  switch expr.Kind
    case TupleExpr(items) =>
      let expectedTypes = switch ctx.retType
        case TTuple(elems) => elems
        case _ => ctx.retTypes
      end
      let values = translateAstArgs(items, ctx, 0, [] as Slice[goast.Expr], [] as Slice[goast.Stmt], expectedTypes)
      switch values
        case Err(msg) => Err(msg)
        case Ok(v) =>
          switch ctx.retType
            case TUnit => Ok(goast.AppendStmts(v.Pre, astSingleStmt(goast.Return([] as Slice[goast.Expr]))))
            case _ =>
              # Function literals passed as values (e.g. a PMap callback) must
              # return a single anonymous struct for a tuple result instead of
              # Go multi-values; top-level functions keep the multi-value form.
              if ctx.tupleReturnStruct then
                let structType = monoTypeToGoStrWithParamsIn(ctx.retType, ctx.typeParamNames, ctx.pathAliases)
                switch wrapExprsAsStructFields(v.Exprs, 0, [] as Slice[goast.Expr])
                  case Err(msg) => Err(msg)
                  case Ok(keyed) => Ok(goast.AppendStmts(v.Pre, astSingleStmt(goast.Return(astSingleExpr(goast.Composite(goast.MustTypeExpr(structType), keyed))))))
                end
              else
                Ok(goast.AppendStmts(v.Pre, astSingleStmt(goast.Return(v.Exprs))))
              end
          end
      end
    case UnitExpr =>
      Ok(astSingleStmt(goast.Return([] as Slice[goast.Expr])))
    case IdentExpr(name) =>
      # Bare None is a generic zero-argument constructor.  Handle it at the
      # return boundary as well as expression lowering so impl methods retain
      # their declared Option[A] return context.
      let inner = noneTypeArg(ctx.retType, ctx)
      if name == "None" && inner != "" then
        Ok(astSingleStmt(goast.Return(astSingleExpr(goast.GenericCall(goast.Ident("None"), [inner], [] as Slice[goast.Expr])))))
      else
        translateAstReturnSingle(expr, ctx)
      end
    case NumberExpr(_) => translateAstReturnSingle(expr, ctx)
    case StringExpr(_) => translateAstReturnSingle(expr, ctx)
    case RuneExpr(_) => translateAstReturnSingle(expr, ctx)
    case SliceLitExpr(_) => translateAstReturnSingle(expr, ctx)
    case TypeAsExpr(_, _) => translateAstReturnSingle(expr, ctx)
    case BoolExpr(_) => translateAstReturnSingle(expr, ctx)
    case CallExpr(_, _, _) => translateAstReturnSingle(expr, ctx)
    case DictionaryCallExpr(_, _, _) => translateAstReturnSingle(expr, ctx)
    case FieldExpr(_, _) => translateAstReturnSingle(expr, ctx)
    case UnaryExpr(_, _) => translateAstReturnSingle(expr, ctx)
    case BinaryExpr(_, _, _) => translateAstReturnSingle(expr, ctx)
    case IfExpr(_, _, _) => translateAstReturnSingle(expr, ctx)
    case SwitchExpr(_, _, _) => translateAstReturnSingle(expr, ctx)
    case BlockExpr(_) => translateAstReturnSingle(expr, ctx)
    case StructLitExpr(_, _) => translateAstReturnSingle(expr, ctx)
    case GenericStructLitExpr(_, _, _) => translateAstReturnSingle(expr, ctx)
    # A function type alias can make a function literal the direct result of
    # a declaration (rather than a field within a struct literal).  It is an
    # ordinary single-value return, and translateExprAstExpected already
    # lowers its body through translateFuncLitAst.
    case FuncLitExpr(_, _, _) => translateAstReturnSingle(expr, ctx)
    case InlineGoExpr(_, _, _, _) => translateAstReturnSingle(expr, ctx)
    case MapLitExpr(_) => translateAstReturnSingle(expr, ctx)
    case SetLitExpr(_) => translateAstReturnSingle(expr, ctx)
  end
end

func translateAstReturnSingle(expr: ast2.Expr, ctx: Ref[egCtx]) -> Result[Slice[goast.Stmt], String]
  let value = translateExprAstExpected(expr, ctx, ctx.retType)
  switch value
    case Err(msg) => Err(msg)
    case Ok(v) =>
      switch ctx.retType
        case TUnit =>
          # In a unit-returning function the expression value is discarded.
          # Skip ExpressionStmt for Unit expressions to avoid "not used".
          # Use structural check via goast.IsUnitExpr instead of just expr.Kind
          # because switch/if/block lowering also produces Unit() as v.Expr.
          if goast.IsUnitExpr(v.Expr) then
            Ok(goast.AppendStmts(v.Pre, astSingleStmt(goast.Return([] as Slice[goast.Expr]))))
          else
            Ok(goast.AppendStmts(v.Pre, astTwoStmts(goast.ExpressionStmt(v.Expr), goast.Return([] as Slice[goast.Expr]))))
          end
        case _ =>
          Ok(goast.AppendStmts(v.Pre, astSingleStmt(goast.Return(astSingleExpr(v.Expr)))))
      end
  end
end

func astSingleExpr(expr: goast.Expr) -> Slice[goast.Expr]
  ([] as Slice[goast.Expr]).Append(expr)
end

func astSingleStmt(stmt: goast.Stmt) -> Slice[goast.Stmt]
  ([] as Slice[goast.Stmt]).Append(stmt)
end

func astTwoStmts(first: goast.Stmt, second: goast.Stmt) -> Slice[goast.Stmt]
  ([] as Slice[goast.Stmt]).Append(first).Append(second)
end
