package codegen2
import common2 "github.com/mygo-lang/mygo/internal/mygo/common2"

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import goast "go:github.com/mygo-lang/mygo/internal/mygo/codegen2/goast"
import typeinference2 "github.com/mygo-lang/mygo/internal/mygo/typeinference2"

func collectImports(decls: Slice[ast2.Decl]) -> Slice[GoImportPart]
  decls.Fold([] as Slice[GoImportPart], func(out: Slice[GoImportPart], d: ast2.Decl) -> Slice[GoImportPart]
    switch d
      case ImportDecl(alias, path) =>
        out.Append(GoImportPart { Alias: alias, Path: importPathForGo(path) })
      case _ => out
    end
  end)
end

func mergeGoImports(left: Slice[GoImportPart], right: Slice[GoImportPart]) -> Slice[GoImportPart]
  right.Fold(left, func(out: Slice[GoImportPart], item: GoImportPart) -> Slice[GoImportPart] out.Append(item) end)
end

func collectAstDecls(decls: Slice[ast2.Decl]) -> Slice[goast.Decl]
  decls.Fold([] as Slice[goast.Decl], func(out: Slice[goast.Decl], d: ast2.Decl) -> Slice[goast.Decl]
    switch d
      case TypeAliasDecl(name, tps, target) => out.Append(translateTypeAstDecl(name, tps, target, true))
      case TypeDecl(name, tps, target) => out.Append(translateTypeAstDecl(name, tps, target, false))
      case StructDecl(name, tps, fields) => out.Append(translateStructAstDecl(name, tps, fields))
      case InterfaceDecl(name, tps, methods) => out.Append(translateInterfaceAstDecl(name, tps, methods))
      case EnumDecl(name, tps, vars) => goast.AppendDecls(out, translateEnumAstDecls(name, tps, vars))
      case _ => out
    end
  end)
end

# translateDeclsAst 是新的声明收集入口。它保留 Result，使 func/impl
# 等需要翻译函数体的声明能够向上报告 AST 降低错误。
func translateDeclsAst(g: Ref[Generator2], decls: Slice[ast2.Decl], index: Int, out: Slice[goast.Decl]) -> Result[Slice[goast.Decl], String]
  if index >= decls.Len() then
    # Emit the mutual tail-call trampolines owned by this file exactly once.
    # Wrappers in other generated files call these helpers through Go package
    # scope, so the helper must live in one deterministic file.
    let trampolines = genMutualTailTrampolines(g)
    switch trampolines
      case Ok(items) => Ok(goast.AppendDecls(out, items))
      case Err(msg) => Err(msg)
    end
  else
    switch decls.Get(index)
      case Some(decl) => switch decl
      case TypeAliasDecl(name, tps, target) => translateDeclsAst(g, decls, index + 1, out.Append(translateTypeAstDecl(name, tps, target, true)))
      case TypeDecl(name, tps, target) => translateDeclsAst(g, decls, index + 1, out.Append(translateTypeAstDecl(name, tps, target, false)))
      case StructDecl(name, tps, fields) => translateDeclsAst(g, decls, index + 1, out.Append(translateStructAstDecl(name, tps, fields)))
      # Typeclass interfaces are compile-time declarations. Like the legacy
      # backend, codegen2 emits impl helpers rather than Go interface types.
      case InterfaceDecl(_, _, _) => translateDeclsAst(g, decls, index + 1, out)
      case EnumDecl(name, tps, vars) => translateDeclsAst(g, decls, index + 1, goast.AppendDecls(out, translateEnumAstDecls(name, tps, vars)))
      case LetDecl(bind) =>
        let result = translatePackageBinding(g, bind, false)
        switch result
          case Ok(items) => translateDeclsAst(g, decls, index + 1, goast.AppendDecls(out, items))
          case Err(msg) => Err("package let " + bind.Name + ": " + msg)
        end
      case VarDecl(bind) =>
        let result = translatePackageBinding(g, bind, true)
        switch result
          case Ok(items) => translateDeclsAst(g, decls, index + 1, goast.AppendDecls(out, items))
          case Err(msg) => Err("package var " + bind.Name + ": " + msg)
        end
      case FuncDecl(name, tps, params, ret, body, constraints) =>
        let result = translateFuncAstDecl(g, name, tps, params, ret, body, constraints)
        switch result
          case Ok(fn) => translateDeclsAst(g, decls, index + 1, out.Append(fn))
          case Err(msg) => Err("function " + name + ": " + msg)
        end
      case ImportDecl(_, _) => translateDeclsAst(g, decls, index + 1, out)
      case ImplDecl(tps, target, iface, methods) =>
        let result = translateImplAstDecl(g, tps, target, iface, methods)
        switch result
          case Ok(items) => translateDeclsAst(g, decls, index + 1, goast.AppendDecls(out, items))
          case Err(msg) => Err("impl " + typeString(target) + ": " + msg)
        end
      end
      case None => Err("malformed AST: missing declaration")
    end
  end
end

func seedPackageBindings(ctx: Ref[egCtx], decls: Slice[ast2.Decl], index: Int) -> ()
  switch seedPackageBindingsAt(ctx, decls, index)
    case Some(_) => ()
    case None => ()
  end
end

func seedPackageBindingsAt(ctx: Ref[egCtx], decls: Slice[ast2.Decl], index: Int) -> Option[()]
  if index >= decls.Len() then Some(()) else
    switch decls.Get(index)
      case Some(decl) =>
        switch decl
      case LetDecl(bind) =>
        ctxSetBinding(ctx, bind.Name, sanitizeIdent(bind.Name))
        ctxSetMutable(ctx, sanitizeIdent(bind.Name), false)
        switch bind.Value.Type
          case Some(typ) => ctxSetLocal(ctx, bind.Name, typ)
          case None => ()
        end
      case VarDecl(bind) =>
        ctxSetBinding(ctx, bind.Name, sanitizeIdent(bind.Name))
        ctxSetMutable(ctx, sanitizeIdent(bind.Name), true)
        switch bind.Value.Type
          case Some(typ) => ctxSetLocal(ctx, bind.Name, typ)
          case None => ()
        end
      case _ => ()
        end
        seedPackageBindingsAt(ctx, decls, index + 1)
      case None => None
    end
  end
end

func translatePackageBinding(g: Ref[Generator2], bind: ast2.Bind, mutable: Bool) -> Result[Slice[goast.Decl], String]
  if bind.Name == "" || bind.Name == "_" then
    Err("package binding requires a name")
  else
    var ctx = Ref.new(newEgCtx())
    go[()] {
      code: "{ctx}.goPackages = {g}.goPackages; {ctx}.pkgInfo = {g}.pkgInfo; {ctx}.pathAliases = {g}.pathAliases"
      in ctx = ctx
      in g = g
    }
    ctxUsePackageIndex(ctx, g.packageIndex)
    seedPackageBindings(ctx, g.decls, 0)
    let value = translateAstBindingValue(bind.Value, bind.Type, ctx)
    switch value
      case Err(msg) => Err(msg)
      case Ok(v) =>
        if v.Pre.Len() != 0 then
          Err("initializer requires statement lowering")
        else
          let typ = switch bind.Type
            case Some(t) => Some(goTypeAst(t, ctx.typeParams))
            case None => bind.Value.Type.Map(func(inferred: ast2.MonoType) -> goast.Expr monoTypeToGoAstWithParams(inferred, ctx.typeParamNames, ctx.pathAliases) end)
          end
          switch typ
            case None => Err("package binding has no inferred type")
            case Some(goType) => Ok(goast.PackageVarDecls(sanitizeIdent(bind.Name), goType, v.Expr))
          end
        end
    end
  end
end

func translateTypeAstDecl(name: String, tps: Slice[String], target: ast2.TypeExpr, isAlias: Bool) -> goast.Decl
  let ctx = newEgCtxWithTypeParams(tps)
  goast.TypeDeclFromParts(sanitizeIdent(name), tps, goType(target, ctx.typeParams), isAlias)
end

func translateImplAstDecl(g: Ref[Generator2], tps: Slice[String], target: ast2.TypeExpr, iface: Option[ast2.TypeExpr], methods: Slice[ast2.ImplMethod]) -> Result[Slice[goast.Decl], String]
  let ctx = Ref.new(newEgCtxWithTypeParams(tps))
  go[()] {
    code: "{ctx}.goPackages = {packages}; {ctx}.pkgInfo = {pkgInfo}; {ctx}.pathAliases = {aliases}"
    in ctx = ctx
    in packages = g.goPackages
    in pkgInfo = g.pkgInfo
    in aliases = g.pathAliases
  }
  ctxUsePackageIndex(ctx, g.packageIndex)
  seedPackageBindings(ctx, g.decls, 0)
  let stem = implStem(target, iface, ctx.typeParams)
  let receiverName = switch iface
    case Some(ifaceType) =>
      switch ifaceType
        case NamedType(_, args) =>
          switch args.Get(0)
            case None => ""
            case Some(arg) =>
              switch arg
                case NamedType(name, _) => name
                case _ => ""
              end
          end
        case _ => ""
      end
    case None => ""
  end
  translateImplAstMethods(stem, tps, methods, ctx.value(), 0, [] as Slice[goast.Decl], g.decls, receiverName)
end

func collectFuncDecls(g: Ref[Generator2], decls: Slice[ast2.Decl], index: Int, out: Slice[goast.Decl]) -> Result[Slice[goast.Decl], String]
  if index >= decls.Len() then
    Ok(out)
  else
    switch decls.Get(index)
      case None => Err("malformed file: missing declaration")
      case Some(decl) then
        switch decl
          case FuncDecl(name, tps, params, ret, body, constraints) =>
            let one = translateFuncAstDecl(g, name, tps, params, ret, body, constraints)
            switch one
              case Ok(fn) => collectFuncDecls(g, decls, index + 1, out.Append(fn))
              case Err(msg) => Err(msg)
            end
          case _ => collectFuncDecls(g, decls, index + 1, out)
        end
      end
    end
  end
end

func translateStructAstDecl(name: String, tps: Slice[String], fields: Slice[ast2.Field]) -> goast.Decl
  let ctx = newEgCtxWithTypeParams(tps)
  # Struct field names keep their declared spelling (Go identifiers are
  # case-sensitive; inline-Go in this package references lowercase fields such
  # as `ctx.goPackages`).  No automatic case conversion.
  let names = fields.Map(func(f: ast2.Field) -> String
    if f.Name == "embed" then "" else sanitizeIdent(f.Name) end
  end)
  let types = fields.Map(func(f: ast2.Field) -> goast.Expr goTypeAst(f.Type, ctx.typeParams) end)
  let tags = fields.Map(func(f: ast2.Field) -> String
    switch f.Tag
      case Some(v) => v
      case None => ""
    end
  end)
  goast.StructDeclFromExprParts(sanitizeIdent(name), tps, names, types, tags)
end

func translateEnumAstDecls(name: String, tps: Slice[String], vars: Slice[ast2.Variant]) -> Slice[goast.Decl]
  let ctx = newEgCtxWithTypeParams(tps)
  let variantNames = vars.Map(func(v: ast2.Variant) -> String variantGoTypeName(sanitizeIdent(name), v.Name) end)
  let variantFields = vars.Map(func(v: ast2.Variant) -> Slice[String]
    v.Fields.Map(func(t: ast2.TypeExpr) -> String goType(t, ctx.typeParams) end)
  end)
  let variantFieldNames = vars.Map(func(v: ast2.Variant) -> Slice[String]
    if v.Named then v.Names else ([] as Slice[String]) end
  end)
  let constructors = vars.Map(func(v: ast2.Variant) -> String enumConstructorGoName(sanitizeIdent(name), v.Name) end)
  goast.EnumDeclsFromPartsWithFieldNames(sanitizeIdent(name), tps, variantNames, variantFields, variantFieldNames, constructors)
end

func translateInterfaceAstDecl(name: String, tps: Slice[String], methods: Slice[ast2.FuncSig]) -> goast.Decl
  let ctx = newEgCtxWithTypeParams(tps)
  let names = methods.Map(func(m: ast2.FuncSig) -> String sanitizeIdent(m.Name) end)
  let sigs = methods.Map(func(m: ast2.FuncSig) -> String
    funcSignature("", m.TypeParams, m.Params, m.Ret, ctx.typeParams)
  end)
  goast.InterfaceDeclFromParts(sanitizeIdent(name), tps, names, sigs)
end

func translateImplAstMethods(stem: String, tps: Slice[String], methods: Slice[ast2.ImplMethod], baseCtx: egCtx, index: Int, out: Slice[goast.Decl], decls: Slice[ast2.Decl], receiverName: String) -> Result[Slice[goast.Decl], String]
  if index >= methods.Len() then
    Ok(out)
  else
    switch methods.Get(index)
      case None => Err("malformed impl declaration: missing method")
      case Some(method) => translateImplAstMethodAt(stem, tps, methods, baseCtx, index, out, decls, receiverName, method)
    end
  end
end

func translateImplAstMethodAt(stem: String, tps: Slice[String], methods: Slice[ast2.ImplMethod], baseCtx: egCtx, index: Int, out: Slice[goast.Decl], decls: Slice[ast2.Decl], receiverName: String, method: ast2.ImplMethod) -> Result[Slice[goast.Decl], String]
    let sig = method.Sig
    let methodTps = appendStrings(tps, sig.TypeParams)
    let ret = returnMonoType(sig.Ret)

    let ctx = Ref.new(newFuncEgCtx(methodTps, ret, sig.Name, sig.Params.Len()))
    go[()] {
      code: "{ctx}.goPackages = {packages}; {ctx}.pkgInfo = {pkgInfo}; {ctx}.pathAliases = {aliases}"
      in ctx = ctx
      in packages = baseCtx.goPackages
      in pkgInfo = baseCtx.pkgInfo
      in aliases = baseCtx.pathAliases
    }
    # Package facts are precomputed once by Generator2 and shared read-only
    # by every function and impl-method context.
    ctxUsePackageFacts(ctx, baseCtx)
    var names: Slice[String] = []
    var i: Int = 0
    while i < sig.Params.Len()
      if sig.Params.Get(i).IsNone() then return Err("impl method parameter index is out of range") end
      switch sig.Params.Get(i)
        case None => ()
        case Some(param) =>
          let goName = ctxFreshBinding(ctx, param.Name)
          ctxSetLocal(ctx, param.Name, typeinference2.TypeFromASTWithParams(param.Type, methodTps))
          names = names.Append(goName)
      end
      i = i + 1
    end
    # Process `using` constraints (e.g. using Eq[T]) to inject dictionary
    # parameters like equalsFn, matching translateFuncAstDecl behavior.
    let paramTypes = sig.Params.Map(func(p: ast2.Param) -> String goType(p.Type, ctx.typeParams) end)
    let dictionary = addConstraintParams(sig.Using, ctx, names, paramTypes, methodTps, receiverName)
    ctxSetTailRecParamNames(ctx, dictionary.Names)
    let body = translateFuncBodyAst(method.Body, ctx)
    let comparableParams = comparableTypeParamsFromFunc(sig.Params, sig.Ret, ctx.typeParams)
    switch body
      case Err(msg) => Err("impl method " + sig.Name + ": " + msg)
      case Ok(stmts) =>
        let decl = goast.MustFuncDeclFromStmtsMultiComparable(
          implMethodSymbol(stem, sig.Name),
          methodTps,
          dictionary.Names,
          dictionary.Types,
          goReturnTypesFromOption(sig.Ret, ctx.typeParams),
          comparableParams,
          stmts,
          containsTailCall(method.Body, sig.Name),
        )
        translateImplAstMethods(stem, tps, methods, baseCtx, index + 1, out.Append(decl), decls, receiverName)
    end
end

func defaultImplMethod() -> ast2.ImplMethod
  ast2.ImplMethod {
    Pos: ast2.SourcePos { SourceName: "", Line: 1, Column: 1 },
    Sig: ast2.FuncSig { Pos: ast2.SourcePos { SourceName: "", Line: 1, Column: 1 }, Name: "", TypeParams: [] as Slice[String], Params: [] as Slice[ast2.Param], Ret: None, Using: [] as Slice[ast2.Constraint] },
    Body: ast2.EmptyExpr(),
  }
end

# Build all package-level lowering metadata once.  Individual function and
# impl-method contexts only receive references to these immutable maps/slices.
func newPackageIndex(decls: Slice[ast2.Decl]) -> PackageIndex
  let seed = Ref.new(newEgCtx())
  seedInterfaceMetadata(decls, 0, seed)
  seedNamedImpls(decls, 0, seed)
  seedCallDictionaries(decls, seed)
  seedCallRequirements(decls, seed)
  seedStructSourceTypes(decls, seed)
  seedPackageDictionaries(decls, seed)
  seedEnumValueConstructors(decls, seed)
  PackageIndex {
    StructFields: seed.structFields,
    StructTypeParams: seed.structTypeParams,
    CallDictionaries: seed.callDictionaries,
    PackageDictionaries: seed.packageDictionaries,
    CallRequirements: seed.callRequirements,
    PackageCandidates: seed.packageCandidates,
    InherentCandidates: seed.inherentCandidates,
    TypeclassCandidates: seed.typeclassCandidates,
    EnumValueConstructors: seed.enumValueConstructors,
    EnumVariantOwners: seed.enumVariantOwners,
    VariantFieldMonoTypes: seed.variantFieldMonoTypes,
    VariantFieldNames: seed.variantFieldNames,
    InterfaceMethods: seed.interfaceMethods,
    InterfaceTypeParams: seed.interfaceTypeParams,
    NamedImpls: seed.namedImpls,
  }
end

func newPackageIndexWithImports(localDecls: Slice[ast2.Decl], imports: Slice[typeinference2.MyGoPackageInfo]) -> PackageIndex
  let seed = Ref.new(newEgCtx())
  seedInterfaceMetadata(localDecls, 0, seed)
  seedNamedImpls(localDecls, 0, seed)
  seedCallDictionaries(localDecls, seed)
  seedCallRequirements(localDecls, seed)
  seedStructSourceTypes(localDecls, seed)
  seedPackageDictionaries(localDecls, seed)
  seedImportedPackageDictionaries(imports, 0, seed)
  seedEnumValueConstructors(localDecls, seed)
  PackageIndex { StructFields: seed.structFields, StructTypeParams: seed.structTypeParams, CallDictionaries: seed.callDictionaries, PackageDictionaries: seed.packageDictionaries, CallRequirements: seed.callRequirements, PackageCandidates: seed.packageCandidates, InherentCandidates: seed.inherentCandidates, TypeclassCandidates: seed.typeclassCandidates, EnumValueConstructors: seed.enumValueConstructors, EnumVariantOwners: seed.enumVariantOwners, VariantFieldMonoTypes: seed.variantFieldMonoTypes, VariantFieldNames: seed.variantFieldNames, InterfaceMethods: seed.interfaceMethods, InterfaceTypeParams: seed.interfaceTypeParams, NamedImpls: seed.namedImpls }
end

func seedImportedPackageDictionaries(packages: Slice[typeinference2.MyGoPackageInfo], index: Int, ctx: Ref[egCtx]) -> ()
  if index < packages.Len() then
    switch packages.Get(index)
      case None => seedImportedPackageDictionaries(packages, index + 1, ctx)
      case Some(pkg) =>
        ctx.candidateOwnerAlias = pkg.Alias
        seedPackageDictionaries(pkg.Decls, ctx)
        seedImportedPackageDictionaries(packages, index + 1, ctx)
    end
  end
end

func seedInterfaceMetadata(decls: Slice[ast2.Decl], index: Int, ctx: Ref[egCtx]) -> ()
  if index < decls.Len() then
    switch decls.Get(index)
      case None => ()
      case Some(decl) => seedOneInterfaceMetadata(decl, ctx)
    end
    seedInterfaceMetadata(decls, index + 1, ctx)
  end
end

func seedOneInterfaceMetadata(decl: ast2.Decl, ctx: Ref[egCtx]) -> ()
  switch decl
    case InterfaceDecl(name, tps, methods) then
      ctx.interfaceMethods.Set(name, methods)
      ctx.interfaceTypeParams.Set(name, tps)
    end
    case _ => ()
  end
end

func seedNamedImpls(decls: Slice[ast2.Decl], index: Int, ctx: Ref[egCtx]) -> ()
  if index < decls.Len() then
    switch decls.Get(index)
      case None => ()
      case Some(decl) => seedOneNamedImpl(decl, ctx)
    end
    seedNamedImpls(decls, index + 1, ctx)
  end
end

func seedOneNamedImpl(decl: ast2.Decl, ctx: Ref[egCtx]) -> ()
  switch decl
    case ImplDecl(_, target, iface, _) then
      switch iface
        case Some(_) then
          switch target
            case NamedType(name, _) => ctx.namedImpls.Set(name, true)
            case _ => ()
          end
        end
        case None => ()
      end
    end
    case _ => ()
  end
end

func ctxUsePackageIndex(ctx: Ref[egCtx], index: PackageIndex) -> ()
  go[()] {
    code: "{ctx}.structFields = {index}.StructFields; {ctx}.structTypeParams = {index}.StructTypeParams; {ctx}.callDictionaries = {index}.CallDictionaries; {ctx}.packageDictionaries = {index}.PackageDictionaries; {ctx}.callRequirements = {index}.CallRequirements; {ctx}.packageCandidates = {index}.PackageCandidates; {ctx}.inherentCandidates = {index}.InherentCandidates; {ctx}.typeclassCandidates = {index}.TypeclassCandidates; {ctx}.enumValueConstructors = {index}.EnumValueConstructors; {ctx}.enumVariantOwners = {index}.EnumVariantOwners; {ctx}.variantFieldMonoTypes = {index}.VariantFieldMonoTypes; {ctx}.variantFieldNames = {index}.VariantFieldNames; {ctx}.interfaceMethods = {index}.InterfaceMethods; {ctx}.interfaceTypeParams = {index}.InterfaceTypeParams; {ctx}.namedImpls = {index}.NamedImpls"
    in ctx = ctx
    in index = index
  }
end

func ctxUsePackageFacts(ctx: Ref[egCtx], source: egCtx) -> ()
  go[()] {
    code: "{ctx}.structFields = {source}.structFields; {ctx}.structTypeParams = {source}.structTypeParams; {ctx}.callDictionaries = {source}.callDictionaries; {ctx}.packageDictionaries = {source}.packageDictionaries; {ctx}.callRequirements = {source}.callRequirements; {ctx}.packageCandidates = {source}.packageCandidates; {ctx}.inherentCandidates = {source}.inherentCandidates; {ctx}.typeclassCandidates = {source}.typeclassCandidates; {ctx}.enumValueConstructors = {source}.enumValueConstructors; {ctx}.enumVariantOwners = {source}.enumVariantOwners; {ctx}.variantFieldMonoTypes = {source}.variantFieldMonoTypes; {ctx}.variantFieldNames = {source}.variantFieldNames; {ctx}.interfaceMethods = {source}.interfaceMethods; {ctx}.interfaceTypeParams = {source}.interfaceTypeParams; {ctx}.namedImpls = {source}.namedImpls"
    in ctx = ctx
    in source = source
  }
end

func implStem(target: ast2.TypeExpr, iface: Option[ast2.TypeExpr], tps: Set[String]) -> String
  switch iface
    case Some(i) then
      switch i
        case NamedType(name, args) => mangleInterfaceImplSymbol(name, target, args)
        case _ => mangleInterfaceImplSymbol(typeString(i), target, [] as Slice[ast2.TypeExpr])
      end
    end
    case None => mangleInherentImplSymbol(inherentReceiverName(target))
  end
end

func translateFuncAstDecl(g: Ref[Generator2], name: String, tps: Slice[String], params: Slice[ast2.Param], ret: Option[ast2.TypeExpr], body: ast2.Expr, constraints: Slice[ast2.Constraint]) -> Result[goast.Decl, String]
  # A member of an eligible mutual tail-call SCC becomes a thin wrapper that
  # forwards to the shared trampoline; the source body is lowered inside the
  # trampoline instead.  This preserves the exported name and signature.
  switch g.mutualTail.ByName.Get(name)
    case Some(plan) => genMutualTailWrapper(g, name, tps, params, ret, constraints, plan)
    case None =>
      translateFuncAstDeclBody(g, name, tps, params, ret, body, constraints)
  end
end

func translateFuncAstDeclBody(g: Ref[Generator2], name: String, tps: Slice[String], params: Slice[ast2.Param], ret: Option[ast2.TypeExpr], body: ast2.Expr, constraints: Slice[ast2.Constraint]) -> Result[goast.Decl, String]
  let initialRetType = returnMonoType(ret)
  let ctx = Ref.new(newFuncEgCtx(tps, initialRetType, name, params.Len()))
  go[()] {
    code: "{ctx}.goPackages = {g}.goPackages; {ctx}.pkgInfo = {g}.pkgInfo; {ctx}.pathAliases = {g}.pathAliases"
    in ctx = ctx
    in g = g
  }
  ctxUsePackageIndex(ctx, g.packageIndex)
  seedPackageBindings(ctx, g.decls, 0)
  var goParams: Slice[String] = []
  var paramNames: Slice[String] = []
  var i: Int = 0
  while i < params.Len()
    if params.Get(i).IsNone() then return Err("function parameter index is out of range") end
    switch params.Get(i)
      case None => ()
      case Some(p) =>
        let pn = ctxFreshBinding(ctx, p.Name)
        ctxSetLocal(ctx, p.Name, typeinference2.TypeFromASTWithParams(p.Type, tps))
        goParams = goParams.Append(pn + " " + goType(p.Type, ctx.typeParams))
        paramNames = paramNames.Append(pn)
    end
    i = i + 1
  end
  let dictionary = addConstraintParams(constraints, ctx, paramNames, params.Map(func(p: ast2.Param) -> String goType(p.Type, ctx.typeParams) end), tps, "")
  ctxSetTailRecParamNames(ctx, dictionary.Names)
  let comparableParams = comparableTypeParamsFromFunc(params, ret, ctx.typeParams)
  let astBody = translateFuncBodyAst(body, ctx)
  switch astBody
    case Ok(stmts) =>
      if constraints.Len() == 0 then
        Ok(goast.MustFuncDeclFromExprStmtsMultiComparable(
          sanitizeIdent(name), tps, paramNames,
          params.Map(func(p: ast2.Param) -> goast.Expr goTypeAst(p.Type, ctx.typeParams) end),
          goReturnTypesAst(ret, ctx.typeParams), comparableParams, stmts,
          containsTailCall(body, name),
        ))
      else
        Ok(goast.MustFuncDeclFromStmtsMultiComparable(
          sanitizeIdent(name), tps, dictionary.Names, dictionary.Types,
          goReturnTypesFromOption(ret, ctx.typeParams), comparableParams, stmts,
          containsTailCall(body, name),
        ))
      end
    case Err(msg) => Err(msg)
  end
end

# Keep source-level field types available while lowering receiver syntax.
# Keys use the Go-visible struct constructor and exported field spelling.
# Uses if/else chain instead of switch to avoid the old mygo compiler
func seedStructSourceTypes(decls: Slice[ast2.Decl], ctx: Ref[egCtx]) -> ()
  if decls.Len() != 0 then
    switch decls.Get(0)
      case None => ()
      case Some(decl) => seedStructSourceTypesFromDecl(decl, ctx)
    end
    seedStructSourceTypes(common2.SliceDrop(decls, 1), ctx)
  end
end

func isStructDecl(decl: ast2.Decl) -> Bool
  switch decl
    case StructDecl(_, _, _) => true
    case _ => false
  end
end

func seedStructSourceTypesFromDecl(decl: ast2.Decl, ctx: Ref[egCtx]) -> ()
  switch decl
    case StructDecl(name, tps, fields) =>
      # FIXME: To Be Removed
      # ctx.sourceTypes.Set("$tparams$" + name, strings.Join(tps, ","))
      # Also populate MonoType-based struct field storage.
      let bound = typeParamIDsMono(tps, 1)
      ctx.structTypeParams.Set(name, bound)
      let fieldEntries = fieldsToFieldEntries(name, fields, tps, 0, [] as Slice[typeinference2.FieldEntry])
      ctx.structFields.Set(name, fieldEntries)
    case _ => ()
  end
end

func typeParamIDsMono(params: Slice[String], index: Int) -> Slice[Int]
  if params.Len() == 0 then [] as Slice[Int] else
    typeParamIDsMono(common2.SliceDrop(params, 1), index + 1).Prepend(-index)
  end
end

func fieldsToFieldEntries(typeName: String, fields: Slice[ast2.Field], tps: Slice[String], index: Int, out: Slice[typeinference2.FieldEntry]) -> Slice[typeinference2.FieldEntry]
  if index >= fields.Len() then out else
    switch fields.Get(index)
      case None => fieldsToFieldEntries(typeName, fields, tps, index + 1, out)
      case Some(f) =>
        let monoType = typeinference2.TypeFromASTWithParams(f.Type, tps)
        let entry = typeinference2.FieldEntry { TypeName: typeName, FieldName: f.Name, Type: monoType }
        fieldsToFieldEntries(typeName, fields, tps, index + 1, out.Append(entry))
    end
  end
end

func seedEnumValueConstructors(decls: Slice[ast2.Decl], ctx: Ref[egCtx]) -> ()
  if decls.Len() != 0 then
    switch decls.Get(0)
      case None => ()
      case Some(decl) => seedOneEnumValueConstructor(decl, ctx)
    end
    seedEnumValueConstructors(common2.SliceDrop(decls, 1), ctx)
  end
end

func seedOneEnumValueConstructor(decl: ast2.Decl, ctx: Ref[egCtx]) -> ()
  switch decl
    case EnumDecl(name, typeParams, variants) => seedEnumVariantsForVariants(name, typeParams, variants, ctx, 0)
    case _ => ()
  end
end

func seedEnumVariantsForVariants(enumName: String, enumTypeParams: Slice[String], variants: Slice[ast2.Variant], ctx: Ref[egCtx], index: Int) -> ()
  if index < variants.Len() then
    switch variants.Get(index)
      case None => ()
      case Some(variant) then
        ctx.enumVariantOwners.Set(variant.Name, enumName)
        ctx.enumValueConstructors.Set(enumName + "." + variant.Name, enumConstructorGoName(sanitizeIdent(enumName), variant.Name))
        seedEnumVariantFieldTypes(enumName, variant.Name, variant.Fields, enumTypeParams, ctx, 0)
        if variant.Named then
          ctx.variantFieldNames.Set(variant.Name, variant.Names)
        end
      end
    end
    seedEnumVariantsForVariants(enumName, enumTypeParams, variants, ctx, index + 1)
  end
end

func seedEnumVariantFieldTypes(enumName: String, variantName: String, fields: Slice[ast2.TypeExpr], enumTypeParams: Slice[String], ctx: Ref[egCtx], index: Int) -> ()
  if index < fields.Len() then
    switch fields.Get(index)
      case None => ()
      case Some(fieldType) then
        let fieldMono = typeinference2.TypeFromASTWithParams(fieldType, enumTypeParams)
        let existing = switch ctx.variantFieldMonoTypes.Get(variantName)
          case Some(value) => value
          case None => [] as Slice[ast2.MonoType]
        end
        ctx.variantFieldMonoTypes.Set(variantName, existing.Append(fieldMono))
      end
    end
    seedEnumVariantFieldTypes(enumName, variantName, fields, enumTypeParams, ctx, index + 1)
  end
end

func seedCallDictionaries(decls: Slice[ast2.Decl], ctx: Ref[egCtx]) -> ()
  if decls.Len() != 0 then
    switch decls.Get(0)
      case None => ()
      case Some(decl) => seedOneCallDictionary(decl, ctx)
    end
    seedCallDictionaries(common2.SliceDrop(decls, 1), ctx)
  end
end

func seedOneCallDictionary(decl: ast2.Decl, ctx: Ref[egCtx]) -> ()
  switch decl
    case FuncDecl(name, _, _, _, _, constraints) => ctx.callDictionaries.Set(name, dictionaryMethodNames(ctx, constraints))
    case _ => ()
  end
end

func seedCallRequirements(decls: Slice[ast2.Decl], ctx: Ref[egCtx]) -> ()
  if decls.Len() != 0 then
    switch decls.Get(0)
      case None => ()
      case Some(decl) => seedOneCallRequirement(decl, ctx)
    end
    seedCallRequirements(common2.SliceDrop(decls, 1), ctx)
  end
end

func seedOneCallRequirement(decl: ast2.Decl, ctx: Ref[egCtx]) -> ()
  switch decl
    case FuncDecl(name, _, _, _, _, constraints) => ctx.callRequirements.Set(name, requirementsForConstraints(ctx, constraints))
    case _ => ()
  end
end

func requirementsForConstraints(ctx: Ref[egCtx], constraints: Slice[ast2.Constraint]) -> Slice[DictionaryRequirement]
  if constraints.Len() == 0 then
    []
  else
    switch constraints.Get(0)
      case None => requirementsForConstraints(ctx, common2.SliceDrop(constraints, 1))
      case Some(constraint) =>
        let methods = switch ctx.interfaceMethods.Get(constraint.Name)
          case Some(value) => value
          case None => [] as Slice[ast2.FuncSig]
        end
        appendRequirements(requirementsForMethods(constraint, methods), requirementsForConstraints(ctx, common2.SliceDrop(constraints, 1)))
    end
  end
end

func requirementsForMethods(constraint: ast2.Constraint, methods: Slice[ast2.FuncSig]) -> Slice[DictionaryRequirement]
  if methods.Len() == 0 then
    []
  else
    switch methods.Get(0)
      case None => requirementsForMethods(constraint, common2.SliceDrop(methods, 1))
      case Some(method) => requirementsForMethods(constraint, common2.SliceDrop(methods, 1)).Prepend(DictionaryRequirement { Interface: constraint.Name, Method: method.Name, Args: constraint.Args })
    end
  end
end

func appendRequirements(left: Slice[DictionaryRequirement], right: Slice[DictionaryRequirement]) -> Slice[DictionaryRequirement]
  if right.Len() == 0 then
    left
  else
    switch right.Get(0)
      case None => left
      case Some(requirement) => appendRequirements(left.Append(requirement), common2.SliceDrop(right, 1))
    end
  end
end

func seedPackageDictionaries(decls: Slice[ast2.Decl], ctx: Ref[egCtx]) -> ()
  if decls.Len() != 0 then
    switch decls.Get(0)
      case None => ()
      case Some(decl) => seedOnePackageDictionary(decl, ctx)
    end
    seedPackageDictionaries(common2.SliceDrop(decls, 1), ctx)
  end
end

func seedOnePackageDictionary(decl: ast2.Decl, ctx: Ref[egCtx]) -> ()
  switch decl
    case ImplDecl(tps, target, iface, methods) =>
      switch iface
        case Some(interfaceType) =>
          let stem = implStem(target, Some(interfaceType), typeParamSet(tps))
          seedImplMethodDictionaries(methods, stem, interfaceTypeName(interfaceType), ctx)
          seedImplCandidates(methods, stem, interfaceTypeName(interfaceType), interfaceTypeArgs(interfaceType), tps, ctx)
        case None =>
          # Inherent methods are callable with receiver syntax too.  Keep
          # instance and static methods in separate lookup keys: `x.f()` has
          # a receiver, whereas `Type.f()` must not pass the type name as one.
          let stem = implStem(target, None, typeParamSet(tps))
          seedInherentCandidates(methods, stem, target, tps, ctx)
      end
    case _ => ()
  end
end

func seedInherentCandidates(methods: Slice[ast2.ImplMethod], stem: String, target: ast2.TypeExpr, typeParams: Slice[String], ctx: Ref[egCtx]) -> ()
  if methods.Len() != 0 then
    switch methods.Get(0)
      case None => seedInherentCandidates(common2.SliceDrop(methods, 1), stem, target, typeParams, ctx)
      case Some(method) => seedInherentCandidate(methods, method, stem, target, typeParams, ctx)
    end
  end
end

func seedInherentCandidate(methods: Slice[ast2.ImplMethod], method: ast2.ImplMethod, stem: String, target: ast2.TypeExpr, typeParams: Slice[String], ctx: Ref[egCtx]) -> ()
    let helper = implMethodSymbol(stem, method.Sig.Name)
    let first = method.Sig.Params.Get(0)
    let isInstance = switch first
      case Some(param) => inherentReceiverParamMatches(param.Type, target)
      case None => false
    end
    let combined = appendStrings(typeParams, method.Sig.TypeParams)
    let methodMonos = methodAllParamMonos(method.Sig.Params, combined)
    let spellCount = if isInstance then methodSpellCount(method, typeParams, ctx) else 0 end
    if isInstance then
      let candidate = ImplDictionaryCandidate { Interface: "$inherent$", Method: method.Sig.Name, InterfaceArgs: [target], Receiver: typeinference2.TypeFromASTWithParams(target, typeParams), TypeParams: typeParams, Helper: helper, OwnerAlias: ctx.candidateOwnerAlias, RequiresExplicitTypeArgs: spellCount > 0, MethodTypeParams: method.Sig.TypeParams, MethodParamMonos: methodMonos, SpellCount: spellCount }
      ctx.inherentCandidates = ctx.inherentCandidates.Append(candidate)
    else
      let key = "$static$" + inherentReceiverName(target) + "." + method.Sig.Name
      let candidate = ImplDictionaryCandidate { Interface: "$inherent$", Method: method.Sig.Name, InterfaceArgs: [target], Receiver: typeinference2.TypeFromASTWithParams(target, typeParams), TypeParams: typeParams, Helper: helper, OwnerAlias: ctx.candidateOwnerAlias, RequiresExplicitTypeArgs: false, MethodTypeParams: [] as Slice[String], MethodParamMonos: [] as Slice[ast2.MonoType], SpellCount: 0 }
      let existing = switch ctx.packageCandidates.Get(key)
        case Some(value) => value
        case None => [] as Slice[ImplDictionaryCandidate]
      end
      ctx.packageCandidates.Set(key, existing.Append(candidate))
    end
    seedInherentCandidates(common2.SliceDrop(methods, 1), stem, target, typeParams, ctx)
end

# A method is a receiver (instance) method when its first parameter's type
# constructor matches the impl target's constructor.  Textual comparison
# fails for nested receivers such as
# `Flatten(opt: Option[Option[A]])`, whose first parameter does not spell
# the impl target `Option[A]` exactly.
func inherentReceiverParamMatches(paramType: ast2.TypeExpr, target: ast2.TypeExpr) -> Bool
  receiverParamHead(paramType) == inherentReceiverName(target)
end

func receiverParamHead(typ: ast2.TypeExpr) -> String
  switch typ
    case NamedType(name, _) => name
    case _ => typeString(typ)
  end
end

func seedImplCandidates(methods: Slice[ast2.ImplMethod], stem: String, interfaceName: String, interfaceArgs: Slice[ast2.TypeExpr], typeParams: Slice[String], ctx: Ref[egCtx]) -> ()
  if methods.Len() != 0 then
    switch methods.Get(0)
      case None => ()
      case Some(method) =>
        switch interfaceArgs.Get(0)
          case None => seedImplCandidates(common2.SliceDrop(methods, 1), stem, interfaceName, interfaceArgs, typeParams, ctx)
          case Some(receiver) => seedImplCandidate(method, common2.SliceDrop(methods, 1), receiver, stem, interfaceName, interfaceArgs, typeParams, ctx)
        end
    end
  end
end

func seedImplCandidate(method: ast2.ImplMethod, rest: Slice[ast2.ImplMethod], receiver: ast2.TypeExpr, stem: String, interfaceName: String, interfaceArgs: Slice[ast2.TypeExpr], typeParams: Slice[String], ctx: Ref[egCtx]) -> ()
  let key = interfaceName + "." + method.Sig.Name
  let combined = appendStrings(typeParams, method.Sig.TypeParams)
  let methodMonos = methodAllParamMonos(method.Sig.Params, combined)
  let spellCount = methodSpellCount(method, typeParams, ctx)
  let candidate = ImplDictionaryCandidate { Interface: interfaceName, Method: method.Sig.Name, InterfaceArgs: interfaceArgs, Receiver: typeinference2.TypeFromASTWithParams(receiver, typeParams), TypeParams: typeParams, Helper: implMethodSymbol(stem, method.Sig.Name), OwnerAlias: ctx.candidateOwnerAlias, RequiresExplicitTypeArgs: spellCount > 0, MethodTypeParams: method.Sig.TypeParams, MethodParamMonos: methodMonos, SpellCount: spellCount }
  let existing = switch ctx.packageCandidates.Get(key)
    case Some(value) => value
    case None => [] as Slice[ImplDictionaryCandidate]
  end
  ctx.packageCandidates.Set(key, existing.Append(candidate))
  ctx.typeclassCandidates = ctx.typeclassCandidates.Append(candidate)
  seedImplCandidates(rest, stem, interfaceName, interfaceArgs, typeParams, ctx)
end

# Go can only infer generic function type arguments from positions that are
# structurally unifiable: bare parameters, `func` parameters, native generic
# containers (Slice/Map/Set/Ref), and defined generic structs (List[A]).
# Generic enum types lower to Go interfaces (Option[A], Result[A, E]) and do
# not participate in inference at the top level of a parameter.  When a type
# parameter is provably non-inferable the emitted helper call must spell every
# type argument up to and including it (Go >= 1.21 infers any remaining tail
# from the argument list); when the analysis cannot decide, spelling is the
# safe default.
func methodSpellCount(method: ast2.ImplMethod, implTps: Slice[String], ctx: Ref[egCtx]) -> Int
  let combined = appendStrings(implTps, method.Sig.TypeParams)
  if combined.Len() == 0 then
    0
  else
    let tpIDs = typeParamIDsMono(combined, 1)
    nonInferableTrailingCount(tpIDs, method.Sig.Params, combined, ctx, 0, 0)
  end
end

func nonInferableTrailingCount(tpIDs: Slice[Int], params: Slice[ast2.Param], combined: Slice[String], ctx: Ref[egCtx], index: Int, trailing: Int) -> Int
  if index >= tpIDs.Len() then
    trailing
  else
    switch tpIDs.Get(index)
      case None => trailing
      case Some(id) =>
        if paramsContainInferable(params, combined, id, ctx) then
          nonInferableTrailingCount(tpIDs, params, combined, ctx, index + 1, trailing)
        else
          nonInferableTrailingCount(tpIDs, params, combined, ctx, index + 1, index + 1)
        end
    end
  end
end

# A type parameter is "inferable" only when some parameter exposes it in a
# position Go can unify.  Generic enum types lower to Go interfaces
# (Option[A], Result[A, E]), which never contribute to Go inference; generic
# struct types (List[A]) and native containers (Slice/Map/Set/Ref) do, as do
# `func` parameters.
func paramsContainInferable(params: Slice[ast2.Param], combined: Slice[String], tpID: Int, ctx: Ref[egCtx]) -> Bool
  if params.Len() == 0 then
    false
  else
    switch params.Get(0)
      case None => false
      case Some(p) => monoTypeParamInferable(typeinference2.TypeFromASTWithParams(p.Type, combined), tpID, ctx) || paramsContainInferable(common2.SliceDrop(params, 1), combined, tpID, ctx)
    end
  end
end

func monoTypeParamInferable(t: ast2.MonoType, tpID: Int, ctx: Ref[egCtx]) -> Bool
  switch t
    case TParam(id) => id == tpID
    case TApp(ctor, args) =>
      switch ctor.value()
        case TCon(name) =>
          if isNativeInferableContainer(name) then
            monoTypesParamInferable(args, tpID, ctx)
          elsif typeIsStructContainer(name, ctx) then
            monoTypesParamInferable(args, tpID, ctx)
          else
            false
          end
        case _ => false
      end
    case TFunc(items, ret) => monoTypesParamInferable(items, tpID, ctx) || monoTypeParamInferable(ret.value(), tpID, ctx)
    case _ => false
  end
end

func monoTypesParamInferable(items: Slice[ast2.MonoType], tpID: Int, ctx: Ref[egCtx]) -> Bool
  if items.Len() == 0 then
    false
  else
    switch items.Get(0)
      case None => false
      case Some(item) => monoTypeParamInferable(item, tpID, ctx) || monoTypesParamInferable(common2.SliceDrop(items, 1), tpID, ctx)
    end
  end
end

func methodAllParamMonos(params: Slice[ast2.Param], combined: Slice[String]) -> Slice[ast2.MonoType]
  if params.Len() == 0 then
    [] as Slice[ast2.MonoType]
  else
    switch params.Get(0)
      case None => [] as Slice[ast2.MonoType]
      case Some(p) => methodAllParamMonos(common2.SliceDrop(params, 1), combined).Prepend(typeinference2.TypeFromASTWithParams(p.Type, combined))
    end
  end
end

func isNativeInferableContainer(name: String) -> Bool
  name == "Slice" || name == "Map" || name == "Set" || name == "Ref"
end

func typeIsStructContainer(name: String, ctx: Ref[egCtx]) -> Bool
  switch ctx.structFields.Get(name)
    case Some(_) => true
    case None => false
  end
end

func seedImplMethodDictionaries(methods: Slice[ast2.ImplMethod], stem: String, interfaceName: String, ctx: Ref[egCtx]) -> ()
  if methods.Len() != 0 then
    switch methods.Get(0)
      case None => seedImplMethodDictionaries(common2.SliceDrop(methods, 1), stem, interfaceName, ctx)
      case Some(method) =>
        # Lexical dictionaries still win; this is only a package fallback.
        ctx.packageDictionaries.Set(interfaceName + "." + method.Sig.Name, implMethodSymbol(stem, method.Sig.Name))
        seedImplMethodDictionaries(common2.SliceDrop(methods, 1), stem, interfaceName, ctx)
    end
  end
end

func interfaceTypeName(typ: ast2.TypeExpr) -> String
  switch typ
    case NamedType(name, _) => name
    case _ => typeString(typ)
  end
end

func interfaceTypeArgs(typ: ast2.TypeExpr) -> Slice[ast2.TypeExpr]
  switch typ
    case NamedType(_, args) => args
    case _ => []
  end
end

func dictionaryMethodNames(ctx: Ref[egCtx], constraints: Slice[ast2.Constraint]) -> Slice[String]
  if constraints.Len() == 0 then [] else
    switch constraints.Get(0)
      case None => dictionaryMethodNames(ctx, common2.SliceDrop(constraints, 1))
      case Some(constraint) =>
        let methods = switch ctx.interfaceMethods.Get(constraint.Name)
          case Some(value) => value
          case None => [] as Slice[ast2.FuncSig]
        end
        let names = methods.Map(func(method: ast2.FuncSig) -> String method.Name end)
        appendStrings(names, dictionaryMethodNames(ctx, common2.SliceDrop(constraints, 1)))
    end
  end
end

func appendStrings(left: Slice[String], right: Slice[String]) -> Slice[String]
  if right.Len() == 0 then left else
    switch right.Get(0)
      case None => appendStrings(left, common2.SliceDrop(right, 1))
      case Some(value) => appendStrings(left.Append(value), common2.SliceDrop(right, 1))
    end
  end
end

struct DictionaryParams
  Names: Slice[String]
  Types: Slice[String]
end

func addConstraintParams(constraints: Slice[ast2.Constraint], ctx: Ref[egCtx], names: Slice[String], types: Slice[String], fnTypeParams: Slice[String], receiverName: String) -> DictionaryParams
  if constraints.Len() == 0 then
    DictionaryParams { Names: names, Types: types }
  else
    switch constraints.Get(0)
      case None => addConstraintParams(common2.SliceDrop(constraints, 1), ctx, names, types, fnTypeParams, receiverName)
      case Some(constraint) =>
        let ifaceTps = switch ctx.interfaceTypeParams.Get(constraint.Name)
          case Some(value) => value
          case None => [] as Slice[String]
        end
        let methods = switch ctx.interfaceMethods.Get(constraint.Name)
          case Some(value) => value
          case None => [] as Slice[ast2.FuncSig]
        end
        addDictionaryMethods(common2.SliceDrop(constraints, 1), methods, ctx, names, types, constraint.Name, constraint.Args, ifaceTps, fnTypeParams, receiverName)
    end
  end
end

func addDictionaryMethods(rest: Slice[ast2.Constraint], methods: Slice[ast2.FuncSig], ctx: Ref[egCtx], names: Slice[String], types: Slice[String], constraintName: String, constraintArgs: Slice[ast2.TypeExpr], ifaceTps: Slice[String], fnTypeParams: Slice[String], receiverName: String) -> DictionaryParams
  if methods.Len() == 0 then
    addConstraintParams(rest, ctx, names, types, fnTypeParams, receiverName)
  else
    switch methods.Get(0)
      case None => addDictionaryMethods(rest, common2.SliceDrop(methods, 1), ctx, names, types, constraintName, constraintArgs, ifaceTps, fnTypeParams, receiverName)
      case Some(method) => addDictionaryMethod(rest, methods, method, ctx, names, types, constraintName, constraintArgs, ifaceTps, fnTypeParams, receiverName)
    end
  end
end

func addDictionaryMethod(rest: Slice[ast2.Constraint], methods: Slice[ast2.FuncSig], method: ast2.FuncSig, ctx: Ref[egCtx], names: Slice[String], types: Slice[String], constraintName: String, constraintArgs: Slice[ast2.TypeExpr], ifaceTps: Slice[String], fnTypeParams: Slice[String], receiverName: String) -> DictionaryParams
    let baseName = sanitizeIdent(method.Name) + "Fn"
    let paramName = ctxFreshBinding(ctx, baseName)
    ctx.constraintFuncs.Set(method.Name, paramName)
    ctx.dictionaryCallFuncs.Set(constraintName + ":" + constraintArgsKeyForCodegen(constraintArgs, fnTypeParams) + ":" + method.Name, paramName)
    # Maintain ordered lists for multi-constraint dispatch.
    let existingNames = switch ctx.constraintFuncNames.Get(method.Name)
      case Some(value) => value
      case None => [] as Slice[String]
    end
    ctx.constraintFuncNames.Set(method.Name, existingNames.Append(paramName))
    if constraintArgs.Len() > 0 then
      # Store MyGO type string for receiver type matching (dictFuncForMethod).
      switch constraintArgs.Get(0)
        case None => ()
        case Some(typeArgExpr) =>
          let typeArg = substituteTypeParamsMyGO(typeArgExpr, ifaceTps, constraintArgs)
          let existingTypes = switch ctx.constraintFuncArgTypes.Get(method.Name)
            case Some(value) => value
            case None => [] as Slice[String]
          end
          ctx.constraintFuncArgTypes.Set(method.Name, existingTypes.Append(typeArg))
          # Store MonoType for constraint arg matching (prefer inferred TVars).
          switch resolvedConstraintArgFor(ctx, method.Name, constraintRefForCtx(ctx, constraintName), constraintArgsKeyForCodegen(constraintArgs, fnTypeParams), receiverName)
            case None => ()
            case Some(constraintMono) =>
              let existingMonoTypes = switch ctx.constraintFuncArgMonoTypes.Get(method.Name)
                case Some(value) => value
                case None => [] as Slice[ast2.MonoType]
              end
              ctx.constraintFuncArgMonoTypes.Set(method.Name, existingMonoTypes.Append(constraintMono))
          end
      end
    end
    # Substitute interface type params with constraint type args so
    # e.g. Eq[A].Equals(A, A) with constraint Eq[T] yields func(T, T) bool.
    let argTypes = method.Params.Map(func(p: ast2.Param) -> String
      substituteTypeParamsInTypeExpr(p.Type, ifaceTps, constraintArgs, ctx.typeParams)
    end)
    let retStr = switch method.Ret
      case Some(t) => substituteTypeParamsInTypeExpr(t, ifaceTps, constraintArgs, ctx.typeParams)
      case None => ""
    end
    addDictionaryMethods(rest, common2.SliceDrop(methods, 1), ctx, names.Append(paramName), types.Append("func(" + common2.JoinStrings(argTypes, ", ") + ")" + retStr), constraintName, constraintArgs, ifaceTps, fnTypeParams, receiverName)
end

func resolvedConstraintArgFor(ctx: Ref[egCtx], methodName: String, constraint: typeinference2.MethodConstraintRef, argsKey: String, receiverName: String) -> Option[ast2.MonoType]
  switch ctx.pkgInfo
    case Some(pkgInfo) =>
      let key = typeinference2.MethodConstraintKey { Receiver: receiverName, Constraint: constraint, ArgsKey: argsKey, Method: methodName }
      let resolved = pkgInfo.ResolvedConstraintArgs.Get(key)
      switch resolved
        case Some(args) => args.Get(0)
        case None => None
      end
    case None => None
  end
end

func constraintArgsKeyForCodegen(args: Slice[ast2.TypeExpr], typeParams: Slice[String]) -> String
  constraintMonoArgsKey(typeArgsToMonos(args, typeParams, 0, [] as Slice[ast2.MonoType]), 0, "")
end

func typeArgsToMonos(args: Slice[ast2.TypeExpr], typeParams: Slice[String], index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= args.Len() then out else
    switch args.Get(index)
      case None => out
      case Some(item) => typeArgsToMonos(args, typeParams, index + 1, out.Append(typeinference2.TypeFromASTWithParams(item, typeParams)))
    end
  end
end

func constraintMonoArgsKey(args: Slice[ast2.MonoType], index: Int, out: String) -> String
  if index >= args.Len() then out else
    switch args.Get(index)
      case None => out
      case Some(item) =>
        let next = if out == "" then typeinference2.MonoStringFull(item) else out + "," + typeinference2.MonoStringFull(item) end
        constraintMonoArgsKey(args, index + 1, next)
    end
  end
end

# A named impl (for example ResultEq[A, E]) is distinct from an interface
# requirement (Eq[A]).  The classification is precomputed with the package
# index so dictionary lowering never rescans declarations.
func constraintRefForCtx(ctx: Ref[egCtx], name: String) -> typeinference2.MethodConstraintRef
  let namedImpl = switch ctx.namedImpls.Get(name)
    case Some(value) => value
    case None => false
  end
  if namedImpl then typeinference2.MethodConstraintRef.NamedImpl(name) else typeinference2.MethodConstraintRef.Interface(name) end
end

func funcTypeResultWithRet(paramStrs: Slice[String], retStr: String) -> String
  let base = "func(" + common2.JoinStrings(paramStrs, ", ") + ")"
  if retStr == "" then
    base
  else
    base + " " + retStr
  end
end

# One type-expr substitution recursion for both render styles: replace
# the interface's type parameters with the constraint arguments, then render
# the result as a Go type string (`mygo = false`) or a MyGO type string
# (`mygo = true`, e.g. `Slice[T]` instead of `[]T`) — used by the receiver
# matching in constraintFuncArgTypes.  The four public entry points below are
# thin wrappers selecting the style.
func substituteTypeParamsByStyle(typ: ast2.TypeExpr, ifaceTps: Slice[String], constraintArgs: Slice[ast2.TypeExpr], typeParams: Set[String], mygo: Bool) -> String
  switch typ
    case NamedType(name, args) then
      let index = findStringIndex(ifaceTps, name)
      if index >= 0 && index < constraintArgs.Len() then
        switch constraintArgs.Get(index)
          case Some(replacement) => if mygo then mygoTypeString(replacement) else goType(replacement, typeParams) end
          case None => if mygo then "any" else "any" end
        end
      else
        if args.Len() == 0 then
          if mygo then mygoTypeString(typ) else goType(typ, typeParams) end
        else
          let innerArgs = args.Map(func(a: ast2.TypeExpr) -> ast2.TypeExpr
            substituteTypeExpr(a, ifaceTps, constraintArgs)
          end)
          let replacedArgs = if mygo then mygoTypeExprStrings(innerArgs) else typeExprsToStrings(innerArgs, typeParams) end
          name + "[" + common2.JoinStrings(replacedArgs, ", ") + "]"
        end
      end
    end
    case FuncType(params, retRef) => funcTypeSubstitutedResultByStyle(params, retRef.value(), ifaceTps, constraintArgs, typeParams, mygo)
    case UnitType => if mygo then "()" else "struct{}" end
    case _ => if mygo then mygoTypeString(typ) else goType(typ, typeParams) end
  end
end

# Build a func type string after substituting interface type parameters.
func substituteTypeParamsInTypeExpr(typ: ast2.TypeExpr, ifaceTps: Slice[String], constraintArgs: Slice[ast2.TypeExpr], typeParams: Set[String]) -> String
  substituteTypeParamsByStyle(typ, ifaceTps, constraintArgs, typeParams, false)
end

func substituteTypeParamsMyGO(typ: ast2.TypeExpr, ifaceTps: Slice[String], constraintArgs: Slice[ast2.TypeExpr]) -> String
  substituteTypeParamsByStyle(typ, ifaceTps, constraintArgs, Set.New[String](), true)
end

func funcTypeSubstitutedResultByStyle(params: Slice[ast2.TypeExpr], ret: ast2.TypeExpr, ifaceTps: Slice[String], constraintArgs: Slice[ast2.TypeExpr], typeParams: Set[String], mygo: Bool) -> String
  let paramStrs = params.Map(func(p: ast2.TypeExpr) -> String
    substituteTypeParamsByStyle(p, ifaceTps, constraintArgs, typeParams, mygo)
  end)
  let retStr = substituteTypeParamsByStyle(ret, ifaceTps, constraintArgs, typeParams, mygo)
  if mygo then
    if retStr == "()" then
      "func(" + common2.JoinStrings(paramStrs, ", ") + ")"
    else
      "func(" + common2.JoinStrings(paramStrs, ", ") + ") -> " + retStr
    end
  else
    funcTypeResultWithRet(paramStrs, retStr)
  end
end

func funcTypeSubstitutedResult(params: Slice[ast2.TypeExpr], ret: ast2.TypeExpr, ifaceTps: Slice[String], constraintArgs: Slice[ast2.TypeExpr], typeParams: Set[String]) -> String
  funcTypeSubstitutedResultByStyle(params, ret, ifaceTps, constraintArgs, typeParams, false)
end

func funcTypeSubstitutedResultMyGO(params: Slice[ast2.TypeExpr], ret: ast2.TypeExpr, ifaceTps: Slice[String], constraintArgs: Slice[ast2.TypeExpr]) -> String
  funcTypeSubstitutedResultByStyle(params, ret, ifaceTps, constraintArgs, Set.New[String](), true)
end

func substituteTypeExpr(typ: ast2.TypeExpr, ifaceTps: Slice[String], constraintArgs: Slice[ast2.TypeExpr]) -> ast2.TypeExpr
  switch typ
    case NamedType(name, args) =>
      let index = findStringIndex(ifaceTps, name)
      if index >= 0 && index < constraintArgs.Len() then
        switch constraintArgs.Get(index)
          case Some(replacement) => replacement
          case None => typ
        end
      else
        if args.Len() == 0 then typ else
          ast2.TypeExpr.NamedType(name, args.Map(func(a: ast2.TypeExpr) -> ast2.TypeExpr substituteTypeExpr(a, ifaceTps, constraintArgs) end))
        end
      end
    case _ => typ
  end
end

func goReturnTypesFromOption(ret: Option[ast2.TypeExpr], typeParams: Set[String]) -> Slice[String]
  switch ret
    case Some(t) => goReturnTypes(t, typeParams)
    case None => [] as Slice[String]
  end
end
