func TestInferSuffixedNumericLiterals(t: Ref[testing.T]) -> ()
  let cases = [
    ("42i8", "Int8"),
    ("200u8", "UInt8"),
    ("-1000i16", "Int16"),
    ("60000u16", "UInt16"),
    ("-100000i32", "Int32"),
    ("3000000000u32", "UInt32"),
    ("9223372036854775807i64", "Int64"),
    ("18_446744073_709_551_615u", "UInt"),
    ("18_446744073_709_551_615u64", "UInt64"),
    ("3.14f32", "Float32"),
    ("2.718281828459045f64", "Float64"),
    ("3.14", "Float64"),
    ("42", "Int"),
  ]
  cases.Each(func(item: (String, String)) -> ()
    let (val_str, typ_str) = item
    let source = "package sample\n\nlet value = " + val_str + "\n"
    switch inferSourceTest(t, source)
      case None => ()
      case Some(info) then
        switch info.TypedDecls.Get(0)
          case None => t.Fatalf("typed declaration missing for %s", val_str)
          case Some(decl) then
            switch decl
              case LetDecl(bind) then
                switch bind.Value.Type
                  case Some(TCon(name)) then
                    if name != typ_str then
                      t.Errorf("%s inferred as %s, want %s", val_str, name, typ_str)
                    end
                  end
                  case _ => t.Errorf("%s inferred an unexpected non-named type", val_str)
                end
              end
              case _ => t.Fatalf("first declaration for %s is not LetDecl", val_str)
            end
          end
        end
      end
    end
  end)
end

func declsContainTypeAliasMyGo(decls: Slice[ast2.Decl], name: String) -> Bool
  decls.Fold(
    false,
    func(acc: Bool, decl: ast2.Decl) -> Bool
      if acc then
        acc
      else
        switch decl
          case TypeAliasDecl(aliasName, _, _) => aliasName == name
          case _ => false
        end
      end
    end
  )
end

func TestInferTypeAliasIsInterchangeableButDefinedTypeIsNot(t: Ref[testing.T]) -> ()
  switch inferSourceTest(
    t,
    "package sample\n\ntype UserID = Int\n\nfunc accepts(value: UserID) -> Int\n  value\nend\n\nfunc use() -> Int\n  accepts(1)\nend\n"
  )
    case None => ()
    case Some(_) => ()
  end
  switch inferSourceErrorTest(
    t,
    "package sample\n\ntype UserID Int\n\nfunc accepts(value: UserID) -> Int\n  0\nend\n\nfunc use() -> Int\n  accepts(1)\nend\n"
  )
    case None => ()
    case Some(_) => ()
  end
end

func externalPackageTest(
  t: Ref[testing.T],
  userSources: Slice[PkgDeclSource],
  externalSources: Slice[PkgDeclSource]
) -> Option[PackageInfo]
  switch InferPackageWithExternal(userSources, externalSources, [], [])
    case Err(msg) =>
      t.Fatalf("InferPackageWithExternal failed: %v", msg)
      None
    case Ok(info) => Some(info)
  end
end

func TestInferPackageWithExternalRetainsUserTypeAliasForCodegen(t: Ref[testing.T]) -> ()
  switch parser2.ParseFile("package sample\n\ntype Parser[A] = func(Int) -> A\n")
    case Err(msg) => t.Fatalf("ParseFile user failed: %v", msg)
    case Ok(userFile) then
      switch parser2.ParseFile("package prelude\n\nstruct External\n  Value: Int\nend\n")
        case Err(msg) => t.Fatalf("ParseFile external failed: %v", msg)
        case Ok(externalFile) then
          switch externalPackageTest(
            t,
            [PkgDeclSource { Path: "parsec.mygo", Decls: userFile.Decls }],
            [PkgDeclSource { Path: "prelude.mygo", Decls: externalFile.Decls }]
          )
            case None => ()
            case Some(info) then
              if !declsContainTypeAliasMyGo(info.TypedDecls, "Parser") then
                t.Fatalf("user type alias absent from TypedDecls: %v", info.TypedDecls)
              end
              if declsContainTypeAliasMyGo(info.ExternalTypedDecls, "Parser") then
                t.Fatalf("user type alias was classified as external: %v", info.ExternalTypedDecls)
              end
            end
          end
        end
      end
    end
  end
end

func TestInferPackageWithExternalAcceptsNamedEnumVariantInSliceField(t: Ref[testing.T]) -> ()
  let userSource = "package sample\n\nenum Content\n  Text { Text: String }\nend\n\nstruct Message\n  Content: Slice[Content]\nend\n\nfunc NewText(text: String) -> Message\n  Message {\n    Content: [Content.Text { Text: text }],\n  }\nend\n"
  switch parser2.ParseFile(userSource)
    case Err(msg) => t.Fatalf("ParseFile user failed: %v", msg)
    case Ok(userFile) then
      switch parser2.ParseFile("package prelude\n\nstruct External\n  Value: Int\nend\n")
        case Err(msg) => t.Fatalf("ParseFile external failed: %v", msg)
        case Ok(externalFile) then
          switch externalPackageTest(
            t,
            [PkgDeclSource { Path: "message.mygo", Decls: userFile.Decls }],
            [PkgDeclSource { Path: "prelude.mygo", Decls: externalFile.Decls }]
          )
            case None => ()
            case Some(_) => ()
          end
        end
      end
    end
  end
end

func TestInferPackageWithExternalExpandsForwardAliasInStructField(t: Ref[testing.T]) -> ()
  let userSource = "package sample\n\nenum Event\n  Started { RunID: RunID }\nend\n\nstruct Pending\n  RunID: RunID\nend\n\nfunc empty() -> Pending\n  Pending { RunID: \"\" }\nend\n\nfunc run(event: Event) -> Pending\n  switch event\n    case Started { RunID } => Pending { RunID: RunID }\n  end\nend\n"
  switch parser2.ParseFile(userSource)
    case Err(msg) => t.Fatalf("ParseFile user failed: %v", msg)
    case Ok(userFile) then
      switch parser2.ParseFile("package sample\n\ntype RunID = String\n")
        case Err(msg) => t.Fatalf("ParseFile aliases failed: %v", msg)
        case Ok(aliasFile) then
          switch parser2.ParseFile("package prelude\n\nstruct External\n  Value: Int\nend\n")
            case Err(msg) => t.Fatalf("ParseFile external failed: %v", msg)
            case Ok(externalFile) then
              switch externalPackageTest(
                t,
                [
                  PkgDeclSource { Path: "state.mygo", Decls: userFile.Decls },
                  PkgDeclSource { Path: "types.mygo", Decls: aliasFile.Decls },
                ],
                [PkgDeclSource { Path: "prelude.mygo", Decls: externalFile.Decls }]
              )
                case None => ()
                case Some(_) => ()
              end
            end
          end
        end
      end
    end
  end
end

func TestComposeSubstDefersResolutionAndPreservesPrecedence(t: Ref[testing.T]) -> ()
  let older = SubstFromEntries([SubstEntry { ID: 1, Type: ast2.MonoType.TVar(2) }])
  let newer = SubstFromEntries([SubstEntry { ID: 2, Type: ast2.MonoType.TCon("Int") }])
  let got = applySubst(composeSubst(newer, older), ast2.MonoType.TVar(1))
  if !ast2.MonoEqual(got, ast2.MonoType.TCon("Int")) then
    t.Fatalf("lazy substitution chain resolved to %v, want Int", got)
  end
  let older2 = SubstFromEntries([SubstEntry { ID: 1, Type: ast2.MonoType.TCon("String") }])
  let newer2 = SubstFromEntries([SubstEntry { ID: 1, Type: ast2.MonoType.TCon("Int") }])
  let got2 = applySubst(composeSubst(newer2, older2), ast2.MonoType.TVar(1))
  if !ast2.MonoEqual(got2, ast2.MonoType.TCon("String")) then
    t.Fatalf("composeSubst precedence changed: got %v, want String", got2)
  end
end
