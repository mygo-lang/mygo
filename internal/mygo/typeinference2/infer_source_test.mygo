func TestInferNamedStructEnumVariantRejectsUnknownOrDuplicatePatternField(
  t: Ref[testing.T]
) -> ()
  ["Circle { missing }", "Circle { radius, radius }"].Each(func(pattern: String) -> ()
    let source = """package sample

enum Shape
  Circle { radius: Float64 }
end

func area(shape: Shape) -> Float64
  switch shape
    case """ +
      pattern +
      " => 0.0\n  end\nend\n"
    switch inferSourceErrorTest(t, source)
      case None => ()
      case Some(_) => ()
    end
  end)
end

