func TestInferDistinctNamedGoTypesRemainIncompatible(t: Ref[testing.T]) -> ()
  let a = GoPackageEntry {
    Alias: "a",
    Path: "go:example.test/a",
    Origin: None,
    GoName: "a",
    Funcs: [],
    Types: [GoTypeSignature {
      TypeName: "Value",
      TypeParams: [],
      Methods: [],
      InterfaceMethods: [],
      Fields: [],
      Embeds: [],
      Underlying: "struct{N int}",
    }],
    Constants: [],
  }
  let b = GoPackageEntry {
    Alias: "b",
    Path: "go:example.test/b",
    Origin: None,
    GoName: "b",
    Funcs: [GoFuncSignature {
      Name: "Accept",
      Params: ["Value"],
      Results: [],
      Variadic: false,
      TypeParams: [],
    }],
    Types: [GoTypeSignature {
      TypeName: "Value",
      TypeParams: [],
      Methods: [],
      InterfaceMethods: [],
      Fields: [],
      Embeds: [],
      Underlying: "struct{N int}",
    }],
    Constants: [],
  }
  let source = "package sample\n\nimport a \"go:example.test/a\"\nimport b \"go:example.test/b\"\n\nfunc invalid(value: a.Value) -> ()\n  b.Accept(value)\nend\n"
  switch parser2.ParseFile(source)
    case Err(msg) => t.Fatalf("ParseFile failed: %v", msg)
    case Ok(file) then
      let assigned = mustAssignFileExprIDsForTest(t, file)
      switch InferPackageWithGoPackages(
        [PkgDeclSource { Path: "distinct-named-types.mygo", Decls: assigned.Decls }],
        [a, b]
      )
        case Ok(_) then
          t.Fatalf(
            "%s",
            "inference accepted distinct named Go types with identical underlying representations"
          )
        end
        case Err(_) => ()
      end
    end
  end
end

func TestGoPackageAliasLookupRejectsAmbiguousAliases(t: Ref[testing.T]) -> ()
  let packages = [
    GoPackageEntry {
      Alias: "mail",
      Path: "go:net/mail",
      Origin: None,
      GoName: "",
      Funcs: [],
      Types: [],
      Constants: [],
    },
    GoPackageEntry {
      Alias: "mail",
      Path: "go:example.test/mail",
      Origin: None,
      GoName: "",
      Funcs: [],
      Types: [],
      Constants: [],
    },
  ]
  if goPackageAliasIsUnambiguous(packages, "mail", "go:net/mail", 0) then
    t.Fatalf("%s", "expected duplicate Go import aliases with different paths to be ambiguous")
  end
end

func TestInferNamedGoInterfaceArgumentAssignability(t: Ref[testing.T]) -> ()
  registerGoInterfaceFixtureForTest(t, true, false)
  let readMethod = GoInterfaceMethodSignature {
    Name: "Read",
    PackagePath: "",
    Signature: "([]uint8) (int,error)",
  }
  let closeMethod = GoInterfaceMethodSignature {
    Name: "Close",
    PackagePath: "",
    Signature: "() error",
  }
  let targetRead = GoInterfaceMethodSignature {
    Name: "Read",
    PackagePath: "",
    Signature: "([]uint8) (int,error)",
  }
  let packages = [
    GoPackageEntry {
      Alias: "src",
      Path: "go:example.test/source",
      Origin: None,
      GoName: "",
      Funcs: [],
      Types: [GoTypeSignature {
        TypeName: "Source",
        TypeParams: [],
        Methods: [],
        InterfaceMethods: [
          readMethod,
          closeMethod,
        ],
        Fields: [],
        Embeds: [],
        Underlying: "interface {}",
      }],
      Constants: [],
    },
    GoPackageEntry {
      Alias: "dst",
      Path: "go:example.test/target",
      Origin: None,
      GoName: "",
      Funcs: [GoFuncSignature {
        Name: "Accept",
        Params: ["Reader"],
        Results: [],
        Variadic: false,
        TypeParams: [],
      }],
      Types: [GoTypeSignature {
        TypeName: "Reader",
        TypeParams: [],
        Methods: [],
        InterfaceMethods: [targetRead],
        Fields: [],
        Embeds: [],
        Underlying: "interface {}",
      }],
      Constants: [],
    },
  ]
  let source = "package sample\nimport src \"go:example.test/source\"\nimport dst \"go:example.test/target\"\nfunc forward(value: src.Source) -> ()\n  dst.Accept(value)\n  ()\nend\n"
  switch parser2.ParseFile(source)
    case Err(msg) => t.Fatalf("ParseFile failed: %v", msg)
    case Ok(file) then
      let fileWithIDs = mustAssignFileExprIDsForTest(t, file)
      switch InferPackageWithGoPackages(
        [PkgDeclSource { Path: "iface-assign.mygo", Decls: fileWithIDs.Decls }],
        packages
      )
        case Err(msg) => t.Fatalf("inference rejected assignable named Go interfaces: %v", msg)
        case Ok(_) => ()
      end
    end
  end
end

func TestInferNamedGoInterfaceArgumentRejectsMissingOrMismatchedMethods(t: Ref[testing.T]) -> ()
  registerGoInterfaceFixtureForTest(t, false, false)
  let sourceRead = GoInterfaceMethodSignature {
    Name: "Read",
    PackagePath: "",
    Signature: "([]uint8) (int,error)",
  }
  let targetRead = GoInterfaceMethodSignature {
    Name: "Read",
    PackagePath: "",
    Signature: "([]uint8) (int,error)",
  }
  let targetWrite = GoInterfaceMethodSignature {
    Name: "Write",
    PackagePath: "",
    Signature: "([]uint8) (int,error)",
  }
  let packages = [
    GoPackageEntry {
      Alias: "src",
      Path: "go:example.test/source",
      Origin: None,
      GoName: "",
      Funcs: [],
      Types: [GoTypeSignature {
        TypeName: "Source",
        TypeParams: [],
        Methods: [],
        InterfaceMethods: [sourceRead],
        Fields: [],
        Embeds: [],
        Underlying: "interface {}",
      }],
      Constants: [],
    },
    GoPackageEntry {
      Alias: "dst",
      Path: "go:example.test/target",
      Origin: None,
      GoName: "",
      Funcs: [GoFuncSignature {
        Name: "Accept",
        Params: ["Reader"],
        Results: [],
        Variadic: false,
        TypeParams: [],
      }],
      Types: [GoTypeSignature {
        TypeName: "Reader",
        TypeParams: [],
        Methods: [],
        InterfaceMethods: [
          targetRead,
          targetWrite,
        ],
        Fields: [],
        Embeds: [],
        Underlying: "interface {}",
      }],
      Constants: [],
    },
  ]
  let source = "package sample\nimport src \"go:example.test/source\"\nimport dst \"go:example.test/target\"\nfunc forward(value: src.Source) -> ()\n  dst.Accept(value)\n  ()\nend\n"
  switch parser2.ParseFile(source)
    case Err(msg) => t.Fatalf("ParseFile failed: %v", msg)
    case Ok(file) then
      let fileWithIDs = mustAssignFileExprIDsForTest(t, file)
      switch InferPackageWithGoPackages(
        [PkgDeclSource { Path: "iface-assign-invalid.mygo", Decls: fileWithIDs.Decls }],
        packages
      )
        case Ok(_) then
          t.Fatalf("%s", "inference accepted a source interface missing target method Write")
        end
        case Err(msg) then
          if !strings.Contains(msg, "call argument type mismatch") ||
            !strings.Contains(msg, "actual argument type") then
            t.Fatalf("interface mismatch diagnostic lacks argument context: %s", msg)
          end
        end
      end
      let badRead = GoInterfaceMethodSignature {
        Name: "Read",
        PackagePath: "",
        Signature: "([]uint8) (int,string)",
      }
      let badWrite = GoInterfaceMethodSignature {
        Name: "Write",
        PackagePath: "",
        Signature: "([]uint8) (int,error)",
      }
      let badPackages = [
        GoPackageEntry {
          Alias: "src",
          Path: "go:example.test/source",
          Origin: None,
          GoName: "",
          Funcs: [],
          Types: [GoTypeSignature {
            TypeName: "Source",
            TypeParams: [],
            Methods: [],
            InterfaceMethods: [
              badRead,
              badWrite,
            ],
            Fields: [],
            Embeds: [],
            Underlying: "interface {}",
          }],
          Constants: [],
        },
        GoPackageEntry {
          Alias: "dst",
          Path: "go:example.test/target",
          Origin: None,
          GoName: "",
          Funcs: [GoFuncSignature {
            Name: "Accept",
            Params: ["Reader"],
            Results: [],
            Variadic: false,
            TypeParams: [],
          }],
          Types: [GoTypeSignature {
            TypeName: "Reader",
            TypeParams: [],
            Methods: [],
            InterfaceMethods: [
              targetRead,
              targetWrite,
            ],
            Fields: [],
            Embeds: [],
            Underlying: "interface {}",
          }],
          Constants: [],
        },
      ]
      switch InferPackageWithGoPackages(
        [PkgDeclSource { Path: "iface-assign-badsig.mygo", Decls: fileWithIDs.Decls }],
        badPackages
      )
        case Ok(_) => t.Fatalf("%s", "inference accepted an incompatible method signature")
        case Err(_) => ()
      end
    end
  end
end

func TestInferGoMethodReturnsPackageLocalType(t: Ref[testing.T]) -> ()
  let pkg = contextFixture()
  let extended = GoPackageEntry {
    Alias: pkg.Alias,
    Path: pkg.Path,
    Origin: pkg.Origin,
    GoName: pkg.GoName,
    Funcs: pkg.Funcs,
    Types: pkg.Types.Append(GoTypeSignature {
      TypeName: "CancelContext",
      TypeParams: [],
      Methods: [GoFuncSignature {
        Name: "CancelFn",
        Params: [],
        Results: ["CancelFunc"],
        Variadic: false,
        TypeParams: [],
      }],
      InterfaceMethods: [],
      Fields: [],
      Embeds: [],
      Underlying: "struct{}",
    }),
    Constants: pkg.Constants,
  }
  let src = "package sample\n\nimport context \"go:context\"\n\nfunc use(c: Ref[context.CancelContext]) -> ()\n  let f = c.CancelFn()\n  f()\n  ()\nend\n"
  switch parser2.ParseFile(src)
    case Err(msg) => t.Fatalf("ParseFile failed: %v", msg)
    case Ok(file) then
      let fileWithIDs = mustAssignFileExprIDsForTest(t, file)
      switch InferPackageWithGoPackages(
        [PkgDeclSource { Path: "ffi-method.mygo", Decls: fileWithIDs.Decls }],
        [extended]
      )
        case Err(msg) then
          t.Fatalf("inference rejected method returning a package-local func type: %v", msg)
        end
        case Ok(_) => ()
      end
    end
  end
end
