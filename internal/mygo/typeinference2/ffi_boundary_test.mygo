package typeinference2

import strings "go:strings"
import testing "go:testing"
import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import parser2 "github.com/mygo-lang/mygo/internal/mygo/parser2"

func mustAssignFileExprIDsForTest(t: Ref[testing.T], file: ast2.File) -> ast2.File
  switch ast2.AssignFileExprIDs(file)
    case None then
      t.Fatalf("%s", "AssignFileExprIDs returned None")
      ast2.File { PackageName: "", Decls: [] }
    end
    case Some(assigned) => assigned
  end
end

func registerGoInterfaceFixtureForTest(
  t: Ref[testing.T],
  sourceHasWrite: Bool,
  sourceReadMismatch: Bool
) -> ()
  go[()] {
    code: """func() { registerGoInterfaceFixture(t, {sourceHasWrite}, {sourceReadMismatch}) }()"""
    in t = t
    in sourceHasWrite = sourceHasWrite
    in sourceReadMismatch = sourceReadMismatch
  }
end

# contextFixture mirrors what the real FFI loader returns for go:context
# (qualified result spellings), plus a bare package-local spelling used by the
# boundary paths under test.
func contextFixture() -> GoPackageEntry
  GoPackageEntry {
    Alias: "context",
    Path: "go:context",
    Origin: None,
    GoName: "",
    Funcs: [
      GoFuncSignature {
        Name: "Background",
        Params: [],
        Results: ["context.Context"],
        Variadic: false,
        TypeParams: [],
      },
      GoFuncSignature {
        Name: "WithTimeout",
        Params: ["context.Context", "time.Duration"],
        Results: [
          "context.Context",
          "CancelFunc",
        ],
        Variadic: false,
        TypeParams: [],
      },
    ],
    Types: [
      GoTypeSignature {
        TypeName: "Context",
        TypeParams: [],
        Methods: [],
        InterfaceMethods: [],
        Fields: [],
        Embeds: [],
        Underlying: "interface{Deadline() (time.Time, bool); Done() <-chan struct{}; Err() error; Value(key any) any}",
      },
      GoTypeSignature {
        TypeName: "CancelFunc",
        TypeParams: [],
        Methods: [],
        InterfaceMethods: [],
        Fields: [],
        Embeds: [],
        Underlying: "func()",
      },
    ],
    Constants: [],
  }
end

