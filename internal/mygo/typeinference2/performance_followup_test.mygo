func benchmarkEnvToSliceAt(b: Ref[testing.B], env: Env, index: Int) -> ()
  if index < b.N then
    benchmarkEnvResult = env.ToSlice()
    benchmarkEnvToSliceAt(b, env, index + 1)
  else
    ()
  end
end

func benchmarkEnvPutAt(b: Ref[testing.B], env: Env, scheme: Scheme, index: Int) -> ()
  if index < b.N then
    benchmarkEnvPutResult = envPut(env, "benchmark", scheme)
    benchmarkEnvPutAt(b, env, scheme, index + 1)
  else
    ()
  end
end

func benchmarkEnvGetAt(b: Ref[testing.B], env: Env, name: String, index: Int) -> ()
  if index < b.N then
    benchmarkEnvGetResult = envGet(env, name)
    benchmarkEnvGetAt(b, env, name, index + 1)
  else
    ()
  end
end
