package typeinference2

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import strings "go:strings"

# typeinference2 is the self-hosted, parser2-facing inference core.
# It implements a deliberately small HM-style pass over ast2. The production
# typeinference package is still richer; this package is the bootstrap lane.

# MonoType is now defined in ast2 package with the same variants plus TVariadic.

struct Scheme
  Bound: Slice[Int]
  # Predicates are the typeclass requirements carried by a polymorphic
  # binding. Keeping Body separate preserves the existing HM consumers while
  # making dictionary requirements explicit for codegen2.
  Predicates: Slice[Predicate]
  Body: ast2.MonoType
end

struct Predicate
  ClassName: String
  Args: Slice[ast2.MonoType]
end

struct QualifiedType
  Predicates: Slice[Predicate]
  Body: ast2.MonoType
end

struct EnvEntry
  Name: String
  Scheme: Scheme
end

# Env is a persistent lexical environment. Each extension owns a single
# binding layer (its Entry) and points at its parent, so adding a binding
# neither copies nor mutates an older environment snapshot.  Batch layers
# hold many bindings at once (an imported package's entire exported surface)
# with an O(1) index map, so a deep import graph never degrades lookups to a
# thousands-of-links chain walk.
struct Env
  Entry: Option[EnvEntry]
  Batch: Option[BatchBindings]
  Parent: Option[Ref[Env]]
end

# A batch layer's bindings: Index gives O(1) name lookup while Entries keeps
# the addition order for ToSlice / variant walks.  FreeVars is the union of
# free type variables across all entries, precomputed once at batch creation:
# envFreeVars runs per let binding, so re-deriving it over the whole imported
# surface each time would dominate inference for deep import graphs.
struct BatchBindings
  Index: Map[String, Scheme]
  Entries: Slice[EnvEntry]
  FreeVars: Slice[Int]
end

impl Env
  func New() -> Env
    Env { Entry: None, Batch: None, Parent: None }
  end

  # Put creates a child scope containing `name`. The parent remains intact,
  # which preserves shadowing and makes sibling inference branches independent.
  func Put(env: Env, name: String, scheme: Scheme) -> Env
    Env { Entry: Some(EnvEntry { Name: name, Scheme: scheme }), Batch: None, Parent: Some(Ref.new(env)) }
  end

  func Get(env: Env, name: String) -> Option[Scheme]
    switch env.Entry
      case Some(entry) =>
        if entry.Name == name then
          Some(entry.Scheme)
        else
          env.GetBatchOrParent(name)
        end
      case None => env.GetBatchOrParent(name)
    end
  end

  func GetBatchOrParent(env: Env, name: String) -> Option[Scheme]
    switch env.Batch
      case Some(batch) =>
        switch batch.Index.Get(name)
          case Some(scheme) => Some(scheme)
          case None =>
            switch env.Parent
              case Some(parent) => parent.value().Get(name)
              case None => None
            end
        end
      case None =>
        switch env.Parent
          case Some(parent) => parent.value().Get(name)
          case None => None
        end
    end
  end

  # ToSlice is a compatibility boundary for PackageInfo. Inference itself
  # stays on persistent Env layers; consumers receive the former newest-first
  # entry order only once, at package completion.
  func ToSlice(env: Env) -> Slice[EnvEntry]
    envToSliceInto(env, [])
  end
end

func envToSliceInto(env: Env, out: Slice[EnvEntry]) -> Slice[EnvEntry]
  let withBatch = switch env.Batch
    case Some(batch) => appendEnvEntries(out, batch.Entries)
    case None => out
  end
  let withEntry = switch env.Entry
    case Some(entry) => withBatch.Append(entry)
    case None => withBatch
  end
  # Batch nodes carry no Entry, so they must still descend into their Parent;
  # Env.New() terminates the walk via Parent == None.
  switch env.Parent
    case Some(parent) => envToSliceInto(parent.value(), withEntry)
    case None => withEntry
  end
end

func appendEnvEntries(left: Slice[EnvEntry], right: Slice[EnvEntry]) -> Slice[EnvEntry]
  if right.Len() == 0 then
    left
  else
    appendEnvEntries(left.Append(right.Get(0).UnwrapOr(EnvEntry { Name: "", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TUnit } })), sliceDrop(right, 1))
  end
end

struct FieldEntry
  TypeName: String
  FieldName: String
  Type: ast2.MonoType
end

enum Symbol
  StructField(String, String, ast2.MonoType)
  GoMethod(String, String, GoFuncSignature)
  ImplMethod(String, String, Scheme)
  # EnumVariant captures the type-name + variant-name + constructor type for
  # an enum variant constructor.  FieldExpr on an enum type (e.g. `Decl.ImportDecl`)
  # has to look the variant up in the symbol table because the constructor has
  # at least one field and therefore its scheme body is a TFunc, not a TCon.
  EnumVariant(String, String, ast2.MonoType)
end

struct SubstEntry
  ID: Int
  Type: ast2.MonoType
end

# Subst is a persistent substitution layer. Entries and Index contain only
# this layer's bindings; earlier bindings are reached through Fallbacks.
# This prevents sibling inference branches from observing map mutations
# without copying the complete substitution at each update or composition.
#
# Index is None for single-entry prepend/append layers (their Entries are
# scanned linearly, avoiding a one-entry map allocation per binding) and
# Some(map) for flattened substitutions produced by substFromEntries, where
# the eager index keeps lookups constant-time.
struct Subst
  Entries: Slice[SubstEntry]
  Index: Option[Map[Int, ast2.MonoType]]
  Fallbacks: Slice[Ref[Subst]]
  IndexFirst: Bool
  # MaxID is the maximum binding key in this layer and all fallback layers.
  # Keeping it cached makes fresh-variable collision checks constant time.
  MaxID: Int
end

# ---------------------------------------------------------------------------
# Package-level inference context
# ---------------------------------------------------------------------------

# PkgInfo holds package-level AST declarations for enum/struct/interface
# lookups during type inference. It mirrors the old typeinference.PkgInfo
# without the per-type-name maps — mygo enums require pattern matching over
# the full declaration slice instead.
struct PkgInfo
  Dir: String
  Name: String
  Decls: Slice[ast2.Decl]
end

# MyGoPackageInfo records the exported surface of an imported MyGO package.
# Decls holds the raw AST declarations from the imported package.
# Qualified access like `ast2.SourcePos { ... }` resolves by looking up the
# package alias in MyGoPackageCache and scanning its Decls for the target
# type name.
struct MyGoPackageInfo
  Alias: String
  Path: String
  Decls: Slice[ast2.Decl]
end

# InferState holds inference state: fresh variable counter, package info for
# lookups, and (optionally) a TypedInfo accumulator that records every
# successfully inferred expression type.  Callers that do not need expression
# granularity can leave TypedInfo as None.
struct InferState
  FreshVarID: Int
  PkgInfo: Option[PkgInfo]
  GoPackages: Slice[GoPackageEntry]
  MyGoPackages: Slice[MyGoPackageInfo]
  MyGoPackageCache: Slice[MyGoPackageInfo]
  Symbols: Slice[Symbol]
  # SymbolIndex resolves `TypeName::Field` selectors in constant time instead
  # of a linear scan over the whole Symbols slice.  Struct fields overwrite
  # (they are prepended to the slice) while impl methods insert only when the
  # key is absent (they are appended), mirroring the slice's lookup order.
  SymbolIndex: Map[String, Symbol]
  ActiveConstraints: Slice[Predicate]
  NamedImpls: Slice[String]
  ResolvedConstraintArgs: Map[MethodConstraintKey, Slice[ast2.MonoType]]
end

struct InferResult
  Type: ast2.MonoType
  Predicates: Slice[Predicate]
  Subst: Subst
  State: InferState
end

# PackageInfo contains the inferred types for a whole package.
# The Env holds all top-level bindings (functions, types, etc.) visible
# across files, and Fields stores struct field type information for
# field access resolution. GoPackages records imported Go package info.
enum MethodConstraintRef
  Interface(String)
  NamedImpl(String)
end

struct MethodConstraintKey
  Receiver: String
  Constraint: MethodConstraintRef
  ArgsKey: String
  Method: String
end

struct PackageInfo
  Env: Slice[EnvEntry]
  Fields: Slice[FieldEntry]
  GoPackages: Slice[GoPackageEntry]
  Instances: Slice[Instance]
  Solver: Solver
  TypedDecls: Slice[ast2.Decl]
  ExternalTypedDecls: Slice[ast2.Decl]
  # Typed declarations retain their originating source file so downstream
  # codegen never has to recover ownership from declaration names or shapes.
  TypedDeclSources: Slice[PkgDeclSource]
  ExternalTypedDeclSources: Slice[PkgDeclSource]
  ResolvedConstraintArgs: Map[MethodConstraintKey, Slice[ast2.MonoType]]
end

# GoPackageEntry records an imported Go package with its alias and type info.
struct GoPackageEntry
  Alias: String
  Path: String
  Funcs: Slice[GoFuncSignature]
  Types: Slice[GoTypeSignature]
end

# GoFuncSignature is populated by the bootstrap entry from go/types and is
# passed unchanged to codegen2 for FFI-specific lowering.
struct GoFuncSignature
  Name: String
  Params: Slice[String]
  Results: Slice[String]
  Variadic: Bool
end

# GoTypeSignature is populated by the bootstrap entry from go/types and carries
# a Go type alias (alias.TypeName) plus the exported methods on that type
# (alias.Methods).  This lets the bootstrap type checker resolve qualified
# `pkg.Type` references and `recv.Method` selectors against real Go packages
# (e.g. `testing.T.Fatal`) without special-casing.
struct GoTypeSignature
  TypeName: String
  TypeParams: Slice[String]
  Methods: Slice[GoFuncSignature]
end

struct DeclInfer
  Env: Env
  Fields: Slice[FieldEntry]
  State: InferState
  TypedDecl: Option[ast2.Decl]
end

struct ArgsResult
  Types: Slice[ast2.MonoType]
  Exprs: Slice[ast2.Expr]
  Predicates: Slice[Predicate]
  Subst: Subst
  State: InferState
end

struct BlockInferStep
  Result: InferResult
  Env: Env
  Stmt: ast2.Stmt
end

# PkgDecls bundles all file declarations in a package.
struct PkgDecls
  Decls: Slice[ast2.Decl]
end

# PkgDeclSource is a single file's declarations with its path.
struct PkgDeclSource
  Path: String
  Decls: Slice[ast2.Decl]
end

func NewInferState() -> InferState
  InferState {
    FreshVarID: 1,
    PkgInfo: None,
    GoPackages: [] as Slice[GoPackageEntry],
    MyGoPackages: [] as Slice[MyGoPackageInfo],
    MyGoPackageCache: [] as Slice[MyGoPackageInfo],
    Symbols: [] as Slice[Symbol],
    SymbolIndex: {},
    ActiveConstraints: [] as Slice[Predicate],
    NamedImpls: [] as Slice[String],
    ResolvedConstraintArgs: {},
  }
end

# Copy an InferState with an updated FreshVarID, preserving all other fields.
# This avoids repeating the full struct literal at every fresh-variable site.
func withFreshID(state: InferState, id: Int) -> InferState
  InferState {
    FreshVarID: id,
    PkgInfo: state.PkgInfo,
    GoPackages: state.GoPackages,
    MyGoPackages: state.MyGoPackages,
    MyGoPackageCache: state.MyGoPackageCache,
    Symbols: state.Symbols,
    SymbolIndex: state.SymbolIndex,
    ActiveConstraints: state.ActiveConstraints,
    NamedImpls: state.NamedImpls,
    ResolvedConstraintArgs: state.ResolvedConstraintArgs,
  }
end

func withActiveConstraints(state: InferState, constraints: Slice[Predicate]) -> InferState
  InferState {
    FreshVarID: state.FreshVarID,
    PkgInfo: state.PkgInfo,
    GoPackages: state.GoPackages,
    MyGoPackages: state.MyGoPackages,
    MyGoPackageCache: state.MyGoPackageCache,
    Symbols: state.Symbols,
    SymbolIndex: state.SymbolIndex,
    ActiveConstraints: constraints,
    NamedImpls: state.NamedImpls,
    ResolvedConstraintArgs: state.ResolvedConstraintArgs,
  }
end

func goBuiltinSymbols() -> Slice[Symbol]
  # Go's built-in error interface has Error() string method.
  let errorMethod = GoFuncSignature { Name: "Error", Params: [] as Slice[String], Results: ["string"] as Slice[String], Variadic: false }
  [Symbol.GoMethod("Error", "Error", errorMethod)] as Slice[Symbol]
end

func goSymbolsFromPackages(packages: Slice[GoPackageEntry], out: Slice[Symbol]) -> Slice[Symbol]
  if packages.Len() == 0 then out else
    let pkg = packages.Get(0).UnwrapOr(GoPackageEntry { Alias: "", Path: "", Funcs: [] as Slice[GoFuncSignature], Types: [] as Slice[GoTypeSignature] })
    goSymbolsFromPackages(sliceDrop(packages, 1), goSymbolsFromTypes(pkg.Alias, pkg.Types, out))
  end
end

func goSymbolsFromTypes(alias: String, types: Slice[GoTypeSignature], out: Slice[Symbol]) -> Slice[Symbol]
  if types.Len() == 0 then out else
    let t = types.Get(0).UnwrapOr(GoTypeSignature { TypeName: "", TypeParams: [] as Slice[String], Methods: [] as Slice[GoFuncSignature] })
    goSymbolsFromTypes(alias, sliceDrop(types, 1), goMethodsFromSigs(goPackageMemberName(alias, t.TypeName), t.Methods, out))
  end
end

# A dot-import exposes members directly, while a regular import exposes them
# through its source alias.
func goPackageMemberName(alias: String, name: String) -> String
  if alias == "." then name else alias + "." + name end
end

func goMethodsFromSigs(typeName: String, methods: Slice[GoFuncSignature], out: Slice[Symbol]) -> Slice[Symbol]
  if methods.Len() == 0 then out else
    let m = methods.Get(0).UnwrapOr(GoFuncSignature { Name: "", Params: [] as Slice[String], Results: [] as Slice[String], Variadic: false })
    goMethodsFromSigs(typeName, sliceDrop(methods, 1), out.Prepend(Symbol.GoMethod(typeName, m.Name, m)))
  end
end

func buildSymbolTable(goPkgs: Slice[GoPackageEntry], decls: Slice[ast2.Decl], env: Env) -> Slice[Symbol]
  let builtinSyms = goBuiltinSymbols()
  let goSyms = goSymbolsFromPackages(goPkgs, [] as Slice[Symbol])
  let declSyms = collectDeclSymbols(decls, env, [] as Slice[Symbol])
  concatSymbols(concatSymbols(builtinSyms, goSyms), declSyms)
end

# Build the constant-time symbol index from an ordered symbol list.  The list
# is scanned in slice order and the first occurrence of each `TypeName::Field`
# key wins, mirroring the former linear findSymbol scan over Symbols.
func symbolIndexFromSlice(symbols: Slice[Symbol], index: Map[String, Symbol]) -> Map[String, Symbol]
  if symbols.Len() == 0 then index else
    let s = symbols.Get(0).UnwrapOr(Symbol.StructField("", "", ast2.MonoType.TUnit))
    let key = symbolKey(symbolTypeName(s), symbolFieldName(s))
    switch index.Get(key)
      case None then
        index.Set(key, s)
        symbolIndexFromSlice(sliceDrop(symbols, 1), index)
      end
      case Some(_) => symbolIndexFromSlice(sliceDrop(symbols, 1), index)
    end
  end
end

# Newly declared struct fields are prepended to the symbol slice, so they
# shadow earlier entries.  Reproduce that precedence by overwriting the key.
func symbolIndexPrepend(index: Map[String, Symbol], symbols: Slice[Symbol]) -> Map[String, Symbol]
  if symbols.Len() == 0 then index else
    let s = symbols.Get(0).UnwrapOr(Symbol.StructField("", "", ast2.MonoType.TUnit))
    index.Set(symbolKey(symbolTypeName(s), symbolFieldName(s)), s)
    symbolIndexPrepend(index, sliceDrop(symbols, 1))
  end
end

# Impl methods are appended to the symbol slice, so earlier entries keep
# lookup priority.  Reproduce that precedence by inserting only when absent.
func symbolIndexAppend(index: Map[String, Symbol], symbols: Slice[Symbol]) -> Map[String, Symbol]
  if symbols.Len() == 0 then index else
    let s = symbols.Get(0).UnwrapOr(Symbol.StructField("", "", ast2.MonoType.TUnit))
    let key = symbolKey(symbolTypeName(s), symbolFieldName(s))
    switch index.Get(key)
      case None =>
        index.Set(key, s)
        symbolIndexAppend(index, sliceDrop(symbols, 1))
      case Some(_) => symbolIndexAppend(index, sliceDrop(symbols, 1))
    end
  end
end

func symbolTypeName(s: Symbol) -> String
  switch s
    case StructField(tn, _, _) => tn
    case GoMethod(tn, _, _) => tn
    case ImplMethod(tn, _, _) => tn
    case EnumVariant(tn, _, _) => tn
  end
end

func symbolFieldName(s: Symbol) -> String
  switch s
    case StructField(_, fn, _) => fn
    case GoMethod(_, mn, _) => mn
    case ImplMethod(_, mn, _) => mn
    case EnumVariant(_, vn, _) => vn
  end
end

# "::" cannot appear in MyGO identifiers, so `TypeName::Field` is injective
# even when TypeName itself is qualified (`ps.Reply`).
func symbolKey(typeName: String, field: String) -> String
  typeName + "::" + field
end

func collectDeclSymbols(decls: Slice[ast2.Decl], env: Env, out: Slice[Symbol]) -> Slice[Symbol]
  if decls.Len() == 0 then out else
    let d = decls.Get(0).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    let rest = collectDeclSymbols(sliceDrop(decls, 1), env, out)
    switch d
      case StructDecl(name, tps, fields) =>
        let syms = structFieldSymbolsInEnv(name, fields, tps, env, [] as Slice[Symbol])
        concatSymbols(rest, syms)
      case EnumDecl(name, tps, variants) =>
        let syms = enumVariantSymbolsInEnv(name, variants, tps, env, [] as Slice[Symbol])
        concatSymbols(rest, syms)
      case ImplDecl(tps, target, iface, methods) =>
        let receiverName = implReceiverName(target, iface)
        let syms = implMethodSymbols(receiverName, tps, methods, env, [] as Slice[Symbol])
        concatSymbols(rest, syms)
      case _ => rest
    end
  end
end

# enumVariantSymbols seeds one EnumVariant symbol per variant of the enum so
# that FieldExpr on an enum-typed receiver can resolve `TypeName.VariantName`
# via findSymbol.  Mirrors predeclareEnum's constructor-type computation.
func enumVariantSymbolsInEnv(enumName: String, variants: Slice[ast2.Variant], tps: Slice[String], env: Env, out: Slice[Symbol]) -> Slice[Symbol]
  if variants.Len() == 0 then out else
    let v = variants.Get(0).UnwrapOr(ast2.Variant { Name: "", Fields: [] as Slice[ast2.TypeExpr] })
    let enumType = tCon(enumName, typeParamsAsTypes(tps, 1))
    let constructorType = if v.Fields.Len() == 0 then enumType else ast2.MonoType.TFunc(typeArgsFromASTInEnvWithParamsList(v.Fields, tps, env, NewInferState()), Ref.new(enumType)) end
    enumVariantSymbolsInEnv(enumName, sliceDrop(variants, 1), tps, env, out.Prepend(Symbol.EnumVariant(enumName, v.Name, constructorType)))
  end
end

func structFieldSymbolsInEnv(typeName: String, fields: Slice[ast2.Field], typeParams: Slice[String], env: Env, out: Slice[Symbol]) -> Slice[Symbol]
  if fields.Len() == 0 then out else
    let f = fields.Get(0).UnwrapOr(ast2.Field { Name: "", Type: ast2.TypeExpr.UnitType, Tag: None })
    let fieldType = typeFromASTInEnvWithParams(f.Type, typeParams, env, NewInferState())
    structFieldSymbolsInEnv(typeName, sliceDrop(fields, 1), typeParams, env, out.Prepend(Symbol.StructField(typeName, f.Name, fieldType)))
  end
end

# InferFile runs type inference on a single file in isolation.
# This is a convenience wrapper around InferPackage for single-file packages.
func InferFile(file: ast2.File) -> Result[PackageInfo, String]
  let goPkgImports = collectGoPackageImports(file.Decls)
  let mygoImports = collectMyGoPackageImports(file.Decls)
  # Seed Go-FFI and MyGO package types into the env *before* predeclaring
  # functions.  See InferPackageWithExternal for the full rationale.
  let envWithGoPkgs = seedGoPackageEnv(goPkgImports, initialEnv())
  let envWithMyGoPkgs = seedMyGoPackageEnv(mygoImports, [] as Slice[MyGoPackageInfo], goPkgImports, envWithGoPkgs)
  let envWithPredecl = predeclareImplMethods(file.Decls, predeclareFunctions(file.Decls, envWithMyGoPkgs))
  let initialSymbols = buildSymbolTable(goPkgImports, file.Decls, envWithMyGoPkgs)
  let state = InferState {
    FreshVarID: 1,
    PkgInfo: None,
    GoPackages: goPkgImports,
    MyGoPackages: [] as Slice[MyGoPackageInfo],
    MyGoPackageCache: [] as Slice[MyGoPackageInfo],
    Symbols: initialSymbols,
    SymbolIndex: symbolIndexFromSlice(initialSymbols, {}),
    ActiveConstraints: [] as Slice[Predicate],
    NamedImpls: namedImplNames(file.Decls, 0, [] as Slice[String]),
    ResolvedConstraintArgs: {},
  }
  switch inferDecls(file.Decls, envWithPredecl, [], state)
    case Ok(info) =>
      let collected = collectInstances(file.Decls)
      let instances = mergeBuiltInInstances(collected)
      let solver = solverFromInstances(instances)
      Ok(PackageInfo {
        Env: resolveEnvironment(solver, info.Env),
        Fields: info.Fields,
        GoPackages: goPkgImports,
        Instances: instances,
        Solver: solver,
        TypedDecls: info.TypedDecls,
        ExternalTypedDecls: [] as Slice[ast2.Decl],
        TypedDeclSources: [PkgDeclSource { Path: file.SourceName, Decls: info.TypedDecls }],
        ExternalTypedDeclSources: [],
        ResolvedConstraintArgs: info.ResolvedConstraintArgs,
      })
    case Err(msg) => Err(withExpressionSourceName(msg, file.SourceName))
  end
end

# InferPackage runs HM type inference across all files in a package.
func InferPackage(files: Slice[PkgDeclSource]) -> Result[PackageInfo, String]
  InferPackageWithGoPackages(files, collectGoPackageImports(flattenPkgDecls(files, 0, [] as Slice[ast2.Decl])))
end

func InferPackageWithGoPackages(files: Slice[PkgDeclSource], goPkgImports: Slice[GoPackageEntry]) -> Result[PackageInfo, String]
  let allDecls = flattenPkgDecls(files, 0, [] as Slice[ast2.Decl])
  let mygoImports = collectMyGoPackageImports(allDecls)
  # Seed Go-FFI and MyGO package types into the env *before* predeclaring
  # functions.  See InferPackageWithExternal for the full rationale.
  let envWithGoPkgs = seedGoPackageEnv(goPkgImports, initialEnv())
  let envWithMyGoPkgs = seedMyGoPackageEnv(mygoImports, [] as Slice[MyGoPackageInfo], goPkgImports, envWithGoPkgs)
  let envWithPredecl = predeclareAllFunctions(allDecls, envWithMyGoPkgs)
  let initialSymbols = buildSymbolTable(goPkgImports, allDecls, envWithMyGoPkgs)
  let state = InferState {
    FreshVarID: 1,
    PkgInfo: None,
    GoPackages: goPkgImports,
    MyGoPackages: [] as Slice[MyGoPackageInfo],
    MyGoPackageCache: [] as Slice[MyGoPackageInfo],
    Symbols: initialSymbols,
    SymbolIndex: symbolIndexFromSlice(initialSymbols, {}),
    ActiveConstraints: [] as Slice[Predicate],
    NamedImpls: namedImplNames(allDecls, 0, [] as Slice[String]),
    ResolvedConstraintArgs: {},
  }
  let result = inferDecls(allDecls, envWithPredecl, [], state)
  switch result
    case Ok(info) =>
      let collected = collectInstances(allDecls)
      let instances = mergeBuiltInInstances(collected)
      let solver = solverFromInstances(instances)
      Ok(PackageInfo {
        Env: resolveEnvironment(solver, info.Env),
        Fields: info.Fields,
        GoPackages: goPkgImports,
        Instances: instances,
        Solver: solver,
        TypedDecls: info.TypedDecls,
        ExternalTypedDecls: [] as Slice[ast2.Decl],
        TypedDeclSources: buildTypedDeclSources(files, info.TypedDecls, 0).Sources,
        ExternalTypedDeclSources: [],
        ResolvedConstraintArgs: info.ResolvedConstraintArgs,
      })
    case Err(msg) =>
      let source = files.Get(0).UnwrapOr(PkgDeclSource { Path: "<input>", Decls: [] as Slice[ast2.Decl] }).Path
      Err(withExpressionSourceName(msg, source))
  end
end

func InferPackageWithExternal(files: Slice[PkgDeclSource], external: Slice[PkgDeclSource], goPkgImports: Slice[GoPackageEntry], myGoPkgImports: Slice[MyGoPackageInfo]) -> Result[PackageInfo, String]
  # Merge user and external declarations for inference, then separate results.
  # External decls participate in type inference (so prelude types are visible)
  # but their typed forms go into ExternalTypedDecls instead of TypedDecls.
  let allDecls = flattenPkgDecls(files, 0, [] as Slice[ast2.Decl])
  let extDecls = flattenPkgDecls(external, 0, [] as Slice[ast2.Decl])
  let combined = appendDecls(allDecls, extDecls)
  # Collect MyGO imports (non-go:) so each import's top-level type and
  # function can be registered under `alias.Name` in the environment.  The
  # env entries wrap each member in TQualifiedName so qualified access such
  # as `ps.ParseInput(...)` resolves through the normal env lookup path.
  let mygoAliases = collectMyGoPackageImports(allDecls)
  # Seed Go-FFI and MyGO package types into the env *before* predeclaring
  # functions.  This way `Ref[testing.T]` in a function signature sees the
  # `testing.T` env entry and wraps the inner type in TQualifiedName; without
  # it, the inner type falls through to a bare TCon("T") and field lookup
  # `t.Fatal` later fails because receiverQualifiedName cannot recover the
  # qualified `testing.T` key used by the symbol table.
  let envWithGoPkgs = seedGoPackageEnv(goPkgImports, initialEnv())
  let envWithMyGoPkgs = seedMyGoPackageEnv(mygoAliases, myGoPkgImports, goPkgImports, envWithGoPkgs)
  let envWithPredecl = predeclareAllFunctions(combined, envWithMyGoPkgs)
  let userSyms = buildSymbolTable(goPkgImports, allDecls, envWithMyGoPkgs)
  let extSyms = buildSymbolTable([] as Slice[GoPackageEntry], extDecls, envWithMyGoPkgs)
  let importedStructSymbols = myGoPackageStructSymbols(myGoPkgImports, goPkgImports, [] as Slice[Symbol])
  let initialSymbols = concatSymbols(concatSymbols(userSyms, extSyms), importedStructSymbols)
  let state = InferState {
    FreshVarID: 1,
    PkgInfo: None,
    GoPackages: goPkgImports,
    MyGoPackages: [] as Slice[MyGoPackageInfo],
    MyGoPackageCache: myGoPkgImports,
    Symbols: initialSymbols,
    SymbolIndex: symbolIndexFromSlice(initialSymbols, {}),
    ActiveConstraints: [] as Slice[Predicate],
    NamedImpls: namedImplNames(combined, 0, [] as Slice[String]),
    ResolvedConstraintArgs: {},
  }
  let result = inferDecls(combined, envWithPredecl, [], state)
  switch result
    case Ok(info) =>
      let collected = collectInstances(allDecls)
      let instances = mergeBuiltInInstances(collected)
      let solver = solverFromInstances(instances)
      # Split typed declarations by the original source sequence.  This is
      # positional, not name-based, so identical impl shapes remain assigned
      # to the file that supplied them.
      let userTyped = buildTypedDeclSources(files, info.TypedDecls, 0)
      let externalTyped = buildTypedDeclSources(external, info.TypedDecls, userTyped.Next)
      Ok(PackageInfo {
        Env: resolveEnvironment(solver, info.Env),
        Fields: info.Fields,
        GoPackages: goPkgImports,
        Instances: instances,
        Solver: solver,
        TypedDecls: flattenPkgDecls(userTyped.Sources, 0, [] as Slice[ast2.Decl]),
        ExternalTypedDecls: flattenPkgDecls(externalTyped.Sources, 0, [] as Slice[ast2.Decl]),
        TypedDeclSources: userTyped.Sources,
        ExternalTypedDeclSources: externalTyped.Sources,
        ResolvedConstraintArgs: info.ResolvedConstraintArgs,
      })
    case Err(msg) =>
      Err(withExpressionSourceName(msg, "<input>"))
  end
end

# ---------------------------------------------------------------------------
# Imported-package inference cache
# ---------------------------------------------------------------------------

# Process-wide cache of imported-package inference artifacts keyed by
# `path::alias`.  The bootstrap sync compiles packages that repeatedly import
# the same heavy packages (ast2, typeinference2, codegen2, ...); caching their
# member schemes and struct symbols avoids re-deriving the same declaration
# surface once per importer, which previously made typeinference2 superlinear
# in the number of referenced packages.
var importedPackageCache: Map[String, ImportedPackageCacheEntry] = {}

struct ImportedPackageCacheEntry
  # The package's declarations interpreted in its own import context: bare
  # member names -> Scheme.  Self-contained (built on importedPackageEnv), so
  # it is valid for any importer.
  PrivateEnv: Env
  # The alias-qualified projection (`alias.Name` -> Scheme plus bare enum
  # variant constructors) in addition order.  Layered onto an importer as a
  # single batch env layer with an O(1) index.
  Exported: Slice[EnvEntry]
  # Struct fields registered as symbols under `alias.TypeName`, in the same
  # order myGoPackageStructDeclSymbols produces.
  StructSymbols: Slice[Symbol]
  # Cached collectMyGoTypeNames result.
  TypeNames: Slice[String]
end

# Build or fetch the cached inference artifacts for an imported package.
# Packages without declarations (unresolved bootstrap stubs) contribute
# nothing and are never cached.
func cachedImportedPackage(pkg: MyGoPackageInfo, alias: String, packages: Slice[MyGoPackageInfo], goPkgs: Slice[GoPackageEntry]) -> ImportedPackageCacheEntry
  if pkg.Decls.Len() == 0 then
    ImportedPackageCacheEntry { PrivateEnv: Env.New(), Exported: [] as Slice[EnvEntry], StructSymbols: [] as Slice[Symbol], TypeNames: [] as Slice[String] }
  else
    let key = pkg.Path + "::" + alias
    switch importedPackageCache.Get(key)
      case Some(entry) => entry
      case None =>
        let built = buildImportedPackageCacheEntry(pkg, alias, packages, goPkgs)
        importedPackageCache.Set(key, built)
        built
    end
  end
end

func buildImportedPackageCacheEntry(pkg: MyGoPackageInfo, alias: String, packages: Slice[MyGoPackageInfo], goPkgs: Slice[GoPackageEntry]) -> ImportedPackageCacheEntry
  let typeNames = collectMyGoTypeNames(pkg.Decls, 0, [] as Slice[String])
  let pkgEnv = importedPackageEnv(pkg, packages, goPkgs)
  let privateEnv = seedMyGoPackageDecls(pkg, 0, pkgEnv, packages)
  let exported = exportMyGoPackageEntries(pkg.Decls, privateEnv, [] as Slice[EnvEntry], alias, pkg.Path, typeNames)
  let state = InferState { FreshVarID: 1, PkgInfo: None, GoPackages: goPkgs, MyGoPackages: packages, MyGoPackageCache: packages, Symbols: [], SymbolIndex: {}, ActiveConstraints: [], NamedImpls: [], ResolvedConstraintArgs: {} }
  let structSymbols = myGoPackageStructDeclSymbols(pkg.Decls, alias, pkg.Path, typeNames, pkgEnv, state, [] as Slice[Symbol])
  ImportedPackageCacheEntry { PrivateEnv: privateEnv, Exported: exported, StructSymbols: structSymbols, TypeNames: typeNames }
end

# Layer a batch of bindings (an imported package's exported surface) onto an
# importer environment as a single layer.  Lookups hit the O(1) index map, so
# a deep import graph costs one map probe per envGet instead of a
# thousands-of-links chain walk.
func envPutBatch(env: Env, entries: Slice[EnvEntry]) -> Env
  if entries.Len() == 0 then env else
    let index: Map[String, Scheme] = {}
    Env { Entry: None, Batch: Some(BatchBindings { Index: batchIndexFromEntries(entries, index, 0), Entries: entries, FreeVars: batchFreeVars(entries, [], 0) }), Parent: Some(Ref.new(env)) }
  end
end

func batchIndexFromEntries(entries: Slice[EnvEntry], index: Map[String, Scheme], position: Int) -> Map[String, Scheme]
  if position >= entries.Len() then index else
    let entry = entries.Get(position).UnwrapOr(EnvEntry { Name: "", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TUnit } })
    index.Set(entry.Name, entry.Scheme)
    batchIndexFromEntries(entries, index, position + 1)
  end
end

# Union of free type variables across a batch's entries, mirroring the
# per-entry logic of envFreeVars so generalization treats imported members
# exactly as it did when they were individual env layers.
func batchFreeVars(entries: Slice[EnvEntry], out: Slice[Int], index: Int) -> Slice[Int]
  if index >= entries.Len() then out else
    let item = entries.Get(index).UnwrapOr(EnvEntry { Name: "", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TUnit } })
    let bodyFree = removeInts(freeVars(item.Scheme.Body, []), item.Scheme.Bound)
    batchFreeVars(entries, unionInts(out, freeVarsPredicates(item.Scheme.Predicates, bodyFree)), index + 1)
  end
end

# Imported MyGO struct fields are not declarations of the current package,
# so buildSymbolTable cannot see them. Register them under their source alias
# plus type name (for example ast2.Param), preserving the same identity used
# by selector expressions and preventing same-named imported structs from
# colliding.
func myGoPackageStructSymbols(packages: Slice[MyGoPackageInfo], goPkgs: Slice[GoPackageEntry], out: Slice[Symbol]) -> Slice[Symbol]
  # Keep the full package list fixed across iterations: a dotted annotation
  # such as `Slice[ast2.Decl]` must resolve against every imported package,
  # not just the ones not yet visited.  Dropping visited entries from the
  # shared list made `importedPackageEnv` and the state's MyGoPackageCache
  # lose `ast2` by the time a later package (e.g. typeinference2) was
  # processed, falling back to a bare TCon("Decl") that never unified with the
  # call-site TQualifiedName.
  myGoPackageStructSymbolsLoop(packages, packages, goPkgs, out)
end

func myGoPackageStructSymbolsLoop(allPackages: Slice[MyGoPackageInfo], packages: Slice[MyGoPackageInfo], goPkgs: Slice[GoPackageEntry], out: Slice[Symbol]) -> Slice[Symbol]
  if packages.Len() == 0 then out else
    let pkg = packages.Get(0).UnwrapOr(MyGoPackageInfo { Alias: "", Path: "", Decls: [] as Slice[ast2.Decl] })
    let cached = cachedImportedPackage(pkg, pkg.Alias, allPackages, goPkgs)
    let next = concatSymbols(out, cached.StructSymbols)
    myGoPackageStructSymbolsLoop(allPackages, sliceDrop(packages, 1), goPkgs, next)
  end
end

func myGoPackageStructDeclSymbols(decls: Slice[ast2.Decl], alias: String, path: String, typeNames: Slice[String], env: Env, state: InferState, out: Slice[Symbol]) -> Slice[Symbol]
  if decls.Len() == 0 then out else
    let decl = decls.Get(0).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    let next = switch decl
      case StructDecl(name, tps, fields) => myGoStructFieldSymbols(alias + "." + name, fields, tps, path, typeNames, env, state, out)
      case _ => out
    end
    myGoPackageStructDeclSymbols(sliceDrop(decls, 1), alias, path, typeNames, env, state, next)
  end
end

func myGoPackageAliasForPath(packages: Slice[MyGoPackageInfo], path: String, index: Int) -> String
  if index >= packages.Len() then "" else
    let pkg = packages.Get(index).UnwrapOr(MyGoPackageInfo { Alias: "", Path: "", Decls: [] as Slice[ast2.Decl] })
    if pkg.Path == path then pkg.Alias else myGoPackageAliasForPath(packages, path, index + 1) end
  end
end

func myGoStructFieldSymbols(typeName: String, fields: Slice[ast2.Field], typeParams: Slice[String], path: String, typeNames: Slice[String], env: Env, state: InferState, out: Slice[Symbol]) -> Slice[Symbol]
  if fields.Len() == 0 then out else
    let field = fields.Get(0).UnwrapOr(ast2.Field { Name: "", Type: ast2.TypeExpr.UnitType, Tag: None })
    let rawType = typeFromASTInEnvWithParams(field.Type, typeParams, env, state)
    let fieldType = wrapPkgTypesInMonoType(rawType, path, typeNames)
    myGoStructFieldSymbols(typeName, sliceDrop(fields, 1), typeParams, path, typeNames, env, state, out.Prepend(Symbol.StructField(typeName, field.Name, fieldType)))
  end
end

# Build the environment in which an imported package's own declarations are
# interpreted: its go: imports seeded with the caller's populated Go package
# signatures, then its MyGO imports seeded on top.  Dotted references inside
# the package's field types (for example `Slice[ast2.Decl]`) then resolve via
# env lookup exactly as they do in the package's own source.
func importedPackageEnv(pkg: MyGoPackageInfo, packages: Slice[MyGoPackageInfo], goPkgs: Slice[GoPackageEntry]) -> Env
  let goImports = importedGoPackageEntries(pkg.Decls, goPkgs, [] as Slice[GoPackageEntry])
  seedMyGoPackageEnv(collectMyGoPackageImports(pkg.Decls), packages, goPkgs, seedGoPackageEnv(goImports, initialEnv()))
end

# Map the imported package's go: imports to populated GoPackageEntry values
# (re-aliased to the imported package's own spelling) so FFI types referenced
# in its fields are qualified with the correct `go:` import path.
func importedGoPackageEntries(decls: Slice[ast2.Decl], goPkgs: Slice[GoPackageEntry], out: Slice[GoPackageEntry]) -> Slice[GoPackageEntry]
  if decls.Len() == 0 then out else
    let decl = decls.Get(0).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    let next = switch decl
      case ImportDecl(alias, path) then
        if strings.HasPrefix(path, "go:") then
          switch findGoPackageEntryByPath(goPkgs, path, 0)
            case Some(found) => out.Append(GoPackageEntry { Alias: alias, Path: path, Funcs: found.Funcs, Types: found.Types })
            case None => out
          end
        else
          out
        end
      end
      case _ => out
    end
    importedGoPackageEntries(sliceDrop(decls, 1), goPkgs, next)
  end
end

func findGoPackageEntryByPath(goPkgs: Slice[GoPackageEntry], path: String, index: Int) -> Option[GoPackageEntry]
  if index >= goPkgs.Len() then None else
    let entry = goPkgs.Get(index).UnwrapOr(GoPackageEntry { Alias: "", Path: "", Funcs: [] as Slice[GoFuncSignature], Types: [] as Slice[GoTypeSignature] })
    if entry.Path == path then
      Some(entry)
    else
      findGoPackageEntryByPath(goPkgs, path, index + 1)
    end
  end
end

struct TypedDeclSourcesBuild
  Sources: Slice[PkgDeclSource]
  Next: Int
end

struct TypedDeclFileBuild
  Decls: Slice[ast2.Decl]
  Next: Int
end

# Associate typed declarations with source paths by consuming the inference
# output in the exact declaration order used to build the inference input.
# Imports have no TypedDecl, so they advance only the source cursor.
func buildTypedDeclSources(files: Slice[PkgDeclSource], typedDecls: Slice[ast2.Decl], start: Int) -> TypedDeclSourcesBuild
  buildTypedDeclSourcesLoop(files, typedDecls, 0, start, [])
end

func buildTypedDeclSourcesLoop(files: Slice[PkgDeclSource], typedDecls: Slice[ast2.Decl], fileIndex: Int, typedIndex: Int, out: Slice[PkgDeclSource]) -> TypedDeclSourcesBuild
  if fileIndex >= files.Len() then
    TypedDeclSourcesBuild { Sources: out, Next: typedIndex }
  else
    let file = files.Get(fileIndex).UnwrapOr(PkgDeclSource { Path: "", Decls: [] })
    let built = buildTypedDeclFile(file.Decls, typedDecls, 0, typedIndex, [])
    let source = PkgDeclSource { Path: file.Path, Decls: built.Decls }
    buildTypedDeclSourcesLoop(files, typedDecls, fileIndex + 1, built.Next, out.Append(source))
  end
end

func buildTypedDeclFile(sourceDecls: Slice[ast2.Decl], typedDecls: Slice[ast2.Decl], sourceIndex: Int, typedIndex: Int, out: Slice[ast2.Decl]) -> TypedDeclFileBuild
  if sourceIndex >= sourceDecls.Len() then
    TypedDeclFileBuild { Decls: out, Next: typedIndex }
  else
    let sourceDecl = sourceDecls.Get(sourceIndex).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    switch sourceDecl
      case ImportDecl(_, _) => buildTypedDeclFile(sourceDecls, typedDecls, sourceIndex + 1, typedIndex, out)
      case _ =>
        let typed = typedDecls.Get(typedIndex).UnwrapOr(ast2.Decl.ImportDecl("", ""))
        buildTypedDeclFile(sourceDecls, typedDecls, sourceIndex + 1, typedIndex + 1, out.Append(typed))
    end
  end
end

func separateTypedDecls(all: Slice[ast2.Decl], user: Slice[ast2.Decl], ext: Slice[ast2.Decl]) -> DividedDecls
  # Match each typed decl back to its source (user or external) by name.
  DividedDecls {
    User: filterDeclsAgainst(all, user, 0, [] as Slice[ast2.Decl]),
    External: filterDeclsAgainst(all, ext, 0, [] as Slice[ast2.Decl]),
  }
end

struct DividedDecls
  User: Slice[ast2.Decl]
  External: Slice[ast2.Decl]
end

func filterDeclsAgainst(typedDecls: Slice[ast2.Decl], sourceDecls: Slice[ast2.Decl], index: Int, out: Slice[ast2.Decl]) -> Slice[ast2.Decl]
  if index >= typedDecls.Len() then
    out
  else
    let decl = typedDecls.Get(index).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    if typedDeclInSource(decl, sourceDecls, 0) then
      filterDeclsAgainst(typedDecls, sourceDecls, index + 1, out.Append(decl))
    else
      filterDeclsAgainst(typedDecls, sourceDecls, index + 1, out)
    end
  end
end

func typedDeclInSource(decl: ast2.Decl, source: Slice[ast2.Decl], index: Int) -> Bool
  if index >= source.Len() then false else
    let d = source.Get(index).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    if typedDeclEq(decl, d) then true else typedDeclInSource(decl, source, index + 1) end
  end
end

func typedDeclEq(a: ast2.Decl, b: ast2.Decl) -> Bool
  switch a
    # Aliases and defined types also need to be associated with their source
    # file after combined user/prelude inference.  Without these cases,
    # `separateTypedDecls` drops them from both output sets, so codegen2 never
    # emits package-local aliases such as `type Parser[A] = ...`.
    case TypeAliasDecl(nameA, _, _) then
      switch b
        case TypeAliasDecl(nameB, _, _) => nameA == nameB
        case _ => false
      end
    end
    case LetDecl(bindA) then
      switch b
        case LetDecl(bindB) => bindA.Name == bindB.Name
        case _ => false
      end
    end
    case VarDecl(bindA) then
      switch b
        case VarDecl(bindB) => bindA.Name == bindB.Name
        case _ => false
      end
    end
    case TypeDecl(nameA, _, _) then
      switch b
        case TypeDecl(nameB, _, _) => nameA == nameB
        case _ => false
      end
    end
    case StructDecl(nameA, _, _) then
      switch b
        case StructDecl(nameB, _, _) => nameA == nameB
        case _ => false
      end
    end
    case EnumDecl(nameA, _, _) then
      switch b
        case EnumDecl(nameB, _, _) => nameA == nameB
        case _ => false
      end
    end
    case InterfaceDecl(nameA, _, _) then
      switch b
        case InterfaceDecl(nameB, _, _) => nameA == nameB
        case _ => false
      end
    end
    case FuncDecl(nameA, _, _, _, _, _) then
      switch b
        case FuncDecl(nameB, _, _, _, _, _) => nameA == nameB
        case _ => false
      end
    end
    case ImplDecl(_, targetA, ifaceA, _) then
      switch b
        case ImplDecl(_, targetB, ifaceB, _) =>
          ast2.TypesEqual(targetA, targetB) && optionTypesEqual(ifaceA, ifaceB)
        case _ => false
      end
    end
    case _ => false
  end
end

func optionTypesEqual(a: Option[ast2.TypeExpr], b: Option[ast2.TypeExpr]) -> Bool
  switch a
    case Some(ta) =>
      switch b
        case Some(tb) => ast2.TypesEqual(ta, tb)
        case _ => false
      end
    case None =>
      switch b
        case None => true
        case _ => false
      end
  end
end

func resolveEnvironment(solver: Solver, env: Slice[EnvEntry]) -> Slice[EnvEntry]
  resolveEnvironmentInto(solver, env, 0, [])
end

func resolveEnvironmentInto(solver: Solver, env: Slice[EnvEntry], index: Int, out: Slice[EnvEntry]) -> Slice[EnvEntry]
  if index >= env.Len() then out else
    let entry = env.Get(index).UnwrapOr(EnvEntry { Name: "", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TUnit } })
    let resolved = solverResolve(solver, entry.Scheme.Predicates, emptySubst())
    let predicates = switch resolved
      case Ok(items) => items
      case Err(_) => entry.Scheme.Predicates
    end
    resolveEnvironmentInto(solver, env, index + 1, out.Append(EnvEntry { Name: entry.Name, Scheme: Scheme { Bound: entry.Scheme.Bound, Predicates: predicates, Body: entry.Scheme.Body } }))
  end
end

func collectInstances(decls: Slice[ast2.Decl]) -> Slice[Instance]
  if decls.Len() == 0 then [] as Slice[Instance] else
    let decl = decls.Get(0).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    let rest = collectInstances(sliceDrop(decls, 1))
    switch decl
      case ImplDecl(_, target, interfaceOpt, _) =>
        switch interfaceOpt
          case Some(interfaceType) =>
            switch typeFromAST(interfaceType)
              case TCon(name) => rest.Append(Instance { ClassName: name, Type: typeFromAST(target), Predicates: [] as Slice[Predicate] })
              case _ => rest
            end
          case None => rest
        end
      case _ => rest
    end
  end
end

# Parser2 assigns line and column while parsing expressions.  Package-level
# inference receives declarations rather than full files, so replace the
# expression-location placeholder with the known source path at this boundary.
func withExpressionSourceName(msg: String, source: String) -> String
  if source == "" then msg else strings.ReplaceAll(msg, "<input>:", source + ":") end
end

# Collect Go FFI package imports (go: prefix) from the declarations.
# These are real Go FFI packages whose function signatures are resolved through
# Go's go/types reflection and populated by bootstrapPopulateGoSignatures.
func collectGoPackageImports(decls: Slice[ast2.Decl]) -> Slice[GoPackageEntry]
  decls.Fold([] as Slice[GoPackageEntry], func(out: Slice[GoPackageEntry], d: ast2.Decl) -> Slice[GoPackageEntry]
    switch d
      case ImportDecl(alias, path) then
        if !strings.HasPrefix(path, "go:") then out else
          let existing = out.Fold(false, func(found: Bool, e: GoPackageEntry) -> Bool
            found || e.Alias == alias
          end)
          if existing then out else out.Append(GoPackageEntry { Alias: alias, Path: path, Funcs: [] as Slice[GoFuncSignature], Types: [] as Slice[GoTypeSignature] }) end
        end
      end
      case _ => out
    end
  end)
end

# Collect MyGO package imports (non-go:) from the declarations.
# Returns a list of (alias, path) tuples.
func collectMyGoPackageImports(decls: Slice[ast2.Decl]) -> Slice[(String, String)]
  decls.Fold([] as Slice[(String, String)], func(out: Slice[(String, String)], d: ast2.Decl) -> Slice[(String, String)]
    switch d
      case ImportDecl(alias, path) then
        if strings.HasPrefix(path, "go:") then out else
          let existing = out.Fold(false, func(found: Bool, item: (String, String)) -> Bool
            let (item0, _) = item
            found || item0 == alias
          end)
          if existing then out else out.Append((alias, path)) end
        end
      end
      case _ => out
    end
  end)
end

# Seed the environment with MyGO package aliases resolved into per-member env
# entries.  Each top-level type or function from the imported package is
# registered as `alias.Name` -> a Scheme whose Body is
# `TQualifiedName(path, Ref.new(<original type>))`.  The inner type preserves
# the same shape used by `predeclareFunctions` / `predeclareEnum` for the
# current package, so downstream type equality treats imports the same as
# local declarations.
func seedMyGoPackageEnv(imports: Slice[(String, String)], packages: Slice[MyGoPackageInfo], goPkgs: Slice[GoPackageEntry], env: Env) -> Env
  if imports.Len() == 0 then
    env
  else
    let item = imports.Get(0).UnwrapOr(("", ""))
    let (alias, _) = item
    let pkg = findMyGoPackage(packages, alias)
    # Project the package's cached member schemes into the caller environment.
    # The first importer of a (path, alias) pair builds and caches the full
    # inference artifacts; later importers (including sibling packages in the
    # same sync run) only layer the precomputed entries, so the same heavy
    # package surface is never re-derived.
    let cached = cachedImportedPackage(pkg, alias, packages, goPkgs)
    let envWithMembers = envPutBatch(env, cached.Exported)
    seedMyGoPackageEnv(sliceDrop(imports, 1), packages, goPkgs, envWithMembers)
  end
end

func exportMyGoPackageEntries(decls: Slice[ast2.Decl], localEnv: Env, out: Slice[EnvEntry], alias: String, path: String, typeNames: Slice[String]) -> Slice[EnvEntry]
  if decls.Len() == 0 then
    out
  else
    let decl = decls.Get(0).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    let name = switch decl
      case FuncDecl(n, _, _, _, _, _) => n
      case TypeAliasDecl(n, _, _) => n
      case TypeDecl(n, _, _) => n
      case StructDecl(n, _, _) => n
      case EnumDecl(n, _, _) => n
      case InterfaceDecl(n, _, _) => n
      case _ => ""
    end
    let next = switch envGet(localEnv, name)
      case Some(scheme) then
        let wrapped = wrapPkgTypesInMonoType(scheme.Body, path, typeNames)
        # A function itself is a package member as well. Its nested types have
        # already been qualified above, but the outer marker preserves the
        # identity expected by selector/call inference.
        let body = switch decl
          case FuncDecl(_, _, _, _, _, _) => ast2.MonoType.TQualifiedName(path, Ref.new(wrapped))
          case _ => wrapped
        end
        let withMember = out.Append(EnvEntry { Name: alias + "." + name, Scheme: Scheme { Bound: scheme.Bound, Predicates: scheme.Predicates, Body: body } })
        switch decl
          case EnumDecl(enumName, tps, variants) => exportMyGoPackageEnumVariantEntries(alias, path, enumName, tps, variants, typeNames, localEnv, withMember)
          case _ => withMember
        end
      end
      case None => out
    end
    exportMyGoPackageEntries(sliceDrop(decls, 1), localEnv, next, alias, path, typeNames)
  end
end

# Enum variants are selector members too (for example `ast2.TypeExpr.UnitType`).
# They are projected only after the enum's private, bare signature is complete.
func exportMyGoPackageEnumVariantEntries(alias: String, path: String, enumName: String, typeParams: Slice[String], variants: Slice[ast2.Variant], typeNames: Slice[String], localEnv: Env, out: Slice[EnvEntry]) -> Slice[EnvEntry]
  if variants.Len() == 0 then
    out
  else
    let variant = variants.Get(0).UnwrapOr(ast2.Variant { Name: "", Fields: [] as Slice[ast2.TypeExpr] })
    let enumType = ast2.MonoType.TQualifiedName(path, Ref.new(declaredType(enumName, typeParams)))
    let body = if variant.Fields.Len() == 0 then
      enumType
    else
      # Resolve variant field types against the imported package's private env
      # (the same spelling its own source uses), so dotted names collapse to
      # canonical TQualifiedName instead of a bare TCon("ast2.MonoType").
      ast2.MonoType.TFunc(wrapPkgTypesInSlice(typeArgsFromASTInEnvWithParamsList(variant.Fields, typeParams, localEnv, NewInferState()), path, typeNames), Ref.new(enumType))
    end
    let scheme = Scheme { Bound: typeParamIDs(typeParams, 1), Predicates: [], Body: body }
    # Variant patterns in the importer (`case LetDecl(bind)`) resolve
    # constructors by their bare spelling via variantSchemeForTarget, so the
    # bare name must be exported alongside the qualified selector member
    # `alias.Enum.Variant`.  Both keys share the same qualified scheme; the
    # switch target type still disambiguates same-named variants from
    # different packages.
    let withQualified = out.Append(EnvEntry { Name: alias + "." + enumName + "." + variant.Name, Scheme: scheme })
    exportMyGoPackageEnumVariantEntries(alias, path, enumName, typeParams, sliceDrop(variants, 1), typeNames, localEnv, withQualified.Append(EnvEntry { Name: variant.Name, Scheme: scheme }))
  end
end

# Look up the MyGoPackageInfo entry for a given alias.  When the alias is not
# present (bootstrap inference has not loaded the imported package), fall back
# to a stub whose Path equals the alias so qualified types still resolve.
func findMyGoPackage(packages: Slice[MyGoPackageInfo], alias: String) -> MyGoPackageInfo
  if packages.Len() == 0 then
    MyGoPackageInfo { Alias: alias, Path: alias, Decls: [] as Slice[ast2.Decl] }
  else
    let pkg = packages.Get(0).UnwrapOr(MyGoPackageInfo { Alias: "", Path: "", Decls: [] as Slice[ast2.Decl] })
    if pkg.Alias == alias then pkg else findMyGoPackage(sliceDrop(packages, 1), alias) end
  end
end

# Build declarations in an imported package's private environment.  This is
# intentionally the same spelling that its own source uses: no package path
# is inserted while resolving sibling aliases and function signatures.
func seedMyGoPackageDecls(pkg: MyGoPackageInfo, index: Int, env: Env, packages: Slice[MyGoPackageInfo]) -> Env
  if index >= pkg.Decls.Len() then
    env
  else
    let decl = pkg.Decls.Get(index).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    # Resolve dotted annotations such as `typeinference2.PackageInfo` against
    # the import cache so they canonicalize to TQualifiedName even when the
    # imported member scheme is not yet registered in this local env (the
    # package's own imports are seeded separately, and the caller may seed
    # sibling packages in any order).
    let state = InferState { FreshVarID: 1, PkgInfo: None, GoPackages: [] as Slice[GoPackageEntry], MyGoPackages: packages, MyGoPackageCache: packages, Symbols: [] as Slice[Symbol], SymbolIndex: {}, ActiveConstraints: [] as Slice[Predicate], NamedImpls: [] as Slice[String], ResolvedConstraintArgs: {} }
    let next = switch decl
      case FuncDecl(name, tps, params, ret, _, constraints) then
        let retType = switch ret
          case Some(t) => typeFromASTInEnvWithParams(t, tps, env, state)
          case None => ast2.MonoType.TUnit
        end
        let paramTypes = paramsToTypesWithParamsInEnv(params, tps, env, state)
        let body = ast2.MonoType.TFunc(paramTypes, Ref.new(retType))
        envPut(env, name, Scheme { Bound: typeParamIDs(tps, 1), Predicates: predicatesFromConstraintsWithParams(constraints, tps), Body: body })
      end
      # Type aliases and nominal types are selectable package members just
      # like structs and enums.  Registering them is essential before parsing
      # a dotted annotation such as `ps.Parser[A]`; otherwise lookup falls
      # back to a bare TCon("Parser") and loses the import path.
      case TypeAliasDecl(name, tps, target) then
        # An alias is structurally identical to its target, including across
        # package boundaries. Keep the target unwrapped so `ps.Parser[A]`
        # expands to its function type rather than becoming a nominal Parser.
        let body = typeFromASTInEnvWithParams(target, tps, env, state)
        let scheme = Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: body }
        envPut(env, name, scheme)
      end
      case TypeDecl(name, tps, _) then
        let scheme = Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: declaredType(name, tps) }
        envPut(env, name, scheme)
      end
      case StructDecl(name, tps, _) then
        # Match ordinary AST type references: a non-generic struct is TCon,
        # while only a generic struct is represented as TApp.  tCon always
        # produced `TApp(TCon(name), [])` for imports, which diverged from the
        # `TCon(name)` a function annotation produces and broke struct-literal
        # field unification at import boundaries.
        let scheme = Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: declaredType(name, tps) }
        envPut(env, name, scheme)
      end
      case EnumDecl(name, tps, variants) then
        # Match ordinary AST type references: a non-generic enum is TCon,
        # while only a generic enum is represented as TApp. Using tCon here
        # produced `TApp(TCon(name), [])` for imports, which diverged from
        # `TCon(name)` in a function annotation after qualification.
        let scheme = Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: declaredType(name, tps) }
        let withEnum = envPut(env, name, scheme)
        seedMyGoPackageEnumVariants(pkg, variants, name, tps, withEnum)
      end
      case InterfaceDecl(name, tps, _) then
        # Same shape rule as structs/enums: non-generic interfaces are TCon.
        let scheme = Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: declaredType(name, tps) }
        envPut(env, name, scheme)
      end
      case _ => env
    end
    seedMyGoPackageDecls(pkg, index + 1, next, packages)
  end
end

# Imported enum constructors are used as bare names in patterns (for example,
# `case NamedType(name, args)`).  Register them alongside qualified top-level
# declarations, preserving the imported enum's canonical package identity.
func seedMyGoPackageEnumVariants(pkg: MyGoPackageInfo, variants: Slice[ast2.Variant], enumName: String, typeParams: Slice[String], env: Env) -> Env
  if variants.Len() == 0 then
    env
  else
    let variant = variants.Get(0).UnwrapOr(ast2.Variant { Name: "", Fields: [] as Slice[ast2.TypeExpr] })
    let enumType = declaredType(enumName, typeParams)
    let constructorType = if variant.Fields.Len() == 0 then
      enumType
    else
      let fieldTypes = typeArgsFromASTWithParams(variant.Fields, typeParams)
      ast2.MonoType.TFunc(fieldTypes, Ref.new(enumType))
    end
    let scheme = Scheme { Bound: typeParamIDs(typeParams, 1), Predicates: [], Body: constructorType }
    seedMyGoPackageEnumVariants(pkg, sliceDrop(variants, 1), enumName, typeParams, envPut(env, variant.Name, scheme))
  end
end

# Collect the names of every top-level type declaration in a MyGO package.
# This includes aliases and nominal `type` declarations: an imported generic
# alias such as `type Parser[A] = ...` must be qualified in function
# signatures just like a struct or enum. Used by seedMyGoPackageDecls to
# decide which bare TCon
# references inside a foreign function signature should be re-qualified with
# the package's import path.
func collectMyGoTypeNames(decls: Slice[ast2.Decl], index: Int, out: Slice[String]) -> Slice[String]
  if index >= decls.Len() then
    out
  else
    let decl = decls.Get(index).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    let name = switch decl
      case TypeAliasDecl(n, _, _) => n
      case TypeDecl(n, _, _) => n
      case StructDecl(n, _, _) => n
      case EnumDecl(n, _, _) => n
      case InterfaceDecl(n, _, _) => n
      case _ => ""
    end
    let next = if name == "" then out else
      let exists = out.Fold(false, func(found: Bool, item: String) -> Bool found || item == name end)
      if exists then out else out.Append(name) end
    end
    collectMyGoTypeNames(decls, index + 1, next)
  end
end

# wrapPkgTypesInSlice wraps every TCon / TApp ctor whose name appears in
# `typeNames` with TQualifiedName(path, ...).  Prelude types (String, Int, etc.)
# and type-parameter references are left untouched.
func wrapPkgTypesInSlice(items: Slice[ast2.MonoType], path: String, typeNames: Slice[String]) -> Slice[ast2.MonoType]
  wrapPkgTypesInSliceInto(items, path, typeNames, 0, [])
end

func wrapPkgTypesInSliceInto(items: Slice[ast2.MonoType], path: String, typeNames: Slice[String], index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= items.Len() then out
  else wrapPkgTypesInSliceInto(items, path, typeNames, index + 1, out.Append(wrapPkgTypesInMonoType(items.Get(index).UnwrapOr(ast2.MonoType.TUnit), path, typeNames))) end
end

func wrapPkgTypesInMonoType(typ: ast2.MonoType, path: String, typeNames: Slice[String]) -> ast2.MonoType
  switch typ
    case TCon(name) then
      if containsString(typeNames, name) then
        ast2.MonoType.TQualifiedName(path, Ref.new(typ))
      else
        typ
      end
    end
    case TApp(ctor, args) then
      let wrappedCtor = wrapPkgTypesInMonoType(ctor.value(), path, typeNames)
      ast2.MonoType.TApp(Ref.new(wrappedCtor), wrapPkgTypesInSlice(args, path, typeNames))
    end
    case TFunc(params, ret) then
      ast2.MonoType.TFunc(wrapPkgTypesInSlice(params, path, typeNames), Ref.new(wrapPkgTypesInMonoType(ret.value(), path, typeNames)))
    end
    case TVariadic(params, ret) then
      ast2.MonoType.TVariadic(wrapPkgTypesInSlice(params, path, typeNames), Ref.new(wrapPkgTypesInMonoType(ret.value(), path, typeNames)))
    end
    case TTuple(items) then
      ast2.MonoType.TTuple(wrapPkgTypesInSlice(items, path, typeNames))
    end
    # A type already qualified with its canonical import path keeps that path;
    # only bare package-local names are re-qualified with `path`.  Rewriting
    # an existing TQualifiedName would turn a foreign reference such as
    # `ast2.Decl` into a local one and break unification at the call site.
    case TQualifiedName(foundPath, inner) => ast2.MonoType.TQualifiedName(foundPath, Ref.new(wrapPkgTypesInMonoType(inner.value(), path, typeNames)))
    case _ => typ
  end
end

func containsString(items: Slice[String], value: String) -> Bool
  if items.Len() == 0 then false else
    if items.Get(0).UnwrapOr("") == value then true else containsString(sliceDrop(items, 1), value) end
  end
end

# Look up the path for a given alias from the MyGO package info slice.
func myGoPackagePath(packages: Slice[MyGoPackageInfo], alias: String) -> String
  if packages.Len() == 0 then alias else
    let pkg = packages.Get(0).UnwrapOr(MyGoPackageInfo { Alias: "", Path: "", Decls: [] as Slice[ast2.Decl] })
    if pkg.Alias == alias then pkg.Path else myGoPackagePath(sliceDrop(packages, 1), alias) end
  end
end

# Seed the environment with Go package member entries.  Each function and type
# exported by the Go package is registered as `alias.Name` with the original
# Go-derived MonoType wrapped in `TQualifiedName(path, ...)` so qualified
# `pkg.Func` / `pkg.Type` access resolves uniformly with MyGO imports.
func seedGoPackageEnv(goPkgs: Slice[GoPackageEntry], env: Env) -> Env
  if goPkgs.Len() == 0 then
    env
  else
    let pkg = goPkgs.Get(0).UnwrapOr(GoPackageEntry { Alias: "", Path: "", Funcs: [] as Slice[GoFuncSignature], Types: [] as Slice[GoTypeSignature] })
    seedGoPackageEnv(sliceDrop(goPkgs, 1), seedGoPackageMembers(pkg, env))
  end
end

func seedGoPackageMembers(pkg: GoPackageEntry, env: Env) -> Env
  let withFuncs = seedGoPackageFuncs(pkg, pkg.Funcs, env)
  seedGoPackageTypes(pkg, pkg.Types, withFuncs)
end

func seedGoPackageFuncs(pkg: GoPackageEntry, funcs: Slice[GoFuncSignature], env: Env) -> Env
  if funcs.Len() == 0 then env else
    let fn = funcs.Get(0).UnwrapOr(GoFuncSignature { Name: "", Params: [] as Slice[String], Results: [] as Slice[String], Variadic: false })
    # A Go package qualifies the selected function name, not its signature.
    # Wrapping the complete function type makes primitive results such as
    # strings.HasPrefix's Bool appear as `go:strings.Bool` after a call.
    let body = GoSignatureTypeFor(fn, pkg)
    seedGoPackageFuncs(pkg, sliceDrop(funcs, 1), envPut(env, goPackageMemberName(pkg.Alias, fn.Name), Scheme { Bound: [], Predicates: [], Body: body }))
  end
end

# Register Go package-level types as `pkg.TypeName` and their exported methods
# as field-scheme entries keyed by `$field$pkg.TypeName.Method`.  The method
# scheme is a bare function type (no leading receiver parameter), matching
# how Go method selectors are invoked from MyGO (`recv.Method(args)`).
func seedGoPackageTypes(pkg: GoPackageEntry, types: Slice[GoTypeSignature], env: Env) -> Env
  if types.Len() == 0 then env else
    let t = types.Get(0).UnwrapOr(GoTypeSignature { TypeName: "", TypeParams: [] as Slice[String], Methods: [] as Slice[GoFuncSignature] })
    let qualifiedName = goPackageMemberName(pkg.Alias, t.TypeName)
    # The type constructor's scheme body mirrors a generic type: the qualified
    # name keeps the structure of `pkg.X` so downstream codegen qualifies it,
    # and the type parameters are bound fresh so a polymorphic Go type can be
    # instantiated at each use site (rare, but supported symmetrically).
    let bound = typeParamIDs(t.TypeParams, 1)
    let inner = tCon(t.TypeName, typeParamsAsTypes(t.TypeParams, 1))
    let body = ast2.MonoType.TQualifiedName(pkg.Path, Ref.new(inner))
    let withType = envPut(env, qualifiedName, Scheme { Bound: bound, Predicates: [], Body: body })
    seedGoPackageTypes(pkg, sliceDrop(types, 1), withType)
  end
end

func emptyGoPackageEntry() -> GoPackageEntry
  GoPackageEntry { Alias: "", Path: "", Funcs: [] as Slice[GoFuncSignature], Types: [] as Slice[GoTypeSignature] }
end

func GoSignatureType(sig: GoFuncSignature) -> ast2.MonoType
  GoSignatureTypeFor(sig, emptyGoPackageEntry())
end

# Package-aware FFI signature conversion.  Bare type names that name one of the
# package's own exported types (including aliases such as goast.Expr) resolve
# to TQualifiedName(pkg.Path, TCon(name)) so they unify with annotations like
# `goast.Expr` instead of degenerating into a shared TVar that makes a call's
# result inherit its parameter type.
func GoSignatureTypeFor(sig: GoFuncSignature, pkg: GoPackageEntry) -> ast2.MonoType
  let params = goSignatureTypesFor(sig.Params, pkg)
  let results = goSignatureTypesFor(sig.Results, pkg)
  let result = goSignatureResultShape(results)
  if sig.Variadic then
    ast2.MonoType.TVariadic(goVariadicParamTypesFor(sig.Params, pkg), Ref.new(result))
  else
    ast2.MonoType.TFunc(params, Ref.new(result))
  end
end

func goSignatureResultShape(results: Slice[ast2.MonoType]) -> ast2.MonoType
  if results.Len() == 0 then
    ast2.MonoType.TUnit
  else
    if results.Len() == 2 then
      # Go convention: (value, error) maps to Result[value, error],
      # (value, bool) maps to Option[value]
      let first = results.Get(0).UnwrapOr(ast2.MonoType.TUnit)
      let second = results.Get(1).UnwrapOr(ast2.MonoType.TUnit)
      switch second
        case TCon(name) =>
          if name == "Bool" then
            tCon("Option", [first])
          else
            tCon("Result", [first, second])
          end
        case _ => tCon("Result", [first, second])
      end
    else
      if results.Len() == 1 then
        results.Get(0).UnwrapOr(ast2.MonoType.TUnit)
      else
        ast2.MonoType.TTuple(results)
      end
    end
  end
end

# Inline Go blocks declare their native Go result shape (`go[(T, error)]`).
# Like Go FFI signatures, a 2-tuple result follows the boundary convention:
# (T, error) -> Result[T, error] and (T, bool) -> Option[T].  This makes a
# tuple-typed inline Go expression interchangeable with an equivalent Go FFI
# call at the type level; the raw tuple shape remains available to tuple
# destructuring via ffiRawTupleResultType.
func inlineGoResultMono(t: ast2.MonoType) -> ast2.MonoType
  switch t
    case TTuple(items) =>
      if items.Len() == 2 then
        goSignatureResultShape(items)
      else
        t
      end
    case _ => t
  end
end

# goVariadicParamTypes maps a variadic Go function's parameter strings to the
# element types MyGO callers unify against.  go/types reports the trailing
# parameter as the slice type (`...any` -> `[]any`); TVariadic carries the
# element type so each call argument binds it directly.
func goVariadicParamTypes(names: Slice[String]) -> Slice[ast2.MonoType]
  let mapped = goSignatureTypesInto(names, 0, emptyGoTypes())
  if mapped.Len() == 0 then
    mapped
  else
    let lastIndex = mapped.Len() - 1
    let element = goVariadicElementType(mapped.Get(lastIndex).UnwrapOr(ast2.MonoType.TVar(0)))
    replaceGoParamTypes(mapped, lastIndex, element)
  end
end

func goVariadicElementType(t: ast2.MonoType) -> ast2.MonoType
  switch t
    case TApp(typeRef, args) then
      switch typeRef.value()
        case TCon(name) => if name == "Slice" then args.Get(0).UnwrapOr(ast2.MonoType.TVar(0)) else t end
        case _ => t
      end
    end
    case _ => t
  end
end

func replaceGoParamTypes(mapped: Slice[ast2.MonoType], lastIndex: Int, element: ast2.MonoType) -> Slice[ast2.MonoType]
  var out: Slice[ast2.MonoType] = []
  var i: Int = 0
  while i < mapped.Len()
    if i == lastIndex then
      out = out.Append(element)
    else
      out = out.Append(mapped.Get(i).UnwrapOr(ast2.MonoType.TVar(0)))
    end
    i = i + 1
  end
  out
end

# GoSignatureRawResultType preserves the Go boundary's native return shape.
# Most expressions expose the ergonomic Option/Result form from
# GoSignatureType; tuple destructuring deliberately requests this raw form.
func GoSignatureRawResultType(sig: GoFuncSignature) -> ast2.MonoType
  let results = goSignatureTypes(sig.Results)
  if results.Len() == 0 then
    ast2.MonoType.TUnit
  else
    if results.Len() == 1 then
      results.Get(0).UnwrapOr(ast2.MonoType.TUnit)
    else
      ast2.MonoType.TTuple(results)
    end
  end
end

func goSignatureTypes(items: Slice[String]) -> Slice[ast2.MonoType]
  goSignatureTypesInto(items, 0, emptyGoTypes())
end

func goSignatureTypesInto(items: Slice[String], index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= items.Len() then out
  else goSignatureTypesInto(items, index + 1, out.Append(GoTypeName(items.Get(index).UnwrapOr("any")))) end
end

func goSignatureTypesFor(items: Slice[String], pkg: GoPackageEntry) -> Slice[ast2.MonoType]
  goSignatureTypesForInto(items, pkg, 0, emptyGoTypes())
end

func goSignatureTypesForInto(items: Slice[String], pkg: GoPackageEntry, index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= items.Len() then out
  else goSignatureTypesForInto(items, pkg, index + 1, out.Append(GoTypeNameFor(items.Get(index).UnwrapOr("any"), pkg))) end
end

func emptyGoTypes() -> Slice[ast2.MonoType]
  [] as Slice[ast2.MonoType]
end

# GoTypeName maps a Go signature type string (produced by go/types TypeString)
# to the MyGO MonoType representation.  Composite shapes are parsed
# recursively: `[]string` becomes Slice[String], `map[K]V` becomes Map[K, V]
# and `*T` becomes Ref[T].  Without this a Go FFI result such as
# `strings.Split`'s `[]string` degenerates to a bare TVar, and typeclass
# method calls like `parts.Len()` / `parts.Get()` cannot dispatch to the
# Slice IEnumerable / IIndexable impls.
func GoTypeName(name: String) -> ast2.MonoType
  let trimmed = strings.TrimSpace(name)
  if strings.HasPrefix(trimmed, "[]") then
    ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Slice")), [GoTypeName(strings.TrimPrefix(trimmed, "[]"))])
  else
    if strings.HasPrefix(trimmed, "map[") then
      let close = strings.Index(trimmed, "]")
      if close >= 0 then
        let key = substring(trimmed, 4, close).UnwrapOr("")
        let value = substring(trimmed, close + 1, trimmed.Len()).UnwrapOr("")
        ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Map")), [GoTypeName(key), GoTypeName(value)])
      else
        ast2.MonoType.TVar(0)
      end
    else
      if strings.HasPrefix(trimmed, "*") then
        ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Ref")), [GoTypeName(strings.TrimPrefix(trimmed, "*"))])
      else
        switch trimmed
          case "int" => ast2.MonoType.TCon("Int")
          case "int8" => ast2.MonoType.TCon("Int8")
          case "int16" => ast2.MonoType.TCon("Int16")
          case "int32" => ast2.MonoType.TCon("Int32")
          case "int64" => ast2.MonoType.TCon("Int64")
          case "uint" => ast2.MonoType.TCon("UInt")
          case "uint8" => ast2.MonoType.TCon("UInt8")
          case "uint16" => ast2.MonoType.TCon("UInt16")
          case "uint32" => ast2.MonoType.TCon("UInt32")
          case "uint64" => ast2.MonoType.TCon("UInt64")
          case "float32" => ast2.MonoType.TCon("Float32")
          case "float64" => ast2.MonoType.TCon("Float64")
          case "string" => ast2.MonoType.TCon("String")
          case "bool" => ast2.MonoType.TCon("Bool")
          case "byte" => ast2.MonoType.TCon("Byte")
          case "rune" => ast2.MonoType.TCon("Rune")
          case "error" => ast2.MonoType.TCon("Error")
          case _ => ast2.MonoType.TVar(0)
        end
      end
    end
  end
end

# Package-aware GoTypeName: in addition to the primitive/composite shapes
# above, a bare name naming one of the package's own exported types (including
# exported aliases such as goast.Expr) becomes
# TQualifiedName(pkg.Path, TCon(name)).  Composite shapes recurse through this
# resolver so `[]Decl` keeps its qualified element.
func GoTypeNameFor(name: String, pkg: GoPackageEntry) -> ast2.MonoType
  let trimmed = strings.TrimSpace(name)
  if strings.HasPrefix(trimmed, "[]") then
    ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Slice")), [GoTypeNameFor(strings.TrimPrefix(trimmed, "[]"), pkg)])
  else
    if strings.HasPrefix(trimmed, "map[") then
      let close = strings.Index(trimmed, "]")
      if close >= 0 then
        let key = substring(trimmed, 4, close).UnwrapOr("")
        let value = substring(trimmed, close + 1, trimmed.Len()).UnwrapOr("")
        ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Map")), [GoTypeNameFor(key, pkg), GoTypeNameFor(value, pkg)])
      else
        ast2.MonoType.TVar(0)
      end
    else
      if strings.HasPrefix(trimmed, "*") then
        ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Ref")), [GoTypeNameFor(strings.TrimPrefix(trimmed, "*"), pkg)])
      else
        let prim = GoTypeName(trimmed)
        switch prim
          case TVar(_) => goPackageTypeForName(trimmed, pkg)
          case _ => prim
        end
      end
    end
  end
end

func goPackageTypeForName(name: String, pkg: GoPackageEntry) -> ast2.MonoType
  let trimmed = strings.TrimSpace(name)
  if goPackageHasType(pkg, trimmed) then
    ast2.MonoType.TQualifiedName(pkg.Path, Ref.new(ast2.MonoType.TCon(trimmed)))
  else
    ast2.MonoType.TVar(0)
  end
end

func goPackageHasType(pkg: GoPackageEntry, name: String) -> Bool
  goPackageHasTypeInto(pkg.Types, name, 0)
end

func goPackageHasTypeInto(types: Slice[GoTypeSignature], name: String, index: Int) -> Bool
  if index >= types.Len() then false else
    let t = types.Get(index).UnwrapOr(GoTypeSignature { TypeName: "", TypeParams: [] as Slice[String], Methods: [] as Slice[GoFuncSignature] })
    if t.TypeName == name then true else goPackageHasTypeInto(types, name, index + 1) end
  end
end

func goVariadicParamTypesFor(names: Slice[String], pkg: GoPackageEntry) -> Slice[ast2.MonoType]
  let mapped = goSignatureTypesForInto(names, pkg, 0, emptyGoTypes())
  if mapped.Len() == 0 then
    mapped
  else
    let lastIndex = mapped.Len() - 1
    let element = goVariadicElementType(mapped.Get(lastIndex).UnwrapOr(ast2.MonoType.TVar(0)))
    replaceGoParamTypes(mapped, lastIndex, element)
  end
end

# Flatten all package file declarations into a single slice.
func flattenPkgDecls(files: Slice[PkgDeclSource], index: Int, out: Slice[ast2.Decl]) -> Slice[ast2.Decl]
  if index >= files.Len() then
    out
  else
    let f = files.Get(index).UnwrapOr(PkgDeclSource { Path: "", Decls: [] as Slice[ast2.Decl] })
    flattenPkgDecls(files, index + 1, appendDecls(out, f.Decls))
  end
end

func namedImplNames(decls: Slice[ast2.Decl], index: Int, out: Slice[String]) -> Slice[String]
  if index >= decls.Len() then
    out
  else
    let decl = decls.Get(index).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    switch decl
      case ImplDecl(_, target, iface, _) =>
        switch iface
          case Some(_) =>
            switch target
              case NamedType(name, _) => namedImplNames(decls, index + 1, out.Append(name))
              case _ => namedImplNames(decls, index + 1, out)
            end
          case None => namedImplNames(decls, index + 1, out)
        end
      case _ => namedImplNames(decls, index + 1, out)
    end
  end
end

# Predeclare all function signatures for forward reference support.
func predeclareAllFunctions(decls: Slice[ast2.Decl], env: Env) -> Env
  predeclareImplMethods(decls, predeclareFunctions(decls, env))
end

func appendDecls(acc: Slice[ast2.Decl], items: Slice[ast2.Decl]) -> Slice[ast2.Decl]
  if items.Len() == 0 then
    acc
  else
    appendDecls(acc.Append(items.Get(0).UnwrapOr(ast2.Decl.ImportDecl("", ""))), sliceDrop(items, 1))
  end
end

