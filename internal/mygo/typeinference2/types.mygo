package typeinference2
import common2 "github.com/mygo-lang/mygo/internal/mygo/common2"

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import strings "go:strings"
# typeinference2 is the self-hosted, parser2-facing inference core.
# It implements a deliberately small HM-style pass over ast2. The production
# typeinference package is still richer; this package is the bootstrap lane.
# MonoType is now defined in ast2 package with the same variants plus TVariadic.

struct Scheme
  Bound: Slice[Int]
  # Predicates are the typeclass requirements carried by a polymorphic
  # binding. Keeping Body separate preserves the existing HM consumers while
  # making dictionary requirements explicit for codegen2.
  Predicates: Slice[Predicate]
  Body: ast2.MonoType
end

struct Predicate
  ClassName: String
  Args: Slice[ast2.MonoType]
end

struct QualifiedType
  Predicates: Slice[Predicate]
  Body: ast2.MonoType
end

struct EnvEntry
  Name: String
  Scheme: Scheme
end

# Env is a persistent lexical environment. Each extension owns a single
# binding layer (its Entry) and points at its parent, so adding a binding
# neither copies nor mutates an older environment snapshot.  Batch layers
# hold many bindings at once (an imported package's entire exported surface)
# with an O(1) index map, so a deep import graph never degrades lookups to a
# thousands-of-links chain walk.
struct Env
  Entry: Option[EnvEntry]
  Batch: Option[BatchBindings]
  Parent: Option[Ref[Env]]
end

# A batch layer's bindings: Index gives O(1) name lookup while Entries keeps
# the addition order for ToSlice / variant walks.  FreeVars is the union of
# free type variables across all entries, precomputed once at batch creation:
# envFreeVars runs per let binding, so re-deriving it over the whole imported
# surface each time would dominate inference for deep import graphs.
struct BatchBindings
  Index: Map[String, Scheme]
  Entries: Slice[EnvEntry]
  FreeVars: Slice[Int]
end

impl Env
  func New() -> Env
    Env { Entry: None, Batch: None, Parent: None }
  end

  # Put creates a child scope containing `name`. The parent remains intact,
  # which preserves shadowing and makes sibling inference branches independent.
  func Put(env: Env, name: String, scheme: Scheme) -> Env
    Env {
      Entry: Some(EnvEntry { Name: name, Scheme: scheme }),
      Batch: None,
      Parent: Some(Ref.new(env)),
    }
  end
  func Get(env: Env, name: String) -> Option[Scheme]
    switch env.Entry
      case Some(entry) then
        if entry.Name == name then
          Some(entry.Scheme)
        else
          env.GetBatchOrParent(name)
        end
      end
      case None => env.GetBatchOrParent(name)
    end
  end
  func GetBatchOrParent(env: Env, name: String) -> Option[Scheme]
    switch env.Batch
      case Some(batch) then
        switch batch.Index.Get(name)
          case Some(scheme) => Some(scheme)
          case None then
            switch env.Parent
              case Some(parent) => parent.value().Get(name)
              case None => None
            end
          end
        end
      end
      case None then
        switch env.Parent
          case Some(parent) => parent.value().Get(name)
          case None => None
        end
      end
    end
  end

  # ToSlice is a compatibility boundary for PackageInfo. Inference itself
  # stays on persistent Env layers; consumers receive the former newest-first
  # entry order only once, at package completion.
  func ToSlice(env: Env) -> Slice[EnvEntry]
    envToSliceInto(env, [])
  end
end

func envToSliceInto(env: Env, out: Slice[EnvEntry]) -> Slice[EnvEntry]
  let withBatch = switch env.Batch
    case Some(batch) then
      switch appendEnvEntries(out, batch.Entries)
        case Some(entries) => entries
        case None => out
      end
    end
    case None => out
  end
  let withEntry = switch env.Entry
    case Some(entry) => withBatch.Append(entry)
    case None => withBatch
  end
  # Batch nodes carry no Entry, so they must still descend into their Parent;
  # Env.New() terminates the walk via Parent == None.
  switch env.Parent
    case Some(parent) => envToSliceInto(parent.value(), withEntry)
    case None => withEntry
  end
end

func appendEnvEntries(left: Slice[EnvEntry], right: Slice[EnvEntry]) -> Option[Slice[EnvEntry]]
  appendEnvEntriesAt(left, right, 0)
end

func appendEnvEntriesAt(left: Slice[EnvEntry], right: Slice[EnvEntry], index: Int) -> Option[Slice[EnvEntry]]
  if index >= right.Len() then
    Some(left)
  else
    switch right.Get(index)
      case Some(entry) => appendEnvEntriesAt(left.Append(entry), right, index + 1)
      case None => None
    end
  end
end

struct FieldEntry
  TypeName: String
  FieldName: String
  Type: ast2.MonoType
end

enum Symbol
  StructField(String, String, ast2.MonoType)
  GoMethod(String, String, GoFuncSignature)
  ImplMethod(String, String, Scheme)
  # EnumVariant captures the type-name + variant-name + constructor type for
  # an enum variant constructor.  FieldExpr on an enum type (e.g. `Decl.ImportDecl`)
  # has to look the variant up in the symbol table because the constructor has
  # at least one field and therefore its scheme body is a TFunc, not a TCon.
  EnumVariant(String, String, ast2.MonoType)
end

struct SubstEntry
  ID: Int
  Type: ast2.MonoType
end

# Subst is a persistent substitution layer. Entries and Index contain only
# this layer's bindings; earlier bindings are reached through Fallbacks.
# This prevents sibling inference branches from observing map mutations
# without copying the complete substitution at each update or composition.
#
# Index is None for single-entry prepend/append layers (their Entries are
# scanned linearly, avoiding a one-entry map allocation per binding) and
# Some(map) for flattened substitutions produced by substFromEntries, where
# the eager index keeps lookups constant-time.
struct Subst
  Entries: Slice[SubstEntry]
  Index: Option[Map[Int, ast2.MonoType]]
  Fallbacks: Slice[Ref[Subst]]
  IndexFirst: Bool
  # MaxID is the maximum binding key in this layer and all fallback layers.
  # Keeping it cached makes fresh-variable collision checks constant time.
  MaxID: Int
end

# ---------------------------------------------------------------------------
# Package-level inference context
# ---------------------------------------------------------------------------

# PkgInfo holds package-level AST declarations for enum/struct/interface
# lookups during type inference. It mirrors the old typeinference.PkgInfo
# without the per-type-name maps — mygo enums require pattern matching over
# the full declaration slice instead.
struct PkgInfo
  Dir: String
  Name: String
  Decls: Slice[ast2.Decl]
end

# MyGoPackageInfo records the exported surface of an imported MyGO package.
# Decls holds the raw AST declarations from the imported package.
# Qualified access like `ast2.SourcePos { ... }` resolves by looking up the
# package alias in MyGoPackageCache and scanning its Decls for the target
# type name.
struct MyGoPackageInfo
  Alias: String
  Path: String
  Decls: Slice[ast2.Decl]
end

# InferState holds inference state: fresh variable counter, package info for
# lookups, and (optionally) a TypedInfo accumulator that records every
# successfully inferred expression type.  Callers that do not need expression
# granularity can leave TypedInfo as None.
struct InferState
  FreshVarID: Int
  PkgInfo: Option[PkgInfo]
  GoPackages: Slice[GoPackageEntry]
  MyGoPackages: Slice[MyGoPackageInfo]
  MyGoPackageCache: Slice[MyGoPackageInfo]
  Symbols: Slice[Symbol]
  # SymbolIndex resolves `TypeName::Field` selectors in constant time instead
  # of a linear scan over the whole Symbols slice.  Struct fields overwrite
  # (they are prepended to the slice) while impl methods insert only when the
  # key is absent (they are appended), mirroring the slice's lookup order.
  SymbolIndex: Map[String, Symbol]
  ActiveConstraints: Slice[Predicate]
  NamedImpls: Slice[String]
  ResolvedConstraintArgs: Map[MethodConstraintKey, Slice[ast2.MonoType]]
end

struct InferResult
  Type: ast2.MonoType
  Predicates: Slice[Predicate]
  Subst: Subst
  State: InferState
end

# PackageInfo contains the inferred types for a whole package.
# The Env holds all top-level bindings (functions, types, etc.) visible
# across files, and Fields stores struct field type information for
# field access resolution. GoPackages records imported Go package info.
enum MethodConstraintRef
  Interface(String)
  NamedImpl(String)
end

struct MethodConstraintKey
  Receiver: String
  Constraint: MethodConstraintRef
  ArgsKey: String
  Method: String
end

struct PackageInfo
  Env: Slice[EnvEntry]
  Fields: Slice[FieldEntry]
  GoPackages: Slice[GoPackageEntry]
  MyGoPackages: Slice[MyGoPackageInfo]
  Instances: Slice[Instance]
  Solver: Solver
  TypedDecls: Slice[ast2.Decl]
  ExternalTypedDecls: Slice[ast2.Decl]
  # Typed declarations retain their originating source file so downstream
  # codegen never has to recover ownership from declaration names or shapes.
  TypedDeclSources: Slice[PkgDeclSource]
  ExternalTypedDeclSources: Slice[PkgDeclSource]
  ResolvedConstraintArgs: Map[MethodConstraintKey, Slice[ast2.MonoType]]
end

# GoPackageEntry records an imported Go package with its alias and type info.
struct GoPackageEntry
  Alias: String
  Path: String
  Funcs: Slice[GoFuncSignature]
  Types: Slice[GoTypeSignature]
  Constants: Slice[GoConstSignature]
end

# GoConstSignature records one exported package-level Go constant (e.g.
# time.Second, http.StatusOK).  The constant's declared type string is carried
# verbatim and converted to a MonoType through the shared Go type resolver when
# it is seeded into the environment, so selectors like `time.Second` type-check
# as values instead of failing with "unknown Go package member".
struct GoConstSignature
  Name: String
  Type: String
end

# GoFuncSignature is populated by the bootstrap entry from go/types and is
# passed unchanged to codegen2 for FFI-specific lowering.
struct GoFuncSignature
  Name: String
  Params: Slice[String]
  Results: Slice[String]
  Variadic: Bool
  # The generic type parameters of the original Go declaration, in order.
  # Bare identifiers in the rendered Params/Results that name one of these
  # resolve to the bounded TParam ids, so the FFI resolver finds the
  # original definition instead of degrading the type.
  TypeParams: Slice[String]
end

# GoTypeSignature is populated by the bootstrap entry from go/types and carries
# a Go type alias (alias.TypeName) plus the exported methods on that type
# (alias.Methods), the exported struct fields (alias.Fields), and the rendered
# underlying type string (alias.Underlying).  This lets the bootstrap type
# checker resolve qualified `pkg.Type` references, `recv.Method` selectors and
# `recv.Field` accesses against real Go packages (e.g. `testing.T.Fatal`,
# `http.Request.Header`) without special-casing.  Underlying drives boundary
# aliasing of nominal types whose underlying shape is callable (a Go named
# function type such as `context.CancelFunc` becomes a TFunc).
struct GoTypeSignature
  TypeName: String
  TypeParams: Slice[String]
  Methods: Slice[GoFuncSignature]
  Fields: Slice[GoFieldSignature]
  # Embeds lists the type's exported embedded (anonymous) fields, in
  # declaration order.  `Fields` already contains each embedded field under
  # its own name (for an anonymous field the Go field name IS the type name),
  # so the qualified path `u.Model` keeps working; this list is what the
  # promotion resolver recurses through, which `Fields` cannot express
  # because it does not distinguish an embedded field from a named one.
  Embeds: Slice[GoEmbedSignature]
  Underlying: String
end

# GoFieldSignature records one exported field of a Go struct type.  It is
# populated by the bootstrap entry from go/types and passed unchanged to the
# symbol table so `recv.Field` type-checks and `recv.Field.Method(...)` chains
# resolve against the field's own type.
struct GoFieldSignature
  Name: String
  Type: String
end

# GoEmbedSignature records one exported embedded field of a Go struct type.
# Name is the embedded type's name (identical to the corresponding
# GoFieldSignature entry, since Go names an anonymous field after its type) and
# Type is the embedded type rendered the same way, so the resolver can both
# offer the qualified path and walk the chain one level deeper.
struct GoEmbedSignature
  Name: String
  Type: String
end

struct DeclInfer
  Env: Env
  Fields: Slice[FieldEntry]
  State: InferState
  TypedDecl: Option[ast2.Decl]
end

struct ArgsResult
  Types: Slice[ast2.MonoType]
  Exprs: Slice[ast2.Expr]
  Predicates: Slice[Predicate]
  Subst: Subst
  State: InferState
end

struct BlockInferStep
  Result: InferResult
  Env: Env
  Stmt: ast2.Stmt
end

# PkgDecls bundles all file declarations in a package.
struct PkgDecls
  Decls: Slice[ast2.Decl]
end

# PkgDeclSource is a single file's declarations with its path.
struct PkgDeclSource
  Path: String
  Decls: Slice[ast2.Decl]
end

func NewInferState() -> InferState
  InferState {
    FreshVarID: 1,
    PkgInfo: None,
    GoPackages: [],
    MyGoPackages: [],
    MyGoPackageCache: [],
    Symbols: [],
    SymbolIndex: {},
    ActiveConstraints: [],
    NamedImpls: [],
    ResolvedConstraintArgs: {},
  }
end

# Copy an InferState with an updated FreshVarID, preserving all other fields.
# This avoids repeating the full struct literal at every fresh-variable site.
func withFreshID(state: InferState, id: Int) -> InferState
  InferState {
    FreshVarID: id,
    PkgInfo: state.PkgInfo,
    GoPackages: state.GoPackages,
    MyGoPackages: state.MyGoPackages,
    MyGoPackageCache: state.MyGoPackageCache,
    Symbols: state.Symbols,
    SymbolIndex: state.SymbolIndex,
    ActiveConstraints: state.ActiveConstraints,
    NamedImpls: state.NamedImpls,
    ResolvedConstraintArgs: state.ResolvedConstraintArgs,
  }
end

func withActiveConstraints(state: InferState, constraints: Slice[Predicate]) -> InferState
  InferState {
    FreshVarID: state.FreshVarID,
    PkgInfo: state.PkgInfo,
    GoPackages: state.GoPackages,
    MyGoPackages: state.MyGoPackages,
    MyGoPackageCache: state.MyGoPackageCache,
    Symbols: state.Symbols,
    SymbolIndex: state.SymbolIndex,
    ActiveConstraints: constraints,
    NamedImpls: state.NamedImpls,
    ResolvedConstraintArgs: state.ResolvedConstraintArgs,
  }
end

func goBuiltinSymbols() -> Slice[Symbol]
  # Go's built-in error interface has Error() string method.
  let errorMethod = GoFuncSignature {
    Name: "Error",
    Params: [],
    Results: ["string"],
    Variadic: false,
    TypeParams: [],
  }
  [Symbol.GoMethod("Error", "Error", errorMethod)]
end

func goSymbolsFromPackages(packages: Slice[GoPackageEntry], out: Slice[Symbol]) -> Option[Slice[Symbol]]
  if packages.Len() == 0 then
    Some(out)
  else
    switch packages.Get(0)
      case Some(pkg) then
        switch goSymbolsFromTypes(pkg, pkg.Types, out)
          case Some(withTypes) => goSymbolsFromPackages(common2.SliceDrop(packages, 1), withTypes)
          case None => None
        end
      end
      case None => None
    end
  end
end

# Go FFI types register both their exported methods (GoMethod) and their
# exported struct fields (StructField) in the same symbol table, so field
# selectors (`r.Header`) and method chains (`r.Header.Set(...)`) resolve
# against the imported package's real type surface.  Field type strings are
# resolved package-aware so same-package references (`http.Header`) collapse
# onto the same qualified MonoType as the package's own type scheme.
func goSymbolsFromTypes(pkg: GoPackageEntry, types: Slice[GoTypeSignature], out: Slice[Symbol]) -> Option[Slice[Symbol]]
  if types.Len() == 0 then
    Some(out)
  else
    switch types.Get(0)
      case Some(t) then
        let typeName = goPackageMemberName(pkg.Alias, t.TypeName)
        switch goMethodsFromSigs(typeName, t.Methods, out)
          case Some(withMethods) then
            switch goFieldsFromSigs(typeName, pkg, t, withMethods)
              case Some(withFields) then
                goSymbolsFromTypes(pkg, common2.SliceDrop(types, 1), withFields)
              end
              case None => None
            end
          end
          case None => None
        end
      end
      case None => None
    end
  end
end

# goFieldsFromSigs registers each exported field as a StructField symbol.  A
# field whose type string cannot be resolved is skipped: the field then reads
# as an ordinary `unknown field` inference error at its use site, which is more
# precise than failing the whole package seed.
func goFieldsFromSigs(typeName: String, pkg: GoPackageEntry, t: GoTypeSignature, out: Slice[Symbol]) -> Option[Slice[Symbol]]
  goFieldsFromSigsInto(typeName, pkg, goTypeParamMap(t.TypeParams), t.Fields, 0, out)
end

func goFieldsFromSigsInto(typeName: String, pkg: GoPackageEntry, typeParams: Map[String, Int], fields: Slice[GoFieldSignature], index: Int, out: Slice[Symbol]) -> Option[Slice[Symbol]]
  if index >= fields.Len() then
    Some(out)
  else
    switch fields.Get(index)
      case Some(f) then
        switch goTypeNameWith(f.Type, Some(pkg), typeParams)
          case Ok(mono) then
            goFieldsFromSigsInto(
              typeName,
              pkg,
              typeParams,
              fields,
              index + 1,
              out.Prepend(Symbol.StructField(typeName, f.Name, mono))
            )
          end
          case Err(_) => goFieldsFromSigsInto(typeName, pkg, typeParams, fields, index + 1, out)
        end
      end
      case None => None
    end
  end
end

# A dot-import exposes members directly, while a regular import exposes them
# through its source alias.
func goPackageMemberName(alias: String, name: String) -> String
  if alias == "." then
    name
  else
    alias + "." + name
  end
end

func goMethodsFromSigs(typeName: String, methods: Slice[GoFuncSignature], out: Slice[Symbol]) -> Option[Slice[Symbol]]
  if methods.Len() == 0 then
    Some(out)
  else
    switch methods.Get(0)
      case Some(method) then
        goMethodsFromSigs(
          typeName,
          common2.SliceDrop(methods, 1),
          out.Prepend(Symbol.GoMethod(typeName, method.Name, method))
        )
      end
      case None => None
    end
  end
end

func buildSymbolTable(goPkgs: Slice[GoPackageEntry], decls: Slice[ast2.Decl], env: Env) -> Option[Slice[Symbol]]
  let builtinSyms = goBuiltinSymbols()
  switch collectDeclSymbols(decls, env, [])
    case None => None
    case Some(declSyms) then
      switch goSymbolsFromPackages(goPkgs, [])
        case None => None
        case Some(goSyms) then
          switch concatSymbols(builtinSyms, goSyms)
            case None => None
            case Some(withBuiltins) => concatSymbols(withBuiltins, declSyms)
          end
        end
      end
    end
  end
end

# InferenceSetup is the common package-level preparation result.  Structural
# symbols must be derived after aliases, enums, and functions have been
# predeclared; otherwise a forward alias in another source file remains a bare
# nominal TCon while literals infer as its target type.
struct InferenceSetup
  Env: Env
  Symbols: Slice[Symbol]
end

# prepareInferenceSetup keeps the ordering shared by every package inference
# entry point: seed imports, add any already-inferred external environment, then
# predeclare the effective declarations before resolving structural symbols.
# `externalEntries` is newest-first PackageInfo.Env data used only by external
# test packages; keeping it between imports and local declarations preserves
# its existing shadowing semantics.
func prepareInferenceSetup(decls: Slice[ast2.Decl], goPkgs: Slice[GoPackageEntry], mygoImports: Slice[(String, String)], myGoPkgImports: Slice[MyGoPackageInfo], externalEntries: Slice[EnvEntry]) -> Result[InferenceSetup, String]
  switch seedGoPackageEnv(goPkgs, initialEnv())
    case Ok(envWithGoPkgs) then
      switch seedMyGoPackageEnv(mygoImports, myGoPkgImports, goPkgs, envWithGoPkgs)
        case Ok(envWithMyGoPkgs) then
          switch envPutBatchLatest(envWithMyGoPkgs, externalEntries)
            case Some(base) then
              switch predeclareAllFunctions(decls, base)
                case Some(predeclared) then
                  switch buildSymbolTable(goPkgs, decls, predeclared)
                    case Some(symbols) => Ok(InferenceSetup { Env: predeclared, Symbols: symbols })
                    case None => Err("malformed declaration or imported symbol list: missing index")
                  end
                end
                case None => Err("malformed AST: missing indexed declaration while predeclaring")
              end
            end
            case None => Err("malformed environment entries: missing indexed entry")
          end
        end
        case Err(msg) => Err(msg)
      end
    end
    case Err(msg) => Err(msg)
  end
end

# Build the constant-time symbol index from an ordered symbol list.  The list
# is scanned in slice order and the first occurrence of each `TypeName::Field`
# key wins, mirroring the former linear findSymbol scan over Symbols.
func symbolIndexFromSlice(symbols: Slice[Symbol], index: Map[String, Symbol]) -> Option[Map[String, Symbol]]
  symbolIndexFromSliceAt(symbols, index)
end

func symbolIndexFromSliceAt(symbols: Slice[Symbol], index: Map[String, Symbol]) -> Option[Map[String, Symbol]]
  if symbols.Len() == 0 then
    Some(index)
  else
    switch symbols.Get(0)
      case Some(s) then
        let key = symbolKey(symbolTypeName(s), symbolFieldName(s))
        switch index.Get(key)
          case None then
            index.Set(key, s)
            symbolIndexFromSliceAt(common2.SliceDrop(symbols, 1), index)
          end
          case Some(_) => symbolIndexFromSliceAt(common2.SliceDrop(symbols, 1), index)
        end
      end
      case None => None
    end
  end
end

# Newly declared struct fields are prepended to the symbol slice, so they
# shadow earlier entries.  Reproduce that precedence by overwriting the key.
func symbolIndexPrepend(index: Map[String, Symbol], symbols: Slice[Symbol]) -> Map[String, Symbol]
  switch symbolIndexPrependAt(index, symbols)
    case Some(found) => found
    case None => index
  end
end

func symbolIndexPrependAt(index: Map[String, Symbol], symbols: Slice[Symbol]) -> Option[Map[String, Symbol]]
  if symbols.Len() == 0 then
    Some(index)
  else
    switch symbols.Get(0)
      case Some(s) then
        index.Set(symbolKey(symbolTypeName(s), symbolFieldName(s)), s)
        symbolIndexPrependAt(index, common2.SliceDrop(symbols, 1))
      end
      case None => None
    end
  end
end

# Impl methods are appended to the symbol slice, so earlier entries keep
# lookup priority.  Reproduce that precedence by inserting only when absent.
func symbolIndexAppend(index: Map[String, Symbol], symbols: Slice[Symbol]) -> Map[String, Symbol]
  switch symbolIndexAppendAt(index, symbols)
    case Some(found) => found
    case None => index
  end
end

func symbolIndexAppendAt(index: Map[String, Symbol], symbols: Slice[Symbol]) -> Option[Map[String, Symbol]]
  if symbols.Len() == 0 then
    Some(index)
  else
    switch symbols.Get(0)
      case Some(s) then
        let key = symbolKey(symbolTypeName(s), symbolFieldName(s))
        switch index.Get(key)
          case None =>
            index.Set(key, s)
            symbolIndexAppendAt(index, common2.SliceDrop(symbols, 1))
          case Some(_) => symbolIndexAppendAt(index, common2.SliceDrop(symbols, 1))
        end
      end
      case None => None
    end
  end
end

func symbolTypeName(s: Symbol) -> String
  switch s
    case StructField(tn, _, _) => tn
    case GoMethod(tn, _, _) => tn
    case ImplMethod(tn, _, _) => tn
    case EnumVariant(tn, _, _) => tn
  end
end

func symbolFieldName(s: Symbol) -> String
  switch s
    case StructField(_, fn, _) => fn
    case GoMethod(_, mn, _) => mn
    case ImplMethod(_, mn, _) => mn
    case EnumVariant(_, vn, _) => vn
  end
end

# "::" cannot appear in MyGO identifiers, so `TypeName::Field` is injective
# even when TypeName itself is qualified (`ps.Reply`).
func symbolKey(typeName: String, field: String) -> String
  typeName + "::" + field
end

func collectDeclSymbols(decls: Slice[ast2.Decl], env: Env, out: Slice[Symbol]) -> Option[Slice[Symbol]]
  if decls.Len() == 0 then
    Some(out)
  else
    switch decls.Get(0)
      case None => None
      case Some(d) then
        switch d
          case StructDecl(name, tps, fields) then
            switch structFieldSymbolsInEnv(name, fields, tps, env, [])
              case Some(syms) then
                switch collectDeclSymbols(common2.SliceDrop(decls, 1), env, out)
                  case Some(rest) => concatSymbols(rest, syms)
                  case None => None
                end
              end
              case None => None
            end
          end
          case EnumDecl(name, tps, variants) then
            switch enumVariantSymbolsInEnv(name, variants, tps, env, [])
              case Some(syms) then
                switch collectDeclSymbols(common2.SliceDrop(decls, 1), env, out)
                  case Some(rest) => concatSymbols(rest, syms)
                  case None => None
                end
              end
              case None => None
            end
          end
          case ImplDecl(tps, target, iface, methods) then
            switch implReceiverName(target, iface)
              case Some(receiverName) then
                switch implMethodSymbols(receiverName, tps, methods, env, [])
                  case Some(syms) then
                    switch collectDeclSymbols(common2.SliceDrop(decls, 1), env, out)
                      case Some(rest) => concatSymbols(rest, syms)
                      case None => None
                    end
                  end
                  case None => None
                end
              end
              case None => None
            end
          end
          case _ => collectDeclSymbols(common2.SliceDrop(decls, 1), env, out)
        end
      end
    end
  end
end

# enumVariantSymbols seeds one EnumVariant symbol per variant of the enum so
# that FieldExpr on an enum-typed receiver can resolve `TypeName.VariantName`
# via findSymbol.  Mirrors predeclareEnum's constructor-type computation.
func enumVariantSymbolsInEnv(enumName: String, variants: Slice[ast2.Variant], tps: Slice[String], env: Env, out: Slice[Symbol]) -> Option[Slice[Symbol]]
  if variants.Len() == 0 then
    Some(out)
  else
    switch variants.Get(0)
      case None => None
      case Some(v) then
        let enumType = tCon(enumName, typeParamsAsTypes(tps, 1))
        let constructorType = if v.Fields.Len() == 0 then
          enumType
        else
          ast2.MonoType.TFunc(
            typeArgsFromASTInEnvWithParamsList(v.Fields, tps, env, NewInferState()),
            Ref.new(enumType)
          )
        end
        enumVariantSymbolsInEnv(
          enumName,
          common2.SliceDrop(variants, 1),
          tps,
          env,
          out.Prepend(Symbol.EnumVariant(enumName, v.Name, constructorType))
        )
      end
    end
  end
end

func structFieldSymbolsInEnv(typeName: String, fields: Slice[ast2.Field], typeParams: Slice[String], env: Env, out: Slice[Symbol]) -> Option[Slice[Symbol]]
  if fields.Len() == 0 then
    Some(out)
  else
    switch fields.Get(0)
      case None => None
      case Some(f) then
        let fieldType = typeFromASTInEnvWithParams(f.Type, typeParams, env, NewInferState())
        structFieldSymbolsInEnv(
          typeName,
          common2.SliceDrop(fields, 1),
          typeParams,
          env,
          out.Prepend(Symbol.StructField(typeName, f.Name, fieldType))
        )
      end
    end
  end
end

# InferFile runs type inference on a single file in isolation.
# This is a convenience wrapper around InferPackage for single-file packages.
func InferFile(file: ast2.File) -> Result[PackageInfo, String]
  let goPkgImports = collectGoPackageImports(file.Decls)
  let mygoImports = collectMyGoPackageImports(file.Decls)
  switch prepareInferenceSetup(file.Decls, goPkgImports, mygoImports, [], [])
    case Ok(setup) then
      switch symbolIndexFromSlice(setup.Symbols, {})
        case None => Err("malformed symbol list: missing indexed entry")
        case Some(symbolIndex) then
          let state = InferState {
            FreshVarID: 1,
            PkgInfo: Some(PkgInfo { Dir: "", Name: file.PackageName, Decls: file.Decls }),
            GoPackages: goPkgImports,
            MyGoPackages: [],
            MyGoPackageCache: [],
            Symbols: setup.Symbols,
            SymbolIndex: symbolIndex,
            ActiveConstraints: [],
            NamedImpls: namedImplNames(file.Decls, 0, []),
            ResolvedConstraintArgs: {},
          }
          switch inferDecls(file.Decls, setup.Env, [], state)
            case Ok(info) then
              let collected = collectInstances(file.Decls)
              let instances = mergeBuiltInInstances(collected)
              let solver = solverFromInstances(instances)
              Ok(PackageInfo {
                Env: resolveEnvironment(solver, info.Env),
                Fields: info.Fields,
                GoPackages: goPkgImports,
                MyGoPackages: [],
                Instances: instances,
                Solver: solver,
                TypedDecls: info.TypedDecls,
                ExternalTypedDecls: [],
                TypedDeclSources: [PkgDeclSource { Path: file.SourceName, Decls: info.TypedDecls }],
                ExternalTypedDeclSources: [],
                ResolvedConstraintArgs: info.ResolvedConstraintArgs,
              })
            end
            case Err(msg) => Err(common2.WithExpressionSourceName(msg, file.SourceName))
          end
        end
      end
    end
    case Err(msg) => Err(msg)
  end
end

# InferPackage runs HM type inference across all files in a package.
func InferPackage(files: Slice[PkgDeclSource]) -> Result[PackageInfo, String]
  InferPackageWithGoPackages(
    files,
    collectGoPackageImports(flattenPkgDecls(files, 0, []))
  )
end

func InferPackageWithGoPackages(files: Slice[PkgDeclSource], goPkgImports: Slice[GoPackageEntry]) -> Result[PackageInfo, String]
  let allDecls = flattenPkgDecls(files, 0, [])
  let mygoImports = collectMyGoPackageImports(allDecls)
  switch prepareInferenceSetup(
    allDecls,
    goPkgImports,
    mygoImports,
    [],
    []
  )
    case Ok(setup) then
      switch symbolIndexFromSlice(setup.Symbols, {})
        case None => Err("malformed symbol list: missing indexed entry")
        case Some(symbolIndex) then
          let state = InferState {
            FreshVarID: 1,
            PkgInfo: Some(PkgInfo { Dir: "", Name: "", Decls: allDecls }),
            GoPackages: goPkgImports,
            MyGoPackages: [],
            MyGoPackageCache: [],
            Symbols: setup.Symbols,
            SymbolIndex: symbolIndex,
            ActiveConstraints: [],
            NamedImpls: namedImplNames(allDecls, 0, []),
            ResolvedConstraintArgs: {},
          }
          let result = inferDecls(allDecls, setup.Env, [], state)
          switch result
            case Ok(info) then
              let collected = collectInstances(allDecls)
              let instances = mergeBuiltInInstances(collected)
              let solver = solverFromInstances(instances)
              Ok(PackageInfo {
                Env: resolveEnvironment(solver, info.Env),
                Fields: info.Fields,
                GoPackages: goPkgImports,
                MyGoPackages: [],
                Instances: instances,
                Solver: solver,
                TypedDecls: info.TypedDecls,
                ExternalTypedDecls: [],
                TypedDeclSources: buildTypedDeclSources(files, info.TypedDecls, 0).Sources,
                ExternalTypedDeclSources: [],
                ResolvedConstraintArgs: info.ResolvedConstraintArgs,
              })
            end
            case Err(msg) then
              let source = switch files.Get(0)
                case Some(file) => file.Path
                case None => "<input>"
              end
              Err(common2.WithExpressionSourceName(msg, source))
            end
          end
        end
      end
    end
    case Err(msg) => Err(msg)
  end
end

func InferPackageWithExternal(files: Slice[PkgDeclSource], external: Slice[PkgDeclSource], goPkgImports: Slice[GoPackageEntry], myGoPkgImports: Slice[MyGoPackageInfo]) -> Result[PackageInfo, String]
  # Merge user and external declarations for inference, then separate results.
  # External decls participate in type inference (so prelude types are visible)
  # but their typed forms go into ExternalTypedDecls instead of TypedDecls.
  let allDecls = flattenPkgDecls(files, 0, [])
  let extDecls = flattenPkgDecls(external, 0, [])
  let combined = appendDecls(allDecls, extDecls)
  # Collect MyGO imports (non-go:) so each import's top-level type and
  # function can be registered under `alias.Name` in the environment.  The
  # env entries wrap each member in TQualifiedName so qualified access such
  # as `ps.ParseInput(...)` resolves through the normal env lookup path.
  let mygoAliases = collectMyGoPackageImports(allDecls)
  switch prepareInferenceSetup(
    combined,
    goPkgImports,
    mygoAliases,
    myGoPkgImports,
    []
  )
    case Ok(setup) then
      switch myGoPackageStructSymbols(myGoPkgImports, goPkgImports, [])
        case Ok(importedStructSymbols) then
          switch concatSymbols(setup.Symbols, importedStructSymbols)
            case None => Err("malformed imported symbols: missing index")
            case Some(initialSymbols) then
              switch symbolIndexFromSlice(initialSymbols, {})
                case None => Err("malformed symbol list: missing indexed entry")
                case Some(symbolIndex) then
                  let state = InferState {
                    FreshVarID: 1,
                    PkgInfo: Some(PkgInfo { Dir: "", Name: "", Decls: combined }),
                    GoPackages: goPkgImports,
                    MyGoPackages: myGoPkgImports,
                    MyGoPackageCache: myGoPkgImports,
                    Symbols: initialSymbols,
                    SymbolIndex: symbolIndex,
                    ActiveConstraints: [],
                    NamedImpls: namedImplNames(combined, 0, []),
                    ResolvedConstraintArgs: {},
                  }
                  let result = inferDecls(combined, setup.Env, [], state)
                  switch result
                    case Ok(info) then
                      let collected = collectInstances(allDecls)
                      let instances = mergeBuiltInInstances(collected)
                      let solver = solverFromInstances(instances)
                      # Split typed declarations by the original source sequence.  This is
                      # positional, not name-based, so identical impl shapes remain assigned
                      # to the file that supplied them.
                      let userTyped = buildTypedDeclSources(files, info.TypedDecls, 0)
                      let externalTyped = buildTypedDeclSources(external, info.TypedDecls, userTyped.Next)
                      Ok(PackageInfo {
                        Env: resolveEnvironment(solver, info.Env),
                        Fields: info.Fields,
                        GoPackages: goPkgImports,
                        MyGoPackages: myGoPkgImports,
                        Instances: instances,
                        Solver: solver,
                        TypedDecls: flattenPkgDecls(userTyped.Sources, 0, []),
                        ExternalTypedDecls: flattenPkgDecls(externalTyped.Sources, 0, []),
                        TypedDeclSources: userTyped.Sources,
                        ExternalTypedDeclSources: externalTyped.Sources,
                        ResolvedConstraintArgs: info.ResolvedConstraintArgs,
                      })
                    end
                    case Err(msg) => Err(common2.WithExpressionSourceName(msg, "<input>"))
                  end
                end
              end
            end
          end
        end
        case Err(msg) => Err(msg)
      end
    end
    case Err(msg) => Err(msg)
  end
end

# InferPackageWithExternalInfo infers only `files` while reusing an already
# inferred package (normally the main unit of an external test package) as
# external context.  The external declarations are already typed, so their
# bodies are not inferred again; this avoids re-running prelude inference once
# per external test unit.
func InferPackageWithExternalInfo(files: Slice[PkgDeclSource], externalInfo: PackageInfo, goPkgImports: Slice[GoPackageEntry], myGoPkgImports: Slice[MyGoPackageInfo]) -> Result[PackageInfo, String]
  let allDecls = flattenPkgDecls(files, 0, [])
  let externalDecls = appendDecls(externalInfo.ExternalTypedDecls, externalInfo.TypedDecls)
  let externalSources = appendPkgDeclSources(
    externalInfo.ExternalTypedDeclSources,
    externalInfo.TypedDeclSources
  )
  let mygoAliases = collectMyGoPackageImports(allDecls)
  # externalInfo.Env is newest-first and may repeat the same name (a function
  # is predeclared and then replaced by its inferred signature).  Batch the
  # entries with first-match-wins indexing to preserve that resolution order.
  switch prepareInferenceSetup(
    allDecls,
    goPkgImports,
    mygoAliases,
    myGoPkgImports,
    externalInfo.Env
  )
    case Ok(setup) then
      switch myGoPackageStructSymbols(myGoPkgImports, goPkgImports, [])
        case Ok(importedStructSymbols) then
          switch buildSymbolTable([], externalDecls, setup.Env)
            case None => Err("malformed external symbols: missing indexed entry")
            case Some(externalSymbols) then
              switch concatSymbols(setup.Symbols, externalSymbols)
                case None => Err("malformed symbol list: missing index")
                case Some(withExternal) then
                  switch concatSymbols(withExternal, importedStructSymbols)
                    case None => Err("malformed imported symbols: missing index")
                    case Some(initialSymbols) then
                      switch symbolIndexFromSlice(initialSymbols, {})
                        case None => Err("malformed symbol list: missing indexed entry")
                        case Some(symbolIndex) then
                          let named = namedImplNames(externalDecls, 0, namedImplNames(allDecls, 0, []))
                          let state = InferState {
                            FreshVarID: 1,
                            PkgInfo: Some(PkgInfo { Dir: "", Name: "", Decls: allDecls }),
                            GoPackages: goPkgImports,
                            MyGoPackages: [],
                            MyGoPackageCache: myGoPkgImports,
                            Symbols: initialSymbols,
                            SymbolIndex: symbolIndex,
                            ActiveConstraints: [],
                            NamedImpls: named,
                            ResolvedConstraintArgs: {},
                          }
                          let result = inferDecls(allDecls, setup.Env, externalInfo.Fields, state)
                          switch result
                            case Ok(info) then
                              let collected = collectInstances(allDecls)
                              let instances = mergeBuiltInInstances(collected)
                              let solver = solverFromInstances(instances)
                              let userTyped = buildTypedDeclSources(files, info.TypedDecls, 0)
                              Ok(PackageInfo {
                                Env: resolveEnvironment(solver, info.Env),
                                Fields: info.Fields,
                                GoPackages: goPkgImports,
                                MyGoPackages: myGoPkgImports,
                                Instances: instances,
                                Solver: solver,
                                TypedDecls: flattenPkgDecls(userTyped.Sources, 0, []),
                                ExternalTypedDecls: externalDecls,
                                TypedDeclSources: userTyped.Sources,
                                ExternalTypedDeclSources: externalSources,
                                ResolvedConstraintArgs: info.ResolvedConstraintArgs,
                              })
                            end
                            case Err(msg) => Err(common2.WithExpressionSourceName(msg, "<input>"))
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
        case Err(msg) => Err(msg)
      end
    end
    case Err(msg) => Err(msg)
  end
end

# ---------------------------------------------------------------------------
# Imported-package inference cache
# ---------------------------------------------------------------------------

# Process-wide cache of imported-package inference artifacts keyed by
# `path::alias`.  The bootstrap sync compiles packages that repeatedly import
# the same heavy packages (ast2, typeinference2, codegen2, ...); caching their
# member schemes and struct symbols avoids re-deriving the same declaration
# surface once per importer, which previously made typeinference2 superlinear
# in the number of referenced packages.
var importedPackageCache: Map[String, ImportedPackageCacheEntry] = {}

struct ImportedPackageCacheEntry
  # The package's declarations interpreted in its own import context: bare
  # member names -> Scheme.  Self-contained (built on importedPackageEnv), so
  # it is valid for any importer.
  PrivateEnv: Env
  # The alias-qualified projection (`alias.Name` -> Scheme plus bare enum
  # variant constructors) in addition order.  Layered onto an importer as a
  # single batch env layer with an O(1) index.
  Exported: Slice[EnvEntry]
  # Struct fields registered as symbols under `alias.TypeName`, in the same
  # order myGoPackageStructDeclSymbols produces.
  StructSymbols: Slice[Symbol]
  # Impl methods registered as symbols so a caller can dispatch a method on an
  # imported receiver type. The receiver key matches what
  # receiverQualifiedName rebuilds at the call site: a bare name for a
  # compiler-builtin receiver (e.g. Chan) and `alias.Name` for a
  # package-declared receiver (e.g. concurrency.IChannel).
  ImplMethodSymbols: Slice[Symbol]
  # Cached collectMyGoTypeNames result.
  TypeNames: Slice[String]
end

# Build or fetch the cached inference artifacts for an imported package.
# Packages without declarations (unresolved bootstrap stubs) contribute
# nothing and are never cached.
func cachedImportedPackage(pkg: MyGoPackageInfo, alias: String, packages: Slice[MyGoPackageInfo], goPkgs: Slice[GoPackageEntry]) -> Result[ImportedPackageCacheEntry, String]
  if pkg.Decls.Len() == 0 then
    Ok(ImportedPackageCacheEntry {
      PrivateEnv: Env.New(),
      Exported: [],
      StructSymbols: [],
      ImplMethodSymbols: [],
      TypeNames: [],
    })
  else
    # Relative import paths such as `../lib` are only meaningful in the
    # importing workspace. Include the declaration surface in the process-wide
    # cache key so separate bootstrap workspaces cannot reuse stale exports
    # from another package with the same relative path and alias.
    let key = pkg.Path + "::" + alias + "::" + importedPackageDeclSignature(pkg.Decls, "")
    switch importedPackageCache.Get(key)
      case Some(entry) => Ok(entry)
      case None then
        switch buildImportedPackageCacheEntry(pkg, alias, packages, goPkgs)
          case Ok(built) =>
            importedPackageCache.Set(key, built)
            Ok(built)
          case Err(msg) => Err(msg)
        end
      end
    end
  end
end

func importedPackageDeclSignature(decls: Slice[ast2.Decl], out: String) -> String
  if decls.Len() == 0 then
    out
  else
    switch decls.Get(0)
      case None => importedPackageDeclSignature(common2.SliceDrop(decls, 1), out)
      case Some(decl) then
        let part = switch decl
          case FuncDecl(name, _, _, _, _, _) => "f:" + name
          case TypeAliasDecl(name, _, _) => "a:" + name
          case TypeDecl(name, _, _) => "t:" + name
          case StructDecl(name, _, fields) => "s:" + name + ":" + fields.Len().ToString()
          case InterfaceDecl(name, _, methods) => "i:" + name + ":" + methods.Len().ToString()
          case EnumDecl(name, _, variants) then
            "e:" + name + ":" + importedEnumVariantSignature(variants, "")
          end
          case ImplDecl(_, _, _, methods) => "m:" + methods.Len().ToString()
          case LetDecl(bind) => "l:" + bind.Name
          case VarDecl(bind) => "v:" + bind.Name
          case ImportDecl(alias, path) => "p:" + alias + ":" + path
        end
        importedPackageDeclSignature(common2.SliceDrop(decls, 1), out + "|" + part)
      end
    end
  end
end

func importedEnumVariantSignature(variants: Slice[ast2.Variant], out: String) -> String
  if variants.Len() == 0 then
    out
  else
    switch variants.Get(0)
      case None => out
      case Some(variant) then
        importedEnumVariantSignature(
          common2.SliceDrop(variants, 1),
          out + "," + variant.Name + ":" + variant.Fields.Len().ToString() + ":" + variant.Names.Fold("", func(names: String, field: String) -> String names + "." + field end)
        )
      end
    end
  end
end

func buildImportedPackageCacheEntry(pkg: MyGoPackageInfo, alias: String, packages: Slice[MyGoPackageInfo], goPkgs: Slice[GoPackageEntry]) -> Result[ImportedPackageCacheEntry, String]
  let typeNames = collectMyGoTypeNames(pkg.Decls, 0, [])
  switch importedPackageEnv(pkg, packages, goPkgs)
    case Ok(pkgEnv) then
      switch seedMyGoPackageDecls(pkg, 0, pkgEnv, packages)
        case None => Err("malformed imported package declarations: missing indexed entry")
        case Some(privateEnv) then
          let exported = exportMyGoPackageEntries(pkg.Decls, privateEnv, [], alias, pkg.Path, typeNames)
          let state = InferState {
            FreshVarID: 1,
            PkgInfo: None,
            GoPackages: goPkgs,
            MyGoPackages: packages,
            MyGoPackageCache: packages,
            Symbols: [],
            SymbolIndex: {},
            ActiveConstraints: [],
            NamedImpls: [],
            ResolvedConstraintArgs: {},
          }
          let structSymbols = myGoPackageStructDeclSymbols(pkg.Decls, alias, pkg.Path, typeNames, pkgEnv, state, [])
          switch myGoPackageImplMethodDeclSymbols(pkg.Decls, alias, pkg.Path, typeNames, privateEnv, [])
            case Some(implMethodSymbols) then
              Ok(ImportedPackageCacheEntry {
                PrivateEnv: privateEnv,
                Exported: exported,
                StructSymbols: structSymbols,
                ImplMethodSymbols: implMethodSymbols,
                TypeNames: typeNames,
              })
            end
            case None => Err("malformed imported package implementation: missing indexed entry")
          end
        end
      end
    end
    case Err(msg) => Err(msg)
  end
end

# Layer a batch of bindings (an imported package's exported surface) onto an
# importer environment as a single layer.  Lookups hit the O(1) index map, so
# a deep import graph costs one map probe per envGet instead of a
# thousands-of-links chain walk.
func envPutBatch(env: Env, entries: Slice[EnvEntry]) -> Option[Env]
  if entries.Len() == 0 then
    Some(env)
  else
    let index: Map[String, Scheme] = {}
    switch batchIndexFromEntries(entries, index, 0)
      case Some(indexed) then
        switch batchFreeVars(entries, [], 0)
          case Some(freeVars) then
            Some(Env {
              Entry: None,
              Batch: Some(BatchBindings {
                Index: indexed,
                Entries: entries,
                FreeVars: freeVars,
              }),
              Parent: Some(Ref.new(env)),
            })
          end
          case None => None
        end
      end
      case None => None
    end
  end
end

# Same as envPutBatch, but keeps the first occurrence of a repeated name.
# PackageInfo.Env is newest-first and a name can legitimately appear more than
# once, so the index must not let the older duplicate win.
func envPutBatchLatest(env: Env, entries: Slice[EnvEntry]) -> Option[Env]
  if entries.Len() == 0 then
    Some(env)
  else
    let index: Map[String, Scheme] = {}
    switch batchIndexFromEntriesLatest(entries, index, 0)
      case Some(indexed) then
        switch batchFreeVars(entries, [], 0)
          case Some(freeVars) then
            Some(Env {
              Entry: None,
              Batch: Some(BatchBindings {
                Index: indexed,
                Entries: entries,
                FreeVars: freeVars,
              }),
              Parent: Some(Ref.new(env)),
            })
          end
          case None => None
        end
      end
      case None => None
    end
  end
end

func batchIndexFromEntries(entries: Slice[EnvEntry], index: Map[String, Scheme], position: Int) -> Option[Map[String, Scheme]]
  if position >= entries.Len() then
    Some(index)
  else
    switch entries.Get(position)
      case Some(entry) then
        index.Set(entry.Name, entry.Scheme)
        batchIndexFromEntries(entries, index, position + 1)
      end
      case None => None
    end
  end
end

func batchIndexFromEntriesLatest(entries: Slice[EnvEntry], index: Map[String, Scheme], position: Int) -> Option[Map[String, Scheme]]
  if position >= entries.Len() then
    Some(index)
  else
    switch entries.Get(position)
      case Some(entry) then
        switch index.Get(entry.Name)
          case None => index.Set(entry.Name, entry.Scheme)
          case Some(_) => ()
        end
        batchIndexFromEntriesLatest(entries, index, position + 1)
      end
      case None => None
    end
  end
end

# Union of free type variables across a batch's entries, mirroring the
# per-entry logic of envFreeVars so generalization treats imported members
# exactly as it did when they were individual env layers.
func batchFreeVars(entries: Slice[EnvEntry], out: Slice[Int], index: Int) -> Option[Slice[Int]]
  if index >= entries.Len() then
    Some(out)
  else
    switch entries.Get(index)
      case Some(item) then
        let bodyFree = removeInts(freeVars(item.Scheme.Body, []), item.Scheme.Bound)
        let withPredicates = freeVarsPredicates(item.Scheme.Predicates, bodyFree)
        let combined = unionInts(out, withPredicates)
        batchFreeVars(entries, combined, index + 1)
      end
      case None => None
    end
  end
end

# Imported MyGO struct fields are not declarations of the current package,
# so buildSymbolTable cannot see them. Register them under their source alias
# plus type name (for example ast2.Param), preserving the same identity used
# by selector expressions and preventing same-named imported structs from
# colliding.
func myGoPackageStructSymbols(packages: Slice[MyGoPackageInfo], goPkgs: Slice[GoPackageEntry], out: Slice[Symbol]) -> Result[Slice[Symbol], String]
  # Keep the full package list fixed across iterations: a dotted annotation
  # such as `Slice[ast2.Decl]` must resolve against every imported package,
  # not just the ones not yet visited.  Dropping visited entries from the
  # shared list made `importedPackageEnv` and the state's MyGoPackageCache
  # lose `ast2` by the time a later package (e.g. typeinference2) was
  # processed, falling back to a bare TCon("Decl") that never unified with the
  # call-site TQualifiedName.
  myGoPackageStructSymbolsLoop(packages, packages, goPkgs, out)
end

func myGoPackageStructSymbolsLoop(allPackages: Slice[MyGoPackageInfo], packages: Slice[MyGoPackageInfo], goPkgs: Slice[GoPackageEntry], out: Slice[Symbol]) -> Result[Slice[Symbol], String]
  if packages.Len() == 0 then
    Ok(out)
  else
    switch packages.Get(0)
      case None => Err("imported MyGO package index is missing")
      case Some(pkg) then
        switch cachedImportedPackage(pkg, pkg.Alias, allPackages, goPkgs)
          case Ok(cached) then
            switch concatSymbols(out, cached.StructSymbols)
              case None => Err("malformed imported struct symbols: missing index")
              case Some(withStructs) then
                switch concatSymbols(withStructs, cached.ImplMethodSymbols)
                  case None => Err("malformed imported implementation symbols: missing index")
                  case Some(next) then
                    myGoPackageStructSymbolsLoop(allPackages, common2.SliceDrop(packages, 1), goPkgs, next)
                  end
                end
              end
            end
          end
          case Err(msg) => Err(msg)
        end
      end
    end
  end
end

func myGoPackageStructDeclSymbols(decls: Slice[ast2.Decl], alias: String, path: String, typeNames: Slice[String], env: Env, state: InferState, out: Slice[Symbol]) -> Slice[Symbol]
  if decls.Len() == 0 then
    out
  else
    switch decls.Get(0)
      case None then
        myGoPackageStructDeclSymbols(common2.SliceDrop(decls, 1), alias, path, typeNames, env, state, out)
      end
      case Some(decl) then
        let next = switch decl
          case StructDecl(name, tps, fields) then
            myGoStructFieldSymbols(alias + "." + name, fields, tps, path, typeNames, env, state, out)
          end
          case _ => out
        end
        myGoPackageStructDeclSymbols(common2.SliceDrop(decls, 1), alias, path, typeNames, env, state, next)
      end
    end
  end
end

# Project every imported package ImplDecl's methods into symbols a caller can
# use to dispatch a method on an imported receiver type. Each method's Scheme
# is built against the package's private env (so the receiver, parameters, and
# return resolve with the package's own spelling) and package-local type names
# are wrapped with TQualifiedName via the same path/typeNames pair used for the
# struct-field projection. The receiver key mirrors receiverQualifiedName at
# the call site: a compiler-builtin receiver (Chan, SendChan, RecvChan, ...)
# is not declared by the package and so stays bare; a package-declared receiver
# is qualified with the import alias.
func myGoPackageImplMethodDeclSymbols(decls: Slice[ast2.Decl], alias: String, path: String, typeNames: Slice[String], env: Env, out: Slice[Symbol]) -> Option[Slice[Symbol]]
  if decls.Len() == 0 then
    Some(out)
  else
    switch decls.Get(0)
      case None => None
      case Some(decl) then
        switch decl
          case ImplDecl(tps, target, iface, methods) then
            switch myGoImplMethodSymbols(tps, target, iface, methods, alias, path, typeNames, env, out)
              case Some(next) then
                myGoPackageImplMethodDeclSymbols(common2.SliceDrop(decls, 1), alias, path, typeNames, env, next)
              end
              case None => None
            end
          end
          case _ then
            myGoPackageImplMethodDeclSymbols(common2.SliceDrop(decls, 1), alias, path, typeNames, env, out)
          end
        end
      end
    end
  end
end

func myGoImplMethodSymbols(implTps: Slice[String], target: ast2.TypeExpr, iface: Option[ast2.TypeExpr], methods: Slice[ast2.ImplMethod], alias: String, path: String, typeNames: Slice[String], env: Env, out: Slice[Symbol]) -> Option[Slice[Symbol]]
  if methods.Len() == 0 then
    Some(out)
  else
    switch implReceiverName(target, iface)
      case None => None
      case Some(receiverName) then
        let declared = typeNames.Fold(false, func(found: Bool, name: String) -> Bool found || name == receiverName end)
        let key = if declared => alias + "." + receiverName else receiverName
        myGoImplMethodSymbolsLoop(implTps, methods, key, path, typeNames, env, out)
      end
    end
  end
end

func myGoImplMethodSymbolsLoop(implTps: Slice[String], methods: Slice[ast2.ImplMethod], key: String, path: String, typeNames: Slice[String], env: Env, out: Slice[Symbol]) -> Option[Slice[Symbol]]
  if methods.Len() == 0 then
    Some(out)
  else
    switch methods.Get(0)
      case None => None
      case Some(m) => myGoImplMethodSymbolsOne(implTps, methods, m, key, path, typeNames, env, out)
    end
  end
end

func myGoImplMethodSymbolsOne(implTps: Slice[String], methods: Slice[ast2.ImplMethod], m: ast2.ImplMethod, key: String, path: String, typeNames: Slice[String], env: Env, out: Slice[Symbol]) -> Option[Slice[Symbol]]
  switch appendStringSlice(implTps, m.Sig.TypeParams)
    case None => None
    case Some(combined) then
      switch paramsToTypesWithParamsInEnv(m.Sig.Params, combined, env, NewInferState())
        case None => None
        case Some(paramTypes) then
          let retType = switch m.Sig.Ret
            case Some(t) => typeFromASTInEnvWithParams(t, combined, env, NewInferState())
            case None => ast2.MonoType.TUnit
          end
          let predicates = predicatesFromConstraintsWithParams(m.Sig.Using, combined)
          let body = ast2.MonoType.TFunc(paramTypes, Ref.new(retType))
          switch wrapPkgTypesInMonoType(body, path, typeNames)
            case None then
              myGoImplMethodSymbolsLoop(implTps, common2.SliceDrop(methods, 1), key, path, typeNames, env, out)
            end
            case Some(wrappedBody) then
              let scheme = Scheme {
                Bound: typeParamIDs(combined, 1),
                Predicates: predicates,
                Body: wrappedBody,
              }
              myGoImplMethodSymbolsLoop(
                implTps,
                common2.SliceDrop(methods, 1),
                key,
                path,
                typeNames,
                env,
                out.Prepend(Symbol.ImplMethod(key, m.Sig.Name, scheme))
              )
            end
          end
        end
      end
    end
  end
end

func myGoPackageAliasForPath(packages: Slice[MyGoPackageInfo], path: String, index: Int) -> String
  if index >= packages.Len() then
    ""
  else
    switch packages.Get(index)
      case None => myGoPackageAliasForPath(packages, path, index + 1)
      case Some(pkg) then
        if pkg.Path == path then
          pkg.Alias
        else
          myGoPackageAliasForPath(packages, path, index + 1)
        end
      end
    end
  end
end

# A field type in an imported MyGO package may refer to a dependency imported
# by that package rather than by the current package. Recover the source alias
# from the package declarations so selectors use the same key as the projected
# struct-field symbols.
func myGoPackageGoAliasForPath(packages: Slice[MyGoPackageInfo], path: String, index: Int) -> String
  if index >= packages.Len() then
    ""
  else
    switch packages.Get(index)
      case None => myGoPackageGoAliasForPath(packages, path, index + 1)
      case Some(pkg) then
        switch myGoPackageGoAliasInDecls(pkg.Decls, path, 0)
          case Some(alias) then
            if alias != "" then
              alias
            else
              myGoPackageGoAliasForPath(packages, path, index + 1)
            end
          end
          case None => myGoPackageGoAliasForPath(packages, path, index + 1)
        end
      end
    end
  end
end

func myGoPackageGoAliasInDecls(decls: Slice[ast2.Decl], path: String, index: Int) -> Option[String]
  if index >= decls.Len() then
    None
  else
    switch decls.Get(index)
      case None => None
      case Some(decl) then
        switch decl
          case ImportDecl(alias, importedPath) then
            if importedPath == path then
              Some(alias)
            else
              myGoPackageGoAliasInDecls(decls, path, index + 1)
            end
          end
          case _ => myGoPackageGoAliasInDecls(decls, path, index + 1)
        end
      end
    end
  end
end

func myGoPackageImportPathForAlias(packages: Slice[MyGoPackageInfo], alias: String, index: Int) -> String
  if index >= packages.Len() then
    ""
  else
    switch packages.Get(index)
      case None => myGoPackageImportPathForAlias(packages, alias, index + 1)
      case Some(pkg) then
        switch myGoPackageImportPathInDecls(pkg.Decls, alias, 0)
          case Some(path) then
            if path != "" then
              path
            else
              myGoPackageImportPathForAlias(packages, alias, index + 1)
            end
          end
          case None => myGoPackageImportPathForAlias(packages, alias, index + 1)
        end
      end
    end
  end
end

func myGoPackageImportPathInDecls(decls: Slice[ast2.Decl], alias: String, index: Int) -> Option[String]
  if index >= decls.Len() then
    None
  else
    switch decls.Get(index)
      case None => None
      case Some(decl) then
        switch decl
          case ImportDecl(importAlias, path) then
            if importAlias == alias && !strings.HasPrefix(path, "go:") then
              Some(path)
            else
              myGoPackageImportPathInDecls(decls, alias, index + 1)
            end
          end
          case _ => myGoPackageImportPathInDecls(decls, alias, index + 1)
        end
      end
    end
  end
end

func myGoStructFieldSymbols(typeName: String, fields: Slice[ast2.Field], typeParams: Slice[String], path: String, typeNames: Slice[String], env: Env, state: InferState, out: Slice[Symbol]) -> Slice[Symbol]
  if fields.Len() == 0 then
    out
  else
    switch fields.Get(0)
      case None => out
      case Some(field) then
        let rawType = typeFromASTInEnvWithParams(field.Type, typeParams, env, state)
        switch wrapPkgTypesInMonoType(rawType, path, typeNames)
          case None then
            myGoStructFieldSymbols(typeName, common2.SliceDrop(fields, 1), typeParams, path, typeNames, env, state, out)
          end
          case Some(fieldType) then
            myGoStructFieldSymbols(
              typeName,
              common2.SliceDrop(fields, 1),
              typeParams,
              path,
              typeNames,
              env,
              state,
              out.Prepend(Symbol.StructField(typeName, field.Name, fieldType))
            )
          end
        end
      end
    end
  end
end

# Build the environment in which an imported package's own declarations are
# interpreted: its go: imports seeded with the caller's populated Go package
# signatures, then its MyGO imports seeded on top.  Dotted references inside
# the package's field types (for example `Slice[ast2.Decl]`) then resolve via
# env lookup exactly as they do in the package's own source.
func importedPackageEnv(pkg: MyGoPackageInfo, packages: Slice[MyGoPackageInfo], goPkgs: Slice[GoPackageEntry]) -> Result[Env, String]
  let goImports = importedGoPackageEntries(pkg.Decls, goPkgs, [])
  switch seedGoPackageEnv(goImports, initialEnv())
    case Ok(base) then
      seedMyGoPackageEnv(collectMyGoPackageImports(pkg.Decls), packages, goPkgs, base)
    end
    case Err(msg) => Err(msg)
  end
end

# Map the imported package's go: imports to populated GoPackageEntry values
# (re-aliased to the imported package's own spelling) so FFI types referenced
# in its fields are qualified with the correct `go:` import path.
func importedGoPackageEntries(decls: Slice[ast2.Decl], goPkgs: Slice[GoPackageEntry], out: Slice[GoPackageEntry]) -> Slice[GoPackageEntry]
  if decls.Len() == 0 then
    out
  else
    switch decls.Get(0)
      case None => importedGoPackageEntries(common2.SliceDrop(decls, 1), goPkgs, out)
      case Some(decl) then
        let next = switch decl
          case ImportDecl(alias, path) then
            if strings.HasPrefix(path, "go:") then
              switch findGoPackageEntryByPath(goPkgs, path, 0)
                case Some(found) then
                  out.Append(GoPackageEntry {
                    Alias: alias,
                    Path: path,
                    Funcs: found.Funcs,
                    Types: found.Types,
                  })
                end
                case None => out
              end
            else
              out
            end
          end
          case _ => out
        end
        importedGoPackageEntries(common2.SliceDrop(decls, 1), goPkgs, next)
      end
    end
  end
end

func findGoPackageEntryByPath(goPkgs: Slice[GoPackageEntry], path: String, index: Int) -> Option[GoPackageEntry]
  if index >= goPkgs.Len() then
    None
  else
    switch goPkgs.Get(index)
      case None => None
      case Some(entry) then
        if entry.Path == path then
          Some(entry)
        else
          findGoPackageEntryByPath(goPkgs, path, index + 1)
        end
      end
    end
  end
end

struct TypedDeclSourcesBuild
  Sources: Slice[PkgDeclSource]
  Next: Int
end

struct TypedDeclFileBuild
  Decls: Slice[ast2.Decl]
  Next: Int
end

# Associate typed declarations with source paths by consuming the inference
# output in the exact declaration order used to build the inference input.
# Imports have no TypedDecl, so they advance only the source cursor.
func buildTypedDeclSources(files: Slice[PkgDeclSource], typedDecls: Slice[ast2.Decl], start: Int) -> TypedDeclSourcesBuild
  buildTypedDeclSourcesLoop(files, typedDecls, 0, start, [])
end

func buildTypedDeclSourcesLoop(files: Slice[PkgDeclSource], typedDecls: Slice[ast2.Decl], fileIndex: Int, typedIndex: Int, out: Slice[PkgDeclSource]) -> TypedDeclSourcesBuild
  if fileIndex >= files.Len() then
    TypedDeclSourcesBuild { Sources: out, Next: typedIndex }
  else
    switch files.Get(fileIndex)
      case None => TypedDeclSourcesBuild { Sources: out, Next: typedIndex }
      case Some(file) then
        let built = buildTypedDeclFile(file.Decls, typedDecls, 0, typedIndex, [])
        let source = PkgDeclSource { Path: file.Path, Decls: built.Decls }
        buildTypedDeclSourcesLoop(files, typedDecls, fileIndex + 1, built.Next, out.Append(source))
      end
    end
  end
end

func buildTypedDeclFile(sourceDecls: Slice[ast2.Decl], typedDecls: Slice[ast2.Decl], sourceIndex: Int, typedIndex: Int, out: Slice[ast2.Decl]) -> TypedDeclFileBuild
  if sourceIndex >= sourceDecls.Len() then
    TypedDeclFileBuild { Decls: out, Next: typedIndex }
  else
    switch sourceDecls.Get(sourceIndex)
      case None => TypedDeclFileBuild { Decls: out, Next: typedIndex }
      case Some(sourceDecl) then
        switch sourceDecl
          case ImportDecl(_, _) then
            buildTypedDeclFile(sourceDecls, typedDecls, sourceIndex + 1, typedIndex, out)
          end
          case _ then
            switch typedDecls.Get(typedIndex)
              case None => TypedDeclFileBuild { Decls: out, Next: typedIndex }
              case Some(typed) then
                buildTypedDeclFile(sourceDecls, typedDecls, sourceIndex + 1, typedIndex + 1, out.Append(typed))
              end
            end
          end
        end
      end
    end
  end
end

func separateTypedDecls(all: Slice[ast2.Decl], user: Slice[ast2.Decl], ext: Slice[ast2.Decl]) -> DividedDecls
  # Match each typed decl back to its source (user or external) by name.
  DividedDecls {
    User: filterDeclsAgainst(all, user, 0, []),
    External: filterDeclsAgainst(all, ext, 0, []),
  }
end

struct DividedDecls
  User: Slice[ast2.Decl]
  External: Slice[ast2.Decl]
end

func filterDeclsAgainst(typedDecls: Slice[ast2.Decl], sourceDecls: Slice[ast2.Decl], index: Int, out: Slice[ast2.Decl]) -> Slice[ast2.Decl]
  if index >= typedDecls.Len() then
    out
  else
    switch typedDecls.Get(index)
      case None => out
      case Some(decl) then
        if typedDeclInSource(decl, sourceDecls, 0) then
          filterDeclsAgainst(typedDecls, sourceDecls, index + 1, out.Append(decl))
        else
          filterDeclsAgainst(typedDecls, sourceDecls, index + 1, out)
        end
      end
    end
  end
end

func typedDeclInSource(decl: ast2.Decl, source: Slice[ast2.Decl], index: Int) -> Bool
  if index >= source.Len() then
    false
  else
    switch source.Get(index)
      case None => false
      case Some(d) then
        if typedDeclEq(decl, d) then
          true
        else
          typedDeclInSource(decl, source, index + 1)
        end
      end
    end
  end
end

func typedDeclEq(a: ast2.Decl, b: ast2.Decl) -> Bool
  switch a
    # Aliases and defined types also need to be associated with their source
    # file after combined user/prelude inference.  Without these cases,
    # `separateTypedDecls` drops them from both output sets, so codegen2 never
    # emits package-local aliases such as `type Parser[A] = ...`.

    case TypeAliasDecl(nameA, _, _) then
      switch b
        case TypeAliasDecl(nameB, _, _) => nameA == nameB
        case _ => false
      end
    end
    case LetDecl(bindA) then
      switch b
        case LetDecl(bindB) => bindA.Name == bindB.Name
        case _ => false
      end
    end
    case VarDecl(bindA) then
      switch b
        case VarDecl(bindB) => bindA.Name == bindB.Name
        case _ => false
      end
    end
    case TypeDecl(nameA, _, _) then
      switch b
        case TypeDecl(nameB, _, _) => nameA == nameB
        case _ => false
      end
    end
    case StructDecl(nameA, _, _) then
      switch b
        case StructDecl(nameB, _, _) => nameA == nameB
        case _ => false
      end
    end
    case EnumDecl(nameA, _, _) then
      switch b
        case EnumDecl(nameB, _, _) => nameA == nameB
        case _ => false
      end
    end
    case InterfaceDecl(nameA, _, _) then
      switch b
        case InterfaceDecl(nameB, _, _) => nameA == nameB
        case _ => false
      end
    end
    case FuncDecl(nameA, _, _, _, _, _) then
      switch b
        case FuncDecl(nameB, _, _, _, _, _) => nameA == nameB
        case _ => false
      end
    end
    case ImplDecl(_, targetA, ifaceA, _) then
      switch b
        case ImplDecl(_, targetB, ifaceB, _) then
          ast2.TypesEqual(targetA, targetB) && optionTypesEqual(ifaceA, ifaceB)
        end
        case _ => false
      end
    end
    case _ => false
  end
end

func optionTypesEqual(a: Option[ast2.TypeExpr], b: Option[ast2.TypeExpr]) -> Bool
  switch a
    case Some(ta) then
      switch b
        case Some(tb) => ast2.TypesEqual(ta, tb)
        case _ => false
      end
    end
    case None => switch b
        case None => true
        case _ => false
      end
  end
end

func resolveEnvironment(solver: Solver, env: Slice[EnvEntry]) -> Slice[EnvEntry]
  resolveEnvironmentInto(solver, env, 0, [])
end

func resolveEnvironmentInto(solver: Solver, env: Slice[EnvEntry], index: Int, out: Slice[EnvEntry]) -> Slice[EnvEntry]
  if index >= env.Len() then
    out
  else
    switch env.Get(index)
      case None => resolveEnvironmentInto(solver, env, index + 1, out)
      case Some(entry) then
        let resolved = solverResolve(solver, entry.Scheme.Predicates, emptySubst())
        let predicates = switch resolved
          case Ok(items) => items
          case Err(_) => entry.Scheme.Predicates
        end
        resolveEnvironmentInto(
          solver,
          env,
          index + 1,
          out.Append(EnvEntry {
            Name: entry.Name,
            Scheme: Scheme {
              Bound: entry.Scheme.Bound,
              Predicates: predicates,
              Body: entry.Scheme.Body,
            },
          })
        )
      end
    end
  end
end

func collectInstances(decls: Slice[ast2.Decl]) -> Slice[Instance]
  if decls.Len() == 0 then
    []
  else
    switch decls.Get(0)
      case None => collectInstances(common2.SliceDrop(decls, 1))
      case Some(decl) then
        let rest = collectInstances(common2.SliceDrop(decls, 1))
        switch decl
          case ImplDecl(_, target, interfaceOpt, _) then
            switch interfaceOpt
              case Some(interfaceType) then
                switch typeFromAST(interfaceType)
                  case TCon(name) then
                    rest.Append(Instance {
                      ClassName: name,
                      Type: typeFromAST(target),
                      Predicates: [],
                    })
                  end
                  case _ => rest
                end
              end
              case None => rest
            end
          end
          case _ => rest
        end
      end
    end
  end
end

# Parser2 assigns line and column while parsing expressions.  Package-level
# Collect Go FFI package imports (go: prefix) from the declarations.
# These are real Go FFI packages whose function signatures are resolved through
# Go's go/types reflection and populated by bootstrapPopulateGoSignatures.
func collectGoPackageImports(decls: Slice[ast2.Decl]) -> Slice[GoPackageEntry]
  decls.Fold(
    [],
    func(out: Slice[GoPackageEntry], d: ast2.Decl) -> Slice[GoPackageEntry]
      switch d
        case ImportDecl(alias, path) then
          if !strings.HasPrefix(path, "go:") then
            out
          else
            let existing = out.Fold(
              false,
              func(found: Bool, e: GoPackageEntry) -> Bool
                found || e.Alias == alias
              end
            )
            if existing then
              out
            else
              out.Append(GoPackageEntry {
                Alias: alias,
                Path: path,
                Funcs: [],
                Types: [],
              })
            end
          end
        end
        case _ => out
      end
    end
  )
end

# Collect MyGO package imports (non-go:) from the declarations.
# Returns a list of (alias, path) tuples.
func collectMyGoPackageImports(decls: Slice[ast2.Decl]) -> Slice[(String, String)]
  decls.Fold(
    [],
    func(out: Slice[(String, String)], d: ast2.Decl) -> Slice[(String, String)]
      switch d
        case ImportDecl(alias, path) then
          if strings.HasPrefix(path, "go:") then
            out
          else
            let existing = out.Fold(
              false,
              func(found: Bool, item: (String, String)) -> Bool
                let (item0, _) = item
                found || item0 == alias
              end
            )
            if existing then
              out
            else
              out.Append((alias, path))
            end
          end
        end
        case _ => out
      end
    end
  )
end

# Seed the environment with MyGO package aliases resolved into per-member env
# entries.  Each top-level type or function from the imported package is
# registered as `alias.Name` -> a Scheme whose Body is
# `TQualifiedName(path, Ref.new(<original type>))`.  The inner type preserves
# the same shape used by `predeclareFunctions` / `predeclareEnum` for the
# current package, so downstream type equality treats imports the same as
# local declarations.
func seedMyGoPackageEnv(imports: Slice[(String, String)], packages: Slice[MyGoPackageInfo], goPkgs: Slice[GoPackageEntry], env: Env) -> Result[Env, String]
  if imports.Len() == 0 then
    Ok(env)
  else
    switch imports.Get(0)
      case None => Err("malformed import list: missing indexed entry")
      case Some(item) then
        let (alias, _) = item
        let pkg = findMyGoPackage(packages, alias)
        # Project the package's cached member schemes into the caller environment.
        # The first importer of a (path, alias) pair builds and caches the full
        # inference artifacts; later importers (including sibling packages in the
        # same sync run) only layer the precomputed entries, so the same heavy
        # package surface is never re-derived.
        switch cachedImportedPackage(pkg, alias, packages, goPkgs)
          case Ok(cached) then
            switch envPutBatch(env, cached.Exported)
              case Some(envWithMembers) then
                seedMyGoPackageEnv(common2.SliceDrop(imports, 1), packages, goPkgs, envWithMembers)
              end
              case None => Err("malformed imported environment: missing indexed entry")
            end
          end
          case Err(msg) => Err(msg)
        end
      end
    end
  end
end

func exportMyGoPackageEntries(decls: Slice[ast2.Decl], localEnv: Env, out: Slice[EnvEntry], alias: String, path: String, typeNames: Slice[String]) -> Slice[EnvEntry]
  if decls.Len() == 0 then
    out
  else
    switch decls.Get(0)
      case None then
        exportMyGoPackageEntries(common2.SliceDrop(decls, 1), localEnv, out, alias, path, typeNames)
      end
      case Some(decl) => exportMyGoPackageEntry(decls, decl, localEnv, out, alias, path, typeNames)
    end
  end
end

func exportMyGoPackageEntry(decls: Slice[ast2.Decl], decl: ast2.Decl, localEnv: Env, out: Slice[EnvEntry], alias: String, path: String, typeNames: Slice[String]) -> Slice[EnvEntry]
  let name = switch decl
    case FuncDecl(n, _, _, _, _, _) => n
    case TypeAliasDecl(n, _, _) => n
    case TypeDecl(n, _, _) => n
    case StructDecl(n, _, _) => n
    case EnumDecl(n, _, _) => n
    case InterfaceDecl(n, _, _) => n
    case _ => ""
  end
  let next = switch envGet(localEnv, name)
    case Some(scheme) then
      switch wrapPkgTypesInMonoType(scheme.Body, path, typeNames)
        case None => out
        case Some(wrapped) then
          let body = switch decl
            case FuncDecl(_, _, _, _, _, _) => ast2.MonoType.TQualifiedName(path, Ref.new(wrapped))
            case _ => wrapped
          end
          let withMember = out.Append(EnvEntry {
            Name: alias + "." + name,
            Scheme: Scheme {
              Bound: scheme.Bound,
              Predicates: scheme.Predicates,
              Body: body,
            },
          })
          switch decl
            case EnumDecl(enumName, tps, variants) then
              exportMyGoPackageEnumVariantEntries(alias, path, enumName, tps, variants, typeNames, localEnv, withMember)
            end
            case _ => withMember
          end
        end
      end
    end
    case None => out
  end
  exportMyGoPackageEntries(common2.SliceDrop(decls, 1), localEnv, next, alias, path, typeNames)
end

# Enum variants are selector members too (for example `ast2.TypeExpr.UnitType`).
# They are projected only after the enum's private, bare signature is complete.
func exportMyGoPackageEnumVariantEntries(alias: String, path: String, enumName: String, typeParams: Slice[String], variants: Slice[ast2.Variant], typeNames: Slice[String], localEnv: Env, out: Slice[EnvEntry]) -> Slice[EnvEntry]
  if variants.Len() == 0 then
    out
  else
    switch variants.Get(0)
      case None => out
      case Some(variant) then
        let enumType = ast2.MonoType.TQualifiedName(path, Ref.new(declaredType(enumName, typeParams)))
        let fieldTypes = wrapPkgTypesInSlice(
          typeArgsFromASTInEnvWithParamsList(variant.Fields, typeParams, localEnv, NewInferState()),
          path,
          typeNames
        )
        switch fieldTypes
          case None then
            exportMyGoPackageEnumVariantEntries(
              alias,
              path,
              enumName,
              typeParams,
              common2.SliceDrop(variants, 1),
              typeNames,
              localEnv,
              out
            )
          end
          case Some(wrappedFields) then
            let body = if variant.Fields.Len() == 0 then
              enumType
            else
              ast2.MonoType.TFunc(wrappedFields, Ref.new(enumType))
            end
            let scheme = Scheme { Bound: typeParamIDs(typeParams, 1), Predicates: [], Body: body }
            # Export only the qualified selector member. Registering the bare variant
            # name would pollute the importer's shared environment and could shadow
            # a type or constructor from another package (for example Error).
            let withQualified = out.Append(EnvEntry {
              Name: alias + "." + enumName + "." + variant.Name,
              Scheme: scheme,
            })
            exportMyGoPackageEnumVariantEntries(
              alias,
              path,
              enumName,
              typeParams,
              common2.SliceDrop(variants, 1),
              typeNames,
              localEnv,
              withQualified
            )
          end
        end
      end
    end
  end
end

# Look up the MyGoPackageInfo entry for a given alias.  When the alias is not
# present (bootstrap inference has not loaded the imported package), fall back
# to a stub whose Path equals the alias so qualified types still resolve.
func findMyGoPackage(packages: Slice[MyGoPackageInfo], alias: String) -> MyGoPackageInfo
  if packages.Len() == 0 then
    MyGoPackageInfo { Alias: alias, Path: alias, Decls: [] }
  else
    switch packages.Get(0)
      case None => findMyGoPackage(common2.SliceDrop(packages, 1), alias)
      case Some(pkg) then
        if pkg.Alias == alias then
          pkg
        else
          findMyGoPackage(common2.SliceDrop(packages, 1), alias)
        end
      end
    end
  end
end

# Build declarations in an imported package's private environment.  This is
# intentionally the same spelling that its own source uses: no package path
# is inserted while resolving sibling aliases and function signatures.
func seedMyGoPackageDecls(pkg: MyGoPackageInfo, index: Int, env: Env, packages: Slice[MyGoPackageInfo]) -> Option[Env]
  if index >= pkg.Decls.Len() then
    Some(env)
  else
    switch pkg.Decls.Get(index)
      case None => None
      case Some(decl) => seedMyGoPackageDecl(pkg, index, decl, env, packages)
    end
  end
end

func seedMyGoPackageDecl(pkg: MyGoPackageInfo, index: Int, decl: ast2.Decl, env: Env, packages: Slice[MyGoPackageInfo]) -> Option[Env]
  # Resolve dotted annotations such as `typeinference2.PackageInfo` against
  # the import cache so they canonicalize to TQualifiedName even when the
  # imported member scheme is not yet registered in this local env (the
  # package's own imports are seeded separately, and the caller may seed
  # sibling packages in any order).
  let state = InferState {
    FreshVarID: 1,
    PkgInfo: None,
    GoPackages: [],
    MyGoPackages: packages,
    MyGoPackageCache: packages,
    Symbols: [],
    SymbolIndex: {},
    ActiveConstraints: [],
    NamedImpls: [],
    ResolvedConstraintArgs: {},
  }
  switch decl
    case FuncDecl(name, tps, params, ret, _, constraints) then
      switch paramsToTypesWithParamsInEnv(params, tps, env, state)
        case None => None
        case Some(paramTypes) then
          let retType = switch ret
            case Some(t) => typeFromASTInEnvWithParams(t, tps, env, state)
            case None => ast2.MonoType.TUnit
          end
          let body = ast2.MonoType.TFunc(paramTypes, Ref.new(retType))
          seedMyGoPackageDecls(
            pkg,
            index + 1,
            envPut(
              env,
              name,
              Scheme {
                Bound: typeParamIDs(tps, 1),
                Predicates: predicatesFromConstraintsWithParams(constraints, tps),
                Body: body,
              }
            ),
            packages
          )
        end
      end
    end
    # Type aliases and nominal types are selectable package members just
    # like structs and enums.  Registering them is essential before parsing
    # a dotted annotation such as `ps.Parser[A]`; otherwise lookup falls
    # back to a bare TCon("Parser") and loses the import path.
    case TypeAliasDecl(name, tps, target) then
      # An alias is structurally identical to its target, including across
      # package boundaries. Keep the target unwrapped so `ps.Parser[A]`
      # expands to its function type rather than becoming a nominal Parser.
      let body = typeFromASTInEnvWithParams(target, tps, env, state)
      let scheme = Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: body }
      seedMyGoPackageDecls(pkg, index + 1, envPut(env, name, scheme), packages)
    end
    case TypeDecl(name, tps, _) then
      let scheme = Scheme {
        Bound: typeParamIDs(tps, 1),
        Predicates: [],
        Body: declaredType(name, tps),
      }
      seedMyGoPackageDecls(pkg, index + 1, envPut(env, name, scheme), packages)
    end
    case StructDecl(name, tps, _) then
      # Match ordinary AST type references: a non-generic struct is TCon,
      # while only a generic struct is represented as TApp.  tCon always
      # produced `TApp(TCon(name), [])` for imports, which diverged from the
      # `TCon(name)` a function annotation produces and broke struct-literal
      # field unification at import boundaries.
      let scheme = Scheme {
        Bound: typeParamIDs(tps, 1),
        Predicates: [],
        Body: declaredType(name, tps),
      }
      seedMyGoPackageDecls(pkg, index + 1, envPut(env, name, scheme), packages)
    end
    case EnumDecl(name, tps, variants) then
      # Match ordinary AST type references: a non-generic enum is TCon,
      # while only a generic enum is represented as TApp. Using tCon here
      # produced `TApp(TCon(name), [])` for imports, which diverged from
      # `TCon(name)` in a function annotation after qualification.
      let scheme = Scheme {
        Bound: typeParamIDs(tps, 1),
        Predicates: [],
        Body: declaredType(name, tps),
      }
      let withEnum = envPut(env, name, scheme)
      switch seedMyGoPackageEnumVariants(pkg, variants, name, tps, withEnum)
        case Some(envWithVariants) then
          seedMyGoPackageDecls(pkg, index + 1, envWithVariants, packages)
        end
        case None => None
      end
    end
    case InterfaceDecl(name, tps, _) then
      # Same shape rule as structs/enums: non-generic interfaces are TCon.
      let scheme = Scheme {
        Bound: typeParamIDs(tps, 1),
        Predicates: [],
        Body: declaredType(name, tps),
      }
      seedMyGoPackageDecls(pkg, index + 1, envPut(env, name, scheme), packages)
    end
    case _ => seedMyGoPackageDecls(pkg, index + 1, env, packages)
  end
end

# Imported enum constructors are registered only as qualified selectors.
func seedMyGoPackageEnumVariants(pkg: MyGoPackageInfo, variants: Slice[ast2.Variant], enumName: String, typeParams: Slice[String], env: Env) -> Option[Env]
  if variants.Len() == 0 then
    Some(env)
  else
    switch variants.Get(0)
      case None => None
      case Some(variant) then
        let enumType = declaredType(enumName, typeParams)
        let constructorType = if variant.Fields.Len() == 0 then
          enumType
        else
          let fieldTypes = typeArgsFromASTWithParams(variant.Fields, typeParams)
          ast2.MonoType.TFunc(fieldTypes, Ref.new(enumType))
        end
        let scheme = Scheme {
          Bound: typeParamIDs(typeParams, 1),
          Predicates: [],
          Body: constructorType,
        }
        let qualifiedName = pkg.Alias + "." + enumName + "." + variant.Name
        seedMyGoPackageEnumVariants(
          pkg,
          common2.SliceDrop(variants, 1),
          enumName,
          typeParams,
          envPut(env, qualifiedName, scheme)
        )
      end
    end
  end
end

# Collect the names of every top-level type declaration in a MyGO package.
# This includes aliases and nominal `type` declarations: an imported generic
# alias such as `type Parser[A] = ...` must be qualified in function
# signatures just like a struct or enum. Used by seedMyGoPackageDecls to
# decide which bare TCon
# references inside a foreign function signature should be re-qualified with
# the package's import path.
func collectMyGoTypeNames(decls: Slice[ast2.Decl], index: Int, out: Slice[String]) -> Slice[String]
  if index >= decls.Len() then
    out
  else
    switch decls.Get(index)
      case None => out
      case Some(decl) then
        let name = switch decl
          case TypeAliasDecl(n, _, _) => n
          case TypeDecl(n, _, _) => n
          case StructDecl(n, _, _) => n
          case EnumDecl(n, _, _) => n
          case InterfaceDecl(n, _, _) => n
          case _ => ""
        end
        let next = if name == "" then
          out
        else
          let exists = out.Fold(false, func(found: Bool, item: String) -> Bool found || item == name end)
          if exists then
            out
          else
            out.Append(name)
          end
        end
        collectMyGoTypeNames(decls, index + 1, next)
      end
    end
  end
end

# wrapPkgTypesInSlice wraps every TCon / TApp ctor whose name appears in
# `typeNames` with TQualifiedName(path, ...).  Prelude types (String, Int, etc.)
# and type-parameter references are left untouched.
func wrapPkgTypesInSlice(items: Slice[ast2.MonoType], path: String, typeNames: Slice[String]) -> Option[Slice[ast2.MonoType]]
  wrapPkgTypesInSliceInto(items, path, typeNames, 0, [])
end

func wrapPkgTypesInSliceInto(items: Slice[ast2.MonoType], path: String, typeNames: Slice[String], index: Int, out: Slice[ast2.MonoType]) -> Option[Slice[ast2.MonoType]]
  if index >= items.Len() then
    Some(out)
  else
    switch items.Get(index)
      case None => None
      case Some(item) then
        switch wrapPkgTypesInMonoType(item, path, typeNames)
          case None => None
          case Some(wrapped) then
            wrapPkgTypesInSliceInto(items, path, typeNames, index + 1, out.Append(wrapped))
          end
        end
      end
    end
  end
end

func wrapPkgTypesInMonoType(typ: ast2.MonoType, path: String, typeNames: Slice[String]) -> Option[ast2.MonoType]
  switch typ
    case TCon(name) then
      if common2.ContainsString(typeNames, name) then
        Some(ast2.MonoType.TQualifiedName(path, Ref.new(typ)))
      else
        Some(typ)
      end
    end
    case TApp(ctor, args) then
      switch wrapPkgTypesInMonoType(ctor.value(), path, typeNames)
        case None => None
        case Some(wrappedCtor) then
          switch wrapPkgTypesInSlice(args, path, typeNames)
            case None => None
            case Some(wrappedArgs) => Some(ast2.MonoType.TApp(Ref.new(wrappedCtor), wrappedArgs))
          end
        end
      end
    end
    case TFunc(params, ret) then
      switch wrapPkgTypesInSlice(params, path, typeNames)
        case None => None
        case Some(wrappedParams) then
          switch wrapPkgTypesInMonoType(ret.value(), path, typeNames)
            case None => None
            case Some(wrappedRet) => Some(ast2.MonoType.TFunc(wrappedParams, Ref.new(wrappedRet)))
          end
        end
      end
    end
    case TVariadic(params, ret) then
      switch wrapPkgTypesInSlice(params, path, typeNames)
        case None => None
        case Some(wrappedParams) then
          switch wrapPkgTypesInMonoType(ret.value(), path, typeNames)
            case None => None
            case Some(wrappedRet) then
              Some(ast2.MonoType.TVariadic(wrappedParams, Ref.new(wrappedRet)))
            end
          end
        end
      end
    end
    case TTuple(items) then
      switch wrapPkgTypesInSlice(items, path, typeNames)
        case None => None
        case Some(wrappedItems) => Some(ast2.MonoType.TTuple(wrappedItems))
      end
    end
    # A type already qualified with its canonical import path keeps that path;
    # only bare package-local names are re-qualified with `path`.  Rewriting
    # an existing TQualifiedName would turn a foreign reference such as
    # `ast2.Decl` into a local one and break unification at the call site.
    case TQualifiedName(foundPath, inner) then
      switch wrapPkgTypesInMonoType(inner.value(), path, typeNames)
        case None => None
        case Some(wrappedInner) then
          Some(ast2.MonoType.TQualifiedName(foundPath, Ref.new(wrappedInner)))
        end
      end
    end
    case _ => Some(typ)
  end
end

# Look up the path for a given alias from the MyGO package info slice.
func myGoPackagePath(packages: Slice[MyGoPackageInfo], alias: String) -> String
  if packages.Len() == 0 then
    alias
  else
    switch packages.Get(0)
      case None => myGoPackagePath(common2.SliceDrop(packages, 1), alias)
      case Some(pkg) then
        if pkg.Alias == alias then
          pkg.Path
        else
          myGoPackagePath(common2.SliceDrop(packages, 1), alias)
        end
      end
    end
  end
end

# Seed the environment with Go package member entries.  Each function and type
# exported by the Go package is registered as `alias.Name` with the original
# Go-derived MonoType wrapped in `TQualifiedName(path, ...)` so qualified
# `pkg.Func` / `pkg.Type` access resolves uniformly with MyGO imports.
func seedGoPackageEnv(goPkgs: Slice[GoPackageEntry], env: Env) -> Result[Env, String]
  if goPkgs.Len() == 0 then
    Ok(env)
  else
    switch goPkgs.Get(0)
      case None => Err("malformed Go package list: missing package entry")
      case Some(pkg) then
        switch seedGoPackageMembers(pkg, env)
          case Ok(withMembers) => seedGoPackageEnv(common2.SliceDrop(goPkgs, 1), withMembers)
          case Err(msg) => Err(msg)
        end
      end
    end
  end
end

func seedGoPackageMembers(pkg: GoPackageEntry, env: Env) -> Result[Env, String]
  switch seedGoPackageFuncs(pkg, pkg.Funcs, env)
    case Ok(withFuncs) then
      let withConsts = seedGoPackageConstants(pkg, pkg.Constants, withFuncs)
      Ok(seedGoPackageTypes(pkg, pkg.Types, withConsts))
    end
    case Err(msg) => Err(msg)
  end
end

# Register Go package-level constants as `alias.ConstName` (or bare `ConstName`
# for a dot-import) so a package selector like `time.Second` resolves to its
# declared Go type.  Unlike functions (whose whole signature becomes the
# scheme body) a constant's scheme body is just its type, so the selector is a
# plain value expression in MyGO.
func seedGoPackageConstants(pkg: GoPackageEntry, constants: Slice[GoConstSignature], env: Env) -> Env
  if constants.Len() == 0 then
    env
  else
    switch constants.Get(0)
      case None => seedGoPackageConstants(pkg, common2.SliceDrop(constants, 1), env)
      case Some(c) then
        switch goTypeNameWith(c.Type, Some(pkg), {})
          case Ok(mono) then
            seedGoPackageConstants(
              pkg,
              common2.SliceDrop(constants, 1),
              envPut(
                env,
                goPackageMemberName(pkg.Alias, c.Name),
                Scheme {
                  Bound: [],
                  Predicates: [],
                  Body: mono,
                }
              )
            )
          end
          case Err(_) => seedGoPackageConstants(pkg, common2.SliceDrop(constants, 1), env)
        end
      end
    end
  end
end

func seedGoPackageFuncs(pkg: GoPackageEntry, funcs: Slice[GoFuncSignature], env: Env) -> Result[Env, String]
  if funcs.Len() == 0 then
    Ok(env)
  else
    switch funcs.Get(0)
      case None => seedGoPackageFuncs(pkg, common2.SliceDrop(funcs, 1), env)
      case Some(fn) => seedGoPackageFunc(pkg, funcs, fn, env)
    end
  end
end

func seedGoPackageFunc(pkg: GoPackageEntry, funcs: Slice[GoFuncSignature], fn: GoFuncSignature, env: Env) -> Result[Env, String]
  # A Go package qualifies the selected function name, not its signature.
  # Wrapping the complete function type makes primitive results such as
  # strings.HasPrefix's Bool appear as `go:strings.Bool` after a call.
  # The declaration's generic type parameters are bound like a MyGO generic
  # function's, so `maps.Clone[M ~map[K]V]` stays polymorphic and each call
  # site instantiates its own fresh variables.
  switch GoSignatureTypeWithPackage(fn, pkg)
    case Ok(body) then
      let bound = typeParamIDs(fn.TypeParams, 1)
      seedGoPackageFuncs(
        pkg,
        common2.SliceDrop(funcs, 1),
        envPut(
          env,
          goPackageMemberName(pkg.Alias, fn.Name),
          Scheme {
            Bound: bound,
            Predicates: [],
            Body: body,
          }
        )
      )
    end
    case Err(msg) => Err(msg)
  end
end

# Register Go package-level types as `pkg.TypeName` and their exported methods
# as field-scheme entries keyed by `$field$pkg.TypeName.Method`.  The method
# scheme is a bare function type (no leading receiver parameter), matching
# how Go method selectors are invoked from MyGO (`recv.Method(args)`).
func seedGoPackageTypes(pkg: GoPackageEntry, types: Slice[GoTypeSignature], env: Env) -> Env
  if types.Len() == 0 then
    env
  else
    switch types.Get(0)
      case None => seedGoPackageTypes(pkg, common2.SliceDrop(types, 1), env)
      case Some(t) => seedGoPackageType(pkg, types, t, env)
    end
  end
end

func seedGoPackageType(pkg: GoPackageEntry, types: Slice[GoTypeSignature], t: GoTypeSignature, env: Env) -> Env
  let qualifiedName = goPackageMemberName(pkg.Alias, t.TypeName)
  # The type constructor's scheme body mirrors a generic type: the qualified
  # name keeps the structure of `pkg.X` so downstream codegen qualifies it,
  # and the type parameters are bound fresh so a polymorphic Go type can be
  # instantiated at each use site (rare, but supported symmetrically).
  let bound = typeParamIDs(t.TypeParams, 1)
  let inner = tCon(t.TypeName, typeParamsAsTypes(t.TypeParams, 1))
  let body = ast2.MonoType.TQualifiedName(pkg.Path, Ref.new(inner))
  let withType = envPut(env, qualifiedName, Scheme { Bound: bound, Predicates: [], Body: body })
  seedGoPackageTypes(pkg, common2.SliceDrop(types, 1), withType)
end

func emptyGoPackageEntry() -> GoPackageEntry
  GoPackageEntry {
    Alias: "",
    Path: "",
    Funcs: [],
    Types: [],
    Constants: [],
  }
end

# goPackageEntryForType finds the GoPackageEntry that owns a fully-qualified
# type name (`alias.TypeName`).  Method symbols carry only their signature, so
# package-aware signature resolution locates the owning package back through
# the type list.  Returns None for local (non-FFI) receiver names.
func goPackageEntryForType(typeName: String, packages: Slice[GoPackageEntry], index: Int) -> Option[GoPackageEntry]
  if index >= packages.Len() then
    None
  else
    switch packages.Get(index)
      case None => goPackageEntryForType(typeName, packages, index + 1)
      case Some(pkg) then
        if goPackageEntryHasType(pkg, typeName) then
          Some(pkg)
        else
          goPackageEntryForType(typeName, packages, index + 1)
        end
      end
    end
  end
end

func goPackageEntryHasType(pkg: GoPackageEntry, typeName: String) -> Bool
  goPackageEntryHasTypeInto(pkg.Types, pkg.Alias, typeName, 0)
end

func goPackageEntryHasTypeInto(types: Slice[GoTypeSignature], alias: String, typeName: String, index: Int) -> Bool
  if index >= types.Len() then
    false
  else
    switch types.Get(index)
      case None => goPackageEntryHasTypeInto(types, alias, typeName, index + 1)
      case Some(t) then
        if goPackageMemberName(alias, t.TypeName) == typeName then
          true
        else
          goPackageEntryHasTypeInto(types, alias, typeName, index + 1)
        end
      end
    end
  end
end

func GoSignatureType(sig: GoFuncSignature) -> Result[ast2.MonoType, String]
  GoSignatureTypeWithPackage(sig, emptyGoPackageEntry())
end

# Package-aware FFI signature conversion.  Bare type names that name one of the
# package's own exported types (including aliases such as goast.Expr) resolve
# to TQualifiedName(pkg.Path, TCon(name)) so they unify with annotations like
# `goast.Expr`.  An unresolvable type propagates as an Err rather than
# degenerating into a shared TVar.
func GoSignatureTypeWithPackage(sig: GoFuncSignature, pkg: GoPackageEntry) -> Result[ast2.MonoType, String]
  let typeParams = goTypeParamMap(sig.TypeParams)
  switch goSignatureTypesWithPackage(sig.Params, pkg, typeParams)
    case Ok(params) then
      switch goSignatureTypesWithPackage(sig.Results, pkg, typeParams)
        case Ok(results) then
          switch goSignatureResultShape(results)
            case None => Err("malformed Go signature results")
            case Some(result) then
              if sig.Variadic then
                switch goVariadicParamTypesWithPackage(sig.Params, pkg, typeParams)
                  case Ok(elemParams) => Ok(ast2.MonoType.TVariadic(elemParams, Ref.new(result)))
                  case Err(msg) => Err(msg)
                end
              else
                Ok(ast2.MonoType.TFunc(params, Ref.new(result)))
              end
            end
          end
        end
        case Err(msg) => Err(msg)
      end
    end
    case Err(msg) => Err(msg)
  end
end

func goSignatureResultShape(results: Slice[ast2.MonoType]) -> Option[ast2.MonoType]
  if results.Len() == 0 then
    Some(ast2.MonoType.TUnit)
  else
    if results.Len() == 2 then
      # Go convention: (value, error) maps to Result[value, error],
      # (value, bool) maps to Option[value]
      switch results.Get(0)
        case None => None
        case Some(first) then
          switch results.Get(1)
            case None => None
            case Some(second) then
              let shape = switch second
                case TCon(name) then
                  if name == "Bool" then
                    tCon("Option", [first])
                  else
                    tCon("Result", [first, second])
                  end
                end
                case _ => tCon("Result", [first, second])
              end
              Some(shape)
            end
          end
        end
      end
    else
      if results.Len() == 1 then
        # Go convention: a lone trailing error (func Foo() error) maps to
        # Result[(), error], matching the two-result (value, error) rule.
        switch results.Get(0)
          case None => None
          case Some(only) then
            let shape = switch only
              case TCon(name) then
                if name == "Error" || name == "error" then
                  tCon("Result", [ast2.MonoType.TUnit, only])
                else
                  only
                end
              end
              case _ => only
            end
            Some(shape)
          end
        end
      else
        Some(ast2.MonoType.TTuple(results))
      end
    end
  end
end

# Inline Go blocks declare their native Go result shape (`go[(T, error)]`).
# Like Go FFI signatures, a 2-tuple result follows the boundary convention:
# (T, error) -> Result[T, error] and (T, bool) -> Option[T].  This makes a
# tuple-typed inline Go expression interchangeable with an equivalent Go FFI
# call at the type level; the raw tuple shape remains available to tuple
# destructuring via ffiRawTupleResultType.
func inlineGoResultMono(t: ast2.MonoType) -> ast2.MonoType
  switch t
    case TTuple(items) then
      if items.Len() == 2 then
        switch goSignatureResultShape(items)
          case Some(result) => result
          case None => t
        end
      else
        t
      end
    end
    case _ => t
  end
end

# goVariadicParamTypes maps a variadic Go function's parameter strings to the
# element types MyGO callers unify against.  go/types reports the trailing
# parameter as the slice type (`...any` -> `[]any`); TVariadic carries the
# element type so each call argument binds it directly.
func goVariadicParamTypes(names: Slice[String], typeParams: Map[String, Int]) -> Result[Slice[ast2.MonoType], String]
  switch goSignatureTypes(names, typeParams)
    case Ok(mapped) then
      if mapped.Len() == 0 then
        Ok(mapped)
      else
        let lastIndex = mapped.Len() - 1
        switch mapped.Get(lastIndex)
          case None => Err("malformed Go variadic signature: missing final parameter type")
          case Some(last) => Ok(replaceGoParamTypes(mapped, lastIndex, goVariadicElementType(last)))
        end
      end
    end
    case Err(msg) => Err(msg)
  end
end

func goVariadicElementType(t: ast2.MonoType) -> ast2.MonoType
  switch t
    case TApp(typeRef, args) then
      switch typeRef.value()
        case TCon(name) then
          if name == "Slice" then
            switch args.Get(0)
              case Some(elem) => elem
              case None => t
            end
          else
            t
          end
        end
        case _ => t
      end
    end
    case _ => t
  end
end

func replaceGoParamTypes(mapped: Slice[ast2.MonoType], lastIndex: Int, element: ast2.MonoType) -> Slice[ast2.MonoType]
  var out: Slice[ast2.MonoType] = []
  var i: Int = 0
  while i < mapped.Len()
    if i == lastIndex then
      out = out.Append(element)
    else
      switch mapped.Get(i)
        case None => ()
        case Some(item) => out = out.Append(item)
      end
    end
    i = i + 1
  end
  out
end

# GoSignatureRawResultType preserves the Go boundary's native return shape.
# Most expressions expose the ergonomic Option/Result form from
# GoSignatureType; tuple destructuring deliberately requests this raw form.
func GoSignatureRawResultType(sig: GoFuncSignature) -> Result[ast2.MonoType, String]
  GoSignatureRawResultTypeWithPackage(sig, emptyGoPackageEntry())
end

# Package-aware variant of GoSignatureRawResultType.  Result strings that name
# a type defined inside the imported package itself (for example
# `context.WithTimeout`'s `CancelFunc`) are unresolvable without the owning
# package context; the plain entry point above therefore falls back to the
# spare shape only when no package was provided.  Tuple destructuring requests
# this raw form and always knows the callee's package.
func GoSignatureRawResultTypeWithPackage(sig: GoFuncSignature, pkg: GoPackageEntry) -> Result[ast2.MonoType, String]
  switch goSignatureTypesWithPackage(sig.Results, pkg, goTypeParamMap(sig.TypeParams))
    case Ok(results) then
      if results.Len() == 0 then
        Ok(ast2.MonoType.TUnit)
      else
        if results.Len() == 1 then
          switch results.Get(0)
            case Some(result) => Ok(result)
            case None => Err("missing Go signature result at index 0")
          end
        else
          Ok(ast2.MonoType.TTuple(results))
        end
      end
    end
    case Err(msg) => Err(msg)
  end
end

func goSignatureTypes(items: Slice[String], typeParams: Map[String, Int]) -> Result[Slice[ast2.MonoType], String]
  goSignatureTypesInto(items, typeParams, 0, emptyGoTypes())
end

func goSignatureTypesInto(items: Slice[String], typeParams: Map[String, Int], index: Int, out: Slice[ast2.MonoType]) -> Result[Slice[ast2.MonoType], String]
  if index >= items.Len() then
    Ok(out)
  else
    switch items.Get(index)
      case None => Err("missing Go signature type at index " + index.ToString())
      case Some(typeName) then
        switch goTypeNameWith(typeName, None, typeParams)
          case Ok(mt) => goSignatureTypesInto(items, typeParams, index + 1, out.Append(mt))
          case Err(msg) => Err(msg)
        end
      end
    end
  end
end

func goSignatureTypesWithPackage(items: Slice[String], pkg: GoPackageEntry, typeParams: Map[String, Int]) -> Result[Slice[ast2.MonoType], String]
  goSignatureTypesWithPackageInto(items, pkg, typeParams, 0, emptyGoTypes())
end

func goSignatureTypesWithPackageInto(items: Slice[String], pkg: GoPackageEntry, typeParams: Map[String, Int], index: Int, out: Slice[ast2.MonoType]) -> Result[Slice[ast2.MonoType], String]
  if index >= items.Len() then
    Ok(out)
  else
    switch items.Get(index)
      case None => Err("missing Go signature type at index " + index.ToString())
      case Some(typeName) then
        switch goTypeNameWith(typeName, Some(pkg), typeParams)
          case Ok(mt) then
            goSignatureTypesWithPackageInto(items, pkg, typeParams, index + 1, out.Append(mt))
          end
          case Err(msg) => Err(msg)
        end
      end
    end
  end
end

func emptyGoTypes() -> Slice[ast2.MonoType]
  []
end

# A builtin primitive type has two spellings: the Go name used by FFI
# signatures (`error`) and the MyGO constructor name (`Error`).  GoTypeName
# (Go FFI → MonoType), unify entry normalisation, and codegen declaration
# lowering all consult this one table, so the error alias needs no special
# case in any direction: every spelling resolves through the same pair.
struct GoPrimitivePair
  GoName: String
  MyGoName: String
end

func goPrimitivePairs() -> Slice[GoPrimitivePair]
  [
    GoPrimitivePair { GoName: "int", MyGoName: "Int" },
    GoPrimitivePair { GoName: "int8", MyGoName: "Int8" },
    GoPrimitivePair { GoName: "int16", MyGoName: "Int16" },
    GoPrimitivePair { GoName: "int32", MyGoName: "Int32" },
    GoPrimitivePair { GoName: "int64", MyGoName: "Int64" },
    GoPrimitivePair { GoName: "uint", MyGoName: "UInt" },
    GoPrimitivePair { GoName: "uint8", MyGoName: "UInt8" },
    GoPrimitivePair { GoName: "uint16", MyGoName: "UInt16" },
    GoPrimitivePair { GoName: "uint32", MyGoName: "UInt32" },
    GoPrimitivePair { GoName: "uint64", MyGoName: "UInt64" },
    GoPrimitivePair { GoName: "float32", MyGoName: "Float32" },
    GoPrimitivePair { GoName: "float64", MyGoName: "Float64" },
    GoPrimitivePair { GoName: "complex64", MyGoName: "Complex64" },
    GoPrimitivePair { GoName: "complex128", MyGoName: "Complex128" },
    GoPrimitivePair { GoName: "string", MyGoName: "String" },
    GoPrimitivePair { GoName: "bool", MyGoName: "Bool" },
    GoPrimitivePair { GoName: "byte", MyGoName: "Byte" },
    GoPrimitivePair { GoName: "rune", MyGoName: "Rune" },
    GoPrimitivePair { GoName: "uintptr", MyGoName: "Uintptr" },
    GoPrimitivePair { GoName: "error", MyGoName: "Error" },
    GoPrimitivePair { GoName: "any", MyGoName: "Any" },
  ]
end

func anyPrimitivePair(pairs: Slice[GoPrimitivePair], name: String, index: Int) -> Option[GoPrimitivePair]
  if index >= pairs.Len() then
    None
  else
    switch pairs.Get(index)
      case None => None
      case Some(pair) then
        if pair.GoName == name || pair.MyGoName == name then
          Some(pair)
        else
          anyPrimitivePair(pairs, name, index + 1)
        end
      end
    end
  end
end

func goSpelledPair(pairs: Slice[GoPrimitivePair], name: String, index: Int) -> Option[GoPrimitivePair]
  if index >= pairs.Len() then
    None
  else
    switch pairs.Get(index)
      case None => None
      case Some(pair) then
        if pair.GoName == name then
          Some(pair)
        else
          goSpelledPair(pairs, name, index + 1)
        end
      end
    end
  end
end

# PrimitiveGoSpelling maps either spelling of a builtin primitive to the Go
# name used in generated code (`Error` and `error` both map to `error`).
# Codegen consults this so declaration lowering never special-cases aliases.
func PrimitiveGoSpelling(name: String) -> Option[String]
  switch anyPrimitivePair(goPrimitivePairs(), name, 0)
    case Some(pair) => Some(pair.GoName)
    case None => None
  end
end

# PrimitiveMyGoSpelling maps the Go spelling of a builtin primitive to its
# canonical MyGO constructor name (Go FFI `error` becomes `Error`).  GoTypeName
# and unify entry normalisation use it; already-canonical names pass through
# untouched.
func PrimitiveMyGoSpelling(name: String) -> Option[String]
  switch goSpelledPair(goPrimitivePairs(), name, 0)
    case Some(pair) => Some(pair.MyGoName)
    case None => None
  end
end

# GoTypeName maps a Go signature type string (produced by go/types TypeString)
# to the MyGO MonoType representation.  Composite shapes are parsed
# recursively: `[]string` becomes Slice[String], `map[K]V` becomes Map[K, V]
# and `*T` becomes Ref[T].  The resolver returns a Result: an unresolvable
# boundary type name is an Err rather than a silent `any` fallback, so a Go
# FFI signature never degenerates to a bare TVar.
func GoTypeName(name: String) -> Result[ast2.MonoType, String]
  goTypeNameWith(name, None, {})
end

# Package-aware GoTypeName (package-aware names use the `...WithPackage`
# suffix): a bare name naming one of the package's own exported types
# (including exported aliases such as goast.Expr) becomes
# TQualifiedName(pkg.Path, TCon(name)).  Composite shapes recurse through the
# shared resolver so `[]Decl` keeps its qualified element.
func GoTypeNameWithPackage(name: String, pkg: GoPackageEntry) -> Result[ast2.MonoType, String]
  goTypeNameWith(name, Some(pkg), {})
end

# Shared Go-type resolver.  Both spellings recurse through this one walker;
# only the bare-name leaf differs (type-parameter lookup, then package
# resolution when pkg is present).  `typeParams` maps a Go generic parameter
# name to its bounded MyGO TParam id (negative).
func goTypeNameWith(name: String, pkg: Option[GoPackageEntry], typeParams: Map[String, Int]) -> Result[ast2.MonoType, String]
  let trimmed = strings.TrimSpace(name)
  if strings.HasPrefix(trimmed, "[]") then
    switch goTypeNameWith(strings.TrimPrefix(trimmed, "[]"), pkg, typeParams)
      case Ok(inner) => Ok(ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Slice")), [inner]))
      case Err(msg) => Err(msg)
    end
  else
    if strings.HasPrefix(trimmed, "map[") then
      let close = matchingCloseIndex(trimmed, 3)
      if close >= 0 then
        switch (substring(trimmed, 4, close), substring(trimmed, close + 1, trimmed.Len()))
          case (Some(key), Some(value)) then
            switch goTypeNameWith(key, pkg, typeParams)
              case Ok(k) then
                switch goTypeNameWith(value, pkg, typeParams)
                  case Ok(v) => Ok(ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Map")), [k, v]))
                  case Err(msg) => Err(msg)
                end
              end
              case Err(msg) => Err(msg)
            end
          end
          case _ => Err("malformed map type: " + trimmed)
        end
      else
        Err("unterminated map type: " + trimmed)
      end
    else
      if strings.HasPrefix(trimmed, "*") then
        switch goTypeNameWith(strings.TrimPrefix(trimmed, "*"), pkg, typeParams)
          case Ok(inner) => Ok(ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Ref")), [inner]))
          case Err(msg) => Err(msg)
        end
      elsif trimmed == "()" then
        Ok(ast2.MonoType.TUnit)
      else
        switch PrimitiveMyGoSpelling(trimmed)
          case Some(canonical) => Ok(ast2.MonoType.TCon(canonical))
          case None then
            if strings.HasPrefix(trimmed, "func(") then
              switch goFuncTypeName(trimmed, pkg, typeParams)
                case Ok(mt) => Ok(mt)
                case Err(msg) => Err(msg)
              end
            elsif strings.HasPrefix(trimmed, "<-chan ") then
              switch goTypeNameWith(strings.TrimPrefix(trimmed, "<-chan "), pkg, typeParams)
                case Ok(inner) then
                  Ok(ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("RecvChan")), [inner]))
                end
                case Err(msg) => Err(msg)
              end
            elsif strings.HasPrefix(trimmed, "chan<- ") then
              switch goTypeNameWith(strings.TrimPrefix(trimmed, "chan<- "), pkg, typeParams)
                case Ok(inner) then
                  Ok(ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("SendChan")), [inner]))
                end
                case Err(msg) => Err(msg)
              end
            elsif strings.HasPrefix(trimmed, "chan ") then
              switch goTypeNameWith(strings.TrimPrefix(trimmed, "chan "), pkg, typeParams)
                case Ok(inner) then
                  Ok(ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Chan")), [inner]))
                end
                case Err(msg) => Err(msg)
              end
            elsif trimmed == "interface{}" then
              Ok(ast2.MonoType.TCon("Any"))
            else
              switch typeParams.Get(trimmed)
                case Some(id) => Ok(ast2.MonoType.TParam(id))
                case None then
                  switch pkg
                    case Some(p) => goPackageTypeForNameWith(trimmed, p, typeParams)
                    case None => goUnqualifiedGoTypeName(trimmed, typeParams)
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

# A bare Go type name that is not a builtin primitive resolves nominally: a
# dotted name (`io.Writer`) becomes TQualifiedName("go:io", TCon("Writer"))
# using the Go package name qualifier that go/types TypeString renders, and
# anything else is an Err.  An FFI signature never degrades a type to a
# placeholder: qualifier-qualified types keep their identity even when the
# referenced package is not itself imported.
func goUnqualifiedGoTypeName(name: String, typeParams: Map[String, Int]) -> Result[ast2.MonoType, String]
  let dot = strings.Index(name, ".")
  if dot > 0 && dot + 1 < name.Len() then
    switch (substring(name, 0, dot), substring(name, dot + 1, name.Len()))
      case (Some(qualifier), Some(member)) then
        goQualifiedGoTypeName(qualifier, member, None, None, typeParams)
      end
      case _ => Err("unresolved Go type name: " + name)
    end
  else
    Err("unresolved Go type name: " + name)
  end
end

# Build a qualified MonoType for a Go `qualifier.member` name.  Instantiated
# generics render as `pkg.List[K, V]`: the bracketed type arguments resolve
# through the shared resolver (so generic parameters bind to TParams).  When
# `ownPath` is Some the qualifier names the package under resolution itself
# and the real `go:` import path is used (matching `pkg.Type` annotations);
# otherwise the qualifier is the Go package name and the nominal
# `go:<qualifier>` path is synthesised.
func goQualifiedGoTypeName(qualifier: String, member: String, ownPath: Option[String], pkg: Option[GoPackageEntry], typeParams: Map[String, Int]) -> Result[ast2.MonoType, String]
  let memberTrimmed = strings.TrimSpace(member)
  let opened = strings.Index(memberTrimmed, "[")
  if opened < 0 then
    let path = switch ownPath
      case Some(value) => value
      case None => "go:" + qualifier
    end
    Ok(ast2.MonoType.TQualifiedName(path, Ref.new(ast2.MonoType.TCon(memberTrimmed))))
  else
    let close = matchingCloseIndex(memberTrimmed, opened)
    if close < 0 then
      Err("unterminated generic type argument: " + memberTrimmed)
    else
      let base = switch substring(memberTrimmed, 0, opened)
        case Some(value) => strings.TrimSpace(value)
        case None => ""
      end
      let inner = switch substring(memberTrimmed, opened + 1, close)
        case Some(value) => value
        case None => ""
      end
      let argParts = splitGoTopLevelCommas(inner)
      switch goFuncPartTypes(argParts, pkg, typeParams, 0, [])
        case Ok(args) then
          let path = switch ownPath
            case Some(value) => value
            case None => "go:" + qualifier
          end
          Ok(ast2.MonoType.TApp(Ref.new(ast2.MonoType.TQualifiedName(path, Ref.new(ast2.MonoType.TCon(base)))), args))
        end
        case Err(msg) => Err(msg)
      end
    end
  end
end

# Whether `member` (possibly an instantiated generic `List[K]`) names one of
# the package's own exported types, ignoring any bracketed type arguments.
func goQualifiedMemberInPackage(pkg: GoPackageEntry, member: String) -> Bool
  let opened = strings.Index(member, "[")
  let base = if opened < 0 then
    member
  else
    switch substring(member, 0, opened)
      case Some(value) => value
      case None => member
    end
  end
  goPackageHasType(pkg, strings.TrimSpace(base))
end

func goTypeParamMap(params: Slice[String]) -> Map[String, Int]
  goTypeParamMapInto(params, 0, {})
end

func goTypeParamMapInto(params: Slice[String], position: Int, out: Map[String, Int]) -> Map[String, Int]
  if position >= params.Len() then
    out
  else
    switch params.Get(position)
      case Some(param) then
        out.Set(param, -(position + 1))
        goTypeParamMapInto(params, position + 1, out)
      end
      case None => out
    end
  end
end

# The Go package name (not the MyGO alias) that go/types TypeString qualifies
# the package's own types with.  Derived from the `go:` import path's final
# segment, matching stdlib packages (`go:fmt` -> `fmt`,
# `go:path/filepath` -> `filepath`).
func goPackageOwnName(pkg: GoPackageEntry) -> String
  let path = strings.TrimPrefix(pkg.Path, "go:")
  let slash = strings.LastIndex(path, "/")
  if slash >= 0 then
    switch substring(path, slash + 1, path.Len())
      case Some(value) => value
      case None => path
    end
  else
    path
  end
end

# A single-character string at `index`; empty when out of range.
func goCharAt(s: String, index: Int) -> String
  switch substring(s, index, index + 1)
    case Some(ch) => ch
    case None => ""
  end
end

func isGoOpenBracket(ch: String) -> Bool
  ch == "(" || ch == "[" || ch == "{"
end

func isGoCloseBracket(ch: String) -> Bool
  ch == ")" || ch == "]" || ch == "}"
end

# Find the index of the bracket that closes the opener at `open` (one of
# `(`, `[`, `{`), honouring nested pairs.  Returns -1 when unbalanced.
func matchingCloseIndex(s: String, open: Int) -> Int
  matchingCloseIndexAt(s, open + 1, 1)
end

func matchingCloseIndexAt(s: String, index: Int, depth: Int) -> Int
  if index >= s.Len() then
    -1
  else
    let ch = goCharAt(s, index)
    if isGoOpenBracket(ch) then
      matchingCloseIndexAt(s, index + 1, depth + 1)
    elsif isGoCloseBracket(ch) then
      if depth == 1 then
        index
      else
        matchingCloseIndexAt(s, index + 1, depth - 1)
      end
    else
      matchingCloseIndexAt(s, index + 1, depth)
    end
  end
end

# Index of the first space that is not inside any bracket pair, or -1.  A Go
# signature element `i int` splits into the name prefix `i` and the type `int`
# at this space; the element `types.Type` has none.
func firstTopLevelSpace(s: String) -> Int
  firstTopLevelSpaceAt(s, 0, 0)
end

func firstTopLevelSpaceAt(s: String, index: Int, depth: Int) -> Int
  if index >= s.Len() then
    -1
  else
    let ch = goCharAt(s, index)
    if ch == " " && depth == 0 then
      index
    elsif isGoOpenBracket(ch) then
      firstTopLevelSpaceAt(s, index + 1, depth + 1)
    elsif isGoCloseBracket(ch) then
      if depth > 0 then
        firstTopLevelSpaceAt(s, index + 1, depth - 1)
      else
        firstTopLevelSpaceAt(s, index + 1, depth)
      end
    else
      firstTopLevelSpaceAt(s, index + 1, depth)
    end
  end
end

# Split a Go parameter/result list on commas that are not inside bracket pairs.
func splitGoTopLevelCommas(s: String) -> Slice[String]
  splitGoTopLevelCommasFrom(s, 0, 0, 0, [])
end

func splitGoTopLevelCommasFrom(s: String, elemStart: Int, index: Int, depth: Int, out: Slice[String]) -> Slice[String]
  if index >= s.Len() then
    let elem = switch substring(s, elemStart, index)
      case Some(value) => strings.TrimSpace(value)
      case None => ""
    end
    if elem == "" then
      out
    else
      out.Append(elem)
    end
  else
    let ch = goCharAt(s, index)
    if ch == "," && depth == 0 then
      let elem = switch substring(s, elemStart, index)
        case Some(value) => strings.TrimSpace(value)
        case None => ""
      end
      if elem == "" then
        splitGoTopLevelCommasFrom(s, index + 1, index + 1, depth, out)
      else
        splitGoTopLevelCommasFrom(s, index + 1, index + 1, depth, out.Append(elem))
      end
    elsif isGoOpenBracket(ch) then
      splitGoTopLevelCommasFrom(s, elemStart, index + 1, depth + 1, out)
    elsif isGoCloseBracket(ch) then
      if depth > 0 then
        splitGoTopLevelCommasFrom(s, elemStart, index + 1, depth - 1, out)
      else
        splitGoTopLevelCommasFrom(s, elemStart, index + 1, depth, out)
      end
    else
      splitGoTopLevelCommasFrom(s, elemStart, index + 1, depth, out)
    end
  end
end

# The type text of a single Go parameter element: everything after the first
# top-level space (`i int` -> `int`), or the whole element when unnamed
# (`rune`, `types.Type`, `[]ast.Node`).
func goFuncPartTypeText(part: String) -> String
  let trimmed = strings.TrimSpace(part)
  let sep = firstTopLevelSpace(trimmed)
  if sep < 0 then
    trimmed
  else
    strings.TrimSpace(switch substring(trimmed, sep + 1, trimmed.Len())
      case Some(value) => value
      case None => trimmed
    end
)
  end
end

func goFuncPartTypes(parts: Slice[String], pkg: Option[GoPackageEntry], typeParams: Map[String, Int], index: Int, out: Slice[ast2.MonoType]) -> Result[Slice[ast2.MonoType], String]
  if index >= parts.Len() then
    Ok(out)
  else
    switch parts.Get(index)
      case None => Err("missing Go function type part at index " + index.ToString())
      case Some(part) then
        let typeText = goFuncPartTypeText(part)
        switch goTypeNameWith(typeText, pkg, typeParams)
          case Ok(mt) => goFuncPartTypes(parts, pkg, typeParams, index + 1, out.Append(mt))
          case Err(msg) => Err(msg)
        end
      end
    end
  end
end

func goFuncResultTypeName(resultsText: String, pkg: Option[GoPackageEntry], typeParams: Map[String, Int]) -> Result[ast2.MonoType, String]
  if resultsText == "" then
    Ok(ast2.MonoType.TUnit)
  else
    if strings.HasPrefix(resultsText, "(") then
      let close = matchingCloseIndex(resultsText, 0)
      if close < 0 then
        Err("unterminated Go func results: " + resultsText)
      else
        let inner = switch substring(resultsText, 1, close)
          case Some(value) => value
          case None => ""
        end
        let parts = splitGoTopLevelCommas(inner)
        switch goFuncPartTypes(parts, pkg, typeParams, 0, [])
          case Ok(types) then
            if types.Len() == 0 then
              Ok(ast2.MonoType.TUnit)
            elsif types.Len() == 1 then
              switch types.Get(0)
                case Some(t) => Ok(t)
                case None => Err("malformed Go func results: missing result type")
              end
            else
              Ok(ast2.MonoType.TTuple(types))
            end
          end
          case Err(msg) => Err(msg)
        end
      end
    else
      goTypeNameWith(resultsText, pkg, typeParams)
    end
  end
end

# Parse a Go anonymous function type rendered by go/types (`func(rune) bool`,
# `func(i int, j int) (bool, error)`) into a MyGO TFunc.  go/types spells each
# parameter with its own type and renders names, so declaration names are
# stripped per top-level element before the shared resolver recurses.
func goFuncTypeName(name: String, pkg: Option[GoPackageEntry], typeParams: Map[String, Int]) -> Result[ast2.MonoType, String]
  let open = strings.Index(name, "(")
  if open < 0 then
    Err("malformed Go func type: " + name)
  else
    let close = matchingCloseIndex(name, open)
    if close < 0 then
      Err("unterminated Go func type: " + name)
    else
      let paramsText = switch substring(name, open + 1, close)
        case Some(value) => value
        case None => ""
      end
      let resultsText = strings.TrimSpace(switch substring(name, close + 1, name.Len())
        case Some(value) => value
        case None => ""
      end
)
      let paramParts = splitGoTopLevelCommas(paramsText)
      switch goFuncPartTypes(paramParts, pkg, typeParams, 0, [])
        case Ok(paramTypes) then
          switch goFuncResultTypeName(resultsText, pkg, typeParams)
            case Ok(resultType) => Ok(ast2.MonoType.TFunc(paramTypes, Ref.new(resultType)))
            case Err(msg) => Err(msg)
          end
        end
        case Err(msg) => Err(msg)
      end
    end
  end
end

func goPackageTypeForNameWith(name: String, pkg: GoPackageEntry, typeParams: Map[String, Int]) -> Result[ast2.MonoType, String]
  let trimmed = strings.TrimSpace(name)
  let dot = strings.Index(trimmed, ".")
  if dot > 0 && dot + 1 < trimmed.Len() then
    switch (substring(trimmed, 0, dot), substring(trimmed, dot + 1, trimmed.Len()))
      case (Some(qualifier), Some(member)) then
        if qualifier == goPackageOwnName(pkg) && goQualifiedMemberInPackage(pkg, member) then
          # The package's own name, rendered qualified by go/types.  Resolve it
          # against the real `go:` import path so it unifies with `pkg.Type`
          # annotations and the type constructors registered in seedGoPackageTypes.
          switch goPackageOwnMemberType(pkg, member, typeParams)
            case Some(mt) => Ok(mt)
            case None then
              goQualifiedGoTypeName(qualifier, member, Some(pkg.Path), Some(pkg), typeParams)
            end
          end
        else
          # A foreign-package type (`io.Writer` in a fmt signature).  Keep the
          # nominal qualified identity; the qualifier is the Go package name.
          goQualifiedGoTypeName(qualifier, member, None, None, typeParams)
        end
      end
      case _ => Err("unresolved Go type name: " + name)
    end
  else
    if goPackageHasType(pkg, trimmed) then
      switch goPackageOwnMemberType(pkg, trimmed, typeParams)
        case Some(mt) => Ok(mt)
        case None then
          Ok(ast2.MonoType.TQualifiedName(pkg.Path, Ref.new(ast2.MonoType.TCon(trimmed))))
        end
      end
    else
      Err("unknown type " + trimmed + " in package " + pkg.Path)
    end
  end
end

# goPackageOwnMemberType resolves a member of the package's own type surface
# that has a callable or channel underlying shape: `context.CancelFunc`
# (underlying `func()`) becomes TFunc so a `cancel` value can be invoked, and
# a named channel type keeps its Chan shape.  Everything else (structs,
# primitives, slices, maps) and generic members stay nominal (None) so the
# caller falls back to the qualified identity handling.
func goPackageOwnMemberType(pkg: GoPackageEntry, member: String, typeParams: Map[String, Int]) -> Option[ast2.MonoType]
  let opened = strings.Index(member, "[")
  if opened >= 0 then
    None
  else
    switch goPackageTypeUnderlying(pkg, member)
      case Some(underlying) then
        if strings.HasPrefix(underlying, "func(") || strings.HasPrefix(underlying, "chan ") || strings.HasPrefix(underlying, "chan<- ") || strings.HasPrefix(underlying, "<-chan ") then
          switch goTypeNameWith(underlying, Some(pkg), typeParams)
            case Ok(mt) => Some(mt)
            case Err(_) => None
          end
        else
          None
        end
      end
      case None => None
    end
  end
end

func goPackageHasType(pkg: GoPackageEntry, name: String) -> Bool
  goPackageHasTypeInto(pkg.Types, name, 0)
end

func goPackageHasTypeInto(types: Slice[GoTypeSignature], name: String, index: Int) -> Bool
  if index >= types.Len() then
    false
  else
    switch types.Get(index)
      case None => goPackageHasTypeInto(types, name, index + 1)
      case Some(t) then
        if t.TypeName == name then
          true
        else
          goPackageHasTypeInto(types, name, index + 1)
        end
      end
    end
  end
end

# goPackageTypeUnderlying returns the rendered underlying type string of a
# package-local named type, or None when the type is not present.  The
# bootstrap loader stores `types.TypeString(named.Underlying())` in
# GoTypeSignature.Underlying so the boundary resolver can distinguish callable
# and channel-shaped named types without hard-coding package names.
func goPackageTypeUnderlying(pkg: GoPackageEntry, name: String) -> Option[String]
  goPackageTypeUnderlyingInto(pkg.Types, name, 0)
end

# goPackageTypeSignatureFor returns the FFI type signature a package declares
# for a local type name, or None when the package does not export it.
func goPackageTypeSignatureFor(pkg: GoPackageEntry, name: String, index: Int) -> Option[GoTypeSignature]
  if index >= pkg.Types.Len() then
    None
  else
    switch pkg.Types.Get(index)
      case None => goPackageTypeSignatureFor(pkg, name, index + 1)
      case Some(t) then
        if t.TypeName == name then
          Some(t)
        else
          goPackageTypeSignatureFor(pkg, name, index + 1)
        end
      end
    end
  end
end

func goPackageTypeUnderlyingInto(types: Slice[GoTypeSignature], name: String, index: Int) -> Option[String]
  if index >= types.Len() then
    None
  else
    switch types.Get(index)
      case None => goPackageTypeUnderlyingInto(types, name, index + 1)
      case Some(t) then
        if t.TypeName == name then
          if t.Underlying == "" then
            None
          else
            Some(t.Underlying)
          end
        else
          goPackageTypeUnderlyingInto(types, name, index + 1)
        end
      end
    end
  end
end

func goVariadicParamTypesWithPackage(names: Slice[String], pkg: GoPackageEntry, typeParams: Map[String, Int]) -> Result[Slice[ast2.MonoType], String]
  switch goSignatureTypesWithPackage(names, pkg, typeParams)
    case Ok(mapped) then
      if mapped.Len() == 0 then
        Ok(mapped)
      else
        let lastIndex = mapped.Len() - 1
        switch mapped.Get(lastIndex)
          case None => Err("malformed Go variadic signature: missing final parameter type")
          case Some(last) => Ok(replaceGoParamTypes(mapped, lastIndex, goVariadicElementType(last)))
        end
      end
    end
    case Err(msg) => Err(msg)
  end
end

# Flatten all package file declarations into a single slice.
func flattenPkgDecls(files: Slice[PkgDeclSource], index: Int, out: Slice[ast2.Decl]) -> Slice[ast2.Decl]
  if index >= files.Len() then
    out
  else
    switch files.Get(index)
      case None => flattenPkgDecls(files, index + 1, out)
      case Some(file) => flattenPkgDecls(files, index + 1, appendDecls(out, file.Decls))
    end
  end
end

func namedImplNames(decls: Slice[ast2.Decl], index: Int, out: Slice[String]) -> Slice[String]
  if index >= decls.Len() then
    out
  else
    switch decls.Get(index)
      case None => namedImplNames(decls, index + 1, out)
      case Some(decl) then
        switch decl
          case ImplDecl(_, target, iface, _) then
            switch iface
              case Some(_) then
                switch target
                  case NamedType(name, _) => namedImplNames(decls, index + 1, out.Append(name))
                  case _ => namedImplNames(decls, index + 1, out)
                end
              end
              case None => namedImplNames(decls, index + 1, out)
            end
          end
          case _ => namedImplNames(decls, index + 1, out)
        end
      end
    end
  end
end

# Predeclare all function signatures for forward reference support.
func predeclareAllFunctions(decls: Slice[ast2.Decl], env: Env) -> Option[Env]
  # Run declaration predeclaration twice so aliases from later source files
  # are visible while resolving earlier enum fields and function signatures.
  # The second pass only refreshes equivalent schemes, while aliases remain
  # transparent at every structural-symbol and pattern-binding boundary.
  switch predeclareFunctionsWithState(decls, env, NewInferState())
    case None => None
    case Some(aliasesVisible) then
      switch predeclareFunctionsWithState(decls, aliasesVisible, NewInferState())
        case None => None
        case Some(functionsVisible) => predeclareImplMethods(decls, functionsVisible)
      end
    end
  end
end

func appendDecls(acc: Slice[ast2.Decl], items: Slice[ast2.Decl]) -> Slice[ast2.Decl]
  if items.Len() == 0 then
    acc
  else
    switch items.Get(0)
      case None => appendDecls(acc, common2.SliceDrop(items, 1))
      case Some(item) => appendDecls(acc.Append(item), common2.SliceDrop(items, 1))
    end
  end
end

func appendPkgDeclSources(left: Slice[PkgDeclSource], right: Slice[PkgDeclSource]) -> Slice[PkgDeclSource]
  if right.Len() == 0 then
    left
  else
    switch right.Get(0)
      case None => appendPkgDeclSources(left, common2.SliceDrop(right, 1))
      case Some(source) => appendPkgDeclSources(left.Append(source), common2.SliceDrop(right, 1))
    end
  end
end
