package typeinference2

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import strings "go:strings"

func typeFromAST(t: ast2.TypeExpr) -> ast2.MonoType
  switch t
    case NamedType(name, args) => ast2.MonoType.TCon(name, typeArgsFromAST(args))
    case FuncType(params, ret) => ast2.MonoType.TFunc(typeArgsFromAST(params), Ref.new(typeFromAST(ret.value())))
    case TupleType(items) => ast2.MonoType.TTuple(typeArgsFromAST(items))
    case UnitType => ast2.MonoType.TUnit
    case InlineGo(inner, _) => typeFromAST(inner.value())
  end
end

func TypeFromAST(t: ast2.TypeExpr) -> ast2.MonoType
  typeFromAST(t)
end

func TypeFromASTWithParams(t: ast2.TypeExpr, params: Slice[String]) -> ast2.MonoType
  typeFromASTWithParams(t, params)
end

# Enum constructors carry their declared type parameters as HM variables.
# Keeping those variables distinct from names such as `A` is essential when a
# variant pattern is unified with a parameterized switch target (Option[A],
# Result[A, E], and so on).
func typeFromASTWithParams(t: ast2.TypeExpr, params: Slice[String]) -> ast2.MonoType
  switch t
    case NamedType(name, args) =>
      switch hktParamID(params, name, args, 1)
        case Some(id) => ast2.MonoType.TApp(Ref.new(ast2.MonoType.TKVar(id)), typeArgsFromASTWithParams(args, params))
        case None =>
          switch typeParamID(params, name, 1)
            case Some(id) => ast2.MonoType.TParam(id)
            case None => ast2.MonoType.TCon(name, typeArgsFromASTWithParams(args, params))
          end
      end
    case FuncType(items, ret) => ast2.MonoType.TFunc(typeArgsFromASTWithParams(items, params), Ref.new(typeFromASTWithParams(ret.value(), params)))
    case TupleType(items) => ast2.MonoType.TTuple(typeArgsFromASTWithParams(items, params))
    case UnitType => ast2.MonoType.TUnit
    case InlineGo(inner, _) => typeFromASTWithParams(inner.value(), params)
  end
end

func hktParamID(params: Slice[String], name: String, args: Slice[ast2.TypeExpr], index: Int) -> Option[Int]
  if params.Len() == 0 then None else
    let current = params.Get(0).UnwrapOr("")
    let expected = name + "[" + typeExprListString(args) + "]"
    if strings.Index(current, "[") > 0 && current == expected then Some(-index) else hktParamID(sliceDrop(params, 1), name, args, index + 1) end
  end
end

func typeExprListString(items: Slice[ast2.TypeExpr]) -> String
  if items.Len() == 0 then "" else
    let tail = typeExprListString(sliceDrop(items, 1))
    let head = typeExprString(items.Get(0).UnwrapOr(ast2.TypeExpr.UnitType()))
    if tail == "" then head else head + ", " + tail end
  end
end

func typeExprString(t: ast2.TypeExpr) -> String
  switch t
    case NamedType(name, args) => if args.Len() == 0 then name else name + "[" + typeExprListString(args) + "]" end
    case UnitType => "()"
    case TupleType(_) => "tuple"
    case FuncType(_, _) => "func"
    case InlineGo(inner, _) => typeExprString(inner.value())
  end
end

func typeArgsFromASTWithParams(items: Slice[ast2.TypeExpr], params: Slice[String]) -> Slice[ast2.MonoType]
  if items.Len() == 0 then
    []
  else
    typeArgsFromASTWithParams(sliceDrop(items, 1), params).Prepend(typeFromASTWithParams(items.Get(0).UnwrapOr(ast2.TypeExpr.UnitType()), params))
  end
end

func typeParamID(params: Slice[String], name: String, index: Int) -> Option[Int]
  if params.Len() == 0 then
    None
  else
    if params.Get(0).UnwrapOr("") == name then Some(-index) else typeParamID(sliceDrop(params, 1), name, index + 1) end
  end
end

func typeParamIDs(params: Slice[String], index: Int) -> Slice[Int]
  if params.Len() == 0 then
    []
  else
    typeParamIDs(sliceDrop(params, 1), index + 1).Prepend(-index)
  end
end

func typeArgsFromAST(items: Slice[ast2.TypeExpr]) -> Slice[ast2.MonoType]
  if items.Len() == 0 then
    []
  else
    typeArgsFromAST(sliceDrop(items, 1)).Prepend(typeFromAST(items.Get(0).UnwrapOr(ast2.TypeExpr.UnitType())))
  end
end

func typeFromASTInEnv(t: ast2.TypeExpr, env: Slice[EnvEntry], state: InferState) -> ast2.MonoType
  switch t
    case NamedType(name, args) =>
      if args.Len() == 0 then
        switch envGet(env, name)
          case Some(s) => instantiateQualified(s, state).Body
          case None => ast2.MonoType.TCon(name, typeArgsFromASTInEnv(args, env, state))
        end
      else
        ast2.MonoType.TCon(name, typeArgsFromASTInEnv(args, env, state))
      end
    case FuncType(params, ret) => ast2.MonoType.TFunc(typeArgsFromASTInEnv(params, env, state), Ref.new(typeFromASTInEnv(ret.value(), env, state)))
    case TupleType(items) => ast2.MonoType.TTuple(typeArgsFromASTInEnv(items, env, state))
    case UnitType => ast2.MonoType.TUnit
    case InlineGo(inner, _) => typeFromASTInEnv(inner.value(), env, state)
  end
end

func typeArgsFromASTInEnv(items: Slice[ast2.TypeExpr], env: Slice[EnvEntry], state: InferState) -> Slice[ast2.MonoType]
  if items.Len() == 0 then
    []
  else
    typeArgsFromASTInEnv(sliceDrop(items, 1), env, state).Prepend(typeFromASTInEnv(items.Get(0).UnwrapOr(ast2.TypeExpr.UnitType()), env, state))
  end
end

func paramsToTypes(params: Slice[ast2.Param]) -> Slice[ast2.MonoType]
  if params.Len() == 0 then
    []
  else
    paramsToTypes(sliceDrop(params, 1)).Prepend(typeFromAST(params.Get(0).UnwrapOr(ast2.Param { Name: "", Type: ast2.TypeExpr.UnitType() }).Type))
  end
end

func paramsToTypesWithParams(params: Slice[ast2.Param], typeParams: Slice[String]) -> Slice[ast2.MonoType]
  if params.Len() == 0 then [] else
    let param = params.Get(0).UnwrapOr(ast2.Param { Name: "", Type: ast2.TypeExpr.UnitType() })
    paramsToTypesWithParams(sliceDrop(params, 1), typeParams).Prepend(typeFromASTWithParams(param.Type, typeParams))
  end
end

func paramsToTypesInEnv(params: Slice[ast2.Param], env: Slice[EnvEntry], state: InferState) -> Slice[ast2.MonoType]
  if params.Len() == 0 then [] else
    let param = params.Get(0).UnwrapOr(ast2.Param { Name: "", Type: ast2.TypeExpr.UnitType() })
    paramsToTypesInEnv(sliceDrop(params, 1), env, state).Prepend(typeFromASTInEnv(param.Type, env, state))
  end
end

func envWithParamsAndTypes(env: Slice[EnvEntry], params: Slice[ast2.Param], types: Slice[ast2.MonoType]) -> Slice[EnvEntry]
  if params.Len() == 0 then env else
    let param = params.Get(0).UnwrapOr(ast2.Param { Name: "", Type: ast2.TypeExpr.UnitType() })
    let typ = types.Get(0).UnwrapOr(ast2.MonoType.TUnit)
    envWithParamsAndTypes(envPut(env, param.Name, Scheme { Bound: [], Predicates: [], Body: typ }), sliceDrop(params, 1), sliceDrop(types, 1))
  end
end

func envWithParams(env: Slice[EnvEntry], params: Slice[ast2.Param]) -> Slice[EnvEntry]
  if params.Len() == 0 then
    env
  else
    let p = params.Get(0).UnwrapOr(ast2.Param { Name: "", Type: ast2.TypeExpr.UnitType() })
    envWithParams(envPut(env, p.Name, Scheme { Bound: [], Predicates: [], Body: typeFromAST(p.Type) }), sliceDrop(params, 1))
  end
end

func envWithTypeParams(env: Slice[EnvEntry], typeParams: Slice[String]) -> Slice[EnvEntry]
  envWithTypeParamsLoop(env, typeParams, 1)
end

func envWithTypeParamsLoop(env: Slice[EnvEntry], typeParams: Slice[String], index: Int) -> Slice[EnvEntry]
  if typeParams.Len() == 0 then
    env
  else
    let name = typeParams.Get(0).UnwrapOr("")
    envWithTypeParamsLoop(envPut(env, name, Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TParam(-index) }), sliceDrop(typeParams, 1), index + 1)
  end
end

func initialEnv() -> Slice[EnvEntry]
  [
    EnvEntry { Name: "Int", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Int", emptyMonoTypes()) } },
    EnvEntry { Name: "Int8", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Int8", emptyMonoTypes()) } },
    EnvEntry { Name: "UInt8", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("UInt8", emptyMonoTypes()) } },
    EnvEntry { Name: "Int16", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Int16", emptyMonoTypes()) } },
    EnvEntry { Name: "UInt16", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("UInt16", emptyMonoTypes()) } },
    EnvEntry { Name: "Int32", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Int32", emptyMonoTypes()) } },
    EnvEntry { Name: "UInt32", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("UInt32", emptyMonoTypes()) } },
    EnvEntry { Name: "Int64", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Int64", emptyMonoTypes()) } },
    EnvEntry { Name: "UInt", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("UInt", emptyMonoTypes()) } },
    EnvEntry { Name: "UInt64", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("UInt64", emptyMonoTypes()) } },
    EnvEntry { Name: "Float32", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Float32", emptyMonoTypes()) } },
    EnvEntry { Name: "Float64", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Float64", emptyMonoTypes()) } },
    EnvEntry { Name: "Byte", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Byte", emptyMonoTypes()) } },
    EnvEntry { Name: "String", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("String", emptyMonoTypes()) } },
    EnvEntry { Name: "Bool", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Bool", emptyMonoTypes()) } },
    EnvEntry { Name: "Float", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Float", emptyMonoTypes()) } },
    EnvEntry { Name: "Rune", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Rune", emptyMonoTypes()) } },
    EnvEntry { Name: "Unit", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TUnit } },
    # Ref is a compiler-level reference type, unlike the algebraic/container
    # types supplied by prelude.
    EnvEntry { Name: "Ref", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Ref", emptyMonoTypes()) } },
    EnvEntry { Name: "true", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Bool", emptyMonoTypes()) } },
    EnvEntry { Name: "false", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Bool", emptyMonoTypes()) } },
    EnvEntry { Name: "len", Scheme: Scheme { Bound: [-1], Predicates: [], Body: ast2.MonoType.TFunc([ast2.MonoType.TParam(-1)], Ref.new(ast2.MonoType.TCon("Int", emptyMonoTypes()))) } },
    EnvEntry { Name: "append", Scheme: Scheme { Bound: [-1], Predicates: [], Body: ast2.MonoType.TFunc([ast2.MonoType.TCon("Slice", [ast2.MonoType.TParam(-1)]), ast2.MonoType.TParam(-1)], Ref.new(ast2.MonoType.TCon("Slice", [ast2.MonoType.TParam(-1)]))) } },
    EnvEntry { Name: "Some", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Some", emptyMonoTypes()) } },
    EnvEntry { Name: "Ok", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Ok", emptyMonoTypes()) } },
    EnvEntry { Name: "Err", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Err", emptyMonoTypes()) } },
    # EnvEntry { Name: "Zero", Scheme: Scheme { Bound: [], Predicates: [], Body: MonoType.TCon("Zero", emptyMonoTypes()) } },
  ]
end

func envGet(env: Slice[EnvEntry], name: String) -> Option[Scheme]
  if env.Len() == 0 then
    None
  else
    let item = env.Get(0).UnwrapOr(EnvEntry { Name: "", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TUnit } })
    if item.Name == name then
      Some(item.Scheme)
    else
      envGet(sliceDrop(env, 1), name)
    end
  end
end

func envPut(env: Slice[EnvEntry], name: String, scheme: Scheme) -> Slice[EnvEntry]
  env.Prepend(EnvEntry { Name: name, Scheme: scheme })
end

func envWithStructFields(env: Slice[EnvEntry], typeName: String, typeParams: Slice[String], fields: Slice[ast2.Field]) -> Slice[EnvEntry]
  env
end

func concatSymbols(acc: Slice[Symbol], items: Slice[Symbol]) -> Slice[Symbol]
  if items.Len() == 0 then acc else
    let head = items.Get(0).UnwrapOr(Symbol.StructField("", "", ast2.MonoType.TUnit))
    concatSymbols(acc.Append(head), sliceDrop(items, 1))
  end
end

func structSymbols(typeName: String, fields: Slice[ast2.Field], typeParams: Slice[String], out: Slice[Symbol]) -> Slice[Symbol]
  if fields.Len() == 0 then out else
    let f = fields.Get(0).UnwrapOr(ast2.Field { Name: "", Type: ast2.TypeExpr.UnitType(), Tag: None })
    let fieldType = typeFromASTWithParams(f.Type, typeParams)
    structSymbols(typeName, sliceDrop(fields, 1), typeParams, out.Prepend(Symbol.StructField(typeName, f.Name, fieldType)))
  end
end

func fieldsForStruct(typeName: String, fields: Slice[ast2.Field], out: Slice[FieldEntry]) -> Slice[FieldEntry]
  if fields.Len() == 0 then
    out
  else
    let f = fields.Get(0).UnwrapOr(ast2.Field { Name: "", Type: ast2.TypeExpr.UnitType(), Tag: None })
    # Note: fieldsForStruct intentionally uses typeFromAST (not typeFromASTWithParams)
    # because FieldEntry is used for codegen lookups that match on concrete type
    # names rather than type variable IDs.  Struct field type variables are resolved
    # through envWithStructFields + instantiateQualified at inference time.
    fieldsForStruct(typeName, sliceDrop(fields, 1), out.Append(FieldEntry { TypeName: typeName, FieldName: f.Name, Type: typeFromAST(f.Type) }))
  end
end

# Impl methods are registered as synthetic field entries keyed by
# "$field$<ReceiverType>.<MethodName>".  This lets ordinary `recv.Method(args)`
# calls resolve through the same path as struct field access: the callee is a
# FieldExpr whose stored scheme is a function type with the receiver parameter
# already stripped, mirroring the inherent-impl call sugar
# `recv.Method(args)` ~> `MangledName(recv, args)`.
#
# The receiver type name is the head constructor of:
#   - the iface's first type argument, for typeclass impls (`impl .. : Iface[T, ..]`),
#   - the impl target itself, for inherent impls (`impl T`).
func predeclareImplMethods(decls: Slice[ast2.Decl], env: Slice[EnvEntry]) -> Slice[EnvEntry]
  if decls.Len() == 0 then
    env
  else
    let head = decls.Get(0).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    let next = switch head
      case ImplDecl(tps, target, iface, methods) => registerImplMethods(tps, target, iface, methods, env)
      case _ => env
    end
    predeclareImplMethods(sliceDrop(decls, 1), next)
  end
end

func registerImplMethods(implTps: Slice[String], target: ast2.TypeExpr, iface: Option[ast2.TypeExpr], methods: Slice[ast2.ImplMethod], env: Slice[EnvEntry]) -> Slice[EnvEntry]
  let receiverName = implReceiverName(target, iface)
  if receiverName == "" || methods.Len() == 0 then
    env
  else
    registerImplMethodsLoop(implTps, receiverName, methods, env)
  end
end

func implMethodSymbols(receiverName: String, implTps: Slice[String], methods: Slice[ast2.ImplMethod], out: Slice[Symbol]) -> Slice[Symbol]
  if methods.Len() == 0 || receiverName == "" then out else
    let m = methods.Get(0).UnwrapOr(defaultImplMethod())
    let combined = appendStringSlice(implTps, m.Sig.TypeParams)
    let bound = typeParamIDs(combined, 1)
    let paramTypes = paramsToTypesWithParams(m.Sig.Params, combined)
    let retType = switch m.Sig.Ret
      case Some(t) => typeFromASTWithParams(t, combined)
      case None => ast2.MonoType.TUnit
    end
    let predicates = predicatesFromConstraintsWithParams(m.Sig.Using, combined)
    let scheme = Scheme { Bound: bound, Predicates: predicates, Body: ast2.MonoType.TFunc(paramTypes, Ref.new(retType)) }
    implMethodSymbols(receiverName, implTps, sliceDrop(methods, 1), out.Prepend(Symbol.ImplMethod(receiverName, m.Sig.Name, scheme)))
  end
end

func registerImplMethodsLoop(implTps: Slice[String], receiverName: String, methods: Slice[ast2.ImplMethod], env: Slice[EnvEntry]) -> Slice[EnvEntry]
  if methods.Len() == 0 then
    env
  else
    let m = methods.Get(0).UnwrapOr(defaultImplMethod())
    let combined = appendStringSlice(implTps, m.Sig.TypeParams)
    let bound = typeParamIDs(combined, 1)
    # Keep the receiver parameter inside the method type.  At every call site
    # `recv.Method(args)`, `inferField` unifies this receiver pattern with the
    # actual receiver type and then drops it, restoring the surface semantic
    # `recv.Method(args)` ~ `Thunk(recv, args)` while still binding the impl's
    # receiver type parameters to the actual element types (e.g. `T` in
    # `SliceIEnumerable[T].Fold` to `Parser[A]` when folding `Slice[Parser[A]]`).
    let paramTypes = paramsToTypesWithParams(m.Sig.Params, combined)
    let retType = switch m.Sig.Ret
      case Some(t) => typeFromASTWithParams(t, combined)
      case None => ast2.MonoType.TUnit
    end
    let predicates = predicatesFromConstraintsWithParams(m.Sig.Using, combined)
    let scheme = Scheme { Bound: bound, Predicates: predicates, Body: ast2.MonoType.TFunc(paramTypes, Ref.new(retType)) }
    registerImplMethodsLoop(implTps, receiverName, sliceDrop(methods, 1), envPut(env, receiverName + "." + m.Sig.Name, scheme))
  end
end

func implReceiverName(target: ast2.TypeExpr, iface: Option[ast2.TypeExpr]) -> String
  switch iface
    case Some(ifaceType) =>
      switch ifaceType
        case NamedType(_, args) =>
          switch args.Get(0).UnwrapOr(ast2.TypeExpr.UnitType())
            case NamedType(name, _) => name
            case _ => ""
          end
        case _ => ""
      end
    case None =>
      switch target
        case NamedType(name, _) => name
        case _ => ""
      end
  end
end

func appendStringSlice(a: Slice[String], b: Slice[String]) -> Slice[String]
  if a.Len() == 0 then
    b
  else
    appendStringSlice(sliceDrop(a, 1), b).Prepend(a.Get(0).UnwrapOr(""))
  end
end

func defaultImplMethod() -> ast2.ImplMethod
  ast2.ImplMethod {
    Pos: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 },
    Sig: defaultFuncSig(),
    Body: ast2.EmptyExpr(),
  }
end

func defaultFuncSig() -> ast2.FuncSig
  ast2.FuncSig {
    Pos: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 },
    Name: "",
    TypeParams: [] as Slice[String],
    Params: [] as Slice[ast2.Param],
    Ret: None,
    Using: [] as Slice[ast2.Constraint],
  }
end
