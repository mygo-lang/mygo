package typeinference2

import fmt "go:fmt"
import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import strings "go:strings"

func typeFromAST(t: ast2.TypeExpr) -> ast2.MonoType
  switch t
    case NamedType(name, args) then
      if args.Len() == 0 then
        ast2.MonoType.TCon(name)
      else
        ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon(name)), typeArgsFromAST(args))
      end
    end
    case FuncType(params, ret) => ast2.MonoType.TFunc(typeArgsFromAST(params), Ref.new(typeFromAST(ret.value())))
    case TupleType(items) => ast2.MonoType.TTuple(typeArgsFromAST(items))
    case UnitType => ast2.MonoType.TUnit
    case InlineGo(inner, _) => typeFromAST(inner.value())
  end
end

func TypeFromAST(t: ast2.TypeExpr) -> ast2.MonoType
  typeFromAST(t)
end

func TypeFromASTWithParams(t: ast2.TypeExpr, params: Slice[String]) -> ast2.MonoType
  typeFromASTWithParams(t, params)
end

# Enum constructors carry their declared type parameters as HM variables.
# Keeping those variables distinct from names such as `A` is essential when a
# variant pattern is unified with a parameterized switch target (Option[A],
# Result[A, E], and so on).
func typeFromASTWithParams(t: ast2.TypeExpr, params: Slice[String]) -> ast2.MonoType
  switch t
    case NamedType(name, args) then
      switch hktParamID(params, name, args, 1)
        case Some(id) => ast2.MonoType.TApp(Ref.new(ast2.MonoType.TKVar(id)), typeArgsFromASTWithParams(args, params))
        case None then
          switch typeParamID(params, name, 1)
            case Some(id) => ast2.MonoType.TParam(id)
            case None => ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon(name)), typeArgsFromASTWithParams(args, params))
          end
        end
      end
    end
    case FuncType(items, ret) => ast2.MonoType.TFunc(typeArgsFromASTWithParams(items, params), Ref.new(typeFromASTWithParams(ret.value(), params)))
    case TupleType(items) => ast2.MonoType.TTuple(typeArgsFromASTWithParams(items, params))
    case UnitType => ast2.MonoType.TUnit
    case InlineGo(inner, _) => typeFromASTWithParams(inner.value(), params)
  end
end

func hktParamID(params: Slice[String], name: String, args: Slice[ast2.TypeExpr], index: Int) -> Option[Int]
  if params.Len() == 0 then None else
    let current = params.Get(0).UnwrapOr("")
    let expected = name + "[" + typeExprListString(args) + "]"
    if strings.Index(current, "[") > 0 && current == expected then
      Some(-index)
    else
      hktParamID(sliceDrop(params, 1), name, args, index + 1)
    end
  end
end

func typeExprListString(items: Slice[ast2.TypeExpr]) -> String
  if items.Len() == 0 then
    ""
  else
    let tail = typeExprListString(sliceDrop(items, 1))
    switch items.Get(0)
      case Some(item) then
        let head = typeExprString(item)
        if tail == "" then
          head
        else
          head + ", " + tail
        end
      end
      case None => tail
    end
  end
end

func typeExprString(t: ast2.TypeExpr) -> String
  switch t
    case NamedType(name, args) then
      if args.Len() == 0 then
        name
      else
        name + "[" + typeExprListString(args) + "]"
      end
    end
    case UnitType => "()"
    case TupleType(_) => "tuple"
    case FuncType(_, _) => "func"
    case InlineGo(inner, _) => typeExprString(inner.value())
  end
end

func typeArgsFromASTWithParams(items: Slice[ast2.TypeExpr], params: Slice[String]) -> Slice[ast2.MonoType]
  typeArgsFromASTWithParamsInto(items, params, 0, [])
end

func typeArgsFromASTWithParamsInto(items: Slice[ast2.TypeExpr], params: Slice[String], index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= items.Len() then out else
    # Keep imported TypeExpr values out of a default-expression call.  In the
    # bootstrap environment `ast2.TypeExpr.UnitType` is a qualified enum
    # constructor; using it as UnwrapOr's fallback made the generic receiver
    # infer it as a thunk instead of an ast2.TypeExpr.
    switch items.Get(index)
      case Some(item) => typeArgsFromASTWithParamsInto(items, params, index + 1, out.Append(typeFromASTWithParams(item, params)))
      case None => typeArgsFromASTWithParamsInto(items, params, index + 1, out)
    end
  end
end

func typeParamID(params: Slice[String], name: String, index: Int) -> Option[Int]
  if params.Len() == 0 then
    None
  else
    if params.Get(0).UnwrapOr("") == name then Some(-index) else typeParamID(sliceDrop(params, 1), name, index + 1) end
  end
end

func typeParamIDs(params: Slice[String], index: Int) -> Slice[Int]
  typeParamIDsInto(params, index, 0, [])
end

func typeParamIDsInto(params: Slice[String], nextID: Int, position: Int, out: Slice[Int]) -> Slice[Int]
  if position >= params.Len() then out
  else typeParamIDsInto(params, nextID + 1, position + 1, out.Append(-nextID)) end
end

func typeArgsFromAST(items: Slice[ast2.TypeExpr]) -> Slice[ast2.MonoType]
  typeArgsFromASTInto(items, 0, [])
end

func typeArgsFromASTInto(items: Slice[ast2.TypeExpr], index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= items.Len() then out else
    switch items.Get(index)
      case Some(item) => typeArgsFromASTInto(items, index + 1, out.Append(typeFromAST(item)))
      case None => typeArgsFromASTInto(items, index + 1, out)
    end
  end
end

func substring(s: String, st: Int, en: Int) -> Option[String]
  s.Slice(st, en)
end

# typeFromASTInEnv resolves AST type expressions to MonoType, consulting the
# environment for both type parameters and imported package members.  When a
# NamedType has a dot-separated name and `alias.member` matches a known
# imported env entry, the result is wrapped in TQualifiedName using the
# package's import path so cross-file aliases all collapse to the same
# canonical type.  Top-level type parameters (passed in via `typeParams`)
# resolve to TParam / TKVar so generic signatures like `func[A] ... A ...`
# work without requiring envWithTypeParams to be in effect first.  This
# ensures that `ast2.SourcePos` is recognised consistently across files even
# if each file uses a different local alias for the same import path.
func typeFromASTInEnv(t: ast2.TypeExpr, env: Env, state: InferState) -> ast2.MonoType
  typeFromASTInEnvWithParams(t, [] as Slice[String], env, state)
end

func typeFromASTInEnvWithParams(t: ast2.TypeExpr, typeParams: Slice[String], env: Env, state: InferState) -> ast2.MonoType
  switch t
    case NamedType(name, args) then
      let dotPos = strings.Index(name, ".")
      if dotPos > 0 then
        let pkgName = substring(name, 0, dotPos).UnwrapOr("")
        let memberName = substring(name, dotPos + 1, name.Len()).UnwrapOr("")
        let resolvedArgs = typeArgsFromASTInEnvWithParamsList(args, typeParams, env, state)
        let inner = if args.Len() == 0 then
          ast2.MonoType.TCon(memberName)
        else
          ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon(memberName)), resolvedArgs)
        end
        switch envGet(env, pkgName + "." + memberName)
          case Some(s) then
            # Extract the canonical import path from the existing
            # TQualifiedName body and re-wrap our `inner` with that path so
            # different local aliases for the same import collapse to the
            # same canonical type.
            let q = instantiateQualified(s, state)
            # Keep q.Body in the same instantiated import-scheme boundary.
            # Passing it through qualifiedPath used a separately inferred
            # ast2.MonoType parameter and reintroduced the bare-vs-qualified
            # mismatch during bootstrap.
            let path = switch q.Body
              case TQualifiedName(foundPath, _) => foundPath
              case _ => ""
            end
            # Canonical qualified application form is
            # TApp(TQualifiedName(path, TCon(Name)), args), matching the
            # shape used when imported function signatures are seeded.  Do
            # not wrap the whole TApp: the two forms render alike but fail
            # structural unification.
            if path == "" then
              # Imported type aliases store their expanded target directly
              # (rather than a TQualifiedName wrapper). Apply the source
              # arguments to that scheme so aliases remain interchangeable
              # with their target across package boundaries.
              applySchemeTypeArgs(s, resolvedArgs)
            else
              let qualifiedCtor = ast2.MonoType.TQualifiedName(path, Ref.new(ast2.MonoType.TCon(memberName)))
              if args.Len() == 0 => qualifiedCtor else ast2.MonoType.TApp(Ref.new(qualifiedCtor), resolvedArgs)
            end
          end
          case None then
            # Bootstrap can parse a dependent package before all of its
            # member schemes have been registered in this local env.  The
            # import cache already owns the canonical path, however, so a
            # dotted source name must still become a qualified MonoType here
            # rather than falling back to TCon("ast2.MonoType").
            let cachedPath = myGoPackagePath(state.MyGoPackageCache, pkgName)
            if cachedPath == pkgName then
              inner
            else
              let qualifiedCtor = ast2.MonoType.TQualifiedName(cachedPath, Ref.new(ast2.MonoType.TCon(memberName)))
              if args.Len() == 0 => qualifiedCtor else ast2.MonoType.TApp(Ref.new(qualifiedCtor), resolvedArgs)
            end
          end
        end
      else
        # Single-segment names first check the explicit type-parameter
        # table (TParam / TKVar) and then fall through to env lookup, which
        # covers prelude / import / type-param-via-envWithTypeParams.
        if args.Len() == 0 then
          switch hktParamID(typeParams, name, args, 1)
            case Some(id) => ast2.MonoType.TKVar(id)
            case None then
              switch typeParamID(typeParams, name, 1)
                case Some(id) => ast2.MonoType.TParam(id)
                case None then
                  switch envGet(env, name)
                    case Some(s) then
                      let q = instantiateQualified(s, state)
                      let body = q.Body
                      body
                    end
                    case None => ast2.MonoType.TCon(name)
                  end
                end
              end
            end
          end
        else
          let resolvedArgs = typeArgsFromASTInEnvWithParamsList(args, typeParams, env, state)
          switch hktParamID(typeParams, name, args, 1)
            case Some(id) => ast2.MonoType.TApp(Ref.new(ast2.MonoType.TKVar(id)), resolvedArgs)
            case None =>
              switch envGet(env, name)
                case Some(s) => applySchemeTypeArgs(s, resolvedArgs)
                case None => ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon(name)), resolvedArgs)
              end
          end
        end
      end
    end
    case FuncType(params, ret) => ast2.MonoType.TFunc(typeArgsFromASTInEnvWithParamsList(params, typeParams, env, state), Ref.new(typeFromASTInEnvWithParams(ret.value(), typeParams, env, state)))
    case TupleType(items) => ast2.MonoType.TTuple(typeArgsFromASTInEnvWithParamsList(items, typeParams, env, state))
    case UnitType => ast2.MonoType.TUnit
    case InlineGo(inner, _) => typeFromASTInEnvWithParams(inner.value(), typeParams, env, state)
  end
end

# Explicit type arguments substitute a type alias's bound parameters before
# unification, so `Alias[A]` has exactly the identity of its target.
func applySchemeTypeArgs(scheme: Scheme, args: Slice[ast2.MonoType]) -> ast2.MonoType
  if scheme.Bound.Len() != args.Len() then
    ast2.MonoType.TApp(Ref.new(scheme.Body), args)
  else
    applySubst(typeArgSubst(scheme.Bound, args, emptySubst()), scheme.Body)
  end
end

func typeArgSubst(ids: Slice[Int], args: Slice[ast2.MonoType], out: Subst) -> Subst
  if ids.Len() == 0 then out else
    typeArgSubst(sliceDrop(ids, 1), sliceDrop(args, 1), substAppend(out, SubstEntry { ID: ids.Get(0).UnwrapOr(0), Type: args.Get(0).UnwrapOr(ast2.MonoType.TUnit) }))
  end
end

# qualifiedPath returns the canonical import path of a TQualifiedName body,
# or "" for any other shape.  Used by typeFromASTInEnv to canonicalise a
# dot-name AST reference against an existing imported env entry.
func qualifiedPath(t: ast2.MonoType) -> String
  switch t
    case TQualifiedName(path, _) => path
    case _ => ""
  end
end

func typeArgsFromASTInEnv(items: Slice[ast2.TypeExpr], env: Env, state: InferState) -> Slice[ast2.MonoType]
  typeArgsFromASTInEnvWithParamsList(items, [] as Slice[String], env, state)
end

func typeArgsFromASTInEnvWithParamsList(items: Slice[ast2.TypeExpr], typeParams: Slice[String], env: Env, state: InferState) -> Slice[ast2.MonoType]
  typeArgsFromASTInEnvWithParamsListInto(items, typeParams, env, state, 0, [])
end

func typeArgsFromASTInEnvWithParamsListInto(items: Slice[ast2.TypeExpr], typeParams: Slice[String], env: Env, state: InferState, index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= items.Len() then out else
    switch items.Get(index)
      case Some(item) => typeArgsFromASTInEnvWithParamsListInto(items, typeParams, env, state, index + 1, out.Append(typeFromASTInEnvWithParams(item, typeParams, env, state)))
      case None => typeArgsFromASTInEnvWithParamsListInto(items, typeParams, env, state, index + 1, out)
    end
  end
end

func paramsToTypes(params: Slice[ast2.Param]) -> Slice[ast2.MonoType]
  paramsToTypesInto(params, 0, [])
end

func paramsToTypesInto(params: Slice[ast2.Param], index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= params.Len() then
    out
  else
    paramsToTypesInto(params, index + 1, out.Append(typeFromAST(params.Get(index).UnwrapOr(ast2.Param { Name: "", Type: ast2.TypeExpr.UnitType }).Type)))
  end
end

func paramsToTypesWithParams(params: Slice[ast2.Param], typeParams: Slice[String]) -> Slice[ast2.MonoType]
  paramsToTypesWithParamsInto(params, typeParams, 0, [])
end

func paramsToTypesWithParamsInto(params: Slice[ast2.Param], typeParams: Slice[String], index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= params.Len() then
    out
  else
    let param = params.Get(index).UnwrapOr(ast2.Param { Name: "", Type: ast2.TypeExpr.UnitType })
    paramsToTypesWithParamsInto(params, typeParams, index + 1, out.Append(typeFromASTWithParams(param.Type, typeParams)))
  end
end

func paramsToTypesInEnv(params: Slice[ast2.Param], env: Env, state: InferState) -> Slice[ast2.MonoType]
  paramsToTypesInEnvInto(params, env, state, 0, [])
end

func paramsToTypesInEnvInto(params: Slice[ast2.Param], env: Env, state: InferState, index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= params.Len() then
    out
  else
    let param = params.Get(index).UnwrapOr(ast2.Param { Name: "", Type: ast2.TypeExpr.UnitType })
    paramsToTypesInEnvInto(params, env, state, index + 1, out.Append(typeFromASTInEnv(param.Type, env, state)))
  end
end

func paramsToTypesWithParamsInEnv(params: Slice[ast2.Param], typeParams: Slice[String], env: Env, state: InferState) -> Slice[ast2.MonoType]
  paramsToTypesWithParamsInEnvInto(params, typeParams, env, state, 0, [])
end

func paramsToTypesWithParamsInEnvInto(params: Slice[ast2.Param], typeParams: Slice[String], env: Env, state: InferState, index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= params.Len() then
    out
  else
    let param = params.Get(index).UnwrapOr(ast2.Param { Name: "", Type: ast2.TypeExpr.UnitType })
    paramsToTypesWithParamsInEnvInto(params, typeParams, env, state, index + 1, out.Append(typeFromASTInEnvWithParams(param.Type, typeParams, env, state)))
  end
end

func envWithParamsAndTypes(env: Env, params: Slice[ast2.Param], types: Slice[ast2.MonoType]) -> Env
  if params.Len() == 0 then
    env
  else
    let param = params.Get(0).UnwrapOr(ast2.Param { Name: "", Type: ast2.TypeExpr.UnitType })
    let typ = types.Get(0).UnwrapOr(ast2.MonoType.TUnit)
    envWithParamsAndTypes(envPut(env, param.Name, Scheme { Bound: [], Predicates: [], Body: typ }), sliceDrop(params, 1), sliceDrop(types, 1))
  end
end

func envWithParams(env: Env, params: Slice[ast2.Param]) -> Env
  if params.Len() == 0 then
    env
  else
    let p = params.Get(0).UnwrapOr(ast2.Param { Name: "", Type: ast2.TypeExpr.UnitType })
    envWithParams(envPut(env, p.Name, Scheme { Bound: [], Predicates: [], Body: typeFromAST(p.Type) }), sliceDrop(params, 1))
  end
end

func envWithTypeParams(env: Env, typeParams: Slice[String]) -> Env
  envWithTypeParamsLoop(env, typeParams, 1)
end

func envWithTypeParamsLoop(env: Env, typeParams: Slice[String], index: Int) -> Env
  if typeParams.Len() == 0 then
    env
  else
    let name = typeParams.Get(0).UnwrapOr("")
    envWithTypeParamsLoop(envPut(env, name, Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TParam(-index) }), sliceDrop(typeParams, 1), index + 1)
  end
end

func initialEnvEntries() -> Slice[EnvEntry]
  [
    EnvEntry { Name: "Int", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Int") } },
    EnvEntry { Name: "Int8", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Int8") } },
    EnvEntry { Name: "UInt8", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("UInt8") } },
    EnvEntry { Name: "Int16", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Int16") } },
    EnvEntry { Name: "UInt16", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("UInt16") } },
    EnvEntry { Name: "Int32", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Int32") } },
    EnvEntry { Name: "UInt32", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("UInt32") } },
    EnvEntry { Name: "Int64", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Int64") } },
    EnvEntry { Name: "UInt", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("UInt") } },
    EnvEntry { Name: "UInt64", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("UInt64") } },
    EnvEntry { Name: "Float32", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Float32") } },
    EnvEntry { Name: "Float64", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Float64") } },
    EnvEntry { Name: "Byte", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Byte") } },
    EnvEntry { Name: "String", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("String") } },
    EnvEntry { Name: "Bool", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Bool") } },
    EnvEntry { Name: "Float", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Float") } },
    EnvEntry { Name: "Rune", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Rune") } },
    EnvEntry { Name: "Unit", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TUnit } },
    # Ref is a compiler-level reference type, unlike the algebraic/container
    # types supplied by prelude.
    EnvEntry { Name: "Ref", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Ref") } },
    EnvEntry { Name: "true", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Bool") } },
    EnvEntry { Name: "false", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon("Bool") } },
    EnvEntry { Name: "len", Scheme: Scheme { Bound: [-1], Predicates: [], Body: ast2.MonoType.TFunc([ast2.MonoType.TParam(-1)], Ref.new(ast2.MonoType.TCon("Int"))) } },
    EnvEntry { Name: "append", Scheme: Scheme { Bound: [-1], Predicates: [], Body: ast2.MonoType.TFunc([ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Slice")), [ast2.MonoType.TParam(-1)]), ast2.MonoType.TParam(-1)], Ref.new(ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Slice")), [ast2.MonoType.TParam(-1)]))) } },
    # Keep enum constructors usable before external prelude declarations are
    # predeclared.  Placeholder TCons cannot participate in `case Some(x)`
    # because variant lookup needs both the field and result type.
    EnvEntry { Name: "Some", Scheme: Scheme { Bound: [-1], Predicates: [], Body: ast2.MonoType.TFunc([ast2.MonoType.TParam(-1)], Ref.new(ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Option")), [ast2.MonoType.TParam(-1)]))) } },
    EnvEntry { Name: "Ok", Scheme: Scheme { Bound: [-1, -2], Predicates: [], Body: ast2.MonoType.TFunc([ast2.MonoType.TParam(-1)], Ref.new(ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Result")), [ast2.MonoType.TParam(-1), ast2.MonoType.TParam(-2)]))) } },
    EnvEntry { Name: "Err", Scheme: Scheme { Bound: [-1, -2], Predicates: [], Body: ast2.MonoType.TFunc([ast2.MonoType.TParam(-2)], Ref.new(ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Result")), [ast2.MonoType.TParam(-1), ast2.MonoType.TParam(-2)]))) } },
    # EnvEntry { Name: "Zero", Scheme: Scheme { Bound: [], Predicates: [], Body: MonoType.TCon("Zero") } },
  ]
end

func initialEnv() -> Env
  let entries = initialEnvEntries()
  envFromEntries(entries, 0)
end

func envFromEntries(entries: Slice[EnvEntry], index: Int) -> Env
  if index >= entries.Len() then Env.New() else
    let parent = envFromEntries(entries, index + 1)
    let entry = entries.Get(index).UnwrapOr(EnvEntry { Name: "", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TUnit } })
    parent.Put(entry.Name, entry.Scheme)
  end
end

func envGet(env: Env, name: String) -> Option[Scheme]
  env.Get(name)
end

func envPut(env: Env, name: String, scheme: Scheme) -> Env
  env.Put(name, scheme)
end

func envWithStructFields(env: Env, typeName: String, typeParams: Slice[String], fields: Slice[ast2.Field]) -> Env
  env
end

func concatSymbols(acc: Slice[Symbol], items: Slice[Symbol]) -> Slice[Symbol]
  if items.Len() == 0 then acc else
    let head = items.Get(0).UnwrapOr(Symbol.StructField("", "", ast2.MonoType.TUnit))
    concatSymbols(acc.Append(head), sliceDrop(items, 1))
  end
end

func structSymbolsInEnv(typeName: String, fields: Slice[ast2.Field], typeParams: Slice[String], env: Env, state: InferState, out: Slice[Symbol]) -> Slice[Symbol]
  if fields.Len() == 0 then out else
    let f = fields.Get(0).UnwrapOr(ast2.Field { Name: "", Type: ast2.TypeExpr.UnitType, Tag: None })
    let fieldType = typeFromASTInEnvWithParams(f.Type, typeParams, env, state)
    structSymbolsInEnv(typeName, sliceDrop(fields, 1), typeParams, env, state, out.Prepend(Symbol.StructField(typeName, f.Name, fieldType)))
  end
end

func fieldsForStructInEnv(typeName: String, fields: Slice[ast2.Field], typeParams: Slice[String], env: Env, state: InferState, out: Slice[FieldEntry]) -> Slice[FieldEntry]
  if fields.Len() == 0 then
    out
  else
    let f = fields.Get(0).UnwrapOr(ast2.Field { Name: "", Type: ast2.TypeExpr.UnitType, Tag: None })
    let fieldType = typeFromASTInEnvWithParams(f.Type, typeParams, env, state)
    fieldsForStructInEnv(typeName, sliceDrop(fields, 1), typeParams, env, state, out.Append(FieldEntry { TypeName: typeName, FieldName: f.Name, Type: fieldType }))
  end
end

# Impl methods are registered as synthetic field entries keyed by
# "$field$<ReceiverType>.<MethodName>".  This lets ordinary `recv.Method(args)`
# calls resolve through the same path as struct field access: the callee is a
# FieldExpr whose stored scheme is a function type with the receiver parameter
# already stripped, mirroring the inherent-impl call sugar
# `recv.Method(args)` ~> `MangledName(recv, args)`.
#
# The receiver type name is the head constructor of:
#   - the iface's first type argument, for typeclass impls (`impl .. : Iface[T, ..]`),
#   - the impl target itself, for inherent impls (`impl T`).
func predeclareImplMethods(decls: Slice[ast2.Decl], env: Env) -> Env
  if decls.Len() == 0 then
    env
  else
    let head = decls.Get(0).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    let next = switch head
      case ImplDecl(tps, target, iface, methods) => registerImplMethods(tps, target, iface, methods, env)
      case _ => env
    end
    predeclareImplMethods(sliceDrop(decls, 1), next)
  end
end

func registerImplMethods(implTps: Slice[String], target: ast2.TypeExpr, iface: Option[ast2.TypeExpr], methods: Slice[ast2.ImplMethod], env: Env) -> Env
  let receiverName = implReceiverName(target, iface)
  if receiverName == "" || methods.Len() == 0 then
    env
  else
    registerImplMethodsLoop(implTps, receiverName, methods, env)
  end
end

func implMethodSymbols(receiverName: String, implTps: Slice[String], methods: Slice[ast2.ImplMethod], out: Slice[Symbol]) -> Slice[Symbol]
  if methods.Len() == 0 || receiverName == "" then
    out
  else
    let m = methods.Get(0).UnwrapOr(defaultImplMethod())
    let combined = appendStringSlice(implTps, m.Sig.TypeParams)
    let bound = typeParamIDs(combined, 1)
    let paramTypes = paramsToTypesWithParams(m.Sig.Params, combined)
    let retType = switch m.Sig.Ret
      case Some(t) => typeFromASTWithParams(t, combined)
      case None => ast2.MonoType.TUnit
    end
    let predicates = predicatesFromConstraintsWithParams(m.Sig.Using, combined)
    let scheme = Scheme { Bound: bound, Predicates: predicates, Body: ast2.MonoType.TFunc(paramTypes, Ref.new(retType)) }
    implMethodSymbols(receiverName, implTps, sliceDrop(methods, 1), out.Prepend(Symbol.ImplMethod(receiverName, m.Sig.Name, scheme)))
  end
end

func registerImplMethodsLoop(implTps: Slice[String], receiverName: String, methods: Slice[ast2.ImplMethod], env: Env) -> Env
  if methods.Len() == 0 then
    env
  else
    let m = methods.Get(0).UnwrapOr(defaultImplMethod())
    let combined = appendStringSlice(implTps, m.Sig.TypeParams)
    let bound = typeParamIDs(combined, 1)
    # Keep the receiver parameter inside the method type.  At every call site
    # `recv.Method(args)`, `inferField` unifies this receiver pattern with the
    # actual receiver type and then drops it, restoring the surface semantic
    # `recv.Method(args)` ~ `Thunk(recv, args)` while still binding the impl's
    # receiver type parameters to the actual element types (e.g. `T` in
    # `SliceIEnumerable[T].Fold` to `Parser[A]` when folding `Slice[Parser[A]]`).
    let paramTypes = paramsToTypesWithParams(m.Sig.Params, combined)
    let retType = switch m.Sig.Ret
      case Some(t) => typeFromASTWithParams(t, combined)
      case None => ast2.MonoType.TUnit
    end
    let predicates = predicatesFromConstraintsWithParams(m.Sig.Using, combined)
    let scheme = Scheme { Bound: bound, Predicates: predicates, Body: ast2.MonoType.TFunc(paramTypes, Ref.new(retType)) }
    registerImplMethodsLoop(implTps, receiverName, sliceDrop(methods, 1), envPut(env, receiverName + "." + m.Sig.Name, scheme))
  end
end

func implReceiverName(target: ast2.TypeExpr, iface: Option[ast2.TypeExpr]) -> String
  switch iface
    case Some(ifaceType) =>
      switch ifaceType
        case NamedType(_, args) =>
          switch args.Get(0).UnwrapOr(ast2.TypeExpr.UnitType)
            case NamedType(name, _) => name
            case _ => ""
          end
        case _ => ""
      end
    case None =>
      switch target
        case NamedType(name, _) => name
        case _ => ""
      end
  end
end

func appendStringSlice(a: Slice[String], b: Slice[String]) -> Slice[String]
  appendStringSliceInto(a, b, 0, [])
end

func appendStringSliceInto(a: Slice[String], b: Slice[String], index: Int, out: Slice[String]) -> Slice[String]
  if index >= a.Len() then appendStringSliceTail(b, 0, out)
  else appendStringSliceInto(a, b, index + 1, out.Append(a.Get(index).UnwrapOr(""))) end
end

func appendStringSliceTail(items: Slice[String], index: Int, out: Slice[String]) -> Slice[String]
  if index >= items.Len() then out
  else appendStringSliceTail(items, index + 1, out.Append(items.Get(index).UnwrapOr(""))) end
end

func defaultImplMethod() -> ast2.ImplMethod
  ast2.ImplMethod {
    Pos: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 },
    Sig: defaultFuncSig(),
    Body: ast2.EmptyExpr(),
  }
end

func defaultFuncSig() -> ast2.FuncSig
  ast2.FuncSig {
    Pos: ast2.SourcePos { SourceName: "", Line: 0, Column: 0 },
    Name: "",
    TypeParams: [] as Slice[String],
    Params: [] as Slice[ast2.Param],
    Ret: None,
    Using: [] as Slice[ast2.Constraint],
  }
end
