package typeinference2

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"

func monoEqual(a: ast2.MonoType, b: ast2.MonoType) -> Bool
  switch a
    case TVar(id) =>
      switch b
        case TVar(id2) => id == id2
        case _ => false
      end
    case TKVar(id) =>
      switch b
        case TKVar(id2) => id == id2
        case _ => false
      end
    case TParam(id) =>
      switch b
        case TParam(id2) => id == id2
        case _ => false
      end
    case TApp(ctor, args) =>
      switch b
        case TApp(ctor2, args2) => monoEqual(ctor.value(), ctor2.value()) && monoListEqual(args, args2)
        case _ => false
      end
    case TCon(name, args) =>
      switch b
        case TCon(name2, args2) => name == name2 && monoListEqual(args, args2)
        case _ => false
      end
    case TFunc(args, ret) =>
      switch b
        case TFunc(args2, ret2) => monoListEqual(args, args2) && monoEqual(ret.value(), ret2.value())
        case _ => false
      end
    case TTuple(items) =>
      switch b
        case TTuple(items2) => monoListEqual(items, items2)
        case _ => false
      end
    case TUnit =>
      switch b
        case TUnit => true
        case _ => false
      end
    case TGoPackage(alias) =>
      switch b
        case TGoPackage(alias2) => alias == alias2
        case _ => false
      end
  end
end

func monoListEqual(a: Slice[ast2.MonoType], b: Slice[ast2.MonoType]) -> Bool
  if a.Len() != b.Len() then
    false
  else
    if a.Len() == 0 then
      true
    else
      monoEqual(a.Get(0).UnwrapOr(ast2.MonoType.TUnit), b.Get(0).UnwrapOr(ast2.MonoType.TUnit)) && monoListEqual(sliceDrop(a, 1), sliceDrop(b, 1))
    end
  end
end

func monoString(t: ast2.MonoType) -> String
  switch t
    case TVar(id) => "t" + id.ToString()
    case TKVar(id) => "K" + id.ToString()
    case TParam(id) => "p" + id.ToString()
    case TCon(name, _) => name
    case TApp(ctor, _) => monoString(ctor.value()) + "[...]"
    case TFunc(_, _) => "func"
    case TTuple(_) => "tuple"
    case TUnit => "()"
    case TGoPackage(alias) => "go package " + alias
  end
end

func monoStringFull(t: ast2.MonoType) -> String
  switch t
    case TVar(id) => "t" + id.ToString()
    case TKVar(id) => "K" + id.ToString()
    case TParam(id) => "p" + id.ToString()
    case TCon(name, args) =>
      if args.Len() == 0 then name else name + "[" + monoListString(args) + "]" end
    case TApp(ctor, args) => monoStringFull(ctor.value()) + "[" + monoListString(args) + "]"
    case TFunc(args, ret) => "func(" + monoListString(args) + ") -> " + monoStringFull(ret.value())
    case TTuple(items) => "tuple(" + monoListString(items) + ")"
    case TUnit => "()"
    case TGoPackage(alias) => "go package " + alias
  end
end

func monoListString(items: Slice[ast2.MonoType]) -> String
  if items.Len() == 0 then "" else
    let head = monoStringFull(items.Get(0).UnwrapOr(ast2.MonoType.TUnit))
    let tail = monoListString(sliceDrop(items, 1))
    if tail == "" then head else head + ", " + tail end
  end
end

# Exported wrappers so that codegen2 can convert MonoType to MyGO type strings.
func MonoStringFull(t: ast2.MonoType) -> String
  monoStringFull(t)
end

func MonoListString(items: Slice[ast2.MonoType]) -> String
  monoListString(items)
end

func ApplySubst(subst: Slice[SubstEntry], t: ast2.MonoType) -> ast2.MonoType
  applySubst(subst, t)
end

func substString(subst: Slice[SubstEntry]) -> String
  if subst.Len() == 0 then "[]" else
    "[" + substStringLoop(subst, 0) + "]"
  end
end

func substStringLoop(subst: Slice[SubstEntry], index: Int) -> String
  if index >= subst.Len() then "" else
    let entry = subst.Get(index).UnwrapOr(SubstEntry { ID: 0, Type: ast2.MonoType.TUnit })
    let head = "t" + entry.ID.ToString() + "->" + monoStringFull(entry.Type)
    let tail = substStringLoop(subst, index + 1)
    if tail == "" then head else head + ", " + tail end
  end
end

# Instantiate a polymorphic binding at each lookup site.
func instantiate(scheme: Scheme, state: InferState) -> ast2.MonoType
  instantiateBound(scheme.Bound, scheme.Body, state, [])
end

func instantiateQualified(scheme: Scheme, state: InferState) -> QualifiedType
  let subst = instantiateBoundSubstFor(scheme.Bound, scheme.Body, state, [])
  QualifiedType { Predicates: substPredicates(scheme.Predicates, subst), Body: applySubst(subst, scheme.Body) }
end

func instantiateBoundSubst(bound: Slice[Int], state: InferState, out: Slice[SubstEntry]) -> Slice[SubstEntry]
  if bound.Len() == 0 then out
  else
    let id = bound.Get(0).UnwrapOr(0)
    instantiateBoundSubst(sliceDrop(bound, 1), withFreshID(state, state.FreshVarID + 1), out.Append(SubstEntry { ID: id, Type: ast2.MonoType.TVar(state.FreshVarID) }))
  end
end

func instantiateBoundSubstFor(bound: Slice[Int], body: ast2.MonoType, state: InferState, out: Slice[SubstEntry]) -> Slice[SubstEntry]
  if bound.Len() == 0 then out else
    let id = bound.Get(0).UnwrapOr(0)
    let replacement = if isKindVar(body, id) then ast2.MonoType.TKVar(state.FreshVarID) else ast2.MonoType.TVar(state.FreshVarID) end
    instantiateBoundSubstFor(sliceDrop(bound, 1), body, withFreshID(state, state.FreshVarID + 1), out.Append(SubstEntry { ID: id, Type: replacement }))
  end
end

func substPredicates(items: Slice[Predicate], subst: Slice[SubstEntry]) -> Slice[Predicate]
  if items.Len() == 0 then []
  else
    let p = items.Get(0).UnwrapOr(Predicate { ClassName: "", Args: [] as Slice[ast2.MonoType] })
    substPredicates(sliceDrop(items, 1), subst).Prepend(Predicate { ClassName: p.ClassName, Args: substTypes(p.Args, subst) })
  end
end

func substTypes(items: Slice[ast2.MonoType], subst: Slice[SubstEntry]) -> Slice[ast2.MonoType]
  if items.Len() == 0 then []
  else substTypes(sliceDrop(items, 1), subst).Prepend(applySubst(subst, items.Get(0).UnwrapOr(ast2.MonoType.TUnit))) end
end

func appendPredicates(left: Slice[Predicate], right: Slice[Predicate]) -> Slice[Predicate]
  if right.Len() == 0 then left
  else appendPredicates(left.Append(right.Get(0).UnwrapOr(Predicate { ClassName: "", Args: [] as Slice[ast2.MonoType] })), sliceDrop(right, 1)) end
end

func instantiateBound(bound: Slice[Int], body: ast2.MonoType, state: InferState, subst: Slice[SubstEntry]) -> ast2.MonoType
  if bound.Len() == 0 then
    applySubst(subst, body)
  else
    let id = bound.Get(0).UnwrapOr(0)
    let replacement = if isKindVar(body, id) then ast2.MonoType.TKVar(state.FreshVarID) else ast2.MonoType.TVar(state.FreshVarID) end
    instantiateBound(sliceDrop(bound, 1), body, withFreshID(state, state.FreshVarID + 1), subst.Prepend(SubstEntry { ID: id, Type: replacement }))
  end
end

func isKindVar(t: ast2.MonoType, id: Int) -> Bool
  switch t
    case TKVar(other) => id == other
    case TParam(_) => false
    case TApp(ctor, args) => isKindVar(ctor.value(), id) || isKindVarAll(args, id)
    case TCon(_, args) => isKindVarAll(args, id)
    case TFunc(args, ret) => isKindVarAll(args, id) || isKindVar(ret.value(), id)
    case TTuple(items) => isKindVarAll(items, id)
    case _ => false
  end
end

func isKindVarAll(items: Slice[ast2.MonoType], id: Int) -> Bool
  if items.Len() == 0 then false else isKindVar(items.Get(0).UnwrapOr(ast2.MonoType.TUnit), id) || isKindVarAll(sliceDrop(items, 1), id) end
end

# Instantiation currently returns only a type, so callers must select result
# variables that cannot collide with variables already present in that type.
func nextFreshVarID(t: ast2.MonoType, current: Int) -> Int
  switch t
    case TVar(id) => if id >= current then id + 1 else current end
    case TKVar(id) => if id >= current then id + 1 else current end
    case TParam(_) => current
    case TCon(_, args) => nextFreshVarIDInAll(args, current)
    case TApp(ctor, args) => nextFreshVarIDInAll(args, nextFreshVarID(ctor.value(), current))
    case TFunc(args, ret) => nextFreshVarID(ret.value(), nextFreshVarIDInAll(args, current))
    case TTuple(items) => nextFreshVarIDInAll(items, current)
    case TUnit => current
    case TGoPackage(_) => current
  end
end

func nextFreshVarIDInAll(items: Slice[ast2.MonoType], current: Int) -> Int
  if items.Len() == 0 then
    current
  else
    nextFreshVarIDInAll(sliceDrop(items, 1), nextFreshVarID(items.Get(0).UnwrapOr(ast2.MonoType.TUnit), current))
  end
end

# Collect free variables for the small HM generalizer.
func freeVars(t: ast2.MonoType, out: Slice[Int]) -> Slice[Int]
  switch t
    case TVar(id) => if containsInt(out, id) then out else out.Append(id) end
    case TKVar(id) => if containsInt(out, id) then out else out.Append(id) end
    case TParam(_) => out
    case TCon(_, args) => freeVarsAll(args, out)
    case TApp(ctor, args) => freeVarsAll(args, freeVars(ctor.value(), out))
    case TFunc(args, ret) => freeVarsAll(args, freeVars(ret.value(), out))
    case TTuple(items) => freeVarsAll(items, out)
    case TUnit => out
    case TGoPackage(_) => out
  end
end

func freeVarsAll(items: Slice[ast2.MonoType], out: Slice[Int]) -> Slice[Int]
  if items.Len() == 0 then out else freeVarsAll(sliceDrop(items, 1), freeVars(items.Get(0).UnwrapOr(ast2.MonoType.TUnit), out)) end
end

func containsInt(items: Slice[Int], value: Int) -> Bool
  if items.Len() == 0 then false else items.Get(0).UnwrapOr(0) == value || containsInt(sliceDrop(items, 1), value) end
end

func envFreeVars(env: Slice[EnvEntry], out: Slice[Int]) -> Slice[Int]
  if env.Len() == 0 then out
  else
    let item = env.Get(0).UnwrapOr(EnvEntry { Name: "", Scheme: Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TUnit } })
    # Compute this entry's contribution to the environment's free type
    # variables independently: freeVars(body) minus the entry's own Bound.
    # Removing Bound from the running accumulator (as the previous
    # implementation did) is wrong: a scheme like POrElse's own signature --
    # forall A. func(Parser[A], Parser[A]) -> Reply[A] -- has Body that
    # mentions A but lists A in Bound. When such an entry is processed it
    # would erase A from the accumulator even though other entries (params and
    # type-param bindings) keep A free in the environment. The result is that
    # let-bound values mentioning A become spuriously polymorphic and
    # inference falls over with occurs-check failures like t-1 ~ Reply[t-1].
    let bodyFree = removeInts(freeVars(item.Scheme.Body, []), item.Scheme.Bound)
    let entryFree = freeVarsPredicates(item.Scheme.Predicates, bodyFree)
    envFreeVars(sliceDrop(env, 1), unionInts(out, entryFree))
  end
end

func unionInts(left: Slice[Int], right: Slice[Int]) -> Slice[Int]
  if right.Len() == 0 then
    left
  else
    let head = right.Get(0).UnwrapOr(0)
    let next = if containsInt(left, head) then left else left.Append(head) end
    unionInts(next, sliceDrop(right, 1))
  end
end

func freeVarsPredicates(items: Slice[Predicate], out: Slice[Int]) -> Slice[Int]
  if items.Len() == 0 then
    out
  else
    let predicate = items.Get(0).UnwrapOr(Predicate { ClassName: "", Args: [] as Slice[ast2.MonoType] })
    freeVarsPredicates(sliceDrop(items, 1), freeVarsAll(predicate.Args, out))
  end
end

func removeInts(items: Slice[Int], removed: Slice[Int]) -> Slice[Int]
  if items.Len() == 0 then [] else
    let tail = removeInts(sliceDrop(items, 1), removed)
    if containsInt(removed, items.Get(0).UnwrapOr(0)) then tail else tail.Prepend(items.Get(0).UnwrapOr(0)) end
  end
end

func generalize(env: Slice[EnvEntry], t: ast2.MonoType) -> Slice[Int]
  removeInts(freeVars(t, []), envFreeVars(env, []))
end

# Generalize a qualified type.  Predicates are part of the type's free
# variables too: dropping them here makes a let-bound value look
# unconstrained even though its initializer required a typeclass instance.
func generalizeQualified(env: Slice[EnvEntry], t: ast2.MonoType, predicates: Slice[Predicate]) -> Slice[Int]
  removeInts(freeVarsPredicates(predicates, freeVars(t, [])), envFreeVars(env, []))
end

func isArithmetic(op: String) -> Bool
  op == "+" || op == "-" || op == "*" || op == "/"
end

func isComparison(op: String) -> Bool
  op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">="
end

func isLogical(op: String) -> Bool
  op == "&&" || op == "||"
end

func emptyMonoTypes() -> Slice[ast2.MonoType]
  []
end

func emptyASTTypeExprs() -> Slice[ast2.TypeExpr]
  []
end

func sliceDrop[A](items: Slice[A], n: Int) -> Slice[A]
  if n <= 0 then
    items
  else
    if items.Len() == 0 then
      []
    else
      sliceDrop(sliceTail(items), n - 1)
    end
  end
end

func sliceTail[A](items: Slice[A]) -> Slice[A]
  sliceTailLoop(items, 1, [] as Slice[A])
end

func sliceTailLoop[A](items: Slice[A], index: Int, out: Slice[A]) -> Slice[A]
  if index >= items.Len() then
    out
  else
    switch items.Get(index)
      case Some(value) => sliceTailLoop(items, index + 1, out.Append(value))
      case None => out
    end
  end
end
