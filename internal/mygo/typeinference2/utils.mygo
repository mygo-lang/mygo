package typeinference2
import common2 "github.com/mygo-lang/mygo/internal/mygo/common2"

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import fmt "go:fmt"

func monoEqual(a: ast2.MonoType, b: ast2.MonoType) -> Bool
  ast2.MonoEqual(a, b)
end

func monoListEqual(a: Slice[ast2.MonoType], b: Slice[ast2.MonoType]) -> Bool
  ast2.MonoListEqual(a, b)
end

func monoString(t: ast2.MonoType) -> String
  switch t
    case TVar(id) => "t" + id.ToString()
    case TKVar(id) => "K" + id.ToString()
    case TParam(id) => "p" + id.ToString()
    case TCon(name) => name
    case TApp(ctor, _) => monoString(ctor.value()) + "[...]"
    case TFunc(_, _) => "func"
    case TVariadic(_, _) => "variadic"
    case TTuple(_) => "tuple"
    case TUnit => "()"
    case TQualifiedName(alias, typeRef) => fmt.Sprintf("%s.%s", alias, monoString(typeRef.value()))
    case _ then
      Panic("unreachable MonoType variant")
      ""
    end
  end
end

func monoStringFull(t: ast2.MonoType) -> String
  switch t
    case TVar(id) => "t" + id.ToString()
    case TKVar(id) => "K" + id.ToString()
    case TParam(id) => "p" + id.ToString()
    case TCon(name) => name
    case TApp(ctor, args) => monoStringFull(ctor.value()) + "[" + monoListString(args) + "]"
    case TFunc(args, ret) => "func(" + monoListString(args) + ") -> " + monoStringFull(ret.value())
    case TVariadic(args, ret) then
      "variadic(" + monoListString(args) + ") -> " + monoStringFull(ret.value())
    end
    case TTuple(items) => "tuple(" + monoListString(items) + ")"
    case TUnit => "()"
    case TQualifiedName(alias, typeRef) then
      fmt.Sprintf("%s.%s", alias, monoStringFull(typeRef.value()))
    end
    case _ then
      Panic("unreachable MonoType variant")
      ""
    end
  end
end

func monoListString(items: Slice[ast2.MonoType]) -> String
  switch monoListStringAt(items, 0, "")
    case Some(value) => value
    case None => ""
  end
end

func monoListStringAt(items: Slice[ast2.MonoType], index: Int, out: String) -> Option[String]
  if index >= items.Len() then
    Some(out)
  else
    switch items.Get(index)
      case Some(item) then
        let next = if out == "" then
          monoStringFull(item)
        else
          out + ", " + monoStringFull(item)
        end
        monoListStringAt(items, index + 1, next)
      end
      case None => None
    end
  end
end

# Exported wrappers so that codegen2 can convert MonoType to MyGO type strings.
func MonoStringFull(t: ast2.MonoType) -> String
  monoStringFull(t)
end

func MonoListString(items: Slice[ast2.MonoType]) -> String
  monoListString(items)
end

func ApplySubst(subst: Subst, t: ast2.MonoType) -> ast2.MonoType
  applySubst(subst, t)
end

# SubstFromEntries is the compatibility boundary for codegen2, which creates
# short-lived substitutions from explicit type arguments.
func SubstFromEntries(entries: Slice[SubstEntry]) -> Subst
  substFromEntries(entries)
end

func substString(subst: Subst) -> String
  if subst.Entries.Len() == 0 then
    "[]"
  else
    "[" + substStringLoop(subst, 0) + "]"
  end
end

func substStringLoop(subst: Subst, index: Int) -> String
  switch substStringLoopAt(subst, index)
    case Some(value) => value
    case None => ""
  end
end

func substStringLoopAt(subst: Subst, index: Int) -> Option[String]
  if index >= subst.Entries.Len() then
    Some("")
  else
    switch subst.Entries.Get(index)
      case Some(entry) then
        let head = "t" + entry.ID.ToString() + "->" + monoStringFull(entry.Type)
        substStringLoopAt(subst, index + 1).Map(func(tail: String) -> String if tail == "" then head else head + ", " + tail end end)
      end
      case None => None
    end
  end
end

# Instantiate a polymorphic binding at each lookup site.
func instantiate(scheme: Scheme, state: InferState) -> ast2.MonoType
  switch instantiateBound(scheme.Bound, scheme.Body, state, emptySubst())
    case Some(typ) => typ
    case None => scheme.Body
  end
end

func instantiateQualified(scheme: Scheme, state: InferState) -> QualifiedType
  switch instantiateBoundSubstFor(scheme.Bound, scheme.Body, state, emptySubst())
    case Some(subst) then
      QualifiedType {
        Predicates: substPredicates(scheme.Predicates, subst),
        Body: applySubst(subst, scheme.Body),
      }
    end
    case None => QualifiedType { Predicates: scheme.Predicates, Body: scheme.Body }
  end
end

func instantiateBoundSubst(bound: Slice[Int], state: InferState, out: Subst) -> Option[Subst]
  if bound.Len() == 0 then
    Some(out)
  else
    switch bound.Get(0)
      case Some(id) then
        instantiateBoundSubst(
          common2.SliceDrop(bound, 1),
          withFreshID(state, state.FreshVarID + 1),
          substAppend(
            out,
            SubstEntry {
              ID: id,
              Type: ast2.MonoType.TVar(state.FreshVarID),
            }
          )
        )
      end
      case None => None
    end
  end
end

func instantiateBoundSubstFor(bound: Slice[Int], body: ast2.MonoType, state: InferState, out: Subst) -> Option[Subst]
  if bound.Len() == 0 then
    Some(out)
  else
    switch bound.Get(0)
      case Some(id) then
        let replacement = if isKindVar(body, id) then
          ast2.MonoType.TKVar(state.FreshVarID)
        else
          ast2.MonoType.TVar(state.FreshVarID)
        end
        instantiateBoundSubstFor(
          common2.SliceDrop(bound, 1),
          body,
          withFreshID(state, state.FreshVarID + 1),
          substAppend(out, SubstEntry {
            ID: id,
            Type: replacement,
          })
        )
      end
      case None => None
    end
  end
end

func substPredicates(items: Slice[Predicate], subst: Subst) -> Slice[Predicate]
  substPredicatesInto(items, subst, 0, [])
end

func substPredicatesInto(items: Slice[Predicate], subst: Subst, index: Int, out: Slice[Predicate]) -> Slice[Predicate]
  switch substPredicatesIntoOption(items, subst, index, out)
    case Some(predicates) => predicates
    case None => out
  end
end

func substPredicatesIntoOption(items: Slice[Predicate], subst: Subst, index: Int, out: Slice[Predicate]) -> Option[Slice[Predicate]]
  if index >= items.Len() then
    Some(out)
  else
    switch items.Get(index)
      case Some(predicate) then
        substPredicatesIntoOption(
          items,
          subst,
          index + 1,
          out.Append(Predicate {
            ClassName: predicate.ClassName,
            Args: substTypes(predicate.Args, subst),
          })
        )
      end
      case None => None
    end
  end
end

func substTypes(items: Slice[ast2.MonoType], subst: Subst) -> Slice[ast2.MonoType]
  substTypesInto(items, subst, 0, [])
end

func substTypesInto(items: Slice[ast2.MonoType], subst: Subst, index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  switch substTypesIntoOption(items, subst, index, out)
    case Some(types) => types
    case None => out
  end
end

func substTypesIntoOption(items: Slice[ast2.MonoType], subst: Subst, index: Int, out: Slice[ast2.MonoType]) -> Option[Slice[ast2.MonoType]]
  if index >= items.Len() then
    Some(out)
  else
    switch items.Get(index)
      case Some(item) then
        substTypesIntoOption(items, subst, index + 1, out.Append(applySubst(subst, item)))
      end
      case None => None
    end
  end
end

func appendPredicates(left: Slice[Predicate], right: Slice[Predicate]) -> Slice[Predicate]
  switch appendPredicatesAt(left, right, 0)
    case Some(predicates) => predicates
    case None => left
  end
end

func appendPredicatesAt(left: Slice[Predicate], right: Slice[Predicate], index: Int) -> Option[Slice[Predicate]]
  if index >= right.Len() then
    Some(left)
  else
    switch right.Get(index)
      case Some(predicate) => appendPredicatesAt(left.Append(predicate), right, index + 1)
      case None => None
    end
  end
end

func instantiateBound(bound: Slice[Int], body: ast2.MonoType, state: InferState, subst: Subst) -> Option[ast2.MonoType]
  if bound.Len() == 0 then
    Some(applySubst(subst, body))
  else
    switch bound.Get(0)
      case Some(id) then
        let replacement = if isKindVar(body, id) then
          ast2.MonoType.TKVar(state.FreshVarID)
        else
          ast2.MonoType.TVar(state.FreshVarID)
        end
        instantiateBound(
          common2.SliceDrop(bound, 1),
          body,
          withFreshID(state, state.FreshVarID + 1),
          substPrepend(subst, SubstEntry {
            ID: id,
            Type: replacement,
          })
        )
      end
      case None => None
    end
  end
end

func isKindVar(t: ast2.MonoType, id: Int) -> Bool
  switch t
    case TKVar(other) => id == other
    case TParam(_) => false
    case TApp(ctor, args) => isKindVar(ctor.value(), id) || isKindVarAll(args, id)
    case TCon(_) => false
    case TFunc(args, ret) => isKindVarAll(args, id) || isKindVar(ret.value(), id)
    case TVariadic(args, ret) => isKindVarAll(args, id) || isKindVar(ret.value(), id)
    case TTuple(items) => isKindVarAll(items, id)
    case _ => false
  end
end

func isKindVarAll(items: Slice[ast2.MonoType], id: Int) -> Bool
  switch isKindVarAt(items, id, 0)
    case Some(found) => found
    case None => false
  end
end

func isKindVarAt(items: Slice[ast2.MonoType], id: Int, index: Int) -> Option[Bool]
  if index >= items.Len() then
    Some(false)
  else
    switch items.Get(index)
      case Some(item) then
        if isKindVar(item, id) then
          Some(true)
        else
          isKindVarAt(items, id, index + 1)
        end
      end
      case None => None
    end
  end
end

# Instantiation currently returns only a type, so callers must select result
# variables that cannot collide with variables already present in that type.
func nextFreshVarID(t: ast2.MonoType, current: Int) -> Int
  switch t
    case TVar(id) => if id >= current then id + 1 else current end
    case TKVar(id) => if id >= current then id + 1 else current end
    case TParam(_) => current
    case TCon(_) => current
    case TApp(ctor, args) => nextFreshVarIDInAll(args, nextFreshVarID(ctor.value(), current))
    case TFunc(args, ret) => nextFreshVarID(ret.value(), nextFreshVarIDInAll(args, current))
    case TVariadic(args, ret) => nextFreshVarID(ret.value(), nextFreshVarIDInAll(args, current))
    case TTuple(items) => nextFreshVarIDInAll(items, current)
    case TUnit => current
    case TQualifiedName(_, inner) => nextFreshVarID(inner.value(), current)
  end
end

func nextFreshVarIDInAll(items: Slice[ast2.MonoType], current: Int) -> Int
  switch nextFreshVarIDInAllAt(items, current, 0)
    case Some(next) => next
    case None => current
  end
end

func nextFreshVarIDInAllAt(items: Slice[ast2.MonoType], current: Int, index: Int) -> Option[Int]
  if index >= items.Len() then
    Some(current)
  else
    switch items.Get(index)
      case Some(item) => nextFreshVarIDInAllAt(items, nextFreshVarID(item, current), index + 1)
      case None => None
    end
  end
end

# Collect free variables for the small HM generalizer.
func freeVars(t: ast2.MonoType, out: Slice[Int]) -> Slice[Int]
  switch t
    case TVar(id) => if containsInt(out, id) then out else out.Append(id) end
    case TKVar(id) => if containsInt(out, id) then out else out.Append(id) end
    case TParam(_) => out
    case TCon(_) => out
    case TApp(ctor, args) => freeVarsAll(args, freeVars(ctor.value(), out))
    case TFunc(args, ret) => freeVarsAll(args, freeVars(ret.value(), out))
    case TVariadic(args, ret) => freeVarsAll(args, freeVars(ret.value(), out))
    case TTuple(items) => freeVarsAll(items, out)
    case TUnit => out
    case TQualifiedName(_, inner) => freeVars(inner.value(), out)
  end
end

func freeVarsAll(items: Slice[ast2.MonoType], out: Slice[Int]) -> Slice[Int]
  switch freeVarsAllAt(items, out, 0)
    case Some(vars) => vars
    case None => out
  end
end

func freeVarsAllAt(items: Slice[ast2.MonoType], out: Slice[Int], index: Int) -> Option[Slice[Int]]
  if index >= items.Len() then
    Some(out)
  else
    switch items.Get(index)
      case Some(item) => freeVarsAllAt(items, freeVars(item, out), index + 1)
      case None => None
    end
  end
end

func containsInt(items: Slice[Int], value: Int) -> Bool
  switch containsIntAt(items, value, 0)
    case Some(found) => found
    case None => false
  end
end

func containsIntAt(items: Slice[Int], value: Int, index: Int) -> Option[Bool]
  if index >= items.Len() then
    Some(false)
  else
    switch items.Get(index)
      case Some(item) then
        if item == value then
          Some(true)
        else
          containsIntAt(items, value, index + 1)
        end
      end
      case None => None
    end
  end
end

func envFreeVars(env: Env, out: Slice[Int]) -> Slice[Int]
  # Batch layers contribute their precomputed free-variable union, so a deep
  # import graph costs O(1) per batch instead of re-walking every imported
  # member on every generalization.
  let fromBatch = switch env.Batch
    case Some(batch) => unionInts(out, batch.FreeVars)
    case None => out
  end
  switch env.Entry
    case Some(item) then
      let bodyFree = removeInts(freeVars(item.Scheme.Body, []), item.Scheme.Bound)
      let entryFree = freeVarsPredicates(item.Scheme.Predicates, bodyFree)
      let next = unionInts(fromBatch, entryFree)
      switch env.Parent
        case Some(parent) => envFreeVars(parent.value(), next)
        case None => next
      end
    end
    case None => fromBatch
  end
end

func unionInts(left: Slice[Int], right: Slice[Int]) -> Slice[Int]
  switch unionIntsAt(left, right, 0)
    case Some(items) => items
    case None => left
  end
end

func unionIntsAt(left: Slice[Int], right: Slice[Int], index: Int) -> Option[Slice[Int]]
  if index >= right.Len() then
    Some(left)
  else
    switch right.Get(index)
      case Some(head) then
        let next = if containsInt(left, head) then
          left
        else
          left.Append(head)
        end
        unionIntsAt(next, right, index + 1)
      end
      case None => None
    end
  end
end

func freeVarsPredicates(items: Slice[Predicate], out: Slice[Int]) -> Slice[Int]
  switch freeVarsPredicatesAt(items, out, 0)
    case Some(vars) => vars
    case None => out
  end
end

func freeVarsPredicatesAt(items: Slice[Predicate], out: Slice[Int], index: Int) -> Option[Slice[Int]]
  if index >= items.Len() then
    Some(out)
  else
    switch items.Get(index)
      case Some(predicate) then
        freeVarsPredicatesAt(items, freeVarsAll(predicate.Args, out), index + 1)
      end
      case None => None
    end
  end
end

func removeInts(items: Slice[Int], removed: Slice[Int]) -> Slice[Int]
  switch removeIntsAt(items, removed, 0)
    case Some(result) => result
    case None => []
  end
end

func removeIntsAt(items: Slice[Int], removed: Slice[Int], index: Int) -> Option[Slice[Int]]
  if index >= items.Len() then
    Some([])
  else
    switch items.Get(index)
      case Some(item) then
        switch removeIntsAt(items, removed, index + 1)
          case Some(tail) then
            if containsInt(removed, item) then
              Some(tail)
            else
              Some(tail.Prepend(item))
            end
          end
          case None => None
        end
      end
      case None => None
    end
  end
end

func generalize(env: Env, t: ast2.MonoType) -> Slice[Int]
  removeInts(freeVars(t, []), envFreeVars(env, []))
end

# Generalize a qualified type.  Predicates are part of the type's free
# variables too: dropping them here makes a let-bound value look
# unconstrained even though its initializer required a typeclass instance.
func generalizeQualified(env: Env, t: ast2.MonoType, predicates: Slice[Predicate]) -> Slice[Int]
  removeInts(freeVarsPredicates(predicates, freeVars(t, [])), envFreeVars(env, []))
end

func isArithmetic(op: String) -> Bool
  op == "+" || op == "-" || op == "*" || op == "/"
end

func isComparison(op: String) -> Bool
  op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">="
end

func isLogical(op: String) -> Bool
  op == "&&" || op == "||"
end

func emptyMonoTypes() -> Slice[ast2.MonoType]
  []
end

func emptyASTTypeExprs() -> Slice[ast2.TypeExpr]
  []
end

# Construct generic types
func tCon(name: String, args: Slice[ast2.MonoType]) -> ast2.MonoType
  ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon(name)), args)
end

func getTCon(typ: ast2.MonoType) -> Option[(String, Slice[ast2.MonoType])]
  switch typ
    case TCon(name) => Some((name, []))
    case TApp(typeRef, args) then
      switch typeRef.value()
        case TCon(name) then
          Some((name, args as Slice[ast2.MonoType]))
          # An imported generic type (`ps.Reply[A]`) arrives as
          # TApp(TQualifiedName(path, TCon(name)), args).  Unwrap it just like
          # the bare TQualifiedName case below.
        end
        case TQualifiedName(_, inner) then
          switch inner.value()
            case TCon(name) => Some((name, args as Slice[ast2.MonoType]))
            case _ => None
          end
        end
        case _ => None
      end
    end
    # Unwrap TQualifiedName so a foreign-package type (e.g. `testing.T`
    # reached through `Ref[testing.T]`) is treated as the underlying type
    # name.  The caller is responsible for re-deriving the qualified
    # `alias.Name` form when the symbol table needs the full key.
    case TQualifiedName(_, inner) => getTCon(inner.value())
    case _ => None
  end
end
