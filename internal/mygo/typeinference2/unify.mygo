package typeinference2
import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"

func emptySubst() -> Subst
  Subst { Entries: [], Index: None, Fallbacks: [], IndexFirst: true, MaxID: 0 }
end

func substFromEntries(entries: Slice[SubstEntry]) -> Subst
  let index: Map[Int, ast2.MonoType] = {}
  Subst { Entries: entries, Index: Some(substIndexEntries(entries, 0, index)), Fallbacks: [], IndexFirst: true, MaxID: maxSubstEntryID(entries, 0) }
end

# Entries are ordered by lookup priority.  Record only the first occurrence
# of an ID so the index has exactly the same observable semantics as the
# former linear substGet scan.
func substIndexEntries(entries: Slice[SubstEntry], position: Int, index: Map[Int, ast2.MonoType]) -> Map[Int, ast2.MonoType]
  if position >= entries.Len() then index else
    let entry = entries.Get(position).UnwrapOr(SubstEntry { ID: 0, Type: ast2.MonoType.TUnit })
    switch index.Get(entry.ID)
      case None then
        index.Set(entry.ID, entry.Type)
        substIndexEntries(entries, position + 1, index)
      end
      case Some(_) => substIndexEntries(entries, position + 1, index)
    end
  end
end

# Single-entry prepend/append layers carry no Index map.  Scan their Entries
# (0 or 1 elements) for the requested ID, preserving first-occurrence-wins.
func substIndexLinear(entries: Slice[SubstEntry], id: Int, index: Int) -> Option[ast2.MonoType]
  if index >= entries.Len() then None else
    let entry = entries.Get(index).UnwrapOr(SubstEntry { ID: 0, Type: ast2.MonoType.TUnit })
    if entry.ID == id then Some(entry.Type) else substIndexLinear(entries, id, index + 1) end
  end
end

func substPrepend(subst: Subst, entry: SubstEntry) -> Subst
  Subst { Entries: [entry], Index: None, Fallbacks: [Ref.new(subst)], IndexFirst: true, MaxID: maxSubstIDPair(entry.ID, subst.MaxID) }
end

func substAppend(subst: Subst, entry: SubstEntry) -> Subst
  Subst { Entries: [entry], Index: None, Fallbacks: [Ref.new(subst)], IndexFirst: false, MaxID: maxSubstIDPair(entry.ID, subst.MaxID) }
end

func maxSubstEntryID(entries: Slice[SubstEntry], index: Int) -> Int
  if index >= entries.Len() then
    0
  else
    let entry = entries.Get(index).UnwrapOr(SubstEntry { ID: 0, Type: ast2.MonoType.TUnit })
    maxSubstIDPair(entry.ID, maxSubstEntryID(entries, index + 1))
  end
end

func maxSubstIDPair(left: Int, right: Int) -> Int
  if left > right then left else right end
end

func unify(left: ast2.MonoType, right: ast2.MonoType, subst: Subst) -> Result[Subst, String]
  # A non-generic nominal type is accepted in both spellings during bootstrap:
  # TCon(Name) and TApp(TCon(Name), []). Canonicalise the latter before the
  # structural cases below, including when it is nested in TQualifiedName.
  # An empty substitution cannot change either side, so skip the full-tree
  # applySubst rebuilds entirely; a non-empty one is applied below.
  let aLeft = if substIsEmpty(subst) => left else applySubst(subst, left)
  let bRight = if substIsEmpty(subst) => right else applySubst(subst, right)
  let a = normalizeEmptyTypeApps(aLeft)
  let b = normalizeEmptyTypeApps(bRight)
  if isAnyType(a) || isAnyType(b) then
    Ok(subst)
  else
    if monoEqual(a, b) then
      Ok(subst)
    else
      switch a
        case TVar(id) => bindVar(id, b, subst)
        case TKVar(id) => bindVar(id, b, subst)
        case TParam(id) then
          switch b
            case TParam(id2) => if id == id2 then Ok(subst) else Err("cannot unify " + monoStringFull(a) + " with " + monoStringFull(b)) end
            case TVar(id2) => bindVar(id2, a, subst)
            case TKVar(id2) => bindVar(id2, a, subst)
            case _ => Err("cannot unify " + monoStringFull(a) + " with " + monoStringFull(b))
          end
        end
        case TApp(ctor, args) => unifyApplication(ctor.value(), args, b, subst)
        case TCon(name) then
          switch b
            case TVar(id) => bindVar(id, a, subst)
            case TKVar(id) => bindVar(id, a, subst)
            case TParam(id) => bindVar(id, a, subst)
            case TApp(ctor, appArgs) => unifyApplication(ctor.value(), appArgs, a, subst)
            case TCon(name2) then
              if name == name2 then
                unifyArgs([], [], subst)
              else
                Err("cannot unify " + monoStringFull(a) + " with " + monoStringFull(b))
              end
            end
            case _ => Err("cannot unify " + monoStringFull(a) + " with " + monoStringFull(b))
          end
        end
        case TFunc(args, ret) then
          switch b
            case TVar(id) => bindVar(id, a, subst)
            case TKVar(id) => bindVar(id, a, subst)
            case TParam(id) => bindVar(id, a, subst)
            case TApp(ctor, appArgs) => unifyApplication(ctor.value(), appArgs, a, subst)
            case TFunc(args2, ret2) =>
              if args.Len() == args2.Len() then
                let s1 = unifyArgs(args, args2, subst)
                switch s1
                  case Ok(s) => unify(ret.value(), ret2.value(), s)
                  case Err(msg) => Err(msg)
                end
              else
                Err("function arity mismatch")
              end
            case _ => Err("cannot unify " + monoStringFull(a) + " with " + monoStringFull(b))
          end
        end
        case TVariadic(args, ret) then
          switch b
            case TVar(id) => bindVar(id, a, subst)
            case TKVar(id) => bindVar(id, a, subst)
            case TParam(id) => bindVar(id, a, subst)
            case TVariadic(args2, ret2) =>
              let s1 = unifyArgs(args, args2, subst)
              switch s1
                case Ok(s) => unify(ret.value(), ret2.value(), s)
                case Err(msg) => Err(msg)
              end
            case _ => Err("cannot unify " + monoStringFull(a) + " with " + monoStringFull(b))
          end
        end
        case TTuple(items) then
          switch b
            case TVar(id) => bindVar(id, a, subst)
            case TKVar(id) => bindVar(id, a, subst)
            case TParam(id) => bindVar(id, a, subst)
            case TApp(ctor, appArgs) => unifyApplication(ctor.value(), appArgs, a, subst)
            case TTuple(items2) =>
              if items.Len() == items2.Len() then
                unifyArgs(items, items2, subst)
              else
                Err("tuple arity mismatch")
              end
            case _ => Err("cannot unify " + monoStringFull(a) + " with " + monoStringFull(b))
          end
        end
        case TUnit then
          switch b
            case TVar(id) => bindVar(id, a, subst)
            case TKVar(id) => bindVar(id, a, subst)
            case TParam(id) => bindVar(id, a, subst)
            case TApp(ctor, appArgs) => unifyApplication(ctor.value(), appArgs, a, subst)
            case _ => Err("cannot unify " + monoStringFull(a) + " with " + monoStringFull(b))
          end
        end
        case TQualifiedName(pathA, innerA) then
          switch b
            case TVar(id) => bindVar(id, a, subst)
            case TKVar(id) => bindVar(id, a, subst)
            case TParam(id) => bindVar(id, a, subst)
            case TQualifiedName(pathB, innerB) =>
              if pathA == pathB then
                unify(innerA.value(), innerB.value(), subst)
              else
                Err("cannot unify " + monoStringFull(a) + " with " + monoStringFull(b))
              end
            case _ => Err("cannot unify " + monoStringFull(a) + " with " + monoStringFull(b))
          end
        end
      end
    end
  end
end

func normalizeEmptyTypeApps(t: ast2.MonoType) -> ast2.MonoType
  switch t
    case TApp(ctor, args) then
      if args.Len() == 0 then
        normalizeEmptyTypeApps(ctor.value())
      else
        t
      end
    end
    case TQualifiedName(path, inner) => ast2.MonoType.TQualifiedName(path, Ref.new(normalizeEmptyTypeApps(inner.value())))
    case _ => t
  end
end

# Any is the MyGO spelling for Go's `any` interface. It is a dynamic boundary
# type, so values can flow into and out of it without nominal unification.
func isAnyType(typ: ast2.MonoType) -> Bool
  switch typ
    case TCon(name) => name == "Any"
    case _ => false
  end
end

func unifyApplication(ctor: ast2.MonoType, args: Slice[ast2.MonoType], other: ast2.MonoType, subst: Subst) -> Result[Subst, String]
  let resolvedCtor = applySubst(subst, ctor)
  let resolvedOther = applySubst(subst, other)
  switch resolvedOther
    case TVar(id) => bindVar(id, ast2.MonoType.TApp(Ref.new(resolvedCtor), args), subst)
    case TKVar(id) => bindVar(id, ast2.MonoType.TApp(Ref.new(resolvedCtor), args), subst)
    case TParam(id) => bindVar(id, ast2.MonoType.TApp(Ref.new(resolvedCtor), args), subst)
    case TApp(otherCtor, otherArgs) then
      switch unify(resolvedCtor, otherCtor.value(), subst)
        case Ok(next) => unifyArgs(args, otherArgs, next)
        case Err(msg) => Err(msg)
      end
    end
    case TCon(name) then
      switch unify(resolvedCtor, ast2.MonoType.TCon(name), subst)
        case Ok(next) then
          # A bare `TCon(name)` is the constructor without its type
          # parameters.  Unifying it with `TCon(name)` is a structural
          # match; the application args have nowhere to land, so we
          # require the constructor's own bound type parameters to
          # account for them.  For now we drop the args, leaving their
          # instantiation to a later unify on a concrete callee.
          if args.Len() == 0 then
            Ok(next)
          else
            # Treat the args as fresh type parameters so subsequent
            # substitution can still recover the parametric shape.
            let recovered = args.Fold(next, func(acc: Subst, arg: ast2.MonoType) -> Subst
              acc
            end)
            Ok(recovered)
          end
        end
        case Err(msg) => Err(msg)
      end
    end
    case TFunc(otherArgs, otherRet) then
      # Unify a `ctor applied to args` against a bare `TFunc` by treating
      # the ctor as a parameterised constructor: build a combined
      # function type that reuses the ctor's parameter slots.
      let combined = appendMonoTypesRec(args, otherArgs)
      unify(ast2.MonoType.TFunc(combined, otherRet), resolvedCtor, subst)
    end
    # Type applications cannot structurally unify with the remaining MonoType
    # variants (for example a qualified type).  This is a normal inference
    # failure, not an impossible runtime state: returning Err keeps bootstrap
    # diagnostics intact instead of triggering generated `panic("unreachable")`.
    case _ => Err("cannot unify " + monoStringFull(ast2.MonoType.TApp(Ref.new(resolvedCtor), args)) + " with " + monoStringFull(resolvedOther))
  end
end

# appendMonoTypesRec concats two MonoType slices into a fresh slice.
func appendMonoTypesRec(a: Slice[ast2.MonoType], b: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  appendMonoTypesAt(a, b, 0)
end

func appendMonoTypesAt(a: Slice[ast2.MonoType], b: Slice[ast2.MonoType], index: Int) -> Slice[ast2.MonoType]
  appendMonoTypesInto(a, b, index, [])
end

func appendMonoTypesInto(a: Slice[ast2.MonoType], b: Slice[ast2.MonoType], index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= a.Len() then
    appendMonoTypesTail(b, 0, out)
  else
   appendMonoTypesInto(a, b, index + 1, out.Append(a.Get(index).UnwrapOr(ast2.MonoType.TUnit)))
  end
end

func appendMonoTypesTail(items: Slice[ast2.MonoType], index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= items.Len() then
    out
  else
    appendMonoTypesTail(items, index + 1, out.Append(items.Get(index).UnwrapOr(ast2.MonoType.TUnit)))
  end
end

func bindVar(id: Int, t: ast2.MonoType, subst: Subst) -> Result[Subst, String]
  # Unifying a variable with itself is already solved.  It must be handled
  # before the occurs check, otherwise polymorphic constructor instantiation
  # spuriously reports an infinite type for equations such as t1 ~ t1.
  switch t
    case TVar(other) => if id == other then Ok(subst) else bindDistinctVar(id, t, subst) end
    case TKVar(other) => if id == other then Ok(subst) else bindDistinctVar(id, t, subst) end
    case TParam(_) => bindDistinctVar(id, t, subst)
    case TVariadic(_, _) => bindDistinctVar(id, t, subst)
    case _ => bindDistinctVar(id, t, subst)
  end
end

func bindDistinctVar(id: Int, t: ast2.MonoType, subst: Subst) -> Result[Subst, String]
  if occursIn(id, t) then
    Err("occurs check failed: t" + id.ToString() + " ~ " + monoStringFull(t))
  else
    Ok(substPrepend(subst, SubstEntry { ID: id, Type: t }))
  end
end

func unifyArgs(left: Slice[ast2.MonoType], right: Slice[ast2.MonoType], subst: Subst) -> Result[Subst, String]
  unifyArgsAt(left, right, subst, 0)
end

func unifyArgsAt(left: Slice[ast2.MonoType], right: Slice[ast2.MonoType], subst: Subst, index: Int) -> Result[Subst, String]
  if index >= left.Len() then
    Ok(subst)
  else
    let s = unify(left.Get(index).UnwrapOr(ast2.MonoType.TUnit), right.Get(index).UnwrapOr(ast2.MonoType.TUnit), subst)
    switch s
      case Ok(next) => unifyArgsAt(left, right, next, index + 1)
      case Err(msg) => Err(msg)
    end
  end
end

func applySubst(subst: Subst, t: ast2.MonoType) -> ast2.MonoType
  # The overwhelmingly common call sites pass an empty substitution (fresh
  # literals, initial unification, variant matching).  Skipping the full
  # tree walk in that case avoids rebuilding types that cannot change.
  if substIsEmpty(subst) then
    t
  # A non-empty substitution still only changes types that mention a bound
  # variable.  Returning untouched types without rebuilding them keeps the
  # re-normalisation at nested expression boundaries linear instead of
  # allocating a fresh copy of every (possibly huge) imported type.
  elsif !substAffectsType(subst, t) then
    t
  else
    applySubstSeen(subst, t, [])
  end
end

# True when the substitution binds at least one type variable occurring in t.
# applySubst uses this to return unrelated / already-resolved types without
# an allocation-heavy rebuild at every expression boundary.
func substAffectsType(subst: Subst, t: ast2.MonoType) -> Bool
  switch t
    case TVar(id) => substBindsVar(subst, id)
    case TKVar(id) => substBindsVar(subst, id)
    case TParam(id) => substBindsVar(subst, id)
    case TCon(_) => false
    case TApp(ctor, args) => substAffectsType(subst, ctor.value()) || substAffectsTypeAll(subst, args)
    case TFunc(args, ret) => substAffectsTypeAll(subst, args) || substAffectsType(subst, ret.value())
    case TVariadic(args, ret) => substAffectsTypeAll(subst, args) || substAffectsType(subst, ret.value())
    case TTuple(items) => substAffectsTypeAll(subst, items)
    case TUnit => false
    case TQualifiedName(_, inner) => substAffectsType(subst, inner.value())
  end
end

func substAffectsTypeAll(subst: Subst, items: Slice[ast2.MonoType]) -> Bool
  substAffectsTypeAt(subst, items, 0)
end

func substAffectsTypeAt(subst: Subst, items: Slice[ast2.MonoType], index: Int) -> Bool
  if index >= items.Len() then false else
    substAffectsType(subst, items.Get(index).UnwrapOr(ast2.MonoType.TUnit)) || substAffectsTypeAt(subst, items, index + 1)
  end
end

func substBindsVar(subst: Subst, id: Int) -> Bool
  switch substGet(subst, id)
    case Some(_) => true
    case None => false
  end
end

# The old implementation removed one entry from `subst` at every variable
# hop to avoid expanding a self reference forever.  That copied the full
# substitution for every hop.  Keep a small path-local visited set instead;
# substitutions produced by unification are acyclic, and this also safely
# handles the deliberately tolerated self-reference special case.
func applySubstSeen(subst: Subst, t: ast2.MonoType, seen: Slice[Int]) -> ast2.MonoType
  switch t
    case TVar(id) then
      if containsInt(seen, id) then
        t
      else
        let found = substGet(subst, id)
        switch found
          case Some(value) => applySubstSeen(subst, value, seen.Append(id))
          case None => t
        end
      end
    end
    case TKVar(id) then
      if containsInt(seen, id) then
        t
      else
        let found = substGet(subst, id)
        switch found
          case Some(value) => applySubstSeen(subst, value, seen.Append(id))
          case None => t
        end
      end
    end
    case TParam(id) then
      if containsInt(seen, id) then
        t
      else
        let found = substGet(subst, id)
        switch found
          case Some(value) => applySubstSeen(subst, value, seen.Append(id))
          case None => t
        end
      end
    end
    case TCon(name) => ast2.MonoType.TCon(name)
    case TApp(ctor, args) => ast2.MonoType.TApp(Ref.new(applySubstSeen(subst, ctor.value(), seen)), applySubstAllSeen(subst, args, seen))
    case TFunc(args, ret) => ast2.MonoType.TFunc(applySubstAllSeen(subst, args, seen), Ref.new(applySubstSeen(subst, ret.value(), seen)))
    case TVariadic(args, ret) => ast2.MonoType.TVariadic(applySubstAllSeen(subst, args, seen), Ref.new(applySubstSeen(subst, ret.value(), seen)))
    case TTuple(items) => ast2.MonoType.TTuple(applySubstAllSeen(subst, items, seen))
    case TUnit => t
    case TQualifiedName(path, inner) => ast2.MonoType.TQualifiedName(path, Ref.new(applySubstSeen(subst, inner.value(), seen)))
  end
end

func applySubstAll(subst: Subst, items: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if substIsEmpty(subst) then items else applySubstAllSeen(subst, items, []) end
end

func applySubstAllSeen(subst: Subst, items: Slice[ast2.MonoType], seen: Slice[Int]) -> Slice[ast2.MonoType]
  applySubstAllAt(subst, items, seen, 0)
end

func applySubstAllAt(subst: Subst, items: Slice[ast2.MonoType], seen: Slice[Int], index: Int) -> Slice[ast2.MonoType]
  applySubstAllInto(subst, items, seen, index, [])
end

func applySubstAllInto(subst: Subst, items: Slice[ast2.MonoType], seen: Slice[Int], index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= items.Len() then out
  else applySubstAllInto(subst, items, seen, index + 1, out.Append(applySubstSeen(subst, items.Get(index).UnwrapOr(ast2.MonoType.TUnit), seen))) end
end

func composeSubst(newer: Subst, older: Subst) -> Subst
  # `older` has lookup priority.  Keeping both substitutions as fallback
  # branches looks cheap, but repeated composition creates a shared DAG.
  # A miss then walks every path in that DAG (exponential for the deeply
  # nested parser-combinator expressions in examples/parsec/json).
  #
  # Materialise only the ordered bindings, without eagerly applying either
  # substitution to its images.  applySubst still resolves variable chains
  # lazily, while every lookup now has one linear layer rather than a DAG.
  #
  # composeSubst runs once per block statement / call argument / operator.
  # Most of those call sites pass at least one empty side, so short-circuit
  # before flattening to keep the common path allocation-free.
  if substIsEmpty(newer) then
    older
  elsif substIsEmpty(older) then
    newer
  else
    substFromEntries(appendSubstEntries(substEntriesInLookupOrder(older, []), substEntriesInLookupOrder(newer, [])))
  end
end

# Return bindings in exactly the order substGet would inspect them.  A
# reconstructed Subst uses substFromEntries, whose index keeps the first
# occurrence of each ID, preserving shadowing and compose precedence.
func substEntriesInLookupOrder(subst: Subst, out: Slice[SubstEntry]) -> Slice[SubstEntry]
  if subst.IndexFirst then
    substEntriesFromFallbacks(subst.Fallbacks, 0, appendSubstEntries(out, subst.Entries))
  else
    appendSubstEntries(substEntriesFromFallbacks(subst.Fallbacks, 0, out), subst.Entries)
  end
end

func substEntriesFromFallbacks(fallbacks: Slice[Ref[Subst]], index: Int, out: Slice[SubstEntry]) -> Slice[SubstEntry]
  if index >= fallbacks.Len() then
    out
  else
    switch fallbacks.Get(index)
      case Some(fallback) => substEntriesFromFallbacks(fallbacks, index + 1, substEntriesInLookupOrder(fallback.value(), out))
      case None => substEntriesFromFallbacks(fallbacks, index + 1, out)
    end
  end
end

func appendSubstEntries(left: Slice[SubstEntry], right: Slice[SubstEntry]) -> Slice[SubstEntry]
  appendSubstEntriesAt(left, right, 0)
end

func appendSubstEntriesAt(left: Slice[SubstEntry], right: Slice[SubstEntry], index: Int) -> Slice[SubstEntry]
  if index >= right.Len() then
    left
  else
    appendSubstEntriesAt(left.Append(right.Get(index).UnwrapOr(SubstEntry { ID: 0, Type: ast2.MonoType.TUnit })), right, index + 1)
  end
end

func substIsEmpty(subst: Subst) -> Bool
  subst.Entries.Len() == 0 && subst.Fallbacks.Len() == 0
end

func substGet(subst: Subst, id: Int) -> Option[ast2.MonoType]
  # Index is None for prepend/append layers (linear scan over their 0/1
  # entries) and Some for flattened substitutions (eager map lookup).
  let local = switch subst.Index
    case Some(index) => index.Get(id)
    case None => substIndexLinear(subst.Entries, id, 0)
  end
  if subst.IndexFirst then
    switch local
      case Some(_) => local
      # The common prepend/compose path gives the current layer priority.
      # Do not traverse its persistent fallback graph when this layer
      # already contains the requested binding.
      case None => substGetFallbacks(subst.Fallbacks, id, 0)
    end
  else
    # Appended entries intentionally give older layers priority, so this is
    # the only branch that must consult the fallback before the local layer.
    let fallback = substGetFallbacks(subst.Fallbacks, id, 0)
    switch fallback
      case Some(_) => fallback
      case None => local
    end
  end
end

func substGetFallbacks(fallbacks: Slice[Ref[Subst]], id: Int, index: Int) -> Option[ast2.MonoType]
  if index >= fallbacks.Len() then
    None
  else
    switch fallbacks.Get(index)
      case Some(fallback) then
        switch substGet(fallback.value(), id)
          case Some(value) => Some(value)
          case None => substGetFallbacks(fallbacks, id, index + 1)
        end
      end
      case None => None
    end
  end
end

func occursIn(id: Int, t: ast2.MonoType) -> Bool
  switch t
    case TVar(other) => id == other
    case TKVar(other) => id == other
    case TParam(_) => false
    case TCon(_) => false
    case TApp(ctor, args) => occursIn(id, ctor.value()) || occursInAny(id, args)
    case TFunc(args, ret) => occursInAny(id, args) || occursIn(id, ret.value())
    case TVariadic(args, ret) => occursInAny(id, args) || occursIn(id, ret.value())
    case TTuple(items) => occursInAny(id, items)
    case TUnit => false
    case TQualifiedName(_, inner) => occursIn(id, inner.value())
  end
end

func occursInAny(id: Int, items: Slice[ast2.MonoType]) -> Bool
  occursInAnyAt(id, items, 0)
end

func occursInAnyAt(id: Int, items: Slice[ast2.MonoType], index: Int) -> Bool
  if index >= items.Len() then
    false
  else
    occursIn(id, items.Get(index).UnwrapOr(ast2.MonoType.TUnit)) || occursInAnyAt(id, items, index + 1)
  end
end
