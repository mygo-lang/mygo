package typeinference2

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import parser2 "github.com/mygo-lang/mygo/internal/mygo/parser2"
import testing "go:testing"

# GoMethodSignatureInPackages resolves a method call on a Go FFI *interface*
# receiver (path go:net/http, member ResponseWriter) from the imported
# package's method table.  The resolved Write signature reports the raw Go
# shape: params `[]byte`, results `(int, error)`.
func TestGoMethodSignatureInPackagesInterfaceReceiver(t: Ref[testing.T]) -> ()
  let pkg = GoPackageEntry {
    Alias: "http",
    Path: "go:net/http",
    Funcs: [] as Slice[GoFuncSignature],
    Types: [
      GoTypeSignature {
        TypeName: "ResponseWriter",
        TypeParams: [] as Slice[String],
        Methods: [
          GoFuncSignature { Name: "Write", Params: ["[]byte"], Results: ["int", "error"], Variadic: false, TypeParams: [] as Slice[String] },
        ],
        Fields: [] as Slice[GoFieldSignature],
        Underlying: "interface{}",
      },
    ],
    Constants: [] as Slice[GoConstSignature],
  }
  switch GoMethodSignatureInPackages("go:net/http", "ResponseWriter", "Write", [pkg] as Slice[GoPackageEntry], ffiMultiResultPredicate)
    case None => t.Fatal("GoMethodSignatureInPackages did not resolve http.ResponseWriter.Write")
    case Some(sig) then
      let firstParam = switch sig.Params.Get(0)
        case Some(value) => value
        case None => ""
      end
      if sig.Params.Len() != 1 || firstParam != "[]byte" then
        t.Fatal("Write params did not resolve to []byte")
      end
      if sig.Results.Len() != 2 then t.Fatal("Write results are not a (T, error) pair") end
      let firstResult = switch sig.Results.Get(0)
        case Some(value) => value
        case None => ""
      end
      let secondResult = switch sig.Results.Get(1)
        case Some(value) => value
        case None => ""
      end
      if firstResult != "int" then t.Fatal("Write first result is not int") end
      if secondResult != "error" then t.Fatal("Write second result is not error") end
    end
  end
end

# A (T, error) interface method must resolve to the same Result-wrapping
# boundary path already used for struct methods and package functions: here
# http.ResponseWriter.Write (int, error) types as Result[int, error], so a
# function returning that annotation type-checks.
func TestInferGoInterfaceMethodWrapsResult(t: Ref[testing.T]) -> ()
  let src = """
package sample

import http "go:net/http"

func write(w: Ref[http.ResponseWriter], b: Slice[Byte]) -> Result[Int, Error]
  w.Write(b)
end
"""
  let parsed = parser2.ParseFile(src)
  switch parsed
    case Err(msg) => t.Fatal(msg)
    case Ok(file) then
      var fileWithIDs: ast2.File = file
      switch ast2.AssignFileExprIDs(file)
        case Some(typed) => fileWithIDs = typed
        case None => t.Fatal("AssignFileExprIDs returned None")
      end
      let pkg = GoPackageEntry {
        Alias: "http",
        Path: "go:net/http",
        Funcs: [] as Slice[GoFuncSignature],
        Types: [
          GoTypeSignature {
            TypeName: "ResponseWriter",
            TypeParams: [] as Slice[String],
            Methods: [
              GoFuncSignature { Name: "Write", Params: ["[]byte"], Results: ["int", "error"], Variadic: false, TypeParams: [] as Slice[String] },
            ],
            Fields: [] as Slice[GoFieldSignature],
            Underlying: "interface{}",
          },
        ],
        Constants: [] as Slice[GoConstSignature],
      }
      switch InferPackageWithGoPackages(
        [PkgDeclSource { Path: "ffi-interface.mygo", Decls: fileWithIDs.Decls }],
        [pkg] as Slice[GoPackageEntry],
      )
        case Ok(_) => ()
        case Err(msg) => t.Fatalf("inference rejected interface method call: %s", msg)
      end
    end
  end
end
