package typeinference2
import common2 "github.com/mygo-lang/mygo/internal/mygo/common2"

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import importer "go:go/importer"
import gotypes "go:go/types"
import strings "go:strings"
# Predeclare function signatures so a declaration can call functions defined
# later in the same source file. This is required by the self-hosted modules,
# whose mutually-recursive helpers are intentionally grouped by concern.
#
# `env` is assumed to already contain seeded imports (e.g. via
# seedMyGoPackageEnv) so that any `alias.Name` references in the signature
# resolve through the env and end up wrapped in TQualifiedName with the
# package's canonical import path.
func predeclareFunctions(decls: Slice[ast2.Decl], env: Env) -> Env
  switch predeclareFunctionsWithState(decls, env, NewInferState())
    case Some(result) => result
    case None => env
  end
end

func predeclareFunctionsWithState(decls: Slice[ast2.Decl], env: Env, state: InferState) -> Option[Env]
  if decls.Len() == 0 then
    Some(env)
  else
    switch decls.Get(0)
      case Some(decl) then
        let next = switch decl
          case TypeAliasDecl(name, tps, target) then
            envPut(
              env,
              name,
              Scheme {
                Bound: typeParamIDs(tps, 1),
                Predicates: [],
                Body: typeFromASTInEnvWithParams(target, tps, env, state),
              }
            )
          end
          case TypeDecl(name, tps, _) then
            envPut(
              env,
              name,
              Scheme {
                Bound: typeParamIDs(tps, 1),
                Predicates: [],
                Body: declaredType(name, tps),
              }
            )
          end
          case LetDecl(bind) then
            switch bind.Type
              case Some(typ) then
                envPut(
                  env,
                  bind.Name,
                  Scheme {
                    Bound: [],
                    Predicates: [],
                    Body: typeFromASTInEnvWithParams(typ, [], env, state),
                  }
                )
              end
              case None => env
            end
          end
          case VarDecl(bind) then
            switch bind.Type
              case Some(typ) then
                envPut(
                  env,
                  bind.Name,
                  Scheme {
                    Bound: [],
                    Predicates: [],
                    Body: typeFromASTInEnvWithParams(typ, [], env, state),
                  }
                )
              end
              case None => env
            end
          end
          case FuncDecl(name, tps, params, ret, _, constraints) then
            switch paramsToTypesWithParamsInEnv(params, tps, env, state)
              case Some(paramTypes) then
                let retType = switch ret
                  case Some(t) => typeFromASTInEnvWithParams(t, tps, env, state)
                  case None => ast2.MonoType.TUnit
                end
                envPut(
                  env,
                  name,
                  Scheme {
                    Bound: typeParamIDs(tps, 1),
                    Predicates: predicatesFromConstraintsWithParams(constraints, tps),
                    Body: ast2.MonoType.TFunc(paramTypes, Ref.new(retType)),
                  }
                )
              end
              case None => env
            end
          end
          case EnumDecl(name, tps, vars) => predeclareEnum(env, name, tps, vars)
          case _ => env
        end
        predeclareFunctionsWithState(common2.SliceDrop(decls, 1), next, state)
      end
      case None => None
    end
  end
end

func declaredType(name: String, tps: Slice[String]) -> ast2.MonoType
  if tps.Len() == 0 then
    ast2.MonoType.TCon(name)
  else
    ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon(name)), typeParamsAsTypes(tps, 1))
  end
end

func predeclareEnum(env: Env, name: String, tps: Slice[String], vars: Slice[ast2.Variant]) -> Env
  let enumType = tCon(name, typeParamsAsTypes(tps, 1))
  let envWithEnum = envPut(
    env,
    name,
    Scheme {
      Bound: typeParamIDs(tps, 1),
      Predicates: [],
      Body: enumType,
    }
  )
  switch predeclareEnumVariants(envWithEnum, vars, name, tps, NewInferState())
    case Some(result) => result
    case None => envWithEnum
  end
end

func predeclareEnumVariants(env: Env, vars: Slice[ast2.Variant], name: String, tps: Slice[String], state: InferState) -> Option[Env]
  if vars.Len() == 0 then
    Some(env)
  else
    switch vars.Get(0)
      case Some(v) then
        let enumType = tCon(name, typeParamsAsTypes(tps, 1))
        let constructorType = if v.Fields.Len() == 0 then
          enumType
        else
          ast2.MonoType.TFunc(typeArgsFromASTInEnvWithParamsList(v.Fields, tps, env, state), Ref.new(enumType))
        end
        let scheme = Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: constructorType }
        let withQualified = envPut(env, name + "." + v.Name, scheme)
        predeclareEnumVariants(withQualified, common2.SliceDrop(vars, 1), name, tps, state)
      end
      case None => None
    end
  end
end

func inferDecls(decls: Slice[ast2.Decl], env: Env, fields: Slice[FieldEntry], state: InferState) -> Result[PackageInfo, String]
  if decls.Len() == 0 then
    Ok(PackageInfo {
      Env: env.ToSlice(),
      Fields: fields,
      GoPackages: [],
      MyGoPackages: state.MyGoPackages,
      Instances: [],
      Solver: newSolver(),
      TypedDecls: [],
      ExternalTypedDecls: [],
      TypedDeclSources: [],
      ExternalTypedDeclSources: [],
      ResolvedConstraintArgs: state.ResolvedConstraintArgs,
    })
  else
    switch decls.Get(0)
      case Some(head) then
        let tail = common2.SliceDrop(decls, 1)
        let next = inferDecl(head, env, fields, state)
        switch next
          case Ok(pair) then
            let rest = inferDecls(tail, pair.Env, pair.Fields, pair.State)
            switch rest
              case Ok(info) then
                let newDecls = switch pair.TypedDecl
                  case Some(d) => info.TypedDecls.Prepend(d)
                  case None => info.TypedDecls
                end
                Ok(PackageInfo {
                  Env: info.Env,
                  Fields: info.Fields,
                  GoPackages: info.GoPackages,
                  MyGoPackages: info.MyGoPackages,
                  Instances: info.Instances,
                  Solver: info.Solver,
                  TypedDecls: newDecls,
                  ExternalTypedDecls: info.ExternalTypedDecls,
                  TypedDeclSources: info.TypedDeclSources,
                  ExternalTypedDeclSources: info.ExternalTypedDeclSources,
                  ResolvedConstraintArgs: info.ResolvedConstraintArgs,
                })
              end
              case Err(m) => Err(m)
            end
          end
          case Err(msg) => Err(msg)
        end
      end
      case None => Err("malformed AST: missing declaration")
    end
  end
end

func inferDecl(decl: ast2.Decl, env: Env, fields: Slice[FieldEntry], state: InferState) -> Result[DeclInfer, String]
  switch decl
    case ImportDecl(_, _) then
      Ok(DeclInfer { Env: env, Fields: fields, State: state, TypedDecl: None})
    end
    case LetDecl(bind) => inferPackageBinding(bind, false, env, fields, state)
    case VarDecl(bind) => inferPackageBinding(bind, true, env, fields, state)
    case TypeAliasDecl(_, _, _) then
      Ok(DeclInfer {
        Env: env,
        Fields: fields,
        State: state,
        TypedDecl: Some(decl),
      })
    end
    case TypeDecl(_, _, _) then
      Ok(DeclInfer {
        Env: env,
        Fields: fields,
        State: state,
        TypedDecl: Some(decl),
      })
    end
    case StructDecl(name, tps, structFields) then
      switch structSymbolsInEnv(name, structFields, tps, env, state, [])
        case None => Err("malformed struct declaration: missing field index")
        case Some(newSymbols) then
          inferStructDeclWithSymbols(name, tps, structFields, env, fields, state, decl, newSymbols)
        end
      end
    end
    case EnumDecl(name, tps, vars) then
      switch validateEnumVariantFieldNames(vars)
        case Err(msg) => Err("enum " + name + ": " + msg)
        case Ok(_) then
          switch inferVariants(vars, name, tps, env, fields, state)
            case Ok(di) then
              Ok(DeclInfer {
                Env: di.Env,
                Fields: di.Fields,
                State: di.State,
                TypedDecl: Some(decl),
              })
            end
            case Err(msg) => Err(msg)
          end
        end
      end
    end
    case InterfaceDecl(name, _, _) then
      Ok(DeclInfer {
        Env: envPut(
          env,
          name,
          Scheme {
            Bound: [],
            Predicates: [],
            Body: ast2.MonoType.TCon(name),
          }
        ),
        Fields: fields,
        State: state,
        TypedDecl: Some(decl),
      })
    end
    case ImplDecl(tps, target, iface, methods) then
      switch implReceiverName(target, iface)
        case None => Err("malformed impl declaration: receiver type is missing")
        case Some(receiverName) then
          switch implMethodSymbols(receiverName, tps, methods, env, [])
            case None => Err("malformed impl declaration: method signature index is missing")
            case Some(implSyms) then
              inferImplDeclWithSymbols(tps, target, iface, methods, receiverName, implSyms, env, fields, state, decl)
            end
          end
        end
      end
    end
    case FuncDecl(name, tps, params, ret, body, constraints) then
      inferFuncDecl(name, tps, params, ret, body, constraints, env, fields, state)
    end
  end
end

func inferStructDeclWithSymbols(name: String, tps: Slice[String], structFields: Slice[ast2.Field], env: Env, fields: Slice[FieldEntry], state: InferState, decl: ast2.Decl, newSymbols: Slice[Symbol]) -> Result[DeclInfer, String]
  switch concatSymbols(newSymbols, state.Symbols)
    case None => Err("malformed struct declaration: symbol index is missing")
    case Some(symbols) then
      switch fieldsForStructInEnv(name, structFields, tps, env, state, fields)
        case None => Err("malformed struct declaration: field index is missing")
        case Some(allFields) then
          inferStructDeclWithResolvedFields(name, tps, structFields, env, state, decl, newSymbols, symbols, allFields)
        end
      end
    end
  end
end

func inferStructDeclWithResolvedFields(name: String, tps: Slice[String], structFields: Slice[ast2.Field], env: Env, state: InferState, decl: ast2.Decl, newSymbols: Slice[Symbol], symbols: Slice[Symbol], allFields: Slice[FieldEntry]) -> Result[DeclInfer, String]
  let stateWithSymbols = InferState {
    FreshVarID: state.FreshVarID,
    PkgInfo: state.PkgInfo,
    GoPackages: state.GoPackages,
    MyGoPackages: state.MyGoPackages,
    MyGoPackageCache: state.MyGoPackageCache,
    Symbols: symbols,
    SymbolIndex: symbolIndexPrepend(state.SymbolIndex, newSymbols),
    ActiveConstraints: state.ActiveConstraints,
    NamedImpls: state.NamedImpls,
    ResolvedConstraintArgs: state.ResolvedConstraintArgs,
  }
  Ok(DeclInfer {
    Env: envWithStructFields(
      envPut(
        env,
        name,
        Scheme {
          Bound: typeParamIDs(tps, 1),
          Predicates: [],
          Body: tCon(name, typeParamsAsTypes(tps, 1)),
        }
      ),
      name,
      tps,
      structFields
    ),
    Fields: allFields,
    State: stateWithSymbols,
    TypedDecl: Some(decl),
  })
end

func inferImplDeclWithSymbols(tps: Slice[String], target: ast2.TypeExpr, iface: Option[ast2.TypeExpr], methods: Slice[ast2.ImplMethod], receiverName: String, implSyms: Slice[Symbol], env: Env, fields: Slice[FieldEntry], state: InferState, decl: ast2.Decl) -> Result[DeclInfer, String]
  switch concatSymbols(state.Symbols, implSyms)
    case None => Err("malformed impl declaration: missing symbol index")
    case Some(symbols) then
      inferImplDeclWithResolvedSymbols(tps, target, iface, methods, receiverName, implSyms, symbols, env, fields, state, decl)
    end
  end
end

func inferImplDeclWithResolvedSymbols(tps: Slice[String], target: ast2.TypeExpr, iface: Option[ast2.TypeExpr], methods: Slice[ast2.ImplMethod], receiverName: String, implSyms: Slice[Symbol], symbols: Slice[Symbol], env: Env, fields: Slice[FieldEntry], state: InferState, decl: ast2.Decl) -> Result[DeclInfer, String]
  let stateWithSyms = InferState {
    FreshVarID: state.FreshVarID,
    PkgInfo: state.PkgInfo,
    GoPackages: state.GoPackages,
    MyGoPackages: state.MyGoPackages,
    MyGoPackageCache: state.MyGoPackageCache,
    Symbols: symbols,
    SymbolIndex: symbolIndexAppend(state.SymbolIndex, implSyms),
    ActiveConstraints: state.ActiveConstraints,
    NamedImpls: state.NamedImpls,
    ResolvedConstraintArgs: state.ResolvedConstraintArgs,
  }
  let res = inferImplMethods(
    methods,
    tps,
    env,
    fields,
    stateWithSyms,
    [],
    receiverName
  )
  switch res
    case Ok(pair) then
      let (typedMethods, newState) = pair
      Ok(DeclInfer {
        Env: env,
        Fields: fields,
        State: newState,
        TypedDecl: Some(ast2.Decl.ImplDecl(tps, target, iface, typedMethods)),
      })
    end
    case Err(m) => Err(m)
  end
end

func validateEnumVariantFieldNames(vars: Slice[ast2.Variant]) -> Result[(), String]
  if vars.Len() == 0 then
    Ok(())
  else
    switch vars.Get(0)
      case Some(variant) then
        if variant.Named then
          switch duplicateString(variant.Names, [])
            case Some(field) then
              Err("variant " + variant.Name + " declares field " + field + " more than once")
            end
            case None => validateEnumVariantFieldNames(common2.SliceDrop(vars, 1))
          end
        else
          validateEnumVariantFieldNames(common2.SliceDrop(vars, 1))
        end
      end
      case None => Err("malformed enum: missing variant")
    end
  end
end

func duplicateString(items: Slice[String], seen: Slice[String]) -> Option[String]
  if items.Len() == 0 then
    None
  else
    switch items.Get(0)
      case Some(item) then
        if stringSliceContains(seen, item) then
          Some(item)
        else
          duplicateString(common2.SliceDrop(items, 1), seen.Append(item))
        end
      end
      case None => None
    end
  end
end

func inferPackageBinding(bind: ast2.Bind, mutable: Bool, env: Env, fields: Slice[FieldEntry], state: InferState) -> Result[DeclInfer, String]
  let inferred = inferBlockBind(bind, mutable, env, state)
  switch inferred
    case Err(msg) => Err(msg)
    case Ok(step) then
      let typed = switch step.Stmt
        case LetStmt(value) => ast2.Decl.LetDecl(value)
        case VarStmt(value) => ast2.Decl.VarDecl(value)
        case _ => ast2.Decl.LetDecl(bind)
      end
      Ok(DeclInfer {
        Env: step.Env,
        Fields: fields,
        State: step.Result.State,
        TypedDecl: Some(typed),
      })
    end
  end
end

func inferFuncDecl(name: String, tps: Slice[String], params: Slice[ast2.Param], ret: Option[ast2.TypeExpr], body: ast2.Expr, constraints: Slice[ast2.Constraint], env: Env, fields: Slice[FieldEntry], state: InferState) -> Result[DeclInfer, String]
  # Resolve parameter and return types against the running env so that
  # dot-name references (e.g. `ps.Parser`) collapse to a TQualifiedName
  # whose first field is the package's import path.  This keeps
  # `ps.ParseInput(fileParser(), input)` consistent: the callee's parameter
  # type and the call-site argument type share the same canonical path.
  switch paramsToTypesWithParamsInEnv(params, tps, env, state)
    case None => Err("malformed function declaration: missing parameter index")
    case Some(paramTypes) then
      inferFuncDeclWithParamTypes(name, tps, params, ret, body, constraints, env, fields, state, paramTypes)
    end
  end
end

func inferFuncDeclWithParamTypes(name: String, tps: Slice[String], params: Slice[ast2.Param], ret: Option[ast2.TypeExpr], body: ast2.Expr, constraints: Slice[ast2.Constraint], env: Env, fields: Slice[FieldEntry], state: InferState, paramTypes: Slice[ast2.MonoType]) -> Result[DeclInfer, String]
  let retType = switch ret
    case Some(t) => typeFromASTInEnvWithParams(t, tps, env, state)
    case None => ast2.MonoType.TUnit
  end
  let fnType = ast2.MonoType.TFunc(paramTypes, Ref.new(retType))
  let predicates = predicatesFromConstraintsWithParams(constraints, tps)
  let envWithSig = envPut(
    env,
    name,
    Scheme {
      Bound: typeParamIDs(tps, 1),
      Predicates: predicates,
      Body: fnType,
    }
  )
  switch envWithParamsAndTypes(envWithSig, params, paramTypes)
    case None => return Err("malformed function declaration: missing parameter binding index")
    case Some(paramEnv) then
      switch envWithTypeParams(paramEnv, tps)
        case None => return Err("malformed function declaration: missing type parameter index")
        case Some(bodyEnv) then
          inferFuncDeclInEnv(
            name,
            tps,
            params,
            ret,
            body,
            constraints,
            env,
            fields,
            state,
            paramTypes,
            retType,
            fnType,
            predicates,
            bodyEnv
          )
        end
      end
    end
  end
end

func inferFuncDeclInEnv(name: String, tps: Slice[String], params: Slice[ast2.Param], ret: Option[ast2.TypeExpr], body: ast2.Expr, constraints: Slice[ast2.Constraint], env: Env, fields: Slice[FieldEntry], state: InferState, paramTypes: Slice[ast2.MonoType], retType: ast2.MonoType, fnType: ast2.MonoType, predicates: Slice[Predicate], bodyEnv: Env) -> Result[DeclInfer, String]
  # Method-call syntax within a function body must see the function's `using`
  # predicates. Otherwise `value.Show()` is left as a plain selector call even
  # though codegen has injected the corresponding ShowFn dictionary parameter.
  let bodyState = withActiveConstraints(state, predicates)
  let inferred = inferExpr(body, bodyEnv, bodyState)
  switch inferred
    case Ok(eir) then
      let r = eir.Result
      let inferredType = applySubst(r.Subst, r.Type)
      let checked = if isGoBoundaryTuple(inferredType, retType) then
        Ok(r.Subst)
      else
        unify(inferredType, retType, r.Subst)
      end
      switch checked
        case Ok(s2) then
          let typedBody = applyTypedExprSubst(s2, eir.Expr)
          Ok(DeclInfer {
            Env: envPut(
              env,
              name,
              Scheme {
                Bound: typeParamIDs(tps, 1),
                Predicates: predicates,
                Body: applySubst(s2, fnType),
              }
            ),
            Fields: fields,
            # Function-local constraints must not leak into following package
# declarations, while fresh IDs and other inference state updates
# from the body remain available.
State: withActiveConstraints(r.State, state.ActiveConstraints),
            TypedDecl: Some(ast2.Decl.FuncDecl(name, tps, params, ret, typedBody, constraints)),
          })
        end
        case Err(msg) then
          Err(functionBodyError(
            body,
            name,
            "return type mismatch: " + msg + " [inferred=" + MonoStringFull(inferredType) + " ret=" + MonoStringFull(retType) + "]"
          ))
        end
      end
    end
    case Err(msg) => Err(functionBodyError(body, name, msg))
  end
end

func inferImplMethods(methods: Slice[ast2.ImplMethod], tps: Slice[String], env: Env, fields: Slice[FieldEntry], state: InferState, out: Slice[ast2.ImplMethod], receiverName: String) -> Result[(Slice[ast2.ImplMethod], InferState), String]
  if methods.Len() == 0 then
    Ok((out, state))
  else
    switch methods.Get(0)
      case Some(m) then
        let sig = m.Sig
        switch appendStringSlice(tps, sig.TypeParams)
          case None => Err("malformed impl method: missing type parameter index")
          case Some(combined) then
            switch paramsToTypesWithParamsInEnv(sig.Params, combined, env, state)
              case None => Err("malformed impl method: missing parameter index")
              case Some(paramTypes) then
                inferImplMethodBody(methods, tps, env, fields, state, out, receiverName, m, sig, combined, paramTypes)
              end
            end
          end
        end
      end
      case None => Err("malformed implementation: missing method")
    end
  end
end

func inferImplMethodBody(methods: Slice[ast2.ImplMethod], tps: Slice[String], env: Env, fields: Slice[FieldEntry], state: InferState, out: Slice[ast2.ImplMethod], receiverName: String, m: ast2.ImplMethod, sig: ast2.FuncSig, combined: Slice[String], paramTypes: Slice[ast2.MonoType]) -> Result[(Slice[ast2.ImplMethod], InferState), String]
  switch envWithParamsAndTypes(env, sig.Params, paramTypes)
    case None => Err("malformed impl method: missing parameter binding index")
    case Some(paramEnv) then
      switch envWithTypeParams(paramEnv, combined)
        case None => Err("malformed impl method: missing type parameter index")
        case Some(bodyEnv) then
          inferImplMethodWithEnv(
            methods,
            tps,
            env,
            fields,
            state,
            out,
            receiverName,
            m,
            sig,
            combined,
            paramTypes,
            bodyEnv
          )
        end
      end
    end
  end
end

func inferImplMethodWithEnv(methods: Slice[ast2.ImplMethod], tps: Slice[String], env: Env, fields: Slice[FieldEntry], state: InferState, out: Slice[ast2.ImplMethod], receiverName: String, m: ast2.ImplMethod, sig: ast2.FuncSig, combined: Slice[String], paramTypes: Slice[ast2.MonoType], bodyEnv: Env) -> Result[(Slice[ast2.ImplMethod], InferState), String]
  let methodState = withActiveConstraints(
    state,
    predicatesFromConstraintsWithParams(sig.Using, combined)
  )
  let inferred = inferExpr(m.Body, bodyEnv, methodState)
  switch inferred
    case Ok(eir) then
      let typedBody = applyTypedExprSubst(eir.Result.Subst, eir.Expr)
      let typedMethod = ast2.ImplMethod { Pos: m.Pos, Sig: sig, Body: typedBody }
      # The predicates collected from the body are instantiated at each
      # method-call site.  Their TVar IDs are therefore local inference
      # details (and a method may collect the same predicate more than
      # once).  Store the method's declared constraints instead: these
      # retain the declared constraint identity used by codegen dispatch.
      switch storeResolvedConstraintArgs(receiverName, sig, combined, eir.Result.State)
        case Some(resolvedState) then
          let newState = withActiveConstraints(resolvedState, state.ActiveConstraints)
          inferImplMethods(
            common2.SliceDrop(methods, 1),
            tps,
            env,
            fields,
            newState,
            out.Append(typedMethod),
            receiverName
          )
        end
        case None => Err("malformed implementation constraints: missing constraint")
      end
    end
    case Err(msg) => Err(msg)
  end
end

func storeResolvedConstraintArgs(receiverName: String, sig: ast2.FuncSig, typeParams: Slice[String], state: InferState) -> Option[InferState]
  storeMethodConstraintArgs(receiverName, sig.Name, sig.Using, typeParams, state)
end

# Store each `using` entry under its own identity.  Methods such as Equals
# commonly occur in multiple constraints, so {receiver, method} alone cannot
# distinguish Eq[A] from Eq[E] or a named impl such as ResultEq[A, E].
func storeMethodConstraintArgs(receiverName: String, methodName: String, constraints: Slice[ast2.Constraint], typeParams: Slice[String], state: InferState) -> Option[InferState]
  if constraints.Len() == 0 then
    Some(state)
  else
    switch constraints.Get(0)
      case Some(constraint) then
        let args = typeArgsFromASTWithParams(constraint.Args, typeParams)
        let key = MethodConstraintKey {
          Receiver: receiverName,
          Constraint: methodConstraintRef(constraint.Name, state.NamedImpls),
          ArgsKey: constraintArgsKey(args),
          Method: methodName,
        }
        state.ResolvedConstraintArgs.Set(key, args)
        storeMethodConstraintArgs(receiverName, methodName, common2.SliceDrop(constraints, 1), typeParams, state)
      end
      case None => None
    end
  end
end

func constraintArgsKey(args: Slice[ast2.MonoType]) -> String
  constraintArgsKeyLoop(args, 0, "")
end

func constraintArgsKeyLoop(args: Slice[ast2.MonoType], index: Int, out: String) -> String
  switch constraintArgsKeyAt(args, index, out)
    case Some(value) => value
    case None => out
  end
end

func constraintArgsKeyAt(args: Slice[ast2.MonoType], index: Int, out: String) -> Option[String]
  if index >= args.Len() then
    Some(out)
  else
    switch args.Get(index)
      case Some(item) then
        let next = if out == "" => monoStringFull(item) else out + "," + monoStringFull(item)
        constraintArgsKeyAt(args, index + 1, next)
      end
      case None => None
    end
  end
end

func methodConstraintRef(name: String, namedImpls: Slice[String]) -> MethodConstraintRef
  if stringSliceContains(namedImpls, name) then
    MethodConstraintRef.NamedImpl(name)
  else
    MethodConstraintRef.Interface(name)
  end
end

func stringSliceContains(items: Slice[String], wanted: String) -> Bool
  switch stringSliceContainsAt(items, wanted, 0)
    case Some(found) => found
    case None => false
  end
end

func stringSliceContainsAt(items: Slice[String], wanted: String, index: Int) -> Option[Bool]
  if index >= items.Len() then
    Some(false)
  else
    switch items.Get(index)
      case Some(item) then
        if item == wanted then
          Some(true)
        else
          stringSliceContainsAt(items, wanted, index + 1)
        end
      end
      case None => None
    end
  end
end

func collectResolvedMonos(predicates: Slice[Predicate], index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  switch collectResolvedMonosAt(predicates, index, out)
    case Some(monos) => monos
    case None => out
  end
end

func collectResolvedMonosAt(predicates: Slice[Predicate], index: Int, out: Slice[ast2.MonoType]) -> Option[Slice[ast2.MonoType]]
  if index >= predicates.Len() then
    Some(out)
  else
    switch predicates.Get(index)
      case Some(predicate) then
        switch predicate.Args.Get(0)
          case Some(arg) => collectResolvedMonosAt(predicates, index + 1, out.Append(arg))
          case None => None
        end
      end
      case None => None
    end
  end
end

func isGoBoundaryTuple(inferred: ast2.MonoType, expected: ast2.MonoType) -> Bool
  switch inferred
    case TTuple(items) then
      switch expected
        case TApp(typeRef, _) then
          switch typeRef.value()
            case TCon(name) => (name == "Option" || name == "Result") && items.Len() == 2
            case _ => false
          end
        end
        case _ => false
      end
    end
    case _ => false
  end
end

# Convert parser constraints to inference predicates. Resolution is deliberately
# deferred: a predicate may mention a type parameter and must survive until a
# call site supplies concrete arguments.
func predicatesFromConstraintsWithParams(items: Slice[ast2.Constraint], params: Slice[String]) -> Slice[Predicate]
  predicatesFromConstraintsWithParamsInto(items, params, 0, [])
end

func predicatesFromConstraintsWithParamsInto(items: Slice[ast2.Constraint], params: Slice[String], index: Int, out: Slice[Predicate]) -> Slice[Predicate]
  switch predicatesFromConstraintsWithParamsAt(items, params, index, out)
    case Some(predicates) => predicates
    case None => out
  end
end

func predicatesFromConstraintsWithParamsAt(items: Slice[ast2.Constraint], params: Slice[String], index: Int, out: Slice[Predicate]) -> Option[Slice[Predicate]]
  if index >= items.Len() then
    Some(out)
  else
    switch items.Get(index)
      case Some(item) then
        predicatesFromConstraintsWithParamsAt(
          items,
          params,
          index + 1,
          out.Append(Predicate {
            ClassName: item.Name,
            Args: typeArgsFromASTWithParams(item.Args, params),
          })
        )
      end
      case None => None
    end
  end
end

func inferExpr(expr: ast2.Expr, env: Env, state: InferState) -> Result[ExprInferResult, String]
  let result = inferExprInner(expr, env, state)
  switch result
    case Ok(eir) then
      # Preserve the local inferred type while composing parent substitutions.
      # A completed declaration/block normalises its typed subtree once; doing
      # so at every expression boundary repeatedly expands the same type.
      let typedExpr = ast2.Expr {
        ID: expr.ID,
        Pos: expr.Pos,
        Kind: eir.Expr.Kind,
        Type: Some(eir.Result.Type),
      }
      let nextState = recordInferredExprType(typedExpr, eir.Result.Type, eir.Result.Predicates, eir.Result.Subst, eir.Result.State)
      Ok(ExprInferResult {
        Expr: typedExpr,
        Result: InferResult {
          Type: eir.Result.Type,
          Predicates: eir.Result.Predicates,
          Subst: eir.Result.Subst,
          State: nextState,
        },
      })
    end
    case Err(msg) => Err(common2.ErrorAtExpr(expr, msg))
  end
end

func recordInferredExprType(expr: ast2.Expr, typ: ast2.MonoType, preds: Slice[Predicate], subst: Subst, state: InferState) -> InferState
  state
end

# Function-level wrappers used to add `function name:` before the expression
# error reached errorAtExpr. That colon made errorAtExpr assume the message was
# already located, dropping the source position altogether. Attach the body's
# position before adding the function context instead.
func functionBodyError(body: ast2.Expr, name: String, msg: String) -> String
  let source = if body.Pos.SourceName == "" then
    "<input>"
  else
    body.Pos.SourceName
  end
  source + ":" + body.Pos.Line.ToString() + ":" + body.Pos.Column.ToString() + ": function " + name + ": " + msg
end

func mkTyped(expr: ast2.Expr, t: ast2.MonoType, state: InferState, exprKind: Option[ast2.ExprKind]) -> ExprInferResult
  let kind = switch exprKind
    case Some(k) => k
    case None => expr.Kind
  end
  let te = ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: kind, Type: Some(t) }
  ExprInferResult {
    Expr: te,
    Result: InferResult {
      Type: t,
      Predicates: [],
      Subst: emptySubst(),
      State: state,
    },
  }
end

struct ExprInferResult
  Expr: ast2.Expr
  Result: InferResult
end

func inferExprInner(expr: ast2.Expr, env: Env, state: InferState) -> Result[ExprInferResult, String]
  switch expr.Kind
    case IdentExpr(name) then
      switch envGet(env, name)
        case Some(s) then
          let q = instantiateQualified(s, state)
          let te = ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: expr.Kind, Type: Some(q.Body) }
          Ok(ExprInferResult {
            Expr: te,
            Result: InferResult {
              Type: q.Body,
              Predicates: q.Predicates,
              Subst: emptySubst(),
              State: withFreshID(state, state.FreshVarID + s.Bound.Len()),
            },
          })
        end
        case None => Err("unknown identifier " + name)
      end
    end
    case NumberExpr(value) => Ok(mkTyped(expr, numberLiteralType(value), state, None))
    case StringExpr(_) => Ok(mkTyped(expr, ast2.MonoType.TCon("String"), state, None))
    case RuneExpr(_) => Ok(mkTyped(expr, ast2.MonoType.TCon("Rune"), state, None))
    case BoolExpr(_) => Ok(mkTyped(expr, ast2.MonoType.TCon("Bool"), state, None))
    case UnitExpr => Ok(mkTyped(expr, ast2.MonoType.TUnit, state, None))
    case SliceLitExpr(items) then
      let r = inferSlice(items, env, state)
      switch r
        case Ok(pair) then
          let (v, typedItems) = pair
          let typedKind = ast2.ExprKind.SliceLitExpr(typedItems)
          let result = InferResult {
            Type: v.Type,
            Predicates: v.Predicates,
            Subst: v.Subst,
            State: v.State,
          }
          Ok(ExprInferResult {
            Expr: ast2.Expr {
              ID: expr.ID,
              Pos: expr.Pos,
              Kind: typedKind,
              Type: Some(v.Type),
            },
            Result: result,
          })
        end
        case Err(m) => Err(m)
      end
    end
    case TypeAsExpr(value, typ) then
      let r = inferTypeAs(value, typ, env, state)
      switch r
        case Ok(pair) then
          let (v, typedValue) = pair
          let typedKind = ast2.ExprKind.TypeAsExpr(applyTypedExprSubst(v.Subst, typedValue), typ)
          let result = InferResult {
            Type: v.Type,
            Predicates: v.Predicates,
            Subst: v.Subst,
            State: v.State,
          }
          Ok(ExprInferResult {
            Expr: ast2.Expr {
              ID: expr.ID,
              Pos: expr.Pos,
              Kind: typedKind,
              Type: Some(result.Type),
            },
            Result: result,
          })
        end
        case Err(m) => Err(m)
      end
    end
    case TupleExpr(items) then
      let r = inferTuple(items, env, state)
      switch r
        case Ok(pair) then
          let (v, typedItems) = pair
          let typedKind = ast2.ExprKind.TupleExpr(typedItems)
          let result = InferResult {
            Type: v.Type,
            Predicates: v.Predicates,
            Subst: v.Subst,
            State: v.State,
          }
          Ok(ExprInferResult {
            Expr: ast2.Expr {
              ID: expr.ID,
              Pos: expr.Pos,
              Kind: typedKind,
              Type: Some(v.Type),
            },
            Result: result,
          })
        end
        case Err(m) => Err(m)
      end
    end
    case UnaryExpr(op, inner) => inferUnary(expr, op, inner, env, state)
    case BinaryExpr(op, left, right) then
      let r = inferBinary(expr, op, left, right, env, state)
      switch r
        case Ok(eir) => Ok(eir)
        case Err(m) => Err(m)
      end
    end
    case CallExpr(callee, typeArgs, args) then
      let r = inferCall(callee, typeArgs, args, env, state)
      switch r
        # inferCall constructs the typed call itself.  Keeping the parsed
        # expression here used to discard DictionaryCallExpr annotations.

        case Ok(eir) => Ok(eir)
        case Err(m) => Err(m)
      end
    end
    case FieldExpr(base, field) then
      let res = inferField(base, field, env, state)
      switch res
        case Ok(eir) then
          # A selector can be used immediately as an impl-method receiver
          # (`tail.Value.Prepend(...)`).  Persist its fully substituted type
          # in the typed AST so codegen does not have to recover it from the
          # surrounding expression's potentially stale substitutions.
          let resolvedType = applySubst(eir.Result.Subst, eir.Result.Type)
          let te = ast2.Expr {
            ID: expr.ID,
            Pos: expr.Pos,
            Kind: ast2.ExprKind.FieldExpr(eir.Expr, field),
            Type: Some(resolvedType),
          }
          Ok(ExprInferResult { Expr: te, Result: eir.Result })
        end
        case Err(msg) => Err(msg)
      end
    end
    case IfExpr(cond, thenExpr, elseExpr) => inferIf(expr, cond, thenExpr, elseExpr, env, state)
    case SwitchExpr(target, cases, _) then
      let r = inferSwitch(target, cases, env, state)
      switch r
        # inferSwitch already returns the fully reconstructed typed switch,
        # including its inferred case bodies.

        case Ok(eir) => Ok(eir)
        case Err(m) => Err(m)
      end
    end
    case BlockExpr(items) then
      let r = inferTypedBlock(items, env, state)
      switch r
        case Ok(pair) then
          let (v, typedItems) = pair
          let typedKind = ast2.ExprKind.BlockExpr(typedItems)
          Ok(mkTyped(expr, v.Type, v.State, Some(typedKind)))
        end
        case Err(m) => Err(m)
      end
    end
    case FuncLitExpr(params, ret, body) then
      let r = inferFuncLit(params, ret, body, env, state)
      switch r
        case Ok(eir) then
          let typedKind = ast2.ExprKind.FuncLitExpr(params, ret, eir.Expr)
          Ok(ExprInferResult {
            Expr: ast2.Expr {
              ID: expr.ID,
              Pos: expr.Pos,
              Kind: typedKind,
              Type: Some(eir.Result.Type),
            },
            Result: eir.Result,
          })
        end
        case Err(m) => Err(m)
      end
    end
    case StructLitExpr(typeName, fields) then
      let r = inferTypedStructLit(typeName, fields, env, state)
      switch r
        case Ok(pair) then
          let (v, typedFields) = pair
          let typedKind = ast2.ExprKind.StructLitExpr(typeName, typedFields)
          Ok(ExprInferResult {
            Expr: ast2.Expr {
              ID: expr.ID,
              Pos: expr.Pos,
              Kind: typedKind,
              Type: Some(v.Type),
            },
            Result: v,
          })
        end
        case Err(m) => Err(m)
      end
    end
    case GenericStructLitExpr(typeName, typeArgs, fields) then
      # Resolve qualified constructors (for example `ps.Reply[A]`) through
      # the import environment, just like annotated function return types.
      let resultType = typeFromASTInEnv(ast2.TypeExpr.NamedType(typeName, typeArgs), env, state)
      let r = inferTypedStructLitForType(resultType, fields, env, state)
      switch r
        case Ok(pair) then
          let (v, typedFields) = pair
          let result = InferResult {
            Type: resultType,
            Predicates: v.Predicates,
            Subst: v.Subst,
            State: v.State,
          }
          let typedKind = ast2.ExprKind.GenericStructLitExpr(typeName, typeArgs, typedFields)
          Ok(ExprInferResult {
            Expr: ast2.Expr {
              ID: expr.ID,
              Pos: expr.Pos,
              Kind: typedKind,
              Type: Some(resultType),
            },
            Result: result,
          })
        end
        case Err(m) => Err(m)
      end
    end
    case MapLitExpr(pairs) then
      let r = inferMapLit(pairs, env, state)
      switch r
        case Ok(pair) then
          let (v, typedPairs) = pair
          let typedKind = ast2.ExprKind.MapLitExpr(typedPairs)
          let result = InferResult {
            Type: v.Type,
            Predicates: v.Predicates,
            Subst: v.Subst,
            State: v.State,
          }
          Ok(ExprInferResult {
            Expr: ast2.Expr {
              ID: expr.ID,
              Pos: expr.Pos,
              Kind: typedKind,
              Type: Some(v.Type),
            },
            Result: result,
          })
        end
        case Err(m) => Err(m)
      end
    end
    case SetLitExpr(items) then
      let r = inferSetLit(items, env, state)
      switch r
        case Ok(pair) then
          let (v, typedItems) = pair
          let typedKind = ast2.ExprKind.SetLitExpr(typedItems)
          let result = InferResult {
            Type: v.Type,
            Predicates: v.Predicates,
            Subst: v.Subst,
            State: v.State,
          }
          Ok(ExprInferResult {
            Expr: ast2.Expr {
              ID: expr.ID,
              Pos: expr.Pos,
              Kind: typedKind,
              Type: Some(v.Type),
            },
            Result: result,
          })
        end
        case Err(m) => Err(m)
      end
    end
    case InlineGoExpr(typ, _, _, _) then
      # An inline Go block declares its native Go result shape (for example
      # `go[((), error)]`).  Like a Go FFI signature, a 2-tuple result follows
      # the boundary convention: (T, error) -> Result[T, error] and
      # (T, bool) -> Option[T].  The raw tuple shape remains available through
      # tuple destructuring (ffiRawTupleResultType).
      let mono = inlineGoResultMono(typeFromASTInEnv(typ.value(), env, state))
      Ok(mkTyped(expr, mono, state, None))
    end
  end
end

# Numeric suffixes are part of the source literal, not merely code-generation
# decoration.  Preserve their type through inference so an annotated binding
# such as `let value: Int8 = 42i8` unifies as expected.
func numberLiteralType(value: String) -> ast2.MonoType
  let lower = strings.ToLower(value)
  let name = if strings.HasSuffix(lower, "i8") then
    "Int8"
  elsif strings.HasSuffix(lower, "i16") then
    "Int16"
  elsif strings.HasSuffix(lower, "i32") then
    "Int32"
  elsif strings.HasSuffix(lower, "i64") then
    "Int64"
  elsif strings.HasSuffix(lower, "u8") then
    "UInt8"
  elsif strings.HasSuffix(lower, "u16") then
    "UInt16"
  elsif strings.HasSuffix(lower, "u32") then
    "UInt32"
  elsif strings.HasSuffix(lower, "u64") then
    "UInt64"
  elsif strings.HasSuffix(lower, "u") then
    "UInt"
  elsif strings.HasSuffix(lower, "f32") then
    "Float32"
  elsif strings.HasSuffix(lower, "f64") then
    "Float64"
  elsif strings.Contains(value, ".") then
    "Float64"
  else
    "Int"
  end
  ast2.MonoType.TCon(name)
end

func inferFuncLit(params: Slice[ast2.Param], ret: Option[ast2.TypeExpr], body: ast2.Expr, env: Env, state: InferState) -> Result[ExprInferResult, String]
  switch paramsToTypesInEnv(params, env, state)
    case None => Err("malformed function literal: missing parameter index")
    case Some(paramTypes) => inferFuncLitWithParamTypes(params, ret, body, env, state, paramTypes)
  end
end

func inferFuncLitWithParamTypes(params: Slice[ast2.Param], ret: Option[ast2.TypeExpr], body: ast2.Expr, env: Env, state: InferState, paramTypes: Slice[ast2.MonoType]) -> Result[ExprInferResult, String]
  let retType = switch ret
    case Some(t) => typeFromASTInEnv(t, env, state)
    case None => ast2.MonoType.TUnit
  end
  # Build the body environment from the SAME resolved param types used for the
  # function's signature.  Using envWithParams (which calls typeFromAST) would
  # mis-resolve references to outer type parameters (e.g. `A` inside a generic
  # function) as bare `TCon("A")` constructors, diverging from `paramTypes`
  # (which resolves them to the outer `TVar(-1)`) and producing an internally
  # inconsistent function type.
  switch envWithParamsAndTypes(env, params, paramTypes)
    case None => Err("malformed function literal: missing parameter binding index")
    case Some(bodyEnv) => inferFuncLitBody(params, retType, body, bodyEnv, state, paramTypes)
  end
end

func inferFuncLitBody(params: Slice[ast2.Param], retType: ast2.MonoType, body: ast2.Expr, bodyEnv: Env, state: InferState, paramTypes: Slice[ast2.MonoType]) -> Result[ExprInferResult, String]
  let inferred = inferExpr(body, bodyEnv, state)
  switch inferred
    case Err(msg) => Err("function literal: " + msg)
    case Ok(eir) then
      let r = eir.Result
      let bodyApplied = applySubst(r.Subst, r.Type)
      let checked = unify(bodyApplied, retType, r.Subst)
      switch checked
        case Err(msg) => Err("function literal return type mismatch: " + msg)
        case Ok(subst) then
          let ftyp = ast2.MonoType.TFunc(paramTypes, Ref.new(applySubst(subst, retType)))
          let typedBody = applyTypedExprSubst(subst, eir.Expr)
          Ok(ExprInferResult {
            Expr: typedBody,
            Result: InferResult {
              Type: ftyp,
              Predicates: r.Predicates,
              Subst: subst,
              State: r.State,
            },
          })
        end
      end
    end
  end
end

func inferGenericStructLit(typeName: String, typeArgs: Slice[ast2.TypeExpr], fields: Slice[ast2.StructLitField], env: Env, state: InferState) -> Result[InferResult, String]
  let checked = inferStructLit(typeName, fields, env, state)
  switch checked
    case Err(msg) => Err(msg)
    case Ok(value) then
      let resultType = tCon(typeName, typeArgsFromASTInEnv(typeArgs, env, state))
      Ok(InferResult {
        Type: resultType,
        Predicates: value.Predicates,
        Subst: value.Subst,
        State: value.State,
      })
    end
  end
end

func inferTypeAs(value: ast2.Expr, typ: ast2.TypeExpr, env: Env, state: InferState) -> Result[(InferResult, ast2.Expr), String]
  let inferred = inferExpr(value, env, state)
  let expected = typeFromASTInEnv(typ, env, state)
  switch inferred
    case Err(msg) => Err(msg)
    case Ok(eir) then
      let v = eir.Result
      let matched = unify(v.Type, expected, v.Subst)
      switch matched
        case Ok(s) then
          Ok((
            InferResult {
              Type: applySubst(s, expected),
              Predicates: v.Predicates,
              Subst: s,
              State: v.State,
            },
            applyTypedExprSubst(s, eir.Expr)
          ))
        end
        case Err(_) then
          Ok((
            InferResult {
              Type: expected,
              Predicates: v.Predicates,
              Subst: v.Subst,
              State: v.State,
            },
            applyTypedExprSubst(v.Subst, eir.Expr)
          ))
        end
      end
    end
  end
end

func inferSlice(items: Slice[ast2.Expr], env: Env, state: InferState) -> Result[(InferResult, Slice[ast2.Expr]), String]
  if items.Len() == 0 then
    let element = ast2.MonoType.TVar(state.FreshVarID)
    let empty: Slice[ast2.Expr] = []
    Ok((
      InferResult {
        Type: ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Slice")), [element]),
        Predicates: [],
        Subst: emptySubst(),
        State: withFreshID(state, state.FreshVarID + 1),
      },
      empty
    ))
  else
    switch items.Get(0)
      case None => Err("malformed slice literal: missing first element")
      case Some(item) then
        let first = inferExpr(item, env, state)
        switch first
          case Err(msg) => Err(msg)
          case Ok(eir) then
            inferSliceItems(
              common2.SliceDrop(items, 1),
              eir.Result.Type,
              env,
              eir.Result.State,
              eir.Result.Subst,
              [eir.Expr]
            )
          end
        end
      end
    end
  end
end

func inferSliceItems(items: Slice[ast2.Expr], element: ast2.MonoType, env: Env, state: InferState, subst: Subst, typed: Slice[ast2.Expr]) -> Result[(InferResult, Slice[ast2.Expr]), String]
  if items.Len() == 0 then
    switch applyTypedExprsSubst(subst, typed)
      case None => Err("malformed slice literal: missing typed element")
      case Some(typedItems) then
        Ok((
          InferResult {
            Type: ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Slice")), [applySubst(subst, element)]),
            Predicates: [],
            Subst: subst,
            State: state,
          },
          typedItems
        ))
      end
    end
  else
    switch items.Get(0)
      case None => Err("malformed slice literal: missing element")
      case Some(item) then
        let next = inferExpr(item, env, state)
        switch next
          case Err(msg) => Err(msg)
          case Ok(eir) then
            let value = eir.Result
            let combined = unify(
              applySubst(value.Subst, element),
              applySubst(value.Subst, value.Type),
              composeSubst(value.Subst, subst)
            )
            switch combined
              case Err(msg) => Err("slice element type mismatch: " + msg)
              case Ok(s) then
                inferSliceItems(common2.SliceDrop(items, 1), element, env, value.State, s, typed.Append(eir.Expr))
              end
            end
          end
        end
      end
    end
  end
end

func inferSwitch(target: ast2.Expr, cases: Slice[ast2.SwitchCase], env: Env, state: InferState) -> Result[ExprInferResult, String]
  let matched = inferExpr(target, env, state)
  switch matched
    case Err(msg) => Err(msg)
    case Ok(eir) then
      let value = eir.Result
      # Pattern bindings must start from the target after its inference
      # substitutions.  Otherwise `Some(e)` receives a fresh type variable
      # instead of `ParseError`, and selectors such as `e.Expected` lose their
      # Expr.Type before code generation.
      let inferredTarget = applySubst(value.Subst, value.Type)
      let (targetSubst, targetState) = inferBuiltinSwitchTarget(cases, inferredTarget, value.State)
      let resolvedTarget = applySubst(targetSubst, inferredTarget)
      # The switch target is consumed by codegen after this inference scope
      # has gone away. Persist its fully substituted type directly on the
      # target node; relying on an outer expression copy can otherwise lose
      # the annotation for a local binding inside nested function literals.
      let typedTarget = ast2.Expr {
        ID: eir.Expr.ID,
        Pos: eir.Expr.Pos,
        Kind: eir.Expr.Kind,
        Type: Some(resolvedTarget),
      }
      let next = inferTypedSwitchCases(
        cases,
        resolvedTarget,
        env,
        targetState,
        composeSubst(targetSubst, value.Subst),
        None,
        None,
        value.Predicates,
        []
      )
      switch next
        case Err(msg) => Err(msg)
        case Ok(pair) then
          let (r, typedCases) = pair
          let typedExpr = ast2.Expr {
            ID: 0,
            Pos: typedTarget.Pos,
            Kind: ast2.ExprKind.SwitchExpr(typedTarget, typedCases, Some(resolvedTarget)),
            Type: Some(r.Type),
          }
          Ok(ExprInferResult { Expr: typedExpr, Result: r })
        end
      end
    end
  end
end

func inferBuiltinSwitchTarget(cases: Slice[ast2.SwitchCase], targetType: ast2.MonoType, state: InferState) -> (Subst, InferState)
  if cases.Len() == 0 then
    (emptySubst(), state)
  else
    let pattern = switch cases.Get(0)
      case Some(current) => current.Pattern
      case None => ast2.Pattern.WildcardPattern
    end
    let variantName = switch pattern
      case VariantPattern(name, _) => name
      case BindPattern(name) => name
      case _ => ""
    end
    if !isBuiltinVariantName(variantName) || enumNameForMonoType(targetType).IsSome() then
      (emptySubst(), state)
    else
      switch envGet(initialEnv(), variantName)
        case Some(scheme) then
          let variantType = instantiate(scheme, state)
          let resultType = variantConstructorResultType(variantType)
          switch unify(targetType, resultType, emptySubst())
            case Ok(subst) then
              (subst, withFreshID(state, nextFreshVarID(variantType, state.FreshVarID)))
            end
            case Err(_) => (emptySubst(), state)
          end
        end
        case None => (emptySubst(), state)
      end
    end
  end
end

func variantConstructorResultType(typ: ast2.MonoType) -> ast2.MonoType
  switch typ
    case TFunc(_, ret) => ret.value()
    case _ => typ
  end
end

# Preserve the inferred case bodies in the typed AST.  In particular this
# carries DictionaryCallExpr annotations out of nested matches to codegen2.
func inferTypedSwitchCases(cases: Slice[ast2.SwitchCase], targetType: ast2.MonoType, env: Env, state: InferState, subst: Subst, resultType: Option[ast2.MonoType], resultOrigin: Option[ast2.SourcePos], predicates: Slice[Predicate], out: Slice[ast2.SwitchCase]) -> Result[(InferResult, Slice[ast2.SwitchCase]), String]
  if out.Len() == 0 then
    switch checkSwitchExhaustive(targetType, cases, state)
      case Err(msg) => Err(msg)
      case Ok(_) then
        inferTypedSwitchCasesChecked(cases, targetType, env, state, subst, resultType, resultOrigin, predicates, out)
      end
    end
  else
    inferTypedSwitchCasesChecked(cases, targetType, env, state, subst, resultType, resultOrigin, predicates, out)
  end
end

func inferTypedSwitchCasesChecked(cases: Slice[ast2.SwitchCase], targetType: ast2.MonoType, env: Env, state: InferState, subst: Subst, resultType: Option[ast2.MonoType], resultOrigin: Option[ast2.SourcePos], predicates: Slice[Predicate], out: Slice[ast2.SwitchCase]) -> Result[(InferResult, Slice[ast2.SwitchCase]), String]
  if cases.Len() == 0 then
    switch resultType
      case Some(t) then
        switch applyTypedSwitchCasesSubst(subst, out)
          case None => Err("malformed switch expression: missing typed case")
          case Some(typedCases) then
            Ok((
              InferResult {
                Type: applySubst(subst, t),
                Predicates: predicates,
                Subst: subst,
                State: state,
              },
              typedCases
            ))
          end
        end
      end
      case None => Err("switch requires at least one case")
    end
  else
    switch cases.Get(0)
      case None => Err("malformed switch expression: missing case")
      case Some(current) then
        inferTypedSwitchCase(current, cases, targetType, env, state, subst, resultType, resultOrigin, predicates, out)
      end
    end
  end
end

func inferTypedSwitchCase(current: ast2.SwitchCase, cases: Slice[ast2.SwitchCase], targetType: ast2.MonoType, env: Env, state: InferState, subst: Subst, resultType: Option[ast2.MonoType], resultOrigin: Option[ast2.SourcePos], predicates: Slice[Predicate], out: Slice[ast2.SwitchCase]) -> Result[(InferResult, Slice[ast2.SwitchCase]), String]
  let pattern = resolveBareVariantPattern(env, state, targetType, current.Pattern)
  # Bind call scrutinees to locals: the codegen re-evaluates a switch
  # scrutinee per pattern arm, so switching directly on a call such as
  # `inferExpr(current.Body, ...)` would re-infer the nested case body
  # (exponentially for deeply nested switches).
  let caseEnvResult = envWithPattern(env, pattern, targetType, state)
  switch caseEnvResult
    case Err(msg) => Err(msg)
    case Ok(caseEnv) then
      let bodyInferred = inferExpr(current.Body, caseEnv, state)
      switch bodyInferred
        case Err(msg) => Err(msg)
        case Ok(eir) then
          let value = eir.Result
          let typedOut = out.Append(ast2.SwitchCase {
            Pattern: pattern,
            PatternSpan: current.PatternSpan,
            Body: eir.Expr,
            BodySpan: current.BodySpan,
            Span: current.Span,
          })
          switch resultType
            case None then
              inferTypedSwitchCases(
                common2.SliceDrop(cases, 1),
                targetType,
                env,
                value.State,
                composeSubst(value.Subst, subst),
                Some(value.Type),
                Some(current.Body.Pos),
                appendPredicates(predicates, value.Predicates),
                typedOut
              )
            end
            case Some(previous) then
              let nextSubst = unifySwitchCaseTypes(
                env,
                current.Body,
                applySubst(value.Subst, previous),
                applySubst(value.Subst, value.Type),
                composeSubst(value.Subst, subst)
              )
              switch nextSubst
                case Err(msg) then
                  Err(switchCaseMismatchLocation(resultOrigin, current.Body.Pos) + ": " + msg)
                end
                case Ok(s) then
                  inferTypedSwitchCases(
                    common2.SliceDrop(cases, 1),
                    targetType,
                    env,
                    value.State,
                    s,
                    Some(applySubst(s, previous)),
                    resultOrigin,
                    appendPredicates(predicates, value.Predicates),
                    typedOut
                  )
                end
              end
            end
          end
        end
      end
    end
  end
end

# checkSwitchExhaustive validates enum coverage before switch case bodies are
# lowered.  Bindings and wildcards intentionally escape checking; tuple
# patterns recurse into each element so an enum nested in a tuple is checked
# at its own position.
func checkSwitchExhaustive(targetType: ast2.MonoType, cases: Slice[ast2.SwitchCase], state: InferState) -> Result[(), String]
  checkSwitchExhaustivePatterns(targetType, switchCasePatterns(cases), state)
end

func switchCasePatterns(cases: Slice[ast2.SwitchCase]) -> Slice[ast2.Pattern]
  if cases.Len() == 0 then
    []
  else
    switch cases.Get(0)
      case Some(c) => switchCasePatterns(common2.SliceDrop(cases, 1)).Prepend(c.Pattern)
      case None => switchCasePatterns(common2.SliceDrop(cases, 1))
    end
  end
end

func checkSwitchExhaustivePatterns(targetType: ast2.MonoType, patterns: Slice[ast2.Pattern], state: InferState) -> Result[(), String]
  switch patternsHaveWildcard(patterns)
    case None => Err("malformed switch pattern list")
    case Some(hasWildcard) then
      if hasWildcard then
        Ok(())
      else
        switch targetType
          case TQualifiedName(_, inner) then
            checkSwitchExhaustivePatterns(inner.value(), patterns, state)
          end
          case TTuple(types) => checkSwitchExhaustiveTuple(types, patterns, state)
          case _ then
            switch enumNameForMonoType(targetType)
              case None => Ok(())
              case Some(enumName) then
                checkSwitchExhaustiveEnum(enumName, targetType, patterns, state)
              end
            end
          end
        end
      end
    end
  end
end

func patternsHaveWildcard(patterns: Slice[ast2.Pattern]) -> Option[Bool]
  if patterns.Len() == 0 then
    Some(false)
  else
    switch patterns.Get(0)
      case None => None
      case Some(p) then
        switch p
          case WildcardPattern => Some(true)
          case BindPattern(name) => Some(name == "_")
          case TuplePattern(items) then
            switch patternsHaveWildcard(items)
              case None => None
              case Some(nestedHasWildcard) then
                if nestedHasWildcard then
                  Some(true)
                else
                  patternsHaveWildcard(common2.SliceDrop(patterns, 1))
                end
              end
            end
          end
          case _ => patternsHaveWildcard(common2.SliceDrop(patterns, 1))
        end
      end
    end
  end
end

func checkSwitchExhaustiveTuple(types: Slice[ast2.MonoType], patterns: Slice[ast2.Pattern], state: InferState) -> Result[(), String]
  if patterns.Len() == 0 then
    Ok(())
  else
    switch patterns.Get(0)
      case None => Err("malformed tuple switch pattern")
      case Some(first) then
        switch first
          case WildcardPattern => Ok(())
          case BindPattern(_) => Ok(())
          case TuplePattern(items) then
            if items.Len() != types.Len() then
              Ok(())
            else
              checkSwitchExhaustiveTupleElements(types, patterns, 0, state)
            end
          end
          case _ => Ok(())
        end
      end
    end
  end
end

func checkSwitchExhaustiveTupleElements(types: Slice[ast2.MonoType], patterns: Slice[ast2.Pattern], index: Int, state: InferState) -> Result[(), String]
  if index >= types.Len() then
    Ok(())
  else
    switch tuplePatternsAt(patterns, index, [])
      case None => Err("malformed nested tuple pattern")
      case Some(nested) then
        switch types.Get(index)
          case None => Err("malformed tuple switch type")
          case Some(elementType) then
            switch checkSwitchExhaustivePatterns(elementType, nested, state)
              case Err(msg) => Err(msg)
              case Ok(_) => checkSwitchExhaustiveTupleElements(types, patterns, index + 1, state)
            end
          end
        end
      end
    end
  end
end

func tuplePatternsAt(patterns: Slice[ast2.Pattern], index: Int, out: Slice[ast2.Pattern]) -> Option[Slice[ast2.Pattern]]
  if patterns.Len() == 0 then
    Some(out)
  else
    switch patterns.Get(0)
      case None => None
      case Some(p) then
        switch p
          case TuplePattern(items) then
            switch items.Get(index)
              case None => None
              case Some(item) then
                tuplePatternsAt(common2.SliceDrop(patterns, 1), index, out.Append(item))
              end
            end
          end
          case _ then
            tuplePatternsAt(common2.SliceDrop(patterns, 1), index, out.Append(ast2.Pattern.WildcardPattern))
          end
        end
      end
    end
  end
end

func checkSwitchExhaustiveEnum(enumName: String, targetType: ast2.MonoType, patterns: Slice[ast2.Pattern], state: InferState) -> Result[(), String]
  switch enumVariantNamesForTarget(state, targetType, enumName, [])
    case Err(msg) => Err(msg)
    case Ok(variants) then
      if variants.Len() == 0 then
        Ok(())
      else
        switch enumPatternsCoverage(variants, targetType, patterns, state, [])
          case Err(msg) => Err(msg)
          case Ok(coverage) then
            switch coverage
              case Some(missing) then
                Err("non-exhaustive switch: missing variant(s) " + common2.JoinStrings(missing, ", "))
              end
              case None => Ok(())
            end
          end
        end
      end
    end
  end
end

func enumPatternsCoverage(variants: Slice[String], targetType: ast2.MonoType, patterns: Slice[ast2.Pattern], state: InferState, covered: Slice[String]) -> Result[Option[Slice[String]], String]
  if patterns.Len() == 0 then
    switch missingVariantNames(variants, covered, [])
      case None => Err("malformed enum variant list")
      case Some(missing) then
        if missing.Len() == 0 then
          Ok(None)
        else
          Ok(Some(missing))
        end
      end
    end
  else
    switch patterns.Get(0)
      case None => Err("malformed enum switch pattern list")
      case Some(p) then
        switch p
          case WildcardPattern => Ok(None)
          case BindPattern(name) then
            switch lookupEnumVariantForTarget(state, targetType, name)
              case Some(v) then
                if v.Fields.Len() == 0 then
                  enumPatternsCoverage(
                    variants,
                    targetType,
                    common2.SliceDrop(patterns, 1),
                    state,
                    covered.Append(name)
                  )
                else
                  Ok(None)
                end
              end
              case None => Ok(None)
            end
          end
          case VariantPattern(name, _) then
            enumPatternsCoverage(variants, targetType, common2.SliceDrop(patterns, 1), state, covered.Append(name))
          end
          case StructVariantPattern(name, _) then
            enumPatternsCoverage(variants, targetType, common2.SliceDrop(patterns, 1), state, covered.Append(name))
          end
          case _ then
            enumPatternsCoverage(variants, targetType, common2.SliceDrop(patterns, 1), state, covered)
          end
        end
      end
    end
  end
end

func enumVariantNames(state: InferState, enumName: String, out: Slice[String]) -> Result[Slice[String], String]
  switch state.PkgInfo
    case None => Ok(out)
    case Some(info) => enumVariantNamesInDecls(info.Decls, enumName, out)
  end
end

func enumVariantNamesForTarget(state: InferState, targetType: ast2.MonoType, enumName: String, out: Slice[String]) -> Result[Slice[String], String]
  switch monoTypeQualifiedPath(targetType)
    case Some(path) => enumVariantNamesInPackagesByPath(state.MyGoPackageCache, path, enumName, out)
    case None => enumVariantNames(state, enumName, out)
  end
end

func enumVariantNamesInPackagesByPath(packages: Slice[MyGoPackageInfo], path: String, enumName: String, out: Slice[String]) -> Result[Slice[String], String]
  if packages.Len() == 0 then
    Ok(out)
  else
    switch packages.Get(0)
      case None => Err("malformed imported package list")
      case Some(pkg) then
        if pkg.Path == path then
          enumVariantNamesInDecls(pkg.Decls, enumName, out)
        else
          enumVariantNamesInPackagesByPath(common2.SliceDrop(packages, 1), path, enumName, out)
        end
      end
    end
  end
end

func enumVariantNamesInDecls(decls: Slice[ast2.Decl], enumName: String, out: Slice[String]) -> Result[Slice[String], String]
  if decls.Len() == 0 then
    Ok(out)
  else
    switch decls.Get(0)
      case None => Err("malformed enum declaration list")
      case Some(d) then
        switch d
          case EnumDecl(name, _, variants) then
            if name == enumName then
              enumVariantNamesInVariants(variants, out)
            else
              enumVariantNamesInDecls(common2.SliceDrop(decls, 1), enumName, out)
            end
          end
          case _ => enumVariantNamesInDecls(common2.SliceDrop(decls, 1), enumName, out)
        end
      end
    end
  end
end

func enumVariantNamesInVariants(variants: Slice[ast2.Variant], out: Slice[String]) -> Result[Slice[String], String]
  if variants.Len() == 0 then
    Ok(out)
  else
    switch variants.Get(0)
      case None => Err("malformed enum variant list")
      case Some(v) => enumVariantNamesInVariants(common2.SliceDrop(variants, 1), out.Append(v.Name))
    end
  end
end

func missingVariantNames(variants: Slice[String], covered: Slice[String], out: Slice[String]) -> Option[Slice[String]]
  if variants.Len() == 0 then
    Some(out)
  else
    switch variants.Get(0)
      case None => None
      case Some(name) then
        let next = if stringSliceContains(covered, name) => out else out.Append(name)
        missingVariantNames(common2.SliceDrop(variants, 1), covered, next)
      end
    end
  end
end

func inferSwitchCases(cases: Slice[ast2.SwitchCase], targetType: ast2.MonoType, env: Env, state: InferState, subst: Subst, resultType: Option[ast2.MonoType], predicates: Slice[Predicate]) -> Result[InferResult, String]
  if cases.Len() == 0 then
    switch resultType
      case Some(t) then
        Ok(InferResult {
          Type: applySubst(subst, t),
          Predicates: predicates,
          Subst: subst,
          State: state,
        })
      end
      case None => Err("switch requires at least one case")
    end
  else
    switch cases.Get(0)
      case None => Err("malformed switch expression: missing case")
      case Some(current) then
        let caseEnv = envWithPattern(env, resolveBareVariantPattern(env, state, targetType, current.Pattern), targetType, state)
        switch caseEnv
          case Err(msg) => Err(msg)
          case Ok(nextEnv) then
            let body = inferExpr(current.Body, nextEnv, state)
            switch body
              case Err(msg) => Err(msg)
              case Ok(eir) then
                let value = eir.Result
                switch resultType
                  case None then
                    inferSwitchCases(
                      common2.SliceDrop(cases, 1),
                      targetType,
                      env,
                      value.State,
                      composeSubst(value.Subst, subst),
                      Some(value.Type),
                      appendPredicates(predicates, value.Predicates)
                    )
                  end
                  case Some(previous) then
                    let nextSubst = unifySwitchCaseTypes(
                      env,
                      current.Body,
                      applySubst(value.Subst, previous),
                      applySubst(value.Subst, value.Type),
                      composeSubst(value.Subst, subst)
                    )
                    switch nextSubst
                      case Err(msg) then
                        Err("switch case type mismatch in " + current.Body.Pos.SourceName + ": " + msg)
                      end
                      case Ok(s) then
                        inferSwitchCases(
                          common2.SliceDrop(cases, 1),
                          targetType,
                          env,
                          value.State,
                          s,
                          Some(applySubst(s, previous)),
                          appendPredicates(predicates, value.Predicates)
                        )
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

# Parser2 deliberately preserves a bare identifier as BindPattern.  A
# zero-field enum constructor is also written as a bare identifier, so resolve
# that ambiguity from the switch target enum declaration.
func resolveBareVariantPattern(env: Env, state: InferState, targetType: ast2.MonoType, pattern: ast2.Pattern) -> ast2.Pattern
  switch pattern
    case BindPattern(name) then
      switch variantConstructorTypeForTarget(env, state, name, targetType)
        case Some(variantType) then
          switch variantType
            case TFunc(_, _) => pattern
            case _ => ast2.Pattern.VariantPattern(name, [])
          end
        end
        case None => pattern
      end
    end
    case _ => pattern
  end
end

# Zero-field constructors such as `None` are polymorphic.  Their inferred
# type may retain the enum declaration's parameter instead of the surrounding
# result type; when used as a complete case body, the prior case provides that
# result context.  Keep the established result type after confirming the name
# is an enum constructor, while ordinary branch type mismatches still fail.
func unifySwitchCaseTypes(env: Env, body: ast2.Expr, previous: ast2.MonoType, current: ast2.MonoType, subst: Subst) -> Result[Subst, String]
  # When the case body infers a TQualifiedName (foreign package) but the
  # previous result type was an inner TCon, retry the unification with
  # the inner type.  This keeps the unified switch result as the inner
  # TCon — the qualifier is restored by inferSwitch.
  switch unify(previous, current, subst)
    case Ok(next) => Ok(next)
    case Err(primaryMsg) then
      switch current
        case TQualifiedName(_, inner) then
          switch unify(previous, applySubst(subst, inner.value()), subst)
            case Ok(next) => Ok(next)
            case Err(fallbackMsg) then
              if isBareZeroFieldVariant(env, body) then
                Ok(subst)
              else
                switchCaseTypeMismatch(primaryMsg, fallbackMsg, previous, current)
              end
            end
          end
        end
        case _ then
          if isBareZeroFieldVariant(env, body) then
            Ok(subst)
          else
            switchCaseTypeMismatch(primaryMsg, primaryMsg, previous, current)
          end
        end
      end
    end
  end
end

# Keep the original unification error and both resolved branch types.  This is
# especially important for tuple-valued switch branches, where a mismatch in
# one tuple element was previously reduced to the unhelpful generic message.
func switchCaseTypeMismatch(primaryMsg: String, fallbackMsg: String, previous: ast2.MonoType, current: ast2.MonoType) -> Result[Subst, String]
  let reason = if fallbackMsg == primaryMsg => primaryMsg else primaryMsg + "; fallback: " + fallbackMsg
  Err("switch case type mismatch: " + reason + " [previous=" + MonoStringFull(previous) + " current=" + MonoStringFull(current) + "]")
end

func switchCaseMismatchLocation(previous: Option[ast2.SourcePos], current: ast2.SourcePos) -> String
  let currentText = current.SourceName + ":" + current.Line.ToString() + ":" + current.Column.ToString()
  switch previous
    case Some(pos) then
      "switch case mismatch [first=" + pos.SourceName + ":" + pos.Line.ToString() + ":" + pos.Column.ToString() + " current=" + currentText + "]"
    end
    case None => "switch case mismatch [current=" + currentText + "]"
  end
end

func isBareZeroFieldVariant(env: Env, expr: ast2.Expr) -> Bool
  switch expr.Kind
    case IdentExpr(name) then
      switch envGet(env, name)
        case Some(scheme) then
          switch scheme.Body
            case TCon(enumName) => enumName != name
            case TApp(typeRef, _) then
              switch typeRef.value()
                case TCon(enumName) => enumName != name
                case _ => false
              end
            end
            case _ => false
          end
        end
        case None => false
      end
    end
    case _ => false
  end
end

func envWithPattern(env: Env, pattern: ast2.Pattern, targetType: ast2.MonoType, state: InferState) -> Result[Env, String]
  envWithPatternTarget(env, pattern, targetType, targetType, state)
end

func envWithPatternTarget(env: Env, pattern: ast2.Pattern, targetType: ast2.MonoType, variantTargetType: ast2.MonoType, state: InferState) -> Result[Env, String]
  # TQualifiedName wraps a foreign-package type.  Unwrap the inner type
  # for pattern matching; the bindings the pattern introduces use the
  # original wrapper as their body so any qualified access from the case
  # body is preserved.
  switch targetType
    case TQualifiedName(path, inner) then
      # A variable pattern is the point at which a matched value enters the
      # lexical environment.  Do not unwrap it here: doing so made
      # `Some(item)` bind `item` as bare `TypeExpr` even when the Option
      # element was `ast2.TypeExpr`.  The qualifier is nominal identity, not
      # display metadata, so retain it from the initial binding.
      switch pattern
        case BindPattern(name) then
          Ok(envPut(
            env,
            name,
            Scheme {
              Bound: [],
              Predicates: [],
              Body: targetType,
            }
          ))
        end
        case WildcardPattern => Ok(env)
        case _ then
          let innerType = inner.value()
          let next = envWithPatternTarget(env, pattern, innerType, variantTargetType, state)
          switch next
            case Ok(env2) => wrapPatternBinds(env2, path, innerType)
            case Err(msg) => Err(msg)
          end
        end
      end
    end
    case _ then
      switch pattern
        case BindPattern(name) then
          Ok(envPut(
            env,
            name,
            Scheme {
              Bound: [],
              Predicates: [],
              Body: targetType,
            }
          ))
        end
        case WildcardPattern => Ok(env)
        case TuplePattern(items) then
          switch targetType
            case TTuple(types) => envWithTuplePattern(env, items, types, state)
            case _ => Err("tuple pattern requires tuple target")
          end
        end
        case LiteralPattern(kind, _) then
          let expected = if kind == "string" then
            ast2.MonoType.TCon("String")
          elsif kind == "rune" then
            ast2.MonoType.TCon("Rune")
          else
            ast2.MonoType.TCon("Int")
          end
          switch unify(targetType, expected, emptySubst())
            case Ok(_) => Ok(env)
            case Err(msg) => Err("pattern does not match switch target: " + msg)
          end
        end
        case VariantPattern(name, args) then
          switch variantConstructorTypeForTarget(env, state, name, variantTargetType)
            case None then
              Err("unknown variant " + name + " for switch target " + MonoStringFull(variantTargetType) + " from package " + monoTypeQualifiedPathString(variantTargetType))
            end
            case Some(variantType) then
              switch variantType
                case TFunc(fields, ret) then
                  envWithPatternBindings(env, args, fields, variantTargetType, ret.value(), state)
                end
                case TCon(_) then
                  switch unify(targetType, variantType, emptySubst())
                    case Ok(_) => Ok(env)
                    case Err(msg) => Err("pattern does not match switch target: " + msg)
                  end
                end
                case TApp(_, _) then
                  # A zero-field variant is registered as the bare enum type
                  # (TApp(TCon(name), [type params])).  Treat it like a TCon
                  # so case None / case Empty matches without arguments, and
                  # surface a real error only when the pattern tries to bind
                  # arguments on a parameterless variant.
                  if args.Len() == 0 then
                    switch unify(targetType, variantType, emptySubst())
                      case Ok(_) => Ok(env)
                      case Err(msg) => Err("pattern does not match switch target: " + msg)
                    end
                  else
                    Err("variant " + name + " does not accept pattern arguments")
                  end
                end
                # Imported zero-field variants are registered with a
                # TQualifiedName wrapper (TQualifiedName(path, TCon(enum))).
                # Treat it like the bare enum type so `case UnitExpr` on an
                # imported ast2.ExprKind matches without arguments.
                case TQualifiedName(_, inner) then
                  if args.Len() == 0 then
                    switch unify(targetType, variantType, emptySubst())
                      case Ok(_) => Ok(env)
                      case Err(msg) then
                        switch unify(targetType, inner.value(), emptySubst())
                          case Ok(_) => Ok(env)
                          case Err(_) => Err("pattern does not match switch target: " + msg)
                        end
                      end
                    end
                  else
                    Err("variant " + name + " does not accept pattern arguments")
                  end
                end
                case _ => Err("pattern " + name + " is not an enum variant")
              end
            end
          end
        end
        case StructVariantPattern(vname, fields) then
          switch variantConstructorTypeForTarget(env, state, vname, variantTargetType)
            case None => Err("unknown variant " + vname)
            case Some(variantType) then
              switch variantType
                case TFunc(fieldTypes, ret) then
                  switch lookupEnumVariantForTarget(state, variantTargetType, vname)
                    case Some(variant) then
                      bindNamedStructPatternFields(
                        env,
                        fields,
                        variant.Names,
                        fieldTypes,
                        [],
                        []
                      )
                    end
                    case None => Err("cannot resolve named fields for variant " + vname)
                  end
                end
                case _ then
                  if fields.Len() == 0 then
                    Ok(env)
                  else
                    Err("variant " + vname + " does not accept struct pattern fields")
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

func bindNamedStructPatternFields(env: Env, fields: Slice[ast2.StructPatternField], names: Slice[String], fieldTypes: Slice[ast2.MonoType], seenFields: Slice[String], seenBinds: Slice[String]) -> Result[Env, String]
  if fields.Len() == 0 then
    Ok(env)
  else
    switch fields.Get(0)
      case None => Err("malformed struct variant pattern")
      case Some(f) then
        bindNamedStructPatternField(env, f, common2.SliceDrop(fields, 1), names, fieldTypes, seenFields, seenBinds)
      end
    end
  end
end

func bindNamedStructPatternField(env: Env, field: ast2.StructPatternField, rest: Slice[ast2.StructPatternField], names: Slice[String], fieldTypes: Slice[ast2.MonoType], seenFields: Slice[String], seenBinds: Slice[String]) -> Result[Env, String]
  if field.Field == "_" || field.Bind == "_" then
    bindNamedStructPatternFields(env, rest, names, fieldTypes, seenFields, seenBinds)
  elsif stringSliceContains(seenFields, field.Field) then
    Err("variant pattern field " + field.Field + " specified more than once")
  elsif stringSliceContains(seenBinds, field.Bind) then
    Err("pattern binds " + field.Bind + " more than once")
  else
    switch stringIndexOf(names, field.Field)
      case None => Err("variant has no field " + field.Field)
      case Some(index) then
        bindNamedStructPatternFieldType(env, field, rest, names, fieldTypes, seenFields, seenBinds, index)
      end
    end
  end
end

func bindNamedStructPatternFieldType(env: Env, field: ast2.StructPatternField, rest: Slice[ast2.StructPatternField], names: Slice[String], fieldTypes: Slice[ast2.MonoType], seenFields: Slice[String], seenBinds: Slice[String], index: Int) -> Result[Env, String]
  switch fieldTypes.Get(index)
    case None => Err("missing inferred type for variant field " + field.Field)
    case Some(fieldType) then
      bindNamedStructPatternFields(
        envPut(
          env,
          field.Bind,
          Scheme {
            Bound: [],
            Predicates: [],
            Body: fieldType,
          }
        ),
        rest,
        names,
        fieldTypes,
        seenFields.Append(field.Field),
        seenBinds.Append(field.Bind)
      )
    end
  end
end

func lookupEnumVariantForTarget(state: InferState, targetType: ast2.MonoType, variantName: String) -> Option[ast2.Variant]
  switch enumNameForMonoType(targetType)
    case Some(enumName) => lookupEnumVariantDeclForTarget(state, targetType, enumName, variantName)
    case None => None
  end
end

func lookupEnumVariantDeclForTarget(state: InferState, targetType: ast2.MonoType, enumName: String, variantName: String) -> Option[ast2.Variant]
  switch monoTypeQualifiedPath(targetType)
    case Some(path) then
      lookupEnumVariantDeclInPackagesByPath(state.MyGoPackageCache, path, enumName, variantName)
    end
    case None => lookupEnumVariantDecl(state, enumName, variantName)
  end
end

func monoTypeQualifiedPath(typ: ast2.MonoType) -> Option[String]
  switch typ
    case TQualifiedName(path, _) => Some(path)
    case TApp(ctor, _) => monoTypeQualifiedPath(ctor.value())
    case _ => None
  end
end

func monoTypeQualifiedPathString(typ: ast2.MonoType) -> String
  switch monoTypeQualifiedPath(typ)
    case Some(path) => path
    case None => ""
  end
end

func lookupEnumVariantDeclInPackagesByPath(packages: Slice[MyGoPackageInfo], path: String, enumName: String, variantName: String) -> Option[ast2.Variant]
  if packages.Len() == 0 then
    None
  else
    switch packages.Get(0)
      case None => None
      case Some(pkg) then
        if pkg.Path == path then
          lookupEnumVariantDeclInDecls(pkg.Decls, enumName, variantName)
        else
          lookupEnumVariantDeclInPackagesByPath(common2.SliceDrop(packages, 1), path, enumName, variantName)
        end
      end
    end
  end
end

func variantConstructorTypeForTarget(env: Env, state: InferState, variantName: String, targetType: ast2.MonoType) -> Option[ast2.MonoType]
  switch enumNameForMonoType(targetType)
    case Some(enumName) then
      switch lookupEnumVariantDeclForTarget(state, targetType, enumName, variantName)
        case Some(variant) then
          let typeParams = enumTypeParamsForTarget(state, targetType, enumName)
          let variantEnv = envForEnumTarget(env, state, targetType)
          let genericFields = typeArgsFromASTInEnvWithParamsList(variant.Fields, typeParams, variantEnv, state)
          switch qualifyEnumFieldsForTarget(genericFields, state.MyGoPackageCache, targetType)
            case None => None
            case Some(qualifiedFields) then
              switch enumTypeParameterSubst(typeParams, enumTypeArgsForTarget(targetType), 0, [])
                case None => None
                case Some(parameterSubst) then
                  let fields = substTypes(qualifiedFields, SubstFromEntries(parameterSubst))
                  if fields.Len() == 0 then
                    Some(targetType)
                  else
                    Some(ast2.MonoType.TFunc(fields, Ref.new(targetType)))
                  end
                end
              end
            end
          end
        end
        case None => builtinVariantTypeForTarget(env, state, enumName, variantName, targetType)
      end
    end
    case None => builtinVariantTypeForTarget(env, state, "", variantName, targetType)
  end
end

func envForEnumTarget(env: Env, state: InferState, targetType: ast2.MonoType) -> Env
  switch monoTypeQualifiedPath(targetType)
    case Some(path) then
      switch findMyGoPackageByPath(state.MyGoPackageCache, path)
        case Some(pkg) then
          switch importedPackageEnv(pkg, state.MyGoPackageCache, state.GoPackages)
            case Ok(packageEnv) => packageEnv
            case Err(_) => env
          end
        end
        case None => env
      end
    end
    case None => env
  end
end

func findMyGoPackageByPath(packages: Slice[MyGoPackageInfo], path: String) -> Option[MyGoPackageInfo]
  if packages.Len() == 0 then
    None
  else
    switch packages.Get(0)
      case None => None
      case Some(pkg) then
        if pkg.Path == path then
          Some(pkg)
        else
          findMyGoPackageByPath(common2.SliceDrop(packages, 1), path)
        end
      end
    end
  end
end

func qualifyEnumFieldsForTarget(fields: Slice[ast2.MonoType], packages: Slice[MyGoPackageInfo], targetType: ast2.MonoType) -> Option[Slice[ast2.MonoType]]
  switch monoTypeQualifiedPath(targetType)
    case Some(path) then
      wrapPkgTypesInSlice(fields, path, myGoPackageTypeNamesForPath(packages, path))
    end
    case None => Some(fields)
  end
end

func myGoPackageTypeNamesForPath(packages: Slice[MyGoPackageInfo], path: String) -> Slice[String]
  if packages.Len() == 0 then
    []
  else
    switch packages.Get(0)
      case None => myGoPackageTypeNamesForPath(common2.SliceDrop(packages, 1), path)
      case Some(pkg) then
        if pkg.Path == path then
          collectMyGoTypeNames(pkg.Decls, 0, [])
        else
          myGoPackageTypeNamesForPath(common2.SliceDrop(packages, 1), path)
        end
      end
    end
  end
end

func builtinVariantTypeForTarget(env: Env, state: InferState, enumName: String, variantName: String, targetType: ast2.MonoType) -> Option[ast2.MonoType]
  if !isBuiltinVariantForEnum(enumName, variantName) && !(enumName == "" && isBuiltinVariantName(variantName)) then
    None
  else
    switch envGet(initialEnv(), variantName)
      case Some(scheme) => builtinVariantTypeAgainstTarget(instantiate(scheme, state), targetType)
      case None => None
    end
  end
end

func isBuiltinVariantForEnum(enumName: String, variantName: String) -> Bool
  (enumName == "Option" && (variantName == "Some" || variantName == "None")) || (enumName == "Result" && (variantName == "Ok" || variantName == "Err"))
end

func isBuiltinVariantName(variantName: String) -> Bool
  variantName == "Some" || variantName == "None" || variantName == "Ok" || variantName == "Err"
end

func builtinVariantTypeAgainstTarget(variantType: ast2.MonoType, targetType: ast2.MonoType) -> Option[ast2.MonoType]
  switch variantType
    case TFunc(fields, ret) then
      switch unify(targetType, ret.value(), emptySubst())
        case Ok(subst) then
          Some(ast2.MonoType.TFunc(substTypes(fields, subst), Ref.new(applySubst(subst, ret.value()))))
        end
        case Err(_) => None
      end
    end
    case _ then
      switch unify(targetType, variantType, emptySubst())
        case Ok(subst) => Some(applySubst(subst, variantType))
        case Err(_) => None
      end
    end
  end
end

func enumTypeArgsForTarget(targetType: ast2.MonoType) -> Slice[ast2.MonoType]
  switch targetType
    case TApp(_, args) => args
    case TQualifiedName(_, inner) => enumTypeArgsForTarget(inner.value())
    case _ => []
  end
end

func enumTypeParameterSubst(typeParams: Slice[String], typeArgs: Slice[ast2.MonoType], index: Int, out: Slice[SubstEntry]) -> Option[Slice[SubstEntry]]
  if index >= typeParams.Len() && index >= typeArgs.Len() then
    Some(out)
  elsif index >= typeParams.Len() || index >= typeArgs.Len() then
    None
  else
    switch typeArgs.Get(index)
      case None => None
      case Some(arg) then
        enumTypeParameterSubst(
          typeParams,
          typeArgs,
          index + 1,
          out.Append(SubstEntry {
            ID: -(index + 1),
            Type: arg,
          })
        )
      end
    end
  end
end

func enumTypeParamsForTarget(state: InferState, targetType: ast2.MonoType, enumName: String) -> Slice[String]
  switch targetType
    case TApp(_, args) => enumTypeParamsForTargetFromArgs(state, targetType, enumName, args.Len())
    case TQualifiedName(_, inner) => enumTypeParamsForTarget(state, inner.value(), enumName)
    case _ => []
  end
end

func enumTypeParamsForTargetFromArgs(state: InferState, targetType: ast2.MonoType, enumName: String, argCount: Int) -> Slice[String]
  switch lookupEnumDeclForTarget(state, targetType, enumName)
    case Some(tps) then
      switch takeTypeParams(tps, argCount, [])
        case Some(names) => names
        case None => []
      end
    end
    case None => []
  end
end

func takeTypeParams(params: Slice[String], count: Int, out: Slice[String]) -> Option[Slice[String]]
  if count <= 0 then
    Some(out)
  elsif params.Len() == 0 then
    None
  else
    switch params.Get(0)
      case None => None
      case Some(name) => takeTypeParams(common2.SliceDrop(params, 1), count - 1, out.Append(name))
    end
  end
end

func lookupEnumDeclForTarget(state: InferState, targetType: ast2.MonoType, enumName: String) -> Option[Slice[String]]
  switch monoTypeQualifiedPath(targetType)
    case Some(path) => lookupEnumTypeParamsInPackagesByPath(state.MyGoPackageCache, path, enumName)
    case None => lookupEnumTypeParamsInDecls(state.PkgInfo, enumName)
  end
end

func lookupEnumTypeParamsInPackagesByPath(packages: Slice[MyGoPackageInfo], path: String, enumName: String) -> Option[Slice[String]]
  if packages.Len() == 0 then
    None
  else
    switch packages.Get(0)
      case None => None
      case Some(pkg) then
        if pkg.Path == path then
          lookupEnumTypeParamsInDeclList(pkg.Decls, enumName)
        else
          lookupEnumTypeParamsInPackagesByPath(common2.SliceDrop(packages, 1), path, enumName)
        end
      end
    end
  end
end

func lookupEnumTypeParamsInDecls(info: Option[PkgInfo], enumName: String) -> Option[Slice[String]]
  switch info
    case Some(pkg) => lookupEnumTypeParamsInDeclList(pkg.Decls, enumName)
    case None => None
  end
end

func lookupEnumTypeParamsInDeclList(decls: Slice[ast2.Decl], enumName: String) -> Option[Slice[String]]
  if decls.Len() == 0 then
    None
  else
    switch decls.Get(0)
      case None => None
      case Some(decl) then
        switch decl
          case EnumDecl(name, tps, _) then
            if name == enumName then
              Some(tps)
            else
              lookupEnumTypeParamsInDeclList(common2.SliceDrop(decls, 1), enumName)
            end
          end
          case _ => lookupEnumTypeParamsInDeclList(common2.SliceDrop(decls, 1), enumName)
        end
      end
    end
  end
end

func enumNameForMonoType(typ: ast2.MonoType) -> Option[String]
  switch typ
    case TCon(name) => Some(name)
    case TApp(ctor, _) => enumNameForMonoType(ctor.value())
    case TQualifiedName(_, inner) => enumNameForMonoType(inner.value())
    case _ => None
  end
end

# wrapPatternBinds re-wraps the names that the pattern just introduced
# so they re-export the TQualifiedName.  The inner type may itself be a
# parametric sum (TApp / TCon), so the new Body mirrors the original inner
# rather than re-unwrapping.
func wrapPatternBinds(env: Env, path: String, inner: ast2.MonoType) -> Result[Env, String]
  Ok(env)
end

func envWithTuplePattern(env: Env, patterns: Slice[ast2.Pattern], types: Slice[ast2.MonoType], state: InferState) -> Result[Env, String]
  if patterns.Len() != types.Len() then
    Err("tuple pattern arity mismatch")
  else
    envWithTuplePatternLoop(env, patterns, types, state)
  end
end

func envWithTuplePatternLoop(env: Env, patterns: Slice[ast2.Pattern], types: Slice[ast2.MonoType], state: InferState) -> Result[Env, String]
  if patterns.Len() == 0 then
    Ok(env)
  else
    switch (patterns.Get(0), types.Get(0))
      case (Some(p), Some(t)) then
        switch envWithPattern(env, p, t, state)
          case Ok(next) then
            envWithTuplePatternLoop(next, common2.SliceDrop(patterns, 1), common2.SliceDrop(types, 1), state)
          end
          case Err(msg) => Err(msg)
        end
      end
      case _ => Err("tuple pattern arity mismatch")
    end
  end
end

func envWithPatternBindings(env: Env, names: Slice[ast2.Pattern], fields: Slice[ast2.MonoType], targetType: ast2.MonoType, variantType: ast2.MonoType, state: InferState) -> Result[Env, String]
  if names.Len() != fields.Len() then
    Err("pattern argument count mismatch")
  else
    # Unify the switch target with the variant's constructor type so the
    # variant's type parameters (e.g. `t1` in `func(t1) -> Option[t1]`) get
    # bound to the actual element type (e.g. `ParseError`).  The resulting
    # substitution is then applied to each pattern binding's type, so names
    # like `e` get the *resolved* element type (`ParseError`) rather than the
    # bare fresh variable (`t1`) — otherwise downstream `e.Field` accesses
    # would fail because the stub environment entry is still a type variable.
    let s = unify(targetType, variantType, emptySubst())
    switch s
      case Err(msg) => Err("pattern does not match switch target: " + msg)
      case Ok(subst) => envWithPatternBindingLoop(env, names, fields, subst, state)
    end
  end
end

func envWithPatternBindingLoop(env: Env, names: Slice[ast2.Pattern], fields: Slice[ast2.MonoType], subst: Subst, state: InferState) -> Result[Env, String]
  if names.Len() == 0 then
    Ok(env)
  else
    switch names.Get(0)
      case None => Err("pattern argument count mismatch")
      case Some(name) then
        switch fields.Get(0)
          case None => Err("pattern argument count mismatch")
          case Some(fieldType) then
            let field = applySubst(subst, fieldType)
            switch envWithPattern(env, name, field, state)
              case Ok(next) then
                envWithPatternBindingLoop(next, common2.SliceDrop(names, 1), common2.SliceDrop(fields, 1), subst, state)
              end
              case Err(msg) => Err(msg)
            end
          end
        end
      end
    end
  end
end

func inferTuple(items: Slice[ast2.Expr], env: Env, state: InferState) -> Result[(InferResult, Slice[ast2.Expr]), String]
  inferTupleItems(
    items,
    env,
    state,
    [],
    emptySubst(),
    []
  )
end

func inferTupleItems(items: Slice[ast2.Expr], env: Env, state: InferState, types: Slice[ast2.MonoType], subst: Subst, typed: Slice[ast2.Expr]) -> Result[(InferResult, Slice[ast2.Expr]), String]
  if items.Len() == 0 then
    switch applyTypedExprsSubst(subst, typed)
      case None => Err("malformed tuple expression: missing typed element")
      case Some(typedItems) then
        Ok((
          InferResult {
            Type: ast2.MonoType.TTuple(types),
            Predicates: [],
            Subst: subst,
            State: state,
          },
          typedItems
        ))
      end
    end
  else
    switch items.Get(0)
      case None => Err("malformed tuple expression: missing element")
      case Some(item) then
        let r = inferExpr(item, env, state)
        switch r
          case Err(msg) => Err(msg)
          case Ok(eir) then
            inferTupleItems(
              common2.SliceDrop(items, 1),
              env,
              eir.Result.State,
              types.Append(eir.Result.Type),
              composeSubst(eir.Result.Subst, subst),
              typed.Append(eir.Expr)
            )
          end
        end
      end
    end
  end
end

struct StmtInferResult
  MaybeExpr: Option[ast2.Expr]
  Result: InferResult
end

# inferStmt 推断语句的类型。
func inferStmt(stmt: ast2.Stmt, env: Env, state: InferState) -> Result[StmtInferResult, String]
  switch stmt
    case ExprStmt(expr) then
      let inferred = inferExpr(expr, env, state)
      switch inferred
        case Ok(eir) => Ok(StmtInferResult { MaybeExpr: Some(eir.Expr), Result: eir.Result })
        case Err(msg) => Err(msg)
      end
    end
    case LetStmt(bind) then
      let res = inferLet(bind, env, state)
      switch res
        case Ok(r) => Ok(StmtInferResult { MaybeExpr: None, Result: r })
        case Err(msg) => Err(msg)
      end
    end
    case VarStmt(bind) then
      let res = inferLet(bind, env, state)
      switch res
        case Ok(r) => Ok(StmtInferResult { MaybeExpr: None, Result: r })
        case Err(msg) => Err(msg)
      end
    end
    case LetRecStmt(bindings) then
      let res = inferLetRec(bindings, env, state)
      switch res
        case Ok(r) => Ok(StmtInferResult { MaybeExpr: None, Result: r })
        case Err(msg) => Err(msg)
      end
    end
    case TupleLetStmt(_, value) then
      # Tuple destructuring: `let (a, b) = expr`.  Infer the right-hand side as a
      # tuple type, then bind each name to the corresponding element.  The
      # bootstrap pipeline (codegen2) does not need per-element TypedDecls
      # here — the result type is the tuple's tail type.  This mirrors the
      # single-name LetStmt path so that any package using tuple destructuring
      # can still complete inference instead of panicking.
      let r = inferExpr(value, env, state)
      switch r
        case Err(msg) => Err(msg)
        case Ok(eir) => Ok(StmtInferResult { MaybeExpr: Some(eir.Expr), Result: eir.Result })
      end
    end
    case WhileStmt(cond, body) then
      let inferred = inferExpr(cond, env, state)
      switch inferred
        case Ok(eirCond) then
          let cv = eirCond.Result
          let csubst = unify(cv.Type, ast2.MonoType.TCon("Bool"), cv.Subst)
          switch csubst
            case Err(msg) => Err(msg)
            case Ok(_) then
              let b = inferExpr(body, env, cv.State)
              switch b
                case Err(msg) => Err(msg)
                case Ok(eirBody) then
                  Ok(StmtInferResult {
                    MaybeExpr: None,
                    Result: InferResult {
                      Type: ast2.MonoType.TUnit,
                      Predicates: eirBody.Result.Predicates,
                      Subst: eirBody.Result.Subst,
                      State: eirBody.Result.State,
                    },
                  })
                end
              end
            end
          end
        end
        case Err(msg) => Err(msg)
      end
    end
    case AssignStmt(target, value) then
      let t = inferExpr(target, env, state)
      switch t
        case Err(msg) => Err(msg)
        case Ok(eirTarget) then
          let tv = eirTarget.Result
          let v = inferExpr(value, env, tv.State)
          switch v
            case Err(msg) => Err(msg)
            case Ok(eirValue) then
              let vv = eirValue.Result
              let s = unify(tv.Type, vv.Type, composeSubst(vv.Subst, tv.Subst))
              switch s
                case Err(msg) => Err(msg)
                case Ok(sb) then
                  Ok(StmtInferResult {
                    MaybeExpr: None,
                    Result: InferResult {
                      Type: ast2.MonoType.TUnit,
                      Predicates: appendPredicates(tv.Predicates, vv.Predicates),
                      Subst: sb,
                      State: vv.State,
                    },
                  })
                end
              end
            end
          end
        end
      end
    end
    case ReturnStmt then
      Ok(StmtInferResult {
        MaybeExpr: None,
        Result: InferResult {
          Type: ast2.MonoType.TUnit,
          Predicates: [],
          Subst: emptySubst(),
          State: state,
        },
      })
    end
    case BreakStmt(_) then
      Ok(StmtInferResult {
        MaybeExpr: None,
        Result: InferResult {
          Type: ast2.MonoType.TUnit,
          Predicates: [],
          Subst: emptySubst(),
          State: state,
        },
      })
    end
    case ContinueStmt(_) then
      Ok(StmtInferResult {
        MaybeExpr: None,
        Result: InferResult {
          Type: ast2.MonoType.TUnit,
          Predicates: [],
          Subst: emptySubst(),
          State: state,
        },
      })
    end
    case ReturnWithStmt(value) then
      let inferred = inferExpr(value, env, state)
      switch inferred
        case Ok(eir) then
          Ok(StmtInferResult { MaybeExpr: Some(eir.Expr), Result: eir.Result })
        end
        case Err(msg) => Err(msg)
      end
    end
  end
end

func isGoPackageCall(callee: ast2.Expr, state: InferState) -> Bool
  switch callee.Kind
    case FieldExpr(base, _) then
      switch base.Kind
        case IdentExpr(alias) => isGoPackageAlias(alias, state.GoPackages)
        case _ => false
      end
    end
    case _ => false
  end
end

# isGoPackageAlias checks whether `alias` matches a known Go FFI import.  This
# is the new check that replaces the legacy `TGoPackage` body test, since the
# type system no longer carries a dedicated package variant.
func isGoPackageAlias(alias: String, goPkgs: Slice[GoPackageEntry]) -> Bool
  if goPkgs.Len() == 0 then
    false
  else
    switch goPkgs.Get(0)
      case None => isGoPackageAlias(alias, common2.SliceDrop(goPkgs, 1))
      case Some(head) then
        head.Alias == alias || isGoPackageAlias(alias, common2.SliceDrop(goPkgs, 1))
      end
    end
  end
end

func inferAssign(target: ast2.Expr, value: ast2.Expr, env: Env, state: InferState) -> Result[InferResult, String]
  let t = inferExpr(target, env, state)
  switch t
    case Err(msg) => Err(msg)
    case Ok(teir) then
      let tv = teir.Result
      let v = inferExpr(value, env, tv.State)
      switch v
        case Err(msg) => Err(msg)
        case Ok(eir) then
          let vv = eir.Result
          let s = unify(applySubst(vv.Subst, tv.Type), applySubst(vv.Subst, vv.Type), vv.Subst)
          switch s
            case Err(msg) => Err(msg)
            case Ok(s2) then
              Ok(InferResult {
                Type: ast2.MonoType.TUnit,
                Predicates: vv.Predicates,
                Subst: s2,
                State: vv.State,
              })
            end
          end
        end
      end
    end
  end
end

func inferUnary(expr: ast2.Expr, op: String, inner: ast2.Expr, env: Env, state: InferState) -> Result[ExprInferResult, String]
  let r = inferExpr(inner, env, state)
  switch r
    case Ok(eir) then
      let typedInner = eir.Expr
      let v = eir.Result
      let matched = if op == "!" then
        matchExpected(v, ast2.MonoType.TCon("Bool"), ast2.MonoType.TCon("Bool"))
      else
        if op == "-" then
          if isNumericType(v.Type) then
            Ok(v)
          else
            Err("unary - requires a numeric operand")
          end
        else
          Err("unknown unary operator " + op)
        end
      end
      switch matched
        case Ok(v2) then
          let te = ast2.Expr {
            ID: expr.ID,
            Pos: expr.Pos,
            Kind: ast2.ExprKind.UnaryExpr(op, typedInner),
            Type: Some(v2.Type),
          }
          Ok(ExprInferResult { Expr: te, Result: v2 })
        end
        case Err(m) => Err(m)
      end
    end
    case Err(msg) => Err(msg)
  end
end

func isNumericType(typ: ast2.MonoType) -> Bool
  switch typ
    case TCon(name) then
      name == "Int" || name == "Int8" || name == "Int16" || name == "Int32" || name == "Int64" || name == "UInt" || name == "UInt8" || name == "UInt16" || name == "UInt32" || name == "UInt64" || name == "Float32" || name == "Float64"
    end
    case _ => false
  end
end

func inferBinary(expr: ast2.Expr, op: String, left: ast2.Expr, right: ast2.Expr, env: Env, state: InferState) -> Result[ExprInferResult, String]
  let l = inferExpr(left, env, state)
  switch l
    case Err(msg) => Err(msg)
    case Ok(leir) then
      let lv = leir.Result
      let r = inferExpr(right, env, lv.State)
      switch r
        case Err(msg) => Err(msg)
        case Ok(reir) then
          let rv = reir.Result
          let s1 = composeSubst(rv.Subst, lv.Subst)
          if isArithmetic(op) then
            # Old-compiler parity: arithmetic operators (`+`, `-`, `*`, `/`)
            # unify the operands with each other and let the result inherit
            # the common operand type, so `String + String` chains into a
            # `String` rather than being forced to `Int`.
            let s2 = unify(applySubst(s1, lv.Type), applySubst(s1, rv.Type), s1)
            switch s2
              case Ok(sb) then
                Ok(mkTypedBinary(
                  expr,
                  op,
                  leir.Expr,
                  reir.Expr,
                  InferResult {
                    Type: applySubst(sb, lv.Type),
                    Predicates: appendPredicates(lv.Predicates, rv.Predicates),
                    Subst: sb,
                    State: rv.State,
                  }
                ))
              end
              case Err(msg) => Err("arithmetic operator " + op + " type mismatch: " + msg)
            end
          else
            if isComparison(op) then
              let s2 = unify(applySubst(s1, lv.Type), applySubst(s1, rv.Type), s1)
              switch s2
                case Ok(sb) then
                  Ok(mkTypedBinary(
                    expr,
                    op,
                    leir.Expr,
                    reir.Expr,
                    InferResult {
                      Type: ast2.MonoType.TCon("Bool"),
                      Predicates: appendPredicates(lv.Predicates, rv.Predicates),
                      Subst: sb,
                      State: rv.State,
                    }
                  ))
                end
                case Err(msg) => Err(msg)
              end
            else
              if isLogical(op) then
                let s2 = unify(applySubst(s1, lv.Type), ast2.MonoType.TCon("Bool"), s1)
                switch s2
                  case Err(msg) => Err("logical operator requires Bool operands: " + msg)
                  case Ok(sa) then
                    let s3 = unify(applySubst(sa, rv.Type), ast2.MonoType.TCon("Bool"), sa)
                    switch s3
                      case Ok(sb) then
                        Ok(mkTypedBinary(
                          expr,
                          op,
                          leir.Expr,
                          reir.Expr,
                          InferResult {
                            Type: ast2.MonoType.TCon("Bool"),
                            Predicates: appendPredicates(lv.Predicates, rv.Predicates),
                            Subst: sb,
                            State: rv.State,
                          }
                        ))
                      end
                      case Err(msg) => Err("logical operator requires Bool operands: " + msg)
                    end
                  end
                end
              else
                Err("unknown binary operator " + op)
              end
            end
          end
        end
      end
    end
  end
end

func mkTypedBinary(expr: ast2.Expr, op: String, left: ast2.Expr, right: ast2.Expr, result: InferResult) -> ExprInferResult
  let typedLeft = applyTypedExprSubst(result.Subst, left)
  let typedRight = applyTypedExprSubst(result.Subst, right)
  let typedResult = InferResult {
    Type: applySubst(result.Subst, result.Type),
    Predicates: result.Predicates,
    Subst: result.Subst,
    State: result.State,
  }
  let typedExpr = ast2.Expr {
    ID: expr.ID,
    Pos: expr.Pos,
    Kind: ast2.ExprKind.BinaryExpr(op, typedLeft, typedRight),
    Type: Some(typedResult.Type),
  }
  ExprInferResult { Expr: typedExpr, Result: typedResult }
end

func inferIf(expr: ast2.Expr, cond: ast2.Expr, thenExpr: ast2.Expr, elseExpr: ast2.Expr, env: Env, state: InferState) -> Result[ExprInferResult, String]
  let c = inferExpr(cond, env, state)
  switch c
    case Err(msg) => Err(msg)
    case Ok(ceir) then
      let cv = ceir.Result
      let csubst = unify(cv.Type, ast2.MonoType.TCon("Bool"), cv.Subst)
      switch csubst
        case Err(msg) => Err(msg)
        case Ok(scond) then
          let t = inferExpr(thenExpr, env, cv.State)
          switch t
            case Err(msg) => Err(msg)
            case Ok(eirT) then
              let tv = eirT.Result
              let e = inferExpr(elseExpr, env, tv.State)
              switch e
                case Err(msg) => Err(msg)
                case Ok(eeir) then
                  let ev = eeir.Result
                  let s1 = composeSubst(ev.Subst, composeSubst(tv.Subst, scond))
                  let thenApplied = applySubst(s1, tv.Type)
                  let elseApplied = applySubst(s1, ev.Type)
                  let same = unify(thenApplied, elseApplied, s1)
                  switch same
                    case Ok(s2) then
                      let result = InferResult {
                        Type: applySubst(s2, tv.Type),
                        Predicates: appendPredicates(cv.Predicates, appendPredicates(tv.Predicates, ev.Predicates)),
                        Subst: s2,
                        State: ev.State,
                      }
                      let typedKind = ast2.ExprKind.IfExpr(
                        applyTypedExprSubst(s2, ceir.Expr),
                        applyTypedExprSubst(s2, eirT.Expr),
                        applyTypedExprSubst(s2, eeir.Expr)
                      )
                      Ok(ExprInferResult {
                        Expr: ast2.Expr {
                          ID: expr.ID,
                          Pos: expr.Pos,
                          Kind: typedKind,
                          Type: Some(result.Type),
                        },
                        Result: result,
                      })
                    end
                    case Err(msg) => Err(msg)
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

func inferCall(callee: ast2.Expr, typeArgs: Slice[ast2.TypeExpr], args: Slice[ast2.Expr], env: Env, state: InferState) -> Result[ExprInferResult, String]
  switch inferRefCall(callee, args, env, state)
    case Some(r) then
      switch r
        case Ok(pair) then
          let (v, typedArgs) = pair
          let callExprKind = ast2.ExprKind.CallExpr(callee, typeArgs, typedArgs)
          Ok(ExprInferResult {
            Expr: ast2.Expr {
              ID: 0,
              Pos: ast2.SourcePos{
                SourceName: "",
                Line: 0,
                Column: 0,
              },
              Kind: callExprKind,
              Type: Some(v.Type),
            },
            Result: v,
          })
        end
        case Err(m) => Err(m)
      end
    end
    case None then
      switch inferOrdinaryCall(callee, args, env, state)
        case Ok(pair) then
          let (v, typedArgs) = pair
          let callExprKind = switch inferredDictionaryCall(callee, v.Expr, v.Result.State.ActiveConstraints)
            case Some(key) then
              switch v.Expr.Kind
                case FieldExpr(base, _) => ast2.ExprKind.DictionaryCallExpr(key, base, typedArgs)
                case _ => ast2.ExprKind.CallExpr(v.Expr, typeArgs, typedArgs)
              end
            end
            case None => ast2.ExprKind.CallExpr(v.Expr, typeArgs, typedArgs)
          end
          Ok(ExprInferResult {
            Expr: ast2.Expr {
              ID: 0,
              Pos: ast2.SourcePos{
                SourceName: "",
                Line: 0,
                Column: 0,
              },
              Kind: callExprKind,
              Type: Some(v.Result.Type),
            },
            Result: v.Result,
          })
        end
        case Err(m) => Err(m)
      end
    end
  end
end

func inferredDictionaryCall(callee: ast2.Expr, typedCallee: ast2.Expr, constraints: Slice[Predicate]) -> Option[String]
  switch callee.Kind
    case FieldExpr(_, method) then
      switch typedCallee.Kind
        case FieldExpr(base, _) then
          switch base.Type
            case Some(receiver) => dictionaryCallKeyForReceiver(method, receiver, constraints)
            case None => None
          end
        end
        case _ => None
      end
    end
    case _ => None
  end
end

func dictionaryCallKeyForReceiver(method: String, receiver: ast2.MonoType, constraints: Slice[Predicate]) -> Option[String]
  if constraints.Len() == 0 then
    None
  else
    switch constraints.Get(0)
      case None => None
      case Some(current) then
        switch current.Args.Get(0)
          case None => None
          case Some(arg) then
            if monoEqual(arg, receiver) then
              Some(current.ClassName + ":" + constraintArgsKey(current.Args) + ":" + method)
            else
              dictionaryCallKeyForReceiver(method, receiver, common2.SliceDrop(constraints, 1))
            end
          end
        end
      end
    end
  end
end

# Ref is a compiler boundary type.  Its constructor and dereference operation
# are not ordinary fields in the lexical environment.
func inferRefCall(callee: ast2.Expr, args: Slice[ast2.Expr], env: Env, state: InferState) -> Option[Result[(InferResult, Slice[ast2.Expr]), String]]
  switch callee.Kind
    case FieldExpr(base, field) then
      switch base.Kind
        case IdentExpr(name) then
          if name == "Ref" && field == "new" then
            if args.Len() != 1 then
              Some(Err("Ref.new expects exactly one argument"))
            else
              switch args.Get(0)
                case None => Some(Err("malformed Ref.new call: missing argument"))
                case Some(arg) then
                  let argInferred = inferExpr(arg, env, state)
                  switch argInferred
                    case Ok(eir) then
                      let typedArg = applyTypedExprSubst(eir.Result.Subst, eir.Expr)
                      let result = InferResult {
                        Type: ast2.MonoType.TApp(
                          Ref.new(ast2.MonoType.TCon("Ref")),
                          [applySubst(eir.Result.Subst, eir.Result.Type)]
                        ),
                        Predicates: eir.Result.Predicates,
                        Subst: eir.Result.Subst,
                        State: eir.Result.State,
                      }
                      Some(Ok((result, [typedArg])))
                    end
                    case Err(msg) => Some(Err(msg))
                  end
                end
              end
            end
          else
            inferRefValueCall(base, field, args, env, state)
          end
        end
        case _ => inferRefValueCall(base, field, args, env, state)
      end
    end
    case _ => None
  end
end

func inferRefValueCall(base: ast2.Expr, field: String, args: Slice[ast2.Expr], env: Env, state: InferState) -> Option[Result[(InferResult, Slice[ast2.Expr]), String]]
  if field != "value" || args.Len() != 0 then
    None
  else
    let baseInferred = inferExpr(base, env, state)
    switch baseInferred
      case Err(msg) => Some(Err(msg))
      case Ok(eir) then
        let value = eir.Result
        switch applySubst(value.Subst, value.Type)
          case TApp(typeRef, inner) then
            switch typeRef.value()
              case TCon(name) then
                if name == "Ref" && inner.Len() == 1 then
                  switch inner.Get(0)
                    case None => Some(Err("malformed Ref type: missing inner type"))
                    case Some(innerType) then
                      Some(Ok((
                        InferResult {
                          Type: innerType,
                          Predicates: value.Predicates,
                          Subst: value.Subst,
                          State: value.State,
                        },
                        []
                      )))
                    end
                  end
                else
                  Some(Err("value() requires Ref[T]"))
                end
              end
              case _ => Some(Err("value() requires Ref[T]"))
            end
          end
          case _ => Some(Err("value() requires Ref[T]"))
        end
      end
    end
  end
end

func inferOrdinaryCall(callee: ast2.Expr, args: Slice[ast2.Expr], env: Env, state: InferState) -> Result[(ExprInferResult, Slice[ast2.Expr]), String]
  let c = inferExpr(callee, env, state)
  switch c
    case Err(msg) => Err(msg)
    case Ok(eir) then
      let typedCallee = eir.Expr
      let cv = eir.Result
      switch cv.Type
        case TVariadic(_, _) then
          let argState = stateAfterCalleeInstantiation(cv.Type, cv.State)
          let ar = inferArgs(args, callParamTypes(cv.Type), env, argState, [], [], [], cv.Subst)
          switch ar
            case Err(msg) => Err(msg)
            case Ok(argsResult) then
              let r = inferGoVariadicCall(cv.Type, argsResult, cv)
              switch r
                case Ok(v) then
                  Ok((ExprInferResult { Expr: typedCallee, Result: v }, argsResult.Exprs))
                end
                case Err(m) => Err(m)
              end
            end
          end
        end
        case TQualifiedName(path, inner) then
          # A callee typed as TQualifiedName wraps a foreign-package
          # function whose body is a TFunc/TVariadic/TApp.  Manually
          # re-run the dispatch on the inner shape and rebuild the
          # result type so the call-site retains the package identity.
          let innerType = inner.value()
          switch innerType
            case TVariadic(_, _) then
              let argState = stateAfterCalleeInstantiation(innerType, cv.State)
              let ar = inferArgs(args, callParamTypes(innerType), env, argState, [], [], [], cv.Subst)
              switch ar
                case Err(msg) => Err(msg)
                case Ok(argsResult) then
                  let subst = composeSubst(argsResult.Subst, cv.Subst)
                  switch applySubst(subst, innerType)
                    case TVariadic(_, retRef) then
                      let result = applySubst(subst, retRef.value())
                      let v = InferResult {
                        Type: result,
                        Predicates: appendPredicates(cv.Predicates, argsResult.Predicates),
                        Subst: subst,
                        State: argsResult.State,
                      }
                      Ok((ExprInferResult { Expr: typedCallee, Result: v }, argsResult.Exprs))
                    end
                    case _ => Err("unreachable variadic inner")
                  end
                end
                case _ => Err("unreachable variadic dispatch")
              end
            end
            case _ then
              let argState = stateAfterCalleeInstantiation(innerType, cv.State)
              let ar = inferArgs(args, callParamTypes(innerType), env, argState, [], [], [], cv.Subst)
              switch ar
                case Err(msg) => Err(msg)
                case Ok(argsResult) then
                  let afterCallee = nextFreshVarID(innerType, argsResult.State.FreshVarID)
                  let fresh = nextFreshVarIDInAll(argsResult.Types, afterCallee)
                  let s1 = composeSubst(argsResult.Subst, cv.Subst)
                  let used = maxSubstID(s1)
                  let safeFresh = if fresh <= used then
                    used + 1
                  else
                    fresh
                  end
                  let nextState = withFreshID(argsResult.State, safeFresh + 1)
                  let ret = ast2.MonoType.TVar(safeFresh)
                  let expected = ast2.MonoType.TFunc(argsResult.Types, Ref.new(ret))
                  let s2 = unify(applySubst(s1, innerType), expected, s1)
                  switch s2
                    case Ok(s) then
                      let finalType = applySubst(s, ret)
                      switch applyTypedExprsSubst(s, argsResult.Exprs)
                        case None => Err("malformed call expression: missing typed argument")
                        case Some(typedArgs) then
                          Ok((
                            ExprInferResult {
                              Expr: applyTypedExprSubst(s, typedCallee),
                              Result: InferResult {
                                Type: finalType,
                                Predicates: appendPredicates(cv.Predicates, argsResult.Predicates),
                                Subst: s,
                                State: nextState,
                              },
                            },
                            typedArgs
                          ))
                        end
                      end
                    end
                    case Err(msg) then
                      if isGoPackageCall(callee, state) then
                        Err("Go function argument count mismatch")
                      else
                        Err(msg)
                      end
                    end
                  end
                end
              end
            end
          end
        end
        case _ then
          # TApp and TQualifiedName both wrap a callable shape (TFunc /
          # TVariadic).  Peek past the wrapper so call-type dispatch can
          # match the right branch.  TQualifiedName's inner has already
          # been handled above; the only remaining wrapper is TApp.
          let effective = switch cv.Type
            case TApp(inner, _) => inner.value()
            case _ => cv.Type
          end
          let argState = stateAfterCalleeInstantiation(effective, cv.State)
          let ar = inferArgs(args, callParamTypes(effective), env, argState, [], [], [], cv.Subst)
          switch ar
            case Err(msg) => Err(msg)
            case Ok(argsResult) then
              let afterCallee = nextFreshVarID(effective, argsResult.State.FreshVarID)
              let fresh = nextFreshVarIDInAll(argsResult.Types, afterCallee)
              let s1 = composeSubst(argsResult.Subst, cv.Subst)
              let used = maxSubstID(s1)
              let safeFresh = if fresh <= used then
                used + 1
              else
                fresh
              end
              let nextState = withFreshID(argsResult.State, safeFresh + 1)
              let ret = ast2.MonoType.TVar(safeFresh)
              let expected = ast2.MonoType.TFunc(argsResult.Types, Ref.new(ret))
              let s2 = unify(applySubst(s1, effective), expected, s1)
              switch s2
                case Ok(s) then
                  switch applyTypedExprsSubst(s, argsResult.Exprs)
                    case None => Err("malformed call expression: missing typed argument")
                    case Some(typedArgs) then
                      Ok((
                        ExprInferResult {
                          Expr: applyTypedExprSubst(s, typedCallee),
                          Result: InferResult {
                            Type: applySubst(s, ret),
                            Predicates: appendPredicates(cv.Predicates, argsResult.Predicates),
                            Subst: s,
                            State: nextState,
                          },
                        },
                        typedArgs
                      ))
                    end
                  end
                end
                case Err(msg) then
                  if isGoPackageCall(callee, state) then
                    Err("Go function argument count mismatch")
                  else
                    Err(msg + " [callee=" + MonoStringFull(applySubst(s1, cv.Type)) + " effective=" + MonoStringFull(applySubst(s1, effective)) + " expected=" + MonoStringFull(applySubst(s1, expected)) + "]")
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

# Instantiating a polymorphic callee introduces fresh TVars into its parameter
# types. Nested argument calls must allocate above those IDs; otherwise their
# result temporary can reuse a callee type variable (e.g. ParseInput[A]'s A),
# incorrectly producing Parser[Parser[File]].
func stateAfterCalleeInstantiation(typ: ast2.MonoType, state: InferState) -> InferState
  withFreshID(state, nextFreshVarID(typ, state.FreshVarID))
end

func inferGoVariadicCall(marker: ast2.MonoType, args: ArgsResult, callee: InferResult) -> Result[InferResult, String]
  let subst = composeSubst(args.Subst, callee.Subst)
  switch marker
    case TVariadic(_, ret) then
      Ok(InferResult {
        Type: applySubst(subst, ret.value()),
        Predicates: appendPredicates(callee.Predicates, args.Predicates),
        Subst: subst,
        State: args.State,
      })
    end
    case _ => Err("invalid variadic call type")
  end
end

func callParamTypes(typ: ast2.MonoType) -> Slice[ast2.MonoType]
  switch typ
    case TFunc(params, _) => params
    case TVariadic(params, _) => params
    case _ => []
  end
end

# Infer call arguments against the instantiated callee parameter types.  This
# is where a contextual literal such as `PPure([])` learns that `[]` is
# `Slice[A]`: earlier arguments may first bind the callee's fresh variables,
# and the composed substitution is applied before each following argument.
func inferArgs(args: Slice[ast2.Expr], expectedTypes: Slice[ast2.MonoType], env: Env, state: InferState, types: Slice[ast2.MonoType], exprs: Slice[ast2.Expr], predicates: Slice[Predicate], subst: Subst) -> Result[ArgsResult, String]
  if args.Len() == 0 then
    switch applyTypedExprsSubst(subst, exprs)
      case None => Err("malformed call expression: missing typed argument")
      case Some(typedArgs) then
        Ok(ArgsResult {
          Types: types,
          Exprs: typedArgs,
          Predicates: predicates,
          Subst: subst,
          State: state,
        })
      end
    end
  else
    switch args.Get(0)
      case None => Err("malformed call expression: missing argument")
      case Some(head) then
        inferArgsHead(
          head,
          common2.SliceDrop(args, 1),
          expectedTypes,
          env,
          state,
          types,
          exprs,
          predicates,
          subst
        )
      end
    end
  end
end

func inferArgsHead(head: ast2.Expr, rest: Slice[ast2.Expr], expectedTypes: Slice[ast2.MonoType], env: Env, state: InferState, types: Slice[ast2.MonoType], exprs: Slice[ast2.Expr], predicates: Slice[Predicate], subst: Subst) -> Result[ArgsResult, String]
  switch inferExpr(head, env, state)
    case Err(msg) => Err(msg)
    case Ok(eir) then
      let v = eir.Result
      let baseSubst = composeSubst(v.Subst, subst)
      let checked = switch expectedTypes.Get(0)
        case Some(expected) then
          unify(applySubst(baseSubst, v.Type), applySubst(baseSubst, expected), baseSubst)
        end
        case None => Ok(baseSubst)
      end
      switch checked
        # Preserve the argument expression's position.  The caller may be
        # nested in a switch/function body; without this, bootstrap reports
        # only the enclosing function's first expression and hides the
        # actual constructor or helper call that produced the mismatch.

        case Err(msg) then
          Err(callArgumentError(head, msg + " [actual argument type: " + MonoStringFull(v.Type) + "]"))
        end
        case Ok(nextSubst) then
          inferArgs(
            rest,
            common2.SliceDrop(expectedTypes, 1),
            env,
            v.State,
            types.Append(applySubst(nextSubst, v.Type)),
            exprs.Append(applyTypedExprSubst(nextSubst, eir.Expr)),
            appendPredicates(predicates, v.Predicates),
            nextSubst
          )
        end
      end
    end
  end
end

func callArgumentError(arg: ast2.Expr, msg: String) -> String
  let source = if arg.Pos.SourceName == "" then
    "<input>"
  else
    arg.Pos.SourceName
  end
  source + ":" + arg.Pos.Line.ToString() + ":" + arg.Pos.Column.ToString() + ": call argument type mismatch: " + msg
end

func inferBlock(items: Slice[ast2.Stmt], env: Env, state: InferState) -> Result[InferResult, String]
  if items.Len() == 0 then
    Ok(InferResult { Type: ast2.MonoType.TUnit, Predicates: [], Subst: emptySubst(), State: state })
  else
    inferBlockItems(items, env, state, ast2.MonoType.TUnit, emptySubst(), [])
  end
end

# A block is part of the typed AST, not merely a type-checking scope.  Keep
# the inferred statements so nested calls retain their dispatch annotations.
func inferTypedBlock(items: Slice[ast2.Stmt], env: Env, state: InferState) -> Result[(InferResult, Slice[ast2.Stmt]), String]
  inferTypedBlockItems(
    items,
    env,
    state,
    ast2.MonoType.TUnit,
    emptySubst(),
    [],
    []
  )
end

func inferTypedBlockItems(items: Slice[ast2.Stmt], env: Env, state: InferState, lastType: ast2.MonoType, subst: Subst, predicates: Slice[Predicate], out: Slice[ast2.Stmt]) -> Result[(InferResult, Slice[ast2.Stmt]), String]
  if items.Len() == 0 then
    switch applyTypedStmtsSubst(subst, out)
      case None => Err("malformed block: missing typed statement")
      case Some(typedItems) then
        Ok((
          InferResult {
            Type: applySubst(subst, lastType),
            Predicates: predicates,
            Subst: subst,
            State: state,
          },
          typedItems
        ))
      end
    end
  else
    switch items.Get(0)
      case None => Err("malformed block: missing statement")
      case Some(stmt) then
        let step = inferBlockStep(stmt, env, state, items.Len() == 1)
        switch step
          case Err(msg) => Err(msg)
          case Ok(v) then
            inferTypedBlockItems(
              common2.SliceDrop(items, 1),
              v.Env,
              v.Result.State,
              v.Result.Type,
              composeSubst(v.Result.Subst, subst),
              appendPredicates(predicates, v.Result.Predicates),
              out.Append(v.Stmt)
            )
          end
        end
      end
    end
  end
end

func inferBlockItems(items: Slice[ast2.Stmt], env: Env, state: InferState, lastType: ast2.MonoType, subst: Subst, predicates: Slice[Predicate]) -> Result[InferResult, String]
  if items.Len() == 0 then
    Ok(InferResult {
      Type: applySubst(subst, lastType),
      Predicates: predicates,
      Subst: subst,
      State: state,
    })
  else
    switch items.Get(0)
      case None => Err("malformed block: missing statement")
      case Some(stmt) then
        let step = inferBlockStep(stmt, env, state, items.Len() == 1)
        switch step
          case Err(msg) => Err(msg)
          case Ok(v) then
            inferBlockItems(
              common2.SliceDrop(items, 1),
              v.Env,
              v.Result.State,
              v.Result.Type,
              composeSubst(v.Result.Subst, subst),
              appendPredicates(predicates, v.Result.Predicates)
            )
          end
        end
      end
    end
  end
end

func inferBlockStep(stmt: ast2.Stmt, env: Env, state: InferState, isFinal: Bool) -> Result[BlockInferStep, String]
  switch stmt
    case LetStmt(bind) => inferBlockBind(bind, false, env, state)
    case LetRecStmt(bindings) => inferBlockLetRecTyped(bindings, env, state)
    case VarStmt(bind) => inferBlockBind(bind, true, env, state)
    case WhileStmt(cond, body) => inferTypedWhileStmt(cond, body, env, state)
    case TupleLetStmt(names, value) => inferBlockTupleLet(names, value, env, state)
    case AssignStmt(target, value) then
      inferTypedAssign(target, value, env, state)
      # A conditional used as a statement may return from only one branch.
      # Its branches therefore need not have a common value type.
    end
    case ExprStmt(expr) then
      switch expr.Kind
        case IfExpr(cond, thenExpr, elseExpr) then
          if isFinal then
            inferTypedExprStmt(expr, env, state)
          else
            inferTypedIfStmt(expr, cond, thenExpr, elseExpr, env, state)
          end
        end
        case _ => inferTypedExprStmt(expr, env, state)
      end
    end
    case ReturnWithStmt(value) => inferTypedReturnWith(value, env, state)
    case _ then
      let r = inferStmt(stmt, env, state)
      switch r
        case Err(msg) => Err(msg)
        case Ok(sir) => Ok(BlockInferStep { Result: sir.Result, Env: env, Stmt: stmt })
      end
    end
  end
end

func inferTypedExprStmt(expr: ast2.Expr, env: Env, state: InferState) -> Result[BlockInferStep, String]
  let inferred = inferExpr(expr, env, state)
  switch inferred
    case Err(msg) => Err(msg)
    case Ok(eir) then
      Ok(BlockInferStep {
        Result: eir.Result,
        Env: env,
        Stmt: ast2.Stmt.ExprStmt(eir.Expr),
      })
    end
  end
end

func inferTypedReturnWith(value: ast2.Expr, env: Env, state: InferState) -> Result[BlockInferStep, String]
  let inferred = inferExpr(value, env, state)
  switch inferred
    case Err(msg) => Err(msg)
    case Ok(eir) then
      Ok(BlockInferStep {
        Result: eir.Result,
        Env: env,
        Stmt: ast2.Stmt.ReturnWithStmt(eir.Expr),
      })
    end
  end
end

func inferTypedIfStmt(expr: ast2.Expr, cond: ast2.Expr, thenExpr: ast2.Expr, elseExpr: ast2.Expr, env: Env, state: InferState) -> Result[BlockInferStep, String]
  let condInferred = inferExpr(cond, env, state)
  switch condInferred
    case Err(msg) => Err(msg)
    case Ok(ceir) then
      let cv = ceir.Result
      let condUnified = unify(cv.Type, ast2.MonoType.TCon("Bool"), cv.Subst)
      switch condUnified
        case Err(msg) => Err(msg)
        case Ok(scond) then
          let thenInferred = inferExpr(thenExpr, env, cv.State)
          switch thenInferred
            case Err(msg) => Err(msg)
            case Ok(teir) then
              let tv = teir.Result
              let elseInferred = inferExpr(elseExpr, env, tv.State)
              switch elseInferred
                case Err(msg) => Err(msg)
                case Ok(eeir) then
                  let ev = eeir.Result
                  let subst = composeSubst(ev.Subst, composeSubst(tv.Subst, scond))
                  let typed = ast2.Expr {
                    ID: expr.ID,
                    Pos: expr.Pos,
                    Kind: ast2.ExprKind.IfExpr(
                      applyTypedExprSubst(subst, ceir.Expr),
                      applyTypedExprSubst(subst, teir.Expr),
                      applyTypedExprSubst(subst, eeir.Expr)
                    ),
                    Type: Some(ast2.MonoType.TUnit),
                  }
                  Ok(BlockInferStep {
                    Result: InferResult {
                      Type: ast2.MonoType.TUnit,
                      Predicates: appendPredicates(cv.Predicates, appendPredicates(tv.Predicates, ev.Predicates)),
                      Subst: subst,
                      State: ev.State,
                    },
                    Env: env,
                    Stmt: ast2.Stmt.ExprStmt(typed),
                  })
                end
              end
            end
          end
        end
      end
    end
  end
end

# Assignments need to retain their typed operands just like expression
# statements. In particular, codegen dispatches `items.Append(value)` from
# the receiver annotation on the RHS field expression.
func inferTypedAssign(target: ast2.Expr, value: ast2.Expr, env: Env, state: InferState) -> Result[BlockInferStep, String]
  let inferredTarget = inferExpr(target, env, state)
  switch inferredTarget
    case Err(msg) => Err(msg)
    case Ok(eirTarget) then
      let targetResult = eirTarget.Result
      let inferredValue = inferExpr(value, env, targetResult.State)
      switch inferredValue
        case Err(msg) => Err(msg)
        case Ok(eirValue) then
          let valueResult = eirValue.Result
          let subst = unify(targetResult.Type, valueResult.Type, composeSubst(valueResult.Subst, targetResult.Subst))
          switch subst
            case Err(msg) => Err(msg)
            case Ok(s) then
              let typedTarget = applyTypedExprSubst(s, eirTarget.Expr)
              let typedValue = applyTypedExprSubst(s, eirValue.Expr)
              Ok(BlockInferStep {
                Result: InferResult {
                  Type: ast2.MonoType.TUnit,
                  Predicates: appendPredicates(targetResult.Predicates, valueResult.Predicates),
                  Subst: s,
                  State: valueResult.State,
                },
                Env: env,
                Stmt: ast2.Stmt.AssignStmt(typedTarget, typedValue),
              })
            end
          end
        end
      end
    end
  end
end

# inferBlockTupleLet handles `let (a, b) = expr`.  We don't currently know
# the tuple's element types from a generic expression, so we infer the RHS,
# then introduce each bound name as a fresh type variable.  The result env
# exposes them so the rest of the block can reference them, which is all
# inference needs; codegen2 walks the untyped TupleLetStmt shape directly
# in its own pipeline.
func inferBlockTupleLet(pattern: ast2.Pattern, value: ast2.Expr, env: Env, state: InferState) -> Result[BlockInferStep, String]
  let r = inferExpr(value, env, state)
  switch r
    case Err(msg) => Err(msg)
    case Ok(eir) then
      # A tuple binding is the explicit opt-in to Go's original multiple
      # return values. Ordinary bindings continue to see `(T, bool/error)`
      # as Option[T]/Result[T, E].
      let tupleType = switch ffiRawTupleResultType(value, eir.Result.State)
        case Some(typ) => typ
        case None => eir.Result.Type
      end
      let nextState = eir.Result.State
      switch envWithTupleLetPattern(env, pattern, tupleType)
        case None => Err("malformed tuple binding pattern")
        case Some(nextEnv) then
          switch tuplePatternBindingCount(pattern)
            case None => Err("malformed tuple binding pattern")
            case Some(bindingCount) then
              let typedValue = ast2.Expr {
                ID: eir.Expr.ID,
                Pos: eir.Expr.Pos,
                Kind: eir.Expr.Kind,
                Type: Some(tupleType),
              }
              let stepState = withFreshID(nextState, nextState.FreshVarID + bindingCount)
              let newStmt = ast2.Stmt.TupleLetStmt(pattern, typedValue)
              Ok(BlockInferStep {
                Result: InferResult {
                  Type: ast2.MonoType.TUnit,
                  Predicates: eir.Result.Predicates,
                  Subst: eir.Result.Subst,
                  State: stepState,
                },
                Env: nextEnv,
                Stmt: newStmt,
              })
            end
          end
        end
      end
    end
  end
end

func ffiRawTupleResultType(expr: ast2.Expr, state: InferState) -> Option[ast2.MonoType]
  switch expr.Kind
    case CallExpr(callee, _, _) then
      switch GoSignatureForCalleeWithPackage(callee, state.GoPackages, ffiMultiResultPredicate)
        case Some(pair) then
          # The raw shape is a best-effort recovery of Go's native multiple
          # return values for tuple destructuring.  The owning package context
          # is kept so a bare package-local result type name (for example
          # `context.WithTimeout`'s `CancelFunc`) resolves instead of falling
          # back to the caller's already-inferred type.
          let (sig, pkg) = pair
          switch GoSignatureRawResultTypeWithPackage(sig, pkg)
            case Ok(mt) => Some(mt)
            case Err(_) => None
          end
        end
        case None => None
      end
    end
    # A tuple-typed inline Go block declares its native Go result shape
    # (`go[(T, error)]`).  Tuple destructuring is the explicit opt-in to that
    # raw multiple-return form, exactly like a Go FFI call.
    case InlineGoExpr(typ, _, _, _) then
      switch typ.value()
        case TupleType(_) => Some(typeFromAST(typ.value()))
        case _ => None
      end
    end
    case _ => None
  end
end

# One FFI signature walker shared by codegen2's boundary lowering and by the
# raw-tuple scan above.  `predicate` selects the result shape a caller
# is lowering: `Results[1] == "bool"` for the Option boundary, `Results[1] ==
# "error"` for the Result boundary, and `Results.Len() > 1` for the
# multi-value / raw-tuple forms.  This is the single package/func scan — the
# Go FFI entry points in codegen2 and the raw-tuple scan both call it, so
# the formerly triplicated lookups cannot diverge.
#
# Suffix policy: `...WithPackage` carries GoPackageEntry context,
# `...WithParams` carries type-parameter context, `...In`/`...InEnv` carry an
# environment, `...Into` is the intentional tail-recursion accumulator
# idiom, and `...FromCallee` has been folded into this walker — the base
# accessors already operate on a callee expression.
func GoSignatureForCallee(callee: ast2.Expr, packages: Slice[GoPackageEntry], predicate: func(GoFuncSignature) -> Bool) -> Option[GoFuncSignature]
  switch GoSignatureForCalleeWithPackage(callee, packages, predicate)
    case Some(pair) then
      let (sig, _) = pair
      Some(sig)
    end
    case None => None
  end
end

func GoSignatureForCalleeWithPackage(callee: ast2.Expr, packages: Slice[GoPackageEntry], predicate: func(GoFuncSignature) -> Bool) -> Option[(GoFuncSignature, GoPackageEntry)]
  switch callee.Kind
    case FieldExpr(base, field) then
      switch base.Kind
        case IdentExpr(alias) => GoSignatureInPackagesWithPackage(alias, field, packages, predicate)
        case _ => None
      end
    end
    case _ => None
  end
end

func GoSignatureInPackages(alias: String, name: String, packages: Slice[GoPackageEntry], predicate: func(GoFuncSignature) -> Bool) -> Option[GoFuncSignature]
  switch GoSignatureInPackagesWithPackage(alias, name, packages, predicate)
    case Some(pair) then
      let (sig, _) = pair
      Some(sig)
    end
    case None => None
  end
end

# Package-aware variant of GoSignatureInPackages: the matched signature is
# returned together with its owning package so raw result types that name
# package-local types can be resolved with the right context.
func GoSignatureInPackagesWithPackage(alias: String, name: String, packages: Slice[GoPackageEntry], predicate: func(GoFuncSignature) -> Bool) -> Option[(GoFuncSignature, GoPackageEntry)]
  if packages.Len() == 0 then
    None
  else
    switch packages.Get(0)
      case None then
        GoSignatureInPackagesWithPackage(alias, name, common2.SliceDrop(packages, 1), predicate)
      end
      case Some(pkg) then
        if pkg.Alias == alias then
          switch GoSignatureInFuncs(name, pkg.Funcs, predicate)
            case Some(sig) => Some((sig, pkg))
            case None => None
          end
        else
          GoSignatureInPackagesWithPackage(alias, name, common2.SliceDrop(packages, 1), predicate)
        end
      end
    end
  end
end

func GoSignatureInFuncs(name: String, funcs: Slice[GoFuncSignature], predicate: func(GoFuncSignature) -> Bool) -> Option[GoFuncSignature]
  if funcs.Len() == 0 then
    None
  else
    switch funcs.Get(0)
      case None => GoSignatureInFuncs(name, common2.SliceDrop(funcs, 1), predicate)
      case Some(sig) then
        if sig.Name == name && predicate(sig) then
          Some(sig)
        else
          GoSignatureInFuncs(name, common2.SliceDrop(funcs, 1), predicate)
        end
      end
    end
  end
end

# GoMethodSignatureInPackages resolves the signature of a method call on a Go
# FFI receiver type such as `http.Client` (recorded as TQualifiedName with the
# package's import path, e.g. go:net/http, and TCon(Client)).  The owning
# imported Go package is located from the receiver path, then the method is
# looked up in that package's GoTypeSignature.Methods table subject to
# `predicate`.  Returns None when the receiver is not a Go FFI type or no
# method satisfies the predicate, so the caller can fall back to the plain
# call lowering.
func GoMethodSignatureInPackages(path: String, member: String, method: String, packages: Slice[GoPackageEntry], predicate: func(GoFuncSignature) -> Bool) -> Option[GoFuncSignature]
  switch goPackageEntryForReceiverPath(path, packages, 0)
    case Some(pkg) => goMethodInPackageTypes(pkg, member, method, predicate, 0)
    case None => None
  end
end

func goPackageEntryForReceiverPath(path: String, packages: Slice[GoPackageEntry], index: Int) -> Option[GoPackageEntry]
  if index >= packages.Len() then
    None
  else
    switch packages.Get(index)
      case None => goPackageEntryForReceiverPath(path, packages, index + 1)
      case Some(pkg) then
        if goReceiverPathMatches(pkg, path) then
          Some(pkg)
        else
          goPackageEntryForReceiverPath(path, packages, index + 1)
        end
      end
    end
  end
end

# A receiver's TQualifiedName path is the import path with the go: prefix (e.g.
# go:net/http).  Match it against the package's import path and alias, with and
# without the go: prefix.
func goReceiverPathMatches(pkg: GoPackageEntry, path: String) -> Bool
  let trimmed = strings.TrimSpace(path)
  let stripped = strings.TrimPrefix(trimmed, "go:")
  pkg.Path == trimmed || pkg.Alias == trimmed || (stripped != "" && (pkg.Path == "go:" + stripped || pkg.Path == stripped || pkg.Alias == stripped))
end

# Scans one package's GoTypeSignature table for `member` and returns the
# signature of method `method` when it satisfies `predicate`.
func goMethodInPackageTypes(pkg: GoPackageEntry, member: String, method: String, predicate: func(GoFuncSignature) -> Bool, index: Int) -> Option[GoFuncSignature]
  if index >= pkg.Types.Len() then
    None
  else
    switch pkg.Types.Get(index)
      case None => goMethodInPackageTypes(pkg, member, method, predicate, index + 1)
      case Some(t) then
        if t.TypeName == member then
          switch goMethodInMethods(method, t.Methods, predicate)
            case Some(sig) => Some(sig)
            case None => goMethodInPackageTypes(pkg, member, method, predicate, index + 1)
          end
        else
          goMethodInPackageTypes(pkg, member, method, predicate, index + 1)
        end
      end
    end
  end
end

func goMethodInMethods(method: String, methods: Slice[GoFuncSignature], predicate: func(GoFuncSignature) -> Bool) -> Option[GoFuncSignature]
  if methods.Len() == 0 then
    None
  else
    switch methods.Get(0)
      case None => goMethodInMethods(method, common2.SliceDrop(methods, 1), predicate)
      case Some(sig) then
        if sig.Name == method && predicate(sig) then
          Some(sig)
        else
          goMethodInMethods(method, common2.SliceDrop(methods, 1), predicate)
        end
      end
    end
  end
end

# goMethodSignatureType resolves a Go method's signature with package context
# when the owning type belongs to one of the imported Go packages.  Local
# receiver names have no owning package and use the plain resolver, matching
# the previous behavior.
func goMethodSignatureType(sig: GoFuncSignature, typeName: String, packages: Slice[GoPackageEntry]) -> Result[ast2.MonoType, String]
  switch goPackageEntryForType(typeName, packages, 0)
    case Some(pkg) => GoSignatureTypeWithPackage(sig, pkg)
    case None => GoSignatureType(sig)
  end
end

# The multi-value result predicate shared by the raw-tuple scan and the FFI
# multi-result tuple lowering.
func ffiMultiResultPredicate(sig: GoFuncSignature) -> Bool
  sig.Results.Len() > 1
end

func envWithTupleLetPattern(env: Env, pattern: ast2.Pattern, typ: ast2.MonoType) -> Option[Env]
  switch pattern
    case BindPattern(name) then
      Some(envPut(env, name, Scheme { Bound: [], Predicates: [], Body: typ }))
    end
    case WildcardPattern => Some(env)
    case TuplePattern(items) => envWithTuplePatternItems(env, items, typ, 0)
    case _ => Some(env)
  end
end

func envWithTuplePatternItems(env: Env, items: Slice[ast2.Pattern], tupleType: ast2.MonoType, index: Int) -> Option[Env]
  if index >= items.Len() then
    Some(env)
  else
    switch items.Get(index)
      case None => None
      case Some(pattern) then
        switch tupleElementTypeForBinding(tupleType, index)
          case None => None
          case Some(elementType) then
            switch envWithTupleLetPattern(env, pattern, elementType)
              case None => None
              case Some(nextEnv) => envWithTuplePatternItems(nextEnv, items, tupleType, index + 1)
            end
          end
        end
      end
    end
  end
end

func tuplePatternBindingCount(pattern: ast2.Pattern) -> Option[Int]
  switch pattern
    case BindPattern(_) => Some(1)
    case WildcardPattern => Some(0)
    case TuplePattern(items) => tuplePatternItemsBindingCount(items, 0)
    case _ => Some(0)
  end
end

func tuplePatternItemsBindingCount(items: Slice[ast2.Pattern], index: Int) -> Option[Int]
  if index >= items.Len() then
    Some(0)
  else
    switch items.Get(index)
      case None => None
      case Some(pattern) then
        switch tuplePatternBindingCount(pattern)
          case None => None
          case Some(count) then
            switch tuplePatternItemsBindingCount(items, index + 1)
              case None => None
              case Some(rest) => Some(count + rest)
            end
          end
        end
      end
    end
  end
end

func tupleElementTypeForBinding(tupleType: ast2.MonoType, index: Int) -> Option[ast2.MonoType]
  switch tupleType
    case TTuple(items) => items.Get(index)
    case _ => Some(ast2.MonoType.TVar(index + 1))
  end
end

# envWithFreshTupleBindings puts each name into env as a Scheme wrapping a
# fresh type variable.  It walks the slice recursively and returns the new
# env (an extension of the input).  `freshBase` is the next free FreshVarID.
func envWithFreshTupleBindings(env: Env, names: Slice[String], freshBase: Int, subst: Subst) -> Option[Env]
  if names.Len() == 0 then
    Some(env)
  else
    switch names.Get(0)
      case None => None
      case Some(name) then
        let rest = common2.SliceDrop(names, 1)
        let fresh = ast2.MonoType.TVar(freshBase + rest.Len())
        let bound = envPut(env, name, Scheme { Bound: [], Predicates: [], Body: fresh })
        envWithFreshTupleBindings(bound, rest, freshBase, subst)
      end
    end
  end
end

func inferTypedWhileStmt(cond: ast2.Expr, body: ast2.Expr, env: Env, state: InferState) -> Result[BlockInferStep, String]
  let condition = inferExpr(cond, env, state)
  switch condition
    case Err(msg) => Err(msg)
    case Ok(eirCond) then
      let cv = eirCond.Result
      let checked = unify(cv.Type, ast2.MonoType.TCon("Bool"), cv.Subst)
      switch checked
        case Err(msg) => Err(msg)
        case Ok(s) then
          let inferredBody = inferExpr(body, env, cv.State)
          switch inferredBody
            case Err(msg) => Err(msg)
            case Ok(eirBody) then
              Ok(BlockInferStep {
                Result: InferResult {
                  Type: ast2.MonoType.TUnit,
                  Predicates: eirBody.Result.Predicates,
                  Subst: composeSubst(eirBody.Result.Subst, s),
                  State: eirBody.Result.State,
                },
                Env: env,
                Stmt: ast2.Stmt.WhileStmt(eirCond.Expr, eirBody.Expr),
              })
            end
          end
        end
      end
    end
  end
end

func inferBlockLetRecTyped(bindings: Slice[ast2.LetRecBind], env: Env, state: InferState) -> Result[BlockInferStep, String]
  let inferred = inferBlockLetRec(bindings, env, state)
  switch inferred
    case Ok(step) => Ok(BlockInferStep { Result: step.Result, Env: step.Env, Stmt: step.Stmt })
    case Err(msg) => Err(msg)
  end
end

func inferBlockLetRec(bindings: Slice[ast2.LetRecBind], env: Env, state: InferState) -> Result[BlockInferStep, String]
  switch predeclareLetRec(bindings, env, state)
    case Err(msg) => Err(msg)
    case Ok(recEnv) then
      inferLetRecValues(bindings, recEnv, state, emptySubst(), [])
    end
  end
end

func predeclareLetRec(bindings: Slice[ast2.LetRecBind], env: Env, state: InferState) -> Result[Env, String]
  if bindings.Len() == 0 then
    Ok(env)
  else
    switch bindings.Get(0)
      case None => Err("malformed letrec declaration: missing binding")
      case Some(binding) then
        predeclareLetRec(
          common2.SliceDrop(bindings, 1),
          envPut(
            env,
            binding.Name,
            Scheme {
              Bound: [],
              Predicates: [],
              Body: typeFromASTInEnv(binding.Type, env, state),
            }
          ),
          state
        )
      end
    end
  end
end

func inferLetRec(bindings: Slice[ast2.LetRecBind], env: Env, state: InferState) -> Result[InferResult, String]
  switch predeclareLetRec(bindings, env, state)
    case Err(msg) => Err(msg)
    case Ok(recEnv) then
      switch inferLetRecValues(bindings, recEnv, state, emptySubst(), [])
        case Err(msg) => Err(msg)
        case Ok(step) => Ok(step.Result)
      end
    end
  end
end

func inferLetRecValues(bindings: Slice[ast2.LetRecBind], recEnv: Env, state: InferState, subst: Subst, out: Slice[ast2.LetRecBind]) -> Result[BlockInferStep, String]
  if bindings.Len() == 0 then
    Ok(BlockInferStep {
      Result: InferResult {
        Type: ast2.MonoType.TUnit,
        Predicates: [],
        Subst: subst,
        State: state,
      },
      Env: recEnv,
      Stmt: ast2.Stmt.LetRecStmt(out),
    })
  else
    switch bindings.Get(0)
      case None => Err("malformed letrec declaration: missing binding")
      case Some(binding) then
        inferLetRecValue(binding, common2.SliceDrop(bindings, 1), recEnv, state, subst, out)
      end
    end
  end
end

func inferLetRecValue(binding: ast2.LetRecBind, rest: Slice[ast2.LetRecBind], recEnv: Env, state: InferState, subst: Subst, out: Slice[ast2.LetRecBind]) -> Result[BlockInferStep, String]
  switch inferExpr(binding.Value, recEnv, state)
    case Err(msg) => Err("letrec binding " + binding.Name + ": " + msg)
    case Ok(eir) then
      let value = eir.Result
      let combined = composeSubst(value.Subst, subst)
      let declaredType = typeFromASTInEnv(binding.Type, recEnv, value.State)
      switch unify(applySubst(combined, value.Type), applySubst(combined, declaredType), combined)
        case Err(msg) then
          Err("letrec binding " + binding.Name + ": type annotation mismatch: " + msg)
        end
        case Ok(nextSubst) then
          let normalisedValue = applyTypedExprSubst(nextSubst, eir.Expr)
          let typedValue = ast2.Expr {
            ID: normalisedValue.ID,
            Pos: normalisedValue.Pos,
            Kind: normalisedValue.Kind,
            Type: Some(applySubst(nextSubst, declaredType)),
          }
          let typedBind = ast2.LetRecBind {
            Name: binding.Name,
            Type: binding.Type,
            Value: typedValue,
          }
          inferLetRecValues(rest, recEnv, value.State, nextSubst, out.Append(typedBind))
        end
      end
    end
  end
end

func inferBlockBind(bind: ast2.Bind, isVar: Bool, env: Env, state: InferState) -> Result[BlockInferStep, String]
  let r = inferExpr(bind.Value, env, state)
  switch r
    case Err(msg) => Err(msg)
    case Ok(eir) then
      let v = eir.Result
      let annotated = switch bind.Type
        case Some(t) => unify(v.Type, typeFromASTInEnv(t, env, v.State), v.Subst)
        case None => Ok(v.Subst)
      end
      switch annotated
        case Err(msg) => Err(msg)
        case Ok(s) then
          let boundType = applySubst(s, v.Type)
          let nextEnv = envPut(
            env,
            bind.Name,
            Scheme {
              Bound: generalizeQualified(env, boundType, v.Predicates),
              Predicates: v.Predicates,
              Body: boundType,
            }
          )
          # Preserve the fully substituted type on an unannotated binding's
          # value.  Code generation uses this typed AST to propagate local
          # types through nested selectors.
          let normalisedValue = applyTypedExprSubst(s, eir.Expr)
          let typedValue = ast2.Expr {
            ID: normalisedValue.ID,
            Pos: normalisedValue.Pos,
            Kind: normalisedValue.Kind,
            Type: Some(boundType),
          }
          let typedBind = ast2.Bind { Name: bind.Name, Type: bind.Type, Value: typedValue }
          let typedStmt = if isVar then
            ast2.Stmt.VarStmt(typedBind)
          else
            ast2.Stmt.LetStmt(typedBind)
          end
          Ok(BlockInferStep {
            Result: InferResult {
              Type: ast2.MonoType.TUnit,
              Predicates: v.Predicates,
              Subst: s,
              State: v.State,
            },
            Env: nextEnv,
            Stmt: typedStmt,
          })
        end
      end
    end
  end
end

func inferLet(bind: ast2.Bind, env: Env, state: InferState) -> Result[InferResult, String]
  let r = inferExpr(bind.Value, env, state)
  switch r
    case Err(msg) => Err(msg)
    case Ok(eir) then
      let v = eir.Result
      let annotated = switch bind.Type
        case Some(t) => unify(v.Type, typeFromASTInEnv(t, env, v.State), v.Subst)
        case None => Ok(v.Subst)
      end
      switch annotated
        case Err(msg) => Err(msg)
        case Ok(s) then
          Ok(InferResult {
            Type: ast2.MonoType.TUnit,
            Predicates: v.Predicates,
            Subst: s,
            State: v.State,
          })
        end
      end
    end
  end
end

func matchExpected(v: InferResult, expected: ast2.MonoType, result: ast2.MonoType) -> Result[InferResult, String]
  let s = unify(v.Type, expected, v.Subst)
  switch s
    case Ok(subst) then
      Ok(InferResult {
        Type: result,
        Predicates: v.Predicates,
        Subst: subst,
        State: v.State,
      })
    end
    case Err(msg) => Err(msg)
  end
end

func inferField(base: ast2.Expr, field: String, env: Env, state: InferState) -> Result[ExprInferResult, String]
  switch base.Kind
    case IdentExpr(name) then
      let packageCandidate = envGet(env, name + "." + field)
      switch packageCandidate
        case Some(packageScheme) then
          let qualified = instantiateQualified(packageScheme, state)
          # TQualifiedName is preserved verbatim.  It identifies the type
          # as coming from a different package while still allowing ordinary
          # TFunc/TVariadic matching for call-type dispatch.
          let te = ast2.Expr {
            ID: base.ID,
            Pos: base.Pos,
            Kind: base.Kind,
            Type: Some(qualified.Body),
          }
          Ok(ExprInferResult {
            Expr: te,
            Result: InferResult {
              Type: qualified.Body,
              Predicates: qualified.Predicates,
              Subst: emptySubst(),
              State: state,
            },
          })
        end
        case None then
          if isGoPackageAlias(name, state.GoPackages) then
            Err("unknown Go package member " + field)
          else
            inferNamedField(base, name, field, env, state)
          end
        end
      end
    end
    # Imported enum constructors are parsed as nested selectors. Resolve the
    # complete `alias.Enum.Variant` key before treating `Enum` as a receiver
    # with an ordinary field.
    case FieldExpr(parent, enumName) then
      switch parent.Kind
        case IdentExpr(alias) then
          switch envGet(env, alias + "." + enumName + "." + field)
            case Some(packageScheme) then
              let qualified = instantiateQualified(packageScheme, state)
              let te = ast2.Expr {
                ID: base.ID,
                Pos: base.Pos,
                Kind: base.Kind,
                Type: Some(qualified.Body),
              }
              Ok(ExprInferResult {
                Expr: te,
                Result: InferResult {
                  Type: qualified.Body,
                  Predicates: qualified.Predicates,
                  Subst: emptySubst(),
                  State: state,
                },
              })
            end
            case None => inferOrdinaryField(base, field, env, state)
          end
        end
        case _ => inferOrdinaryField(base, field, env, state)
      end
    end
    case _ => inferOrdinaryField(base, field, env, state)
  end
end

func inferNamedField(base: ast2.Expr, name: String, field: String, env: Env, state: InferState) -> Result[ExprInferResult, String]
  let candidate = envGet(env, field)
  switch candidate
    case Some(scheme) then
      switch scheme.Body
        # Variants with fields are functions; a zero-argument variant has
        # the enum type itself as its scheme body.

        case TCon(enumName) then
          if enumName == name then
            let qualified = instantiateQualified(scheme, state)
            let te = ast2.Expr {
              ID: base.ID,
              Pos: base.Pos,
              Kind: base.Kind,
              Type: Some(qualified.Body),
            }
            Ok(ExprInferResult {
              Expr: te,
              Result: InferResult {
                Type: qualified.Body,
                Predicates: qualified.Predicates,
                Subst: emptySubst(),
                State: state,
              },
            })
          else
            inferOrdinaryField(base, field, env, state)
          end
        end
        case _ => inferOrdinaryField(base, field, env, state)
      end
    end
    case None => inferOrdinaryField(base, field, env, state)
  end
end

func inferOrdinaryField(base: ast2.Expr, field: String, env: Env, state: InferState) -> Result[ExprInferResult, String]
  let r = inferExpr(base, env, state)
  switch r
    case Err(msg) => Err(msg)
    case Ok(eir) then
      let typedBase = eir.Expr
      let v = eir.Result
      let resolvedType = switch applySubst(v.Subst, v.Type)
        case TCon(_) => applySubst(v.Subst, v.Type)
        case TApp(typeRef, args) then
          switch typeRef.value()
            case TCon(name) then
              if name == "Ref" && args.Len() == 1 then
                switch args.Get(0)
                  case Some(innerType) => applySubst(v.Subst, innerType)
                  case None => applySubst(v.Subst, v.Type)
                end
              else
                applySubst(v.Subst, v.Type)
              end
            end
            case _ => applySubst(v.Subst, v.Type)
          end
        end
        case _ => applySubst(v.Subst, v.Type)
      end
      switch getTCon(resolvedType)
        case Some(pair) then
          let (innerName, args) = pair
          # When the receiver is a foreign-package type wrapped in
          # TQualifiedName, getTCon returns the bare inner name (e.g. "T"
          # for `Ref[testing.T]`).  The symbol table, however, registers
          # Go-FFI methods under the full `alias.Name` form
          # ("testing.T").  Re-derive that form here by mapping the
          # qualified import path back to its alias.  Local receivers
          # leave the bare name untouched.
          let typeName = receiverQualifiedName(applySubst(v.Subst, v.Type), innerName, state.GoPackages, state.MyGoPackageCache, 0)
          switch findSymbol(typeName, field, state.SymbolIndex)
            case Some(symbol) then
              switch symbol
                case StructField(_, _, fieldType) then
                  let substed = switchFieldTypeArgs(fieldType, typeName, args, env)
                  let instState = withFreshID(v.State, v.State.FreshVarID + 1)
                  Ok(ExprInferResult {
                    Expr: typedBase,
                    Result: InferResult {
                      Type: substed,
                      Predicates: v.Predicates,
                      Subst: v.Subst,
                      State: instState,
                    },
                  })
                end
                case GoMethod(_, _, sig) then
                  # A method on a generic Go type renders its receiver's type
                  # parameters bare (`(*List[T]).Set(v T)`); bind them like a
                  # generic function so each selector instantiates fresh
                  # variables instead of leaving unsatisfiable TParams.
                  # The owning package is threaded through so a method
                  # signature that names a package-local type (for example a
                  # result of type `CancelFunc`) resolves with package context.
                  switch goMethodSignatureType(sig, typeName, state.GoPackages)
                    case Ok(methodType) then
                      let methodScheme = Scheme {
                        Bound: typeParamIDs(sig.TypeParams, 1),
                        Predicates: [],
                        Body: methodType,
                      }
                      let q = instantiateQualified(methodScheme, v.State)
                      let instState = withFreshID(v.State, v.State.FreshVarID + methodScheme.Bound.Len())
                      Ok(ExprInferResult {
                        Expr: typedBase,
                        Result: InferResult {
                          Type: q.Body,
                          Predicates: v.Predicates,
                          Subst: v.Subst,
                          State: instState,
                        },
                      })
                    end
                    case Err(msg) => Err(msg)
                  end
                end
                case ImplMethod(_, _, scheme) then
                  let q = instantiateQualified(scheme, v.State)
                  let instState = withFreshID(v.State, v.State.FreshVarID + scheme.Bound.Len())
                  let substed = switchFieldTypeArgs(q.Body, typeName, args, env)
                  switch stripReceiverArg(substed, typeName, args, v.Subst)
                    case Some(stripResult) then
                      switch stripResult
                        case Ok(pair2) then
                          let (strippedType, s2) = pair2
                          Ok(ExprInferResult {
                            Expr: typedBase,
                            Result: InferResult {
                              Type: strippedType,
                              Predicates: appendPredicates(v.Predicates, q.Predicates),
                              Subst: s2,
                              State: instState,
                            },
                          })
                        end
                        case Err(msg) => Err(msg)
                      end
                    end
                    case None then
                      Ok(ExprInferResult {
                        Expr: typedBase,
                        Result: InferResult {
                          Type: substed,
                          Predicates: appendPredicates(v.Predicates, q.Predicates),
                          Subst: v.Subst,
                          State: instState,
                        },
                      })
                    end
                  end
                end
                case EnumVariant(_, _, ctorType) then
                  let substed = switchFieldTypeArgs(ctorType, typeName, args, env)
                  let instState = withFreshID(v.State, v.State.FreshVarID + 1)
                  Ok(ExprInferResult {
                    Expr: typedBase,
                    Result: InferResult {
                      Type: substed,
                      Predicates: v.Predicates,
                      Subst: v.Subst,
                      State: instState,
                    },
                  })
                end
              end
            end
            case None => Err("unknown field " + typeName + "." + field)
          end
        end
        case None then
          let fresh = ast2.MonoType.TVar(v.State.FreshVarID)
          Ok(ExprInferResult {
            Expr: typedBase,
            Result: InferResult {
              Type: fresh,
              Predicates: v.Predicates,
              Subst: v.Subst,
              State: withFreshID(v.State, v.State.FreshVarID + 1),
            },
          })
        end
      end
    end
  end
end

# receiverQualifiedName returns the symbol-table key for the receiver of a
# field access.  When the receiver is a foreign-package type wrapped in
# TQualifiedName (e.g. `Ref[testing.T]` whose inner is
# `TQualifiedName("go:testing", TCon("T"))`), the method table was
# registered under the `alias.Name` form.  This helper maps the qualified
# path back to the alias and rebuilds the qualified name; for local
# receivers it returns the bare `innerName` unchanged.
func receiverQualifiedName(receiver: ast2.MonoType, innerName: String, goPkgs: Slice[GoPackageEntry], myGoPkgs: Slice[MyGoPackageInfo], index: Int) -> String
  switch receiver
    case TApp(typeRef, args) then
      switch typeRef.value()
        case TCon(name) then
          if name == "Ref" && args.Len() == 1 then
            switch args.Get(0)
              case Some(innerType) then
                receiverQualifiedName(innerType, innerName, goPkgs, myGoPkgs, index)
              end
              case None => innerName
            end
          else
            innerName
          end
        end
        # An imported generic receiver (`ps.Reply[Rune]`) is
        # TApp(TQualifiedName(path, TCon(name)), args).  Recurse with the bare
        # TQualifiedName so the alias-qualified symbol key (`ps.Reply`) is
        # rebuilt below.
        case TQualifiedName(path, inner) then
          receiverQualifiedName(ast2.MonoType.TQualifiedName(path, inner), innerName, goPkgs, myGoPkgs, index)
        end
        case _ => innerName
      end
    end
    case TQualifiedName(path, inner) then
      let memberName = switch inner.value()
        case TCon(name) => name
        case _ => innerName
      end
      let alias = goPackageAliasForPath(goPkgs, path, 0)
      if alias == "" then
        let transitiveGoAlias = myGoPackageGoAliasForPath(myGoPkgs, path, 0)
        let myGoAlias = if transitiveGoAlias == "" then
          myGoPackageAliasForPath(myGoPkgs, path, 0)
        else
          transitiveGoAlias
        end
        if myGoAlias != "" then
          myGoAlias + "." + memberName
        else
          # Fall back to a path-derived alias when the Go-FFI package table
          # is unavailable (e.g. bootstrap inference running before
          # bootstrapPopulateGoSignatures completes).  Stripping the `go:`
          # prefix recovers the source-level alias the user wrote in the
          # import declaration.
          let pathAlias = goPathAlias(path)
          if pathAlias == "" then
            innerName
          else
            pathAlias + "." + memberName
          end
        end
      else
        if alias == "." then
          memberName
        else
          alias + "." + memberName
        end
      end
    end
    case _ => innerName
  end
end

func goPathAlias(path: String) -> String
  if strings.HasPrefix(path, "go:") then
    switch substring(path, 3, path.Len() - 3)
      case Some(aliasText) => aliasText
      case None => path
    end
  else
    path
  end
end

# goPackageAliasForPath returns the alias registered for `path` in the
# Go FFI import list, or "" when no such entry exists.
func goPackageAliasForPath(goPkgs: Slice[GoPackageEntry], path: String, index: Int) -> String
  if index >= goPkgs.Len() then
    ""
  else
    switch goPkgs.Get(index)
      case Some(entry) then
        if entry.Path == path then
          entry.Alias
        else
          goPackageAliasForPath(goPkgs, path, index + 1)
        end
      end
      case _ => goPackageAliasForPath(goPkgs, path, index + 1)
    end
  end
end

# stripReceiverArg recognises impl-method schemes (registered by
# `registerImplMethods`) whose Body is a function type with the *receiver* as
# its first parameter.  When `fieldType` has that shape — first param is a
# `TCon(typeName, _)` (non-generic receiver) or `TApp(TCon(typeName), _)` (a
# parametric receiver such as `Option[A]`) matching the lookup key — it
# unifies the receiver pattern with the actual receiver (`args` are the
# receiver's concrete type arguments), applies the resulting substitution
# to the remaining parameters and the return type, then returns a stripped
# function type with the receiver dropped and the new substitution.  Returns
# None for ordinary struct field projections (e.g. `Parser.Run`) so the
# caller falls back to the plain `substed` value.
func stripReceiverArg(fieldType: ast2.MonoType, typeName: String, args: Slice[ast2.MonoType], subst: Subst) -> Option[Result[(ast2.MonoType, Subst), String]]
  switch fieldType
    case TFunc(methodArgs, methodRet) then
      if methodArgs.Len() == 0 then
        None
      else
        switch methodArgs.Get(0)
          case None => None
          case Some(first) then
            stripReceiverArgWithFirst(first, methodArgs, methodRet, typeName, args, subst)
          end
        end
      end
    end
    case _ => None
  end
end

func stripReceiverArgWithFirst(first: ast2.MonoType, methodArgs: Slice[ast2.MonoType], methodRet: Ref[ast2.MonoType], typeName: String, args: Slice[ast2.MonoType], subst: Subst) -> Option[Result[(ast2.MonoType, Subst), String]]
  let recvName = switch first
    case TCon(name) => name
    case TApp(ctor, _) then
      switch ctor.value()
        case TCon(name) => name
        case TQualifiedName(_, _) => typeName + "\0"
        case _ => ""
      end
    end
    case TQualifiedName(_, _) => typeName + "\0"
    case _ => ""
  end
  if recvName == typeName + "\0" then
    # Imported package receivers retain their TQualifiedName wrapper.
    # Preserve that constructor while replacing its generic arguments so
    # the impl's type parameters unify with the receiver at this call.
    let receiverType = switch first
      case TApp(ctor, _) => ast2.MonoType.TApp(ctor, args)
      case _ => first
    end
    let us = unify(first, receiverType, subst)
    switch us
      case Err(msg) => Some(Err("method receiver mismatch: " + msg))
      case Ok(s2) then
        let droppedArgs = common2.SliceDrop(methodArgs, 1)
        let newRet = applySubst(s2, methodRet.value())
        switch applySubstMonoList(s2, droppedArgs)
          case None => Some(Err("malformed method parameter type list"))
          case Some(strippedBody) then
            Some(Ok((ast2.MonoType.TFunc(strippedBody, Ref.new(newRet)), s2)))
          end
        end
      end
    end
  elsif recvName != typeName then
    None
  else
    # The actual receiver type is `typeName[args]`.
    let receiverType = tCon(typeName, args)
    # Unify the instantiated receiver pattern with the actual receiver
    # to derive substitution entries for the impl's type parameters
    # (e.g. `T` in `SliceIEnumerable[T].Fold` gets bound to `Parser[A]`
    # when folding `Slice[Parser[A]]`).
    let us = unify(first, receiverType, subst)
    switch us
      case Err(msg) => Some(Err("method receiver mismatch: " + msg))
      case Ok(s2) then
        let droppedArgs = common2.SliceDrop(methodArgs, 1)
        let newRet = applySubst(s2, methodRet.value())
        switch applySubstMonoList(s2, droppedArgs)
          case None => Some(Err("malformed method parameter type list"))
          case Some(strippedBody) then
            Some(Ok((ast2.MonoType.TFunc(strippedBody, Ref.new(newRet)), s2)))
          end
        end
      end
    end
  end
end

func applySubstMonoList(subst: Subst, items: Slice[ast2.MonoType]) -> Option[Slice[ast2.MonoType]]
  applySubstMonoListInto(subst, items, 0, [])
end

func applySubstMonoListInto(subst: Subst, items: Slice[ast2.MonoType], index: Int, out: Slice[ast2.MonoType]) -> Option[Slice[ast2.MonoType]]
  if index >= items.Len() then
    Some(out)
  else
    switch items.Get(index)
      case None => None
      case Some(item) then
        applySubstMonoListInto(subst, items, index + 1, out.Append(applySubst(subst, item)))
      end
    end
  end
end

func switchFieldTypeArgs(fieldType: ast2.MonoType, typeName: String, args: Slice[ast2.MonoType], env: Env) -> ast2.MonoType
  # Read the struct's type param IDs from its env Scheme Bound.
  let scheme = envGet(env, typeName)
  switch scheme
    case Some(s) then
      if s.Bound.Len() == 0 || args.Len() == 0 then
        fieldType
      else
        let subst = bindDistinctFieldArgs(s.Bound, args, 0, emptySubst())
        if substIsEmpty(subst) then
          fieldType
        else
          applySubst(subst, fieldType)
        end
      end
    end
    case None => fieldType
  end
end

func bindDistinctFieldArgs(bound: Slice[Int], args: Slice[ast2.MonoType], index: Int, out: Subst) -> Subst
  if index >= bound.Len() || index >= args.Len() then
    out
  else
    switch bound.Get(index)
      case None => out
      case Some(id) then
        switch args.Get(index)
          case None => out
          case Some(typ) then
            let next = switch typ
              case TVar(other) then
                if other == id then
                  out
                else
                  substPrepend(
                    out,
                    SubstEntry {
                      ID: id,
                      Type: typ,
                    }
                  )
                end
              end
              case _ => substPrepend(out, SubstEntry { ID: id, Type: typ })
            end
            bindDistinctFieldArgs(bound, args, index + 1, next)
          end
        end
      end
    end
  end
end

func goFuncArity(path: String, name: String) -> Int
  go[Int] {
    code: "func() int { pkg, err := {importer}.Default().Import({path}); if err != nil { return -2 }; obj := pkg.Scope().Lookup({name}); if obj == nil { return -2 }; sig, ok := obj.Type().(*{gotypes}.Signature); if !ok { return -2 }; if sig.Variadic() { return -1 }; return sig.Params().Len() }()"
    in importer = importer
    in path = path
    in name = name
    in gotypes = gotypes
  }
end

func inferVariants(vars: Slice[ast2.Variant], enumName: String, tps: Slice[String], env: Env, fields: Slice[FieldEntry], state: InferState) -> Result[DeclInfer, String]
  if vars.Len() == 0 then
    Ok(DeclInfer {
      Env: envPut(
        env,
        enumName,
        Scheme {
          Bound: typeParamIDs(tps, 1),
          Predicates: [],
          Body: tCon(enumName, typeParamsAsTypes(tps, 1)),
        }
      ),
      Fields: fields,
      State: state,
      TypedDecl: None,
    })
  else
    switch vars.Get(0)
      case None => Err("malformed enum declaration: missing variant")
      case Some(v) then
        let enumType = tCon(enumName, typeParamsAsTypes(tps, 1))
        let constructorType = if v.Fields.Len() == 0 then
          enumType
        else
          ast2.MonoType.TFunc(typeArgsFromASTInEnvWithParamsList(v.Fields, tps, env, state), Ref.new(enumType))
        end
        inferVariants(
          common2.SliceDrop(vars, 1),
          enumName,
          tps,
          envPut(
            env,
            v.Name,
            Scheme {
              Bound: typeParamIDs(tps, 1),
              Predicates: [],
              Body: constructorType,
            }
          ),
          fields,
          state
        )
      end
    end
  end
end

func typeParamsAsTypes(params: Slice[String], index: Int) -> Slice[ast2.MonoType]
  typeParamsAsTypesInto(params, index, 0, [])
end

func typeParamsAsTypesInto(params: Slice[String], nextID: Int, position: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if position >= params.Len() then
    out
  else
    typeParamsAsTypesInto(params, nextID + 1, position + 1, out.Append(ast2.MonoType.TParam(-nextID)))
  end
end

# 推断结构体字面量的类型: TypeName { field1: expr1, field2: expr2 }
# 遍历所有字段，对每个字段进行类型推断，最终返回结构体类型 TCon(typeName, [])
func inferStructLit(typeName: String, fields: Slice[ast2.StructLitField], env: Env, state: InferState) -> Result[InferResult, String]
  let typed = inferTypedStructLit(typeName, fields, env, state)
  switch typed
    case Ok(pair) then
      let (result, _) = pair
      Ok(result)
    end
    case Err(msg) => Err(msg)
  end
end

func inferTypedStructLit(typeName: String, fields: Slice[ast2.StructLitField], env: Env, state: InferState) -> Result[(InferResult, Slice[ast2.StructLitField]), String]
  # Enum variant construction: Enum.Variant { field: expr, ... }
  # This shadows struct-literal handling for `Enum.Variant` names.
  let nameParts = strings.Split(typeName, ".")
  if nameParts.Len() == 2 then
    switch (nameParts.Get(0), nameParts.Get(1))
      case (Some(enumName), Some(variantName)) then
        if enumName.Len() > 0 && variantName.Len() > 0 then
          switch lookupEnumVariantDecl(state, enumName, variantName)
            case Some(variant) then
              # If the resolved variant is named (has field names), treat this as
              # enum variant construction.  Otherwise fall through to the regular
              # struct literal path, which is also used for imported structs with
              # qualified names.
              if variant.Named then
                inferEnumVariantStructLit(enumName, variantName, typeName, variant, fields, env, state)
              else
                inferTypedStructLitForType(structLitTypeInEnv(typeName, env, state), fields, env, state)
              end
            end
            case None then
              inferTypedStructLitForType(structLitTypeInEnv(typeName, env, state), fields, env, state)
            end
          end
        else
          inferTypedStructLitForType(structLitTypeInEnv(typeName, env, state), fields, env, state)
        end
      end
      case _ then
        inferTypedStructLitForType(structLitTypeInEnv(typeName, env, state), fields, env, state)
      end
    end
  elsif nameParts.Len() == 3 then
    switch (nameParts.Get(0), nameParts.Get(1), nameParts.Get(2))
      case (Some(alias), Some(enumName), Some(variantName)) then
        inferImportedEnumVariantStructLit(alias, enumName, variantName, typeName, fields, env, state)
      end
      case _ then
        inferTypedStructLitForType(structLitTypeInEnv(typeName, env, state), fields, env, state)
      end
    end
  else
    inferTypedStructLitForType(structLitTypeInEnv(typeName, env, state), fields, env, state)
  end
end

func inferImportedEnumVariantStructLit(alias: String, enumName: String, variantName: String, typeName: String, fields: Slice[ast2.StructLitField], env: Env, state: InferState) -> Result[(InferResult, Slice[ast2.StructLitField]), String]
  switch lookupImportedEnumVariantDecl(state, alias, enumName, variantName)
    case Some(declaration) then
      if declaration.Named then
        inferEnumVariantStructLit(alias + "." + enumName, variantName, typeName, declaration, fields, env, state)
      else
        inferTypedStructLitForType(structLitTypeInEnv(typeName, env, state), fields, env, state)
      end
    end
    case None then
      inferTypedStructLitForType(structLitTypeInEnv(typeName, env, state), fields, env, state)
    end
  end
end

func inferTypedStructLitForType(resultType: ast2.MonoType, fields: Slice[ast2.StructLitField], env: Env, state: InferState) -> Result[(InferResult, Slice[ast2.StructLitField]), String]
  inferTypedStructLitFields(
    resultType,
    fields,
    env,
    state,
    emptySubst(),
    state,
    [],
    []
  )
end

# lookupEnumVariantDecl finds an EnumDecl whose fully-qualified name is
# `enumName` and returns the named variant if it exists.
func lookupEnumVariantDecl(state: InferState, enumName: String, variantName: String) -> Option[ast2.Variant]
  switch state.PkgInfo
    case Some(info) => lookupEnumVariantDeclInDecls(info.Decls, enumName, variantName)
    case None => None
  end
end

func lookupImportedEnumVariantDecl(state: InferState, alias: String, enumName: String, variantName: String) -> Option[ast2.Variant]
  lookupImportedEnumVariantDeclInPackages(state.MyGoPackageCache, alias, enumName, variantName)
end

func lookupImportedEnumVariantDeclInPackages(packages: Slice[MyGoPackageInfo], alias: String, enumName: String, variantName: String) -> Option[ast2.Variant]
  if packages.Len() == 0 then
    None
  else
    switch packages.Get(0)
      case None => None
      case Some(pkg) then
        if pkg.Alias == alias then
          lookupEnumVariantDeclInDecls(pkg.Decls, enumName, variantName)
        else
          lookupImportedEnumVariantDeclInPackages(common2.SliceDrop(packages, 1), alias, enumName, variantName)
        end
      end
    end
  end
end

func lookupEnumVariantDeclInDecls(decls: Slice[ast2.Decl], enumName: String, variantName: String) -> Option[ast2.Variant]
  if decls.Len() == 0 then
    None
  else
    switch decls.Get(0)
      case None => None
      case Some(decl) then
        switch decl
          case EnumDecl(name, _, variants) then
            if name == enumName then
              lookupVariantInList(variants, variantName)
            else
              lookupEnumVariantDeclInDecls(common2.SliceDrop(decls, 1), enumName, variantName)
            end
          end
          case _ => lookupEnumVariantDeclInDecls(common2.SliceDrop(decls, 1), enumName, variantName)
        end
      end
    end
  end
end

func lookupVariantInList(variants: Slice[ast2.Variant], name: String) -> Option[ast2.Variant]
  if variants.Len() == 0 then
    None
  else
    switch variants.Get(0)
      case None => None
      case Some(v) then
        if v.Name == name then
          Some(v)
        else
          lookupVariantInList(common2.SliceDrop(variants, 1), name)
        end
      end
    end
  end
end

# inferEnumVariantStructLit types an `Enum.Variant { field: expr, ... }`
# construction.  It validates that every supplied field is defined on the
# variant exactly once, unifies each value with the declared field type, and
# returns the enum type as the expression type.
func inferEnumVariantStructLit(enumName: String, variantName: String, constructorName: String, variant: ast2.Variant, fields: Slice[ast2.StructLitField], env: Env, state: InferState) -> Result[(InferResult, Slice[ast2.StructLitField]), String]
  switch envGet(env, constructorName)
    case Some(scheme) then
      inferEnumVariantStructLitWithScheme(enumName, variantName, variant, fields, env, state, Some(scheme))
    end
    case None => Err("unknown variant " + enumName + "." + variantName)
  end
end

func inferEnumVariantStructLitWithScheme(enumName: String, variantName: String, variant: ast2.Variant, fields: Slice[ast2.StructLitField], env: Env, state: InferState, candidate: Option[Scheme]) -> Result[(InferResult, Slice[ast2.StructLitField]), String]
  switch candidate
    case None => Err("unknown variant " + variantName)
    case Some(scheme) then
      switch instantiate(scheme, state)
        case TFunc(fieldTypes, ret) then
          inferEnumVariantStructLitFields(
            enumName,
            variantName,
            variant,
            fields,
            env,
            state,
            fieldTypes,
            ret.value(),
            emptySubst(),
            0,
            [],
            []
          )
        end
        case _ => Err("variant " + variantName + " does not accept named fields")
      end
    end
  end
end

func inferEnumVariantStructLitFields(enumName: String, variantName: String, variant: ast2.Variant, fields: Slice[ast2.StructLitField], env: Env, state: InferState, fieldTypes: Slice[ast2.MonoType], enumType: ast2.MonoType, subst: Subst, index: Int, out: Slice[ast2.StructLitField], seen: Slice[String]) -> Result[(InferResult, Slice[ast2.StructLitField]), String]
  if index >= fields.Len() then
    Ok((
      InferResult {
        Type: applySubst(subst, enumType),
        Predicates: [],
        Subst: subst,
        State: state,
      },
      applyTypedStructLitFieldsSubst(subst, out)
    ))
  else
    switch fields.Get(index)
      case None => Err("malformed enum variant struct literal: missing field")
      case Some(field) then
        inferEnumVariantStructLitField(
          enumName,
          variantName,
          variant,
          fields,
          env,
          state,
          fieldTypes,
          enumType,
          subst,
          index,
          out,
          seen,
          field
        )
      end
    end
  end
end

func inferEnumVariantStructLitField(enumName: String, variantName: String, variant: ast2.Variant, fields: Slice[ast2.StructLitField], env: Env, state: InferState, fieldTypes: Slice[ast2.MonoType], enumType: ast2.MonoType, subst: Subst, index: Int, out: Slice[ast2.StructLitField], seen: Slice[String], field: ast2.StructLitField) -> Result[(InferResult, Slice[ast2.StructLitField]), String]
  if stringSliceContains(seen, field.Name) then
    Err("enum " + enumName + " variant " + variantName + " field \"" + field.Name + "\" specified more than once")
  else
    switch stringIndexOf(variant.Names, field.Name)
      case None then
        Err("enum " + enumName + " variant " + variantName + " has no field \"" + field.Name + "\"")
      end
      case Some(fieldIndex) then
        inferEnumVariantStructLitFieldType(
          enumName,
          variantName,
          variant,
          fields,
          env,
          state,
          fieldTypes,
          enumType,
          subst,
          index,
          out,
          seen,
          field,
          fieldIndex
        )
      end
    end
  end
end

func inferEnumVariantStructLitFieldType(enumName: String, variantName: String, variant: ast2.Variant, fields: Slice[ast2.StructLitField], env: Env, state: InferState, fieldTypes: Slice[ast2.MonoType], enumType: ast2.MonoType, subst: Subst, index: Int, out: Slice[ast2.StructLitField], seen: Slice[String], field: ast2.StructLitField, fieldIndex: Int) -> Result[(InferResult, Slice[ast2.StructLitField]), String]
  switch fieldTypes.Get(fieldIndex)
    case None => Err("missing inferred type for enum variant field " + field.Name)
    case Some(fieldType) then
      switch inferExpr(field.Value, env, state)
        case Err(msg) then
          Err("enum " + enumName + " variant " + variantName + " field \"" + field.Name + "\": " + msg)
        end
        case Ok(eir) then
          switch unify(applySubst(subst, fieldType), eir.Result.Type, composeSubst(eir.Result.Subst, subst))
            case Err(msg) then
              Err("enum " + enumName + " variant " + variantName + " field \"" + field.Name + "\" type mismatch: " + msg)
            end
            case Ok(nextSubst) then
              inferEnumVariantStructLitFields(
                enumName,
                variantName,
                variant,
                fields,
                env,
                eir.Result.State,
                fieldTypes,
                enumType,
                nextSubst,
                index + 1,
                out.Append(ast2.StructLitField {
                  Name: field.Name,
                  Value: applyTypedExprSubst(nextSubst, eir.Expr),
                }),
                seen.Append(field.Name)
              )
            end
          end
        end
      end
    end
  end
end

func stringIndexOf(items: Slice[String], target: String) -> Option[Int]
  stringIndexOfAt(items, target, 0)
end

func stringIndexOfAt(items: Slice[String], target: String, index: Int) -> Option[Int]
  if index >= items.Len() then
    None
  else
    switch items.Get(index)
      case None => None
      case Some(item) then
        if item == target then
          Some(index)
        else
          stringIndexOfAt(items, target, index + 1)
        end
      end
    end
  end
end

func structLitTypeInEnv(typeName: String, env: Env, state: InferState) -> ast2.MonoType
  switch envGet(env, typeName)
    case Some(scheme) => instantiate(scheme, state)
    case None => ast2.MonoType.TCon(typeName)
  end
end

func inferTypedStructLitFields(resultType: ast2.MonoType, fields: Slice[ast2.StructLitField], env: Env, state: InferState, subst: Subst, curState: InferState, predicates: Slice[Predicate], out: Slice[ast2.StructLitField]) -> Result[(InferResult, Slice[ast2.StructLitField]), String]
  if fields.Len() == 0 then
    Ok((
      InferResult { Type: resultType, Predicates: predicates, Subst: subst, State: curState },
      applyTypedStructLitFieldsSubst(subst, out)
    ))
  else
    switch fields.Get(0)
      case None => Err("malformed struct literal: missing field")
      case Some(field) then
        inferTypedStructLitField(resultType, fields, field, env, state, subst, curState, predicates, out)
      end
    end
  end
end

func inferTypedStructLitField(resultType: ast2.MonoType, fields: Slice[ast2.StructLitField], field: ast2.StructLitField, env: Env, state: InferState, subst: Subst, curState: InferState, predicates: Slice[Predicate], out: Slice[ast2.StructLitField]) -> Result[(InferResult, Slice[ast2.StructLitField]), String]
  switch inferExpr(field.Value, env, curState)
    case Err(msg) => Err(msg)
    case Ok(eir) then
      let value = eir.Result
      let expectedField = structLitFieldType(applySubst(subst, resultType), field.Name, env, state)
      switch expectedField
        case None then
          inferTypedStructLitFields(
            resultType,
            common2.SliceDrop(fields, 1),
            env,
            value.State,
            composeSubst(value.Subst, subst),
            value.State,
            appendPredicates(predicates, value.Predicates),
            out.Append(ast2.StructLitField {
              Name: field.Name,
              Value: eir.Expr,
            })
          )
        end
        case Some(fieldType) then
          switch unify(applySubst(value.Subst, fieldType), applySubst(value.Subst, value.Type), value.Subst)
            case Err(msg) => Err("struct field " + field.Name + ": " + msg)
            case Ok(nextSubst) then
              inferTypedStructLitFields(
                resultType,
                common2.SliceDrop(fields, 1),
                env,
                value.State,
                composeSubst(nextSubst, subst),
                value.State,
                appendPredicates(predicates, value.Predicates),
                out.Append(ast2.StructLitField {
                  Name: field.Name,
                  Value: applyTypedExprSubst(nextSubst, eir.Expr),
                })
              )
            end
          end
        end
      end
    end
  end
end

func structLitFieldType(resultType: ast2.MonoType, fieldName: String, env: Env, state: InferState) -> Option[ast2.MonoType]
  switch getTCon(resultType)
    case None => None
    case Some(pair) then
      let (typeName, args) = pair
      let key = structLitFieldKey(resultType, typeName, state)
      switch findSymbol(key, fieldName, state.SymbolIndex)
        case Some(symbol) then
          switch symbol
            case StructField(_, _, fieldType) then
              Some(switchFieldTypeArgs(fieldType, key, args, env))
            end
            case _ => None
          end
        end
        case None => None
      end
    end
  end
end

# structLitFieldKey re-derives the symbol-table key for a (possibly imported)
# struct literal type.  TApp(TQualifiedName(path, TCon(name)), args) and bare
# TQualifiedName(path, TCon(name)) become `alias.name` (e.g. `ps.Reply`) so
# imported structs registered under their source alias can be found; local
# types keep their bare name.
func structLitFieldKey(resultType: ast2.MonoType, bareName: String, state: InferState) -> String
  switch resultType
    case TApp(typeRef, _) then
      switch typeRef.value()
        case TQualifiedName(path, inner) then
          qualifiedStructMember(path, inner.value(), bareName, state)
        end
        case _ => bareName
      end
    end
    case TQualifiedName(path, inner) => qualifiedStructMember(path, inner.value(), bareName, state)
    case _ => bareName
  end
end

# qualifiedStructMember maps an import path back to its source alias and
# rebuilds the `alias.member` form, mirroring receiverQualifiedName.  Dot
# imports yield just the member name.
func qualifiedStructMember(path: String, inner: ast2.MonoType, fallback: String, state: InferState) -> String
  let member = switch inner
    case TCon(name) => name
    case _ => fallback
  end
  let goAlias = goPackageAliasForPath(state.GoPackages, path, 0)
  let transitiveGoAlias = myGoPackageGoAliasForPath(state.MyGoPackageCache, path, 0)
  let myGoAlias = if transitiveGoAlias == "" then
    myGoPackageAliasForPath(state.MyGoPackageCache, path, 0)
  else
    transitiveGoAlias
  end
  let alias = if goAlias == "" then
    myGoAlias
  else
    goAlias
  end
  if alias == "" then
    fallback
  elsif alias == "." then
    member
  else
    alias + "." + member
  end
end

func applyTypedStructLitFieldsSubst(subst: Subst, fields: Slice[ast2.StructLitField]) -> Slice[ast2.StructLitField]
  applyTypedStructLitFieldsSubstInto(subst, fields, 0, [])
end

func applyTypedStructLitFieldsSubstInto(subst: Subst, fields: Slice[ast2.StructLitField], index: Int, out: Slice[ast2.StructLitField]) -> Slice[ast2.StructLitField]
  if index >= fields.Len() then
    out
  else
    switch fields.Get(index)
      case Some(field) then
        applyTypedStructLitFieldsSubstInto(
          subst,
          fields,
          index + 1,
          out.Append(ast2.StructLitField {
            Name: field.Name,
            Value: applyTypedExprSubst(subst, field.Value),
          })
        )
      end
      case None => applyTypedStructLitFieldsSubstInto(subst, fields, index + 1, out)
    end
  end
end

# Apply a completed local substitution before embedding a typed subtree in a
# parent. Codegen consumes this annotation directly; it does not reconstruct
# receiver types from local scopes or selector syntax.
func applyTypedExprSubst(subst: Subst, expr: ast2.Expr) -> ast2.Expr
  # Fast path: an empty substitution cannot change any annotation, so the
  # whole typed subtree is returned untouched.  Nested expressions are
  # re-normalised at every enclosing level, so skipping the rebuild here
  # keeps the typed-AST reconstruction linear in the nesting depth instead
  # of quadratic for subtrees that carry no bound variables.
  if substIsEmpty(subst) then
    expr
  else
    let typ = switch expr.Type
      case Some(t) => Some(applySubst(subst, t))
      case None => None
    end
    let kind = switch expr.Kind
      case CallExpr(callee, typeArgs, args) then
        let typedArgs = switch applyTypedExprsSubst(subst, args)
          case Some(items) => items
          case None => []
        end
        ast2.ExprKind.CallExpr(applyTypedExprSubst(subst, callee), typeArgs, typedArgs)
      end
      case DictionaryCallExpr(key, receiver, args) then
        let typedArgs = switch applyTypedExprsSubst(subst, args)
          case Some(items) => items
          case None => []
        end
        ast2.ExprKind.DictionaryCallExpr(key, applyTypedExprSubst(subst, receiver), typedArgs)
      end
      case FieldExpr(base, field) then
        ast2.ExprKind.FieldExpr(applyTypedExprSubst(subst, base), field)
      end
      case UnaryExpr(op, inner) => ast2.ExprKind.UnaryExpr(op, applyTypedExprSubst(subst, inner))
      case BinaryExpr(op, left, right) then
        ast2.ExprKind.BinaryExpr(op, applyTypedExprSubst(subst, left), applyTypedExprSubst(subst, right))
      end
      case TupleExpr(items) then
        let typedItems = switch applyTypedExprsSubst(subst, items)
          case Some(values) => values
          case None => []
        end
        ast2.ExprKind.TupleExpr(typedItems)
      end
      case SliceLitExpr(items) then
        let typedItems = switch applyTypedExprsSubst(subst, items)
          case Some(values) => values
          case None => []
        end
        ast2.ExprKind.SliceLitExpr(typedItems)
      end
      case TypeAsExpr(value, target) then
        ast2.ExprKind.TypeAsExpr(applyTypedExprSubst(subst, value), target)
      end
      case IfExpr(cond, thenExpr, elseExpr) then
        ast2.ExprKind.IfExpr(
          applyTypedExprSubst(subst, cond),
          applyTypedExprSubst(subst, thenExpr),
          applyTypedExprSubst(subst, elseExpr)
        )
      end
      case BlockExpr(items) then
        let typedItems = switch applyTypedStmtsSubst(subst, items)
          case Some(values) => values
          case None => []
        end
        ast2.ExprKind.BlockExpr(typedItems)
      end
      case SwitchExpr(target, cases, targetType) then
        let resolvedTargetType = switch targetType
          case Some(typ) => Some(applySubst(subst, typ))
          case None => None
        end
        let typedCases = switch applyTypedSwitchCasesSubst(subst, cases)
          case Some(values) => values
          case None => []
        end
        ast2.ExprKind.SwitchExpr(applyTypedExprSubst(subst, target), typedCases, resolvedTargetType)
      end
      case FuncLitExpr(params, ret, body) then
        ast2.ExprKind.FuncLitExpr(params, ret, applyTypedExprSubst(subst, body))
      end
      case StructLitExpr(name, fields) then
        ast2.ExprKind.StructLitExpr(name, applyTypedStructLitFieldsSubst(subst, fields))
      end
      case GenericStructLitExpr(name, args, fields) then
        ast2.ExprKind.GenericStructLitExpr(name, args, applyTypedStructLitFieldsSubst(subst, fields))
      end
      case _ => expr.Kind
    end
    ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: kind, Type: typ }
  end
end

func applyTypedExprsSubst(subst: Subst, exprs: Slice[ast2.Expr]) -> Option[Slice[ast2.Expr]]
  applyTypedExprsSubstInto(subst, exprs, 0, [])
end

func applyTypedMapPairsSubst(subst: Subst, pairs: Slice[(ast2.Expr, ast2.Expr)]) -> Option[Slice[(ast2.Expr, ast2.Expr)]]
  applyTypedMapPairsSubstInto(subst, pairs, 0, [])
end

func applyTypedMapPairsSubstInto(subst: Subst, pairs: Slice[(ast2.Expr, ast2.Expr)], index: Int, out: Slice[(ast2.Expr, ast2.Expr)]) -> Option[Slice[(ast2.Expr, ast2.Expr)]]
  if index >= pairs.Len() then
    Some(out)
  else
    switch pairs.Get(index)
      case None => None
      case Some(pair) then
        let (k, v) = pair
        applyTypedMapPairsSubstInto(
          subst,
          pairs,
          index + 1,
          out.Append((applyTypedExprSubst(subst, k), applyTypedExprSubst(subst, v)))
        )
      end
    end
  end
end

func applyTypedExprsSubstInto(subst: Subst, exprs: Slice[ast2.Expr], index: Int, out: Slice[ast2.Expr]) -> Option[Slice[ast2.Expr]]
  if index >= exprs.Len() then
    Some(out)
  else
    switch exprs.Get(index)
      case None => None
      case Some(expr) then
        applyTypedExprsSubstInto(subst, exprs, index + 1, out.Append(applyTypedExprSubst(subst, expr)))
      end
    end
  end
end

func applyTypedSwitchCasesSubst(subst: Subst, cases: Slice[ast2.SwitchCase]) -> Option[Slice[ast2.SwitchCase]]
  applyTypedSwitchCasesSubstInto(subst, cases, 0, [])
end

func applyTypedSwitchCasesSubstInto(subst: Subst, cases: Slice[ast2.SwitchCase], index: Int, out: Slice[ast2.SwitchCase]) -> Option[Slice[ast2.SwitchCase]]
  if index >= cases.Len() then
    Some(out)
  else
    switch cases.Get(index)
      case None => None
      case Some(current) then
        applyTypedSwitchCasesSubstInto(
          subst,
          cases,
          index + 1,
          out.Append(ast2.SwitchCase {
            Pattern: current.Pattern,
            PatternSpan: current.PatternSpan,
            Body: applyTypedExprSubst(subst, current.Body),
            BodySpan: current.BodySpan,
            Span: current.Span,
          })
        )
      end
    end
  end
end

func applyTypedStmtsSubst(subst: Subst, items: Slice[ast2.Stmt]) -> Option[Slice[ast2.Stmt]]
  applyTypedStmtsSubstInto(subst, items, 0, [])
end

func applyTypedStmtsSubstInto(subst: Subst, items: Slice[ast2.Stmt], index: Int, out: Slice[ast2.Stmt]) -> Option[Slice[ast2.Stmt]]
  if index >= items.Len() then
    Some(out)
  else
    switch items.Get(index)
      case None => None
      case Some(current) then
        applyTypedStmtsSubstInto(subst, items, index + 1, out.Append(applyTypedStmtSubst(subst, current)))
      end
    end
  end
end

func applyTypedStmtSubst(subst: Subst, stmt: ast2.Stmt) -> ast2.Stmt
  switch stmt
    case ExprStmt(value) => ast2.Stmt.ExprStmt(applyTypedExprSubst(subst, value))
    case LetStmt(bind) then
      ast2.Stmt.LetStmt(ast2.Bind {
        Name: bind.Name,
        Type: bind.Type,
        Value: applyTypedExprSubst(subst, bind.Value),
      })
    end
    case VarStmt(bind) then
      ast2.Stmt.VarStmt(ast2.Bind {
        Name: bind.Name,
        Type: bind.Type,
        Value: applyTypedExprSubst(subst, bind.Value),
      })
    end
    case WhileStmt(cond, body) then
      ast2.Stmt.WhileStmt(applyTypedExprSubst(subst, cond), applyTypedExprSubst(subst, body))
    end
    case AssignStmt(target, value) then
      ast2.Stmt.AssignStmt(applyTypedExprSubst(subst, target), applyTypedExprSubst(subst, value))
    end
    case ReturnWithStmt(value) => ast2.Stmt.ReturnWithStmt(applyTypedExprSubst(subst, value))
    case _ => stmt
  end
end

func inferMapLit(pairs: Slice[(ast2.Expr, ast2.Expr)], env: Env, s0: InferState) -> Result[(InferResult, Slice[(ast2.Expr, ast2.Expr)]), String]
  if pairs.Len() == 0 then
    let kt = ast2.MonoType.TVar(s0.FreshVarID)
    let vt = ast2.MonoType.TVar(s0.FreshVarID + 1)
    let empty: Slice[(ast2.Expr, ast2.Expr)] = []
    Ok((
      InferResult {
        Type: ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Map")), [kt, vt]),
        Predicates: [],
        Subst: emptySubst(),
        State: withFreshID(s0, s0.FreshVarID + 2),
      },
      empty
    ))
  else
    switch pairs.Get(0)
      case None => Err("malformed map literal: missing first entry")
      case Some(pair) => inferMapLitFirst(pair, pairs, env, s0)
    end
  end
end

func inferMapLitFirst(pair: (ast2.Expr, ast2.Expr), pairs: Slice[(ast2.Expr, ast2.Expr)], env: Env, s0: InferState) -> Result[(InferResult, Slice[(ast2.Expr, ast2.Expr)]), String]
  let (k0, v0) = pair
  let kr = inferExpr(k0, env, s0)
  switch kr
    case Err(msg) => Err("map key: " + msg)
    case Ok(keir) then
      let kv = keir.Result
      let vr = inferExpr(v0, env, kv.State)
      switch vr
        case Err(msg) => Err("map value: " + msg)
        case Ok(eireir) then
          let vv = eireir.Result
          let s1 = composeSubst(vv.Subst, kv.Subst)
          let resultType = ast2.MonoType.TApp(
            Ref.new(ast2.MonoType.TCon("Map")),
            [applySubst(s1, kv.Type), applySubst(s1, vv.Type)]
          )
          inferMapLitTail(
            common2.SliceDrop(pairs, 1),
            env,
            vv.State,
            s1,
            resultType,
            appendPredicates(kv.Predicates, vv.Predicates),
            [(keir.Expr, eireir.Expr)] as Slice[(ast2.Expr, ast2.Expr)]
          )
        end
      end
    end
  end
end

func inferMapLitTail(pairs: Slice[(ast2.Expr, ast2.Expr)], env: Env, s0: InferState, subst: Subst, resultType: ast2.MonoType, predicates: Slice[Predicate], typed: Slice[(ast2.Expr, ast2.Expr)]) -> Result[(InferResult, Slice[(ast2.Expr, ast2.Expr)]), String]
  if pairs.Len() == 0 then
    switch applyTypedMapPairsSubst(subst, typed)
      case None => Err("malformed map literal: missing typed pair")
      case Some(typedPairs) then
        Ok((
          InferResult {
            Type: resultType,
            Predicates: predicates,
            Subst: subst,
            State: s0,
          },
          typedPairs
        ))
      end
    end
  else
    switch pairs.Get(0)
      case None => Err("malformed map literal: missing entry")
      case Some(pair) then
        inferMapLitTailEntry(pair, pairs, env, s0, subst, resultType, predicates, typed)
      end
    end
  end
end

func inferMapLitTailEntry(pair: (ast2.Expr, ast2.Expr), pairs: Slice[(ast2.Expr, ast2.Expr)], env: Env, s0: InferState, subst: Subst, resultType: ast2.MonoType, predicates: Slice[Predicate], typed: Slice[(ast2.Expr, ast2.Expr)]) -> Result[(InferResult, Slice[(ast2.Expr, ast2.Expr)]), String]
  let (k, v) = pair
  let kr = inferExpr(k, env, s0)
  switch kr
    case Err(msg) => Err("map key: " + msg)
    case Ok(eirK) then
      let kv = eirK.Result
      let vr = inferExpr(v, env, kv.State)
      switch vr
        case Err(msg) => Err("map value: " + msg)
        case Ok(eirV) then
          inferMapLitTail(
            common2.SliceDrop(pairs, 1),
            env,
            eirV.Result.State,
            composeSubst(eirV.Result.Subst, composeSubst(kv.Subst, subst)),
            resultType,
            appendPredicates(predicates, appendPredicates(kv.Predicates, eirV.Result.Predicates)),
            typed.Append((eirK.Expr, eirV.Expr))
          )
        end
      end
    end
  end
end

func inferSetLit(items: Slice[ast2.Expr], env: Env, s0: InferState) -> Result[(InferResult, Slice[ast2.Expr]), String]
  switch duplicateSetLiteralElement(items, [])
    case Some(duplicate) => Err(common2.ErrorAtExpr(duplicate, "duplicate element in set literal"))
    case None then
      if items.Len() == 0 then
        let et = ast2.MonoType.TVar(s0.FreshVarID)
        let empty: Slice[ast2.Expr] = []
        Ok((
          InferResult {
            Type: ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Set")), [et]),
            Predicates: [],
            Subst: emptySubst(),
            State: withFreshID(s0, s0.FreshVarID + 1),
          },
          empty
        ))
      else
        switch items.Get(0)
          case None => Err("malformed set literal: missing first element")
          case Some(item) then
            let r0 = inferExpr(item, env, s0)
            switch r0
              case Err(msg) => Err("set element: " + msg)
              case Ok(eir0) then
                let v0 = eir0.Result
                let resultType = ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Set")), [applySubst(v0.Subst, v0.Type)])
                inferSetLitTail(
                  common2.SliceDrop(items, 1),
                  env,
                  v0.State,
                  v0.Subst,
                  resultType,
                  v0.Predicates,
                  [eir0.Expr]
                )
              end
            end
          end
        end
      end
    end
  end
end

# A Set literal is lowered to a Go map literal, where duplicate constant keys
# are invalid. Detect repeated literals here so diagnostics remain in MyGO and
# point to the later, duplicate element. Non-literal expressions are left to
# normal runtime set semantics.
func duplicateSetLiteralElement(items: Slice[ast2.Expr], seen: Slice[String]) -> Option[ast2.Expr]
  if items.Len() == 0 then
    None
  else
    switch items.Get(0)
      case None => duplicateSetLiteralElement(common2.SliceDrop(items, 1), seen)
      case Some(item) then
        switch setLiteralElementKey(item)
          case None => duplicateSetLiteralElement(common2.SliceDrop(items, 1), seen)
          case Some(key) then
            if stringSliceContains(seen, key) then
              Some(item)
            else
              duplicateSetLiteralElement(common2.SliceDrop(items, 1), seen.Append(key))
            end
          end
        end
      end
    end
  end
end

func setLiteralElementKey(item: ast2.Expr) -> Option[String]
  switch item.Kind
    case NumberExpr(value) => Some("number:" + value)
    case StringExpr(value) => Some("string:" + value)
    case RuneExpr(value) => Some("rune:" + value)
    case BoolExpr(value) => Some("bool:" + value.ToString())
    case _ => None
  end
end

func inferSetLitTail(items: Slice[ast2.Expr], env: Env, s0: InferState, subst: Subst, resultType: ast2.MonoType, predicates: Slice[Predicate], typed: Slice[ast2.Expr]) -> Result[(InferResult, Slice[ast2.Expr]), String]
  if items.Len() == 0 then
    switch applyTypedExprsSubst(subst, typed)
      case None => Err("malformed set literal: missing typed element")
      case Some(typedItems) then
        Ok((
          InferResult {
            Type: resultType,
            Predicates: predicates,
            Subst: subst,
            State: s0,
          },
          typedItems
        ))
      end
    end
  else
    switch items.Get(0)
      case None => Err("malformed set literal: missing element")
      case Some(item) then
        let r = inferExpr(item, env, s0)
        switch r
          case Err(msg) => Err("set element: " + msg)
          case Ok(eir) then
            inferSetLitTail(
              common2.SliceDrop(items, 1),
              env,
              eir.Result.State,
              composeSubst(eir.Result.Subst, subst),
              resultType,
              appendPredicates(predicates, eir.Result.Predicates),
              typed.Append(eir.Expr)
            )
          end
        end
      end
    end
  end
end

func maxSubstID(subst: Subst) -> Int
  subst.MaxID
end

# findSymbol resolves a `TypeName::Field` selector through the constant-time
# symbol index carried by InferState, replacing the former linear scan over
# the whole Symbols slice (O(#symbols) per selector) with a map lookup.
func findSymbol(typeName: String, field: String, index: Map[String, Symbol]) -> Option[Symbol]
  index.Get(symbolKey(typeName, field))
end
