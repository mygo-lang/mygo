package typeinference2

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import importer "go:go/importer"
import gotypes "go:go/types"
import strings "go:strings"

# Predeclare function signatures so a declaration can call functions defined
# later in the same source file. This is required by the self-hosted modules,
# whose mutually-recursive helpers are intentionally grouped by concern.
#
# `env` is assumed to already contain seeded imports (e.g. via
# seedMyGoPackageEnv) so that any `alias.Name` references in the signature
# resolve through the env and end up wrapped in TQualifiedName with the
# package's canonical import path.
func predeclareFunctions(decls: Slice[ast2.Decl], env: Env) -> Env
  predeclareFunctionsWithState(decls, env, NewInferState())
end

func predeclareFunctionsWithState(decls: Slice[ast2.Decl], env: Env, state: InferState) -> Env
  if decls.Len() == 0 then
    env
  else
    let decl = decls.Get(0).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    let next = switch decl
      case TypeAliasDecl(name, tps, target) =>
        envPut(env, name, Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: typeFromASTInEnvWithParams(target, tps, env, state) })
      case TypeDecl(name, tps, _) =>
        envPut(env, name, Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: declaredType(name, tps) })
      case LetDecl(bind) =>
        switch bind.Type
          case Some(typ) => envPut(env, bind.Name, Scheme { Bound: [], Predicates: [], Body: typeFromASTInEnvWithParams(typ, [], env, state) })
          case None => env
        end
      case VarDecl(bind) =>
        switch bind.Type
          case Some(typ) => envPut(env, bind.Name, Scheme { Bound: [], Predicates: [], Body: typeFromASTInEnvWithParams(typ, [], env, state) })
          case None => env
        end
      case FuncDecl(name, tps, params, ret, _, constraints) =>
        let retType = switch ret
          case Some(t) => typeFromASTInEnvWithParams(t, tps, env, state)
          case None => ast2.MonoType.TUnit
        end
        envPut(env, name, Scheme { Bound: typeParamIDs(tps, 1), Predicates: predicatesFromConstraintsWithParams(constraints, tps), Body: ast2.MonoType.TFunc(paramsToTypesWithParamsInEnv(params, tps, env, state), Ref.new(retType)) })
      case EnumDecl(name, tps, vars) =>
        predeclareEnum(env, name, tps, vars)
      case _ => env
    end
    predeclareFunctionsWithState(sliceDrop(decls, 1), next, state)
  end
end

func declaredType(name: String, tps: Slice[String]) -> ast2.MonoType
  if tps.Len() == 0 then ast2.MonoType.TCon(name) else ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon(name)), typeParamsAsTypes(tps, 1)) end
end

func predeclareEnum(env: Env, name: String, tps: Slice[String], vars: Slice[ast2.Variant]) -> Env
  let enumType = tCon(name, typeParamsAsTypes(tps, 1))
  let envWithEnum = envPut(env, name, Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: enumType })
  predeclareEnumVariants(envWithEnum, vars, name, tps, NewInferState())
end

func predeclareEnumVariants(env: Env, vars: Slice[ast2.Variant], name: String, tps: Slice[String], state: InferState) -> Env
  if vars.Len() == 0 then env else
    let v = vars.Get(0).UnwrapOr(ast2.Variant { Name: "", Fields: emptyASTTypeExprs() })
    let enumType = tCon(name, typeParamsAsTypes(tps, 1))
    let constructorType = if v.Fields.Len() == 0 then enumType else ast2.MonoType.TFunc(typeArgsFromASTInEnvWithParamsList(v.Fields, tps, env, state), Ref.new(enumType)) end
    predeclareEnumVariants(envPut(env, v.Name, Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: constructorType }), sliceDrop(vars, 1), name, tps, state)
  end
end

func inferDecls(decls: Slice[ast2.Decl], env: Env, fields: Slice[FieldEntry], state: InferState) -> Result[PackageInfo, String]
  if decls.Len() == 0 then
    Ok(PackageInfo { Env: env.ToSlice(), Fields: fields, GoPackages: [] as Slice[GoPackageEntry], Instances: [] as Slice[Instance], Solver: newSolver(), TypedDecls: [] as Slice[ast2.Decl], ExternalTypedDecls: [] as Slice[ast2.Decl], TypedDeclSources: [] as Slice[PkgDeclSource], ExternalTypedDeclSources: [] as Slice[PkgDeclSource], ResolvedConstraintArgs: state.ResolvedConstraintArgs })
  else
    let head = decls.Get(0).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    let tail = sliceDrop(decls, 1)
    let next = inferDecl(head, env, fields, state)
    switch next
      case Ok(pair) =>
        let rest = inferDecls(tail, pair.Env, pair.Fields, pair.State)
        switch rest
          case Ok(info) =>
            let newDecls = switch pair.TypedDecl
              case Some(d) => info.TypedDecls.Prepend(d)
              case None => info.TypedDecls
            end
            Ok(PackageInfo { Env: info.Env, Fields: info.Fields, GoPackages: info.GoPackages, Instances: info.Instances, Solver: info.Solver, TypedDecls: newDecls, ExternalTypedDecls: info.ExternalTypedDecls, TypedDeclSources: info.TypedDeclSources, ExternalTypedDeclSources: info.ExternalTypedDeclSources, ResolvedConstraintArgs: info.ResolvedConstraintArgs })
          case Err(m) => Err(m)
        end
      case Err(msg) => Err(msg)
    end
  end
end

func inferDecl(decl: ast2.Decl, env: Env, fields: Slice[FieldEntry], state: InferState) -> Result[DeclInfer, String]
  switch decl
    case ImportDecl(_, _) => Ok(DeclInfer { Env: env, Fields: fields, State: state, TypedDecl: None})
    case LetDecl(bind) => inferPackageBinding(bind, false, env, fields, state)
    case VarDecl(bind) => inferPackageBinding(bind, true, env, fields, state)
    case TypeAliasDecl(_, _, _) => Ok(DeclInfer { Env: env, Fields: fields, State: state, TypedDecl: Some(decl) })
    case TypeDecl(_, _, _) => Ok(DeclInfer { Env: env, Fields: fields, State: state, TypedDecl: Some(decl) })
    case StructDecl(name, tps, structFields) =>
      let newSymbols = structSymbolsInEnv(name, structFields, tps, env, state, [] as Slice[Symbol])
      let stateWithSymbols = InferState {
        FreshVarID: state.FreshVarID,
        PkgInfo: state.PkgInfo,
        GoPackages: state.GoPackages,
        MyGoPackages: state.MyGoPackages,
        MyGoPackageCache: state.MyGoPackageCache,
        Symbols: concatSymbols(newSymbols, state.Symbols),
        ActiveConstraints: state.ActiveConstraints,
        NamedImpls: state.NamedImpls,
        ResolvedConstraintArgs: state.ResolvedConstraintArgs,
      }
      Ok(DeclInfer {
        Env: envWithStructFields(envPut(env, name, Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: tCon(name, typeParamsAsTypes(tps, 1)) }), name, tps, structFields),
        Fields: fieldsForStructInEnv(name, structFields, tps, env, state, fields),
        State: stateWithSymbols,
        TypedDecl: Some(decl),
      })
    case EnumDecl(name, tps, vars) then
      let res = inferVariants(vars, name, tps, env, fields, state)
      switch res
        case Ok(di) => Ok(DeclInfer { Env: di.Env, Fields: di.Fields, State: di.State, TypedDecl: Some(decl)})
        case Err(m) => Err(m)
      end
    end
    case InterfaceDecl(name, _, _) =>
      Ok(DeclInfer { Env: envPut(env, name, Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon(name) }), Fields: fields, State: state, TypedDecl: Some(decl)})
    case ImplDecl(tps, target, iface, methods) =>
      let receiverName = implReceiverName(target, iface)
      let implSyms = implMethodSymbols(receiverName, tps, methods, env, [] as Slice[Symbol])
      let stateWithSyms = InferState {
        FreshVarID: state.FreshVarID,
        PkgInfo: state.PkgInfo,
        GoPackages: state.GoPackages,
        MyGoPackages: state.MyGoPackages,
        MyGoPackageCache: state.MyGoPackageCache,
        Symbols: concatSymbols(state.Symbols, implSyms),
        ActiveConstraints: state.ActiveConstraints,
        NamedImpls: state.NamedImpls,
        ResolvedConstraintArgs: state.ResolvedConstraintArgs,
      }
      let res = inferImplMethods(methods, tps, env, fields, stateWithSyms, [] as Slice[ast2.ImplMethod], receiverName)
      switch res
        case Ok(pair) then
          let (typedMethods, newState) = pair
          Ok(DeclInfer { Env: env, Fields: fields, State: newState, TypedDecl: Some(ast2.Decl.ImplDecl(tps, target, iface, typedMethods)) })
        end
        case Err(m) => Err(m)
      end
    case FuncDecl(name, tps, params, ret, body, constraints) =>
      inferFuncDecl(name, tps, params, ret, body, constraints, env, fields, state)
  end
end

func inferPackageBinding(bind: ast2.Bind, mutable: Bool, env: Env, fields: Slice[FieldEntry], state: InferState) -> Result[DeclInfer, String]
  let inferred = inferBlockBind(bind, mutable, env, state)
  switch inferred
    case Err(msg) => Err(msg)
    case Ok(step) =>
      let typed = switch step.Stmt
        case LetStmt(value) => ast2.Decl.LetDecl(value)
        case VarStmt(value) => ast2.Decl.VarDecl(value)
        case _ => ast2.Decl.LetDecl(bind)
      end
      Ok(DeclInfer { Env: step.Env, Fields: fields, State: step.Result.State, TypedDecl: Some(typed) })
  end
end

func inferFuncDecl(name: String, tps: Slice[String], params: Slice[ast2.Param], ret: Option[ast2.TypeExpr], body: ast2.Expr, constraints: Slice[ast2.Constraint], env: Env, fields: Slice[FieldEntry], state: InferState) -> Result[DeclInfer, String]
  # Resolve parameter and return types against the running env so that
  # dot-name references (e.g. `ps.Parser`) collapse to a TQualifiedName
  # whose first field is the package's import path.  This keeps
  # `ps.ParseInput(fileParser(), input)` consistent: the callee's parameter
  # type and the call-site argument type share the same canonical path.
  let paramTypes = paramsToTypesWithParamsInEnv(params, tps, env, state)
  let retType = switch ret
    case Some(t) => typeFromASTInEnvWithParams(t, tps, env, state)
    case None => ast2.MonoType.TUnit
  end
  let fnType = ast2.MonoType.TFunc(paramTypes, Ref.new(retType))
  let predicates = predicatesFromConstraintsWithParams(constraints, tps)
  let envWithSig = envPut(env, name, Scheme { Bound: typeParamIDs(tps, 1), Predicates: predicates, Body: fnType })
  let bodyEnv = envWithTypeParams(envWithParamsAndTypes(envWithSig, params, paramTypes), tps)
  # Method-call syntax within a function body must see the function's `using`
  # predicates. Otherwise `value.Show()` is left as a plain selector call even
  # though codegen has injected the corresponding ShowFn dictionary parameter.
  let bodyState = withActiveConstraints(state, predicates)
  let inferred = inferExpr(body, bodyEnv, bodyState)
  switch inferred
    case Ok(eir) then
      let r = eir.Result
      let inferredType = applySubst(r.Subst, r.Type)
      let checked = if isGoBoundaryTuple(inferredType, retType) then Ok(r.Subst) else unify(inferredType, retType, r.Subst) end
      switch checked
        case Ok(s2) then
          let typedBody = applyTypedExprSubst(s2, eir.Expr)
          Ok(DeclInfer {
            Env: envPut(env, name, Scheme {
              Bound: typeParamIDs(tps, 1),
              Predicates: predicates,
              Body: applySubst(s2, fnType)
            }),
            Fields: fields,
            # Function-local constraints must not leak into following package
            # declarations, while fresh IDs and other inference state updates
            # from the body remain available.
            State: withActiveConstraints(r.State, state.ActiveConstraints),
            TypedDecl: Some(ast2.Decl.FuncDecl(name, tps, params, ret, typedBody, constraints)),
          })
        end
        case Err(msg) => Err(functionBodyError(body, name, "return type mismatch: " + msg + " [inferred=" + MonoStringFull(inferredType) + " ret=" + MonoStringFull(retType) + "]"))
      end
    end
    case Err(msg) => Err(functionBodyError(body, name, msg))
  end
end

func inferImplMethods(methods: Slice[ast2.ImplMethod], tps: Slice[String], env: Env, fields: Slice[FieldEntry], state: InferState, out: Slice[ast2.ImplMethod], receiverName: String) -> Result[(Slice[ast2.ImplMethod], InferState), String]
  if methods.Len() == 0 then
    Ok((out, state))
  else
    let m = methods.Get(0).UnwrapOr(ast2.ImplMethod { Pos: ast2.SourcePos{SourceName: "", Line: 0, Column: 0}, Sig: ast2.FuncSig { Pos: ast2.SourcePos{SourceName: "", Line: 0, Column: 0}, Name: "", TypeParams: [] as Slice[String], Params: [] as Slice[ast2.Param], Ret: None, Using: [] as Slice[ast2.Constraint] }, Body: ast2.EmptyExpr() })
    let sig = m.Sig
    let combined = appendStringSlice(tps, sig.TypeParams)
    let paramTypes = paramsToTypesWithParamsInEnv(sig.Params, combined, env, state)
    let bodyEnv = envWithTypeParams(envWithParamsAndTypes(env, sig.Params, paramTypes), combined)
    let methodState = withActiveConstraints(state, predicatesFromConstraintsWithParams(sig.Using, combined))
    let inferred = inferExpr(m.Body, bodyEnv, methodState)
    switch inferred
    case Ok(eir) then
        let typedBody = applyTypedExprSubst(eir.Result.Subst, eir.Expr)
        let typedMethod = ast2.ImplMethod { Pos: m.Pos, Sig: sig, Body: typedBody }
        # The predicates collected from the body are instantiated at each
        # method-call site.  Their TVar IDs are therefore local inference
        # details (and a method may collect the same predicate more than
        # once).  Store the method's declared constraints instead: these
        # retain the declared constraint identity used by codegen dispatch.
        let newState = withActiveConstraints(storeResolvedConstraintArgs(receiverName, sig, combined, eir.Result.State), state.ActiveConstraints)
        inferImplMethods(sliceDrop(methods, 1), tps, env, fields, newState, out.Append(typedMethod), receiverName)
      end
      case Err(msg) => Err(msg)
    end
  end
end

func storeResolvedConstraintArgs(receiverName: String, sig: ast2.FuncSig, typeParams: Slice[String], state: InferState) -> InferState
  storeMethodConstraintArgs(receiverName, sig.Name, sig.Using, typeParams, state)
end

# Store each `using` entry under its own identity.  Methods such as Equals
# commonly occur in multiple constraints, so {receiver, method} alone cannot
# distinguish Eq[A] from Eq[E] or a named impl such as ResultEq[A, E].
func storeMethodConstraintArgs(receiverName: String, methodName: String, constraints: Slice[ast2.Constraint], typeParams: Slice[String], state: InferState) -> InferState
  if constraints.Len() == 0 then
    state
  else
    let constraint = constraints.Get(0).UnwrapOr(ast2.Constraint { Name: "", BindName: None, Args: [] as Slice[ast2.TypeExpr] })
    let args = typeArgsFromASTWithParams(constraint.Args, typeParams)
    let key = MethodConstraintKey { Receiver: receiverName, Constraint: methodConstraintRef(constraint.Name, state.NamedImpls), ArgsKey: constraintArgsKey(args), Method: methodName }
    state.ResolvedConstraintArgs.Set(key, args)
    storeMethodConstraintArgs(receiverName, methodName, sliceDrop(constraints, 1), typeParams, state)
  end
end

func constraintArgsKey(args: Slice[ast2.MonoType]) -> String
  constraintArgsKeyLoop(args, 0, "")
end

func constraintArgsKeyLoop(args: Slice[ast2.MonoType], index: Int, out: String) -> String
  if index >= args.Len() then out else
    let item = args.Get(index).UnwrapOr(ast2.MonoType.TUnit)
    let next = if out == "" then monoStringFull(item) else out + "," + monoStringFull(item) end
    constraintArgsKeyLoop(args, index + 1, next)
  end
end

func methodConstraintRef(name: String, namedImpls: Slice[String]) -> MethodConstraintRef
  if stringSliceContains(namedImpls, name) then MethodConstraintRef.NamedImpl(name) else MethodConstraintRef.Interface(name) end
end

func stringSliceContains(items: Slice[String], wanted: String) -> Bool
  if items.Len() == 0 then false else
    if items.Get(0).UnwrapOr("") == wanted then true else stringSliceContains(sliceDrop(items, 1), wanted) end
  end
end

func collectResolvedMonos(predicates: Slice[Predicate], index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= predicates.Len() then out else
    let p = predicates.Get(index).UnwrapOr(Predicate { ClassName: "", Args: [] as Slice[ast2.MonoType] })
    let arg = p.Args.Get(0).UnwrapOr(ast2.MonoType.TUnit)
    collectResolvedMonos(predicates, index + 1, out.Append(arg))
  end
end

func isGoBoundaryTuple(inferred: ast2.MonoType, expected: ast2.MonoType) -> Bool
  switch inferred
    case TTuple(items) =>
      switch expected
        case TApp(typeRef, _) then
          switch typeRef.value()
            case TCon(name) => (name == "Option" || name == "Result") && items.Len() == 2
            case _ => false
          end
        end
        case _ => false
      end
    case _ => false
  end
end

# Convert parser constraints to inference predicates. Resolution is deliberately
# deferred: a predicate may mention a type parameter and must survive until a
# call site supplies concrete arguments.
func predicatesFromConstraintsWithParams(items: Slice[ast2.Constraint], params: Slice[String]) -> Slice[Predicate]
  predicatesFromConstraintsWithParamsInto(items, params, 0, [])
end

func predicatesFromConstraintsWithParamsInto(items: Slice[ast2.Constraint], params: Slice[String], index: Int, out: Slice[Predicate]) -> Slice[Predicate]
  if index >= items.Len() then out else
    let item = items.Get(index).UnwrapOr(ast2.Constraint { Name: "", BindName: None, Args: [] as Slice[ast2.TypeExpr] })
    predicatesFromConstraintsWithParamsInto(items, params, index + 1, out.Append(Predicate { ClassName: item.Name, Args: typeArgsFromASTWithParams(item.Args, params) }))
  end
end

func inferExpr(expr: ast2.Expr, env: Env, state: InferState) -> Result[ExprInferResult, String]
  let result = inferExprInner(expr, env, state)
  switch result
    case Ok(eir) then
      # Preserve the local inferred type while composing parent substitutions.
      # A completed declaration/block normalises its typed subtree once; doing
      # so at every expression boundary repeatedly expands the same type.
      let typedExpr = ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: eir.Expr.Kind, Type: Some(eir.Result.Type) }
      let nextState = recordInferredExprType(typedExpr, eir.Result.Type, eir.Result.Predicates, eir.Result.Subst, eir.Result.State)
      Ok(ExprInferResult { Expr: typedExpr, Result: InferResult { Type: eir.Result.Type, Predicates: eir.Result.Predicates, Subst: eir.Result.Subst, State: nextState } })
    end
    case Err(msg) => Err(errorAtExpr(expr, msg))
  end
end

func recordInferredExprType(expr: ast2.Expr, typ: ast2.MonoType, preds: Slice[Predicate], subst: Subst, state: InferState) -> InferState
  state
end

func errorAtExpr(expr: ast2.Expr, msg: String) -> String
  if strings.Contains(msg, ":") then
    msg
  else
    let source = if expr.Pos.SourceName == "" then "<input>" else expr.Pos.SourceName end
    source + ":" + expr.Pos.Line.ToString() + ":" + expr.Pos.Column.ToString() + ": " + msg
  end
end

# Function-level wrappers used to add `function name:` before the expression
# error reached errorAtExpr. That colon made errorAtExpr assume the message was
# already located, dropping the source position altogether. Attach the body's
# position before adding the function context instead.
func functionBodyError(body: ast2.Expr, name: String, msg: String) -> String
  let source = if body.Pos.SourceName == "" then "<input>" else body.Pos.SourceName end
  source + ":" + body.Pos.Line.ToString() + ":" + body.Pos.Column.ToString() + ": function " + name + ": " + msg
end

func mkTyped(expr: ast2.Expr, t: ast2.MonoType, state: InferState, exprKind: Option[ast2.ExprKind]) -> ExprInferResult
  let kind = switch exprKind
    case Some(k) => k
    case None => expr.Kind
  end
  let te = ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: kind, Type: Some(t) }
  ExprInferResult { Expr: te, Result: InferResult { Type: t, Predicates: [], Subst: emptySubst(), State: state } }
end

struct ExprInferResult
  Expr: ast2.Expr
  Result: InferResult
end

func inferExprInner(expr: ast2.Expr, env: Env, state: InferState) -> Result[ExprInferResult, String]
  switch expr.Kind
    case IdentExpr(name) =>
      switch envGet(env, name)
        case Some(s) then
          let q = instantiateQualified(s, state)
          let te = ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: expr.Kind, Type: Some(q.Body) }
          Ok(ExprInferResult { Expr: te, Result: InferResult { Type: q.Body, Predicates: q.Predicates, Subst: emptySubst(), State: withFreshID(state, state.FreshVarID + s.Bound.Len()) } })
        end
        case None => Err("unknown identifier " + name)
      end
    case NumberExpr(value) => Ok(mkTyped(expr, numberLiteralType(value), state, None))
    case StringExpr(_) => Ok(mkTyped(expr, ast2.MonoType.TCon("String"), state, None))
    case RuneExpr(_) => Ok(mkTyped(expr, ast2.MonoType.TCon("Rune"), state, None))
    case BoolExpr(_) => Ok(mkTyped(expr, ast2.MonoType.TCon("Bool"), state, None))
    case UnitExpr => Ok(mkTyped(expr, ast2.MonoType.TUnit, state, None))
    case SliceLitExpr(items) then
      let r = inferSlice(items, env, state)
      switch r
        case Ok(pair) =>
          let (v, typedItems) = pair
          let typedKind = ast2.ExprKind.SliceLitExpr(typedItems)
          let result = InferResult { Type: v.Type, Predicates: v.Predicates, Subst: v.Subst, State: v.State }
          Ok(ExprInferResult { Expr: ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: typedKind, Type: Some(v.Type) }, Result: result })
        case Err(m) => Err(m)
      end
    end
    case TypeAsExpr(value, typ) then
      let r = inferTypeAs(value, typ, env, state)
      switch r
        case Ok(pair) then
          let (v, typedValue) = pair
          let typedKind = ast2.ExprKind.TypeAsExpr(applyTypedExprSubst(v.Subst, typedValue), typ)
          let result = InferResult { Type: v.Type, Predicates: v.Predicates, Subst: v.Subst, State: v.State }
          Ok(ExprInferResult { Expr: ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: typedKind, Type: Some(result.Type) }, Result: result })
        end
        case Err(m) => Err(m)
      end
    end
    case TupleExpr(items) then
      let r = inferTuple(items, env, state)
      switch r
        case Ok(pair) =>
          let (v, typedItems) = pair
          let typedKind = ast2.ExprKind.TupleExpr(typedItems)
          let result = InferResult { Type: v.Type, Predicates: v.Predicates, Subst: v.Subst, State: v.State }
          Ok(ExprInferResult { Expr: ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: typedKind, Type: Some(v.Type) }, Result: result })
        case Err(m) => Err(m)
      end
    end
    case UnaryExpr(op, inner) => inferUnary(expr, op, inner, env, state)
    case BinaryExpr(op, left, right) then
      let r = inferBinary(expr, op, left, right, env, state)
      switch r
        case Ok(eir) => Ok(eir)
        case Err(m) => Err(m)
      end
    end
    case CallExpr(callee, typeArgs, args) then
      let r = inferCall(callee, typeArgs, args, env, state)
      switch r
        # inferCall constructs the typed call itself.  Keeping the parsed
        # expression here used to discard DictionaryCallExpr annotations.
        case Ok(eir) => Ok(eir)
        case Err(m) => Err(m)
      end
    end
    case FieldExpr(base, field) then
      let res = inferField(base, field, env, state)
      switch res
        case Ok(eir) then
          # A selector can be used immediately as an impl-method receiver
          # (`tail.Value.Prepend(...)`).  Persist its fully substituted type
          # in the typed AST so codegen does not have to recover it from the
          # surrounding expression's potentially stale substitutions.
          let resolvedType = applySubst(eir.Result.Subst, eir.Result.Type)
          let te = ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: ast2.ExprKind.FieldExpr(eir.Expr, field), Type: Some(resolvedType) }
          Ok(ExprInferResult { Expr: te, Result: eir.Result })
        end
        case Err(msg) => Err(msg)
      end
    end
    case IfExpr(cond, thenExpr, elseExpr) => inferIf(expr, cond, thenExpr, elseExpr, env, state)
    case SwitchExpr(target, cases, _) then
      let r = inferSwitch(target, cases, env, state)
      switch r
        # inferSwitch already returns the fully reconstructed typed switch,
        # including its inferred case bodies.
        case Ok(eir) => Ok(eir)
        case Err(m) => Err(m)
      end
    end
    case BlockExpr(items) then
      let r = inferTypedBlock(items, env, state)
      switch r
        case Ok(pair) then
          let (v, typedItems) = pair
          let typedKind = ast2.ExprKind.BlockExpr(typedItems)
          Ok(mkTyped(expr, v.Type, v.State, Some(typedKind)))
        end
        case Err(m) => Err(m)
      end
    end
    case FuncLitExpr(params, ret, body) then
      let r = inferFuncLit(params, ret, body, env, state)
      switch r
        case Ok(eir) =>
          let typedKind = ast2.ExprKind.FuncLitExpr(params, ret, eir.Expr)
          Ok(ExprInferResult { Expr: ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: typedKind, Type: Some(eir.Result.Type) }, Result: eir.Result })
        case Err(m) => Err(m)
      end
    end
    case StructLitExpr(typeName, fields) then
      let r = inferTypedStructLit(typeName, fields, env, state)
      switch r
        case Ok(pair) then
          let (v, typedFields) = pair
          let typedKind = ast2.ExprKind.StructLitExpr(typeName, typedFields)
          Ok(ExprInferResult { Expr: ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: typedKind, Type: Some(v.Type) }, Result: v })
        end
        case Err(m) => Err(m)
      end
    end
    case GenericStructLitExpr(typeName, typeArgs, fields) then
      # Resolve qualified constructors (for example `ps.Reply[A]`) through
      # the import environment, just like annotated function return types.
      let resultType = typeFromASTInEnv(ast2.TypeExpr.NamedType(typeName, typeArgs), env, state)
      let r = inferTypedStructLitForType(resultType, fields, env, state)
      switch r
        case Ok(pair) then
          let (v, typedFields) = pair
          let result = InferResult { Type: resultType, Predicates: v.Predicates, Subst: v.Subst, State: v.State }
          let typedKind = ast2.ExprKind.GenericStructLitExpr(typeName, typeArgs, typedFields)
          Ok(ExprInferResult { Expr: ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: typedKind, Type: Some(resultType) }, Result: result })
        end
        case Err(m) => Err(m)
      end
    end
    case MapLitExpr(pairs) then
      let r = inferMapLit(pairs, env, state)
      switch r
        case Ok(pair) =>
          let (v, typedPairs) = pair
          let typedKind = ast2.ExprKind.MapLitExpr(typedPairs)
          let result = InferResult { Type: v.Type, Predicates: v.Predicates, Subst: v.Subst, State: v.State }
          Ok(ExprInferResult { Expr: ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: typedKind, Type: Some(v.Type) }, Result: result })
        case Err(m) => Err(m)
      end
    end
    case SetLitExpr(items) then
      let r = inferSetLit(items, env, state)
      switch r
        case Ok(pair) =>
          let (v, typedItems) = pair
          let typedKind = ast2.ExprKind.SetLitExpr(typedItems)
          let result = InferResult { Type: v.Type, Predicates: v.Predicates, Subst: v.Subst, State: v.State }
          Ok(ExprInferResult { Expr: ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: typedKind, Type: Some(v.Type) }, Result: result })
        case Err(m) => Err(m)
      end
    end
    case InlineGoExpr(typ, _, _, _) then
      # An inline Go block declares its native Go result shape (for example
      # `go[((), error)]`).  Like a Go FFI signature, a 2-tuple result follows
      # the boundary convention: (T, error) -> Result[T, error] and
      # (T, bool) -> Option[T].  The raw tuple shape remains available through
      # tuple destructuring (ffiRawTupleResultType).
      let mono = inlineGoResultMono(typeFromASTInEnv(typ.value(), env, state))
      Ok(mkTyped(expr, mono, state, None))
    end
  end
end

# Numeric suffixes are part of the source literal, not merely code-generation
# decoration.  Preserve their type through inference so an annotated binding
# such as `let value: Int8 = 42i8` unifies as expected.
func numberLiteralType(value: String) -> ast2.MonoType
  let lower = strings.ToLower(value)
  let name = if strings.HasSuffix(lower, "i8") then "Int8"
    elsif strings.HasSuffix(lower, "i16") then "Int16"
    elsif strings.HasSuffix(lower, "i32") then "Int32"
    elsif strings.HasSuffix(lower, "i64") then "Int64"
    elsif strings.HasSuffix(lower, "u8") then "UInt8"
    elsif strings.HasSuffix(lower, "u16") then "UInt16"
    elsif strings.HasSuffix(lower, "u32") then "UInt32"
    elsif strings.HasSuffix(lower, "u64") then "UInt64"
    elsif strings.HasSuffix(lower, "u") then "UInt"
    elsif strings.HasSuffix(lower, "f32") then "Float32"
    elsif strings.HasSuffix(lower, "f64") then "Float64"
    elsif strings.Contains(value, ".") then "Float64"
    else "Int"
  end
  ast2.MonoType.TCon(name)
end

func inferFuncLit(params: Slice[ast2.Param], ret: Option[ast2.TypeExpr], body: ast2.Expr, env: Env, state: InferState) -> Result[ExprInferResult, String]
  let paramTypes = paramsToTypesInEnv(params, env, state)
  let retType = switch ret
    case Some(t) => typeFromASTInEnv(t, env, state)
    case None => ast2.MonoType.TUnit
  end
  # Build the body environment from the SAME resolved param types used for the
  # function's signature.  Using envWithParams (which calls typeFromAST) would
  # mis-resolve references to outer type parameters (e.g. `A` inside a generic
  # function) as bare `TCon("A")` constructors, diverging from `paramTypes`
  # (which resolves them to the outer `TVar(-1)`) and producing an internally
  # inconsistent function type.
  let bodyEnv = envWithParamsAndTypes(env, params, paramTypes)
  let inferred = inferExpr(body, bodyEnv, state)
  switch inferred
    case Err(msg) => Err("function literal: " + msg)
    case Ok(eir) =>
      let r = eir.Result
      let bodyApplied = applySubst(r.Subst, r.Type)
      let checked = unify(bodyApplied, retType, r.Subst)
      switch checked
        case Err(msg) => Err("function literal return type mismatch: " + msg)
        case Ok(subst) then
          let ftyp = ast2.MonoType.TFunc(paramTypes, Ref.new(applySubst(subst, retType)))
          let typedBody = applyTypedExprSubst(subst, eir.Expr)
          Ok(ExprInferResult { Expr: typedBody, Result: InferResult { Type: ftyp, Predicates: r.Predicates, Subst: subst, State: r.State } })
        end
      end
  end
end

func inferGenericStructLit(typeName: String, typeArgs: Slice[ast2.TypeExpr], fields: Slice[ast2.StructLitField], env: Env, state: InferState) -> Result[InferResult, String]
  let checked = inferStructLit(typeName, fields, env, state)
  switch checked
    case Err(msg) => Err(msg)
    case Ok(value) then
      let resultType = tCon(typeName, typeArgsFromASTInEnv(typeArgs, env, state))
      Ok(InferResult { Type: resultType, Predicates: value.Predicates, Subst: value.Subst, State: value.State })
    end
  end
end

func inferTypeAs(value: ast2.Expr, typ: ast2.TypeExpr, env: Env, state: InferState) -> Result[(InferResult, ast2.Expr), String]
  let inferred = inferExpr(value, env, state)
  let expected = typeFromASTInEnv(typ, env, state)
  switch inferred
    case Err(msg) => Err(msg)
    case Ok(eir) then
      let v = eir.Result
      let matched = unify(v.Type, expected, v.Subst)
      switch matched
        case Ok(s) => Ok((InferResult { Type: applySubst(s, expected), Predicates: v.Predicates, Subst: s, State: v.State }, applyTypedExprSubst(s, eir.Expr)))
        case Err(_) => Ok((InferResult { Type: expected, Predicates: v.Predicates, Subst: v.Subst, State: v.State }, applyTypedExprSubst(v.Subst, eir.Expr)))
      end
    end
  end
end

func inferSlice(items: Slice[ast2.Expr], env: Env, state: InferState) -> Result[(InferResult, Slice[ast2.Expr]), String]
  if items.Len() == 0 then
    let element = ast2.MonoType.TVar(state.FreshVarID)
    let empty: Slice[ast2.Expr] = []
    Ok((InferResult { Type: ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Slice")), [element]), Predicates: [], Subst: emptySubst(), State: withFreshID(state, state.FreshVarID + 1) }, empty))
  else
    let first = inferExpr(items.Get(0).UnwrapOr(ast2.EmptyExpr()), env, state)
    switch first
      case Err(msg) => Err(msg)
      case Ok(eir) => inferSliceItems(sliceDrop(items, 1), eir.Result.Type, env, eir.Result.State, eir.Result.Subst, [eir.Expr])
    end
  end
end

func inferSliceItems(items: Slice[ast2.Expr], element: ast2.MonoType, env: Env, state: InferState, subst: Subst, typed: Slice[ast2.Expr]) -> Result[(InferResult, Slice[ast2.Expr]), String]
  if items.Len() == 0 then
    Ok((InferResult { Type: ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Slice")), [applySubst(subst, element)]), Predicates: [], Subst: subst, State: state }, applyTypedExprsSubst(subst, typed)))
  else
    let next = inferExpr(items.Get(0).UnwrapOr(ast2.EmptyExpr()), env, state)
    switch next
      case Err(msg) => Err(msg)
      case Ok(eir) then
        let value = eir.Result
        let combined = unify(applySubst(value.Subst, element), applySubst(value.Subst, value.Type), composeSubst(value.Subst, subst))
        switch combined
          case Err(msg) => Err("slice element type mismatch: " + msg)
          case Ok(s) => inferSliceItems(sliceDrop(items, 1), element, env, value.State, s, typed.Append(eir.Expr))
        end
      end
    end
  end
end

func inferSwitch(target: ast2.Expr, cases: Slice[ast2.SwitchCase], env: Env, state: InferState) -> Result[ExprInferResult, String]
  let matched = inferExpr(target, env, state)
  switch matched
    case Err(msg) => Err(msg)
    case Ok(eir) then
      let value = eir.Result
      # Pattern bindings must start from the target after its inference
      # substitutions.  Otherwise `Some(e)` receives a fresh type variable
      # instead of `ParseError`, and selectors such as `e.Expected` lose their
      # Expr.Type before code generation.
      let resolvedTarget = applySubst(value.Subst, value.Type)
      # The switch target is consumed by codegen after this inference scope
      # has gone away. Persist its fully substituted type directly on the
      # target node; relying on an outer expression copy can otherwise lose
      # the annotation for a local binding inside nested function literals.
      let typedTarget = ast2.Expr { ID: eir.Expr.ID, Pos: eir.Expr.Pos, Kind: eir.Expr.Kind, Type: Some(resolvedTarget) }
      let next = inferTypedSwitchCases(cases, resolvedTarget, env, value.State, value.Subst, None, value.Predicates, [] as Slice[ast2.SwitchCase])
      switch next
        case Err(msg) => Err(msg)
        case Ok(pair) then
          let (r, typedCases) = pair
          let typedExpr = ast2.Expr { ID: 0, Pos: typedTarget.Pos, Kind: ast2.ExprKind.SwitchExpr(typedTarget, typedCases, Some(resolvedTarget)), Type: Some(r.Type) }
          Ok(ExprInferResult { Expr: typedExpr, Result: r })
        end
      end
    end
  end
end

# Preserve the inferred case bodies in the typed AST.  In particular this
# carries DictionaryCallExpr annotations out of nested matches to codegen2.
func inferTypedSwitchCases(cases: Slice[ast2.SwitchCase], targetType: ast2.MonoType, env: Env, state: InferState, subst: Subst, resultType: Option[ast2.MonoType], predicates: Slice[Predicate], out: Slice[ast2.SwitchCase]) -> Result[(InferResult, Slice[ast2.SwitchCase]), String]
  if cases.Len() == 0 then
    switch resultType
      case Some(t) => Ok((InferResult { Type: applySubst(subst, t), Predicates: predicates, Subst: subst, State: state }, applyTypedSwitchCasesSubst(subst, out)))
      case None => Err("switch requires at least one case")
    end
  else
    let current = cases.Get(0).UnwrapOr(ast2.SwitchCase { Pattern: ast2.Pattern.WildcardPattern, Body: ast2.EmptyExpr() })
    let pattern = resolveBareVariantPattern(env, targetType, current.Pattern)
    switch envWithPattern(env, pattern, targetType)
      case Err(msg) => Err(msg)
      case Ok(caseEnv) =>
        switch inferExpr(current.Body, caseEnv, state)
          case Err(msg) => Err(msg)
          case Ok(eir) then
            let value = eir.Result
            let typedOut = out.Append(ast2.SwitchCase { Pattern: pattern, Body: eir.Expr })
            switch resultType
              case None => inferTypedSwitchCases(sliceDrop(cases, 1), targetType, env, value.State, composeSubst(value.Subst, subst), Some(value.Type), appendPredicates(predicates, value.Predicates), typedOut)
              case Some(previous) =>
                let nextSubst = unifySwitchCaseTypes(env, current.Body, applySubst(value.Subst, previous), applySubst(value.Subst, value.Type), composeSubst(value.Subst, subst))
                switch nextSubst
                  case Err(msg) => Err("switch case type mismatch in " + current.Body.Pos.SourceName + ": " + msg)
                  case Ok(s) => inferTypedSwitchCases(sliceDrop(cases, 1), targetType, env, value.State, s, Some(applySubst(s, previous)), appendPredicates(predicates, value.Predicates), typedOut)
                end
            end
          end
        end
    end
  end
end

func inferSwitchCases(cases: Slice[ast2.SwitchCase], targetType: ast2.MonoType, env: Env, state: InferState, subst: Subst, resultType: Option[ast2.MonoType], predicates: Slice[Predicate]) -> Result[InferResult, String]
  if cases.Len() == 0 then
    switch resultType
      case Some(t) => Ok(InferResult { Type: applySubst(subst, t), Predicates: predicates, Subst: subst, State: state })
      case None => Err("switch requires at least one case")
    end
  else
    let current = cases.Get(0).UnwrapOr(ast2.SwitchCase { Pattern: ast2.Pattern.WildcardPattern, Body: ast2.EmptyExpr() })
    let caseEnv = envWithPattern(env, resolveBareVariantPattern(env, targetType, current.Pattern), targetType)
    switch caseEnv
      case Err(msg) => Err(msg)
      case Ok(nextEnv) then
        let body = inferExpr(current.Body, nextEnv, state)
        switch body
          case Err(msg) => Err(msg)
          case Ok(eir) then
            let value = eir.Result
            switch resultType
              case None => inferSwitchCases(sliceDrop(cases, 1), targetType, env, value.State, composeSubst(value.Subst, subst), Some(value.Type), appendPredicates(predicates, value.Predicates))
              case Some(previous) then
                let nextSubst = unifySwitchCaseTypes(env, current.Body, applySubst(value.Subst, previous), applySubst(value.Subst, value.Type), composeSubst(value.Subst, subst))
                switch nextSubst
                  case Err(msg) => Err("switch case type mismatch in " + current.Body.Pos.SourceName + ": " + msg)
                  case Ok(s) => inferSwitchCases(sliceDrop(cases, 1), targetType, env, value.State, s, Some(applySubst(s, previous)), appendPredicates(predicates, value.Predicates))
                end
              end
            end
          end
        end
      end
    end
  end
end

# Parser2 deliberately preserves a bare identifier as BindPattern.  A
# zero-field enum constructor is also written as a bare identifier, so resolve
# that ambiguity here from the predeclared environment.  Constructors have an
# enum return type whose name differs from the constructor name; ordinary local
# bindings retain BindPattern.
func resolveBareVariantPattern(env: Env, targetType: ast2.MonoType, pattern: ast2.Pattern) -> ast2.Pattern
  switch pattern
    case BindPattern(name) then
      switch variantSchemeForTarget(env, name, targetType)
        case Some(scheme) then
          switch scheme.Body
            case TCon(enumName) then
              if enumName != name => ast2.Pattern.VariantPattern(name, [] as Slice[ast2.Pattern]) else pattern
            end
            case TApp(typeRef, _) then
              switch typeRef.value()
                case TCon(enumName) then
                  if enumName != name => ast2.Pattern.VariantPattern(name, [] as Slice[ast2.Pattern]) else pattern
                end
                case _ => pattern
              end
            end
            # Imported enum variants carry TQualifiedName(path, TCon(Enum)).
            # Unwrap the wrapper so `case WildcardPattern` on an imported
            # ast2.Pattern resolves to a zero-arity VariantPattern instead of
            # remaining a bare binding that codegen2 would treat as a fallback.
            case TQualifiedName(_, inner) then
              switch inner.value()
                case TCon(enumName) then
                  if enumName != name => ast2.Pattern.VariantPattern(name, [] as Slice[ast2.Pattern]) else pattern
                end
                case _ => pattern
              end
            end
            case _ => pattern
          end
        end
        case None => pattern
      end
    end
    case _ => pattern
  end
end

# Select a constructor by both its spelling and the switch target type. This
# prevents equal variant names from separate imported packages colliding.
func variantSchemeForTarget(env: Env, name: String, targetType: ast2.MonoType) -> Option[Scheme]
  variantSchemeForTargetLoop(env, name, targetType, None)
end

func variantSchemeForTargetLoop(env: Env, name: String, targetType: ast2.MonoType, found: Option[Scheme]) -> Option[Scheme]
  switch env.Entry
    case None => found
    case Some(entry) =>
    let matches = entry.Name == name && variantMatchesTarget(targetType, variantResultType(entry.Scheme.Body))
    if matches then
      switch found
        case None => variantSchemeForTargetParent(env, name, targetType, Some(entry.Scheme))
        case Some(existing) =>
          # The prelude can be present as both input and external declarations.
          # Identical constructors are one candidate, not an ambiguity.
          if monoEqual(variantResultType(existing.Body), variantResultType(entry.Scheme.Body)) then
            variantSchemeForTargetParent(env, name, targetType, found)
          else
            # A bare pattern cannot safely pick one of two matching constructors.
            None
          end
      end
    else
      variantSchemeForTargetParent(env, name, targetType, found)
    end
  end
end

func variantSchemeForTargetParent(env: Env, name: String, targetType: ast2.MonoType, found: Option[Scheme]) -> Option[Scheme]
  switch env.Parent
    case Some(parent) => variantSchemeForTargetLoop(parent.value(), name, targetType, found)
    case None => found
  end
end

func variantResultType(typ: ast2.MonoType) -> ast2.MonoType
  switch typ
    case TFunc(_, ret) => ret.value()
    case _ => typ
  end
end

func variantMatchesTarget(targetType: ast2.MonoType, candidate: ast2.MonoType) -> Bool
  switch unify(targetType, candidate, emptySubst())
    case Ok(_) => true
    case Err(_) =>
      # During bootstrap an imported parameter type can temporarily arrive as
      # its package-local inner type.  Accept that form only for this pattern
      # lookup; variantSchemeForTarget still rejects candidates from different
      # package paths as ambiguous.
      switch candidate
        case TQualifiedName(_, inner) =>
          switch unify(targetType, inner.value(), emptySubst())
            case Ok(_) => true
            case Err(_) => false
          end
        case _ => false
      end
  end
end

# After a constructor has been selected, retain the target's temporary bare
# representation at this bootstrap boundary. Qualification remains intact in
# the environment and in all ordinary unification paths.
func variantTypeForTarget(targetType: ast2.MonoType, variantType: ast2.MonoType) -> ast2.MonoType
  switch variantType
    case TFunc(fields, ret) => ast2.MonoType.TFunc(fields, Ref.new(variantResultTypeForTarget(targetType, ret.value())))
    case _ => variantResultTypeForTarget(targetType, variantType)
  end
end

func variantResultTypeForTarget(targetType: ast2.MonoType, resultType: ast2.MonoType) -> ast2.MonoType
  switch resultType
    case TQualifiedName(_, inner) =>
      switch unify(targetType, resultType, emptySubst())
        case Ok(_) => resultType
        case Err(_) =>
          switch unify(targetType, inner.value(), emptySubst())
            case Ok(_) => inner.value()
            case Err(_) => resultType
          end
      end
    case _ => resultType
  end
end

# Zero-field constructors such as `None` are polymorphic.  Their inferred
# type may retain the enum declaration's parameter instead of the surrounding
# result type; when used as a complete case body, the prior case provides that
# result context.  Keep the established result type after confirming the name
# is an enum constructor, while ordinary branch type mismatches still fail.
func unifySwitchCaseTypes(env: Env, body: ast2.Expr, previous: ast2.MonoType, current: ast2.MonoType, subst: Subst) -> Result[Subst, String]
  # When the case body infers a TQualifiedName (foreign package) but the
  # previous result type was an inner TCon, retry the unification with
  # the inner type.  This keeps the unified switch result as the inner
  # TCon — the qualifier is restored by inferSwitch.
  switch unify(previous, current, subst)
    case Ok(next) => Ok(next)
    case Err(_) =>
      switch current
        case TQualifiedName(_, inner) =>
          switch unify(previous, applySubst(subst, inner.value()), subst)
            case Ok(next) => Ok(next)
            case Err(msg) => if isBareZeroFieldVariant(env, body) => Ok(subst) else Err(msg)
          end
        case _ => if isBareZeroFieldVariant(env, body) => Ok(subst) else Err("switch case type mismatch")
      end
  end
end

func isBareZeroFieldVariant(env: Env, expr: ast2.Expr) -> Bool
  switch expr.Kind
    case IdentExpr(name) =>
      switch envGet(env, name)
        case Some(scheme) =>
          switch scheme.Body
            case TCon(enumName) => enumName != name
            case TApp(typeRef, _) then
              switch typeRef.value()
                case TCon(enumName) => enumName != name
                case _ => false
              end
            end
            case _ => false
          end
        case None => false
      end
    case _ => false
  end
end

func envWithPattern(env: Env, pattern: ast2.Pattern, targetType: ast2.MonoType) -> Result[Env, String]
  # TQualifiedName wraps a foreign-package type.  Unwrap the inner type
  # for pattern matching; the bindings the pattern introduces use the
  # original wrapper as their body so any qualified access from the case
  # body is preserved.
  switch targetType
    case TQualifiedName(path, inner) =>
      # A variable pattern is the point at which a matched value enters the
      # lexical environment.  Do not unwrap it here: doing so made
      # `Some(item)` bind `item` as bare `TypeExpr` even when the Option
      # element was `ast2.TypeExpr`.  The qualifier is nominal identity, not
      # display metadata, so retain it from the initial binding.
      switch pattern
        case BindPattern(name) => Ok(envPut(env, name, Scheme { Bound: [], Predicates: [], Body: targetType }))
        case WildcardPattern => Ok(env)
        case _ then
          let innerType = inner.value()
          let next = envWithPattern(env, pattern, innerType)
          switch next
            case Ok(env2) => wrapPatternBinds(env2, path, innerType)
            case Err(msg) => Err(msg)
          end
        end
      end
    case _ =>
      switch pattern
        case BindPattern(name) => Ok(envPut(env, name, Scheme { Bound: [], Predicates: [], Body: targetType }))
        case WildcardPattern => Ok(env)
        case TuplePattern(items) =>
          switch targetType
            case TTuple(types) => envWithTuplePattern(env, items, types)
            case _ => Err("tuple pattern requires tuple target")
          end
        case LiteralPattern(kind, _) =>
          let expected = if kind == "string" then ast2.MonoType.TCon("String") elsif kind == "rune" then ast2.MonoType.TCon("Rune") else ast2.MonoType.TCon("Int") end
          switch unify(targetType, expected, emptySubst())
            case Ok(_) => Ok(env)
            case Err(msg) => Err("pattern does not match switch target: " + msg)
          end
        case VariantPattern(name, args) =>
          switch variantSchemeForTarget(env, name, targetType)
            case None =>
              if args.Len() == 0 then
                Ok(envPut(env, name, Scheme { Bound: [], Predicates: [], Body: targetType }))
              else
                Err("unknown variant " + name)
              end
            case Some(scheme) =>
              let variantType = variantTypeForTarget(targetType, instantiate(scheme, NewInferState()))
              switch variantType
                case TFunc(fields, ret) => envWithPatternBindings(env, args, fields, targetType, ret.value())
                case TCon(_) then
                  switch unify(targetType, variantType, emptySubst())
                    case Ok(_) => Ok(env)
                    case Err(msg) => Err("pattern does not match switch target: " + msg)
                  end
                end
                case TApp(_, _) then
                  # A zero-field variant is registered as the bare enum type
                  # (TApp(TCon(name), [type params])).  Treat it like a TCon
                  # so case None / case Empty matches without arguments, and
                  # surface a real error only when the pattern tries to bind
                  # arguments on a parameterless variant.
                  if args.Len() == 0 then
                    switch unify(targetType, variantType, emptySubst())
                      case Ok(_) => Ok(env)
                      case Err(msg) => Err("pattern does not match switch target: " + msg)
                    end
                  else
                    Err("variant " + name + " does not accept pattern arguments")
                  end
                end
                # Imported zero-field variants are registered with a
                # TQualifiedName wrapper (TQualifiedName(path, TCon(enum))).
                # Treat it like the bare enum type so `case UnitExpr` on an
                # imported ast2.ExprKind matches without arguments.
                case TQualifiedName(_, inner) then
                  if args.Len() == 0 then
                    switch unify(targetType, variantType, emptySubst())
                      case Ok(_) => Ok(env)
                      case Err(msg) =>
                        switch unify(targetType, inner.value(), emptySubst())
                          case Ok(_) => Ok(env)
                          case Err(_) => Err("pattern does not match switch target: " + msg)
                        end
                    end
                  else
                    Err("variant " + name + " does not accept pattern arguments")
                  end
                end
                case _ => Err("pattern " + name + " is not an enum variant")
              end
          end
      end
  end
end

# wrapPatternBinds re-wraps the names that the pattern just introduced
# so they re-export the TQualifiedName.  The inner type may itself be a
# parametric sum (TApp / TCon), so the new Body mirrors the original inner
# rather than re-unwrapping.
func wrapPatternBinds(env: Env, path: String, inner: ast2.MonoType) -> Result[Env, String]
  Ok(env)
end

func envWithTuplePattern(env: Env, patterns: Slice[ast2.Pattern], types: Slice[ast2.MonoType]) -> Result[Env, String]
  if patterns.Len() != types.Len() then Err("tuple pattern arity mismatch") else envWithTuplePatternLoop(env, patterns, types) end
end

func envWithTuplePatternLoop(env: Env, patterns: Slice[ast2.Pattern], types: Slice[ast2.MonoType]) -> Result[Env, String]
  if patterns.Len() == 0 then Ok(env)
  else
    let p = patterns.Get(0).UnwrapOr(ast2.Pattern.WildcardPattern)
    let t = types.Get(0).UnwrapOr(ast2.MonoType.TUnit)
    switch envWithPattern(env, p, t)
      case Ok(next) => envWithTuplePatternLoop(next, sliceDrop(patterns, 1), sliceDrop(types, 1))
      case Err(msg) => Err(msg)
    end
  end
end

func envWithPatternBindings(env: Env, names: Slice[ast2.Pattern], fields: Slice[ast2.MonoType], targetType: ast2.MonoType, variantType: ast2.MonoType) -> Result[Env, String]
  if names.Len() != fields.Len() then
    Err("pattern argument count mismatch")
  else
    # Unify the switch target with the variant's constructor type so the
    # variant's type parameters (e.g. `t1` in `func(t1) -> Option[t1]`) get
    # bound to the actual element type (e.g. `ParseError`).  The resulting
    # substitution is then applied to each pattern binding's type, so names
    # like `e` get the *resolved* element type (`ParseError`) rather than the
    # bare fresh variable (`t1`) — otherwise downstream `e.Field` accesses
    # would fail because the stub environment entry is still a type variable.
    let s = unify(targetType, variantType, emptySubst())
    switch s
      case Err(msg) => Err("pattern does not match switch target: " + msg)
      case Ok(subst) => envWithPatternBindingLoop(env, names, fields, subst)
    end
  end
end

func envWithPatternBindingLoop(env: Env, names: Slice[ast2.Pattern], fields: Slice[ast2.MonoType], subst: Subst) -> Result[Env, String]
  if names.Len() == 0 then
    Ok(env)
  else
    let field = applySubst(subst, fields.Get(0).UnwrapOr(ast2.MonoType.TUnit))
    switch envWithPattern(env, names.Get(0).UnwrapOr(ast2.Pattern.WildcardPattern), field)
      case Ok(next) => envWithPatternBindingLoop(next, sliceDrop(names, 1), sliceDrop(fields, 1), subst)
      case Err(msg) => Err(msg)
    end
  end
end

func inferTuple(items: Slice[ast2.Expr], env: Env, state: InferState) -> Result[(InferResult, Slice[ast2.Expr]), String]
  inferTupleItems(items, env, state, [] as Slice[ast2.MonoType], emptySubst(), [] as Slice[ast2.Expr])
end

func inferTupleItems(items: Slice[ast2.Expr], env: Env, state: InferState, types: Slice[ast2.MonoType], subst: Subst, typed: Slice[ast2.Expr]) -> Result[(InferResult, Slice[ast2.Expr]), String]
  if items.Len() == 0 then
    Ok((InferResult { Type: ast2.MonoType.TTuple(types), Predicates: [], Subst: subst, State: state }, applyTypedExprsSubst(subst, typed)))
  else
    let r = inferExpr(items.Get(0).UnwrapOr(ast2.EmptyExpr()), env, state)
    switch r
      case Err(msg) => Err(msg)
      case Ok(eir) => inferTupleItems(sliceDrop(items, 1), env, eir.Result.State, types.Append(eir.Result.Type), composeSubst(eir.Result.Subst, subst), typed.Append(eir.Expr))
    end
  end
end

struct StmtInferResult
  MaybeExpr: Option[ast2.Expr]
  Result: InferResult
end

# inferStmt 推断语句的类型。
func inferStmt(stmt: ast2.Stmt, env: Env, state: InferState) -> Result[StmtInferResult, String]
  switch stmt
    case ExprStmt(expr) then
      let inferred = inferExpr(expr, env, state)
      switch inferred
        case Ok(eir)  => Ok(StmtInferResult { MaybeExpr: Some(eir.Expr), Result: eir.Result })
        case Err(msg) => Err(msg)
      end
    end
    case LetStmt(bind) then
      let res = inferLet(bind, env, state)
      switch res
        case Ok(r) => Ok(StmtInferResult { MaybeExpr: None, Result: r })
        case Err(msg) => Err(msg)
      end
    end
    case VarStmt(bind) then
      let res = inferLet(bind, env, state)
      switch res
        case Ok(r) => Ok(StmtInferResult { MaybeExpr: None, Result: r })
        case Err(msg) => Err(msg)
      end
    end
    case LetRecStmt(bindings) then
      let res = inferLetRec(bindings, env, state)
      switch res
        case Ok(r) => Ok(StmtInferResult { MaybeExpr: None, Result: r })
        case Err(msg) => Err(msg)
      end
    end
    case TupleLetStmt(names, value) then
      # Tuple destructuring: `let (a, b) = expr`.  Infer the right-hand side as a
      # tuple type, then bind each name to the corresponding element.  The
      # bootstrap pipeline (codegen2) does not need per-element TypedDecls
      # here — the result type is the tuple's tail type.  This mirrors the
      # single-name LetStmt path so that any package using tuple destructuring
      # can still complete inference instead of panicking.
      let r = inferExpr(value, env, state)
      switch r
        case Err(msg) => Err(msg)
        case Ok(eir) => Ok(StmtInferResult { MaybeExpr: Some(eir.Expr), Result: eir.Result })
      end
    end
    case WhileStmt(cond, body) then
      let inferred = inferExpr(cond, env, state)
      switch inferred
        case Ok(eirCond) then
          let cv = eirCond.Result
          let csubst = unify(cv.Type, ast2.MonoType.TCon("Bool"), cv.Subst)
          switch csubst
            case Err(msg) => Err(msg)
            case Ok(_) then
              let b = inferExpr(body, env, cv.State)
              switch b
                case Err(msg) => Err(msg)
                case Ok(eirBody) =>
                  Ok(StmtInferResult { MaybeExpr: None, Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: eirBody.Result.Predicates, Subst: eirBody.Result.Subst, State: eirBody.Result.State } })
              end
            end
          end
        end
        case Err(msg) => Err(msg)
      end
    end
    case AssignStmt(target, value) then
      let t = inferExpr(target, env, state)
      switch t
        case Err(msg) => Err(msg)
        case Ok(eirTarget) then
          let tv = eirTarget.Result
          let v = inferExpr(value, env, tv.State)
          switch v
            case Err(msg) => Err(msg)
            case Ok(eirValue) then
              let vv = eirValue.Result
              let s = unify(tv.Type, vv.Type, composeSubst(vv.Subst, tv.Subst))
              switch s
                case Err(msg) => Err(msg)
                case Ok(sb) => Ok(StmtInferResult { MaybeExpr: None, Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: appendPredicates(tv.Predicates, vv.Predicates), Subst: sb, State: vv.State } })
              end
            end
          end
        end
      end
    end
    case ReturnStmt => Ok(StmtInferResult { MaybeExpr: None, Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: [], Subst: emptySubst(), State: state } })
    case BreakStmt => Ok(StmtInferResult { MaybeExpr: None, Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: [], Subst: emptySubst(), State: state } })
    case ContinueStmt => Ok(StmtInferResult { MaybeExpr: None, Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: [], Subst: emptySubst(), State: state } })
    case ReturnWithStmt(value) then
      let inferred = inferExpr(value, env, state)
      switch inferred
        case Ok(eir) then
          Ok(StmtInferResult { MaybeExpr: Some(eir.Expr), Result: eir.Result })
        end
        case Err(msg) => Err(msg)
      end
    end
  end
end

func isGoPackageCall(callee: ast2.Expr, state: InferState) -> Bool
  switch callee.Kind
    case FieldExpr(base, _) =>
      switch base.Kind
        case IdentExpr(alias) => isGoPackageAlias(alias, state.GoPackages)
        case _ => false
      end
    case _ => false
  end
end

# isGoPackageAlias checks whether `alias` matches a known Go FFI import.  This
# is the new check that replaces the legacy `TGoPackage` body test, since the
# type system no longer carries a dedicated package variant.
func isGoPackageAlias(alias: String, goPkgs: Slice[GoPackageEntry]) -> Bool
  if goPkgs.Len() == 0 then false else
    let head = goPkgs.Get(0).UnwrapOr(GoPackageEntry { Alias: "", Path: "", Funcs: [] as Slice[GoFuncSignature], Types: [] as Slice[GoTypeSignature] })
    if head.Alias == alias then true else isGoPackageAlias(alias, sliceDrop(goPkgs, 1)) end
  end
end

func inferAssign(target: ast2.Expr, value: ast2.Expr, env: Env, state: InferState) -> Result[InferResult, String]
  let t = inferExpr(target, env, state)
  switch t
    case Err(msg) => Err(msg)
    case Ok(teir) =>
      let tv = teir.Result
      let v = inferExpr(value, env, tv.State)
      switch v
        case Err(msg) => Err(msg)
        case Ok(eir) then
          let vv = eir.Result
          let s = unify(applySubst(vv.Subst, tv.Type), applySubst(vv.Subst, vv.Type), vv.Subst)
          switch s
            case Err(msg) => Err(msg)
            case Ok(s2) => Ok(InferResult { Type: ast2.MonoType.TUnit, Predicates: vv.Predicates, Subst: s2, State: vv.State })
          end
        end
      end
  end
end

func inferUnary(expr: ast2.Expr, op: String, inner: ast2.Expr, env: Env, state: InferState) -> Result[ExprInferResult, String]
  let r = inferExpr(inner, env, state)
  switch r
    case Ok(eir) then
      let typedInner = eir.Expr
      let v = eir.Result
      let matched = if op == "!" then
        matchExpected(v, ast2.MonoType.TCon("Bool"), ast2.MonoType.TCon("Bool"))
      else
        if op == "-" then
          if isNumericType(v.Type) then Ok(v) else Err("unary - requires a numeric operand") end
        else
          Err("unknown unary operator " + op)
        end
      end
      switch matched
        case Ok(v2) then
          let te = ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: ast2.ExprKind.UnaryExpr(op, typedInner), Type: Some(v2.Type) }
          Ok(ExprInferResult { Expr: te, Result: v2 })
        end
        case Err(m) => Err(m)
      end
    end
    case Err(msg) => Err(msg)
  end
end

func isNumericType(typ: ast2.MonoType) -> Bool
  switch typ
    case TCon(name) =>
      name == "Int" || name == "Int8" || name == "Int16" || name == "Int32" || name == "Int64" || name == "UInt" || name == "UInt8" || name == "UInt16" || name == "UInt32" || name == "UInt64" || name == "Float32" || name == "Float64"
    case _ => false
  end
end

func inferBinary(expr: ast2.Expr, op: String, left: ast2.Expr, right: ast2.Expr, env: Env, state: InferState) -> Result[ExprInferResult, String]
  let l = inferExpr(left, env, state)
  switch l
    case Err(msg) => Err(msg)
    case Ok(leir) =>
      let lv = leir.Result
      let r = inferExpr(right, env, lv.State)
      switch r
        case Err(msg) => Err(msg)
        case Ok(reir) =>
          let rv = reir.Result
          let s1 = composeSubst(rv.Subst, lv.Subst)
          if isArithmetic(op) then
              # Old-compiler parity: arithmetic operators (`+`, `-`, `*`, `/`)
              # unify the operands with each other and let the result inherit
              # the common operand type, so `String + String` chains into a
              # `String` rather than being forced to `Int`.
              let s2 = unify(applySubst(s1, lv.Type), applySubst(s1, rv.Type), s1)
              switch s2
                case Ok(sb) => Ok(mkTypedBinary(expr, op, leir.Expr, reir.Expr, InferResult { Type: applySubst(sb, lv.Type), Predicates: appendPredicates(lv.Predicates, rv.Predicates), Subst: sb, State: rv.State }))
                case Err(msg) => Err("arithmetic operator " + op + " type mismatch: " + msg)
              end
          else
            if isComparison(op) then
              let s2 = unify(applySubst(s1, lv.Type), applySubst(s1, rv.Type), s1)
              switch s2
                case Ok(sb) => Ok(mkTypedBinary(expr, op, leir.Expr, reir.Expr, InferResult { Type: ast2.MonoType.TCon("Bool"), Predicates: appendPredicates(lv.Predicates, rv.Predicates), Subst: sb, State: rv.State }))
                case Err(msg) => Err(msg)
              end
            else
              if isLogical(op) then
                let s2 = unify(applySubst(s1, lv.Type), ast2.MonoType.TCon("Bool"), s1)
                switch s2
                  case Err(msg) => Err("logical operator requires Bool operands: " + msg)
                  case Ok(sa) =>
                    let s3 = unify(applySubst(sa, rv.Type), ast2.MonoType.TCon("Bool"), sa)
                    switch s3
                    case Ok(sb) => Ok(mkTypedBinary(expr, op, leir.Expr, reir.Expr, InferResult { Type: ast2.MonoType.TCon("Bool"), Predicates: appendPredicates(lv.Predicates, rv.Predicates), Subst: sb, State: rv.State }))
                      case Err(msg) => Err("logical operator requires Bool operands: " + msg)
                    end
                end
              else
                Err("unknown binary operator " + op)
              end
            end
          end
      end
  end
end

func mkTypedBinary(expr: ast2.Expr, op: String, left: ast2.Expr, right: ast2.Expr, result: InferResult) -> ExprInferResult
  let typedLeft = applyTypedExprSubst(result.Subst, left)
  let typedRight = applyTypedExprSubst(result.Subst, right)
  let typedResult = InferResult { Type: applySubst(result.Subst, result.Type), Predicates: result.Predicates, Subst: result.Subst, State: result.State }
  let typedExpr = ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: ast2.ExprKind.BinaryExpr(op, typedLeft, typedRight), Type: Some(typedResult.Type) }
  ExprInferResult { Expr: typedExpr, Result: typedResult }
end

func inferIf(expr: ast2.Expr, cond: ast2.Expr, thenExpr: ast2.Expr, elseExpr: ast2.Expr, env: Env, state: InferState) -> Result[ExprInferResult, String]
  let c = inferExpr(cond, env, state)
  switch c
    case Err(msg) => Err(msg)
    case Ok(ceir) then
      let cv = ceir.Result
      let csubst = unify(cv.Type, ast2.MonoType.TCon("Bool"), cv.Subst)
      switch csubst
        case Err(msg) => Err(msg)
        case Ok(scond) then
          let t = inferExpr(thenExpr, env, cv.State)
          switch t
            case Err(msg) => Err(msg)
            case Ok(eirT) then
              let tv = eirT.Result
              let e = inferExpr(elseExpr, env, tv.State)
              switch e
                case Err(msg) => Err(msg)
                case Ok(eeir) then
                  let ev = eeir.Result
                  let s1 = composeSubst(ev.Subst, composeSubst(tv.Subst, scond))
                  let thenApplied = applySubst(s1, tv.Type)
                  let elseApplied = applySubst(s1, ev.Type)
                  let same = unify(thenApplied, elseApplied, s1)
                  switch same
                    case Ok(s2) then
                      let result = InferResult { Type: applySubst(s2, tv.Type), Predicates: appendPredicates(cv.Predicates, appendPredicates(tv.Predicates, ev.Predicates)), Subst: s2, State: ev.State }
                      let typedKind = ast2.ExprKind.IfExpr(applyTypedExprSubst(s2, ceir.Expr), applyTypedExprSubst(s2, eirT.Expr), applyTypedExprSubst(s2, eeir.Expr))
                      Ok(ExprInferResult { Expr: ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: typedKind, Type: Some(result.Type) }, Result: result })
                    end
                    case Err(msg) => Err(msg)
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

func inferCall(callee: ast2.Expr, typeArgs: Slice[ast2.TypeExpr], args: Slice[ast2.Expr], env: Env, state: InferState) -> Result[ExprInferResult, String]
  switch inferRefCall(callee, args, env, state)
    case Some(r) then
      switch r
        case Ok(pair) then
          let (v, typedArgs) = pair
          let callExprKind = ast2.ExprKind.CallExpr(callee, typeArgs, typedArgs)
          Ok(ExprInferResult { Expr: ast2.Expr { ID: 0, Pos: ast2.SourcePos{SourceName: "", Line: 0, Column: 0}, Kind: callExprKind, Type: Some(v.Type) }, Result: v })
        end
        case Err(m) => Err(m)
      end
    end
    case None then
      switch inferOrdinaryCall(callee, args, env, state)
        case Ok(pair) then
          let (v, typedArgs) = pair
          let callExprKind = switch inferredDictionaryCall(callee, v.Expr, v.Result.State.ActiveConstraints)
            case Some(key) then
              switch v.Expr.Kind
                case FieldExpr(base, _) => ast2.ExprKind.DictionaryCallExpr(key, base, typedArgs)
                case _ => ast2.ExprKind.CallExpr(v.Expr, typeArgs, typedArgs)
              end
            end
            case None => ast2.ExprKind.CallExpr(v.Expr, typeArgs, typedArgs)
          end
          Ok(ExprInferResult { Expr: ast2.Expr { ID: 0, Pos: ast2.SourcePos{SourceName: "", Line: 0, Column: 0}, Kind: callExprKind, Type: Some(v.Result.Type) }, Result: v.Result })
        end
        case Err(m) => Err(m)
      end
    end
  end
end

func inferredDictionaryCall(callee: ast2.Expr, typedCallee: ast2.Expr, constraints: Slice[Predicate]) -> Option[String]
  switch callee.Kind
    case FieldExpr(_, method) =>
      switch typedCallee.Kind
        case FieldExpr(base, _) =>
          switch base.Type
            case Some(receiver) => dictionaryCallKeyForReceiver(method, receiver, constraints)
            case None => None
          end
        case _ => None
      end
    case _ => None
  end
end

func dictionaryCallKeyForReceiver(method: String, receiver: ast2.MonoType, constraints: Slice[Predicate]) -> Option[String]
  if constraints.Len() == 0 then None else
    let current = constraints.Get(0).UnwrapOr(Predicate { ClassName: "", Args: [] as Slice[ast2.MonoType] })
    let arg = current.Args.Get(0).UnwrapOr(ast2.MonoType.TUnit)
    if monoEqual(arg, receiver) then Some(current.ClassName + ":" + constraintArgsKey(current.Args) + ":" + method) else dictionaryCallKeyForReceiver(method, receiver, sliceDrop(constraints, 1)) end
  end
end

# Ref is a compiler boundary type.  Its constructor and dereference operation
# are not ordinary fields in the lexical environment.
func inferRefCall(callee: ast2.Expr, args: Slice[ast2.Expr], env: Env, state: InferState) -> Option[Result[(InferResult, Slice[ast2.Expr]), String]]
  switch callee.Kind
    case FieldExpr(base, field) then
      switch base.Kind
        case IdentExpr(name) then
          if name == "Ref" && field == "new" then
            if args.Len() != 1 then
              Some(Err("Ref.new expects exactly one argument"))
            else
              switch inferExpr(args.Get(0).UnwrapOr(ast2.EmptyExpr()), env, state)
                case Ok(eir) =>
                  let typedArg = applyTypedExprSubst(eir.Result.Subst, eir.Expr)
                  let result = InferResult { Type: ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Ref")), [applySubst(eir.Result.Subst, eir.Result.Type)]), Predicates: eir.Result.Predicates, Subst: eir.Result.Subst, State: eir.Result.State }
                  Some[Result[(InferResult, Slice[ast2.Expr]), String]](Ok[(InferResult, Slice[ast2.Expr]), String]((result, [typedArg])))
                case Err(msg) => Some[Result[(InferResult, Slice[ast2.Expr]), String]](Err[(InferResult, Slice[ast2.Expr]), String](msg))
              end
            end
          else
            inferRefValueCall(base, field, args, env, state)
          end
        end
        case _ => inferRefValueCall(base, field, args, env, state)
      end
    end
    case _ => None
  end
end

func inferRefValueCall(base: ast2.Expr, field: String, args: Slice[ast2.Expr], env: Env, state: InferState) -> Option[Result[(InferResult, Slice[ast2.Expr]), String]]
  if field != "value" || args.Len() != 0 then
    None
  else
    switch inferExpr(base, env, state)
      case Err(msg) => Some(Err(msg))
      case Ok(eir) then
        let value = eir.Result
        switch applySubst(value.Subst, value.Type)
          case TApp(typeRef, inner) then
            switch typeRef.value()
              case TCon(name) then
                if name == "Ref" && inner.Len() == 1 then
                  Some(Ok((InferResult { Type: inner.Get(0).UnwrapOr(ast2.MonoType.TUnit), Predicates: value.Predicates, Subst: value.Subst, State: value.State }, [] as Slice[ast2.Expr])))
                else
                  Some(Err("value() requires Ref[T]"))
                end
              end
              case _ => Some(Err("value() requires Ref[T]"))
            end
          end
          case _ => Some(Err("value() requires Ref[T]"))
        end
      end
    end
  end
end

func inferOrdinaryCall(callee: ast2.Expr, args: Slice[ast2.Expr], env: Env, state: InferState) -> Result[(ExprInferResult, Slice[ast2.Expr]), String]
  let c = inferExpr(callee, env, state)
  switch c
    case Err(msg) => Err(msg)
    case Ok(eir) then
      let typedCallee = eir.Expr
      let cv = eir.Result
      switch cv.Type
        case TVariadic(_, _) then
          let argState = stateAfterCalleeInstantiation(cv.Type, cv.State)
          let ar = inferArgs(args, callParamTypes(cv.Type), env, argState, [], [], [], cv.Subst)
          switch ar
            case Err(msg) => Err(msg)
            case Ok(argsResult) =>
              let r = inferGoVariadicCall(cv.Type, argsResult, cv)
              switch r
                case Ok(v) => Ok((ExprInferResult { Expr: typedCallee, Result: v }, argsResult.Exprs))
                case Err(m) => Err(m)
              end
          end
        end
        case TQualifiedName(path, inner) then
          # A callee typed as TQualifiedName wraps a foreign-package
          # function whose body is a TFunc/TVariadic/TApp.  Manually
          # re-run the dispatch on the inner shape and rebuild the
          # result type so the call-site retains the package identity.
          let innerType = inner.value()
          switch innerType
            case TVariadic(_, _) =>
              let argState = stateAfterCalleeInstantiation(innerType, cv.State)
              let ar = inferArgs(args, callParamTypes(innerType), env, argState, [], [], [], cv.Subst)
              switch ar
                case Err(msg) => Err(msg)
                case Ok(argsResult) =>
                  let subst = composeSubst(argsResult.Subst, cv.Subst)
                  switch applySubst(subst, innerType)
                    case TVariadic(_, retRef) =>
                      # The qualified wrapper identifies the imported
                      # function binding, not every value it returns.  Types
                      # from the imported package were already qualified
                      # while its signature was seeded; wrapping the result
                      # again turns a primitive `Int` into `../lib.Int`.
                      let result = applySubst(subst, retRef.value())
                      let v = InferResult { Type: result, Predicates: appendPredicates(cv.Predicates, argsResult.Predicates), Subst: subst, State: argsResult.State }
                      Ok((ExprInferResult { Expr: typedCallee, Result: v }, argsResult.Exprs))
                    case _ => Err("unreachable variadic inner")
                  end
                case _ => Err("unreachable variadic dispatch")
              end
            case _ =>
              let argState = stateAfterCalleeInstantiation(innerType, cv.State)
              let ar = inferArgs(args, callParamTypes(innerType), env, argState, [], [], [], cv.Subst)
              switch ar
                case Err(msg) => Err(msg)
                case Ok(argsResult) then
                  let afterCallee = nextFreshVarID(innerType, argsResult.State.FreshVarID)
                  let fresh = nextFreshVarIDInAll(argsResult.Types, afterCallee)
                  let s1 = composeSubst(argsResult.Subst, cv.Subst)
                  let used = maxSubstID(s1)
                  let safeFresh = if fresh <= used then used + 1 else fresh end
                  let nextState = withFreshID(argsResult.State, safeFresh + 1)
                  let ret = ast2.MonoType.TVar(safeFresh)
                  let expected = ast2.MonoType.TFunc(argsResult.Types, Ref.new(ret))
                  let s2 = unify(applySubst(s1, innerType), expected, s1)
                  switch s2
                    case Ok(s) =>
                      # See the variadic branch above: only types explicitly
                      # named in the imported signature carry its qualifier.
                      let finalType = applySubst(s, ret)
                      Ok((ExprInferResult { Expr: applyTypedExprSubst(s, typedCallee), Result: InferResult { Type: finalType, Predicates: appendPredicates(cv.Predicates, argsResult.Predicates), Subst: s, State: nextState } }, applyTypedExprsSubst(s, argsResult.Exprs)))
                    case Err(msg) => if isGoPackageCall(callee, state) then Err("Go function argument count mismatch") else Err(msg) end
                  end
                end
              end
          end
        end
        case _ then
          # TApp and TQualifiedName both wrap a callable shape (TFunc /
          # TVariadic).  Peek past the wrapper so call-type dispatch can
          # match the right branch.  TQualifiedName's inner has already
          # been handled above; the only remaining wrapper is TApp.
          let effective = switch cv.Type
            case TApp(inner, _) => inner.value()
            case _ => cv.Type
          end
          let argState = stateAfterCalleeInstantiation(effective, cv.State)
          let ar = inferArgs(args, callParamTypes(effective), env, argState, [], [], [], cv.Subst)
          switch ar
            case Err(msg) => Err(msg)
            case Ok(argsResult) then
              let afterCallee = nextFreshVarID(effective, argsResult.State.FreshVarID)
              let fresh = nextFreshVarIDInAll(argsResult.Types, afterCallee)
              let s1 = composeSubst(argsResult.Subst, cv.Subst)
              let used = maxSubstID(s1)
              let safeFresh = if fresh <= used then used + 1 else fresh end
              let nextState = withFreshID(argsResult.State, safeFresh + 1)
              let ret = ast2.MonoType.TVar(safeFresh)
              let expected = ast2.MonoType.TFunc(argsResult.Types, Ref.new(ret))
              let s2 = unify(applySubst(s1, effective), expected, s1)
              switch s2
                case Ok(s) => Ok((ExprInferResult { Expr: applyTypedExprSubst(s, typedCallee), Result: InferResult { Type: applySubst(s, ret), Predicates: appendPredicates(cv.Predicates, argsResult.Predicates), Subst: s, State: nextState } }, applyTypedExprsSubst(s, argsResult.Exprs)))
                case Err(msg) then
                  if isGoPackageCall(callee, state) then
                    Err("Go function argument count mismatch")
                  else
                    Err(msg + " [callee=" + MonoStringFull(applySubst(s1, cv.Type)) + " effective=" + MonoStringFull(applySubst(s1, effective)) + " expected=" + MonoStringFull(applySubst(s1, expected)) + "]")
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

# Instantiating a polymorphic callee introduces fresh TVars into its parameter
# types. Nested argument calls must allocate above those IDs; otherwise their
# result temporary can reuse a callee type variable (e.g. ParseInput[A]'s A),
# incorrectly producing Parser[Parser[File]].
func stateAfterCalleeInstantiation(typ: ast2.MonoType, state: InferState) -> InferState
  withFreshID(state, nextFreshVarID(typ, state.FreshVarID))
end

func inferGoVariadicCall(marker: ast2.MonoType, args: ArgsResult, callee: InferResult) -> Result[InferResult, String]
  let subst = composeSubst(args.Subst, callee.Subst)
  switch marker
    case TVariadic(_, ret) => Ok(InferResult { Type: applySubst(subst, ret.value()), Predicates: appendPredicates(callee.Predicates, args.Predicates), Subst: subst, State: args.State })
    case _ => Err("invalid variadic call type")
  end
end

func callParamTypes(typ: ast2.MonoType) -> Slice[ast2.MonoType]
  switch typ
    case TFunc(params, _) => params
    case TVariadic(params, _) => params
    case _ => [] as Slice[ast2.MonoType]
  end
end

# Infer call arguments against the instantiated callee parameter types.  This
# is where a contextual literal such as `PPure([])` learns that `[]` is
# `Slice[A]`: earlier arguments may first bind the callee's fresh variables,
# and the composed substitution is applied before each following argument.
func inferArgs(args: Slice[ast2.Expr], expectedTypes: Slice[ast2.MonoType], env: Env, state: InferState, types: Slice[ast2.MonoType], exprs: Slice[ast2.Expr], predicates: Slice[Predicate], subst: Subst) -> Result[ArgsResult, String]
  if args.Len() == 0 then
    Ok(ArgsResult { Types: types, Exprs: applyTypedExprsSubst(subst, exprs), Predicates: predicates, Subst: subst, State: state })
  else
    let head = args.Get(0).UnwrapOr(ast2.EmptyExpr())
    let r = inferExpr(head, env, state)
    switch r
      case Err(msg) => Err(msg)
      case Ok(eir) =>
        let v = eir.Result
        let baseSubst = composeSubst(v.Subst, subst)
        let checked = switch expectedTypes.Get(0)
          case Some(expected) => unify(applySubst(baseSubst, v.Type), applySubst(baseSubst, expected), baseSubst)
          case None => Ok(baseSubst)
        end
        switch checked
          # Preserve the argument expression's position.  The caller may be
          # nested in a switch/function body; without this, bootstrap reports
          # only the enclosing function's first expression and hides the
          # actual constructor or helper call that produced the mismatch.
          case Err(msg) => Err(callArgumentError(head, msg))
          case Ok(nextSubst) => inferArgs(sliceDrop(args, 1), sliceDrop(expectedTypes, 1), env, v.State, types.Append(applySubst(nextSubst, v.Type)), exprs.Append(applyTypedExprSubst(nextSubst, eir.Expr)), appendPredicates(predicates, v.Predicates), nextSubst)
        end
    end
  end
end

func callArgumentError(arg: ast2.Expr, msg: String) -> String
  let source = if arg.Pos.SourceName == "" then "<input>" else arg.Pos.SourceName end
  source + ":" + arg.Pos.Line.ToString() + ":" + arg.Pos.Column.ToString() + ": call argument type mismatch: " + msg
end

func inferBlock(items: Slice[ast2.Stmt], env: Env, state: InferState) -> Result[InferResult, String]
  if items.Len() == 0 then
    Ok(InferResult { Type: ast2.MonoType.TUnit, Predicates: [], Subst: emptySubst(), State: state })
  else
    inferBlockItems(items, env, state, ast2.MonoType.TUnit, emptySubst(), [])
  end
end

# A block is part of the typed AST, not merely a type-checking scope.  Keep
# the inferred statements so nested calls retain their dispatch annotations.
func inferTypedBlock(items: Slice[ast2.Stmt], env: Env, state: InferState) -> Result[(InferResult, Slice[ast2.Stmt]), String]
  inferTypedBlockItems(items, env, state, ast2.MonoType.TUnit, emptySubst(), [], [] as Slice[ast2.Stmt])
end

func inferTypedBlockItems(items: Slice[ast2.Stmt], env: Env, state: InferState, lastType: ast2.MonoType, subst: Subst, predicates: Slice[Predicate], out: Slice[ast2.Stmt]) -> Result[(InferResult, Slice[ast2.Stmt]), String]
  if items.Len() == 0 then
    Ok((InferResult { Type: applySubst(subst, lastType), Predicates: predicates, Subst: subst, State: state }, applyTypedStmtsSubst(subst, out)))
  else
    let step = inferBlockStep(items.Get(0).UnwrapOr(ast2.Stmt.ExprStmt(ast2.EmptyExpr())), env, state, items.Len() == 1)
    switch step
      case Err(msg) => Err(msg)
      case Ok(v) => inferTypedBlockItems(sliceDrop(items, 1), v.Env, v.Result.State, v.Result.Type, composeSubst(v.Result.Subst, subst), appendPredicates(predicates, v.Result.Predicates), out.Append(v.Stmt))
    end
  end
end

func inferBlockItems(items: Slice[ast2.Stmt], env: Env, state: InferState, lastType: ast2.MonoType, subst: Subst, predicates: Slice[Predicate]) -> Result[InferResult, String]
  if items.Len() == 0 then
    Ok(InferResult { Type: applySubst(subst, lastType), Predicates: predicates, Subst: subst, State: state })
  else
    let step = inferBlockStep(items.Get(0).UnwrapOr(ast2.Stmt.ExprStmt(ast2.EmptyExpr())), env, state, items.Len() == 1)
    switch step
      case Err(msg) => Err(msg)
      case Ok(v) => inferBlockItems(sliceDrop(items, 1), v.Env, v.Result.State, v.Result.Type, composeSubst(v.Result.Subst, subst), appendPredicates(predicates, v.Result.Predicates))
    end
  end
end

func inferBlockStep(stmt: ast2.Stmt, env: Env, state: InferState, isFinal: Bool) -> Result[BlockInferStep, String]
  switch stmt
    case LetStmt(bind) => inferBlockBind(bind, false, env, state)
    case LetRecStmt(bindings) => inferBlockLetRecTyped(bindings, env, state)
    case VarStmt(bind) => inferBlockBind(bind, true, env, state)
    case WhileStmt(cond, body) => inferTypedWhileStmt(cond, body, env, state)
    case TupleLetStmt(names, value) => inferBlockTupleLet(names, value, env, state)
    case AssignStmt(target, value) => inferTypedAssign(target, value, env, state)
    # A conditional used as a statement may return from only one branch.
    # Its branches therefore need not have a common value type.
    case ExprStmt(expr) then
      switch expr.Kind
        case IfExpr(cond, thenExpr, elseExpr) => if isFinal then inferTypedExprStmt(expr, env, state) else inferTypedIfStmt(expr, cond, thenExpr, elseExpr, env, state) end
        case _ => inferTypedExprStmt(expr, env, state)
      end
    end
    case ReturnWithStmt(value) => inferTypedReturnWith(value, env, state)
    case _ then
      let r = inferStmt(stmt, env, state)
      switch r
        case Err(msg) => Err(msg)
        case Ok(sir) => Ok(BlockInferStep { Result: sir.Result, Env: env, Stmt: stmt })
      end
    end
  end
end

func inferTypedExprStmt(expr: ast2.Expr, env: Env, state: InferState) -> Result[BlockInferStep, String]
  switch inferExpr(expr, env, state)
    case Err(msg) => Err(msg)
    case Ok(eir) => Ok(BlockInferStep { Result: eir.Result, Env: env, Stmt: ast2.Stmt.ExprStmt(eir.Expr) })
  end
end

func inferTypedReturnWith(value: ast2.Expr, env: Env, state: InferState) -> Result[BlockInferStep, String]
  switch inferExpr(value, env, state)
    case Err(msg) => Err(msg)
    case Ok(eir) => Ok(BlockInferStep { Result: eir.Result, Env: env, Stmt: ast2.Stmt.ReturnWithStmt(eir.Expr) })
  end
end

func inferTypedIfStmt(expr: ast2.Expr, cond: ast2.Expr, thenExpr: ast2.Expr, elseExpr: ast2.Expr, env: Env, state: InferState) -> Result[BlockInferStep, String]
  switch inferExpr(cond, env, state)
    case Err(msg) => Err(msg)
    case Ok(ceir) then
      let cv = ceir.Result
      switch unify(cv.Type, ast2.MonoType.TCon("Bool"), cv.Subst)
        case Err(msg) => Err(msg)
        case Ok(scond) then
          switch inferExpr(thenExpr, env, cv.State)
            case Err(msg) => Err(msg)
            case Ok(teir) then
              let tv = teir.Result
              switch inferExpr(elseExpr, env, tv.State)
                case Err(msg) => Err(msg)
                case Ok(eeir) then
                  let ev = eeir.Result
                  let subst = composeSubst(ev.Subst, composeSubst(tv.Subst, scond))
                  let typed = ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: ast2.ExprKind.IfExpr(applyTypedExprSubst(subst, ceir.Expr), applyTypedExprSubst(subst, teir.Expr), applyTypedExprSubst(subst, eeir.Expr)), Type: Some(ast2.MonoType.TUnit) }
                  Ok(BlockInferStep { Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: appendPredicates(cv.Predicates, appendPredicates(tv.Predicates, ev.Predicates)), Subst: subst, State: ev.State }, Env: env, Stmt: ast2.Stmt.ExprStmt(typed) })
                end
              end
            end
          end
        end
      end
    end
  end
end

# Assignments need to retain their typed operands just like expression
# statements. In particular, codegen dispatches `items.Append(value)` from
# the receiver annotation on the RHS field expression.
func inferTypedAssign(target: ast2.Expr, value: ast2.Expr, env: Env, state: InferState) -> Result[BlockInferStep, String]
  let inferredTarget = inferExpr(target, env, state)
  switch inferredTarget
    case Err(msg) => Err(msg)
    case Ok(eirTarget) then
      let targetResult = eirTarget.Result
      let inferredValue = inferExpr(value, env, targetResult.State)
      switch inferredValue
        case Err(msg) => Err(msg)
        case Ok(eirValue) then
          let valueResult = eirValue.Result
          let subst = unify(targetResult.Type, valueResult.Type, composeSubst(valueResult.Subst, targetResult.Subst))
          switch subst
            case Err(msg) => Err(msg)
            case Ok(s) =>
              let typedTarget = applyTypedExprSubst(s, eirTarget.Expr)
              let typedValue = applyTypedExprSubst(s, eirValue.Expr)
              Ok(BlockInferStep {
                Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: appendPredicates(targetResult.Predicates, valueResult.Predicates), Subst: s, State: valueResult.State },
                Env: env,
                Stmt: ast2.Stmt.AssignStmt(typedTarget, typedValue),
              })
          end
        end
      end
    end
  end
end

# inferBlockTupleLet handles `let (a, b) = expr`.  We don't currently know
# the tuple's element types from a generic expression, so we infer the RHS,
# then introduce each bound name as a fresh type variable.  The result env
# exposes them so the rest of the block can reference them, which is all
# inference needs; codegen2 walks the untyped TupleLetStmt shape directly
# in its own pipeline.
func inferBlockTupleLet(names: Slice[String], value: ast2.Expr, env: Env, state: InferState) -> Result[BlockInferStep, String]
  let r = inferExpr(value, env, state)
  switch r
    case Err(msg) => Err(msg)
    case Ok(eir) then
      # A tuple binding is the explicit opt-in to Go's original multiple
      # return values. Ordinary bindings continue to see `(T, bool/error)`
      # as Option[T]/Result[T, E].
      let tupleType = ffiRawTupleResultType(value, eir.Result.State).UnwrapOr(eir.Result.Type)
      let nextState = eir.Result.State
      let nextEnv = envWithTupleBindings(env, names, tupleType)
      let typedValue = ast2.Expr { ID: eir.Expr.ID, Pos: eir.Expr.Pos, Kind: eir.Expr.Kind, Type: Some(tupleType) }
      let stepState = withFreshID(nextState, nextState.FreshVarID + names.Len())
      let newStmt = ast2.Stmt.TupleLetStmt(names, typedValue)
      Ok(BlockInferStep { Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: eir.Result.Predicates, Subst: eir.Result.Subst, State: stepState }, Env: nextEnv, Stmt: newStmt })
    end
  end
end

func ffiRawTupleResultType(expr: ast2.Expr, state: InferState) -> Option[ast2.MonoType]
  switch expr.Kind
    case CallExpr(callee, _, _) => ffiRawTupleResultTypeFromCallee(callee, state.GoPackages)
    # A tuple-typed inline Go block declares its native Go result shape
    # (`go[(T, error)]`).  Tuple destructuring is the explicit opt-in to that
    # raw multiple-return form, exactly like a Go FFI call.
    case InlineGoExpr(typ, _, _, _) =>
      switch typ.value()
        case TupleType(_) => Some(typeFromAST(typ.value()))
        case _ => None
      end
    case _ => None
  end
end

func ffiRawTupleResultTypeFromCallee(callee: ast2.Expr, packages: Slice[GoPackageEntry]) -> Option[ast2.MonoType]
  switch callee.Kind
    case FieldExpr(base, field) then
      switch base.Kind
        case IdentExpr(alias) => ffiRawTupleResultTypeInPackages(alias, field, packages)
        case _ => None
      end
    end
    case _ => None
  end
end

func ffiRawTupleResultTypeInPackages(alias: String, name: String, packages: Slice[GoPackageEntry]) -> Option[ast2.MonoType]
  if packages.Len() == 0 then None else
    let pkg = packages.Get(0).UnwrapOr(GoPackageEntry { Alias: "", Path: "", Funcs: [], Types: [] })
    if pkg.Alias == alias then ffiRawTupleResultTypeInFuncs(name, pkg.Funcs) else ffiRawTupleResultTypeInPackages(alias, name, sliceDrop(packages, 1)) end
  end
end

func ffiRawTupleResultTypeInFuncs(name: String, funcs: Slice[GoFuncSignature]) -> Option[ast2.MonoType]
  if funcs.Len() == 0 then None else
    let sig = funcs.Get(0).UnwrapOr(GoFuncSignature { Name: "", Params: [], Results: [], Variadic: false })
    if sig.Name == name && sig.Results.Len() > 1 then Some(GoSignatureRawResultType(sig)) else ffiRawTupleResultTypeInFuncs(name, sliceDrop(funcs, 1)) end
  end
end

func envWithTupleBindings(env: Env, names: Slice[String], tupleType: ast2.MonoType) -> Env
  envWithTupleBindingsAt(env, names, tupleType, 0)
end

func envWithTupleBindingsAt(env: Env, names: Slice[String], tupleType: ast2.MonoType, index: Int) -> Env
  if index >= names.Len() then env else
    let name = names.Get(index).UnwrapOr("")
    let typ = tupleElementTypeForBinding(tupleType, index)
    envWithTupleBindingsAt(envPut(env, name, Scheme { Bound: [], Predicates: [], Body: typ }), names, tupleType, index + 1)
  end
end

func tupleElementTypeForBinding(tupleType: ast2.MonoType, index: Int) -> ast2.MonoType
  switch tupleType
    case TTuple(items) => items.Get(index).UnwrapOr(ast2.MonoType.TUnit)
    case _ => ast2.MonoType.TVar(index + 1)
  end
end

# envWithFreshTupleBindings puts each name into env as a Scheme wrapping a
# fresh type variable.  It walks the slice recursively and returns the new
# env (an extension of the input).  `freshBase` is the next free FreshVarID.
func envWithFreshTupleBindings(env: Env, names: Slice[String], freshBase: Int, subst: Subst) -> Env
  if names.Len() == 0 then env else
    let name = names.Get(0).UnwrapOr("")
    let rest = sliceDrop(names, 1)
    let fresh = ast2.MonoType.TVar(freshBase + rest.Len())
    let bound = envPut(env, name, Scheme { Bound: [], Predicates: [], Body: fresh })
    envWithFreshTupleBindings(bound, rest, freshBase, subst)
  end
end

func inferTypedWhileStmt(cond: ast2.Expr, body: ast2.Expr, env: Env, state: InferState) -> Result[BlockInferStep, String]
  let condition = inferExpr(cond, env, state)
  switch condition
    case Err(msg) => Err(msg)
    case Ok(eirCond) =>
      let cv = eirCond.Result
      let checked = unify(cv.Type, ast2.MonoType.TCon("Bool"), cv.Subst)
      switch checked
        case Err(msg) => Err(msg)
        case Ok(s) =>
          let inferredBody = inferExpr(body, env, cv.State)
          switch inferredBody
            case Err(msg) => Err(msg)
            case Ok(eirBody) => Ok(BlockInferStep {
              Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: eirBody.Result.Predicates, Subst: composeSubst(eirBody.Result.Subst, s), State: eirBody.Result.State },
              Env: env,
              Stmt: ast2.Stmt.WhileStmt(eirCond.Expr, eirBody.Expr),
            })
          end
      end
  end
end

func inferBlockLetRecTyped(bindings: Slice[ast2.LetRecBind], env: Env, state: InferState) -> Result[BlockInferStep, String]
  let inferred = inferBlockLetRec(bindings, env, state)
  switch inferred
    case Ok(step) => Ok(BlockInferStep { Result: step.Result, Env: step.Env, Stmt: step.Stmt })
    case Err(msg) => Err(msg)
  end
end

func inferBlockLetRec(bindings: Slice[ast2.LetRecBind], env: Env, state: InferState) -> Result[BlockInferStep, String]
  let recEnv = predeclareLetRec(bindings, env, state)
  inferLetRecValues(bindings, recEnv, state, emptySubst(), [] as Slice[ast2.LetRecBind])
end

func predeclareLetRec(bindings: Slice[ast2.LetRecBind], env: Env, state: InferState) -> Env
  if bindings.Len() == 0 then
    env
  else
    let binding = bindings.Get(0).UnwrapOr(ast2.LetRecBind { Name: "", Type: ast2.TypeExpr.UnitType, Value: ast2.EmptyExpr() })
    predeclareLetRec(sliceDrop(bindings, 1), envPut(env, binding.Name, Scheme { Bound: [], Predicates: [], Body: typeFromASTInEnv(binding.Type, env, state) }), state)
  end
end

func inferLetRec(bindings: Slice[ast2.LetRecBind], env: Env, state: InferState) -> Result[InferResult, String]
  let recEnv = predeclareLetRec(bindings, env, state)
  let checked = inferLetRecValues(bindings, recEnv, state, emptySubst(), [] as Slice[ast2.LetRecBind])
  switch checked
    case Err(msg) => Err(msg)
    case Ok(step) => Ok(step.Result)
  end
end

func inferLetRecValues(bindings: Slice[ast2.LetRecBind], recEnv: Env, state: InferState, subst: Subst, out: Slice[ast2.LetRecBind]) -> Result[BlockInferStep, String]
  if bindings.Len() == 0 then
    Ok(BlockInferStep { Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: [], Subst: subst, State: state }, Env: recEnv, Stmt: ast2.Stmt.LetRecStmt(out) })
  else
    let binding = bindings.Get(0).UnwrapOr(ast2.LetRecBind { Name: "", Type: ast2.TypeExpr.UnitType, Value: ast2.EmptyExpr() })
    let inferred = inferExpr(binding.Value, recEnv, state)
    switch inferred
      case Err(msg) => Err("letrec binding " + binding.Name + ": " + msg)
      case Ok(eir) =>
        let value = eir.Result
        let combined = composeSubst(value.Subst, subst)
        let declaredType = typeFromASTInEnv(binding.Type, recEnv, value.State)
        let checked = unify(applySubst(combined, value.Type), applySubst(combined, declaredType), combined)
        switch checked
          case Err(msg) => Err("letrec binding " + binding.Name + ": type annotation mismatch: " + msg)
          case Ok(nextSubst) =>
            # Preserve the fully substituted initializer in the typed AST so
            # code generation retains inferred switch target types, selector
            # types, and call dispatch annotations inside letrec bindings.
            let normalisedValue = applyTypedExprSubst(nextSubst, eir.Expr)
            let typedValue = ast2.Expr { ID: normalisedValue.ID, Pos: normalisedValue.Pos, Kind: normalisedValue.Kind, Type: Some(applySubst(nextSubst, declaredType)) }
            let typedBind = ast2.LetRecBind { Name: binding.Name, Type: binding.Type, Value: typedValue }
            inferLetRecValues(sliceDrop(bindings, 1), recEnv, value.State, nextSubst, out.Append(typedBind))
        end
    end
  end
end

func inferBlockBind(bind: ast2.Bind, isVar: Bool, env: Env, state: InferState) -> Result[BlockInferStep, String]
  let r = inferExpr(bind.Value, env, state)
  switch r
    case Err(msg) => Err(msg)
    case Ok(eir) =>
      let v = eir.Result
      let annotated = switch bind.Type
        case Some(t) => unify(v.Type, typeFromASTInEnv(t, env, v.State), v.Subst)
        case None => Ok(v.Subst)
      end
      switch annotated
        case Err(msg) => Err(msg)
        case Ok(s) then
          let boundType = applySubst(s, v.Type)
          let nextEnv = envPut(env, bind.Name, Scheme {
            Bound: generalizeQualified(env, boundType, v.Predicates),
            Predicates: v.Predicates,
            Body: boundType,
          })
          # Preserve the fully substituted type on an unannotated binding's
          # value.  Code generation uses this typed AST to propagate local
          # types through nested selectors.
          let normalisedValue = applyTypedExprSubst(s, eir.Expr)
          let typedValue = ast2.Expr { ID: normalisedValue.ID, Pos: normalisedValue.Pos, Kind: normalisedValue.Kind, Type: Some(boundType) }
          let typedBind = ast2.Bind { Name: bind.Name, Type: bind.Type, Value: typedValue }
          let typedStmt = if isVar then ast2.Stmt.VarStmt(typedBind) else ast2.Stmt.LetStmt(typedBind) end
          Ok(BlockInferStep {
            Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: v.Predicates, Subst: s, State: v.State },
            Env: nextEnv,
            Stmt: typedStmt,
          })
        end
      end
  end
end

func inferLet(bind: ast2.Bind, env: Env, state: InferState) -> Result[InferResult, String]
  let r = inferExpr(bind.Value, env, state)
  switch r
    case Err(msg) => Err(msg)
    case Ok(eir) =>
      let v = eir.Result
      let annotated = switch bind.Type
        case Some(t) => unify(v.Type, typeFromASTInEnv(t, env, v.State), v.Subst)
        case None => Ok(v.Subst)
      end
      switch annotated
        case Err(msg) => Err(msg)
        case Ok(s) =>
          Ok(InferResult {
            Type: ast2.MonoType.TUnit,
            Predicates: v.Predicates,
            Subst: s,
            State: v.State,
          })
      end
  end
end

func matchExpected(v: InferResult, expected: ast2.MonoType, result: ast2.MonoType) -> Result[InferResult, String]
  let s = unify(v.Type, expected, v.Subst)
  switch s
    case Ok(subst) => Ok(InferResult { Type: result, Predicates: v.Predicates, Subst: subst, State: v.State })
    case Err(msg) => Err(msg)
  end
end

func inferField(base: ast2.Expr, field: String, env: Env, state: InferState) -> Result[ExprInferResult, String]
  switch base.Kind
    case IdentExpr(name) =>
      let packageCandidate = envGet(env, name + "." + field)
      switch packageCandidate
        case Some(packageScheme) =>
          let qualified = instantiateQualified(packageScheme, state)
          # TQualifiedName is preserved verbatim.  It identifies the type
          # as coming from a different package while still allowing ordinary
          # TFunc/TVariadic matching for call-type dispatch.
          let te = ast2.Expr { ID: base.ID, Pos: base.Pos, Kind: base.Kind, Type: Some(qualified.Body) }
          Ok(ExprInferResult { Expr: te, Result: InferResult { Type: qualified.Body, Predicates: qualified.Predicates, Subst: emptySubst(), State: state } })
        case None =>
          if isGoPackageAlias(name, state.GoPackages) then
            Err("unknown Go package member " + field)
          else
            inferNamedField(base, name, field, env, state)
          end
      end
    # Imported enum constructors are parsed as nested selectors. Resolve the
    # complete `alias.Enum.Variant` key before treating `Enum` as a receiver
    # with an ordinary field.
    case FieldExpr(parent, enumName) then
      switch parent.Kind
        case IdentExpr(alias) then
          switch envGet(env, alias + "." + enumName + "." + field)
            case Some(packageScheme) then
              let qualified = instantiateQualified(packageScheme, state)
              let te = ast2.Expr { ID: base.ID, Pos: base.Pos, Kind: base.Kind, Type: Some(qualified.Body) }
              Ok(ExprInferResult { Expr: te, Result: InferResult { Type: qualified.Body, Predicates: qualified.Predicates, Subst: emptySubst(), State: state } })
            end
            case None => inferOrdinaryField(base, field, env, state)
          end
        end
        case _ => inferOrdinaryField(base, field, env, state)
      end
    end
    case _ => inferOrdinaryField(base, field, env, state)
  end
end

func inferNamedField(base: ast2.Expr, name: String, field: String, env: Env, state: InferState) -> Result[ExprInferResult, String]
      let candidate = envGet(env, field)
      switch candidate
        case Some(scheme) =>
          switch scheme.Body
            # Variants with fields are functions; a zero-argument variant has
            # the enum type itself as its scheme body.
            case TCon(enumName) =>
              if enumName == name then
                let qualified = instantiateQualified(scheme, state)
                let te = ast2.Expr { ID: base.ID, Pos: base.Pos, Kind: base.Kind, Type: Some(qualified.Body) }
                Ok(ExprInferResult { Expr: te, Result: InferResult { Type: qualified.Body, Predicates: qualified.Predicates, Subst: emptySubst(), State: state } })
              else
                inferOrdinaryField(base, field, env, state)
              end
            case _ => inferOrdinaryField(base, field, env, state)
          end
        case None => inferOrdinaryField(base, field, env, state)
      end
end

func inferOrdinaryField(base: ast2.Expr, field: String, env: Env, state: InferState) -> Result[ExprInferResult, String]
  let r = inferExpr(base, env, state)
  switch r
    case Err(msg) => Err(msg)
    case Ok(eir) then
      let typedBase = eir.Expr
      let v = eir.Result
      let resolvedType = switch applySubst(v.Subst, v.Type)
        case TCon(_) => applySubst(v.Subst, v.Type)
        case TApp(typeRef, args) then
          switch typeRef.value()
            case TCon(name) then
              if name == "Ref" && args.Len() == 1 then
                applySubst(v.Subst, args.Get(0).UnwrapOr(ast2.MonoType.TUnit))
              else
                applySubst(v.Subst, v.Type)
              end
            end
            case _ => applySubst(v.Subst, v.Type)
          end
        end
        case _ => applySubst(v.Subst, v.Type)
      end
      switch getTCon(resolvedType)
        case Some(pair) then
          let (innerName, args) = pair
          # When the receiver is a foreign-package type wrapped in
          # TQualifiedName, getTCon returns the bare inner name (e.g. "T"
          # for `Ref[testing.T]`).  The symbol table, however, registers
          # Go-FFI methods under the full `alias.Name` form
          # ("testing.T").  Re-derive that form here by mapping the
          # qualified import path back to its alias.  Local receivers
          # leave the bare name untouched.
          let typeName = receiverQualifiedName(applySubst(v.Subst, v.Type), innerName, state.GoPackages, state.MyGoPackageCache, 0)
          switch findSymbol(typeName, field, state.Symbols)
            case Some(symbol) then
              switch symbol
                case StructField(_, _, fieldType) then
                  let substed = switchFieldTypeArgs(fieldType, typeName, args, env)
                  let instState = withFreshID(v.State, v.State.FreshVarID + 1)
                  Ok(ExprInferResult { Expr: typedBase, Result: InferResult { Type: substed, Predicates: v.Predicates, Subst: v.Subst, State: instState } })
                end
                case GoMethod(_, _, sig) then
                  let methodType = GoSignatureType(sig)
                  let instState = withFreshID(v.State, v.State.FreshVarID + 1)
                  Ok(ExprInferResult { Expr: typedBase, Result: InferResult { Type: methodType, Predicates: v.Predicates, Subst: v.Subst, State: instState } })
                end
                case ImplMethod(_, _, scheme) then
                  let q = instantiateQualified(scheme, v.State)
                  let instState = withFreshID(v.State, v.State.FreshVarID + scheme.Bound.Len())
                  let substed = switchFieldTypeArgs(q.Body, typeName, args, env)
                  switch stripReceiverArg(substed, typeName, args, v.Subst)
                    case Some(stripResult) then
                      switch stripResult
                        case Ok(pair2) then
                          let (strippedType, s2) = pair2
                          Ok(ExprInferResult { Expr: typedBase, Result: InferResult { Type: strippedType, Predicates: appendPredicates(v.Predicates, q.Predicates), Subst: s2, State: instState } })
                        end
                        case Err(msg) => Err(msg)
                      end
                    end
                    case None then
                      Ok(ExprInferResult {
                        Expr: typedBase,
                        Result: InferResult {
                          Type: substed,
                          Predicates: appendPredicates(v.Predicates, q.Predicates),
                          Subst: v.Subst,
                          State: instState
                        }
                      })
                    end
                  end
                end
                case EnumVariant(_, _, ctorType) then
                  let substed = switchFieldTypeArgs(ctorType, typeName, args, env)
                  let instState = withFreshID(v.State, v.State.FreshVarID + 1)
                  Ok(ExprInferResult { Expr: typedBase, Result: InferResult { Type: substed, Predicates: v.Predicates, Subst: v.Subst, State: instState } })
                end
              end
            end
            case None => Err("unknown field " + typeName + "." + field)
          end
        end
        case None then
          let fresh = ast2.MonoType.TVar(v.State.FreshVarID)
          Ok(ExprInferResult { Expr: typedBase, Result: InferResult { Type: fresh, Predicates: v.Predicates, Subst: v.Subst, State: withFreshID(v.State, v.State.FreshVarID + 1) } })
        end
      end
    end
  end
end

# receiverQualifiedName returns the symbol-table key for the receiver of a
# field access.  When the receiver is a foreign-package type wrapped in
# TQualifiedName (e.g. `Ref[testing.T]` whose inner is
# `TQualifiedName("go:testing", TCon("T"))`), the method table was
# registered under the `alias.Name` form.  This helper maps the qualified
# path back to the alias and rebuilds the qualified name; for local
# receivers it returns the bare `innerName` unchanged.
func receiverQualifiedName(receiver: ast2.MonoType, innerName: String, goPkgs: Slice[GoPackageEntry], myGoPkgs: Slice[MyGoPackageInfo], index: Int) -> String
  switch receiver
    case TApp(typeRef, args) then
      switch typeRef.value()
        case TCon(name) then
          if name == "Ref" && args.Len() == 1 then
            receiverQualifiedName(args.Get(0).UnwrapOr(ast2.MonoType.TUnit), innerName, goPkgs, myGoPkgs, index)
          else
            innerName
          end
        end
        # An imported generic receiver (`ps.Reply[Rune]`) is
        # TApp(TQualifiedName(path, TCon(name)), args).  Recurse with the bare
        # TQualifiedName so the alias-qualified symbol key (`ps.Reply`) is
        # rebuilt below.
        case TQualifiedName(path, inner) => receiverQualifiedName(ast2.MonoType.TQualifiedName(path, inner), innerName, goPkgs, myGoPkgs, index)
        case _ => innerName
      end
    end
    case TQualifiedName(path, inner) then
      let memberName = switch inner.value()
        case TCon(name) => name
        case _ => innerName
      end
      let alias = goPackageAliasForPath(goPkgs, path, 0)
      if alias == "" then
        let myGoAlias = myGoPackageAliasForPath(myGoPkgs, path, 0)
        if myGoAlias != "" then
          myGoAlias + "." + memberName
        else
        # Fall back to a path-derived alias when the Go-FFI package table
        # is unavailable (e.g. bootstrap inference running before
        # bootstrapPopulateGoSignatures completes).  Stripping the `go:`
        # prefix recovers the source-level alias the user wrote in the
        # import declaration.
        let pathAlias = if strings.HasPrefix(path, "go:") => substring(path, 3, path.Len() - 3).UnwrapOr("") else path
        if pathAlias == "" then
          innerName
        else
          pathAlias + "." + memberName
        end
        end
      else
        if alias == "." then memberName else alias + "." + memberName end
      end
    end
    case _ => innerName
  end
end

# goPackageAliasForPath returns the alias registered for `path` in the
# Go FFI import list, or "" when no such entry exists.
func goPackageAliasForPath(goPkgs: Slice[GoPackageEntry], path: String, index: Int) -> String
  if index >= goPkgs.Len() then
    ""
  else
    switch goPkgs.Get(index)
      case Some(entry) then
        if entry.Path == path then
          entry.Alias
        else
          goPackageAliasForPath(goPkgs, path, index + 1)
        end
      end
      case _ => goPackageAliasForPath(goPkgs, path, index + 1)
    end
  end
end

# stripReceiverArg recognises impl-method schemes (registered by
# `registerImplMethods`) whose Body is a function type with the *receiver* as
# its first parameter.  When `fieldType` has that shape — first param is a
# `TCon(typeName, _)` (non-generic receiver) or `TApp(TCon(typeName), _)` (a
# parametric receiver such as `Option[A]`) matching the lookup key — it
# unifies the receiver pattern with the actual receiver (`args` are the
# receiver's concrete type arguments), applies the resulting substitution
# to the remaining parameters and the return type, then returns a stripped
# function type with the receiver dropped and the new substitution.  Returns
# None for ordinary struct field projections (e.g. `Parser.Run`) so the
# caller falls back to the plain `substed` value.
func stripReceiverArg(fieldType: ast2.MonoType, typeName: String, args: Slice[ast2.MonoType], subst: Subst) -> Option[Result[(ast2.MonoType, Subst), String]]
  switch fieldType
    case TFunc(methodArgs, methodRet) then
      if methodArgs.Len() == 0 then None else
        let first = methodArgs.Get(0).UnwrapOr(ast2.MonoType.TUnit)
        let recvName = switch first
          case TCon(name) => name
          case TApp(ctor, _) => switch ctor.value()
            case TCon(name) => name
            case _ => ""
          end
          case _ => ""
        end
        if recvName != typeName then
          None
        else
          # The actual receiver type is `typeName[args]`.
          let receiverType = tCon(typeName, args)
          # Unify the instantiated receiver pattern with the actual receiver
          # to derive substitution entries for the impl's type parameters
          # (e.g. `T` in `SliceIEnumerable[T].Fold` gets bound to `Parser[A]`
          # when folding `Slice[Parser[A]]`).
          let us = unify(first, receiverType, subst)
          switch us
            case Err(msg) => Some(Err("method receiver mismatch: " + msg))
            case Ok(s2) then
              let droppedArgs = sliceDrop(methodArgs, 1)
              let newRet = applySubst(s2, methodRet.value())
              let strippedBody = applySubstMonoList(s2, droppedArgs)
              Some(Ok((ast2.MonoType.TFunc(strippedBody, Ref.new(newRet)), s2)))
            end
          end
        end
      end
    end
    case _ => None
  end
end

func applySubstMonoList(subst: Subst, items: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  applySubstMonoListInto(subst, items, 0, [])
end

func applySubstMonoListInto(subst: Subst, items: Slice[ast2.MonoType], index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= items.Len() then out else
    applySubstMonoListInto(subst, items, index + 1, out.Append(applySubst(subst, items.Get(index).UnwrapOr(ast2.MonoType.TUnit))))
  end
end

func switchFieldTypeArgs(fieldType: ast2.MonoType, typeName: String, args: Slice[ast2.MonoType], env: Env) -> ast2.MonoType
  # Read the struct's type param IDs from its env Scheme Bound.
  let scheme = envGet(env, typeName)
  switch scheme
    case Some(s) then
      if s.Bound.Len() == 0 || args.Len() == 0 then
        fieldType
      else
        let subst = bindDistinctFieldArgs(s.Bound, args, 0, emptySubst())
        if substIsEmpty(subst) then fieldType else applySubst(subst, fieldType) end
      end
    end
    case None => fieldType
  end
end

func bindDistinctFieldArgs(bound: Slice[Int], args: Slice[ast2.MonoType], index: Int, out: Subst) -> Subst
  if index >= bound.Len() || index >= args.Len() then
    out
  else
    let id = bound.Get(index).UnwrapOr(0)
    let typ = args.Get(index).UnwrapOr(ast2.MonoType.TUnit)
    # Skip self-mappings (TVar with same ID as the bound param).
    let next = switch typ
      case TVar(other) => if other == id then out else substPrepend(out, SubstEntry { ID: id, Type: typ }) end
      case _ => substPrepend(out, SubstEntry { ID: id, Type: typ })
    end
    bindDistinctFieldArgs(bound, args, index + 1, next)
  end
end


func goFuncArity(path: String, name: String) -> Int
  go[Int] {
    code: "func() int { pkg, err := {importer}.Default().Import({path}); if err != nil { return -2 }; obj := pkg.Scope().Lookup({name}); if obj == nil { return -2 }; sig, ok := obj.Type().(*{gotypes}.Signature); if !ok { return -2 }; if sig.Variadic() { return -1 }; return sig.Params().Len() }()"
    in importer = importer
    in path = path
    in name = name
    in gotypes = gotypes
  }
end

func inferVariants(vars: Slice[ast2.Variant], enumName: String, tps: Slice[String], env: Env, fields: Slice[FieldEntry], state: InferState) -> Result[DeclInfer, String]
  if vars.Len() == 0 then
    Ok(DeclInfer {
      Env: envPut(env, enumName, Scheme {
        Bound: typeParamIDs(tps, 1),
        Predicates: [],
        Body: tCon(enumName, typeParamsAsTypes(tps, 1))
      }),
      Fields: fields,
      State: state,
      TypedDecl: None
    })
  else
    let v = vars.Get(0).UnwrapOr(ast2.Variant { Name: "", Fields: emptyASTTypeExprs() })
    let enumType = tCon(enumName, typeParamsAsTypes(tps, 1))
    let constructorType = if v.Fields.Len() == 0 then
      enumType
    else
      # Keep qualified imports (`ast2.Expr`) qualified, mirroring
      # predeclareEnumVariants.  Using the plain (env-free) conversion here
      # re-registered constructors with bare TCon field types that shadowed
      # the qualified predeclared scheme, so pattern bindings and struct
      # literal fields disagreed on imported type identity.
      let fieldTypes = typeArgsFromASTInEnvWithParamsList(v.Fields, tps, env, state)
      ast2.MonoType.TFunc(fieldTypes, Ref.new(enumType))
    end
    inferVariants(sliceDrop(vars, 1), enumName, tps, envPut(env, v.Name, Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: constructorType }), fields, state)
  end
end

func typeParamsAsTypes(params: Slice[String], index: Int) -> Slice[ast2.MonoType]
  typeParamsAsTypesInto(params, index, 0, [])
end

func typeParamsAsTypesInto(params: Slice[String], nextID: Int, position: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if position >= params.Len() then out
  else typeParamsAsTypesInto(params, nextID + 1, position + 1, out.Append(ast2.MonoType.TParam(-nextID))) end
end

# 推断结构体字面量的类型: TypeName { field1: expr1, field2: expr2 }
# 遍历所有字段，对每个字段进行类型推断，最终返回结构体类型 TCon(typeName, [])
func inferStructLit(typeName: String, fields: Slice[ast2.StructLitField], env: Env, state: InferState) -> Result[InferResult, String]
  let typed = inferTypedStructLit(typeName, fields, env, state)
  switch typed
    case Ok(pair) =>
      let (result, _) = pair
      Ok(result)
    case Err(msg) => Err(msg)
  end
end

func inferTypedStructLit(typeName: String, fields: Slice[ast2.StructLitField], env: Env, state: InferState) -> Result[(InferResult, Slice[ast2.StructLitField]), String]
  inferTypedStructLitForType(structLitTypeInEnv(typeName, env, state), fields, env, state)
end

func inferTypedStructLitForType(resultType: ast2.MonoType, fields: Slice[ast2.StructLitField], env: Env, state: InferState) -> Result[(InferResult, Slice[ast2.StructLitField]), String]
  inferTypedStructLitFields(resultType, fields, env, state, emptySubst(), state, [], [] as Slice[ast2.StructLitField])
end

func structLitTypeInEnv(typeName: String, env: Env, state: InferState) -> ast2.MonoType
  switch envGet(env, typeName)
    case Some(scheme) => instantiate(scheme, state)
    case None => ast2.MonoType.TCon(typeName)
  end
end

func inferTypedStructLitFields(resultType: ast2.MonoType, fields: Slice[ast2.StructLitField], env: Env, state: InferState, subst: Subst, curState: InferState, predicates: Slice[Predicate], out: Slice[ast2.StructLitField]) -> Result[(InferResult, Slice[ast2.StructLitField]), String]
  if fields.Len() == 0 then
    Ok((InferResult { Type: resultType, Predicates: predicates, Subst: subst, State: curState }, applyTypedStructLitFieldsSubst(subst, out)))
  else
    let f = fields.Get(0).UnwrapOr(ast2.StructLitField { Name: "", Value: ast2.EmptyExpr() })
    let r = inferExpr(f.Value, env, curState)
    switch r
      case Err(msg) => Err(msg)
      case Ok(eir) then
        let v = eir.Result
        let expectedField = structLitFieldType(applySubst(subst, resultType), f.Name, env, state)
        switch expectedField
          # Imported struct fields are not all represented in the local
          # symbol table. Keep their established inference path while local
          # structs use the field type to resolve generic arguments.
          case None then
            let typedField = ast2.StructLitField { Name: f.Name, Value: eir.Expr }
            inferTypedStructLitFields(resultType, sliceDrop(fields, 1), env, v.State, composeSubst(v.Subst, subst), v.State, appendPredicates(predicates, v.Predicates), out.Append(typedField))
          end
          case Some(fieldType) then
            switch unify(applySubst(v.Subst, fieldType), applySubst(v.Subst, v.Type), v.Subst)
              case Err(msg) => Err("struct field " + f.Name + ": " + msg)
              case Ok(s2) then
                let typedField = ast2.StructLitField { Name: f.Name, Value: applyTypedExprSubst(s2, eir.Expr) }
                inferTypedStructLitFields(resultType, sliceDrop(fields, 1), env, v.State, composeSubst(s2, subst), v.State, appendPredicates(predicates, v.Predicates), out.Append(typedField))
              end
            end
          end
        end
      end
    end
  end
end

# A generic struct literal instantiates its type constructor before its field
# values are inferred. Match each field against that instantiated type so
# `Pair { first: 1, second: 2 }` determines `Pair[Int]` without requiring a
# separate binding annotation.  Imported generic structs (e.g.
# `ps.Reply[JsonValue]`) are resolved through the alias-qualified symbol key
# so the `Value` field unifies with `JsonValue` instead of staying a fresh
# type variable.
func structLitFieldType(resultType: ast2.MonoType, fieldName: String, env: Env, state: InferState) -> Option[ast2.MonoType]
  switch getTCon(resultType)
    case None => None
    case Some(pair) then
      let (typeName, args) = pair
      let key = structLitFieldKey(resultType, typeName, state)
      switch findSymbol(key, fieldName, state.Symbols)
        case Some(symbol) then
          switch symbol
            case StructField(_, _, fieldType) => Some(switchFieldTypeArgs(fieldType, key, args, env))
            case _ => None
          end
        end
        case None => None
      end
    end
  end
end

# structLitFieldKey re-derives the symbol-table key for a (possibly imported)
# struct literal type.  TApp(TQualifiedName(path, TCon(name)), args) and bare
# TQualifiedName(path, TCon(name)) become `alias.name` (e.g. `ps.Reply`) so
# imported structs registered under their source alias can be found; local
# types keep their bare name.
func structLitFieldKey(resultType: ast2.MonoType, bareName: String, state: InferState) -> String
  switch resultType
    case TApp(typeRef, _) =>
      switch typeRef.value()
        case TQualifiedName(path, inner) => qualifiedStructMember(path, inner.value(), bareName, state)
        case _ => bareName
      end
    case TQualifiedName(path, inner) => qualifiedStructMember(path, inner.value(), bareName, state)
    case _ => bareName
  end
end

# qualifiedStructMember maps an import path back to its source alias and
# rebuilds the `alias.member` form, mirroring receiverQualifiedName.  Dot
# imports yield just the member name.
func qualifiedStructMember(path: String, inner: ast2.MonoType, fallback: String, state: InferState) -> String
  let member = switch inner
    case TCon(name) => name
    case _ => fallback
  end
  let goAlias = goPackageAliasForPath(state.GoPackages, path, 0)
  let alias = if goAlias == "" then myGoPackageAliasForPath(state.MyGoPackageCache, path, 0) else goAlias end
  if alias == "" then fallback elsif alias == "." then member else alias + "." + member end
end

func applyTypedStructLitFieldsSubst(subst: Subst, fields: Slice[ast2.StructLitField]) -> Slice[ast2.StructLitField]
  applyTypedStructLitFieldsSubstInto(subst, fields, 0, [])
end

func applyTypedStructLitFieldsSubstInto(subst: Subst, fields: Slice[ast2.StructLitField], index: Int, out: Slice[ast2.StructLitField]) -> Slice[ast2.StructLitField]
  if index >= fields.Len() then out else
    let field = fields.Get(index).UnwrapOr(ast2.StructLitField { Name: "", Value: ast2.EmptyExpr() })
    applyTypedStructLitFieldsSubstInto(subst, fields, index + 1, out.Append(ast2.StructLitField { Name: field.Name, Value: applyTypedExprSubst(subst, field.Value) }))
  end
end

# Apply a completed local substitution before embedding a typed subtree in a
# parent. Codegen consumes this annotation directly; it does not reconstruct
# receiver types from local scopes or selector syntax.
func applyTypedExprSubst(subst: Subst, expr: ast2.Expr) -> ast2.Expr
  let typ = switch expr.Type
    case Some(t) => Some(applySubst(subst, t))
    case None => None
  end
  let kind = switch expr.Kind
    case CallExpr(callee, typeArgs, args) => ast2.ExprKind.CallExpr(applyTypedExprSubst(subst, callee), typeArgs, applyTypedExprsSubst(subst, args))
    case DictionaryCallExpr(key, receiver, args) => ast2.ExprKind.DictionaryCallExpr(key, applyTypedExprSubst(subst, receiver), applyTypedExprsSubst(subst, args))
    case FieldExpr(base, field) => ast2.ExprKind.FieldExpr(applyTypedExprSubst(subst, base), field)
    case UnaryExpr(op, inner) => ast2.ExprKind.UnaryExpr(op, applyTypedExprSubst(subst, inner))
    case BinaryExpr(op, left, right) => ast2.ExprKind.BinaryExpr(op, applyTypedExprSubst(subst, left), applyTypedExprSubst(subst, right))
    case TupleExpr(items) => ast2.ExprKind.TupleExpr(applyTypedExprsSubst(subst, items))
    case SliceLitExpr(items) => ast2.ExprKind.SliceLitExpr(applyTypedExprsSubst(subst, items))
    case TypeAsExpr(value, target) => ast2.ExprKind.TypeAsExpr(applyTypedExprSubst(subst, value), target)
    case IfExpr(cond, thenExpr, elseExpr) => ast2.ExprKind.IfExpr(applyTypedExprSubst(subst, cond), applyTypedExprSubst(subst, thenExpr), applyTypedExprSubst(subst, elseExpr))
    case BlockExpr(items) => ast2.ExprKind.BlockExpr(applyTypedStmtsSubst(subst, items))
    case SwitchExpr(target, cases, targetType) then
      let resolvedTargetType = switch targetType
        case Some(typ) => Some(applySubst(subst, typ))
        case None => None
      end
      ast2.ExprKind.SwitchExpr(applyTypedExprSubst(subst, target), applyTypedSwitchCasesSubst(subst, cases), resolvedTargetType)
    end
    case FuncLitExpr(params, ret, body) => ast2.ExprKind.FuncLitExpr(params, ret, applyTypedExprSubst(subst, body))
    case StructLitExpr(name, fields) => ast2.ExprKind.StructLitExpr(name, applyTypedStructLitFieldsSubst(subst, fields))
    case GenericStructLitExpr(name, args, fields) => ast2.ExprKind.GenericStructLitExpr(name, args, applyTypedStructLitFieldsSubst(subst, fields))
    case _ => expr.Kind
  end
  ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: kind, Type: typ }
end

func applyTypedExprsSubst(subst: Subst, exprs: Slice[ast2.Expr]) -> Slice[ast2.Expr]
  applyTypedExprsSubstInto(subst, exprs, 0, [] as Slice[ast2.Expr])
end

func applyTypedMapPairsSubst(subst: Subst, pairs: Slice[(ast2.Expr, ast2.Expr)]) -> Slice[(ast2.Expr, ast2.Expr)]
  applyTypedMapPairsSubstInto(subst, pairs, 0, [] as Slice[(ast2.Expr, ast2.Expr)])
end

func applyTypedMapPairsSubstInto(subst: Subst, pairs: Slice[(ast2.Expr, ast2.Expr)], index: Int, out: Slice[(ast2.Expr, ast2.Expr)]) -> Slice[(ast2.Expr, ast2.Expr)]
  if index >= pairs.Len() then out else
    let p = pairs.Get(index).UnwrapOr((ast2.EmptyExpr(), ast2.EmptyExpr()))
    let (k, v) = p
    applyTypedMapPairsSubstInto(subst, pairs, index + 1, out.Append((applyTypedExprSubst(subst, k), applyTypedExprSubst(subst, v))))
  end
end

func applyTypedExprsSubstInto(subst: Subst, exprs: Slice[ast2.Expr], index: Int, out: Slice[ast2.Expr]) -> Slice[ast2.Expr]
  if index >= exprs.Len() then out else
    applyTypedExprsSubstInto(subst, exprs, index + 1, out.Append(applyTypedExprSubst(subst, exprs.Get(index).UnwrapOr(ast2.EmptyExpr()))))
  end
end

func applyTypedSwitchCasesSubst(subst: Subst, cases: Slice[ast2.SwitchCase]) -> Slice[ast2.SwitchCase]
  applyTypedSwitchCasesSubstInto(subst, cases, 0, [])
end

func applyTypedSwitchCasesSubstInto(subst: Subst, cases: Slice[ast2.SwitchCase], index: Int, out: Slice[ast2.SwitchCase]) -> Slice[ast2.SwitchCase]
  if index >= cases.Len() then out else
    let current = cases.Get(index).UnwrapOr(ast2.SwitchCase { Pattern: ast2.Pattern.WildcardPattern, Body: ast2.EmptyExpr() })
    applyTypedSwitchCasesSubstInto(subst, cases, index + 1, out.Append(ast2.SwitchCase { Pattern: current.Pattern, Body: applyTypedExprSubst(subst, current.Body) }))
  end
end

func applyTypedStmtsSubst(subst: Subst, items: Slice[ast2.Stmt]) -> Slice[ast2.Stmt]
  applyTypedStmtsSubstInto(subst, items, 0, [])
end

func applyTypedStmtsSubstInto(subst: Subst, items: Slice[ast2.Stmt], index: Int, out: Slice[ast2.Stmt]) -> Slice[ast2.Stmt]
  if index >= items.Len() then out else
    let current = items.Get(index).UnwrapOr(ast2.Stmt.ExprStmt(ast2.EmptyExpr()))
    applyTypedStmtsSubstInto(subst, items, index + 1, out.Append(applyTypedStmtSubst(subst, current)))
  end
end

func applyTypedStmtSubst(subst: Subst, stmt: ast2.Stmt) -> ast2.Stmt
  switch stmt
    case ExprStmt(value) => ast2.Stmt.ExprStmt(applyTypedExprSubst(subst, value))
    case LetStmt(bind) => ast2.Stmt.LetStmt(ast2.Bind { Name: bind.Name, Type: bind.Type, Value: applyTypedExprSubst(subst, bind.Value) })
    case VarStmt(bind) => ast2.Stmt.VarStmt(ast2.Bind { Name: bind.Name, Type: bind.Type, Value: applyTypedExprSubst(subst, bind.Value) })
    case WhileStmt(cond, body) => ast2.Stmt.WhileStmt(applyTypedExprSubst(subst, cond), applyTypedExprSubst(subst, body))
    case AssignStmt(target, value) => ast2.Stmt.AssignStmt(applyTypedExprSubst(subst, target), applyTypedExprSubst(subst, value))
    case ReturnWithStmt(value) => ast2.Stmt.ReturnWithStmt(applyTypedExprSubst(subst, value))
    case _ => stmt
  end
end

func inferMapLit(pairs: Slice[(ast2.Expr, ast2.Expr)], env: Env, s0: InferState) -> Result[(InferResult, Slice[(ast2.Expr, ast2.Expr)]), String]
  if pairs.Len() == 0 then
    let kt = ast2.MonoType.TVar(s0.FreshVarID)
    let vt = ast2.MonoType.TVar(s0.FreshVarID + 1)
    let empty: Slice[(ast2.Expr, ast2.Expr)] = []
    Ok((InferResult {
      Type: ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Map")), [kt, vt]),
      Predicates: [],
      Subst: emptySubst(),
      State: withFreshID(s0, s0.FreshVarID + 2)
    }, empty))
  else
    let (k0, v0) = pairs.Get(0).UnwrapOr((ast2.EmptyExpr(), ast2.EmptyExpr()))
    let kr = inferExpr(k0, env, s0)
    switch kr
      case Err(msg) => Err("map key: " + msg)
      case Ok(keir) =>
        let kv = keir.Result
        let vr = inferExpr(v0, env, kv.State)
        switch vr
          case Err(msg) => Err("map value: " + msg)
          case Ok(eireir) then
            let vv = eireir.Result
            let s1 = composeSubst(vv.Subst, kv.Subst)
            let resultType = ast2.MonoType.TApp(
              Ref.new(ast2.MonoType.TCon("Map")),
              [applySubst(s1, kv.Type), applySubst(s1, vv.Type)]
            )
            inferMapLitTail(
              sliceDrop(pairs, 1),
              env,
              vv.State,
              s1,
              resultType,
              appendPredicates(kv.Predicates, vv.Predicates),
              [(keir.Expr, eireir.Expr)] as Slice[(ast2.Expr, ast2.Expr)]
            )
          end
        end
    end
  end
end

func inferMapLitTail(pairs: Slice[(ast2.Expr, ast2.Expr)], env: Env, s0: InferState, subst: Subst, resultType: ast2.MonoType, predicates: Slice[Predicate], typed: Slice[(ast2.Expr, ast2.Expr)]) -> Result[(InferResult, Slice[(ast2.Expr, ast2.Expr)]), String]
  if pairs.Len() == 0 then
    Ok((InferResult { Type: resultType, Predicates: predicates, Subst: subst, State: s0 }, applyTypedMapPairsSubst(subst, typed)))
  else
    let (k, v) = pairs.Get(0).UnwrapOr((ast2.EmptyExpr(), ast2.EmptyExpr()))
    let kr = inferExpr(k, env, s0)
    switch kr
      case Err(msg) => Err("map key: " + msg)
      case Ok(eirK) =>
        let kv = eirK.Result
        let vr = inferExpr(v, env, kv.State)
        switch vr
          case Err(msg) => Err("map value: " + msg)
          case Ok(eirV) => inferMapLitTail(sliceDrop(pairs, 1), env, eirV.Result.State, composeSubst(eirV.Result.Subst, composeSubst(kv.Subst, subst)), resultType, appendPredicates(predicates, appendPredicates(kv.Predicates, eirV.Result.Predicates)), typed.Append((eirK.Expr, eirV.Expr)))
        end
    end
  end
end

func inferSetLit(items: Slice[ast2.Expr], env: Env, s0: InferState) -> Result[(InferResult, Slice[ast2.Expr]), String]
  switch duplicateSetLiteralElement(items, [])
    case Some(duplicate) => Err(errorAtExpr(duplicate, "duplicate element in set literal"))
    case None =>
      if items.Len() == 0 then
        let et = ast2.MonoType.TVar(s0.FreshVarID)
        let empty: Slice[ast2.Expr] = []
        Ok((InferResult {
          Type: ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Set")), [et]),
          Predicates: [],
          Subst: emptySubst(),
          State: withFreshID(s0, s0.FreshVarID + 1)
        }, empty))
      else
        let r0 = inferExpr(items.Get(0).UnwrapOr(ast2.EmptyExpr()), env, s0)
        switch r0
          case Err(msg) => Err("set element: " + msg)
          case Ok(eir0) then
            let v0 = eir0.Result
            let resultType = ast2.MonoType.TApp(Ref.new(ast2.MonoType.TCon("Set")), [applySubst(v0.Subst, v0.Type)])
            inferSetLitTail(sliceDrop(items, 1), env, v0.State, v0.Subst, resultType, v0.Predicates, [eir0.Expr])
          end
        end
      end
  end
end

# A Set literal is lowered to a Go map literal, where duplicate constant keys
# are invalid. Detect repeated literals here so diagnostics remain in MyGO and
# point to the later, duplicate element. Non-literal expressions are left to
# normal runtime set semantics.
func duplicateSetLiteralElement(items: Slice[ast2.Expr], seen: Slice[String]) -> Option[ast2.Expr]
  if items.Len() == 0 then None else
    let item = items.Get(0).UnwrapOr(ast2.EmptyExpr())
    switch setLiteralElementKey(item)
      case None => duplicateSetLiteralElement(sliceDrop(items, 1), seen)
      case Some(key) =>
        if stringSliceContains(seen, key) then Some(item) else duplicateSetLiteralElement(sliceDrop(items, 1), seen.Append(key)) end
    end
  end
end

func setLiteralElementKey(item: ast2.Expr) -> Option[String]
  switch item.Kind
    case NumberExpr(value) => Some("number:" + value)
    case StringExpr(value) => Some("string:" + value)
    case RuneExpr(value) => Some("rune:" + value)
    case BoolExpr(value) => Some("bool:" + value.ToString())
    case _ => None
  end
end

func inferSetLitTail(items: Slice[ast2.Expr], env: Env, s0: InferState, subst: Subst, resultType: ast2.MonoType, predicates: Slice[Predicate], typed: Slice[ast2.Expr]) -> Result[(InferResult, Slice[ast2.Expr]), String]
  if items.Len() == 0 then
    Ok((InferResult { Type: resultType, Predicates: predicates, Subst: subst, State: s0 }, applyTypedExprsSubst(subst, typed)))
  else
    let r = inferExpr(items.Get(0).UnwrapOr(ast2.EmptyExpr()), env, s0)
    switch r
      case Err(msg) => Err("set element: " + msg)
      case Ok(eir) => inferSetLitTail(sliceDrop(items, 1), env, eir.Result.State, composeSubst(eir.Result.Subst, subst), resultType, appendPredicates(predicates, eir.Result.Predicates), typed.Append(eir.Expr))
    end
  end
end

func maxSubstID(subst: Subst) -> Int
  subst.MaxID
end

func findSymbol(typeName: String, field: String, symbols: Slice[Symbol]) -> Option[Symbol]
  if symbols.Len() == 0 then None else
    let s = symbols.Get(0).UnwrapOr(Symbol.StructField("", "", ast2.MonoType.TUnit))
    switch s
      case StructField(tn, fn, _) =>
        if tn == typeName && fn == field then Some(s) else findSymbol(typeName, field, sliceDrop(symbols, 1)) end
      case GoMethod(tn, mn, _) =>
        if tn == typeName && mn == field then Some(s) else findSymbol(typeName, field, sliceDrop(symbols, 1)) end
      case ImplMethod(tn, mn, _) =>
        if tn == typeName && mn == field then Some(s) else findSymbol(typeName, field, sliceDrop(symbols, 1)) end
      case EnumVariant(tn, vn, _) =>
        if tn == typeName && vn == field then Some(s) else findSymbol(typeName, field, sliceDrop(symbols, 1)) end
    end
  end
end
