package typeinference2

import ast2 "github.com/mygo-lang/mygo/internal/mygo/ast2"
import fmt "go:fmt"
import importer "go:go/importer"
import gotypes "go:go/types"
import strings "go:strings"

# Predeclare function signatures so a declaration can call functions defined
# later in the same source file. This is required by the self-hosted modules,
# whose mutually-recursive helpers are intentionally grouped by concern.
func predeclareFunctions(decls: Slice[ast2.Decl], env: Slice[EnvEntry]) -> Slice[EnvEntry]
  if decls.Len() == 0 then
    env
  else
    let decl = decls.Get(0).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    let next = switch decl
      case FuncDecl(name, tps, params, ret, _, constraints) =>
        let retType = switch ret
          case Some(t) => typeFromASTWithParams(t, tps)
          case None => ast2.MonoType.TUnit
        end
        envPut(env, name, Scheme { Bound: typeParamIDs(tps, 1), Predicates: predicatesFromConstraintsWithParams(constraints, tps), Body: ast2.MonoType.TFunc(paramsToTypesWithParams(params, tps), Ref.new(retType)) })
      case EnumDecl(name, tps, vars) =>
        predeclareEnum(env, name, tps, vars)
      case _ => env
    end
    predeclareFunctions(sliceDrop(decls, 1), next)
  end
end

func predeclareEnum(env: Slice[EnvEntry], name: String, tps: Slice[String], vars: Slice[ast2.Variant]) -> Slice[EnvEntry]
  let enumType = ast2.MonoType.TCon(name, typeParamsAsTypes(tps, 1))
  let envWithEnum = envPut(env, name, Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: enumType })
  predeclareEnumVariants(envWithEnum, vars, name, tps)
end

func predeclareEnumVariants(env: Slice[EnvEntry], vars: Slice[ast2.Variant], name: String, tps: Slice[String]) -> Slice[EnvEntry]
  if vars.Len() == 0 then env else
    let v = vars.Get(0).UnwrapOr(ast2.Variant { Name: "", Fields: emptyASTTypeExprs() })
    let enumType = ast2.MonoType.TCon(name, typeParamsAsTypes(tps, 1))
    let constructorType = if v.Fields.Len() == 0 then enumType else ast2.MonoType.TFunc(typeArgsFromASTWithParams(v.Fields, tps), Ref.new(enumType)) end
    predeclareEnumVariants(envPut(env, v.Name, Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: constructorType }), sliceDrop(vars, 1), name, tps)
  end
end

func inferDecls(decls: Slice[ast2.Decl], env: Slice[EnvEntry], fields: Slice[FieldEntry], state: InferState) -> Result[PackageInfo, String]
  if decls.Len() == 0 then
    Ok(PackageInfo { Env: env, Fields: fields, GoPackages: [] as Slice[GoPackageEntry], Instances: [] as Slice[Instance], Solver: newSolver(), TypedDecls: [] as Slice[ast2.Decl], ExternalTypedDecls: [] as Slice[ast2.Decl], ResolvedConstraintArgs: state.ResolvedConstraintArgs })
  else
    let head = decls.Get(0).UnwrapOr(ast2.Decl.ImportDecl("", ""))
    let tail = sliceDrop(decls, 1)
    let next = inferDecl(head, env, fields, state)
    switch next
      case Ok(pair) =>
        let rest = inferDecls(tail, pair.Env, pair.Fields, pair.State)
        switch rest
          case Ok(info) =>
            let newDecls = switch pair.TypedDecl
              case Some(d) => info.TypedDecls.Prepend(d)
              case None => info.TypedDecls
            end
            Ok(PackageInfo { Env: info.Env, Fields: info.Fields, GoPackages: info.GoPackages, Instances: info.Instances, Solver: info.Solver, TypedDecls: newDecls, ExternalTypedDecls: info.ExternalTypedDecls, ResolvedConstraintArgs: info.ResolvedConstraintArgs })
          case Err(m) => Err(m)
        end
      case Err(msg) => Err(msg)
    end
  end
end

func inferDecl(decl: ast2.Decl, env: Slice[EnvEntry], fields: Slice[FieldEntry], state: InferState) -> Result[DeclInfer, String]
  switch decl
    case ImportDecl(_, _) => Ok(DeclInfer { Env: env, Fields: fields, State: state, TypedDecl: None})
    case StructDecl(name, tps, structFields) =>
      let newSymbols = structSymbols(name, structFields, tps, [] as Slice[Symbol])
      let stateWithSymbols = InferState {
        FreshVarID: state.FreshVarID,
        PkgInfo: state.PkgInfo,
        GoPackages: state.GoPackages,
        MyGoPackages: state.MyGoPackages,
        MyGoPackageCache: state.MyGoPackageCache,
        Symbols: concatSymbols(state.Symbols, newSymbols),
        ActiveConstraints: state.ActiveConstraints,
        NamedImpls: state.NamedImpls,
        ResolvedConstraintArgs: state.ResolvedConstraintArgs,
      }
      Ok(DeclInfer {
        Env: envWithStructFields(envPut(env, name, Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: ast2.MonoType.TCon(name, typeParamsAsTypes(tps, 1)) }), name, tps, structFields),
        Fields: fieldsForStruct(name, structFields, fields),
        State: stateWithSymbols,
        TypedDecl: Some(decl),
      })
    case EnumDecl(name, tps, vars) =>
      let res = inferVariants(vars, name, tps, env, fields, state)
      switch res
        case Ok(di) => Ok(DeclInfer { Env: di.Env, Fields: di.Fields, State: di.State, TypedDecl: Some(decl)})
        case Err(m) => Err(m)
      end
    case InterfaceDecl(name, _, _) =>
      Ok(DeclInfer { Env: envPut(env, name, Scheme { Bound: [], Predicates: [], Body: ast2.MonoType.TCon(name, emptyMonoTypes()) }), Fields: fields, State: state, TypedDecl: Some(decl)})
    case ImplDecl(tps, target, iface, methods) =>
      let receiverName = implReceiverName(target, iface)
      let implSyms = implMethodSymbols(receiverName, tps, methods, [] as Slice[Symbol])
      let stateWithSyms = InferState {
        FreshVarID: state.FreshVarID,
        PkgInfo: state.PkgInfo,
        GoPackages: state.GoPackages,
        MyGoPackages: state.MyGoPackages,
        MyGoPackageCache: state.MyGoPackageCache,
        Symbols: concatSymbols(state.Symbols, implSyms),
        ActiveConstraints: state.ActiveConstraints,
        NamedImpls: state.NamedImpls,
        ResolvedConstraintArgs: state.ResolvedConstraintArgs,
      }
      let res = inferImplMethods(methods, tps, env, fields, stateWithSyms, [] as Slice[ast2.ImplMethod], receiverName)
      switch res
        case Ok(pair) then
          let (typedMethods, newState) = pair
          Ok(DeclInfer { Env: env, Fields: fields, State: newState, TypedDecl: Some(ast2.Decl.ImplDecl(tps, target, iface, typedMethods)) })
        end
        case Err(m) => Err(m)
      end
    case FuncDecl(name, tps, params, ret, body, constraints) =>
      inferFuncDecl(name, tps, params, ret, body, constraints, env, fields, state)
  end
end

func inferFuncDecl(name: String, tps: Slice[String], params: Slice[ast2.Param], ret: Option[ast2.TypeExpr], body: ast2.Expr, constraints: Slice[ast2.Constraint], env: Slice[EnvEntry], fields: Slice[FieldEntry], state: InferState) -> Result[DeclInfer, String]
  let paramTypes = paramsToTypesWithParams(params, tps)
  let retType = switch ret
    case Some(t) => typeFromASTWithParams(t, tps)
    case None => ast2.MonoType.TUnit
  end
  let fnType = ast2.MonoType.TFunc(paramTypes, Ref.new(retType))
  let predicates = predicatesFromConstraintsWithParams(constraints, tps)
  let envWithSig = envPut(env, name, Scheme { Bound: typeParamIDs(tps, 1), Predicates: predicates, Body: fnType })
  let bodyEnv = envWithTypeParams(envWithParamsAndTypes(envWithSig, params, paramTypes), tps)
  let inferred = inferExpr(body, bodyEnv, state)
  switch inferred
    case Ok(eir) then
      let typedBody = eir.Expr
      let r = eir.Result
      let inferredType = applySubst(r.Subst, r.Type)
      debugFuncDecl(name, r.Subst, inferredType, retType)
      let checked = if isGoBoundaryTuple(inferredType, retType) then Ok(r.Subst) else unify(inferredType, retType, r.Subst) end
      switch checked
        case Ok(s2) then
          Ok(DeclInfer {
            Env: envPut(env, name, Scheme {
              Bound: typeParamIDs(tps, 1),
              Predicates: predicates,
              Body: applySubst(s2, fnType)
            }),
            Fields: fields,
            State: r.State,
            TypedDecl: Some(ast2.Decl.FuncDecl(name, tps, params, ret, typedBody, constraints)),
          })
        end
        case Err(msg) => Err("function " + name + " return type mismatch: " + msg)
      end
    end
    case Err(msg) => Err("function " + name + ": " + msg)
  end
end

func inferImplMethods(methods: Slice[ast2.ImplMethod], tps: Slice[String], env: Slice[EnvEntry], fields: Slice[FieldEntry], state: InferState, out: Slice[ast2.ImplMethod], receiverName: String) -> Result[(Slice[ast2.ImplMethod], InferState), String]
  if methods.Len() == 0 then
    Ok((out, state))
  else
    let m = methods.Get(0).UnwrapOr(ast2.ImplMethod { Pos: ast2.SourcePos{SourceName: "", Line: 0, Column: 0}, Sig: ast2.FuncSig { Pos: ast2.SourcePos{SourceName: "", Line: 0, Column: 0}, Name: "", TypeParams: [] as Slice[String], Params: [] as Slice[ast2.Param], Ret: None, Using: [] as Slice[ast2.Constraint] }, Body: ast2.EmptyExpr() })
    let sig = m.Sig
    let combined = appendStringSlice(tps, sig.TypeParams)
    let paramTypes = paramsToTypesWithParams(sig.Params, combined)
    let bodyEnv = envWithTypeParams(envWithParamsAndTypes(env, sig.Params, paramTypes), combined)
    let methodState = withActiveConstraints(state, predicatesFromConstraintsWithParams(sig.Using, combined))
    let inferred = inferExpr(m.Body, bodyEnv, methodState)
    switch inferred
      case Ok(eir) then
        let typedBody = eir.Expr
        let typedMethod = ast2.ImplMethod { Pos: m.Pos, Sig: sig, Body: typedBody }
        # The predicates collected from the body are instantiated at each
        # method-call site.  Their TVar IDs are therefore local inference
        # details (and a method may collect the same predicate more than
        # once).  Store the method's declared constraints instead: these
        # retain the declared constraint identity used by codegen dispatch.
        let newState = withActiveConstraints(storeResolvedConstraintArgs(receiverName, sig, combined, eir.Result.State), state.ActiveConstraints)
        inferImplMethods(sliceDrop(methods, 1), tps, env, fields, newState, out.Append(typedMethod), receiverName)
      end
      case Err(msg) => Err(msg)
    end
  end
end

func storeResolvedConstraintArgs(receiverName: String, sig: ast2.FuncSig, typeParams: Slice[String], state: InferState) -> InferState
  storeMethodConstraintArgs(receiverName, sig.Name, sig.Using, typeParams, state)
end

# Store each `using` entry under its own identity.  Methods such as Equals
# commonly occur in multiple constraints, so {receiver, method} alone cannot
# distinguish Eq[A] from Eq[E] or a named impl such as ResultEq[A, E].
func storeMethodConstraintArgs(receiverName: String, methodName: String, constraints: Slice[ast2.Constraint], typeParams: Slice[String], state: InferState) -> InferState
  if constraints.Len() == 0 then
    state
  else
    let constraint = constraints.Get(0).UnwrapOr(ast2.Constraint { Name: "", BindName: None, Args: [] as Slice[ast2.TypeExpr] })
    let args = typeArgsFromASTWithParams(constraint.Args, typeParams)
    let key = MethodConstraintKey { Receiver: receiverName, Constraint: methodConstraintRef(constraint.Name, state.NamedImpls), ArgsKey: constraintArgsKey(args), Method: methodName }
    state.ResolvedConstraintArgs.Set(key, args)
    storeMethodConstraintArgs(receiverName, methodName, sliceDrop(constraints, 1), typeParams, state)
  end
end

func constraintArgsKey(args: Slice[ast2.MonoType]) -> String
  constraintArgsKeyLoop(args, 0, "")
end

func constraintArgsKeyLoop(args: Slice[ast2.MonoType], index: Int, out: String) -> String
  if index >= args.Len() then out else
    let item = args.Get(index).UnwrapOr(ast2.MonoType.TUnit)
    let next = if out == "" then monoStringFull(item) else out + "," + monoStringFull(item) end
    constraintArgsKeyLoop(args, index + 1, next)
  end
end

func methodConstraintRef(name: String, namedImpls: Slice[String]) -> MethodConstraintRef
  if stringSliceContains(namedImpls, name) then MethodConstraintRef.NamedImpl(name) else MethodConstraintRef.Interface(name) end
end

func stringSliceContains(items: Slice[String], wanted: String) -> Bool
  if items.Len() == 0 then false else
    if items.Get(0).UnwrapOr("") == wanted then true else stringSliceContains(sliceDrop(items, 1), wanted) end
  end
end

func collectResolvedMonos(predicates: Slice[Predicate], index: Int, out: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if index >= predicates.Len() then out else
    let p = predicates.Get(index).UnwrapOr(Predicate { ClassName: "", Args: [] as Slice[ast2.MonoType] })
    let arg = p.Args.Get(0).UnwrapOr(ast2.MonoType.TUnit)
    collectResolvedMonos(predicates, index + 1, out.Append(arg))
  end
end

func isGoBoundaryTuple(inferred: ast2.MonoType, expected: ast2.MonoType) -> Bool
  switch inferred
    case TTuple(items) =>
      switch expected
        case TCon(name, _) => (name == "Option" || name == "Result") && items.Len() == 2
        case _ => false
      end
    case _ => false
  end
end

func debugFuncDecl(name: String, subst: Slice[SubstEntry], inferredType: ast2.MonoType, retType: ast2.MonoType) -> ()
  if strings.Contains(name, "PMap") || strings.Contains(name, "PPure") || strings.Contains(name, "PFail") || strings.Contains(name, "PBind") || strings.Contains(name, "PThen") || strings.Contains(name, "POrElse") || strings.Contains(name, "PChoice") || name == "PChoice" then
    fmt.Println("[DEBUG] " + name + ": subst=" + substString(subst))
    fmt.Println("[DEBUG]   inferredType = " + monoStringFull(inferredType))
    fmt.Println("[DEBUG]   retType     = " + monoStringFull(retType))
    fmt.Println("[DEBUG]   applySubst(retType) = " + monoStringFull(applySubst(subst, retType)))
    ()
  end
end

# Convert parser constraints to inference predicates. Resolution is deliberately
# deferred: a predicate may mention a type parameter and must survive until a
# call site supplies concrete arguments.
func predicatesFromConstraints(items: Slice[ast2.Constraint]) -> Slice[Predicate]
  if items.Len() == 0 then
    []
  else
    let item = items.Get(0).UnwrapOr(ast2.Constraint { Name: "", BindName: None, Args: [] as Slice[ast2.TypeExpr] })
    predicatesFromConstraints(sliceDrop(items, 1)).Prepend(Predicate { ClassName: item.Name, Args: typeArgsFromAST(item.Args) })
  end
end

func predicatesFromConstraintsWithParams(items: Slice[ast2.Constraint], params: Slice[String]) -> Slice[Predicate]
  if items.Len() == 0 then [] else
    let item = items.Get(0).UnwrapOr(ast2.Constraint { Name: "", BindName: None, Args: [] as Slice[ast2.TypeExpr] })
    predicatesFromConstraintsWithParams(sliceDrop(items, 1), params).Prepend(Predicate { ClassName: item.Name, Args: typeArgsFromASTWithParams(item.Args, params) })
  end
end

func inferExpr(expr: ast2.Expr, env: Slice[EnvEntry], state: InferState) -> Result[ExprInferResult, String]
  let result = inferExprInner(expr, env, state)
  switch result
    case Ok(eir) then
      let resolvedType = applySubst(eir.Result.Subst, eir.Result.Type)
      let typedExpr = ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: eir.Expr.Kind, Type: Some(resolvedType) }
      let nextState = recordInferredExprType(typedExpr, eir.Result.Type, eir.Result.Predicates, eir.Result.Subst, eir.Result.State)
      Ok(ExprInferResult { Expr: typedExpr, Result: InferResult { Type: eir.Result.Type, Predicates: eir.Result.Predicates, Subst: eir.Result.Subst, State: nextState } })
    end
    case Err(msg) => Err(errorAtExpr(expr, msg))
  end
end

func recordInferredExprType(expr: ast2.Expr, typ: ast2.MonoType, preds: Slice[Predicate], subst: Slice[SubstEntry], state: InferState) -> InferState
  state
end

func errorAtExpr(expr: ast2.Expr, msg: String) -> String
  if strings.Contains(msg, ":") then
    msg
  else
    let source = if expr.Pos.SourceName == "" then "<input>" else expr.Pos.SourceName end
    source + ":" + expr.Pos.Line.ToString() + ":" + expr.Pos.Column.ToString() + ": " + msg
  end
end

func mkTyped(expr: ast2.Expr, t: ast2.MonoType, state: InferState, exprKind: Option[ast2.ExprKind]) -> ExprInferResult
  let kind = switch exprKind
    case Some(k) => k
    case None => expr.Kind
  end
  let te = ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: kind, Type: Some(t) }
  ExprInferResult { Expr: te, Result: InferResult { Type: t, Predicates: [], Subst: [], State: state } }
end

struct ExprInferResult
  Expr: ast2.Expr
  Result: InferResult
end

func inferExprInner(expr: ast2.Expr, env: Slice[EnvEntry], state: InferState) -> Result[ExprInferResult, String]
  switch expr.Kind
    case IdentExpr(name) =>
      switch envGet(env, name)
        case Some(s) then
          let q = instantiateQualified(s, state)
          let te = ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: expr.Kind, Type: Some(q.Body) }
          Ok(ExprInferResult { Expr: te, Result: InferResult { Type: q.Body, Predicates: q.Predicates, Subst: [], State: withFreshID(state, state.FreshVarID + s.Bound.Len()) } })
        end
        case None => Err("unknown identifier " + name)
      end
    case NumberExpr(_) => Ok(mkTyped(expr, ast2.MonoType.TCon("Int", emptyMonoTypes()), state, None))
    case StringExpr(_) => Ok(mkTyped(expr, ast2.MonoType.TCon("String", emptyMonoTypes()), state, None))
    case RuneExpr(_) => Ok(mkTyped(expr, ast2.MonoType.TCon("Rune", emptyMonoTypes()), state, None))
    case BoolExpr(_) => Ok(mkTyped(expr, ast2.MonoType.TCon("Bool", emptyMonoTypes()), state, None))
    case UnitExpr => Ok(mkTyped(expr, ast2.MonoType.TUnit, state, None))
    case SliceLitExpr(items) =>
      let r = inferSlice(items, env, state)
      switch r
        case Ok(v) => Ok(mkTyped(expr, v.Type, v.State, None))
        case Err(m) => Err(m)
      end
    case TypeAsExpr(value, typ) =>
      let r = inferTypeAs(value, typ, env, state)
      switch r
        case Ok(v) => Ok(mkTyped(expr, v.Type, v.State, None))
        case Err(m) => Err(m)
      end
    case TupleExpr(items) =>
      let r = inferTuple(items, env, state)
      switch r
        case Ok(v) => Ok(mkTyped(expr, v.Type, v.State, None))
        case Err(m) => Err(m)
      end
    case UnaryExpr(op, inner) =>
      inferUnary(expr, op, inner, env, state)
    case BinaryExpr(op, left, right) =>
      let r = inferBinary(op, left, right, env, state)
      switch r
        case Ok(v) => Ok(mkTyped(expr, v.Type, v.State, None))
        case Err(m) => Err(m)
      end
    case CallExpr(callee, _, args) =>
      let r = inferCall(callee, args, env, state)
      switch r
        # inferCall constructs the typed call itself.  Keeping the parsed
        # expression here used to discard DictionaryCallExpr annotations.
        case Ok(eir) => Ok(eir)
        case Err(m) => Err(m)
      end
    case FieldExpr(base, field) =>
      let res = inferField(base, field, env, state)
      switch res
        case Ok(eir) then
          let te = ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: ast2.ExprKind.FieldExpr(eir.Expr, field), Type: Some(eir.Result.Type) }
          Ok(ExprInferResult { Expr: te, Result: eir.Result })
        end
        case Err(msg) => Err(msg)
      end
    case IfExpr(cond, thenExpr, elseExpr) =>
      inferIf(expr, cond, thenExpr, elseExpr, env, state)
    case SwitchExpr(target, cases) =>
      let r = inferSwitch(target, cases, env, state)
      switch r
        # inferSwitch already returns the fully reconstructed typed switch,
        # including its inferred case bodies.
        case Ok(eir) => Ok(eir)
        case Err(m) => Err(m)
      end
    case BlockExpr(items) =>
      let r = inferTypedBlock(items, env, state)
      switch r
        case Ok(pair) then
          let (v, typedItems) = pair
          let typedKind = ast2.ExprKind.BlockExpr(typedItems)
          Ok(mkTyped(expr, v.Type, v.State, Some(typedKind)))
        end
        case Err(m) => Err(m)
      end
    case FuncLitExpr(params, ret, body) =>
      let r = inferFuncLit(params, ret, body, env, state)
      switch r
        case Ok(v) => Ok(mkTyped(expr, v.Type, v.State, None))
        case Err(m) => Err(m)
      end
    case StructLitExpr(typeName, fields) =>
      let r = inferStructLit(typeName, fields, env, state)
      switch r
        case Ok(v) => Ok(mkTyped(expr, v.Type, v.State, None))
        case Err(m) => Err(m)
      end
    case GenericStructLitExpr(typeName, typeArgs, fields) =>
      let r = inferGenericStructLit(typeName, typeArgs, fields, env, state)
      switch r
        case Ok(v) => Ok(mkTyped(expr, v.Type, v.State, None))
        case Err(m) => Err(m)
      end
    case MapLitExpr(pairs) =>
      let r = inferMapLit(pairs, env, state)
      switch r
        case Ok(v) => Ok(mkTyped(expr, v.Type, v.State, None))
        case Err(m) => Err(m)
      end
    case SetLitExpr(items) =>
      let r = inferSetLit(items, env, state)
      switch r
        case Ok(v) => Ok(mkTyped(expr, v.Type, v.State, None))
        case Err(m) => Err(m)
      end
    case InlineGoExpr(typ, _, _, _) then
      let mono = typeFromASTInEnv(typ.value(), env, state)
      Ok(mkTyped(expr, mono, state, None))
    end
  end
end

func inferFuncLit(params: Slice[ast2.Param], ret: Option[ast2.TypeExpr], body: ast2.Expr, env: Slice[EnvEntry], state: InferState) -> Result[InferResult, String]
  let paramTypes = paramsToTypesInEnv(params, env, state)
  let retType = switch ret
    case Some(t) => typeFromASTInEnv(t, env, state)
    case None => ast2.MonoType.TUnit
  end
  # Build the body environment from the SAME resolved param types used for the
  # function's signature.  Using envWithParams (which calls typeFromAST) would
  # mis-resolve references to outer type parameters (e.g. `A` inside a generic
  # function) as bare `TCon("A")` constructors, diverging from `paramTypes`
  # (which resolves them to the outer `TVar(-1)`) and producing an internally
  # inconsistent function type.
  let bodyEnv = envWithParamsAndTypes(env, params, paramTypes)
  let inferred = inferExpr(body, bodyEnv, state)
  switch inferred
    case Err(msg) => Err("function literal: " + msg)
    case Ok(eir) =>
      let r = eir.Result
      let bodyApplied = applySubst(r.Subst, r.Type)
      fmt.Println("[DEBUG]   inferFuncLit: bodyType=" + monoStringFull(bodyApplied) + " retType=" + monoStringFull(retType) + " subst=" + substString(r.Subst))
      fmt.Println("[DEBUG]     paramTypes=" + monoListString(paramTypes))
      let checked = unify(bodyApplied, retType, r.Subst)
      switch checked
        case Err(msg) => Err("function literal return type mismatch: " + msg)
        case Ok(subst) =>
      let ftyp = ast2.MonoType.TFunc(paramTypes, Ref.new(applySubst(subst, retType)))
      Ok(InferResult { Type: ftyp, Predicates: r.Predicates, Subst: subst, State: r.State })
      end
  end
end

func inferGenericStructLit(typeName: String, typeArgs: Slice[ast2.TypeExpr], fields: Slice[ast2.StructLitField], env: Slice[EnvEntry], state: InferState) -> Result[InferResult, String]
  let checked = inferStructLit(typeName, fields, env, state)
  switch checked
    case Err(msg) => Err(msg)
    case Ok(value) =>
      let resultType = ast2.MonoType.TCon(typeName, typeArgsFromASTInEnv(typeArgs, env, state))
      debugStructLit(typeName, typeArgs, resultType, value.Subst)
      Ok(InferResult { Type: resultType, Predicates: value.Predicates, Subst: value.Subst, State: value.State })
  end
end

func debugStructLit(typeName: String, typeArgs: Slice[ast2.TypeExpr], resultType: ast2.MonoType, subst: Slice[SubstEntry]) -> ()
  if typeName == "Reply" || typeName == "Parser" then
    fmt.Println("[DEBUG]   inferGenericStructLit " + typeName + "[" + typeExprListString(typeArgs) + "]: resultType=" + monoStringFull(resultType) + " subst=" + substString(subst))
    ()
  end
end

func inferTypeAs(value: ast2.Expr, typ: ast2.TypeExpr, env: Slice[EnvEntry], state: InferState) -> Result[InferResult, String]
  let inferred = inferExpr(value, env, state)
  let expected = typeFromAST(typ)
  switch inferred
    case Err(msg) => Err(msg)
    case Ok(eir) =>
      let v = eir.Result
      let matched = unify(v.Type, expected, v.Subst)
      switch matched
        case Ok(s) => Ok(InferResult { Type: applySubst(s, expected), Predicates: v.Predicates, Subst: s, State: v.State })
        case Err(_) => Ok(InferResult { Type: expected, Predicates: v.Predicates, Subst: v.Subst, State: v.State })
      end
  end
end

func inferSlice(items: Slice[ast2.Expr], env: Slice[EnvEntry], state: InferState) -> Result[InferResult, String]
  if items.Len() == 0 then
    let element = ast2.MonoType.TVar(state.FreshVarID)
    Ok(InferResult { Type: ast2.MonoType.TCon("Slice", [element]), Predicates: [], Subst: [], State: withFreshID(state, state.FreshVarID + 1) })
  else
    let first = inferExpr(items.Get(0).UnwrapOr(ast2.EmptyExpr()), env, state)
    switch first
      case Err(msg) => Err(msg)
      case Ok(eir) => inferSliceItems(sliceDrop(items, 1), eir.Result.Type, env, eir.Result.State, eir.Result.Subst)
    end
  end
end

func inferSliceItems(items: Slice[ast2.Expr], element: ast2.MonoType, env: Slice[EnvEntry], state: InferState, subst: Slice[SubstEntry]) -> Result[InferResult, String]
  if items.Len() == 0 then
    Ok(InferResult { Type: ast2.MonoType.TCon("Slice", [applySubst(subst, element)]), Predicates: [], Subst: subst, State: state })
  else
    let next = inferExpr(items.Get(0).UnwrapOr(ast2.EmptyExpr()), env, state)
    switch next
      case Err(msg) => Err(msg)
      case Ok(eir) then
        let value = eir.Result
        let combined = unify(applySubst(value.Subst, element), applySubst(value.Subst, value.Type), composeSubst(value.Subst, subst))
        switch combined
          case Err(msg) => Err("slice element type mismatch: " + msg)
          case Ok(s) => inferSliceItems(sliceDrop(items, 1), element, env, value.State, s)
        end
      end
    end
  end
end

func inferSwitch(target: ast2.Expr, cases: Slice[ast2.SwitchCase], env: Slice[EnvEntry], state: InferState) -> Result[ExprInferResult, String]
  let matched = inferExpr(target, env, state)
  switch matched
    case Err(msg) => Err(msg)
    case Ok(eir) then
      let typedTarget = eir.Expr
      let value = eir.Result
      let next = inferTypedSwitchCases(cases, value.Type, env, value.State, value.Subst, None, value.Predicates, [] as Slice[ast2.SwitchCase])
      switch next
        case Err(msg) => Err(msg)
        case Ok(pair) then
          let (r, typedCases) = pair
          let typedExpr = ast2.Expr { ID: 0, Pos: typedTarget.Pos, Kind: ast2.ExprKind.SwitchExpr(typedTarget, typedCases), Type: Some(r.Type) }
          Ok(ExprInferResult { Expr: typedExpr, Result: r })
        end
      end
    end
  end
end

# Preserve the inferred case bodies in the typed AST.  In particular this
# carries DictionaryCallExpr annotations out of nested matches to codegen2.
func inferTypedSwitchCases(cases: Slice[ast2.SwitchCase], targetType: ast2.MonoType, env: Slice[EnvEntry], state: InferState, subst: Slice[SubstEntry], resultType: Option[ast2.MonoType], predicates: Slice[Predicate], out: Slice[ast2.SwitchCase]) -> Result[(InferResult, Slice[ast2.SwitchCase]), String]
  if cases.Len() == 0 then
    switch resultType
      case Some(t) => Ok((InferResult { Type: applySubst(subst, t), Predicates: predicates, Subst: subst, State: state }, out))
      case None => Err("switch requires at least one case")
    end
  else
    let current = cases.Get(0).UnwrapOr(ast2.SwitchCase { Pattern: ast2.Pattern.WildcardPattern, Body: ast2.EmptyExpr() })
    switch envWithPattern(env, current.Pattern, targetType)
      case Err(msg) => Err(msg)
      case Ok(caseEnv) =>
        switch inferExpr(current.Body, caseEnv, state)
          case Err(msg) => Err(msg)
          case Ok(eir) then
            let value = eir.Result
            let typedOut = out.Append(ast2.SwitchCase { Pattern: current.Pattern, Body: eir.Expr })
            switch resultType
              case None => inferTypedSwitchCases(sliceDrop(cases, 1), targetType, env, value.State, composeSubst(value.Subst, subst), Some(value.Type), appendPredicates(predicates, value.Predicates), typedOut)
              case Some(previous) =>
                let nextSubst = unify(applySubst(value.Subst, previous), applySubst(value.Subst, value.Type), composeSubst(value.Subst, subst))
                switch nextSubst
                  case Err(msg) => Err("switch case type mismatch: " + msg)
                  case Ok(s) => inferTypedSwitchCases(sliceDrop(cases, 1), targetType, env, value.State, s, Some(applySubst(s, previous)), appendPredicates(predicates, value.Predicates), typedOut)
                end
            end
          end
        end
    end
  end
end

func inferSwitchCases(cases: Slice[ast2.SwitchCase], targetType: ast2.MonoType, env: Slice[EnvEntry], state: InferState, subst: Slice[SubstEntry], resultType: Option[ast2.MonoType], predicates: Slice[Predicate]) -> Result[InferResult, String]
  if cases.Len() == 0 then
    switch resultType
      case Some(t) => Ok(InferResult { Type: applySubst(subst, t), Predicates: predicates, Subst: subst, State: state })
      case None => Err("switch requires at least one case")
    end
  else
    let current = cases.Get(0).UnwrapOr(ast2.SwitchCase { Pattern: ast2.Pattern.WildcardPattern, Body: ast2.EmptyExpr() })
    let caseEnv = envWithPattern(env, current.Pattern, targetType)
    switch caseEnv
      case Err(msg) => Err(msg)
      case Ok(nextEnv) then
        let body = inferExpr(current.Body, nextEnv, state)
        switch body
          case Err(msg) => Err(msg)
          case Ok(eir) then
            let value = eir.Result
            switch resultType
              case None => inferSwitchCases(sliceDrop(cases, 1), targetType, env, value.State, composeSubst(value.Subst, subst), Some(value.Type), appendPredicates(predicates, value.Predicates))
              case Some(previous) then
                let nextSubst = unify(applySubst(value.Subst, previous), applySubst(value.Subst, value.Type), composeSubst(value.Subst, subst))
                switch nextSubst
                  case Err(msg) => Err("switch case type mismatch: " + msg)
                  case Ok(s) => inferSwitchCases(sliceDrop(cases, 1), targetType, env, value.State, s, Some(applySubst(s, previous)), appendPredicates(predicates, value.Predicates))
                end
              end
            end
          end
        end
      end
    end
  end
end

func envWithPattern(env: Slice[EnvEntry], pattern: ast2.Pattern, targetType: ast2.MonoType) -> Result[Slice[EnvEntry], String]
  switch pattern
    case BindPattern(name) => Ok(envPut(env, name, Scheme { Bound: [], Predicates: [], Body: targetType }))
    case WildcardPattern => Ok(env)
    case TuplePattern(items) =>
      switch targetType
        case TTuple(types) => envWithTuplePattern(env, items, types)
        case _ => Err("tuple pattern requires tuple target")
      end
    case LiteralPattern(kind, _) =>
      let expected = if kind == "string" then ast2.MonoType.TCon("String", emptyMonoTypes()) else ast2.MonoType.TCon("Int", emptyMonoTypes()) end
      switch unify(targetType, expected, [])
        case Ok(_) => Ok(env)
        case Err(msg) => Err("pattern does not match switch target: " + msg)
      end
    case VariantPattern(name, args) =>
      switch envGet(env, name)
        case None =>
          if args.Len() == 0 then
            Ok(envPut(env, name, Scheme { Bound: [], Predicates: [], Body: targetType }))
          else
            Err("unknown variant " + name)
          end
        case Some(scheme) =>
          let variantType = instantiate(scheme, NewInferState())
          switch variantType
            case TFunc(fields, ret) => envWithPatternBindings(env, args, fields, targetType, ret.value())
            case TCon(enumName, _) =>
              if args.Len() == 0 then
                switch unify(targetType, variantType, [])
                  case Ok(_) => Ok(env)
                  case Err(msg) => Err("pattern does not match switch target: " + msg)
                end
              else
                Err("variant " + name + " does not accept pattern arguments")
              end
            case _ => Err("pattern " + name + " is not an enum variant")
          end
      end
  end
end

func envWithTuplePattern(env: Slice[EnvEntry], patterns: Slice[ast2.Pattern], types: Slice[ast2.MonoType]) -> Result[Slice[EnvEntry], String]
  if patterns.Len() != types.Len() then Err("tuple pattern arity mismatch") else envWithTuplePatternLoop(env, patterns, types) end
end

func envWithTuplePatternLoop(env: Slice[EnvEntry], patterns: Slice[ast2.Pattern], types: Slice[ast2.MonoType]) -> Result[Slice[EnvEntry], String]
  if patterns.Len() == 0 then Ok(env)
  else
    let p = patterns.Get(0).UnwrapOr(ast2.Pattern.WildcardPattern)
    let t = types.Get(0).UnwrapOr(ast2.MonoType.TUnit)
    switch envWithPattern(env, p, t)
      case Ok(next) => envWithTuplePatternLoop(next, sliceDrop(patterns, 1), sliceDrop(types, 1))
      case Err(msg) => Err(msg)
    end
  end
end

func envWithPatternBindings(env: Slice[EnvEntry], names: Slice[ast2.Pattern], fields: Slice[ast2.MonoType], targetType: ast2.MonoType, variantType: ast2.MonoType) -> Result[Slice[EnvEntry], String]
  if names.Len() != fields.Len() then
    Err("pattern argument count mismatch")
  else
    # Unify the switch target with the variant's constructor type so the
    # variant's type parameters (e.g. `t1` in `func(t1) -> Option[t1]`) get
    # bound to the actual element type (e.g. `ParseError`).  The resulting
    # substitution is then applied to each pattern binding's type, so names
    # like `e` get the *resolved* element type (`ParseError`) rather than the
    # bare fresh variable (`t1`) — otherwise downstream `e.Field` accesses
    # would fail because the stub environment entry is still a type variable.
    let s = unify(targetType, variantType, [])
    switch s
      case Err(msg) => Err("pattern does not match switch target: " + msg)
      case Ok(subst) => envWithPatternBindingLoop(env, names, fields, subst)
    end
  end
end

func envWithPatternBindingLoop(env: Slice[EnvEntry], names: Slice[ast2.Pattern], fields: Slice[ast2.MonoType], subst: Slice[SubstEntry]) -> Result[Slice[EnvEntry], String]
  if names.Len() == 0 then
    Ok(env)
  else
    let field = applySubst(subst, fields.Get(0).UnwrapOr(ast2.MonoType.TUnit))
    switch envWithPattern(env, names.Get(0).UnwrapOr(ast2.Pattern.WildcardPattern), field)
      case Ok(next) => envWithPatternBindingLoop(next, sliceDrop(names, 1), sliceDrop(fields, 1), subst)
      case Err(msg) => Err(msg)
    end
  end
end

func inferTuple(items: Slice[ast2.Expr], env: Slice[EnvEntry], state: InferState) -> Result[InferResult, String]
  inferTupleItems(items, env, state, [] as Slice[ast2.MonoType], [] as Slice[SubstEntry])
end

func inferTupleItems(items: Slice[ast2.Expr], env: Slice[EnvEntry], state: InferState, types: Slice[ast2.MonoType], subst: Slice[SubstEntry]) -> Result[InferResult, String]
  if items.Len() == 0 then
    Ok(InferResult { Type: ast2.MonoType.TTuple(types), Predicates: [], Subst: subst, State: state })
  else
    let r = inferExpr(items.Get(0).UnwrapOr(ast2.EmptyExpr()), env, state)
    switch r
      case Err(msg) => Err(msg)
      case Ok(eir) => inferTupleItems(sliceDrop(items, 1), env, eir.Result.State, types.Append(eir.Result.Type), composeSubst(eir.Result.Subst, subst))
    end
  end
end

struct StmtInferResult
  MaybeExpr: Option[ast2.Expr]
  Result: InferResult
end

# inferStmt 推断语句的类型。
func inferStmt(stmt: ast2.Stmt, env: Slice[EnvEntry], state: InferState) -> Result[StmtInferResult, String]
  switch stmt
    case ExprStmt(expr) =>
      let inferred = inferExpr(expr, env, state)
      switch inferred
        case Ok(eir) then
          Ok(StmtInferResult { MaybeExpr: Some(eir.Expr), Result: eir.Result })
        end
        case Err(msg) => Err(msg)
      end
    case LetStmt(bind) =>
      let res = inferLet(bind, env, state)
      switch res
        case Ok(r) => Ok(StmtInferResult { MaybeExpr: None, Result: r })
        case Err(msg) => Err(msg)
      end
    case VarStmt(bind) =>
      let res = inferLet(bind, env, state)
      switch res
        case Ok(r) => Ok(StmtInferResult { MaybeExpr: None, Result: r })
        case Err(msg) => Err(msg)
      end
    case LetRecStmt(bindings) =>
      let res = inferLetRec(bindings, env, state)
      switch res
        case Ok(r) => Ok(StmtInferResult { MaybeExpr: None, Result: r })
        case Err(msg) => Err(msg)
      end
    case WhileStmt(cond, body) =>
      let inferred = inferExpr(cond, env, state)
      switch inferred
        case Ok(eirCond) then
          let cv = eirCond.Result
          let csubst = unify(cv.Type, ast2.MonoType.TCon("Bool", emptyMonoTypes()), cv.Subst)
          switch csubst
            case Err(msg) => Err(msg)
            case Ok(_) then
              let b = inferExpr(body, env, cv.State)
              switch b
                case Err(msg) => Err(msg)
                case Ok(eirBody) =>
                  Ok(StmtInferResult { MaybeExpr: None, Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: eirBody.Result.Predicates, Subst: eirBody.Result.Subst, State: eirBody.Result.State } })
              end
            end
          end
        end
        case Err(msg) => Err(msg)
      end
    case AssignStmt(target, value) =>
      let t = inferExpr(target, env, state)
      switch t
        case Err(msg) => Err(msg)
        case Ok(eirTarget) then
          let tv = eirTarget.Result
          let v = inferExpr(value, env, tv.State)
          switch v
            case Err(msg) => Err(msg)
            case Ok(eirValue) then
              let vv = eirValue.Result
              let s = unify(tv.Type, vv.Type, composeSubst(vv.Subst, tv.Subst))
              switch s
                case Err(msg) => Err(msg)
                case Ok(sb) => Ok(StmtInferResult { MaybeExpr: None, Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: appendPredicates(tv.Predicates, vv.Predicates), Subst: sb, State: vv.State } })
              end
            end
          end
        end
      end
    case ReturnStmt => Ok(StmtInferResult { MaybeExpr: None, Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: [], Subst: [], State: state } })
    case ReturnWithStmt(value) =>
      let inferred = inferExpr(value, env, state)
      switch inferred
        case Ok(eir) then
          Ok(StmtInferResult { MaybeExpr: Some(eir.Expr), Result: eir.Result })
        end
        case Err(msg) => Err(msg)
      end
  end
end

func isGoPackageCall(callee: ast2.Expr, env: Slice[EnvEntry]) -> Bool
  switch callee.Kind
    case FieldExpr(base, _) =>
      switch base.Kind
        case IdentExpr(alias) =>
          switch envGet(env, alias)
            case Some(scheme) =>
              switch scheme.Body
                case TGoPackage(_) => true
                case _ => false
              end
            case None => false
          end
        case _ => false
      end
    case _ => false
  end
end

func inferAssign(target: ast2.Expr, value: ast2.Expr, env: Slice[EnvEntry], state: InferState) -> Result[InferResult, String]
  let t = inferExpr(target, env, state)
  switch t
    case Err(msg) => Err(msg)
    case Ok(teir) =>
      let tv = teir.Result
      let v = inferExpr(value, env, tv.State)
      switch v
        case Err(msg) => Err(msg)
        case Ok(eir) then
          let vv = eir.Result
          let s = unify(applySubst(vv.Subst, tv.Type), applySubst(vv.Subst, vv.Type), vv.Subst)
          switch s
            case Err(msg) => Err(msg)
            case Ok(s2) => Ok(InferResult { Type: ast2.MonoType.TUnit, Predicates: vv.Predicates, Subst: s2, State: vv.State })
          end
        end
      end
  end
end

func inferUnary(expr: ast2.Expr, op: String, inner: ast2.Expr, env: Slice[EnvEntry], state: InferState) -> Result[ExprInferResult, String]
  let r = inferExpr(inner, env, state)
  switch r
    case Ok(eir) then
      let typedInner = eir.Expr
      let v = eir.Result
      let matched = if op == "!" then
        matchExpected(v, ast2.MonoType.TCon("Bool", emptyMonoTypes()), ast2.MonoType.TCon("Bool", emptyMonoTypes()))
      else
        if op == "-" then
          matchExpected(v, ast2.MonoType.TCon("Int", emptyMonoTypes()), ast2.MonoType.TCon("Int", emptyMonoTypes()))
        else
          Err("unknown unary operator " + op)
        end
      end
      switch matched
        case Ok(v2) then
          let te = ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: ast2.ExprKind.UnaryExpr(op, typedInner), Type: Some(v2.Type) }
          Ok(ExprInferResult { Expr: te, Result: v2 })
        end
        case Err(m) => Err(m)
      end
    end
    case Err(msg) => Err(msg)
  end
end

func inferBinary(op: String, left: ast2.Expr, right: ast2.Expr, env: Slice[EnvEntry], state: InferState) -> Result[InferResult, String]
  let l = inferExpr(left, env, state)
  switch l
    case Err(msg) => Err(msg)
    case Ok(leir) =>
      let lv = leir.Result
      let r = inferExpr(right, env, lv.State)
      switch r
        case Err(msg) => Err(msg)
        case Ok(reir) =>
          let rv = reir.Result
          let s1 = composeSubst(rv.Subst, lv.Subst)
          if isArithmetic(op) then
              # Old-compiler parity: arithmetic operators (`+`, `-`, `*`, `/`)
              # unify the operands with each other and let the result inherit
              # the common operand type, so `String + String` chains into a
              # `String` rather than being forced to `Int`.
              let s2 = unify(applySubst(s1, lv.Type), applySubst(s1, rv.Type), s1)
              switch s2
                case Ok(sb) => Ok(InferResult { Type: applySubst(sb, lv.Type), Predicates: appendPredicates(lv.Predicates, rv.Predicates), Subst: sb, State: rv.State })
                case Err(msg) => Err("arithmetic operator " + op + " type mismatch: " + msg)
              end
          else
            if isComparison(op) then
              let s2 = unify(applySubst(s1, lv.Type), applySubst(s1, rv.Type), s1)
              switch s2
                case Ok(sb) => Ok(InferResult { Type: ast2.MonoType.TCon("Bool", emptyMonoTypes()), Predicates: appendPredicates(lv.Predicates, rv.Predicates), Subst: sb, State: rv.State })
                case Err(msg) => Err(msg)
              end
            else
              if isLogical(op) then
                let s2 = unify(applySubst(s1, lv.Type), ast2.MonoType.TCon("Bool", emptyMonoTypes()), s1)
                switch s2
                  case Err(msg) => Err("logical operator requires Bool operands: " + msg)
                  case Ok(sa) =>
                    let s3 = unify(applySubst(sa, rv.Type), ast2.MonoType.TCon("Bool", emptyMonoTypes()), sa)
                    switch s3
                      case Ok(sb) => Ok(InferResult { Type: ast2.MonoType.TCon("Bool", emptyMonoTypes()), Predicates: appendPredicates(lv.Predicates, rv.Predicates), Subst: sb, State: rv.State })
                      case Err(msg) => Err("logical operator requires Bool operands: " + msg)
                    end
                end
              else
                Err("unknown binary operator " + op)
              end
            end
          end
      end
  end
end

func inferIf(expr: ast2.Expr, cond: ast2.Expr, thenExpr: ast2.Expr, elseExpr: ast2.Expr, env: Slice[EnvEntry], state: InferState) -> Result[ExprInferResult, String]
  let c = inferExpr(cond, env, state)
  switch c
    case Err(msg) => Err(msg)
    case Ok(ceir) then
      let cv = ceir.Result
      let csubst = unify(cv.Type, ast2.MonoType.TCon("Bool", emptyMonoTypes()), cv.Subst)
      switch csubst
        case Err(msg) => Err(msg)
        case Ok(scond) then
          let t = inferExpr(thenExpr, env, cv.State)
          switch t
            case Err(msg) => Err(msg)
            case Ok(eirT) then
              let tv = eirT.Result
              let e = inferExpr(elseExpr, env, tv.State)
              switch e
                case Err(msg) => Err(msg)
                case Ok(eeir) then
                  let ev = eeir.Result
                  let s1 = composeSubst(ev.Subst, composeSubst(tv.Subst, scond))
                  let thenApplied = applySubst(s1, tv.Type)
                  let elseApplied = applySubst(s1, ev.Type)
                  let _ = fmt.Println("[DEBUG]   inferIf: then=" + monoStringFull(thenApplied) + " else=" + monoStringFull(elseApplied) + " subst=" + substString(s1))
                  let same = unify(thenApplied, elseApplied, s1)
                  switch same
                    case Ok(s2) then
                      let result = InferResult { Type: applySubst(s2, tv.Type), Predicates: appendPredicates(cv.Predicates, appendPredicates(tv.Predicates, ev.Predicates)), Subst: s2, State: ev.State }
                      let typedKind = ast2.ExprKind.IfExpr(ceir.Expr, eirT.Expr, eeir.Expr)
                      Ok(ExprInferResult { Expr: ast2.Expr { ID: expr.ID, Pos: expr.Pos, Kind: typedKind, Type: Some(result.Type) }, Result: result })
                    end
                    case Err(msg) => Err(msg)
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

func inferCall(callee: ast2.Expr, args: Slice[ast2.Expr], env: Slice[EnvEntry], state: InferState) -> Result[ExprInferResult, String]
  switch inferRefCall(callee, args, env, state)
    case Some(r) =>
      switch r
        case Ok(v) =>
          let callExprKind = ast2.ExprKind.CallExpr(callee, [] as Slice[ast2.TypeExpr], args)
          Ok(ExprInferResult { Expr: ast2.Expr { ID: 0, Pos: ast2.SourcePos{SourceName: "", Line: 0, Column: 0}, Kind: callExprKind, Type: Some(v.Type) }, Result: v })
        case Err(m) => Err(m)
      end
    case None =>
      switch inferOrdinaryCall(callee, args, env, state)
        case Ok(v) =>
          let callExprKind = switch inferredDictionaryCall(callee, v.Expr, v.Result.State.ActiveConstraints)
            case Some(key) =>
              switch v.Expr.Kind
                case FieldExpr(base, _) => ast2.ExprKind.DictionaryCallExpr(key, base, args)
                case _ => ast2.ExprKind.CallExpr(v.Expr, [] as Slice[ast2.TypeExpr], args)
              end
            case None => ast2.ExprKind.CallExpr(v.Expr, [] as Slice[ast2.TypeExpr], args)
          end
          Ok(ExprInferResult { Expr: ast2.Expr { ID: 0, Pos: ast2.SourcePos{SourceName: "", Line: 0, Column: 0}, Kind: callExprKind, Type: Some(v.Result.Type) }, Result: v.Result })
        case Err(m) => Err(m)
      end
  end
end

func inferredDictionaryCall(callee: ast2.Expr, typedCallee: ast2.Expr, constraints: Slice[Predicate]) -> Option[String]
  switch callee.Kind
    case FieldExpr(_, method) =>
      switch typedCallee.Kind
        case FieldExpr(base, _) =>
          switch base.Type
            case Some(receiver) => dictionaryCallKeyForReceiver(method, receiver, constraints)
            case None => None
          end
        case _ => None
      end
    case _ => None
  end
end

func dictionaryCallKeyForReceiver(method: String, receiver: ast2.MonoType, constraints: Slice[Predicate]) -> Option[String]
  if constraints.Len() == 0 then None else
    let current = constraints.Get(0).UnwrapOr(Predicate { ClassName: "", Args: [] as Slice[ast2.MonoType] })
    let arg = current.Args.Get(0).UnwrapOr(ast2.MonoType.TUnit)
    if monoEqual(arg, receiver) then Some(current.ClassName + ":" + constraintArgsKey(current.Args) + ":" + method) else dictionaryCallKeyForReceiver(method, receiver, sliceDrop(constraints, 1)) end
  end
end

# Ref is a compiler boundary type.  Its constructor and dereference operation
# are not ordinary fields in the lexical environment.
func inferRefCall(callee: ast2.Expr, args: Slice[ast2.Expr], env: Slice[EnvEntry], state: InferState) -> Option[Result[InferResult, String]]
  switch callee.Kind
    case FieldExpr(base, field) then
      switch base.Kind
        case IdentExpr(name) then
          if name == "Ref" && field == "new" then
            if args.Len() != 1 then Some(Err("Ref.new expects exactly one argument")) else
              switch inferExpr(args.Get(0).UnwrapOr(ast2.EmptyExpr()), env, state)
                case Ok(eir) => Some[Result[InferResult, String]](Ok[InferResult, String](InferResult { Type: ast2.MonoType.TCon("Ref", [applySubst(eir.Result.Subst, eir.Result.Type)]), Predicates: eir.Result.Predicates, Subst: eir.Result.Subst, State: eir.Result.State }))
                case Err(msg) => Some[Result[InferResult, String]](Err[InferResult, String](msg))
              end
            end
          else
            inferRefValueCall(base, field, args, env, state)
          end
        end
        case _ => inferRefValueCall(base, field, args, env, state)
      end
    end
    case _ => None
  end
end

func inferRefValueCall(base: ast2.Expr, field: String, args: Slice[ast2.Expr], env: Slice[EnvEntry], state: InferState) -> Option[Result[InferResult, String]]
  if field != "value" || args.Len() != 0 then None else
    switch inferExpr(base, env, state)
      case Err(msg) => Some(Err(msg))
      case Ok(eir) =>
        let value = eir.Result
        switch applySubst(value.Subst, value.Type)
          case TCon(name, inner) then
            if name == "Ref" && inner.Len() == 1 then
              Some(Ok(InferResult { Type: inner.Get(0).UnwrapOr(ast2.MonoType.TUnit), Predicates: value.Predicates, Subst: value.Subst, State: value.State }))
            else
              Some(Err("value() requires Ref[T]"))
            end
          end
          case _ => Some(Err("value() requires Ref[T]"))
        end
    end
  end
end

func inferOrdinaryCall(callee: ast2.Expr, args: Slice[ast2.Expr], env: Slice[EnvEntry], state: InferState) -> Result[ExprInferResult, String]
  let c = inferExpr(callee, env, state)
  switch c
    case Err(msg) => Err(msg)
    case Ok(eir) then
      let typedCallee = eir.Expr
      let cv = eir.Result
      switch cv.Type
        case TVariadic(_, _) =>
          let ar = inferArgs(args, env, cv.State, [], [], cv.Subst)
          switch ar
            case Err(msg) => Err(msg)
            case Ok(argsResult) =>
              let r = inferGoVariadicCall(cv.Type, argsResult, cv)
              switch r
                case Ok(v) => Ok(ExprInferResult { Expr: typedCallee, Result: v })
                case Err(m) => Err(m)
              end
          end
        case _ =>
          let ar = inferArgs(args, env, cv.State, [], [], cv.Subst)
          switch ar
            case Err(msg) => Err(msg)
            case Ok(argsResult) then
              let afterCallee = nextFreshVarID(cv.Type, argsResult.State.FreshVarID)
              let fresh = nextFreshVarIDInAll(argsResult.Types, afterCallee)
              let s1 = composeSubst(argsResult.Subst, cv.Subst)
              let used = maxSubstID(s1)
              let safeFresh = if fresh <= used then used + 1 else fresh end
              let nextState = withFreshID(argsResult.State, safeFresh + 1)
              let ret = ast2.MonoType.TVar(safeFresh)
              let expected = ast2.MonoType.TFunc(argsResult.Types, Ref.new(ret))
              let s2 = unify(applySubst(s1, cv.Type), expected, s1)
              switch s2
                case Ok(s) => Ok(ExprInferResult { Expr: typedCallee, Result: InferResult { Type: applySubst(s, ret), Predicates: appendPredicates(cv.Predicates, argsResult.Predicates), Subst: s, State: nextState } })
                case Err(msg) => if isGoPackageCall(callee, env) then Err("Go function argument count mismatch") else Err(msg) end
              end
            end
          end
      end
    end
  end
end

func inferGoVariadicCall(marker: ast2.MonoType, args: ArgsResult, callee: InferResult) -> Result[InferResult, String]
  let fresh = args.State.FreshVarID
  Ok(InferResult { Type: ast2.MonoType.TVar(fresh), Predicates: appendPredicates(callee.Predicates, args.Predicates), Subst: composeSubst(args.Subst, callee.Subst), State: withFreshID(args.State, fresh + 1) })
end

func inferArgs(args: Slice[ast2.Expr], env: Slice[EnvEntry], state: InferState, types: Slice[ast2.MonoType], predicates: Slice[Predicate], subst: Slice[SubstEntry]) -> Result[ArgsResult, String]
  if args.Len() == 0 then
    Ok(ArgsResult { Types: types, Predicates: predicates, Subst: subst, State: state })
  else
    let head = args.Get(0).UnwrapOr(ast2.EmptyExpr())
    let r = inferExpr(head, env, state)
    switch r
      case Err(msg) => Err(msg)
      case Ok(eir) =>
        let v = eir.Result
        inferArgs(sliceDrop(args, 1), env, v.State, types.Append(applySubst(v.Subst, v.Type)), appendPredicates(predicates, v.Predicates), composeSubst(v.Subst, subst))
    end
  end
end

func inferBlock(items: Slice[ast2.Stmt], env: Slice[EnvEntry], state: InferState) -> Result[InferResult, String]
  if items.Len() == 0 then
    Ok(InferResult { Type: ast2.MonoType.TUnit, Predicates: [], Subst: [], State: state })
  else
    inferBlockItems(items, env, state, ast2.MonoType.TUnit, [], [])
  end
end

# A block is part of the typed AST, not merely a type-checking scope.  Keep
# the inferred statements so nested calls retain their dispatch annotations.
func inferTypedBlock(items: Slice[ast2.Stmt], env: Slice[EnvEntry], state: InferState) -> Result[(InferResult, Slice[ast2.Stmt]), String]
  inferTypedBlockItems(items, env, state, ast2.MonoType.TUnit, [], [], [] as Slice[ast2.Stmt])
end

func inferTypedBlockItems(items: Slice[ast2.Stmt], env: Slice[EnvEntry], state: InferState, lastType: ast2.MonoType, subst: Slice[SubstEntry], predicates: Slice[Predicate], out: Slice[ast2.Stmt]) -> Result[(InferResult, Slice[ast2.Stmt]), String]
  if items.Len() == 0 then
    Ok((InferResult { Type: applySubst(subst, lastType), Predicates: predicates, Subst: subst, State: state }, out))
  else
    let step = inferBlockStep(items.Get(0).UnwrapOr(ast2.Stmt.ExprStmt(ast2.EmptyExpr())), env, state)
    switch step
      case Err(msg) => Err(msg)
      case Ok(v) => inferTypedBlockItems(sliceDrop(items, 1), v.Env, v.Result.State, v.Result.Type, composeSubst(v.Result.Subst, subst), appendPredicates(predicates, v.Result.Predicates), out.Append(v.Stmt))
    end
  end
end

func inferBlockItems(items: Slice[ast2.Stmt], env: Slice[EnvEntry], state: InferState, lastType: ast2.MonoType, subst: Slice[SubstEntry], predicates: Slice[Predicate]) -> Result[InferResult, String]
  if items.Len() == 0 then
    Ok(InferResult { Type: applySubst(subst, lastType), Predicates: predicates, Subst: subst, State: state })
  else
    let step = inferBlockStep(items.Get(0).UnwrapOr(ast2.Stmt.ExprStmt(ast2.EmptyExpr())), env, state)
    switch step
      case Err(msg) => Err(msg)
      case Ok(v) => inferBlockItems(sliceDrop(items, 1), v.Env, v.Result.State, v.Result.Type, composeSubst(v.Result.Subst, subst), appendPredicates(predicates, v.Result.Predicates))
    end
  end
end

func inferBlockStep(stmt: ast2.Stmt, env: Slice[EnvEntry], state: InferState) -> Result[BlockInferStep, String]
  switch stmt
    case LetStmt(bind) => inferBlockBind(bind, false, env, state)
    case LetRecStmt(bindings) => inferBlockLetRecTyped(bindings, env, state)
    case VarStmt(bind) => inferBlockBind(bind, true, env, state)
    case WhileStmt(cond, body) => inferTypedWhileStmt(cond, body, env, state)
    case _ then
      let r = inferStmt(stmt, env, state)
      switch r
        case Err(msg) => Err(msg)
        case Ok(sir) =>
          let typedStmt = switch sir.MaybeExpr
            case Some(te) => ast2.Stmt.ExprStmt(te)
            case None => stmt
          end
          Ok(BlockInferStep { Result: sir.Result, Env: env, Stmt: typedStmt })
      end
    end
  end
end

func inferTypedWhileStmt(cond: ast2.Expr, body: ast2.Expr, env: Slice[EnvEntry], state: InferState) -> Result[BlockInferStep, String]
  let condition = inferExpr(cond, env, state)
  switch condition
    case Err(msg) => Err(msg)
    case Ok(eirCond) =>
      let cv = eirCond.Result
      let checked = unify(cv.Type, ast2.MonoType.TCon("Bool", emptyMonoTypes()), cv.Subst)
      switch checked
        case Err(msg) => Err(msg)
        case Ok(s) =>
          let inferredBody = inferExpr(body, env, cv.State)
          switch inferredBody
            case Err(msg) => Err(msg)
            case Ok(eirBody) => Ok(BlockInferStep {
              Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: eirBody.Result.Predicates, Subst: composeSubst(eirBody.Result.Subst, s), State: eirBody.Result.State },
              Env: env,
              Stmt: ast2.Stmt.WhileStmt(eirCond.Expr, eirBody.Expr),
            })
          end
      end
  end
end

func inferBlockLetRecTyped(bindings: Slice[ast2.LetRecBind], env: Slice[EnvEntry], state: InferState) -> Result[BlockInferStep, String]
  let inferred = inferBlockLetRec(bindings, env, state)
  switch inferred
    case Ok(step) => Ok(BlockInferStep { Result: step.Result, Env: step.Env, Stmt: ast2.Stmt.LetRecStmt(bindings) })
    case Err(msg) => Err(msg)
  end
end

func inferBlockLetRec(bindings: Slice[ast2.LetRecBind], env: Slice[EnvEntry], state: InferState) -> Result[BlockInferStep, String]
  let recEnv = predeclareLetRec(bindings, env)
  inferLetRecValues(bindings, recEnv, state, [])
end

func predeclareLetRec(bindings: Slice[ast2.LetRecBind], env: Slice[EnvEntry]) -> Slice[EnvEntry]
  if bindings.Len() == 0 then
    env
  else
    let binding = bindings.Get(0).UnwrapOr(ast2.LetRecBind { Name: "", Type: ast2.TypeExpr.UnitType(), Value: ast2.EmptyExpr() })
    predeclareLetRec(sliceDrop(bindings, 1), envPut(env, binding.Name, Scheme { Bound: [], Predicates: [], Body: typeFromAST(binding.Type) }))
  end
end

func inferLetRec(bindings: Slice[ast2.LetRecBind], env: Slice[EnvEntry], state: InferState) -> Result[InferResult, String]
  let recEnv = predeclareLetRec(bindings, env)
  let checked = inferLetRecValues(bindings, recEnv, state, [])
  switch checked
    case Err(msg) => Err(msg)
    case Ok(step) => Ok(step.Result)
  end
end

func inferLetRecValues(bindings: Slice[ast2.LetRecBind], recEnv: Slice[EnvEntry], state: InferState, subst: Slice[SubstEntry]) -> Result[BlockInferStep, String]
  if bindings.Len() == 0 then
    Ok(BlockInferStep { Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: [], Subst: subst, State: state }, Env: recEnv, Stmt: ast2.Stmt.ExprStmt(ast2.Expr { ID: 0, Pos: ast2.SourcePos{SourceName: "", Line: 0, Column: 0}, Kind: ast2.ExprKind.UnitExpr, Type: Some(ast2.MonoType.TUnit) }) })
  else
    let binding = bindings.Get(0).UnwrapOr(ast2.LetRecBind { Name: "", Type: ast2.TypeExpr.UnitType(), Value: ast2.EmptyExpr() })
    let inferred = inferExpr(binding.Value, recEnv, state)
    switch inferred
      case Err(msg) => Err("letrec binding " + binding.Name + ": " + msg)
      case Ok(eir) =>
        let value = eir.Result
        let combined = composeSubst(value.Subst, subst)
        let checked = unify(applySubst(combined, value.Type), applySubst(combined, typeFromAST(binding.Type)), combined)
        switch checked
          case Err(msg) => Err("letrec binding " + binding.Name + ": type annotation mismatch: " + msg)
          case Ok(nextSubst) => inferLetRecValues(sliceDrop(bindings, 1), recEnv, value.State, nextSubst)
        end
    end
  end
end

func inferBlockBind(bind: ast2.Bind, isVar: Bool, env: Slice[EnvEntry], state: InferState) -> Result[BlockInferStep, String]
  let r = inferExpr(bind.Value, env, state)
  switch r
    case Err(msg) => Err(msg)
    case Ok(eir) =>
      let v = eir.Result
      let annotated = switch bind.Type
        case Some(t) => unify(v.Type, typeFromASTInEnv(t, env, v.State), v.Subst)
        case None => Ok(v.Subst)
      end
      switch annotated
        case Err(msg) => Err(msg)
        case Ok(s) then
          let boundType = applySubst(s, v.Type)
          let nextEnv = envPut(env, bind.Name, Scheme {
            Bound: generalizeQualified(env, boundType, v.Predicates),
            Predicates: v.Predicates,
            Body: boundType,
          })
          let typedBind = ast2.Bind { Name: bind.Name, Type: bind.Type, Value: eir.Expr }
          let typedStmt = if isVar then ast2.Stmt.VarStmt(typedBind) else ast2.Stmt.LetStmt(typedBind) end
          Ok(BlockInferStep {
            Result: InferResult { Type: ast2.MonoType.TUnit, Predicates: v.Predicates, Subst: s, State: v.State },
            Env: nextEnv,
            Stmt: typedStmt,
          })
        end
      end
  end
end

func inferLet(bind: ast2.Bind, env: Slice[EnvEntry], state: InferState) -> Result[InferResult, String]
  let r = inferExpr(bind.Value, env, state)
  switch r
    case Err(msg) => Err(msg)
    case Ok(eir) =>
      let v = eir.Result
      let annotated = switch bind.Type
        case Some(t) => unify(v.Type, typeFromASTInEnv(t, env, v.State), v.Subst)
        case None => Ok(v.Subst)
      end
      switch annotated
        case Err(msg) => Err(msg)
        case Ok(s) =>
          Ok(InferResult {
            Type: ast2.MonoType.TUnit,
            Predicates: v.Predicates,
            Subst: s,
            State: v.State,
          })
      end
  end
end

func matchExpected(v: InferResult, expected: ast2.MonoType, result: ast2.MonoType) -> Result[InferResult, String]
  let s = unify(v.Type, expected, v.Subst)
  switch s
    case Ok(subst) => Ok(InferResult { Type: result, Predicates: v.Predicates, Subst: subst, State: v.State })
    case Err(msg) => Err(msg)
  end
end

func inferField(base: ast2.Expr, field: String, env: Slice[EnvEntry], state: InferState) -> Result[ExprInferResult, String]
  switch base.Kind
    case IdentExpr(name) =>
      let packageCandidate = envGet(env, name + "." + field)
      switch packageCandidate
        case Some(packageScheme) =>
          let qualified = instantiateQualified(packageScheme, state)
          let te = ast2.Expr { ID: base.ID, Pos: base.Pos, Kind: base.Kind, Type: Some(qualified.Body) }
          Ok(ExprInferResult { Expr: te, Result: InferResult { Type: qualified.Body, Predicates: qualified.Predicates, Subst: [], State: state } })
        case None =>
          inferNamedField(base, name, field, env, state)
      end
    case _ => inferOrdinaryField(base, field, env, state)
  end
end

func inferNamedField(base: ast2.Expr, name: String, field: String, env: Slice[EnvEntry], state: InferState) -> Result[ExprInferResult, String]
      let candidate = envGet(env, field)
      switch candidate
        case Some(scheme) =>
          switch scheme.Body
            # Variants with fields are functions; a zero-argument variant has
            # the enum type itself as its scheme body.
            case TCon(enumName, _) =>
              if enumName == name then
                let qualified = instantiateQualified(scheme, state)
                let te = ast2.Expr { ID: base.ID, Pos: base.Pos, Kind: base.Kind, Type: Some(qualified.Body) }
                Ok(ExprInferResult { Expr: te, Result: InferResult { Type: qualified.Body, Predicates: qualified.Predicates, Subst: [], State: state } })
              else
                inferOrdinaryField(base, field, env, state)
              end
            case _ => inferOrdinaryField(base, field, env, state)
          end
        case None => inferOrdinaryField(base, field, env, state)
      end
end

func inferOrdinaryField(base: ast2.Expr, field: String, env: Slice[EnvEntry], state: InferState) -> Result[ExprInferResult, String]
  let r = inferExpr(base, env, state)
  switch r
    case Err(msg) => Err(msg)
    case Ok(eir) then
      let typedBase = eir.Expr
      let v = eir.Result
      let resolvedType = switch applySubst(v.Subst, v.Type)
        case TCon(name, args) =>
          if name == "Ref" && args.Len() == 1 then
            applySubst(v.Subst, args.Get(0).UnwrapOr(ast2.MonoType.TUnit))
          else
            applySubst(v.Subst, v.Type)
          end
        case _ => applySubst(v.Subst, v.Type)
      end
      switch resolvedType
        case TGoPackage(path) =>
          if strings.HasPrefix(path, "go:") then
            Err("unknown Go package member " + field)
          else
            let fresh = ast2.MonoType.TVar(v.State.FreshVarID)
            Ok(ExprInferResult { Expr: typedBase, Result: InferResult { Type: fresh, Predicates: v.Predicates, Subst: v.Subst, State: withFreshID(v.State, v.State.FreshVarID + 1) } })
          end
        case TCon(typeName, args) =>
          switch findSymbol(typeName, field, state.Symbols)
            case Some(symbol) =>
              switch symbol
                case StructField(_, _, fieldType) =>
                  let substed = switchFieldTypeArgs(fieldType, typeName, args, env)
                  let instState = withFreshID(v.State, v.State.FreshVarID + 1)
                  Ok(ExprInferResult { Expr: typedBase, Result: InferResult { Type: substed, Predicates: v.Predicates, Subst: v.Subst, State: instState } })
                case GoMethod(_, _, sig) =>
                  let methodType = GoSignatureType(sig)
                  let instState = withFreshID(v.State, v.State.FreshVarID + 1)
                  Ok(ExprInferResult { Expr: typedBase, Result: InferResult { Type: methodType, Predicates: v.Predicates, Subst: v.Subst, State: instState } })
                case ImplMethod(_, _, scheme) =>
                  let q = instantiateQualified(scheme, v.State)
                  let instState = withFreshID(v.State, v.State.FreshVarID + scheme.Bound.Len())
                  let substed = switchFieldTypeArgs(q.Body, typeName, args, env)
                  switch stripReceiverArg(substed, typeName, args, v.Subst)
                    case Some(stripResult) =>
                      switch stripResult
                        case Ok(pair2) =>
                          let (strippedType, s2) = pair2
                          Ok(ExprInferResult { Expr: typedBase, Result: InferResult { Type: strippedType, Predicates: appendPredicates(v.Predicates, q.Predicates), Subst: s2, State: instState } })
                        case Err(msg) => Err(msg)
                      end
                    case None =>
                      Ok(ExprInferResult { Expr: typedBase, Result: InferResult { Type: substed, Predicates: appendPredicates(v.Predicates, q.Predicates), Subst: v.Subst, State: instState } })
                  end
              end
            case None =>
              Err("unknown field " + typeName + "." + field)
          end
        case _ =>
          let fresh = ast2.MonoType.TVar(v.State.FreshVarID)
          Ok(ExprInferResult { Expr: typedBase, Result: InferResult { Type: fresh, Predicates: v.Predicates, Subst: v.Subst, State: withFreshID(v.State, v.State.FreshVarID + 1) } })
      end
    end
  end
end

# stripReceiverArg recognises impl-method schemes (registered by
# `registerImplMethods`) whose Body is a function type with the *receiver* as
# its first parameter.  When `fieldType` has that shape — first param is a
# `TCon(typeName, _)` matching the lookup key — it unifies the receiver
# pattern with the actual receiver (`args` are the receiver's concrete type
# arguments), applies the resulting substitution to the remaining parameters
# and the return type, then returns a stripped function type with the
# receiver dropped and the new substitution.  Returns None for ordinary struct
# field projections (e.g. `Parser.Run`) so the caller falls back to the plain
# `substed` value.
func stripReceiverArg(fieldType: ast2.MonoType, typeName: String, args: Slice[ast2.MonoType], subst: Slice[SubstEntry]) -> Option[Result[(ast2.MonoType, Slice[SubstEntry]), String]]
  switch fieldType
    case TFunc(methodArgs, methodRet) =>
      if methodArgs.Len() == 0 then None else
        let first = methodArgs.Get(0).UnwrapOr(ast2.MonoType.TUnit)
        switch first
          case TCon(recvName, recvPatArgs) =>
            if recvName != typeName then None else
              # The actual receiver type is `typeName[args]`.
              let receiverType = ast2.MonoType.TCon(typeName, args)
              # Unify the instantiated receiver pattern with the actual
              # receiver to derive substitution entries for the impl's type
              # parameters (e.g. `T` in `SliceIEnumerable[T].Fold` gets bound
              # to `Parser[A]` when folding `Slice[Parser[A]]`).
              let us = unify(first, receiverType, subst)
              switch us
                case Err(msg) => Some(Err("method receiver mismatch: " + msg))
                case Ok(s2) =>
                  let droppedArgs = sliceDrop(methodArgs, 1)
                  let newRet = applySubst(s2, methodRet.value())
                  let strippedBody = applySubstMonoList(s2, droppedArgs)
                  Some(Ok((ast2.MonoType.TFunc(strippedBody, Ref.new(newRet)), s2)))
              end
            end
          case _ => None
        end
      end
    case _ => None
  end
end

func applySubstMonoList(subst: Slice[SubstEntry], items: Slice[ast2.MonoType]) -> Slice[ast2.MonoType]
  if items.Len() == 0 then [] else
    applySubstMonoList(subst, sliceDrop(items, 1)).Prepend(applySubst(subst, items.Get(0).UnwrapOr(ast2.MonoType.TUnit)))
  end
end

func switchFieldTypeArgs(fieldType: ast2.MonoType, typeName: String, args: Slice[ast2.MonoType], env: Slice[EnvEntry]) -> ast2.MonoType
  # Read the struct's type param IDs from its env Scheme Bound.
  let scheme = envGet(env, typeName)
  switch scheme
    case Some(s) =>
      if s.Bound.Len() == 0 || args.Len() == 0 then
        fieldType
      else
        let subst = bindDistinctFieldArgs(s.Bound, args, 0, [] as Slice[SubstEntry])
        if subst.Len() == 0 then fieldType else applySubst(subst, fieldType) end
      end
    case None => fieldType
  end
end

func bindDistinctFieldArgs(bound: Slice[Int], args: Slice[ast2.MonoType], index: Int, out: Slice[SubstEntry]) -> Slice[SubstEntry]
  if index >= bound.Len() || index >= args.Len() then
    out
  else
    let id = bound.Get(index).UnwrapOr(0)
    let typ = args.Get(index).UnwrapOr(ast2.MonoType.TUnit)
    # Skip self-mappings (TVar with same ID as the bound param).
    let next = switch typ
      case TVar(other) => if other == id then out else out.Prepend(SubstEntry { ID: id, Type: typ }) end
      case _ => out.Prepend(SubstEntry { ID: id, Type: typ })
    end
    bindDistinctFieldArgs(bound, args, index + 1, next)
  end
end


func goFuncArity(path: String, name: String) -> Int
  go[Int] {
    code: "func() int { pkg, err := {importer}.Default().Import({path}); if err != nil { return -2 }; obj := pkg.Scope().Lookup({name}); if obj == nil { return -2 }; sig, ok := obj.Type().(*{gotypes}.Signature); if !ok { return -2 }; if sig.Variadic() { return -1 }; return sig.Params().Len() }()"
    in importer = importer
    in path = path
    in name = name
    in gotypes = gotypes
  }
end

func inferVariants(vars: Slice[ast2.Variant], enumName: String, tps: Slice[String], env: Slice[EnvEntry], fields: Slice[FieldEntry], state: InferState) -> Result[DeclInfer, String]
  if vars.Len() == 0 then
    Ok(DeclInfer { Env: envPut(env, enumName, Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: ast2.MonoType.TCon(enumName, typeParamsAsTypes(tps, 1)) }), Fields: fields, State: state, TypedDecl: None })
  else
    let v = vars.Get(0).UnwrapOr(ast2.Variant { Name: "", Fields: emptyASTTypeExprs() })
    let enumType = ast2.MonoType.TCon(enumName, typeParamsAsTypes(tps, 1))
    let constructorType = if v.Fields.Len() == 0 then
      enumType
    else
      ast2.MonoType.TFunc(typeArgsFromASTWithParams(v.Fields, tps), Ref.new(enumType))
    end
    inferVariants(sliceDrop(vars, 1), enumName, tps, envPut(env, v.Name, Scheme { Bound: typeParamIDs(tps, 1), Predicates: [], Body: constructorType }), fields, state)
  end
end

func typeParamsAsTypes(params: Slice[String], index: Int) -> Slice[ast2.MonoType]
  if params.Len() == 0 then
    []
  else
    typeParamsAsTypes(sliceDrop(params, 1), index + 1).Prepend(ast2.MonoType.TParam(-index))
  end
end

# 推断结构体字面量的类型: TypeName { field1: expr1, field2: expr2 }
# 遍历所有字段，对每个字段进行类型推断，最终返回结构体类型 TCon(typeName, [])
func inferStructLit(typeName: String, fields: Slice[ast2.StructLitField], env: Slice[EnvEntry], state: InferState) -> Result[InferResult, String]
  inferStructLitFields(typeName, fields, env, state, [], state, [])
end

func inferStructLitFields(typeName: String, fields: Slice[ast2.StructLitField], env: Slice[EnvEntry], state: InferState, subst: Slice[SubstEntry], curState: InferState, predicates: Slice[Predicate]) -> Result[InferResult, String]
  if fields.Len() == 0 then
    Ok(InferResult { Type: ast2.MonoType.TCon(typeName, emptyMonoTypes()), Predicates: predicates, Subst: subst, State: curState })
  else
    let f = fields.Get(0).UnwrapOr(ast2.StructLitField { Name: "", Value: ast2.EmptyExpr() })
    if typeName == "Reply" || typeName == "Parser" then
      fmt.Println("[DEBUG]     field " + f.Name + ": substBefore=" + substString(subst))
      ()
    end
    let r = inferExpr(f.Value, env, curState)
    switch r
      case Err(msg) => Err(msg)
      case Ok(eir) then
        let v = eir.Result
        if typeName == "Reply" || typeName == "Parser" then
          fmt.Println("[DEBUG]     field " + f.Name + ": fieldType=" + monoStringFull(v.Type) + " substAfter=" + substString(v.Subst))
          ()
        end
        inferStructLitFields(typeName, sliceDrop(fields, 1), env, v.State, composeSubst(v.Subst, subst), v.State, appendPredicates(predicates, v.Predicates))
      end
    end
  end
end

func inferMapLit(pairs: Slice[(ast2.Expr, ast2.Expr)], env: Slice[EnvEntry], s0: InferState) -> Result[InferResult, String]
  if pairs.Len() == 0 then
    let kt = ast2.MonoType.TVar(s0.FreshVarID)
    let vt = ast2.MonoType.TVar(s0.FreshVarID + 1)
    Ok(InferResult { Type: ast2.MonoType.TCon("Map", [kt, vt]), Predicates: [], Subst: [], State: withFreshID(s0, s0.FreshVarID + 2) })
  else
    let (k0, v0) = pairs.Get(0).UnwrapOr((ast2.EmptyExpr(), ast2.EmptyExpr()))
    let kr = inferExpr(k0, env, s0)
    switch kr
      case Err(msg) => Err("map key: " + msg)
      case Ok(keir) =>
        let kv = keir.Result
        let vr = inferExpr(v0, env, kv.State)
        switch vr
          case Err(msg) => Err("map value: " + msg)
          case Ok(eireir) =>
            let vv = eireir.Result
            let s1 = composeSubst(vv.Subst, kv.Subst)
            let resultType = ast2.MonoType.TCon("Map", [applySubst(s1, kv.Type), applySubst(s1, vv.Type)])
            inferMapLitTail(sliceDrop(pairs, 1), env, vv.State, s1, resultType, appendPredicates(kv.Predicates, vv.Predicates))
        end
    end
  end
end

func inferMapLitTail(pairs: Slice[(ast2.Expr, ast2.Expr)], env: Slice[EnvEntry], s0: InferState, subst: Slice[SubstEntry], resultType: ast2.MonoType, predicates: Slice[Predicate]) -> Result[InferResult, String]
  if pairs.Len() == 0 then
    Ok(InferResult { Type: resultType, Predicates: predicates, Subst: subst, State: s0 })
  else
    let (k, v) = pairs.Get(0).UnwrapOr((ast2.EmptyExpr(), ast2.EmptyExpr()))
    let kr = inferExpr(k, env, s0)
    switch kr
      case Err(msg) => Err("map key: " + msg)
      case Ok(eirK) =>
        let kv = eirK.Result
        let vr = inferExpr(v, env, kv.State)
        switch vr
          case Err(msg) => Err("map value: " + msg)
          case Ok(eirV) => inferMapLitTail(sliceDrop(pairs, 1), env, eirV.Result.State, composeSubst(eirV.Result.Subst, composeSubst(kv.Subst, subst)), resultType, appendPredicates(predicates, appendPredicates(kv.Predicates, eirV.Result.Predicates)))
        end
    end
  end
end

func inferSetLit(items: Slice[ast2.Expr], env: Slice[EnvEntry], s0: InferState) -> Result[InferResult, String]
  if items.Len() == 0 then
    let et = ast2.MonoType.TVar(s0.FreshVarID)
    Ok(InferResult { Type: ast2.MonoType.TCon("Set", [et]), Predicates: [], Subst: [], State: withFreshID(s0, s0.FreshVarID + 1) })
  else
    let r0 = inferExpr(items.Get(0).UnwrapOr(ast2.EmptyExpr()), env, s0)
    switch r0
      case Err(msg) => Err("set element: " + msg)
      case Ok(eir0) =>
        let v0 = eir0.Result
        let resultType = ast2.MonoType.TCon("Set", [applySubst(v0.Subst, v0.Type)])
        inferSetLitTail(sliceDrop(items, 1), env, v0.State, v0.Subst, resultType, v0.Predicates)
    end
  end
end

func inferSetLitTail(items: Slice[ast2.Expr], env: Slice[EnvEntry], s0: InferState, subst: Slice[SubstEntry], resultType: ast2.MonoType, predicates: Slice[Predicate]) -> Result[InferResult, String]
  if items.Len() == 0 then
    Ok(InferResult { Type: resultType, Predicates: predicates, Subst: subst, State: s0 })
  else
    let r = inferExpr(items.Get(0).UnwrapOr(ast2.EmptyExpr()), env, s0)
    switch r
      case Err(msg) => Err("set element: " + msg)
      case Ok(eir) => inferSetLitTail(sliceDrop(items, 1), env, eir.Result.State, composeSubst(eir.Result.Subst, subst), resultType, appendPredicates(predicates, eir.Result.Predicates))
    end
  end
end

func maxSubstID(subst: Slice[SubstEntry]) -> Int
	if subst.Len() == 0 then
		0
	else
		let head = subst.Get(0).UnwrapOr(SubstEntry { ID: 0, Type: ast2.MonoType.TUnit })
		let rest = maxSubstID(sliceDrop(subst, 1))
		if head.ID > rest then head.ID else rest end
	end
end

func findSymbol(typeName: String, field: String, symbols: Slice[Symbol]) -> Option[Symbol]
  if symbols.Len() == 0 then None else
    let s = symbols.Get(0).UnwrapOr(Symbol.StructField("", "", ast2.MonoType.TUnit))
    switch s
      case StructField(tn, fn, _) =>
        if tn == typeName && fn == field then Some(s) else findSymbol(typeName, field, sliceDrop(symbols, 1)) end
      case GoMethod(tn, mn, _) =>
        if tn == typeName && mn == field then Some(s) else findSymbol(typeName, field, sliceDrop(symbols, 1)) end
      case ImplMethod(tn, mn, _) =>
        if tn == typeName && mn == field then Some(s) else findSymbol(typeName, field, sliceDrop(symbols, 1)) end
    end
  end
end
