package prelude

import reflect "go:reflect"
# Distinct keeps one entry point and splits by runtime comparability: a
# comparable element type goes through a hash pass, everything else falls back
# to the caller's Eq instance.

impl[T] Slice[T]
  func DistinctHashed(c: Slice[T]) -> Slice[T]
    go[Slice[T]] {
      code: """
        func() []{T} {
          out := make([]{T}, 0, len(c))
          seen := make(map[any]struct{}, len(c))
          for _, v := range c {
            if _, ok := seen[v]; ok {
              continue
            }
            seen[v] = struct{}{}
            out = append(out, v)
          }
          return out
        }()
      """
      in c = c
      type T = T
    }
  end
end

impl[T] SliceIEquatable[T]: IEquatable[Slice[T], T]
  func Distinct(c: Slice[T]) -> Slice[T] using Eq[T]
    var result: Slice[T] = []
    if go[Bool] {
      code: "reflect.TypeFor[{T}]().Comparable()"
      type T = T
    } then
      result = c.DistinctHashed()
    else
      result = go[Slice[T]] {
        code: """
          func() []{T} {
            out := make([]{T}, 0, len(c))
            for _, v := range c {
              dup := false
              for _, u := range out {
                if {equalsFn}(u, v) {
                  dup = true
                  break
                }
              }
              if !dup {
                out = append(out, v)
              }
            }
            return out
          }()
        """
        in c = c
        in equalsFn = func(left: T, right: T) -> Bool left.Equals(right) end
        type T = T
      }
    end
    result
  end
  func IndexOf(c: Slice[T], item: T) -> Option[Int] using Eq[T]
    go[Option[Int]] {
      code: """
        func() {OptInt} {
          for i, v := range {c} {
            if {equalsFn}(v, {item}) {
              return {someInt}(i)
            }
          }
          return {noneInt}()
        }()
      """
      in c = c
      in item = item
      in equalsFn = func(left: T, right: T) -> Bool left.Equals(right) end
      in someInt = func(value: Int) -> Option[Int] Some(value) end
      in noneInt = func() -> Option[Int] None end
      type OptInt = Option[Int]
    }
  end
  func LastIndexOf(c: Slice[T], item: T) -> Option[Int] using Eq[T]
    go[Option[Int]] {
      code: """
        func() {OptInt} {
          for i := len({c}) - 1; i >= 0; i-- {
            if {equalsFn}({c}[i], {item}) {
              return {someInt}(i)
            }
          }
          return {noneInt}()
        }()
      """
      in c = c
      in item = item
      in equalsFn = func(left: T, right: T) -> Bool left.Equals(right) end
      in someInt = func(value: Int) -> Option[Int] Some(value) end
      in noneInt = func() -> Option[Int] None end
      type OptInt = Option[Int]
    }
  end
end
