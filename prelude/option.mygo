package prelude

impl[A] OptionIEnumerable[A]: IEnumerable[Option[A], A]
  func Each(c: Option[A], fn: func(A) -> ()) -> ()
    switch c
      case Some(v) => fn(v)
      case None => ()
    end
  end

  func Map[B](c: Option[A], fn: func(A) -> B) -> Option[B]
    switch c
      case Some(v) => Some(fn(v))
      case None => None
    end
  end

  func Filter(c: Option[A], fn: func(A) -> Bool) -> Option[A]
    switch c
      case Some(v) => if fn(v) => Some(v) else None
      case None => None
    end
  end

  func Fold[B](c: Option[A], initial: B, fn: func(B, A) -> B) -> B
    switch c
      case Some(v) => fn(initial, v)
      case None => initial
    end
  end

  func Find(c: Option[A], fn: func(A) -> Bool) -> Option[Ref[A]]
    switch c
      case Some(v) => if fn(v) => Some(Ref.new(v)) else None
      case None => None
    end
  end

  func Contains(c: Option[A], item: A) -> Bool using Eq[A]
    switch c
      case Some(v) => v.Equals(item)
      case None => false
    end
  end

  func Len(c: Option[A]) -> Int
    switch c
      case Some(_) => 1
      case None => 0
    end
  end
end

impl[A] Option[A]
  func UnwrapOr(opt: Option[A], defaultVal: A) -> A
    switch opt
      case Some(v) => v
      case None => defaultVal
    end
  end

  func IsSome(opt: Option[A]) -> Bool
    switch opt
      case Some(_) => true
      case None => false
    end
  end

  func IsNone(opt: Option[A]) -> Bool
    switch opt
      case Some(_) => false
      case None => true
    end
  end

  func OkOr[E](opt: Option[A], errVal: E) -> Result[A, E]
    switch opt
      case Some(v) => Ok(v)
      case None => Err(errVal)
    end
  end

  func OkOrElse[E](opt: Option[A], fn: func() -> E) -> Result[A, E]
    switch opt
      case Some(v) => Ok(v)
      case None => Err(fn())
    end
  end

  func AndThen[B](opt: Option[A], fn: func(A) -> Option[B]) -> Option[B]
    switch opt
      case Some(v) => fn(v)
      case None => None
    end
  end

  func OrElse(opt: Option[A], fn: func() -> Option[A]) -> Option[A]
    switch opt
      case Some(v) => Some(v)
      case None => fn()
    end
  end

  func Unwrap(opt: Option[A]) -> A
    switch opt
      case Some(v) => v
      case None then
        Panic("called Option.Unwrap on None")
        Zero[A]()
      end
    end
  end

  func UnwrapOrElse(opt: Option[A], fn: func() -> A) -> A
    switch opt
      case Some(v) => v
      case None => fn()
    end
  end

  func Expect(opt: Option[A], msg: String) -> A
    switch opt
      case Some(v) => v
      case None then
        Panic(msg)
        Zero[A]()
      end
    end
  end

  func MapOr[B](opt: Option[A], defaultVal: B, fn: func(A) -> B) -> B
    switch opt
      case Some(v) => fn(v)
      case None => defaultVal
    end
  end
end

impl[A] Option[Option[A]]
  func Flatten(opt: Option[Option[A]]) -> Option[A]
    switch opt
      case Some(inner) => inner
      case None => None
    end
  end
end

impl[A] OptionEq[A]: Eq[Option[A]]
  func Equals(left: Option[A], right: Option[A]) -> Bool using Eq[A]
    switch left
      case Some(l) then
        switch right
          case Some(r) => l.Equals(r)
          case None => false
        end
      end
      case None then
        switch right
          case Some(_) => false
          case None => true
        end
      end
    end
  end
end

impl[A, E] Option[Result[A, E]]
  func Transpose(opt: Option[Result[A, E]]) -> Result[Option[A], E]
    switch opt
      case Some(inner) then
        switch inner.ToOption()
          case Some(v) => Ok(Some(v))
          case None => Err(inner.UnwrapErr())
        end
      end
      case None => Ok(None)
    end
  end
end
