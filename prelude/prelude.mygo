package prelude

enum Option[A]
  Some(A)
  None
end

enum Result[A, E]
  Ok(A)
  Err(E)
end

interface ToString[A]
  func ToString(value: A) -> String
end

interface Eq[A]
  func Equals(left: A, right: A) -> Bool
end

interface Ord[A]
  func Compare(left: A, right: A) -> Int
  func Less(left: A, right: A) -> Bool
  func Greater(left: A, right: A) -> Bool
end

interface Default[A]
  func Default() -> A
end

interface From[A, B]
  func From(value: A) -> B
end

interface Into[A, B]
  func Into(value: A) -> B
end

interface IEnumerable[C[A], A]
  func Each(c: C[A], fn: func(A) -> ()) -> ()
  func Len(c: C[A]) -> Int
  func Map[B](c: C[A], fn: func(A) -> B) -> IEnumerable[Slice[B], B]
  func Filter(c: C[A], fn: func(A) -> Bool) -> IEnumerable[Slice[A], A]
  func Fold[B](c: C[A], initial: B, fn: func(B, A) -> B) -> B
  func Find(c: C[A], fn: func(A) -> Bool) -> Option[Ref[A]]
  func Contains(c: C[A], item: A) -> Bool using Eq[A]
end

interface IAssignable[C[K, A], K, A]
  func Get(c: C[K, A], index: K) -> Option[A]
  func Set(c: C[K, A], index: K, value: A) -> ()
  func Delete(c: C[K, A], index: K) -> ()
end

interface ISequence[C[A], A]
  func Concat(c: C[A], other: C[A]) -> C[A]
  func Take(c: C[A], n: Int) -> C[A]
  func Skip(c: C[A], n: Int) -> C[A]
  func TakeWhile(c: C[A], fn: func(A) -> Bool) -> C[A]
  func SkipWhile(c: C[A], fn: func(A) -> Bool) -> C[A]
  func Reverse(c: C[A]) -> C[A]
  func ToSlice(c: C[A]) -> Slice[A]
end

interface IOrdered[C[A], A]
  func Sorted(c: C[A]) -> C[A] using Ord[A]
  func SortedBy(c: C[A], less: func(A, A) -> Bool) -> C[A]
  func Min(c: C[A]) -> Option[A] using Ord[A]
  func Max(c: C[A]) -> Option[A] using Ord[A]
end

interface IEquatable[C[A], A]
  func Distinct(c: C[A]) -> C[A] using Eq[A]
  func IndexOf(c: C[A], item: A) -> Option[Int] using Eq[A]
  func LastIndexOf(c: C[A], item: A) -> Option[Int] using Eq[A]
end

# Slice[A] is Go's native slice ([]A).

# Map[K, V] is Go's native map[K]V.

# Set[A] is Go's native map[A]struct{}

func OptionToResult[A, E](opt: Option[A], errVal: E) -> Result[A, E]
  switch opt
    case Some(v) => Ok(v)
    case None => Err(errVal)
  end
end


func Panic(msg: String) -> ()
  go[()] { code: "panic(msg)" }
end


func Zero[A]() -> A
  go[A] {
    code: """
      func() {A} {
        var zero {A}
        return zero
      }()
    """
    type A = A
  }
end
